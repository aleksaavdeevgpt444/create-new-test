      function getTodayCommandCenterData(dayYmd, data) {
        var now = new Date();
        var scheduled = getTasksForDay(dayYmd).filter(function (task) {
          return task && task.due_at && normalizeStatus(task.status) === STATUS.PLANNED;
        }).sort(compareTasksByDueAndUpdated);

        var currentTask = null;
        var nextTask = null;
        for (var i = 0; i < scheduled.length; i += 1) {
          var start = new Date(scheduled[i].due_at);
          if (isNaN(start.getTime())) continue;
          var startMinutes = start.getHours() * 60 + start.getMinutes();
          var endMinutes = startMinutes + Math.max(Number(getTaskDurationMinutes(scheduled[i])) || DEFAULT_EVENT_DURATION_MIN, 1);
          var nowMinutes = now.getHours() * 60 + now.getMinutes();
          if (!currentTask && startMinutes <= nowMinutes && endMinutes >= nowMinutes) {
            currentTask = scheduled[i];
          }
          if (!nextTask && startMinutes > nowMinutes) {
            nextTask = scheduled[i];
          }
        }

        var suggestion = getTodayOsActionSuggestion(dayYmd, data);
        var freeSlotLabel = '';
        try {
          var slotIso = getSuggestedTodaySlotIso(dayYmd, { duration_minutes: Math.max(Number(state.gridStepMinutes) || 15, 5) });
          freeSlotLabel = formatTimeRange(slotIso, Math.max(Number(state.gridStepMinutes) || 15, 5), { withDate: false });
        } catch (error) {
          freeSlotLabel = '';
        }

        return {
          currentTask: currentTask,
          nextTask: nextTask,
          suggestion: suggestion,
          freeSlotLabel: freeSlotLabel
        };
      }

