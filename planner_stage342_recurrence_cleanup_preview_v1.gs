async function convertChecklistItemToTask(env, { itemId, userId, sourceTaskId }) {
  const item = await env.DB.prepare(`
    SELECT id, task_id, text, linked_task_id
    FROM task_checklist
    WHERE id = ? AND user_id = ?
    LIMIT 1
  `).bind(itemId, String(userId)).first();
  if (!item) throw new Error('Checklist item not found');
  if (item.linked_task_id) return { linkedTaskId: item.linked_task_id, items: await listChecklistItems(env, { taskId: item.task_id, userId }) };
  const sourceTask = await getTaskById(env, { taskId: sourceTaskId || item.task_id, userId: String(userId) });
  if (!sourceTask) throw new Error('Source task not found');
  const now = new Date().toISOString();
  const linkedTaskId = crypto.randomUUID();
  await insertTask(env, {
    id: linkedTaskId,
    user_id: String(userId),
    title: item.text,
    description: null,
    status: TASK_STATUSES.NEW,
    priority_manual: null,
    priority_ai: sourceTask.priority_ai ?? null,
    project_name: sourceTask.project_name || 'Без проекта',
    due_at: null,
    duration_minutes: DEFAULT_EVENT_DURATION_FOR_SERVER(),
    remind_at: null,
    source: 'checklist',
    ai_priority_reason: null,
    ai_project_guess: null,
    ai_next_step: null,
    recurrence_type: null,
    recurrence_rule: null,
    recurrence_enabled: 0,
    created_at: now,
    updated_at: now,
  });
  await env.DB.prepare(`
    UPDATE task_checklist
    SET linked_task_id = ?, updated_at = ?
    WHERE id = ? AND user_id = ?
  `).bind(linkedTaskId, now, itemId, String(userId)).run();
  return { linkedTaskId, items: await listChecklistItems(env, { taskId: item.task_id, userId }) };
}

function buildStatusFilterClause(statuses) {
  const placeholders = statuses.map(() => "?").join(", ");
  return { placeholders, values: statuses };
}

async function getTasksByStatus(env, { userId, status, limit = TELEGRAM_LIST_LIMIT }) {
  const safeLimit = Math.max(1, Math.min(Number(limit) || TELEGRAM_LIST_LIMIT, 500));
  const sqlStatuses = getStatusSqlValues(status);
  if (!sqlStatuses.length) throw new Error(`Unsupported status: ${status}`);

  const statusFilter = buildStatusFilterClause(sqlStatuses);
  const result = await env.DB.prepare(`
    SELECT ${TASK_SELECT_FIELDS}
    FROM tasks
    WHERE user_id = ? AND status IN (${statusFilter.placeholders})
    ORDER BY updated_at DESC, created_at DESC
    LIMIT ?
  `)
    .bind(String(userId), ...statusFilter.values, safeLimit)
    .all();

  return result.results || [];
}

