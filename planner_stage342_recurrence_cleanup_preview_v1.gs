      function buildEditorRecurringPayload(options) {
        options = options || {};
        if (!state.editorTaskId || !state.userId) return null;
        var currentTask = findTaskById(state.editorTaskId);
        if (!currentTask) return null;
        var title = String(byId('editorTitleInput').value || '').trim();
        var projectName = getProjectValueFromUi('editor');
        var savedProjectName = normalizeEditorProjectDraftValue(projectName);
        var taskProduct = String((byId('editorProductInput') && byId('editorProductInput').value) || '').trim();
        var description = String(byId('editorDescriptionInput').value || '').trim();
        var priorityManual = byId('editorPrioritySelect') ? byId('editorPrioritySelect').value : '';
        var dateValue = parseDisplayDateToYmd(String(byId('editorDateInput').value || '').trim());
        var timeValue = String(byId('editorTimeInput').value || '').trim();
        var durationValue = snapDurationToStep(byId('editorDurationInput').value || 60);
        var plannedMinutesManual = getEditorPlannedMinutesManualValue();
        var _tntSel2 = byId('editorTelegramNotifyTypeSelect');
        var telegramNotifyType = _tntSel2 ? String(_tntSel2.value || 'auto').trim() : 'auto';
        var actualMinutes = normalizeMinutesInputValue(byId('editorActualMinutesInput') && byId('editorActualMinutesInput').value);
        var showInMonth = byId('editorShowInMonthCheckbox') ? (byId('editorShowInMonthCheckbox').checked ? 1 : 0) : 0;
        var spaceKey = byId('editorSpaceSelect') ? String(byId('editorSpaceSelect').value || state.activeSpaceKey || 'work').trim() : String(state.activeSpaceKey || 'work');
        var recurrencePayload = getRecurrencePayloadFromScope('editor');
        var nextStatus = normalizeStatus(byId('editorStatusSelect') ? byId('editorStatusSelect').value : currentTask.status);
        if (!title) throw new Error('Название задачи не может быть пустым.');
        if (nextStatus === STATUS.PLANNED && !(dateValue && timeValue)) {
          throw new Error('Для статуса «В плане» нужно выбрать дату и время.');
        }
        var payload = {
          task_id: state.editorTaskId,
          user_id: state.userId,
          title: title,
          project_name: projectName || 'Без проекта',
          priority_manual: priorityManual || null,
          task_product: taskProduct || '',
          description: description || '',
          duration_minutes: durationValue,
          planned_minutes_manual: plannedMinutesManual,
          actual_minutes: actualMinutes,
          show_in_month: showInMonth,
          space_key: spaceKey,
          status: nextStatus
        };
        if (nextStatus === STATUS.PLANNED) {
          payload.due_at = makeDueAtIso(dateValue, timeValue);
        } else if (nextStatus === STATUS.POSTPONED) {
          payload.due_at = null;
        }
        if (!(options && options.currentOnly)) {
          payload.recurrence_type = recurrencePayload.type;
          payload.recurrence_rule = recurrencePayload.rule;
          payload.recurrence_enabled = recurrencePayload.enabled;
        }
        return payload;
      }

