        const planner = await getPlannerData(env, { userId: String(userId), weekStartYmd: weekStart, queueLimit });
        return jsonResponse({ ok: true, build: getClientAppBuildLabel(), planner });
      } catch (error) {
        return jsonResponse({ ok: false, error: String(error) }, { status: 500 });
      }
    }

