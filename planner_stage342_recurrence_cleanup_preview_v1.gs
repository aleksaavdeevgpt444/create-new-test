        heroActions.appendChild(createBoardKanbanAction('Открыть неделю', function () { setActiveView('planner'); renderPlannerCalendar(); }, 'ghost'));
        heroActions.appendChild(createBoardKanbanAction('К Today', function () { setActiveView('today'); renderTodayView(); }, 'ghost'));
        hero.appendChild(heroActions);
        shell.appendChild(hero);

        var strip = document.createElement('div');
        strip.className = 'board-control-strip';
        strip.appendChild(createBoardControlOverviewCard({
          value: control.blockedItems.length,
