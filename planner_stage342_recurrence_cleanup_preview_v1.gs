      function formatRecurrenceRuleDetails(type, rule) {
        var normalizedType = String(type || '').trim();
        if (normalizedType !== 'custom') return recurrenceLabel(normalizedType);
        var weekdayMap = {
          MO: 'Пн',
          TU: 'Вт',
          WE: 'Ср',
          TH: 'Чт',
          FR: 'Пт',
          SA: 'Сб',
          SU: 'Вс'
        };
        var weekdays = String(rule || '')
          .split(',')
          .map(function (item) { return String(item || '').trim(); })
          .filter(Boolean)
          .map(function (key) { return weekdayMap[key] || key; });
        return weekdays.length ? ('Дни: ' + weekdays.join(', ')) : 'Другое';
