      function buildDayBlockInstancesRequestUrl(startYmd, endYmd) {
        var safeUserId = String(state.userId || '').trim();
        var url = '/time-blocks/day?user_id=' + encodeURIComponent(safeUserId);
        if (startYmd) url += '&start_date=' + encodeURIComponent(String(startYmd));
        if (endYmd) url += '&end_date=' + encodeURIComponent(String(endYmd));
        return url;
      }

      function requestDayBlockInstancesFromServer(startYmd, endYmd) {
        if (!state.userId) return Promise.resolve(null);
        return requestJson(buildDayBlockInstancesRequestUrl(startYmd, endYmd), {
          method: 'GET',
          __meta: { requestName: 'time-block-day-get', reportServerErrors: true, reportTransportErrors: false, timeoutMs: 5000 }
        });
      }

      function getVisibleDayBlockSyncRange() {
        var startYmd = String(state.weekStart || getCurrentWeekStartYmd()).trim();
        var endDate = new Date(startYmd + 'T00:00:00');
        if (isNaN(endDate.getTime())) endDate = new Date();
        endDate.setDate(endDate.getDate() + 6);
        var endYmd = formatYmdLocal(endDate);
        var dayYmd = String(state.dayYmd || formatYmdLocal(new Date())).trim();
        if (dayYmd < startYmd) startYmd = dayYmd;
        if (dayYmd > endYmd) endYmd = dayYmd;
        return { startYmd: startYmd, endYmd: endYmd };
      }

      function hydrateDayBlockInstancesForVisibleRange(options) {
        if (!state.userId) return Promise.resolve(null);
        var range = getVisibleDayBlockSyncRange();
        return requestDayBlockInstancesFromServer(range.startYmd, range.endYmd).then(function (data) {
          if (!data) return null;
          applyDayBlockInstancesFromServerItems(data.items, range);
          return data;
        }).catch(function () {
          setServerSyncState('dayBlockInstancesSyncState', { source: 'fallback', status: 'fallback', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'instances' });
          return null;
        });
      }


      // STAGE 316 — boot server-sync fallback guard.
      // Серверная синхронизация framework/time-block слоёв не должна блокировать первичную загрузку интерфейса.
      // Если /frameworks/settings или соседний sync route временно недоступен, Planner остаётся на локальном snapshot
      // и продолжает грузить основной экран/задачи.
      function runServerSyncBootstrapStepSafe(label, runner, options) {
        options = options || {};
        var timeoutMs = Number(options.timeoutMs || 0);
        if (!(timeoutMs > 0)) timeoutMs = 6500;
        return new Promise(function (resolve) {
          var settled = false;
          var timeoutId = setTimeout(function () {
            if (settled) return;
            settled = true;
            try {
              if (label === 'framework-settings') {
                setServerSyncState('frameworkSettingsSyncState', { source: 'fallback', status: 'boot-timeout', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: label });
              } else if (label === 'task-framework-assignments') {
                setServerSyncState('taskFrameworkAssignmentsSyncState', { source: 'fallback', status: 'boot-timeout', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: label });
              } else if (label === 'day-block-templates') {
                setServerSyncState('dayBlockTemplatesSyncState', { source: 'fallback', status: 'boot-timeout', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: label });
              } else if (label === 'day-block-instances') {
                setServerSyncState('dayBlockInstancesSyncState', { source: 'fallback', status: 'boot-timeout', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: label });
              }
              renderServerSyncDiagnosticsSummary();
            } catch (_) {}
            resolve(null);
          }, timeoutMs);

          try {
            var result = typeof runner === 'function' ? runner() : null;
            Promise.resolve(result).then(function (value) {
              if (settled) return;
              settled = true;
              clearTimeout(timeoutId);
              resolve(value || null);
            }).catch(function (error) {
              if (settled) return;
              settled = true;
              clearTimeout(timeoutId);
              try { console.warn('[planner boot sync fallback]', label, error); } catch (_) {}
              resolve(null);
            });
          } catch (error) {
            if (settled) return;
            settled = true;
            clearTimeout(timeoutId);
            try { console.warn('[planner boot sync exception]', label, error); } catch (_) {}
            resolve(null);
          }
        });
      }

      function scheduleServerSyncBootstrapHydration() {
        if (!state.userId) return;
        if (state.serverSyncBootstrapInFlight) return;
        state.serverSyncBootstrapInFlight = true;
        setTimeout(function () {
          var chain = Promise.resolve();
          [
            { label: 'framework-settings', runner: hydrateFrameworkSettingsFromServer },
            { label: 'task-framework-assignments', runner: hydrateTaskFrameworkAssignmentsFromServer },
            { label: 'day-block-templates', runner: hydrateDayBlockTemplatesFromServer },
            { label: 'day-block-instances', runner: function () { return hydrateDayBlockInstancesForVisibleRange({ silent: true }); } }
          ].forEach(function (item) {
            chain = chain.then(function () {
              return runServerSyncBootstrapStepSafe(item.label, item.runner, { timeoutMs: 6500 });
            });
          });
          chain.then(function () {
            try { reduceLocalFallbackFootprint(); } catch (_) {}
            try { renderServerSyncDiagnosticsSummary(); } catch (_) {}
          }).finally(function () {
            state.serverSyncBootstrapInFlight = false;
          });
        }, 0);
      }

      function getWeekdayCodeForYmd(dayYmd) {
        var date = new Date(String(dayYmd || '') + 'T00:00:00');
        if (isNaN(date.getTime())) return 'MO';
        return ['SU','MO','TU','WE','TH','FR','SA'][date.getDay()] || 'MO';
      }

      function getMatchingDayBlocks(dayYmd) {
        var dayKey = String(dayYmd || '').trim();
        var loadedMap = state.dayBlockInstancesLoadedDates || Object.create(null);
        var instanceMap = state.dayBlockInstancesByDate || Object.create(null);
        if (dayKey && loadedMap[dayKey] && Array.isArray(instanceMap[dayKey])) {
          return instanceMap[dayKey].slice().sort(function (a, b) { return a.startMinutes - b.startMinutes; });
        }
        var weekday = getWeekdayCodeForYmd(dayYmd);
        return (state.dayBlockTemplates || []).filter(function (block) {
          return block && Array.isArray(block.days) && block.days.indexOf(weekday) >= 0;
        }).slice().sort(function (a, b) { return a.startMinutes - b.startMinutes; });
      }

      function getDayBlockDurationMinutes(block) {
        return Math.max(0, (Number(block && block.endMinutes) || 0) - (Number(block && block.startMinutes) || 0));
      }

      function getDayBlockCapacityMinutes(block) {
        var capacity = Math.max(Number(block && block.capacityMinutes) || 0, 0);
        return capacity > 0 ? capacity : getDayBlockDurationMinutes(block);
      }

      function inferTaskKindForBlockIntelligence(task, assignment) {
        var sourceText = [task && task.title, task && task.description, task && task.product, task && task.notes].filter(Boolean).join(' ').toLowerCase();
        if ((task && task.space_key) === 'personal') return 'personal';
        if (/\b(meeting|call|sync|zoom)\b|созвон|встреч|звонок|митинг/.test(sourceText)) return 'meetings';
        if (/почт|email|inbox|разобрат|админ|admin|telegram|ответ|счет|документ|таблиц/.test(sourceText)) return 'admin';
        return 'focus';
      }

      function getBlockLinkModeLabel(value) {
        return String(value || '').trim().toLowerCase() === 'hard' ? 'Жёсткая связь' : 'Мягкая связь';
      }

      function getTaskBlockIntelligence(task, assignment) {
        var normalized = normalizeTaskFrameworkAssignment(assignment || {});
        if (!(task && normalized.taskBlockId)) return null;
        var dayYmd = task && task.due_at ? formatYmdLocal(new Date(task.due_at)) : '';
        var block = null;
        if (dayYmd) {
          block = getMatchingDayBlocks(dayYmd).find(function (item) {
            return String(item && item.id || '') === String(normalized.taskBlockId) || String(item && item.templateId || '') === String(normalized.taskBlockId);
          }) || null;
        }
        if (!block) {
          block = (state.dayBlockTemplates || []).find(function (item) {
            return String(item && item.id || '') === String(normalized.taskBlockId);
          }) || null;
        }
        if (!block) return null;
        var dayTasks = dayYmd ? getScheduledTasksForDayBlocks(dayYmd) : [];
        var bundle = dayYmd ? getDayBlockTaskBundle(dayYmd, block, dayTasks) : null;
        var capacityMinutes = getDayBlockCapacityMinutes(block);
        var usedMinutes = bundle ? bundle.overlapMinutes : 0;
        var freeMinutes = Math.max(capacityMinutes - usedMinutes, 0);
        var overflowMinutes = Math.max(usedMinutes - capacityMinutes, 0);
        var taskEnergy = String(normalized.energy || '').trim().toLowerCase();
        var blockEnergy = String(block && block.energyType || '').trim().toLowerCase();
        var inferredKind = inferTaskKindForBlockIntelligence(task, normalized);
        var blockKind = String(block && block.kind || '').trim().toLowerCase();
        var energyMismatch = !!(taskEnergy && blockEnergy && taskEnergy !== blockEnergy);
        var kindMismatch = !!(blockKind && inferredKind && blockKind !== inferredKind);
        var scheduledWindow = getTaskScheduledWindowMinutes(task);
        var outsideBlock = !!(scheduledWindow && (scheduledWindow.startMinutes < (Number(block && block.startMinutes) || 0) || scheduledWindow.endMinutes > (Number(block && block.endMinutes) || 0)));
        return {
          task: task,
          assignment: normalized,
          block: block,
          bundle: bundle,
          capacityMinutes: capacityMinutes,
          usedMinutes: usedMinutes,
          freeMinutes: freeMinutes,
          overflowMinutes: overflowMinutes,
          energyMismatch: energyMismatch,
          kindMismatch: kindMismatch,
          inferredKind: inferredKind,
          blockKind: blockKind,
          outsideBlock: outsideBlock
        };
      }

      function getDayBlocksCapacityMinutes(dayYmd) {
        if (!(state.dayBlockSettings || getDefaultDayBlockSettings()).enabled || !(state.dayBlockSettings || getDefaultDayBlockSettings()).useForCapacity) return 0;
        return getMatchingDayBlocks(dayYmd).reduce(function (sum, block) { return sum + getDayBlockDurationMinutes(block); }, 0);
      }

      function getScheduledTasksForDayBlocks(dayYmd) {
        return getTasksForDay(dayYmd).filter(function (task) {
          var status = normalizeStatus(task && task.status);
          return status === STATUS.PLANNED || status === STATUS.DONE;
        });
      }

      function getTaskScheduledWindowMinutes(task) {
        if (!(task && task.due_at)) return null;
        var due = new Date(task.due_at);
        if (isNaN(due.getTime())) return null;
        var startMinutes = due.getHours() * 60 + due.getMinutes();
        var duration = Math.max(Number(getEffectivePlannedMinutesClient(task)) || 0, getDurationStepMinutes());
        return {
          startMinutes: startMinutes,
          endMinutes: startMinutes + duration,
          durationMinutes: duration
        };
      }

      function getTaskDayBlockOverlapMinutes(task, block) {
        var windowMeta = getTaskScheduledWindowMinutes(task);
        if (!windowMeta || !block) return 0;
        return Math.max(0, Math.min(windowMeta.endMinutes, Number(block.endMinutes) || 0) - Math.max(windowMeta.startMinutes, Number(block.startMinutes) || 0));
      }

      function getDayBlockTaskBundle(dayYmd, block, dayTasks) {
        var tasks = Array.isArray(dayTasks) ? dayTasks : getScheduledTasksForDayBlocks(dayYmd);
        var matchingTasks = [];
        var overlapMinutes = 0;
        var doneCount = 0;
        var linkedCount = 0;
        var hardLinkedCount = 0;
        var energyMismatchCount = 0;
        var kindMismatchCount = 0;
        tasks.forEach(function (task) {
          var overlap = getTaskDayBlockOverlapMinutes(task, block);
          if (overlap <= 0) return;
          matchingTasks.push(task);
          overlapMinutes += overlap;
          if (normalizeStatus(task.status) === STATUS.DONE) doneCount += 1;
          var assignment = getTaskFrameworkAssignment(task && task.id);
          var isLinked = String(assignment && assignment.taskBlockId || '') === String(block && block.id || '') || String(assignment && assignment.taskBlockId || '') === String(block && block.templateId || '');
          if (isLinked) {
            linkedCount += 1;
            if (String(assignment && assignment.taskBlockLinkMode || '').trim().toLowerCase() === 'hard') hardLinkedCount += 1;
          }
          var taskEnergy = String(assignment && assignment.energy || '').trim().toLowerCase();
          var blockEnergy = String(block && block.energyType || '').trim().toLowerCase();
          if (taskEnergy && blockEnergy && taskEnergy !== blockEnergy) energyMismatchCount += 1;
          var inferredKind = inferTaskKindForBlockIntelligence(task, assignment);
          var blockKind = String(block && block.kind || '').trim().toLowerCase();
          if (blockKind && inferredKind && blockKind !== inferredKind) kindMismatchCount += 1;
        });
        var blockMinutes = getDayBlockDurationMinutes(block);
        var capacityMinutes = getDayBlockCapacityMinutes(block);
        return {
          block: block,
          tasks: matchingTasks,
          taskCount: matchingTasks.length,
          doneCount: doneCount,
          overlapMinutes: overlapMinutes,
          blockMinutes: blockMinutes,
          capacityMinutes: capacityMinutes,
          freeMinutes: Math.max(capacityMinutes - overlapMinutes, 0),
          overflowMinutes: Math.max(overlapMinutes - capacityMinutes, 0),
          linkedCount: linkedCount,
          hardLinkedCount: hardLinkedCount,
          energyMismatchCount: energyMismatchCount,
          kindMismatchCount: kindMismatchCount
        };
      }

      function getDayBlocksDaySummary(dayYmd) {
        var blocks = getMatchingDayBlocks(dayYmd);
        var tasks = getScheduledTasksForDayBlocks(dayYmd);
        var totalBlockMinutes = 0;
        var coveredTaskIds = Object.create(null);
        var overlapMinutes = 0;
        var overflowMinutes = 0;
        var freeMinutes = 0;
        var bundleList = blocks.map(function (block) {
          var bundle = getDayBlockTaskBundle(dayYmd, block, tasks);
          totalBlockMinutes += bundle.capacityMinutes;
          overlapMinutes += bundle.overlapMinutes;
          overflowMinutes += bundle.overflowMinutes;
          freeMinutes += bundle.freeMinutes;
          bundle.tasks.forEach(function (task) { coveredTaskIds[String(task.id || '')] = true; });
          return bundle;
        });
        var outsideTasks = tasks.filter(function (task) { return !coveredTaskIds[String(task.id || '')]; });
        var outsideMinutes = outsideTasks.reduce(function (sum, task) { return sum + (Number(getEffectivePlannedMinutesClient(task)) || 0); }, 0);
        var tone = 'normal';
        if (overflowMinutes > 0) tone = 'overflow';
        else if (outsideMinutes > 0) tone = 'warning';
        return {
          dayYmd: dayYmd,
          blocks: blocks,
          tasks: tasks,
          bundles: bundleList,
          blockCount: blocks.length,
          taskCount: tasks.length,
          totalBlockMinutes: totalBlockMinutes,
          overlapMinutes: overlapMinutes,
          freeMinutes: freeMinutes,
          overflowMinutes: overflowMinutes,
          outsideTasks: outsideTasks,
          outsideCount: outsideTasks.length,
          outsideMinutes: outsideMinutes,
          tone: tone
        };
      }

      function getDayBlocksTemporalState(dayYmd, blocks) {
        var list = Array.isArray(blocks) ? blocks : getMatchingDayBlocks(dayYmd);
        var now = new Date();
        if (dayYmd !== formatYmdLocal(now)) return { currentBlock: null, nextBlock: list[0] || null, completedCount: 0, isCurrentDay: false };
        var currentMinutes = now.getHours() * 60 + now.getMinutes();
        var currentBlock = null;
        var nextBlock = null;
        var completedCount = 0;
        list.forEach(function (block) {
          if (currentMinutes >= block.endMinutes) completedCount += 1;
          if (!currentBlock && currentMinutes >= block.startMinutes && currentMinutes < block.endMinutes) currentBlock = block;
          if (!nextBlock && currentMinutes < block.startMinutes) nextBlock = block;
        });
        return { currentBlock: currentBlock, nextBlock: nextBlock, completedCount: completedCount, isCurrentDay: true };
      }

