function normalizeInboxStageServer(value) {
  const candidate = String(value || '').trim().toLowerCase();
  return ["new", "triaged", "plan", "projects", "archive"].includes(candidate) ? candidate : "";
}

function sanitizeInboxStageMapServer(rawMap) {
  const safe = {};
  if (!rawMap || typeof rawMap !== 'object') return safe;
  Object.keys(rawMap).forEach((taskId) => {
    const key = String(taskId || '').trim();
    const stage = normalizeInboxStageServer(rawMap[taskId]);
    if (key && stage) safe[key] = stage;
  });
  return safe;
}

async function listInboxStagesForUser(env, userId) {
  await ensureTasksSchema(env);
  const rows = await env.DB.prepare(`
    SELECT task_id, stage, updated_at
    FROM inbox_task_stages
    WHERE user_id = ?
    ORDER BY updated_at DESC, task_id ASC
  `).bind(String(userId)).all();
  const stageMap = {};
  (rows.results || []).forEach((row) => {
    const taskId = String(row.task_id || '').trim();
    const stage = normalizeInboxStageServer(row.stage);
    if (taskId && stage) stageMap[taskId] = stage;
  });
  return stageMap;
}

async function upsertInboxStageRecord(env, { userId, taskId, stage }) {
  await ensureTasksSchema(env);
  const normalizedStage = normalizeInboxStageServer(stage);
  const safeUserId = String(userId || '').trim();
  const safeTaskId = String(taskId || '').trim();
  if (!safeUserId || !safeTaskId || !normalizedStage) throw new Error('user_id, task_id and stage are required');
  const now = new Date().toISOString();
  await env.DB.prepare(`
    INSERT INTO inbox_task_stages (user_id, task_id, stage, created_at, updated_at)
    VALUES (?, ?, ?, ?, ?)
    ON CONFLICT(user_id, task_id) DO UPDATE SET
      stage = excluded.stage,
      updated_at = excluded.updated_at
  `).bind(safeUserId, safeTaskId, normalizedStage, now, now).run();
}

async function deleteInboxStageRecord(env, { userId, taskId }) {
  await ensureTasksSchema(env);
  const safeUserId = String(userId || '').trim();
  const safeTaskId = String(taskId || '').trim();
  if (!safeUserId || !safeTaskId) throw new Error('user_id and task_id are required');
  await env.DB.prepare(`DELETE FROM inbox_task_stages WHERE user_id = ? AND task_id = ?`).bind(safeUserId, safeTaskId).run();
}

async function mergeInboxStageMapForUser(env, { userId, stageMap }) {
  await ensureTasksSchema(env);
  const safeUserId = String(userId || '').trim();
  if (!safeUserId) throw new Error('user_id is required');
  const safeMap = sanitizeInboxStageMapServer(stageMap);
  const now = new Date().toISOString();
  const keys = Object.keys(safeMap);
  for (const taskId of keys) {
    await env.DB.prepare(`
      INSERT INTO inbox_task_stages (user_id, task_id, stage, created_at, updated_at)
      VALUES (?, ?, ?, ?, ?)
      ON CONFLICT(user_id, task_id) DO UPDATE SET
        stage = excluded.stage,
        updated_at = excluded.updated_at
    `).bind(safeUserId, taskId, safeMap[taskId], now, now).run();
  }
  return listInboxStagesForUser(env, safeUserId);
}

async function clearArchivedInboxStagesForUser(env, userId) {
