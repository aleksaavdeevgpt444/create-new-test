        if (!key) return normalizeTaskFrameworkAssignment({});
        var source = state.taskFrameworkAssignments && state.taskFrameworkAssignments[key] ? state.taskFrameworkAssignments[key] : {};
        return normalizeTaskFrameworkAssignment(source);
