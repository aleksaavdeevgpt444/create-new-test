      async function refreshEditorAi(mode) {
        if (!state.editorTaskId) return;
        if (mode === 'product') {
          return improveTaskProductWithAi('editor');
        }
        var taskId = state.editorTaskId;
        var recurringTask = findTaskById(taskId);
        if (mode === 'project') {
          state.requestState = 'обновление-ai-проект';
          updateDebugInfo();
          showError('');
          var beforeAiSnapshot = getEditorAiFieldSnapshot();
          try {
            var aiData = await requestAiEditorAssist();
            var localProjectFallback = inferProjectSuggestionFromText({
              title: String(byId('editorTitleInput') && byId('editorTitleInput').value || '').trim(),
              task_product: String((byId('editorProductInput') && byId('editorProductInput').value) || '').trim(),
              description: String(byId('editorDescriptionInput') && byId('editorDescriptionInput').value || '').trim(),
              project_name: ''
            });
            var nextProject = normalizeAiProjectSuggestion(aiData && aiData.ai && aiData.ai.project_suggestion || '', localProjectFallback || '');
            if (!nextProject) {
              showError('AI не нашёл уверенный проект для подстановки.');
              state.requestState = 'loaded';
              updateDebugInfo();
              return;
            }
            setProjectValueToUi('editor', nextProject);
            if (isRecurringEditorTask(recurringTask)) {
              scheduleRecurringEditorAiAutoApply('project_name', 'Проект', beforeAiSnapshot);
            } else {
              queueEditorAutoSave();
              showSuccess('Проект задачи уточнён AI-подсказкой.' + buildAiSuccessSuffix(aiData));
            }
            state.requestState = 'loaded';
            updateDebugInfo();
          } catch (error) {
            state.requestState = 'error';
            updateDebugInfo();
            reportAiClientFailure('ai-refresh-editor', error, { mode: mode || 'project', task_id: taskId });
            showError(getAiUiErrorMessage(error, 'Не удалось обновить AI-поля задачи. Ошибка отправлена в Telegram.'));
          }
          return;
        }
        if (mode === 'description') {
          state.requestState = 'обновление-ai-описание';
          updateDebugInfo();
          showError('');
          var beforeDescriptionSnapshot = getEditorAiFieldSnapshot();
          try {
            var descriptionAiData = await requestAiEditorAssist();
            var nextDescription = String(descriptionAiData && descriptionAiData.ai && descriptionAiData.ai.description_suggestion || '').trim();
            if (!nextDescription) {
              showError('AI не нашёл уверенное описание для подстановки.');
              state.requestState = 'loaded';
              updateDebugInfo();
              return;
            }
            if (byId('editorDescriptionInput')) {
              byId('editorDescriptionInput').value = nextDescription;
              syncTaskDescriptionInputAutoHeight('editor');
            }
            scheduleDynamicDrawerLayoutRefresh('editor');
            renderEditorProductSummary(recurringTask);
            renderEditorExecutionReadiness(recurringTask);
            renderEditorTaskHelpSummary(recurringTask);
            if (isRecurringEditorTask(recurringTask)) {
              scheduleRecurringEditorAiAutoApply('description', 'Описание', beforeDescriptionSnapshot);
            } else {
              queueEditorAutoSave();
              showSuccess('Описание дополнено AI-подсказкой.' + buildAiSuccessSuffix(descriptionAiData));
            }
            state.requestState = 'loaded';
            updateDebugInfo();
          } catch (error) {
            state.requestState = 'error';
            updateDebugInfo();
            reportAiClientFailure('ai-refresh-editor', error, { mode: mode || 'description', task_id: taskId });
            showError(getAiUiErrorMessage(error, 'Не удалось сгенерировать описание. Ошибка отправлена в Telegram.'));
          }
          return;
        }
        if (isRecurringEditorTask(recurringTask)) {
          showError('Для повторяющихся задач AI-обновление проекта, названия и продукта нужно применять через выбор области сохранения серии.');
          return;
        }

        var title = String(byId('editorTitleInput').value || '').trim();
        var projectName = getProjectValueFromUi('editor');
        var taskProduct = String((byId('editorProductInput') && byId('editorProductInput').value) || '').trim();
        var description = String(byId('editorDescriptionInput').value || '').trim();
        var priorityManual = byId('editorPrioritySelect') ? byId('editorPrioritySelect').value : '';
        var durationValue = snapDurationToStep(byId('editorDurationInput').value || 60);
        var plannedMinutesManual = getEditorPlannedMinutesManualValue();
        var telegramNotifyType = byId('editorTelegramNotifyTypeSelect') ? String(byId('editorTelegramNotifyTypeSelect').value || 'auto').trim() : 'auto';
        var actualMinutes = normalizeMinutesInputValue(byId('editorActualMinutesInput') && byId('editorActualMinutesInput').value);
        var showInMonth = byId('editorShowInMonthCheckbox') ? (byId('editorShowInMonthCheckbox').checked ? 1 : 0) : 0;
        var spaceKey = byId('editorSpaceSelect') ? String(byId('editorSpaceSelect').value || state.activeSpaceKey || 'work').trim() : String(state.activeSpaceKey || 'work');
        var recurrencePayload = getRecurrencePayloadFromScope('editor');

        if (!title) {
          showError('Название задачи не может быть пустым.');
          return;
        }

        state.requestState = 'обновление-ai';
        updateDebugInfo();
        showError('');

        try {
          await updateTaskMeta(taskId, {
            title: title,
            project_name: projectName || 'Без проекта',
            priority_manual: priorityManual || null,
            task_product: taskProduct || '',
            description: description || '',
            duration_minutes: durationValue,
            planned_minutes_manual: plannedMinutesManual,
            actual_minutes: actualMinutes,
            show_in_month: showInMonth,
            telegram_notify_type: telegramNotifyType === 'auto' ? null : telegramNotifyType,
          space_key: spaceKey,
            recurrence_type: recurrencePayload.type,
            recurrence_rule: recurrencePayload.rule,
            recurrence_enabled: recurrencePayload.enabled
          });

          await requestJson('/tasks/refresh-ai', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ task_id: taskId, user_id: state.userId }),
            __meta: { reportServerErrors: true, requestName: 'ai-refresh-editor', timeoutMs: AI_REQUEST_TIMEOUT_MS }
          });

          await loadPlanner();
          resetEditorTaskHelpState();
          openEditor(taskId);
          if (mode === 'project') {
            var current = findTaskById(taskId);
            var nextProjectGuess = normalizeAiProjectSuggestion(current && current.ai_project_guess, '');
            if (nextProjectGuess) setProjectValueToUi('editor', nextProjectGuess);
            else showError('AI не нашёл уверенный проект для подстановки.');
          }
          if (mode === 'product') {
            var aiData = await requestAiEditorAssist();
            if (aiData && aiData.ai && aiData.ai.product_suggestion && byId('editorProductInput')) {
              byId('editorProductInput').value = normalizeAiTaskProductSuggestion({ title: byId('editorTitleInput') && byId('editorTitleInput').value, description: byId('editorDescriptionInput') && byId('editorDescriptionInput').value, task_product: byId('editorProductInput') && byId('editorProductInput').value }, aiData.ai.product_suggestion, '');
              syncTaskProductInputAutoHeight('editor');
              queueEditorAutoSave();
            }
          }
        } catch (error) {
          state.requestState = 'error';
          updateDebugInfo();
          reportAiClientFailure('ai-refresh-editor', error, { mode: mode || 'all', task_id: taskId });
          showError(getAiUiErrorMessage(error, 'Не удалось обновить AI-поля задачи. Ошибка отправлена в Telegram.'));
        }
      }

