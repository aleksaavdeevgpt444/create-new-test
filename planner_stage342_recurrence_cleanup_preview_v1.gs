        if (/(inbox hub|хаб записей|хаб идей|умные заметки)/i.test(source)) return 'Inbox Hub';
        if (/(wildberries|\bwb\b|\bвб\b|рнп)/i.test(source) && /(api|отч[её]т|выгрузк|расч[её]т|анома|подсветк)/i.test(source)) return 'Отчёт API';
