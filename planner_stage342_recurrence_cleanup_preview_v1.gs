      function normalizeAiTaskProductSuggestion(payload, suggestion, fallbackProduct) {
        var fallback = fallbackProduct === undefined || fallbackProduct === null ? '' : String(fallbackProduct).trim();
        var raw = suggestion === undefined || suggestion === null ? '' : String(suggestion).trim();
        if (!raw) return fallback;
        var normalized = raw.replace(/\s+/g, ' ').trim();
        var title = payload && payload.title ? String(payload.title).trim() : '';
        var description = payload && payload.description ? String(payload.description).trim() : '';
        var titleCompare = title.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
        var descriptionCompare = description.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
        var productCompare = normalized.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
        if (!productCompare) return fallback;
        if ((titleCompare && productCompare === titleCompare) || (descriptionCompare && productCompare === descriptionCompare)) return fallback;
        return normalized;
      }

      async function applyAiToCreateField(mode) {
        if (mode === 'product') {
          return improveTaskProductWithAi('create');
        }
        var createAiSessionSeqAtRequestStart = bumpAiSessionSeq('create');
        state.requestState = 'ai-create';
        updateDebugInfo();
        showError('');
        try {
          var data = await requestAiCreateAssist();
          if (createAiSessionSeqAtRequestStart !== getAiSessionSeq('create')) return;
          var ai = data.ai || {};
          if (mode === 'project' || mode === 'all') {
            var directProjectSuggestion = String(ai.project_suggestion || '').trim();
            if (directProjectSuggestion) setProjectValueToUi('create', directProjectSuggestion);
            else if (mode === 'project') showError('AI не нашёл уверенный проект для подстановки.');
          }
          if (mode === 'description' || mode === 'all') {
            if (ai.description_suggestion) {
              byId('createDescriptionInput').value = ai.description_suggestion;
              syncTaskDescriptionInputAutoHeight('create');
            }
          }
          if (mode === 'all') {
            if (ai.title_suggestion && byId('createTitleInput')) {
              byId('createTitleInput').value = ai.title_suggestion;
              syncCreateTitleInputAutoHeight();
            }
            if (ai.product_suggestion && byId('createProductInput')) {
              byId('createProductInput').value = ai.product_suggestion;
              syncTaskProductInputAutoHeight('create');
            }
          }
          scheduleDynamicDrawerLayoutRefresh('create');
          state.requestState = 'loaded';
          updateDebugInfo();
          showSuccess('AI-подсказка применена.' + buildAiSuccessSuffix(data));
        } catch (error) {
          if (createAiSessionSeqAtRequestStart !== getAiSessionSeq('create')) return;
          state.requestState = 'error';
          updateDebugInfo();
          reportAiClientFailure('ai-create-field-' + mode, error, { mode: mode || 'all' });
          showError(getAiUiErrorMessage(error, 'Не удалось получить AI-подсказку. Ошибка отправлена в Telegram.'));
        }
      }

      async function createTaskFromDrawer() {
        if (!state.userId) {
          showError('Сначала укажи user_id.');
          return;
        }
        var saveBtn = byId('createSaveBtn');
        var title = String(byId('createTitleInput').value || '').trim();
        var projectName = getProjectValueFromUi('create');
        var taskProduct = String((byId('createProductInput') && byId('createProductInput').value) || '').trim();
        var priorityManual = byId('createPrioritySelect') ? String(byId('createPrioritySelect').value || '').trim() : '';
        var telegramNotifyType = byId('createTelegramNotifyTypeSelect') ? String(byId('createTelegramNotifyTypeSelect').value || 'auto').trim() : 'auto';
        var spaceKey = byId('createSpaceSelect') ? String(byId('createSpaceSelect').value || getDefaultCreateSpaceKey()).trim() : getDefaultCreateSpaceKey();
        var description = String(byId('createDescriptionInput').value || '').trim();
        var dateValue = parseDisplayDateToYmd(String(byId('createDateInput').value || '').trim());
        var timeValue = String(byId('createTimeInput').value || '').trim();
        var durationValue = String(byId('createDurationInput').value || '').trim();
        var recurrencePayload = getRecurrencePayloadFromScope('create');
        if (!title) {
          showError('Введи название задачи.');
          return;
        }
        var dueAt = null;
        if (dateValue && timeValue) {
          dueAt = makeDueAtIso(dateValue, timeValue);
        }
        state.requestState = 'создание-задачи';
        updateDebugInfo();
        showError('');
        if (saveBtn) saveBtn.disabled = true;

        var created = null;
        try {
          created = await requestJson('/tasks/create', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              user_id: state.userId,
              title: title,
              project_name: projectName || 'Без проекта',
              task_product: taskProduct || '',
              priority_manual: priorityManual || null,
              telegram_notify_type: telegramNotifyType === 'auto' ? null : telegramNotifyType,
              space_key: spaceKey || 'work',
              description: description || '',
              due_at: dueAt,
              duration_minutes: Math.max(state.gridStepMinutes, Number(durationValue || 60)),
              planned_minutes_manual: null,
              recurrence_type: recurrencePayload.type,
              recurrence_rule: recurrencePayload.rule,
              recurrence_enabled: recurrencePayload.enabled,
              source: state.authMode === 'telegram' ? 'mini-app' : 'web-app'
            })
          });
        } catch (error) {
          state.requestState = 'error';
          updateDebugInfo();
          if (saveBtn) saveBtn.disabled = false;
          showError('Не удалось создать задачу: ' + String(error));
          return;
        }

        var createdTask = created && created.item ? created.item : null;
        var taskId = createdTask && createdTask.id ? createdTask.id : null;

        if (createdTask) {
          applyCreatedTaskLocally(createdTask);
        }

        closeCreateDrawer();
        state.requestState = 'loaded';
        updateDebugInfo();
        if (saveBtn) saveBtn.disabled = false;

        if (taskId && state.createChecklistDraft && state.createChecklistDraft.length) {
          Promise.all((state.createChecklistDraft || []).map(function (text) {
            return requestJson('/tasks/checklist/add', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ task_id: taskId, user_id: state.userId, text: text })
            });
          })).then(function () {
            return loadPlanner();
          }).catch(function (error) {
            showError('Задача создана, но чек-лист не удалось сохранить полностью: ' + String(error));
          });
        } else {
          loadPlanner().catch(function () {});
        }

        if (taskId) {
          requestJson('/tasks/refresh-ai', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ task_id: taskId, user_id: state.userId })
          }).then(function () {
            return loadPlanner();
          }).catch(function () {});
        }
      }

      function syncStickyOffsets() {
        var shell = byId('weekNavShell');
        if (!shell) return;
        var height = shell.getBoundingClientRect().height || 84;
        document.documentElement.style.setProperty('--week-nav-sticky-offset', height + 'px');
        document.documentElement.style.setProperty('--calendar-sticky-top', (height + 22) + 'px');
      }

      function formatAiDiagnosticsTime(value) {
        if (!value) return '—';
        var date = new Date(value);
        if (isNaN(date.getTime())) return String(value);
        return date.toLocaleString();
      }

      function formatAiFallbackReasonLabel(reason) {
        var safe = String(reason || '').trim().toLowerCase();
        if (!safe) return 'ошибка';
        if (safe === 'timeout') return 'таймаут';
        if (safe === 'quota_exceeded') return 'квота';
        if (safe === 'rate_limited') return 'лимит частоты';
        if (safe === 'empty_response') return 'пустой ответ';
        if (safe === 'invalid_response') return 'некорректный JSON';
        if (safe === 'not_configured') return 'не настроен';
        return safe.replace(/_/g, ' ');
      }

      function renderAiDiagnostics(snapshot) {
        state.aiDiagnostics = snapshot || null;
        var statusNode = byId('aiDiagnosticsStatus');
        var tokenNode = byId('aiTokenStatusValue');
        var botNode = byId('aiTelegramBotStatusValue');
        var chatNode = byId('aiTelegramChatCountValue');
        var successNode = byId('aiLastSuccessValue');
        var errorNode = byId('aiLastErrorValue');
        var errorsBox = byId('aiDiagnosticsErrorsBox');
        if (!statusNode || !tokenNode || !botNode || !chatNode || !successNode || !errorNode || !errorsBox) return;
        if (!snapshot) {
          statusNode.textContent = 'AI-диагностика ещё не загружена.';
          tokenNode.textContent = '—';
          botNode.textContent = '—';
          chatNode.textContent = '—';
          successNode.textContent = '—';
          errorNode.textContent = '—';
          errorsBox.textContent = 'Ошибки ещё не загружены.';
          return;
        }
        var geminiKeyText = snapshot.token && snapshot.token.configured ? ('Gemini/Gemma: настроен (' + (snapshot.token.masked || 'есть') + ')') : 'Gemini/Gemma: не настроен';
        var groqKeyText = snapshot.token && snapshot.token.groq_configured ? ('Groq: настроен (' + (snapshot.token.groq_masked || 'есть') + ')') : 'Groq: не настроен';
        tokenNode.textContent = geminiKeyText + ' · ' + groqKeyText;
        botNode.textContent = snapshot.telegram && snapshot.telegram.bot_configured ? 'настроен' : 'не настроен';
        chatNode.textContent = snapshot.telegram && Number.isFinite(Number(snapshot.telegram.report_chat_count)) ? String(snapshot.telegram.report_chat_count) : '0';

        var latestSuccessDetails = snapshot.latest_success && snapshot.latest_success.details ? snapshot.latest_success.details : null;
        var latestErrorDetails = snapshot.latest_errors && snapshot.latest_errors.length && snapshot.latest_errors[0].details ? snapshot.latest_errors[0].details : null;
        var latestFallbackDetails = snapshot.latest_soft_fallback && snapshot.latest_soft_fallback.details ? snapshot.latest_soft_fallback.details : null;
        var successParts = [];
        if (snapshot.latest_success) successParts.push(snapshot.latest_success.endpoint || 'ai');
        if (latestSuccessDetails && latestSuccessDetails.ai_provider) successParts.push(String(latestSuccessDetails.ai_provider));
        if (latestSuccessDetails && latestSuccessDetails.ai_model) successParts.push(String(latestSuccessDetails.ai_model));
        if (latestSuccessDetails && latestSuccessDetails.ai_fallback) successParts.push('fallback: ' + formatAiFallbackReasonLabel(latestSuccessDetails.ai_fallback_reason));
        if (snapshot.latest_success) successParts.push(formatAiDiagnosticsTime(snapshot.latest_success.created_at));
        successNode.textContent = successParts.length ? successParts.join(' · ') : 'ещё не было';

        var errorParts = [];
        if (snapshot.latest_errors && snapshot.latest_errors.length) errorParts.push(snapshot.latest_errors[0].endpoint || 'ai');
        if (latestErrorDetails && latestErrorDetails.provider_label) errorParts.push(String(latestErrorDetails.provider_label));
        if (snapshot.latest_errors && snapshot.latest_errors.length) errorParts.push(String(snapshot.latest_errors[0].status || 'error'));
        if (snapshot.latest_errors && snapshot.latest_errors.length) errorParts.push(formatAiDiagnosticsTime(snapshot.latest_errors[0].created_at));
        errorNode.textContent = errorParts.length ? errorParts.join(' · ') : 'ошибок не найдено';

        var providerLabel = snapshot.provider && snapshot.provider.chain_label ? snapshot.provider.chain_label : 'Gemini → Gemma → Qwen';
        var timeoutPart = snapshot.provider ? ('Цепочка: ' + String(snapshot.provider.chain_timeout_ms || '—') + 'ms · провайдер: ' + String(snapshot.provider.provider_timeout_ms || '—') + 'ms') : '';
        statusNode.textContent = 'AI provider chain: ' + providerLabel + '. ' + timeoutPart;

        var lines = [];
        if (snapshot.latest_soft_fallback) {
          lines.push('Последний soft fallback: [' + formatAiDiagnosticsTime(snapshot.latest_soft_fallback.created_at) + '] ' + (snapshot.latest_soft_fallback.endpoint || 'ai') + ' — ' + (snapshot.latest_soft_fallback.message || '')); 
          if (latestFallbackDetails && latestFallbackDetails.ai_provider_error) lines.push('Причина fallback: ' + latestFallbackDetails.ai_provider_error);
          if (latestFallbackDetails && latestFallbackDetails.ai_fallback_reason) lines.push('Код fallback: ' + formatAiFallbackReasonLabel(latestFallbackDetails.ai_fallback_reason));
          lines.push('');
        }
        if (snapshot.provider_attempts && snapshot.provider_attempts.length) {
          lines.push('Последние попытки цепочки:');
          snapshot.provider_attempts.forEach(function (item, index) {
            var details = item && item.details ? item.details : null;
            var row = (index + 1) + '. [' + formatAiDiagnosticsTime(item.created_at) + '] ' + (details && details.provider_label ? details.provider_label : (item.endpoint || 'ai-provider'));
            if (details && details.model) row += ' · ' + String(details.model);
            if (item && item.status) row += ' · ' + String(item.status);
            if (details && Number.isFinite(Number(details.duration_ms))) row += ' · ' + String(Math.round(Number(details.duration_ms))) + 'ms';
            if (item && item.message) row += ' — ' + item.message;
            lines.push(row);
          });
          lines.push('');
        }
        if (snapshot.latest_errors && snapshot.latest_errors.length) {
          lines.push('Последние ошибки:');
          snapshot.latest_errors.forEach(function (item, index) {
            var line = (index + 1) + '. [' + formatAiDiagnosticsTime(item.created_at) + '] ' + (item.endpoint || 'ai');
            if (item.operation) line += ' / ' + item.operation;
            if (item.status) line += ' / ' + item.status;
            if (item.message) line += ' — ' + item.message;
            lines.push(line);
          });
        }
        errorsBox.textContent = lines.length ? lines.join(String.fromCharCode(10)) : 'Ошибок AI в диагностическом логе пока нет.';
      }

      function formatAiLimitStatusLabel(entry) {
        if (!entry) return '—';
        if (entry.status === 'available') return 'доступен';
        if (entry.status === 'not_configured') return 'не настроен';
        if (entry.status === 'quota_exceeded') return 'ограничен квотой';
        if (entry.status === 'rate_limited') return 'временное ограничение';
        if (entry.status === 'timeout') return 'таймаут';
        if (entry.status === 'invalid_response') return 'некорректный ответ';
        if (entry.status === 'provider_unavailable') return 'временно недоступен';
        if (entry.status === 'error') return 'ошибка проверки';
        return entry.status || '—';
      }

      function formatAiLimitStatusHint(entry) {
        if (!entry) return '';
        if (entry.status === 'available') return 'Пробный запрос прошёл успешно.';
        if (entry.status === 'not_configured') return entry.message || 'Провайдер не настроен.';
        if (entry.status === 'quota_exceeded') return 'Провайдер по последней проверке сообщил об ограничении квоты или дневного лимита. Это не точный счётчик остатка токенов.';
        if (entry.status === 'rate_limited') return 'Провайдер по последней проверке временно ограничил частоту запросов. Это не означает, что токены закончились.';
        if (entry.status === 'timeout') return 'Провайдер не ответил вовремя на пробный запрос.';
        if (entry.status === 'invalid_response') return 'Провайдер вернул пустой или некорректный JSON-ответ.';
        if (entry.status === 'provider_unavailable') return 'Провайдер или модель временно вернули внутреннюю ошибку. Это не блокирует всю AI-цепочку, если доступны другие провайдеры.';
        return entry.message || 'Не удалось подтвердить доступность провайдера.';
      }

      function renderAiLimits(snapshot) {
        state.aiLimits = snapshot || null;
        var statusNode = byId('aiLimitsStatus');
        var geminiNode = byId('aiGeminiLimitsValue');
        var gemmaNode = byId('aiGemmaLimitsValue');
        var qwenNode = byId('aiQwenLimitsValue');
        var checkedNode = byId('aiLimitsCheckedAtValue');
        var noteNode = byId('aiLimitsNote');
        if (!statusNode || !geminiNode || !gemmaNode || !qwenNode || !checkedNode || !noteNode) return;
        if (!snapshot) {
          statusNode.textContent = 'Проверка лимитов ещё не запускалась.';
          geminiNode.textContent = '—';
          gemmaNode.textContent = '—';
          qwenNode.textContent = '—';
          checkedNode.textContent = '—';
          noteNode.textContent = 'Пока нет данных по лимитам.';
          return;
        }
        var gemini = snapshot.gemini || null;
        var gemma = snapshot.gemma || null;
        var qwen = snapshot.qwen || null;
        geminiNode.textContent = formatAiLimitStatusLabel(gemini) + (gemini && gemini.model ? (' · ' + gemini.model) : '') + (gemini ? (' · ' + formatAiLimitStatusHint(gemini)) : '');
        gemmaNode.textContent = formatAiLimitStatusLabel(gemma) + (gemma && gemma.model ? (' · ' + gemma.model) : '') + (gemma ? (' · ' + formatAiLimitStatusHint(gemma)) : '');
        qwenNode.textContent = formatAiLimitStatusLabel(qwen) + (qwen && qwen.model ? (' · ' + qwen.model) : '') + (qwen ? (' · ' + formatAiLimitStatusHint(qwen)) : '');
        checkedNode.textContent = formatAiDiagnosticsTime(snapshot.checked_at);
        var okCount = 0;
        if (gemini && gemini.status === 'available') okCount += 1;
        if (gemma && gemma.status === 'available') okCount += 1;
        if (qwen && qwen.status === 'available') okCount += 1;
        if (okCount === 3) {
          statusNode.textContent = 'Все 3 AI-провайдера доступны.';
        } else if (okCount > 0) {
          statusNode.textContent = 'Доступно ' + String(okCount) + ' из 3 AI-провайдеров.';
        } else {
          statusNode.textContent = 'Доступность AI-провайдеров по последней проверке не подтверждена. Это не равно исчерпанию всех токенов.';
        }
        noteNode.textContent = snapshot.note || 'Это проверка доступности провайдеров по пробному запросу, а не точный остаток токенов или квоты. Временная ошибка отдельной модели не означает поломку всей цепочки AI. Точный расход смотри в Google AI Studio и Groq dashboard.';
      }

      function loadAiLimits(options) {
        options = options || {};
        var refreshBtn = byId('refreshAiLimitsBtn');
        state.aiLimitsLoading = true;
        if (refreshBtn) refreshBtn.disabled = true;
        if (options.silent !== true) {
          var statusNode = byId('aiLimitsStatus');
          if (statusNode) statusNode.textContent = 'Проверяю лимиты AI...';
        }
