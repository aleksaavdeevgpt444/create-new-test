      function getTaskAssignmentDistribution(tasks) {
        var distribution = { oneThreeFive: { big: 0, medium: 0, small: 0 }, eisenhower: { important_urgent: 0, important_not_urgent: 0, not_important_urgent: 0, not_important_not_urgent: 0 }, abcde: { A: 0, B: 0, C: 0, D: 0, E: 0 }, energy: { high: 0, medium: 0, low: 0 }, blockAssigned: 0, frameworkAssigned: 0 };
        (tasks || []).forEach(function (task) {
          var assignment = getTaskFrameworkAssignment(task && task.id);
          if (!assignment) return;
          if (assignment.primaryFramework) distribution.frameworkAssigned += 1;
          if (assignment.taskBlockId) distribution.blockAssigned += 1;
          if (assignment.dayPattern && distribution.oneThreeFive[assignment.dayPattern] !== undefined) distribution.oneThreeFive[assignment.dayPattern] += 1;
          if (assignment.eisenhower && distribution.eisenhower[assignment.eisenhower] !== undefined) distribution.eisenhower[assignment.eisenhower] += 1;
          if (assignment.abcde && distribution.abcde[assignment.abcde] !== undefined) distribution.abcde[assignment.abcde] += 1;
          if (assignment.energy && distribution.energy[assignment.energy] !== undefined) distribution.energy[assignment.energy] += 1;
        });
        return distribution;
      }

