        return {
          role: ['author','manager','creator','project','knowledge','operations','personal'].indexOf(String(source.role || '').trim()) >= 0 ? String(source.role).trim() : defaults.role,
          workload: ['incoming','projects','mixed','routine','creative'].indexOf(String(source.workload || '').trim()) >= 0 ? String(source.workload).trim() : defaults.workload,
