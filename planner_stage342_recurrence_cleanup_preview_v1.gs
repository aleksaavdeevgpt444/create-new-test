async function queryTasks(env, { userId = null, status = null, limit = WEB_LIST_LIMIT } = {}) {
  const safeLimit = Math.max(1, Math.min(Number(limit) || WEB_LIST_LIMIT, 500));
  const normalizedStatus = status ? normalizeStatus(status) : null;

  if (userId && normalizedStatus) {
    const statusFilter = buildStatusFilterClause(getStatusSqlValues(normalizedStatus));
    return env.DB.prepare(`
      SELECT ${TASK_SELECT_FIELDS}
      FROM tasks
      WHERE user_id = ? AND status IN (${statusFilter.placeholders})
      ORDER BY updated_at DESC, created_at DESC
      LIMIT ?
    `)
      .bind(String(userId), ...statusFilter.values, safeLimit)
      .all();
  }

  if (userId) {
    return env.DB.prepare(`
      SELECT ${TASK_SELECT_FIELDS}
      FROM tasks
      WHERE user_id = ?
      ORDER BY updated_at DESC, created_at DESC
      LIMIT ?
    `)
      .bind(String(userId), safeLimit)
      .all();
  }

  if (normalizedStatus) {
    const statusFilter = buildStatusFilterClause(getStatusSqlValues(normalizedStatus));
    return env.DB.prepare(`
      SELECT ${TASK_SELECT_FIELDS}
      FROM tasks
      WHERE status IN (${statusFilter.placeholders})
      ORDER BY updated_at DESC, created_at DESC
      LIMIT ?
    `)
      .bind(...statusFilter.values, safeLimit)
      .all();
  }

  return env.DB.prepare(`
    SELECT ${TASK_SELECT_FIELDS}
    FROM tasks
    ORDER BY updated_at DESC, created_at DESC
    LIMIT ?
  `)
    .bind(safeLimit)
    .all();
}


