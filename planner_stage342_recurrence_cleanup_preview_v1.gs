      function renderWeekInlineMetrics() {
        var container = byId('weekInlineMetrics');
        if (!container) return;
        container.innerHTML = '';
        var items = [];
        if (state.currentView === 'today') {
          var dayYmd = state.dayYmd || formatYmdLocal(new Date());
          var dayTasks = getTasksForDay(dayYmd);
          var activeDayTasks = dayTasks.filter(function (task) {
            var status = normalizeStatus(task.status);
            return status === STATUS.PLANNED || status === STATUS.DONE;
          });
          var dayMetrics = aggregateTaskTimeMetrics(dayTasks);
          var dayCapacity = splitDayTasksByCapacity(dayYmd, dayTasks);
          var reminderData = getReminderCenterData(dayYmd);
          items = [
            { label: 'На сегодня', value: activeDayTasks.length },
            { label: 'План', value: formatMinutesHoursLabel(dayMetrics.planned) },
            { label: 'Факт (реальное)', value: formatMinutesHoursLabel(dayMetrics.actual), tone: 'actual' },
            { label: 'Ёмкость', value: formatMinutesHoursLabel(dayCapacity.capacityMinutes) },
            { label: 'Напоминания', value: String(reminderData.total) },
            { label: dayCapacity.overflowMinutes > 0 ? 'Перегруз' : 'Свободно', value: formatMinutesHoursLabel(dayCapacity.overflowMinutes > 0 ? dayCapacity.overflowMinutes : dayCapacity.freeMinutes), tone: dayCapacity.overflowMinutes > 0 ? 'danger' : '' }
          ];
        } else if (state.currentView === 'inbox') {
          var inboxSummary = getInboxSummary();
          items = [
            { label: 'Во входящих', value: inboxSummary.activeCount },
            { label: 'Новое', value: inboxSummary.newCount },
            { label: 'Разобрано', value: inboxSummary.triagedCount },
            { label: 'В план', value: inboxSummary.planCount },
            { label: 'В проекты', value: inboxSummary.projectsCount }
          ];
        } else if (state.currentView === 'planner') {
          var weekTasks = getCurrentWeekTasks();
          var weekMetrics = aggregateTaskTimeMetrics(weekTasks);
          var weekCapacity = getWeekCapacitySummary(state.weekStart || getCurrentWeekStartYmd());
          var focusProgress = getProtectedFocusProgress(state.weekStart || getCurrentWeekStartYmd());
          items = [
            { label: 'На неделю', value: weekMetrics.count },
            { label: 'План', value: formatMinutesHoursLabel(weekMetrics.planned) },
            { label: 'Ёмкость', value: formatMinutesHoursLabel(weekCapacity.capacityMinutes) },
            { label: 'Защищено фокуса', value: formatMinutesHoursLabel(focusProgress.protectedMinutes) + ' / ' + formatMinutesHoursLabel(focusProgress.targetMinutes) },
            { label: 'Требуют внимания', value: String(getAttentionTasks(getCurrentWeekTasks()).length) },
            { label: 'Перегружено дней', value: String(weekCapacity.overflowDays) }
          ];
        } else if (state.currentView === 'month') {
          var monthTasks = getCurrentMonthTasks();
          var monthMetrics = aggregateTaskTimeMetrics(monthTasks);
          var monthActiveDays = {};
          monthTasks.forEach(function(task){ if (task && task.due_at) monthActiveDays[formatYmdLocal(new Date(task.due_at))] = true; });
          items = [
            { label: 'На месяц', value: monthTasks.length },
            { label: 'Активных дней', value: String(Object.keys(monthActiveDays).length) },
            { label: 'План', value: formatMinutesHoursLabel(monthMetrics.planned) },
            { label: 'Требуют внимания', value: String(getAttentionTasks(monthTasks).length) },
            { label: 'С блокером', value: String(monthTasks.filter(function(task){ return !!(getTaskDependencyMeta(task).blockedByTask); }).length) }
          ];
        }
        container.classList.toggle('is-visible', items.length > 0);
        items.forEach(function (item) {
          var card = document.createElement('div');
          card.className = 'week-inline-metric';
          if (item.tone === 'actual') card.classList.add('is-actual');
          if (item.tone === 'danger') card.classList.add('is-danger');
          card.innerHTML = '<div class="week-inline-metric-label"></div><div class="week-inline-metric-value"></div>';
          card.querySelector('.week-inline-metric-label').textContent = item.label;
          card.querySelector('.week-inline-metric-value').textContent = String(item.value || 0);
          container.appendChild(card);
        });
        applyViewControlSettings(state.viewControlSettings || getDefaultViewControlSettings());
      }

