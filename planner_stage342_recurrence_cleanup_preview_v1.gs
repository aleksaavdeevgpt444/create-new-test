async function addChecklistItem(env, { taskId, userId, text }) {
  const now = new Date().toISOString();
  const clean = String(text || '').trim();
  if (!clean) throw new Error('Checklist text is required');
  const id = crypto.randomUUID();
  await env.DB.prepare(`
    INSERT INTO task_checklist (id, task_id, user_id, text, is_done, linked_task_id, created_at, updated_at)
    VALUES (?, ?, ?, ?, 0, NULL, ?, ?)
  `).bind(id, taskId, String(userId), clean, now, now).run();
  return listChecklistItems(env, { taskId, userId });
}

async function toggleChecklistItem(env, { itemId, userId, isDone }) {
  const row = await env.DB.prepare(`SELECT task_id FROM task_checklist WHERE id = ? AND user_id = ? LIMIT 1`).bind(itemId, String(userId)).first();
