      function mapWizardInputToRecommenderInput(inputValue) {
        var input = normalizeKnowledgeWizardInput(inputValue || loadKnowledgeWizardInput());
        var workType = 'balanced';
        if (input.role === 'manager') workType = 'manager';
        else if (input.role === 'creator') workType = 'creator';
        else if (input.role === 'project') workType = 'project';
        else if (input.role === 'knowledge') workType = 'knowledge';
        else if (input.role === 'operations') workType = 'operations';
        else if (input.role === 'personal') workType = 'personal';
        var incomingLoad = input.workload === 'incoming' || input.pain === 'chaos' ? 'high' : (input.workload === 'routine' ? 'medium' : 'medium');
        var planningNeed = 'execution';
        if (input.priority === 'strategy' || input.pain === 'strategy') planningNeed = 'strategy';
        else if (input.priority === 'focus' || input.pain === 'focus' || input.workload === 'creative') planningNeed = 'focus';
        else if (input.priority === 'control' || input.pain === 'review') planningNeed = 'review';
        else if (input.workload === 'incoming' || input.workload === 'routine') planningNeed = 'flow';
        var teamMode = (input.role === 'manager' || input.role === 'project' || input.role === 'operations') ? 'team' : 'solo';
        return normalizeKnowledgeRecommenderInput({ workType: workType, incomingLoad: incomingLoad, planningNeed: planningNeed, teamMode: teamMode, complexity: input.structure });
