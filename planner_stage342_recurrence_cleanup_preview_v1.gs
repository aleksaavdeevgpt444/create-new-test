async function handleTaskTimeBlockLinkApi(request, env) {
  const url = new URL(request.url);
  const method = String(request.method || 'GET').toUpperCase();
  const body = method === 'GET' || method === 'HEAD' ? {} : await readJsonBodySafe(request);
  const queryTaskId = String(url.searchParams.get('task_id') || '').trim();
  const userId = readRequestUserIdFromUrlBodyOrHeader(url, body, request);
  if (!userId) return buildMissingUserIdJsonResponse('/time-blocks/task-link');
  await ensureFrameworksSchema(env);
  if (method === 'GET') {
    if (!queryTaskId) return jsonResponse({ ok: false, error: 'task_id is required', build: getClientAppBuildLabel() }, { status: 400 });
    const item = await getTaskTimeBlockLinkForTask(env, userId, queryTaskId);
    return jsonResponse({ ok: true, build: getClientAppBuildLabel(), item, user_id: String(userId), source: item ? FRAMEWORKS_SYNC_SOURCE_SERVER : FRAMEWORKS_SYNC_SOURCE_DEFAULT });
  }
  const taskId = String(body.task_id || body.taskId || queryTaskId || '').trim();
  if (!taskId) return jsonResponse({ ok: false, error: 'task_id is required', build: getClientAppBuildLabel() }, { status: 400 });
  if (method === 'PUT' || method === 'POST') {
    const blockInstanceId = String(body.block_instance_id || body.blockInstanceId || '').trim();
    const linkMode = String(body.link_mode || body.linkMode || 'soft').trim().toLowerCase();
    if (!blockInstanceId) {
      await deleteTaskTimeBlockLinkForTask(env, userId, taskId);
      return jsonResponse({ ok: true, build: getClientAppBuildLabel(), deleted: true, item: null, user_id: String(userId), source: FRAMEWORKS_SYNC_SOURCE_SERVER });
    }
    const item = await upsertTaskTimeBlockLinkForTask(env, userId, taskId, blockInstanceId, linkMode);
    return jsonResponse({ ok: true, build: getClientAppBuildLabel(), item, user_id: String(userId), source: FRAMEWORKS_SYNC_SOURCE_SERVER });
  }
  if (method === 'DELETE') {
    await deleteTaskTimeBlockLinkForTask(env, userId, taskId);
    return jsonResponse({ ok: true, build: getClientAppBuildLabel(), deleted: true, item: null, user_id: String(userId), source: FRAMEWORKS_SYNC_SOURCE_SERVER });
  }
  return jsonResponse({ ok: false, error: 'Method not allowed', build: getClientAppBuildLabel() }, { status: 405 });
}



