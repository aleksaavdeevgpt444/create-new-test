function parseStatusMoveArgs(args, defaultSourceStatus = TASK_STATUSES.NEW) {
  if (!args || !args.length) return { ok: false, reason: "no_args" };

  if (args.length === 1) {
    const index = Number(args[0]);
    if (!Number.isInteger(index) || index < 1) return { ok: false, reason: "invalid_index" };
    return { ok: true, sourceStatus: defaultSourceStatus, index };
  }

  const sourceStatus = normalizeStatus(args[0]);
  const index = Number(args[1]);
  if (!sourceStatus) return { ok: false, reason: "invalid_source_status" };
  if (!Number.isInteger(index) || index < 1) return { ok: false, reason: "invalid_index" };
  return { ok: true, sourceStatus, index };
}

function getAppUrlFromRequest(request, env) {
  const configured = env.APP_URL || env.PUBLIC_APP_URL;
  if (configured) return configured;
