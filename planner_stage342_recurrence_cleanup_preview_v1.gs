async function getTaskScheduleChangesInRange(env, { userId, fromIso, toIso, limit = 400 }) {
  const safeLimit = Math.max(1, Math.min(Number(limit) || 400, 1000));
  const result = await env.DB.prepare(`
    SELECT
      h.task_id,
      h.payload_json,
      h.created_at,
      t.title,
      t.actual_minutes,
      t.space_key
    FROM task_history h
    LEFT JOIN tasks t
      ON t.id = h.task_id
     AND t.user_id = h.user_id
    WHERE h.user_id = ?
      AND h.event_type = 'schedule_changed'
      AND h.created_at >= ?
      AND h.created_at < ?
    ORDER BY h.created_at DESC
    LIMIT ?
  `)
    .bind(String(userId), fromIso, toIso, safeLimit)
    .all();

  return (result.results || []).map((row) => {
    let payload = null;
    if (row.payload_json) {
      try { payload = JSON.parse(row.payload_json); } catch (error) { payload = null; }
    }
    return {
      task_id: row.task_id,
      created_at: row.created_at,
      title: row.title || '',
      actual_minutes: row.actual_minutes ?? null,
      space_key: row.space_key ?? 'work',
      payload,
    };
  });
}

