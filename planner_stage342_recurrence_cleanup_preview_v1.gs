        return [String(task && task.id || ''), String(triggerIso || ''), scope, project, types, String(settings && settings.leadMinutes || 0)].join('|');
      }


      function isTelegramTaskNotificationTriggerFresh(triggerIso, settings) {
        if (!triggerIso) return false;
