function maskSecretTail(value) {
  const raw = String(value || '').trim();
  if (!raw) return 'не задан';
  if (raw.length <= 8) return 'есть';
  return 'есть · …' + raw.slice(-4);
}

async function getAiDiagnosticsSnapshot(env, { userId = null, limit = 5 } = {}) {
  await ensureTasksSchema(env);
  const safeLimit = Math.max(1, Math.min(Number(limit) || 5, 20));
  const userIdValue = userId ? String(userId) : null;
  const scoped = function (sql, binds) {
    return userIdValue
      ? env.DB.prepare(sql.replace(/__USER_SCOPE__/g, '(user_id = ? OR user_id IS NULL)')).bind(userIdValue, ...(binds || []))
      : env.DB.prepare(sql.replace(/__USER_SCOPE__/g, '1=1')).bind(...(binds || []));
  };
  const latestErrorsQuery = scoped(`SELECT endpoint, operation, severity, status, message, details_json, created_at FROM ai_diagnostics_log WHERE __USER_SCOPE__ AND severity = 'error' ORDER BY created_at DESC LIMIT ?`, [safeLimit]);
  const latestSuccessQuery = scoped(`SELECT endpoint, operation, severity, status, message, details_json, created_at FROM ai_diagnostics_log WHERE __USER_SCOPE__ AND status = 'success' ORDER BY created_at DESC LIMIT 1`, []);
  const latestFallbackQuery = scoped(`SELECT endpoint, operation, severity, status, message, details_json, created_at FROM ai_diagnostics_log WHERE __USER_SCOPE__ AND status = 'soft_fallback' ORDER BY created_at DESC LIMIT 1`, []);
  const providerAttemptsQuery = scoped(`SELECT endpoint, operation, severity, status, message, details_json, created_at FROM ai_diagnostics_log WHERE __USER_SCOPE__ AND endpoint = 'ai-provider' ORDER BY created_at DESC LIMIT ?`, [8]);
  const [latestErrorsResult, latestSuccessResult, latestFallbackResult, providerAttemptsResult] = await Promise.all([latestErrorsQuery.all(), latestSuccessQuery.all(), latestFallbackQuery.all(), providerAttemptsQuery.all()]);
  const mapLogRow = (row, fallbackSeverity) => row ? ({
    endpoint: row.endpoint || 'ai',
    operation: row.operation || '',
    severity: row.severity || fallbackSeverity || 'info',
    status: row.status || fallbackSeverity || 'info',
    message: row.message || '',
    details: tryParseJsonSafe(row.details_json) || row.details_json || null,
    created_at: row.created_at || ''
  }) : null;
  const latestErrors = (latestErrorsResult.results || []).map((row) => mapLogRow(row, 'error'));
  const latestSuccess = mapLogRow((latestSuccessResult.results || [])[0] || null, 'success');
  const latestFallback = mapLogRow((latestFallbackResult.results || [])[0] || null, 'warning');
  const providerAttempts = (providerAttemptsResult.results || []).map((row) => mapLogRow(row, 'info'));
  return {
    ai_module_version: AI_MODULE_VERSION,
    provider: {
      active: 'gemini',
      chain_label: getAiProviderChainLabel(env),
      gemini_model: getConfiguredGeminiGenerationModel(env),
      gemma_model: getConfiguredGemmaGenerationModel(env),
      qwen_model: getConfiguredQwenGenerationModel(env),
      gemini_key_configured: !!getConfiguredGeminiApiKey(env),
      groq_key_configured: !!getConfiguredGroqApiKey(env),
      embedding_hints_enabled: isAiEmbeddingHintsEnabled(env),
      gemini_embedding_model: getConfiguredGeminiEmbeddingModel(env),
      gemini_embedding_dimension: getConfiguredGeminiEmbeddingDimension(env),
      chain_timeout_ms: getConfiguredAiChainTimeoutMs(env),
      provider_timeout_ms: getConfiguredAiProviderTimeoutMs(env)
    },
    token: {
      configured: !!getConfiguredGeminiApiKey(env),
      masked: maskSecretTail(getConfiguredGeminiApiKey(env) || ''),
      groq_configured: !!getConfiguredGroqApiKey(env),
      groq_masked: maskSecretTail(getConfiguredGroqApiKey(env) || ''),
    },
    telegram: {
      bot_configured: !!String(env.TELEGRAM_BOT_TOKEN || '').trim(),
      report_chat_count: getTelegramErrorReportChatIds(env, userIdValue || null).length,
    },
    latest_success: latestSuccess,
    latest_soft_fallback: latestFallback,
    latest_errors: latestErrors,
    provider_attempts: providerAttempts,
  };
}

function classifyAiLimitProbeError(error) {
  const message = String(error && error.message ? error.message : error || '').trim();
  const lower = message.toLowerCase();
  if (!message) return { status: 'error', message: 'unknown error' };
  if ((error && error.name === 'AbortError') || lower.includes('timeout')) return { status: 'timeout', message };
  if (lower.includes('internal error encountered') || lower.includes('internal error') || lower.includes('service unavailable') || lower.includes('backend error') || lower.includes('503')) {
    return { status: 'provider_unavailable', message };
  }
  if (lower.includes('not configured')) return { status: 'not_configured', message };
  if (lower.includes('daily free allocation') || lower.includes('free allocation') || lower.includes('neurons per day') || lower.includes('quota exceeded for metric') || lower.includes('quota exceeded') || lower.includes('free_tier_requests')) {
    return { status: 'quota_exceeded', message };
  }
  if (lower.includes('resource_exhausted') || lower.includes('rate limit') || lower.includes('too many requests') || lower.includes('429')) {
    return { status: 'rate_limited', message };
  }
  if (lower.includes('empty response') || lower.includes('invalid json') || lower.includes('malformed json')) {
    return { status: 'invalid_response', message };
  }
  return { status: 'error', message };
}

