async function callGeminiFamilyJsonWithSchema(env, options) {
  const apiKey = getConfiguredGeminiApiKey(env);
  if (!apiKey) throw new Error('GEMINI_API_KEY is not configured');
  const model = String(options && options.model || '').trim();
  if (!model) throw new Error(String(options && options.providerLabel || 'Gemma') + ' model is not configured');
  const timeoutMs = getConfiguredAiProviderTimeoutMs(env, options);
  const response = await fetchWithAiTimeout(
    `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent?key=${apiKey}`,
    {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(buildGeminiJsonRequest(options && options.prompt || '', options && options.schema || {}, options && options.temperature)),
    },
    timeoutMs,
    options && options.providerLabel || 'Gemini'
  );

  const rawText = await readResponseTextSafe(response);
  const data = tryParseJsonSafe(rawText);
  if (!response.ok) {
    const message = data?.error?.message || rawText || ((options && options.providerLabel || 'Gemini') + ' HTTP ' + response.status);
    throw new Error(message);
  }

  const candidateText = extractGeminiCandidateText(data || {});
  if (!String(candidateText || '').trim()) throw new Error(String(options && options.providerLabel || 'Gemini') + ' returned empty response');
  const parsed = tryParseJsonSafe(candidateText);
  if (!parsed) throw new Error(String(options && options.providerLabel || 'Gemini') + ' returned invalid JSON');
  return parsed;
}

async function callQwenGroqJsonWithSchema(env, options) {
  const apiKey = getConfiguredGroqApiKey(env);
  if (!apiKey) throw new Error('GROQ_API_KEY is not configured');
  const model = String(options && options.model || '').trim();
  if (!model) throw new Error('Qwen model is not configured');
  const timeoutMs = getConfiguredAiProviderTimeoutMs(env, options);
  const response = await fetchWithAiTimeout(
    GROQ_API_BASE_DEFAULT,
    {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        'authorization': 'Bearer ' + apiKey,
      },
      body: JSON.stringify({
        model,
        messages: [
          {
            role: 'system',
            content: 'Ты AI-помощник внутри персонального планировщика. Отвечай только одним JSON-объектом без markdown и без пояснений.'
          },
          {
            role: 'user',
            content: buildGroqJsonPrompt(options && options.prompt || '', options && options.schema || {})
          }
        ],
        temperature: Number.isFinite(Number(options && options.temperature)) ? Number(options.temperature) : 0.2,
        response_format: { type: 'json_object' }
      })
    },
    timeoutMs,
    'Qwen'
  );

  const rawText = await readResponseTextSafe(response);
  const data = tryParseJsonSafe(rawText);
  if (!response.ok) {
    const message = data?.error?.message || rawText || ('Groq HTTP ' + response.status);
    throw new Error(message);
  }

  const content = extractGroqMessageContent(data || {});
  if (!String(content || '').trim()) throw new Error('Qwen returned empty response');
  return normalizeGroqJsonResult(content);
}

async function callPlannerJsonWithSchema(env, options) {
  const requestId = crypto.randomUUID();
  const providerChain = getAiProviderChain(env);
  const providerChainLabel = getAiProviderChainLabel(env);
  const operation = String(options && options.operation || 'ai');
  const userId = options && options.user_id ? String(options.user_id) : (options && options.userId ? String(options.userId) : null);
  const errors = [];
  const chainStartedAt = Date.now();
  const chainTimeoutMs = getConfiguredAiChainTimeoutMs(env, options);
  const preferredProviderTimeoutMs = getConfiguredAiProviderTimeoutMs(env, options);

  for (let i = 0; i < providerChain.length; i += 1) {
    const current = providerChain[i];
    const startedAt = Date.now();
    const timeoutMs = getAiProviderAttemptTimeoutMs(chainTimeoutMs, preferredProviderTimeoutMs, i, providerChain.length, chainStartedAt);
    await writeAiProviderAttemptLog(env, {
      user_id: userId,
      request_id: requestId,
      operation,
      status: 'attempt',
      severity: 'info',
      message: 'AI provider attempt started',
      provider: current.provider,
      provider_label: current.label,
      provider_chain: providerChainLabel,
      model: current.model,
      channel: current.channel,
      attempt: i + 1,
      duration_ms: timeoutMs,
    });
    try {
      let rawResult = null;
      const providerOptions = Object.assign({}, options || {}, {
        model: current.model,
        providerLabel: current.label,
        timeoutMs,
        chainTimeoutMs,
        providerTimeoutMs: preferredProviderTimeoutMs,
      });
      if (current.provider === 'qwen') {
        rawResult = await callQwenGroqJsonWithSchema(env, providerOptions);
      } else {
        rawResult = await callGeminiFamilyJsonWithSchema(env, providerOptions);
      }
      const meta = {
        request_id: requestId,
        provider: current.provider,
        label: current.label,
        model: current.model,
        channel: current.channel,
        operation,
        attempt: i + 1,
        chain_label: providerChainLabel,
        duration_ms: Date.now() - startedAt,
        chain_timeout_ms: chainTimeoutMs,
        provider_timeout_ms: timeoutMs,
      };
      const normalized = normalizeAiProviderPayload(rawResult, meta);
      await writeAiProviderAttemptLog(env, {
        user_id: userId,
        request_id: requestId,
        operation,
        status: 'success',
        severity: 'info',
        message: current.label + ' returned structured JSON',
        provider: current.provider,
        provider_label: current.label,
        provider_chain: providerChainLabel,
        model: current.model,
        channel: current.channel,
        attempt: i + 1,
        duration_ms: meta.duration_ms,
      });
      return normalized;
    } catch (error) {
      const classified = classifyAiProviderError(error);
      await writeAiProviderAttemptLog(env, {
        user_id: userId,
        request_id: requestId,
        operation,
        status: classified.status,
        severity: 'error',
        message: classified.message || String(error && error.message ? error.message : error),
        provider: current.provider,
        provider_label: current.label,
        provider_chain: providerChainLabel,
        model: current.model,
        channel: current.channel,
        attempt: i + 1,
        duration_ms: Date.now() - startedAt,
        error_status: classified.status,
      });
      errors.push(current.label + ': ' + String(classified.message || error && error.message || error));
    }
  }

  const finalError = /** @type {Error & { ai_request_id?: string, ai_provider_chain?: string, ai_provider_errors?: string[], ai_chain_timeout_ms?: number, ai_provider_timeout_ms?: number }} */ (new Error(errors.join(' | ') || 'AI provider chain failed'));
  finalError.ai_request_id = requestId;
  finalError.ai_provider_chain = providerChainLabel;
  finalError.ai_provider_errors = errors.slice();
  finalError.ai_chain_timeout_ms = chainTimeoutMs;
  finalError.ai_provider_timeout_ms = preferredProviderTimeoutMs;
  throw finalError;
}

function trimAiText(value, fallback = '') {
  const safe = String(value || '').trim();
  return safe || fallback;
}

function sentenceCaseFirst(value) {
  const safe = String(value || '').trim();
  if (!safe) return '';
  return safe.charAt(0).toUpperCase() + safe.slice(1);
}

function normalizeAiHelpTextValue(value, fallback = '', maxLength = 220) {
  var safe = trimAiText(value, fallback).replace(/\s+/g, ' ').trim();
  if (!safe) safe = String(fallback || '').trim();
  if (maxLength && safe.length > maxLength) safe = safe.slice(0, Math.max(0, maxLength - 1)).trimEnd() + '…';
  return safe;
}

function sanitizeAiHelpTextValue(value, fallback = '', maxLength = 220) {
  return normalizeAiHelpTextValue(value, fallback, maxLength);
}

function sanitizeAiHelpListValue(value, maxItems = 5) {
  var items = Array.isArray(value) ? value : [value];
  return items
    .map(function (item) { return normalizeAiHelpTextValue(item, '', 180); })
    .filter(Boolean)
    .slice(0, Math.max(1, Number(maxItems) || 5));
}

function normalizeAiFocusMinutes(value, fallback = 25) {
  var parsed = Math.round(Number(value));
  if (parsed === 15 || parsed === 25 || parsed === 50) return parsed;
  if (Number.isFinite(parsed)) {
    if (parsed <= 20) return 15;
    if (parsed <= 37) return 25;
    return 50;
  }
  return fallback === 15 || fallback === 25 || fallback === 50 ? fallback : 25;
}


function stripRedundantAiTaskPrefixes(value) {
  let safe = normalizeTaskTitleHumanWords(String(value || '').trim());
  if (!safe) return '';
  const patterns = [
    /^определить\s+действие\s+по\s+задаче\s*[:\-]?\s*/i,
    /^сформулировать\s+действие\s+по\s+задаче\s*[:\-]?\s*/i,
    /^определить\s+следующий\s+шаг\s+по\s+задаче\s*[:\-]?\s*/i,
    /^уточнить\s+и\s+выполнить\s+задачу\s*[:\-]?\s*/i,
    /^проработать\s+и\s+выполнить\s*[:\-]?\s*/i,
    /^подготовить\s+/i,
    /^выполнить\s*[:\-]?\s*/i,
    /^сделать\s*[:\-]?\s*/i
  ];
  for (let i = 0; i < 6; i += 1) {
    let changed = false;
    for (const pattern of patterns) {
      if (!pattern.test(safe)) continue;
      const next = safe.replace(pattern, '').trim();
      if (!next) continue;
      safe = next;
      changed = true;
      break;
    }
    if (!changed) break;
  }
  return safe;
}

function buildTaskTransformSource(payload) {
  return stripRedundantAiTaskPrefixes(trimAiText(payload?.title) || trimAiText(payload?.task_product) || trimAiText(payload?.description));
}

function normalizeTaskTitleHumanWords(value) {
  return String(value || '')
    .replace(/\bайфон\b/gi, 'iPhone')
    .replace(/\bайфоне\b/gi, 'iPhone')
    .replace(/\bноут\b/gi, 'ноутбук')
    .replace(/\bноуте\b/gi, 'ноутбуке')
    .replace(/\s+/g, ' ')
    .trim();
}

function normalizeTaskTitleCompareKey(value) {
  return String(value || '')
    .toLowerCase()
    .replace(/ё/g, 'е')
    .replace(/["'`«»“”„(){}\[\],.:;!?/\|-]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function looksLikeTrivialTaskRetitle(source, suggestion) {
  var safeSource = normalizeTaskTitleCompareKey(stripRedundantAiTaskPrefixes(source));
  var safeSuggestion = normalizeTaskTitleCompareKey(stripRedundantAiTaskPrefixes(suggestion));
  if (!safeSource || !safeSuggestion) return false;
  return safeSource === safeSuggestion;
}

function looksLikeResultStyleTitle(value) {
  return /^(готов|заполненн|подготовленн|обновленн|созданн|согласованн|оформленн|проведенн|проверенн|собранн|актуализированн)/i.test(String(value || '').trim());
}

function isActionLikeTaskTitle(value) {
  var safe = stripRedundantAiTaskPrefixes(trimAiText(value));
  if (!safe) return false;
  var normalized = normalizeTaskTitleHumanWords(safe);
  if (/^(сделать|подготовить|проверить|провести|обновить|собрать|сформировать|настроить|заполнить|проанализировать|разработать|реализовать|продумать|создать|оформить|запустить|уточнить|поменять|отправить|скорректировать|выгрузить|сверить|починить|добавить|описать|согласовать|протестировать|исправить|перенести|закрыть|снять|актуализировать|оценить|выбрать|подтвердить)/i.test(normalized)) {
    return true;
  }
  return /^[А-Яа-яЁёA-Za-z-]+(ть|ти|чь)/i.test(normalized);
}

function looksLikeSingleVerbPrefixRetitle(source, suggestion) {
  var safeSource = normalizeTaskTitleCompareKey(stripRedundantAiTaskPrefixes(source));
  var rawSuggestion = trimAiText(suggestion);
  if (!safeSource || !rawSuggestion) return false;
  var suggestionKey = normalizeTaskTitleCompareKey(rawSuggestion);
  if (!suggestionKey || suggestionKey === safeSource) return false;
  var withoutSingleVerb = normalizeTaskTitleCompareKey(
    rawSuggestion.replace(/^(подготовить|сделать|выполнить|проверить|обновить|создать|сформировать|собрать|продумать|реализовать|провести|уточнить|отправить|скорректировать|заполнить|проанализировать)\s+/i, '')
  );
  if (withoutSingleVerb === safeSource) return true;
  return false;
}

function looksLikeMetaTaskTitle(value) {
  var safe = trimAiText(value);
  if (!safe) return false;
  return /^(определить\s+действие\s+по\s+задаче|сформулировать\s+действие\s+по\s+задаче|определить\s+следующий\s+шаг\s+по\s+задаче|уточнить\s+и\s+выполнить\s+задачу)/i.test(safe);
}

function looksLikeCopiedCommentOrTitle(source, suggestion) {
  var base = normalizeTaskTitleCompareKey(stripRedundantAiTaskPrefixes(source));
  var next = normalizeTaskTitleCompareKey(stripRedundantAiTaskPrefixes(suggestion));
  if (!base || !next) return false;
  if (base === next) return true;
  if (base.length >= 18 && next.indexOf(base) !== -1) return true;
  if (next.length >= 18 && base.indexOf(next) !== -1) return true;
  return false;
}

function inferActionTitleFromProductText(value) {
  var safe = stripRedundantAiTaskPrefixes(trimAiText(value));
  if (!safe) return '';
  var text = normalizeTaskTitleHumanWords(safe);
  if (/(рекламн|кампан)/i.test(text)) {
    if (/(бюджет|эффективн|цель|ставк|рентабельн)/i.test(text)) return 'Проверить актуальные рекламные кампании и скорректировать бюджет по целям';
    return 'Проверить актуальные рекламные кампании и обновить план действий';
  }
  if (/(отч[её]т|рнп|api)/i.test(text)) return 'Подготовить новый отчёт и проверить корректность расчётов';
  if (/(индекс|локализац|распределени[яе] продаж)/i.test(text)) return 'Изучить индексы локализации и распределения продаж и зафиксировать выводы';
  if (/(прочит|изучит|ознаком)/i.test(text) && /(документ|отч[её]т|материал|статья|регламент|инструкц|индекс)/i.test(text)) return 'Изучить материал и зафиксировать ключевые выводы';
  if (/(тест|qa|провер)/i.test(text)) return 'Провести проверку и зафиксировать результат';
  if (/(планировщик|planner)/i.test(text) && /(интерфейс|ui|ux|экран)/i.test(text) && /(персонализ|единорож|персонал)/i.test(text)) {
    return 'Реализовать персонализированный интерфейс планировщика и провести тесты';
  }
  if (/(интерфейс|ui|ux|экран)/i.test(text) && /(персонализ|единорож|персонал)/i.test(text)) {
    return 'Реализовать персонализированный интерфейс и провести тесты';
  }
  if (/(визуал|дизайн|макет)/i.test(text) && /(планировщик|planner)/i.test(text)) return 'Разработать визуал планировщика и проверить его на тестах';
  if (/(визуал|дизайн|макет|ui|ux|экран|интерфейс)/i.test(text)) return 'Подготовить дизайн-решение и провести тесты';
  if (/список/i.test(text)) return sentenceCaseFirst('Собрать и актуализировать ' + text.replace(/^актуальн(ый|ая|ое)\s+/i, ''));
  if (/таблиц/i.test(text)) return sentenceCaseFirst('Собрать и проверить ' + text);
  if (/план/i.test(text)) return sentenceCaseFirst('Сформировать и уточнить ' + text);
  return '';
}

function looksLikeGenericActionTitle(value) {
  var safe = trimAiText(value);
  if (!safe) return false;
  return /^(подготовить\s+концепт|подготовить\s+задачу|уточнить\s+и\s+выполнить|определить\s+действие|сформулировать\s+действие|определить\s+следующий\s+шаг)/i.test(safe)
    || (/(подготовить|реализовать|провести|сделать|выполнить)/i.test(safe) && /(его|её|их|это)/i.test(safe));
}

function buildConcreteTaskProductFromContext(payload) {
  var title = stripRedundantAiTaskPrefixes(trimAiText(payload?.title));
  var description = trimAiText(payload?.description);
  var currentProduct = stripRedundantAiTaskPrefixes(trimAiText(payload?.task_product));
  var project = trimAiText(payload?.project_name);
  var source = [currentProduct, title, project, description].filter(Boolean).join(' ');
  var text = normalizeTaskTitleHumanWords(source);
  if (!text) return 'Готовый результат задачи';
  if (/(садик|садика)/i.test(text) && /обед/i.test(text)) {
    return 'Софа забрана из садика, обед организован';
  }
  if (/(индекс|локализац|распределени[яе] продаж)/i.test(text)) {
    return 'Краткий конспект по индексам локализации и распределения продаж с ключевыми выводами';
  }
  if (/(рекламн|кампан)/i.test(text)) {
    if (/(бюджет|эффективн|цель|ставк|рентабельн)/i.test(text)) {
      return 'Актуализированный список рекламных кампаний с оценкой эффективности и скорректированным бюджетом по целям';
    }
    return 'Актуализированный список рекламных кампаний с ключевыми выводами и планом действий';
  }
  if (/(отч[её]т|рнп|api)/i.test(text)) {
    return 'Готовый отчёт с проверенными расчётами, блоком аномалий и финальной выгрузкой';
  }
  if (/(прочит|изучит|ознаком)/i.test(text) || /(документ|материал|статья|регламент|инструкц)/i.test(text)) {
    return 'Краткий конспект с ключевыми выводами и следующими действиями';
  }
  if (/(тест|qa|провер)/i.test(text)) {
    return 'Чек-лист проверки с результатами и выявленными замечаниями';
  }
  if (/(визуал|дизайн|макет|ui|ux|экран|интерфейс)/i.test(text)) {
    return 'Согласованный концепт визуала с референсами и критериями качества';
  }
  if (/список/i.test(text)) {
    return sentenceCaseFirst('Актуализированный ' + text.replace(/^актуальн(ый|ая|ое)\s+/i, ''));
  }
  return transformProcessPhraseToResult(currentProduct || title) || 'Готовый результат задачи';
}

function buildLocalTaskActionTitle(payload) {
  var base = buildTaskTransformSource(payload);
  var product = stripRedundantAiTaskPrefixes(trimAiText(payload?.task_product));
  var description = stripRedundantAiTaskPrefixes(trimAiText(payload?.description));
  var project = trimAiText(payload?.project_name);
  var contextText = [base, product, description, project].filter(Boolean).join(' ');
  if (!base) return 'Уточнить задачу и зафиксировать конкретное действие';
  var safe = stripRedundantAiTaskPrefixes(base.replace(/^[–—-]+\s*/, '').trim());
  safe = safe.replace(/\s*[-–—:]\s*(прочитать|изучить|посмотреть|ознакомиться)\s*$/i, '').trim();
  if (!safe) return 'Уточнить задачу и зафиксировать конкретное действие';
  var inferredFromProduct = inferActionTitleFromProductText(product || description);
  if (inferredFromProduct && (!isActionLikeTaskTitle(safe) || looksLikeGenericActionTitle(safe) || safe.length < 18)) {
    return sentenceCaseFirst(inferredFromProduct);
  }
  if (isActionLikeTaskTitle(safe) && !looksLikeMetaTaskTitle(safe) && !looksLikeGenericActionTitle(safe)) {
    return sentenceCaseFirst(safe);
  }
  if (/(рекламн|кампан)/i.test(contextText)) {
    if (/(бюджет|эффективн|цель|ставк|рентабельн)/i.test(contextText)) {
      return 'Проверить актуальные рекламные кампании и скорректировать бюджет по целям';
    }
    return 'Проверить актуальные рекламные кампании и обновить план действий';
  }
  if (/(индекс|локализац|распределени[яе] продаж)/i.test(contextText)) {
    return 'Изучить индексы локализации и распределения продаж и зафиксировать выводы';
  }
  if (/(кол[её]с)/i.test(safe) && /(тормоз)/i.test(safe)) return 'Поменять колёса и обновить тормоза на машине';
  if (/(рнп|отч[её]т)/i.test(safe)) {
    var reportTarget = safe.replace(/^(сделать|нужен|надо)\s+/i, '').trim();
    return sentenceCaseFirst('Подготовить ' + reportTarget);
  }
  if (/визуал/i.test(safe)) {
    if (/планировщик/i.test(safe)) return inferredFromProduct || 'Разработать визуал планировщика и проверить его на тестах';
    return inferredFromProduct || 'Подготовить дизайн-решение и провести тесты';
  }
  if (/тест/i.test(safe) && !isActionLikeTaskTitle(safe)) {
    return 'Провести тесты и зафиксировать результат';
  }
  if (/(прочит|изучит|ознаком)/i.test(base) && /(документ|материал|отч[её]т|статья|регламент|инструкц|индекс)/i.test(contextText)) {
    return inferredFromProduct || 'Изучить материал и зафиксировать ключевые выводы';
  }
  if (inferredFromProduct) return inferredFromProduct;
  if (/список/i.test(safe)) return sentenceCaseFirst('Собрать и актуализировать ' + safe.replace(/^актуальн(ый|ая|ое)\s+/i, ''));
  if (/план/i.test(safe)) return sentenceCaseFirst('Сформировать и уточнить ' + safe);
  if (/таблиц/i.test(safe)) return sentenceCaseFirst('Собрать и проверить ' + safe);
  if (/обед/i.test(safe) && /садик|садика/i.test(safe)) return 'Забрать Софу из садика и организовать обед';
  return sentenceCaseFirst(safe);
}

function normalizeAiTaskTitleSuggestion(payload, suggestion, fallbackTitle = '') {
  var source = buildTaskTransformSource(payload);
  var rawSuggestion = trimAiText(suggestion, fallbackTitle);
  var cleanedSuggestion = stripRedundantAiTaskPrefixes(normalizeTaskTitleHumanWords(rawSuggestion));
  var inferredFromProduct = inferActionTitleFromProductText(trimAiText(payload?.task_product) || trimAiText(payload?.description));
  if (!cleanedSuggestion) return buildLocalTaskActionTitle(payload);
  if (looksLikeMetaTaskTitle(rawSuggestion) || looksLikeMetaTaskTitle(cleanedSuggestion) || looksLikeGenericActionTitle(cleanedSuggestion)) {
    if (inferredFromProduct) return sentenceCaseFirst(inferredFromProduct);
    if (isActionLikeTaskTitle(cleanedSuggestion) && !looksLikeGenericActionTitle(cleanedSuggestion)) return sentenceCaseFirst(cleanedSuggestion);
    return sentenceCaseFirst(buildLocalTaskActionTitle(payload));
  }
  if (looksLikeTrivialTaskRetitle(source, cleanedSuggestion) || looksLikeResultStyleTitle(cleanedSuggestion) || looksLikeSingleVerbPrefixRetitle(source, rawSuggestion)) {
    if (inferredFromProduct) return sentenceCaseFirst(inferredFromProduct);
    if (isActionLikeTaskTitle(source) && !looksLikeMetaTaskTitle(source) && !looksLikeGenericActionTitle(source)) return sentenceCaseFirst(stripRedundantAiTaskPrefixes(source));
    return sentenceCaseFirst(buildLocalTaskActionTitle(payload));
  }
  if (isActionLikeTaskTitle(cleanedSuggestion) && !looksLikeGenericActionTitle(cleanedSuggestion)) return sentenceCaseFirst(cleanedSuggestion);
  if (inferredFromProduct) return sentenceCaseFirst(inferredFromProduct);
  if (isActionLikeTaskTitle(source) && !looksLikeMetaTaskTitle(source) && !looksLikeGenericActionTitle(source)) return sentenceCaseFirst(stripRedundantAiTaskPrefixes(source));
  return sentenceCaseFirst(buildLocalTaskActionTitle(payload));
}

function isGenericProjectSuggestion(value) {
  var safe = String(value || '').replace(/\s+/g, ' ').trim();
  if (!safe) return true;
  return /^(без проекта|no project|none|null|не знаю|не определено|не определен|не указан|не указано|общий|общее|другое|разное|проект)$/i.test(safe);
}

function normalizeAiProjectSuggestion(value, fallback = '') {
  var safeValue = trimAiText(value, '').replace(/\s+/g, ' ').trim();
  var safeFallback = trimAiText(fallback, '').replace(/\s+/g, ' ').trim();
  if (isGenericProjectSuggestion(safeValue)) safeValue = '';
  if (isGenericProjectSuggestion(safeFallback)) safeFallback = '';
  var safe = safeValue || safeFallback;
  if (!safe) return '';
  return sentenceCaseFirst(safe);
}

function normalizeAiTaskProductSuggestion(payload, suggestion, fallbackProduct = '') {
  var title = buildTaskTransformSource(payload);
  var description = trimAiText(payload?.description);
  var currentProduct = stripRedundantAiTaskPrefixes(trimAiText(payload?.task_product));
  var safe = trimAiText(suggestion, fallbackProduct);
  if (safe && (looksLikeCopiedCommentOrTitle(title, safe) || looksLikeCopiedCommentOrTitle(currentProduct, safe) || looksLikeCopiedCommentOrTitle(description, safe))) {
    safe = '';
  }
  if (safe && /^(сделать|заполнить|подготовить|актуализировать|обновить|проверить|провести|проработать|выполнить|реализовать|сформировать|создать)/i.test(safe)) {
    safe = transformProcessPhraseToResult(safe);
  }
  if (!safe) {
    safe = buildConcreteTaskProductFromContext(payload || {});
  }
  if (!safe || looksLikeCopiedCommentOrTitle(title, safe) || looksLikeCopiedCommentOrTitle(description, safe)) {
    safe = buildConcreteTaskProductFromContext(payload || {});
  }
  return sentenceCaseFirst(safe || 'Готовый результат задачи');
}

function mapInfinitiveToCompletedTitleWord(verb) {
  const safe = String(verb || '').trim().toLowerCase();
  const map = {
    'составить': 'Составлен',
    'отправить': 'Отправлен',
    'подготовить': 'Подготовлен',
    'создать': 'Создан',
    'собрать': 'Собран',
    'актуализировать': 'Актуализирован',
    'обновить': 'Обновлён',
    'реализовать': 'Реализован',
    'проверить': 'Проверен',
    'протестировать': 'Протестирован',
    'написать': 'Написан',
    'согласовать': 'Согласован',
    'заполнить': 'Заполнен',
    'оформить': 'Оформлен',
    'настроить': 'Настроен',
    'внедрить': 'Внедрён',
    'запустить': 'Запущен',
    'разработать': 'Разработан',
    'добавить': 'Добавлен',
    'исправить': 'Исправлен',
    'загрузить': 'Загружен',
    'подключить': 'Подключён',
    'сформировать': 'Сформирован',
    'сделать': 'Сделан'
  };
  return map[safe] || '';
}

function transformProcessPhraseToCompletedTitle(value) {
  const safe = String(value || '').replace(/\s+/g, ' ').trim();
  if (!safe) return '';

  let match = safe.match(/^([А-Яа-яЁёA-Za-z-]+ть)\s+и\s+([А-Яа-яЁёA-Za-z-]+ть)\s+(.+)$/i);
  if (match) {
    const first = mapInfinitiveToCompletedTitleWord(match[1]);
    const second = mapInfinitiveToCompletedTitleWord(match[2]);
    const objectPart = String(match[3] || '').trim();
    if (first && second && objectPart) {
      return sentenceCaseFirst(`${first} и ${second.toLowerCase()} ${objectPart}`);
    }
  }

  match = safe.match(/^([А-Яа-яЁёA-Za-z-]+ть)\s+(.+)$/i);
  if (match) {
    const completed = mapInfinitiveToCompletedTitleWord(match[1]);
    const objectPart = String(match[2] || '').trim();
    if (completed && objectPart) {
      return sentenceCaseFirst(`${completed} ${objectPart}`);
    }
  }

  return sentenceCaseFirst(transformProcessPhraseToResult(safe) || safe);
}

function transformProcessPhraseToResult(value) {
  let safe = String(value || '').trim();
  if (!safe) return '';
  if (/^(сделать|подготовить|создать|сформировать)\s+нов(?:ый|ое|ую)\s+отч[её]т/i.test(safe)) {
    return sentenceCaseFirst(safe.replace(/^(сделать|подготовить|создать|сформировать)\s+/i, ''));
  }
  if (/^(сделать|подготовить|создать|сформировать)\s+/i.test(safe) && /(отч[её]т|визуал|макет|документ|таблиц|список|план|схем|бриф)/i.test(safe)) {
    return sentenceCaseFirst(safe.replace(/^(сделать|подготовить|создать|сформировать)\s+/i, ''));
  }

  /** @type {Array<[RegExp, string]>} */
  const replacements = [
    [/^заполнить\s+/i, 'Заполненный '],
    [/^подготовить\s+/i, 'Готовый '],
    [/^актуализировать\s+/i, 'Актуализированный '],
    [/^сделать\s+/i, 'Готовый '],
    [/^создать\s+/i, 'Созданный '],
    [/^оформить\s+/i, 'Оформленный '],
    [/^собрать\s+/i, 'Собранный '],
    [/^провести\s+/i, 'Проведённый '],
    [/^проверить\s+/i, 'Проверенный '],
    [/^обновить\s+/i, 'Обновлённый '],
    [/^написать\s+/i, 'Готовый '],
    [/^согласовать\s+/i, 'Согласованный '],
  ];

  for (const [pattern, replacement] of replacements) {
    if (pattern.test(safe)) {
      safe = safe.replace(pattern, replacement);
      return sentenceCaseFirst(safe);
    }
  }

  return sentenceCaseFirst(safe);
}

function buildLocalTaskResultTransform(payload) {
  const title = trimAiText(payload?.title);
  const description = trimAiText(payload?.description);
  const taskProduct = trimAiText(payload?.task_product);
  const base = title || taskProduct || description || 'Готовый результат задачи';
  const titleResult = transformProcessPhraseToCompletedTitle(title || description || taskProduct || 'Подготовить задачу к выполнению');
  const productResult = normalizeAiTaskProductSuggestion(payload, '', taskProduct);
  return {
    title_result_suggestion: sentenceCaseFirst(titleResult),
    product_result_suggestion: sentenceCaseFirst(productResult || transformProcessPhraseToResult(base) || 'Готовый результат задачи'),
    fallback_used: true,
  };
}

function inferProjectSuggestionFromText(payload) {
  const source = [payload?.project_name, payload?.title, payload?.task_product, payload?.description]
    .map((item) => String(item || '').trim())
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
  if (!source) return '';
  if (/(planner|планировщик|today os|todayos|gant|гант|канбан|week view|today view)/i.test(source)) return 'Planner';
  if (/(inbox hub|хаб записей|хаб идей|умные заметки)/i.test(source)) return 'Inbox Hub';
  if (/(wildberries|wb|вб|рнп|рекламн|кампан|портрет покупател|воронк)/i.test(source) && /(api|отч[её]т|выгрузк|расч[её]т|анома|подсветк|бюджет|ставк|эффективн)/i.test(source)) return 'Отчёт API';
  if (/(wildberries|wb|вб)/i.test(source) && /(аналит|воронк|реклам|карточк|ctr|портрет покупател)/i.test(source)) return 'Wildberries';
  if (/(telegram|tg|бот)/i.test(source)) return 'Telegram';
  if (/(ocr|распознав|pdf|парс)/i.test(source)) return 'OCR / Парсинг';
  if (/(дизайн|визуал|макет|ui|ux|экран|интерфейс)/i.test(source)) return /(planner|планировщик)/i.test(source) ? 'Planner' : 'Дизайн';
  if (/(api|интеграц)/i.test(source)) return 'Интеграции';
  return '';
}

