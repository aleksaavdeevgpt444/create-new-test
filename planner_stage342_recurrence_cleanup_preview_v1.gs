      function renderTodayNowIndicator(dayYmd) {
        if (dayYmd !== formatYmdLocal(new Date())) return;
        var eventsLayer = byId('todayEventsLayer');
        if (!eventsLayer) return;
        var now = new Date();
        var renderWindow = getCalendarRenderWindowHours();
        var totalMinutes = (renderWindow.endHour - renderWindow.startHour) * 60;
        var currentMinutes = now.getHours() * 60 + now.getMinutes();
        var renderWindow = getCalendarRenderWindowHours();
        var relativeMinutes = currentMinutes - renderWindow.startHour * 60;
        if (relativeMinutes < 0 || relativeMinutes > totalMinutes) return;
        var line = document.createElement('div');
        line.className = 'today-now-line';
        line.style.top = 'calc(' + ((relativeMinutes / totalMinutes) * 100) + '% + 1px)';
        eventsLayer.appendChild(line);
      }

      function getCalendarCardDisplayMode(durationMinutes) {
        var duration = Math.max(Number(durationMinutes) || 0, 0);
        if (duration <= 10) return 'title-single';
        if (duration <= 30) return 'title-wrap';
        if (duration < 70) return 'time-title';
        return 'full';
      }

      function getCalendarVisualHeightPercent(durationMinutes, totalMinutes) {
        var duration = Math.max(Number(durationMinutes) || 0, 0);
        var total = Math.max(Number(totalMinutes) || 0, 1);
        var rawPercent = (duration / total) * 100;
        var minimumPercent = 3;
        if (duration <= 10) minimumPercent = 1.2;
        else if (duration <= 15) minimumPercent = 1.6;
        else if (duration <= 20) minimumPercent = 2;
        return Math.max(rawPercent, minimumPercent);
      }

      function getTodayCalendarMinimumCardHeightPx(durationMinutes) {
        var duration = Math.max(Number(durationMinutes) || 0, 0);
        if (duration <= 10) return 24;
        if (duration <= 15) return 28;
        if (duration <= 20) return 32;
        if (duration <= 30) return 38;
        return 0;
      }

      function renderTodayEvents(dayYmd) {
        var eventsLayer = byId('todayEventsLayer');
        if (!eventsLayer) return;
        var renderWindow = getCalendarRenderWindowHours();
        var totalMinutes = (renderWindow.endHour - renderWindow.startHour) * 60;
        var layouts = buildDayOverlapLayout(getTasksForDay(dayYmd));
        layouts.forEach(function (layoutItem) {
          var task = layoutItem.task;
          var date = new Date(task.due_at);
          if (isNaN(date.getTime())) return;
          var startMinutes = date.getHours() * 60 + date.getMinutes();
          var relativeMinutes = startMinutes - renderWindow.startHour * 60;
          if (relativeMinutes < 0 || relativeMinutes >= totalMinutes) return;
          var duration = getTaskDurationMinutes(task);
          var topPercent = (relativeMinutes / totalMinutes) * 100;
          var heightPercent = getCalendarVisualHeightPercent(duration, totalMinutes);
          var status = normalizeStatus(task.status);
          var overdue = isOverdueTask(task);
          var displayMode = getCalendarCardDisplayMode(duration);
          var overlapCols = Math.max(layoutItem.cols || 1, 1);
          var colWidth = 100 / overlapCols;
          var leftPercent = layoutItem.col * colWidth;
          var widthPercent = colWidth;
          var card = document.createElement('div');
          card.className = 'today-event display-' + displayMode + (status === STATUS.DONE ? ' is-done' : '') + (overdue ? ' is-overdue' : '') + (overlapCols > 1 ? ' has-overlap' : '');
          applyTaskSpaceFocusClass(card, task);
          applyTaskVisualStatusClass(card, status);
          card.style.top = 'calc(' + topPercent + '% + 2px)';
          card.style.left = 'calc(' + leftPercent + '% + 8px)';
          card.style.width = 'calc(' + widthPercent + '% - 16px)';
          card.style.height = 'calc(' + heightPercent + '% - 6px)';
          var minimumCardHeightPx = getTodayCalendarMinimumCardHeightPx(duration);
          if (minimumCardHeightPx > 0) {
            card.style.minHeight = minimumCardHeightPx + 'px';
            card.classList.add('is-short-task');
          } else {
            card.style.minHeight = '';
          }
          card.dataset.taskId = task.id;
          attachDragSource(card, { taskId: task.id, source: 'today', status: status, dueAt: task.due_at || null, durationMinutes: duration });
          bindTaskHoverCard(card, task);
          card.addEventListener('click', function (event) {
            hideTaskHoverCard();
            event.preventDefault();
            event.stopPropagation();
            if (shouldSuppressClick()) return;
            openEditor(task.id);
          });
          var top = document.createElement('div');
          top.className = 'today-event-top';
          var time = document.createElement('div');
          time.className = 'today-event-time';
          time.textContent = formatTimeRange(task.due_at, duration);
          top.appendChild(time);
          if (overdue) { var warn = document.createElement('span'); warn.className = 'today-event-overdue-mark'; warn.textContent = '!'; top.appendChild(warn); }
          top.appendChild(createStatusPill(status, status === STATUS.DONE ? '✓' : getStatusSingular(status)));
          var title = document.createElement('div');
          title.className = 'today-event-title';
          title.textContent = task.title || 'Без названия';
          var project = document.createElement('div');
          project.className = 'today-event-project';
          project.textContent = normalizeProjectName(task.project_name);
          var inline = document.createElement('div');
          inline.className = 'today-event-inline';
          inline.textContent = formatTimeRange(task.due_at, duration) + ' · ' + (task.title || 'Без названия') + ' · ' + normalizeProjectName(task.project_name);
          card.appendChild(top); card.appendChild(inline); card.appendChild(title); card.appendChild(project);
          var resizeHandle = document.createElement('div');
          resizeHandle.className = 'today-event-resize-handle calendar-event-resize-handle';
          resizeHandle.setAttribute('draggable', 'false');
          resizeHandle.addEventListener('dragstart', function (event) { event.preventDefault(); });
          resizeHandle.addEventListener('pointerdown', function (event) { startResize(event, task, card, time); });
          card.appendChild(resizeHandle);
          eventsLayer.appendChild(card);
        });
        renderTodayNowIndicator(dayYmd);
      }


      function getTodayOsWindowCapacityMinutes() {
        return getEffectiveCapacityMinutes(state.dayYmd || formatYmdLocal(new Date()));
      }

      function getTodayOsData(dayYmd) {
        var ritual = loadDayRitual(dayYmd);
        var selectedIds = Array.isArray(ritual.topTaskIds) ? ritual.topTaskIds.map(function (id) { return String(id); }) : [];
        var selectedMap = Object.create(null);
        var mainTasks = [];
        selectedIds.forEach(function (taskId) {
          var task = findTaskById(taskId);
          if (!(task && task.id)) return;
          if (selectedMap[task.id]) return;
          selectedMap[task.id] = 1;
          mainTasks.push(task);
        });

        var dayTasks = getTasksForDay(dayYmd);
        var additionalTasks = [];
        var recurringTasks = [];
        dayTasks.forEach(function (task) {
          if (!(task && task.id) || selectedMap[task.id]) return;
          if (isRecurringCalendarTask(task)) recurringTasks.push(task);
          else additionalTasks.push(task);
        });

        var noTimeTasks = getBacklogTasks().filter(function (task) {
          return task && task.id && !task.due_at;
        });

        var overdueTasks = getShellTasks().filter(function (task) {
          if (!(task && task.id)) return false;
          var status = normalizeStatus(task.status);
          if (status === STATUS.DONE) return false;
          return isOverdueTask(task);
        }).sort(compareTasksByDueAndUpdated);

        var timeMetrics = aggregateTaskTimeMetrics(dayTasks);
        var loadSplit = splitDayTasksByCapacity(dayYmd, dayTasks);
        var capacityMinutes = Number(loadSplit.capacityMinutes) || 0;
        var plannedMinutes = Number(timeMetrics.planned) || 0;
        var freeMinutes = Math.max(0, capacityMinutes - plannedMinutes);
        var overflowMinutes = Math.max(0, plannedMinutes - capacityMinutes);
        var focusTask = mainTasks[0] || additionalTasks[0] || recurringTasks[0] || noTimeTasks[0] || null;
        var doneCount = dayTasks.filter(function (task) { return normalizeStatus(task.status) === STATUS.DONE; }).length;
        var plannedCount = dayTasks.filter(function (task) { return normalizeStatus(task.status) === STATUS.PLANNED; }).length;
        var completedCount = doneCount;
        var protectedFocusTasks = dayTasks.filter(function (task) { return !!(task && task.id && isTaskFocusProtected(task.id)); });
        var protectedFocusMinutes = protectedFocusTasks.reduce(function (sum, task) {
          return sum + Math.max(Number(getEffectivePlannedMinutesClient(task)) || Number(getTaskDurationMinutes(task)) || 0, 0);
        }, 0);
        var nextTasks = dayTasks.filter(function (task) {
          return task && task.due_at && normalizeStatus(task.status) === STATUS.PLANNED;
        }).sort(compareTasksByDueAndUpdated).slice(0, 3);
        var attentionTasks = getAttentionTasks(dayTasks.concat(noTimeTasks));
        var inboxSummary = getInboxSummary();
        var dayBlockSummary = null;
        var dayBlockTemporal = null;
        if ((state.dayBlockSettings || getDefaultDayBlockSettings()).enabled) {
          dayBlockSummary = getDayBlocksDaySummary(dayYmd);
          dayBlockTemporal = getDayBlocksTemporalState(dayYmd, (dayBlockSummary && dayBlockSummary.blocks) || []);
        }

        return {
          ritual: ritual,
          focusTask: focusTask,
          mainTasks: mainTasks,
          additionalTasks: additionalTasks,
          recurringTasks: recurringTasks,
          noTimeTasks: noTimeTasks,
          overdueTasks: overdueTasks,
          overdueCount: overdueTasks.length,
          overflowTasks: loadSplit.overflowTasks || [],
          inCapacityTasks: loadSplit.inCapacityTasks || [],
          attentionTasks: attentionTasks,
          attentionCount: attentionTasks.length,
          protectedFocusTasks: protectedFocusTasks,
          protectedFocusMinutes: protectedFocusMinutes,
          nextTasks: nextTasks,
          inboxSummary: inboxSummary,
          doneCount: doneCount,
          plannedCount: plannedCount,
          completedCount: completedCount,
          noTimeCount: noTimeTasks.length,
          dayBlockSummary: dayBlockSummary,
          dayBlockTemporal: dayBlockTemporal,
          plannedMinutes: plannedMinutes,
          actualMinutes: Number(timeMetrics.actual) || 0,
          capacityMinutes: capacityMinutes,
          freeMinutes: freeMinutes,
          overflowMinutes: overflowMinutes,
          loadMeta: loadSplit.loadMeta || getCapacityLoadMeta(plannedMinutes, capacityMinutes),
          loadLevel: capacityMinutes > 0 ? Math.min(100, Math.round((plannedMinutes / capacityMinutes) * 100)) : 0,
          totalCount: dayTasks.length + noTimeTasks.length
        };
      }

      function rerenderTodayOs(dayYmd) {
        var targetDay = dayYmd || state.dayYmd || formatYmdLocal(new Date());
        renderTodayRitualCard(targetDay);
        renderTodayTelegramControlCard(targetDay);
        renderTodayOsHero(targetDay);
        renderTodayOsPanel(targetDay);
      }

      function toggleTodayPrimaryTask(taskId, dayYmd) {
        var targetDay = dayYmd || state.dayYmd || formatYmdLocal(new Date());
        var settings = state.ritualSettings || getDefaultRitualSettings();
        var ritual = loadDayRitual(targetDay);
        var ids = Array.isArray(ritual.topTaskIds) ? ritual.topTaskIds.map(function (id) { return String(id); }) : [];
        var key = String(taskId || '').trim();
        if (!key) return;
        var index = ids.indexOf(key);
        if (index >= 0) {
          ids.splice(index, 1);
          ritual.topTaskIds = ids;
          ritual.updatedAt = new Date().toISOString();
          saveDayRitual(targetDay, ritual);
          rerenderTodayOs(targetDay);
          showSuccess('Задача убрана из главных на день.');
          return;
        }
        if (ids.length >= settings.maxMainTasks) {
          showError('Можно выбрать не больше ' + settings.maxMainTasks + ' главных задач.');
          return;
        }
        ids.push(key);
        ritual.topTaskIds = ids;
        ritual.updatedAt = new Date().toISOString();
        saveDayRitual(targetDay, ritual);
        rerenderTodayOs(targetDay);
        showSuccess('Задача добавлена в главные на день.');
      }

      async function startFocusModeFromTaskId(taskId) {
        try {
          var task = findTaskById(taskId);
          if (!(task && task.id)) {
            showError('Не удалось найти задачу для фокуса.');
            return;
          }
          var focusSettings = state.focusSettings || getDefaultFocusSettings();
          var minutes = null;
          if (focusSettings.askDurationBeforeStart) {
            minutes = await openFocusDurationDialog(task);
            if (!minutes) return;
          } else {
            minutes = resolveDefaultFocusMinutes(task);
          }
          startFocusSession(task, minutes);
          var ritualDayYmd = task && task.due_at ? formatYmdLocal(new Date(task.due_at)) : (state.dayYmd || formatYmdLocal(new Date()));
          if (ritualDayYmd && isTaskPrimaryForRitualDay(task, ritualDayYmd)) {
            markRitualFocusStarted(ritualDayYmd, task.id);
            rerenderTodayOs(ritualDayYmd);
          }
          var focusProtectionSettings = state.focusProtectionSettings || getDefaultFocusProtectionSettings();
          if (task.due_at && focusProtectionSettings.enabled && focusProtectionSettings.autoProtectOnFocusStart && !isTaskFocusProtected(task.id)) {
            toggleTaskFocusProtection(task.id, { silent: true });
            showSuccess('Фокус-сессия запущена. Слот автоматически защищён.');
          }
        } catch (error) {
          showError(String(error && error.message ? error.message : error));
        }
      }

      function buildTodayOsTaskMeta(task) {
        var meta = [];
        var project = normalizeProjectName(task && task.project_name);
        if (project) meta.push(createChip(project));
        var status = normalizeStatus(task && task.status);
        if (status) meta.push(createStatusPill(status, getStatusSingular(status)));
        var plannedMinutes = Number(getEffectivePlannedMinutesClient(task)) || Number(getTaskDurationMinutes(task)) || 0;
        if (plannedMinutes > 0) meta.push(createChip('План: ' + formatMinutesHoursLabel(plannedMinutes)));
        if (task && task.due_at) meta.push(createChip(formatTimeRange(task.due_at, getTaskDurationMinutes(task), { withDate: false })));
        if (task && task.id && isTaskBlocked(task.id)) { var blockedChip = createChip('Блокируется'); blockedChip.classList.add('is-blocked'); meta.push(blockedChip); }
        if (task && task.remind_at) meta.push(createChip('Напомнить: ' + formatShortDateTimeLocal(task.remind_at)));
        if (task && task.id && isTaskFocusProtected(task.id)) meta.push(createChip('Защищённый фокус-слот'));
        getTaskRiskMetaNodes(task).forEach(function (node) { meta.push(node); });
        return meta;
      }

      function getSuggestedTodaySlotIso(dayYmd, task) {
        var tasks = getTasksForDay(dayYmd).slice().sort(compareTasksByDueAndUpdated);
        var gridStep = Math.max(Number(state.gridStepMinutes) || 15, 5);
        var duration = Math.max(Number(getTaskDurationMinutes(task)) || DEFAULT_EVENT_DURATION_MIN, gridStep);
        var planningWindow = getPlanningWindowHours();
        var nextStart = planningWindow.startHour * 60;
        tasks.forEach(function (item) {
          if (!(item && item.due_at)) return;
          var start = new Date(item.due_at);
          if (isNaN(start.getTime())) return;
          var startMinutes = start.getHours() * 60 + start.getMinutes();
          var endMinutes = startMinutes + Math.max(Number(getTaskDurationMinutes(item)) || DEFAULT_EVENT_DURATION_MIN, gridStep);
          if (endMinutes >= nextStart) nextStart = endMinutes + gridStep;
        });
        var planningWindow = getPlanningWindowHours();
        var latestStart = planningWindow.endHour * 60 - duration;
        if (nextStart > latestStart) nextStart = latestStart;
        if (nextStart < planningWindow.startHour * 60) nextStart = planningWindow.startHour * 60;
        return makeDueAtIso(dayYmd, minutesToClockLabel(nextStart));
      }

      function getSuggestedLaterTodaySlotIso(dayYmd, task) {
        var tasks = getTasksForDay(dayYmd).filter(function (item) { return !(item && task && item.id === task.id); }).sort(compareTasksByDueAndUpdated);
        var gridStep = Math.max(Number(state.gridStepMinutes) || 15, 5);
        var duration = Math.max(Number(getTaskDurationMinutes(task)) || DEFAULT_EVENT_DURATION_MIN, gridStep);
        var now = new Date();
        var planningWindow = getPlanningWindowHours();
        var nextStart = planningWindow.startHour * 60;
        if (dayYmd === formatYmdLocal(now)) {
          nextStart = Math.max(nextStart, Math.ceil(((now.getHours() * 60 + now.getMinutes()) + gridStep) / gridStep) * gridStep);
        }
        tasks.forEach(function (item) {
          if (!(item && item.due_at)) return;
          var start = new Date(item.due_at);
          if (isNaN(start.getTime())) return;
          var startMinutes = start.getHours() * 60 + start.getMinutes();
          var endMinutes = startMinutes + Math.max(Number(getTaskDurationMinutes(item)) || DEFAULT_EVENT_DURATION_MIN, gridStep);
          if (endMinutes >= nextStart) nextStart = endMinutes + gridStep;
        });
        var planningWindow = getPlanningWindowHours();
        var latestStart = planningWindow.endHour * 60 - duration;
        if (nextStart > latestStart) nextStart = latestStart;
        if (nextStart < planningWindow.startHour * 60) nextStart = planningWindow.startHour * 60;
        return makeDueAtIso(dayYmd, minutesToClockLabel(nextStart));
      }

      function getSuggestedTomorrowSlotIso(dayYmd, task) {
        return getSuggestedTodaySlotIso(addDaysYmd(dayYmd || state.dayYmd || formatYmdLocal(new Date()), 1), task);
      }

      async function moveTodayTaskToWeek(task) {
        if (!(task && task.id)) return;
