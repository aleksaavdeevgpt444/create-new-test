      function getDefaultWorkspaceFilters() {
        return {
          search: '',
          project: 'all',
          status: 'all',
          priority: 'all',
          timing: 'all'
        };
      }

      function normalizeWorkspaceFilterValue(value) {
        return String(value === undefined || value === null ? '' : value).trim();
      }

      function normalizeWorkspaceFilters(value) {
        var source = value && typeof value === 'object' ? value : {};
        var next = getDefaultWorkspaceFilters();
        var project = normalizeWorkspaceFilterValue(source.project || 'all');
        var status = normalizeWorkspaceFilterValue(source.status || 'all');
        var priority = normalizeWorkspaceFilterValue(source.priority || 'all');
        var timing = normalizeWorkspaceFilterValue(source.timing || 'all');
        next.search = normalizeWorkspaceFilterValue(source.search);
        next.project = project || 'all';
        next.status = status || 'all';
        next.priority = priority || 'all';
        next.timing = timing || 'all';
        return next;
      }

      function cloneWorkspaceFilters(value) {
        return normalizeWorkspaceFilters(value || state.workspaceFilters || getDefaultWorkspaceFilters());
      }

      function loadStoredWorkspaceFilters() {
        try {
          var raw = localStorage.getItem(WORKSPACE_FILTERS_STORAGE_KEY);
          if (!raw) return getDefaultWorkspaceFilters();
          return normalizeWorkspaceFilters(JSON.parse(raw));
        } catch (error) {
          return getDefaultWorkspaceFilters();
        }
      }

      function persistWorkspaceFilters() {
        try {
          localStorage.setItem(WORKSPACE_FILTERS_STORAGE_KEY, JSON.stringify(normalizeWorkspaceFilters(state.workspaceFilters)));
        } catch (error) {}
      }

      function countActiveWorkspaceFilters(filters) {
        var safe = normalizeWorkspaceFilters(filters);
        var count = 0;
        if (safe.search) count += 1;
        if (safe.project !== 'all') count += 1;
        if (safe.status !== 'all') count += 1;
        if (safe.priority !== 'all') count += 1;
        if (safe.timing !== 'all') count += 1;
        return count;
      }

      function normalizeSavedWorkspaceView(value) {
        if (!(value && typeof value === 'object')) return null;
        var name = normalizeWorkspaceFilterValue(value.name);
        if (!name) return null;
        var safeView = normalizeViewName(value.view || state.currentView);
        return {
          id: normalizeWorkspaceFilterValue(value.id) || ('workspace-view-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8)),
          name: name.slice(0, 48),
          view: safeView,
          filters: normalizeWorkspaceFilters(value.filters),
          planFilter: normalizeWorkspaceFilterValue(value.planFilter || 'active') || 'active',
          planSort: normalizeWorkspaceFilterValue(value.planSort || 'priority') || 'priority',
          inboxFilter: normalizeWorkspaceFilterValue(value.inboxFilter || 'active') || 'active',
          inboxSourceFilter: normalizeWorkspaceFilterValue(value.inboxSourceFilter || 'all') || 'all',
          projectsHideInactive: value.projectsHideInactive === false ? false : true,
          createdAt: normalizeWorkspaceFilterValue(value.createdAt) || new Date().toISOString()
        };
      }

      function loadStoredSavedWorkspaceViews() {
        try {
          var raw = localStorage.getItem(SAVED_WORKSPACE_VIEWS_STORAGE_KEY);
          if (!raw) return [];
          var parsed = JSON.parse(raw);
          if (!Array.isArray(parsed)) return [];
          return parsed.map(normalizeSavedWorkspaceView).filter(Boolean).slice(0, 12);
        } catch (error) {
          return [];
        }
      }

      function persistSavedWorkspaceViews() {
        try {
          localStorage.setItem(SAVED_WORKSPACE_VIEWS_STORAGE_KEY, JSON.stringify((state.savedWorkspaceViews || []).map(normalizeSavedWorkspaceView).filter(Boolean).slice(0, 12)));
        } catch (error) {}
      }

      function getWorkspaceProjectOptions() {
        var map = Object.create(null);
        var result = [{ value: 'all', label: 'Все проекты' }];
        (state.allProjects || []).forEach(function (project) {
          var name = normalizeProjectName(project && project.name);
          var key = name.toLowerCase();
          if (!map[key]) {
            map[key] = true;
            result.push({ value: name, label: name });
          }
        });
        getShellTasks().forEach(function (task) {
          var name = normalizeProjectName(task && task.project_name);
          var key = name.toLowerCase();
          if (!map[key]) {
            map[key] = true;
            result.push({ value: name, label: name });
          }
        });
        return result.sort(function (a, b) {
          if (a.value === 'all') return -1;
          if (b.value === 'all') return 1;
          return String(a.label || '').localeCompare(String(b.label || ''), 'ru', { sensitivity: 'base' });
        });
      }

      function getTaskSearchText(task) {
        return [
          task && task.title || '',
          task && task.task_product || '',
          task && task.description || '',
          task && task.project_name || ''
        ].join(' ').toLowerCase();
      }

      function getTaskPriorityFilterValue(task) {
        var rank = getTaskPriorityRank(task);
        if (rank >= 3) return 'high';
        if (rank >= 2) return 'medium';
        if (rank >= 1) return 'low';
        return 'none';
      }

      function isTaskOverdueForWorkspace(task) {
        if (!(task && task.due_at)) return false;
        var status = normalizeStatus(task.status);
        if (status === STATUS.DONE || status === STATUS.CANCELED) return false;
        var dueMs = new Date(task.due_at).getTime();
        if (!isFinite(dueMs)) return false;
        return dueMs < Date.now();
      }

      function getWorkspaceTodayYmd() {
        return state.dayYmd || formatYmdLocal(new Date());
      }

      function matchesWorkspaceTiming(task, timing) {
        var safeTiming = normalizeWorkspaceFilterValue(timing || 'all') || 'all';
        if (safeTiming === 'all') return true;
        if (safeTiming === 'backlog') return !(task && task.due_at);
        if (safeTiming === 'scheduled') return !!(task && task.due_at);
        if (safeTiming === 'overdue') return isTaskOverdueForWorkspace(task);
        if (safeTiming === 'today') {
          return !!(task && task.due_at && getTaskWeekDayYmd(task) === getWorkspaceTodayYmd());
        }
        if (safeTiming === 'week') {
          return !!(task && task.due_at && isTaskInActivePeriod(task, 'week'));
        }
        return true;
      }

      function taskMatchesWorkspaceFilters(task, filters) {
        var safe = normalizeWorkspaceFilters(filters || state.workspaceFilters);
        if (!task) return false;
        if (safe.search) {
          var haystack = getTaskSearchText(task);
          var needle = safe.search.toLowerCase();
          if (haystack.indexOf(needle) === -1) return false;
        }
        if (safe.project !== 'all' && normalizeProjectName(task.project_name) !== safe.project) return false;
        if (safe.status !== 'all' && (normalizeStatus(task.status) || STATUS.NEW) !== safe.status) return false;
        if (safe.priority !== 'all' && getTaskPriorityFilterValue(task) !== safe.priority) return false;
        if (!matchesWorkspaceTiming(task, safe.timing)) return false;
        return true;
      }

      function applyWorkspaceTaskFilters(tasks, filters) {
        return (Array.isArray(tasks) ? tasks : []).filter(function (task) {
          return taskMatchesWorkspaceFilters(task, filters || state.workspaceFilters);
        });
      }

      function setWorkspaceFilters(nextFilters, options) {
        var merged = Object.assign({}, state.workspaceFilters || getDefaultWorkspaceFilters(), nextFilters || {});
        state.workspaceFilters = normalizeWorkspaceFilters(merged);
        persistWorkspaceFilters();
        if (!(options && options.skipRender)) renderShellViews();
      }

      function resetWorkspaceFilters(options) {
        state.workspaceFilters = getDefaultWorkspaceFilters();
