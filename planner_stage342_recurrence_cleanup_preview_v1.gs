function jsonResponse(data, init = {}) {
  const headers = new Headers(init.headers || {});
  headers.set("cache-control", "no-store");
  return Response.json(data, { ...init, headers });
}

function textResponse(text, status = 200, extraHeaders = {}) {
  const headers = new Headers(extraHeaders);
  headers.set("content-type", "text/plain; charset=UTF-8");
  headers.set("cache-control", "no-store");
  return new Response(text, { status, headers });
}

function htmlResponse(html, status = 200, extraHeaders = {}) {
  const headers = new Headers(extraHeaders);
  headers.set("content-type", "text/html; charset=UTF-8");
  headers.set("cache-control", "no-store");
  return new Response(html, { status, headers });
}

function svgResponse(svg, status = 200, extraHeaders = {}) {
  const headers = new Headers(extraHeaders);
  headers.set("content-type", "image/svg+xml; charset=UTF-8");
  headers.set("cache-control", "public, max-age=86400");
  return new Response(svg, { status, headers });
}

function readAdminToken(env) {
  const token = String(env && env.ADMIN_TOKEN || '').trim();
  return token || '';
}

function isAdminProtectionEnabled(env) {
  return !!readAdminToken(env);
}

function readAdminTokenFromRequest(request) {
  if (!request) return '';
  const authHeader = String(request.headers.get('authorization') || '').trim();
  if (authHeader) {
    const bearerMatch = authHeader.match(/^Bearer\s+(.+)$/i);
    if (bearerMatch && bearerMatch[1]) return String(bearerMatch[1]).trim();
  }
  const headerToken = String(
    request.headers.get('x-admin-token') ||
    request.headers.get('x-planner-admin-token') ||
    request.headers.get('x-api-admin-token') ||
    ''
  ).trim();
  if (headerToken) return headerToken;
  try {
    const url = new URL(request.url);
    const queryToken = String(url.searchParams.get('admin_token') || url.searchParams.get('token') || '').trim();
    if (queryToken) return queryToken;
  } catch (error) {
    return headerToken;
  }
  return '';
}

function isAdminRequestAuthorized(request, env) {
  const configured = readAdminToken(env);
  if (!configured) return true;
  const provided = readAdminTokenFromRequest(request);
  return !!provided && provided === configured;
}

function requireAdminRouteAuth(request, env, routeLabel = 'admin') {
  if (isAdminRequestAuthorized(request, env)) return null;
  return jsonResponse({
    ok: false,
    error: 'Unauthorized',
    route: String(routeLabel || 'admin'),
    hint: 'Provide ADMIN_TOKEN via Authorization: Bearer <token> or x-admin-token header.'
  }, { status: 401 });
}

function readUserSessionSecret(env) {
  const token = String(
    env && (env.USER_SESSION_SECRET || env.AUTH_SESSION_SECRET || env.PLANNER_SESSION_SECRET || env.TELEGRAM_BOT_TOKEN) || ''
  ).trim();
  return token || '';
}

function isUserSessionStrictModeEnabled(env) {
  const raw = String(env && env.REQUIRE_USER_SESSION || '').trim().toLowerCase();
  return raw === '1' || raw === 'true' || raw === 'yes' || raw === 'on';
}

function isManualUserModeEnabled(env) {
  const raw = String(
    env && (env.ALLOW_MANUAL_USER_MODE || env.MANUAL_USER_MODE_ENABLED || '') || ''
  ).trim().toLowerCase();
  if (!raw) return true;
  return !(raw === '0' || raw === 'false' || raw === 'no' || raw === 'off' || raw === 'disabled');
}

function readExplicitClientAuthMode(request) {
  if (!request) return '';
  const headerMode = String(
    request.headers.get(USER_AUTH_MODE_HEADER_NAME) ||
    request.headers.get('x-user-auth-mode') ||
    ''
  ).trim().toLowerCase();
  if (headerMode === 'manual' || headerMode === 'session' || headerMode === 'telegram') return headerMode;
  try {
    const url = new URL(request.url);
    const queryMode = String(url.searchParams.get('auth_mode') || '').trim().toLowerCase();
    if (queryMode === 'manual' || queryMode === 'session' || queryMode === 'telegram') return queryMode;
  } catch (error) {}
  return '';
}

function buildManualUserModeDisabledResponse() {
  return jsonResponse({
    ok: false,
    error: 'Manual user mode is disabled',
    reason: 'manual_user_mode_disabled',
    hint: 'Open /app inside Telegram Mini App or provide a valid planner session.'
  }, { status: 401 });
}

function buildManualUserScopedPassThroughRequest(request, sessionContext) {
  const headers = new Headers(request.headers || {});
  headers.set('x-authenticated-user-mode', 'manual');
  headers.set('x-manual-user-mode', '1');
  headers.delete('content-length');
  return {
    request: new Request(request.url, { method: request.method, headers, body: request.body }),
    url: new URL(request.url),
    session: sessionContext || null,
    authenticated_user_id: ''
  };
}

function readCookieValue(request, cookieName) {
  if (!request || !cookieName) return '';
  const cookieHeader = String(request.headers.get('cookie') || '').trim();
  if (!cookieHeader) return '';
  const parts = cookieHeader.split(';');
  for (let i = 0; i < parts.length; i += 1) {
    const pair = String(parts[i] || '').trim();
    if (!pair) continue;
    const eqIndex = pair.indexOf('=');
    if (eqIndex <= 0) continue;
    const name = pair.slice(0, eqIndex).trim();
    if (name !== cookieName) continue;
    try {
      return decodeURIComponent(pair.slice(eqIndex + 1).trim());
    } catch (error) {
      return pair.slice(eqIndex + 1).trim();
    }
  }
  return '';
}

function readUserSessionTokenFromRequest(request) {
  if (!request) return '';
  const headerToken = String(
    request.headers.get(USER_SESSION_HEADER_NAME) ||
    request.headers.get('x-user-session') ||
    readCookieValue(request, USER_SESSION_COOKIE_NAME) ||
    ''
  ).trim();
  if (headerToken) return headerToken;
  try {
    const url = new URL(request.url);
    const queryToken = String(url.searchParams.get('session_token') || '').trim();
    if (queryToken) return queryToken;
  } catch (error) {}
  return '';
}

function bytesToBase64Url(bytes) {
  let binary = '';
  const chunkSize = 0x8000;
  for (let i = 0; i < bytes.length; i += chunkSize) {
    const chunk = bytes.subarray(i, i + chunkSize);
    binary += String.fromCharCode.apply(null, Array.from(chunk));
  }
  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
}

function base64UrlToBytes(value) {
  const normalized = String(value || '').replace(/-/g, '+').replace(/_/g, '/');
  const padded = normalized + '==='.slice((normalized.length + 3) % 4);
  const binary = atob(padded);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
  return bytes;
}

function readRequestUserIdFromUrl(url) {
  try {
    return String(url && url.searchParams ? (url.searchParams.get('user_id') || '') : '').trim();
  } catch (error) {
    return '';
  }
}

function shouldUseSecureCookiesForRequest(request) {
  try {
    const url = new URL(request.url);
    return String(url.protocol || '').toLowerCase() === 'https:';
  } catch (error) {
    return true;
  }
}

function buildUserSessionCookieValue(request, token, maxAgeSec = USER_SESSION_MAX_AGE_SEC) {
  const parts = [
    `${USER_SESSION_COOKIE_NAME}=${encodeURIComponent(String(token || ''))}`,
    'Path=/',
    'HttpOnly',
    'SameSite=Lax',
    `Max-Age=${Math.max(0, Number(maxAgeSec) || 0)}`
  ];
  if (shouldUseSecureCookiesForRequest(request)) parts.push('Secure');
  return parts.join('; ');
}

function buildUserSessionCookieClearValue(request) {
  const parts = [
    `${USER_SESSION_COOKIE_NAME}=`,
    'Path=/',
    'HttpOnly',
    'SameSite=Lax',
    'Max-Age=0',
    'Expires=Thu, 01 Jan 1970 00:00:00 GMT'
  ];
  if (shouldUseSecureCookiesForRequest(request)) parts.push('Secure');
  return parts.join('; ');
}


async function signUserSessionPayload(payloadJson, secret) {
  const key = await crypto.subtle.importKey(
    'raw',
    new TextEncoder().encode(secret),
    { name: 'HMAC', hash: 'SHA-256' },
    false,
    ['sign']
  );
  const signature = await crypto.subtle.sign('HMAC', key, new TextEncoder().encode(payloadJson));
  return bytesToBase64Url(new Uint8Array(signature));
}

async function createUserSessionToken(env, sessionPayload) {
  const secret = readUserSessionSecret(env);
  if (!secret) throw new Error('User session secret is not configured');
  const safeUserId = String(sessionPayload && sessionPayload.user_id || '').trim();
  if (!safeUserId) throw new Error('user_id is required for session token');
  const nowSec = Math.floor(Date.now() / 1000);
  const ttlSec = Math.max(300, Number(sessionPayload && sessionPayload.ttl_sec) || USER_SESSION_MAX_AGE_SEC);
  const payload = {
    v: USER_SESSION_TOKEN_VERSION,
    uid: safeUserId,
    username: sessionPayload && sessionPayload.username ? String(sessionPayload.username) : null,
    auth_mode: sessionPayload && sessionPayload.auth_mode ? String(sessionPayload.auth_mode) : 'telegram',
    iat: nowSec,
    exp: nowSec + ttlSec
  };
  const payloadJson = JSON.stringify(payload);
  const payloadBase64 = bytesToBase64Url(new TextEncoder().encode(payloadJson));
  const signatureBase64 = await signUserSessionPayload(payloadJson, secret);
  return {
    token: `${payloadBase64}.${signatureBase64}`,
    expires_at: new Date((payload.exp || nowSec) * 1000).toISOString(),
    payload
  };
}

/**
 * @typedef {Object} UserSessionContext
 * @property {boolean} ok
 * @property {boolean} token_present
 * @property {boolean} required
 * @property {string} token
 * @property {string} error
 * @property {string} user_id
 * @property {any} payload
 * @property {string} details
 */

/** @returns {Promise<UserSessionContext>} */
async function verifyUserSessionToken(env, token) {
  const safeToken = String(token || '').trim();
  if (!safeToken) return { ok: false, error: 'missing_session_token', token_present: false, required: false, token: '', user_id: '', payload: null, details: '' };
  const secret = readUserSessionSecret(env);
  if (!secret) return { ok: false, error: 'session_secret_not_configured', token_present: true, required: false, token: '', user_id: '', payload: null, details: '' };
  const parts = safeToken.split('.');
  if (parts.length !== 2 || !parts[0] || !parts[1]) return { ok: false, error: 'invalid_session_token_format', token_present: true, required: false, token: '', user_id: '', payload: null, details: '' };
  try {
    const payloadJson = new TextDecoder().decode(base64UrlToBytes(parts[0]));
    const expectedSignature = await signUserSessionPayload(payloadJson, secret);
    if (expectedSignature !== parts[1]) return { ok: false, error: 'invalid_session_token_signature', token_present: true, required: false, token: '', user_id: '', payload: null, details: '' };
    const payload = JSON.parse(payloadJson);
    const userId = String(payload && payload.uid || '').trim();
    if (!userId) return { ok: false, error: 'invalid_session_token_user', token_present: true, required: false, token: '', user_id: '', payload: null, details: '' };
    const nowSec = Math.floor(Date.now() / 1000);
    const expiresAt = Number(payload && payload.exp || 0);
    if (!expiresAt || expiresAt < nowSec) return { ok: false, error: 'session_token_expired', token_present: true, required: false, token: '', user_id: '', payload, details: '' };
    return { ok: true, token_present: true, required: false, token: '', error: '', user_id: userId, payload, details: '' };
  } catch (error) {
    return { ok: false, error: 'invalid_session_token_payload', details: String(error), token_present: true, required: false, token: '', user_id: '', payload: null };
  }
}

/** @returns {Promise<UserSessionContext>} */
async function resolveUserSessionContext(request, env) {
  const token = readUserSessionTokenFromRequest(request);
  if (!token) {
    return {
      ok: false,
      token_present: false,
      required: isUserSessionStrictModeEnabled(env),
      token: '',
      error: '',
      user_id: '',
      payload: null,
      details: ''
    };
  }
  const verification = await verifyUserSessionToken(env, token);
  return { ...verification, token: String(token || '') };
}

function buildUserSessionAuthFailureResponse(reason, options = {}) {
  const status = Number(options && options.status) || 401;
  const strict = !!(options && options.strict);
  return jsonResponse({
    ok: false,
    error: strict ? 'User session is required' : 'Invalid user session',
    reason: String(reason || 'user_session_error'),
    strict_mode: strict,
    hint: strict
      ? 'Open /app inside Telegram Mini App or pass a valid planner session token.'
      : 'Refresh Telegram auth or remove stale planner session token.'
  }, { status });
}

function withInjectedUserIdQuery(url, authenticatedUserId) {
  const nextUrl = new URL(url.toString());
  const existingUserId = readRequestUserIdFromUrl(nextUrl);
  if (existingUserId && existingUserId !== authenticatedUserId) {
    return { ok: false, error: 'user_id_mismatch', existing_user_id: existingUserId, authenticated_user_id: authenticatedUserId };
  }
  if (!existingUserId) nextUrl.searchParams.set('user_id', authenticatedUserId);
  return { ok: true, url: nextUrl };
}

async function buildUserScopedRequest(request, env) {
  const session = await resolveUserSessionContext(request, env);
  const strictMode = isUserSessionStrictModeEnabled(env);
  const manualUserModeEnabled = isManualUserModeEnabled(env);
  const explicitAuthMode = readExplicitClientAuthMode(request);
  const manualModeRequested = explicitAuthMode === 'manual';
  if (session.token_present && !session.ok) {
    if (manualModeRequested && manualUserModeEnabled) {
      return buildManualUserScopedPassThroughRequest(request, session);
    }
    return { response: buildUserSessionAuthFailureResponse(session.error || 'invalid_session', { strict: true, status: 401 }) };
  }
  if (!session.ok) {
    if (strictMode) return { response: buildUserSessionAuthFailureResponse('missing_session', { strict: true, status: 401 }) };
    if (!manualUserModeEnabled) return { response: buildManualUserModeDisabledResponse() };
    return buildManualUserScopedPassThroughRequest(request, session);
  }

  const authenticatedUserId = String(session.user_id || '').trim();
  const method = String(request.method || 'GET').toUpperCase();
  const sourceUrl = new URL(request.url);
  const urlResult = withInjectedUserIdQuery(sourceUrl, authenticatedUserId);
  if (!urlResult.ok) {
    return { response: jsonResponse({ ok: false, error: 'Forbidden', reason: urlResult.error, authenticated_user_id: authenticatedUserId }, { status: 403 }) };
  }
  const nextUrl = urlResult.url;
  const headers = new Headers(request.headers || {});
  headers.set('x-authenticated-user-id', authenticatedUserId);
  headers.set('x-authenticated-user-mode', String(session && session.payload && session.payload.auth_mode || 'session'));
  headers.delete('content-length');

  if (method === 'GET' || method === 'HEAD') {
    return {
      request: new Request(nextUrl.toString(), { method: request.method, headers }),
      url: nextUrl,
      session,
      authenticated_user_id: authenticatedUserId
    };
  }

  const contentType = String(request.headers.get('content-type') || '').toLowerCase();
  if (contentType && !contentType.includes('application/json')) {
    return {
      request: new Request(nextUrl.toString(), { method: request.method, headers, body: request.body }),
      url: nextUrl,
      session,
      authenticated_user_id: authenticatedUserId
    };
  }

  let bodyText = '';
  try {
    bodyText = await request.text();
  } catch (error) {
    bodyText = '';
  }
  /** @type {{ [key: string]: any, user_id?: string }} */
  let body = {};
  if (bodyText) {
    try {
      body = JSON.parse(bodyText);
    } catch (error) {
      return { response: jsonResponse({ ok: false, error: 'invalid_json_request_body' }, { status: 400 }) };
    }
  }
  if (!body || typeof body !== 'object' || Array.isArray(body)) body = {};
  const existingUserId = String(body.user_id || '').trim();
  if (existingUserId && existingUserId !== authenticatedUserId) {
    return { response: jsonResponse({ ok: false, error: 'Forbidden', reason: 'user_id_mismatch', authenticated_user_id: authenticatedUserId }, { status: 403 }) };
  }
  body.user_id = authenticatedUserId;
  headers.set('content-type', 'application/json');
  return {
    request: new Request(nextUrl.toString(), { method: request.method, headers, body: JSON.stringify(body) }),
    url: nextUrl,
    session,
    authenticated_user_id: authenticatedUserId
  };
}

