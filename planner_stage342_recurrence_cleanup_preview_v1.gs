      function getStructureRoleProfileMeta(value) {
        var key = String(value || '').trim().toLowerCase();
        return STRUCTURE_ROLE_PROFILE_REGISTRY.find(function (item) { return item.id === key; }) || null;
      }

      function getStructurePrimarySystemMeta(value) {
        var key = String(value || '').trim().toLowerCase();
        return STRUCTURE_PRIMARY_SYSTEM_OPTIONS.find(function (item) { return item.id === key; }) || null;
      }

      function getDefaultStructureLayerSettings() {
        return {
          enabled: true,
          showTodayCard: true,
          showWeekCard: true,
          layers: {
            intake: true,
            priority: true,
            capacity: true,
            calendar: true,
            review: true,
            gtd: true,
            para: true
          },
          roleProfile: 'author',
          primarySystem: 'author'
        };
      }

      function normalizeStructureLayerSettings(value) {
        var source = value && typeof value === 'object' ? value : {};
        var defaults = getDefaultStructureLayerSettings();
        var roleProfile = getStructureRoleProfileMeta(source.roleProfile) ? String(source.roleProfile).trim().toLowerCase() : defaults.roleProfile;
        var primarySystem = getStructurePrimarySystemMeta(source.primarySystem) ? String(source.primarySystem).trim().toLowerCase() : defaults.primarySystem;
        return {
          enabled: source.enabled !== undefined ? !!source.enabled : defaults.enabled,
          showTodayCard: source.showTodayCard !== undefined ? !!source.showTodayCard : defaults.showTodayCard,
          showWeekCard: source.showWeekCard !== undefined ? !!source.showWeekCard : defaults.showWeekCard,
          layers: {
            intake: source.layers && source.layers.intake !== undefined ? !!source.layers.intake : defaults.layers.intake,
            priority: source.layers && source.layers.priority !== undefined ? !!source.layers.priority : defaults.layers.priority,
            capacity: source.layers && source.layers.capacity !== undefined ? !!source.layers.capacity : defaults.layers.capacity,
            calendar: source.layers && source.layers.calendar !== undefined ? !!source.layers.calendar : defaults.layers.calendar,
            review: source.layers && source.layers.review !== undefined ? !!source.layers.review : defaults.layers.review,
            gtd: source.layers && source.layers.gtd !== undefined ? !!source.layers.gtd : defaults.layers.gtd,
            para: source.layers && source.layers.para !== undefined ? !!source.layers.para : defaults.layers.para
          },
          roleProfile: roleProfile,
          primarySystem: primarySystem
        };
      }

      function loadStoredStructureLayerSettings() {
        try {
          var raw = localStorage.getItem(STRUCTURE_LAYER_SETTINGS_STORAGE_KEY);
          if (!raw) return getDefaultStructureLayerSettings();
          return normalizeStructureLayerSettings(JSON.parse(raw));
        } catch (error) {
          return getDefaultStructureLayerSettings();
        }
      }

      function saveStoredStructureLayerSettings() {
        try {
          localStorage.setItem(STRUCTURE_LAYER_SETTINGS_STORAGE_KEY, JSON.stringify(normalizeStructureLayerSettings(state.structureLayerSettings || getDefaultStructureLayerSettings())));
        } catch (error) {}
      }

      function getStructurePrimarySystemOptionsHtml() {
        return STRUCTURE_PRIMARY_SYSTEM_OPTIONS.map(function (item) { return '<option value="' + escapeHtml(item.id) + '">' + escapeHtml(item.title) + '</option>'; }).join('');
      }

      function getStructureRoleProfileOptionsHtml() {
        return STRUCTURE_ROLE_PROFILE_REGISTRY.map(function (item) { return '<option value="' + escapeHtml(item.id) + '">' + escapeHtml(item.title) + '</option>'; }).join('');
      }

      function syncStructureLayerSettingsInputs() {
        var settings = normalizeStructureLayerSettings(state.structureLayerSettings || getDefaultStructureLayerSettings());
        state.structureLayerSettings = settings;
        [
          ['structureLayerEnabledInput', settings.enabled],
          ['structureTodayCardInput', settings.showTodayCard],
          ['structureWeekCardInput', settings.showWeekCard],
          ['structureIntakeInput', settings.layers.intake],
          ['structurePriorityInput', settings.layers.priority],
          ['structureCapacityInput', settings.layers.capacity],
          ['structureCalendarInput', settings.layers.calendar],
          ['structureReviewInput', settings.layers.review],
          ['structureGtdInput', settings.layers.gtd],
          ['structureParaInput', settings.layers.para]
        ].forEach(function (pair) {
          var node = byId(pair[0]);
          if (node) node.checked = !!pair[1];
        });
        var roleSelect = byId('structureRoleProfileSelect');
        if (roleSelect) {
          roleSelect.innerHTML = getStructureRoleProfileOptionsHtml();
          roleSelect.value = settings.roleProfile || 'author';
        }
        var primarySelect = byId('structurePrimarySystemSelect');
        if (primarySelect) {
          primarySelect.innerHTML = getStructurePrimarySystemOptionsHtml();
          primarySelect.value = settings.primarySystem || 'author';
        }
        renderStructureProfileCards();
      }

      function renderStructureProfileCards() {
        var container = byId('structureProfileCards');
        if (!container) return;
        var settings = normalizeStructureLayerSettings(state.structureLayerSettings || getDefaultStructureLayerSettings());
        container.innerHTML = STRUCTURE_ROLE_PROFILE_REGISTRY.map(function (profile) {
          var layers = [];
          Object.keys(profile.settings.layers || {}).forEach(function (key) { if (profile.settings.layers[key]) layers.push(key); });
          return '' +
            '<article class="framework-knowledge-card' + (settings.roleProfile === profile.id ? ' is-active' : '') + '">' +
              '<div class="framework-knowledge-card-head"><div class="framework-knowledge-title">' + escapeHtml(profile.title) + '</div><div class="framework-knowledge-status ' + (settings.roleProfile === profile.id ? 'partial' : 'planned') + '">' + (settings.roleProfile === profile.id ? 'активен' : 'профиль') + '</div></div>' +
              '<div class="framework-knowledge-meta">Primary: ' + escapeHtml((getStructurePrimarySystemMeta(profile.primarySystem) || { title: '—' }).title) + '</div>' +
              '<p class="framework-knowledge-summary">Слои: ' + escapeHtml(layers.join(' · ')) + '.</p>' +
              '<div class="execution-flow-toolbar"><button class="btn-ghost" type="button" data-structure-profile-apply="' + escapeHtml(profile.id) + '">Применить</button></div>' +
            '</article>';
        }).join('');
        Array.prototype.forEach.call(container.querySelectorAll('[data-structure-profile-apply]'), function (button) {
          button.addEventListener('click', function () {
            applyStructureRoleProfile(String(button.getAttribute('data-structure-profile-apply') || 'author'));
          });
        });
      }

      function applyStructureLayerSettings(settings, options) {
        state.structureLayerSettings = normalizeStructureLayerSettings(settings || getDefaultStructureLayerSettings());
        saveStoredStructureLayerSettings();
        syncStructureLayerSettingsInputs();
        if (options && options.silent) return;
        if (state.currentView === 'today') renderTodayView();
        if (state.currentView === 'planner') renderCalendarFrame();
        showSuccess('Настройки Structure Layer обновлены.');
      }

      function updateStructureLayerSetting(path, value) {
        var next = normalizeStructureLayerSettings(state.structureLayerSettings || getDefaultStructureLayerSettings());
        if (path === 'enabled') next.enabled = !!value;
        else if (path === 'showTodayCard') next.showTodayCard = !!value;
        else if (path === 'showWeekCard') next.showWeekCard = !!value;
        else if (path.indexOf('layers.') === 0) {
          var key = path.split('.')[1] || '';
          if (next.layers[key] !== undefined) next.layers[key] = !!value;
        } else if (path === 'roleProfile') next.roleProfile = getStructureRoleProfileMeta(value) ? String(value).trim().toLowerCase() : next.roleProfile;
        else if (path === 'primarySystem') next.primarySystem = getStructurePrimarySystemMeta(value) ? String(value).trim().toLowerCase() : next.primarySystem;
        applyStructureLayerSettings(next);
      }

      function applyStructureRoleProfile(profileId) {
        var profile = getStructureRoleProfileMeta(profileId) || getStructureRoleProfileMeta('author');
        var next = normalizeStructureLayerSettings((profile && profile.settings) || getDefaultStructureLayerSettings());
        next.roleProfile = (profile && profile.id) || 'author';
        next.primarySystem = (profile && profile.primarySystem) || 'author';
        applyStructureLayerSettings(next);
      }

      function ensureTodayAuthorSystemCard() {
        var anchor = byId('todayTimeAnalytics');
        var existing = byId('todayAuthorSystemCard');
        if (existing) return existing;
