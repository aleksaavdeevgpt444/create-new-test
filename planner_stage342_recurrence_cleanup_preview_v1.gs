      type: 'object',
      properties: {
        priority_level: { type: 'string', enum: ['low', 'medium', 'high'] },
        priority_reason: { type: 'string' },
        project_guess: { type: 'string' },
        next_step: { type: 'string' },
        search_queries: { type: 'array', items: { type: 'string' } },
