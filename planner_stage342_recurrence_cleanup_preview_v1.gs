      function getGanttFocusOptions() {
        return ['active', 'attention', 'blocked', 'done', 'all'];
      }

      function getGanttVisibleTasks(tasks) {
        var focus = getGanttFocusOptions().indexOf(state.ganttFocus) >= 0 ? state.ganttFocus : 'active';
        var list = (tasks || []).filter(function (task) { return !!(task && task.due_at); });
        if (focus === 'attention') return getAttentionTasks(list);
        if (focus === 'blocked') {
          return list.filter(function (task) {
            var dependencyMeta = getTaskDependencyMeta(task);
            var riskMeta = getTaskRiskMeta(task);
            return !!(dependencyMeta && dependencyMeta.blockedByTask) || !!(riskMeta && riskMeta.isBlocked);
          });
        }
        if (focus === 'done') {
          return list.filter(function (task) { return (normalizeStatus(task && task.status) || STATUS.NEW) === STATUS.DONE; });
        }
        if (focus === 'active') {
          return list.filter(function (task) {
            var status = normalizeStatus(task && task.status) || STATUS.NEW;
            return status !== STATUS.DONE && status !== STATUS.CANCELED;
          });
        }
        return list;
      }

      function getGanttProjectRowsData(tasks, rangeStartMs, rangeEndMs) {
        var grouped = Object.create(null);
        (tasks || []).forEach(function (task) {
          var project = normalizeProjectName(task && task.project_name);
          if (!grouped[project]) grouped[project] = [];
          var dueMs = task && task.due_at ? new Date(task.due_at).getTime() : NaN;
          if (isNaN(dueMs)) return;
          var taskEnd = getTaskEndDate(task);
          var taskEndMs = taskEnd ? taskEnd.getTime() : dueMs + getTaskDurationMinutes(task) * 60000;
          if (taskEndMs <= rangeStartMs || dueMs >= rangeEndMs) return;
          grouped[project].push(task);
        });
        return Object.keys(grouped).map(function (project) {
          var projectTasks = grouped[project].slice().sort(compareTasksByDueAndUpdated);
          var attentionCount = 0;
          var blockedCount = 0;
          var doneCount = 0;
          var plannedMinutes = 0;
          var firstStartMs = Infinity;
          var lastEndMs = 0;
          projectTasks.forEach(function (task) {
            var dueMs = new Date(task.due_at).getTime();
            var taskEnd = getTaskEndDate(task);
            var endMs = taskEnd ? taskEnd.getTime() : dueMs + getTaskDurationMinutes(task) * 60000;
            if (dueMs < firstStartMs) firstStartMs = dueMs;
            if (endMs > lastEndMs) lastEndMs = endMs;
            plannedMinutes += getTaskPlannedMinutesValue(task);
            if (isTaskAttentionNeeded(task)) attentionCount += 1;
            if (getTaskDependencyMeta(task).blockedByTask) blockedCount += 1;
            if ((normalizeStatus(task && task.status) || STATUS.NEW) === STATUS.DONE) doneCount += 1;
          });
          return {
            project: project,
            tasks: projectTasks,
            count: projectTasks.length,
            attentionCount: attentionCount,
            blockedCount: blockedCount,
            doneCount: doneCount,
            plannedMinutes: plannedMinutes,
            firstStartMs: Number.isFinite(firstStartMs) ? firstStartMs : 0,
            lastEndMs: lastEndMs,
            leadTask: projectTasks.length ? projectTasks[0] : null
          };
        }).sort(function (a, b) {
          var sort = ['timeline', 'load', 'attention', 'project'].indexOf(state.ganttSort) >= 0 ? state.ganttSort : 'timeline';
          if (sort === 'load') {
            if (a.plannedMinutes !== b.plannedMinutes) return b.plannedMinutes - a.plannedMinutes;
            if (a.count !== b.count) return b.count - a.count;
            return a.project.localeCompare(b.project, 'ru', { sensitivity: 'base' });
          }
          if (sort === 'attention') {
            if (a.attentionCount !== b.attentionCount) return b.attentionCount - a.attentionCount;
            if (a.blockedCount !== b.blockedCount) return b.blockedCount - a.blockedCount;
            return a.project.localeCompare(b.project, 'ru', { sensitivity: 'base' });
          }
          if (sort === 'project') {
            return a.project.localeCompare(b.project, 'ru', { sensitivity: 'base' });
          }
          if (a.firstStartMs !== b.firstStartMs) return a.firstStartMs - b.firstStartMs;
          return a.project.localeCompare(b.project, 'ru', { sensitivity: 'base' });
        });
      }


      function getGanttProjectFilterOptions(rows) {
        var options = [{ value: 'all', label: 'Все проекты' }];
        (rows || []).forEach(function (row) {
          if (!row || !row.project) return;
