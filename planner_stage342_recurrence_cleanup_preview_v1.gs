          structure: ['low','medium','high'].indexOf(String(source.structure || '').trim()) >= 0 ? String(source.structure).trim() : defaults.structure,
          priority: ['execution','planning','strategy','focus','control'].indexOf(String(source.priority || '').trim()) >= 0 ? String(source.priority).trim() : defaults.priority
        };
