        const board = await getBoardData(env, { userId: String(userId), limitPerStatus });
        return jsonResponse({ ok: true, build: getClientAppBuildLabel(), board });
      } catch (error) {
        return jsonResponse({ ok: false, error: String(error) }, { status: 500 });
      }
    }

    if (url.pathname === "/tasks") {
      try {
        const userId = url.searchParams.get("user_id");
        const status = url.searchParams.get("status");
        const limit = Number(url.searchParams.get("limit")) || WEB_LIST_LIMIT;
        if (!userId) {
          return jsonResponse({
            ok: false,
            error: "user_id is required",
            build: getClientAppBuildLabel(),
            hint: "Call /tasks?user_id=... or open /app?user_id=...",
            example: `${url.origin}/tasks?user_id=1436885461&limit=${WEB_LIST_LIMIT}`
          }, { status: 400 });
        }
        const result = await queryTasks(env, { userId, status, limit });
        return jsonResponse({ ok: true, build: getClientAppBuildLabel(), items: result.results || [] });
      } catch (error) {
        return jsonResponse({ ok: false, error: String(error) }, { status: 500 });
      }
    }

    if (url.pathname === "/tasks/similar-by-embedding") return handleTaskSimilarByEmbeddingApi(request, env);
    if (url.pathname === "/diagnostics/ai") return handleAiDiagnosticsApi(request, env);
