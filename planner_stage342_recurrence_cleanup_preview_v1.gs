      function getRecurrencePayloadFromScope(scope) {
        var typeHidden = byId(scope + 'RecurrenceTypeInput');
        var ruleHidden = byId(scope + 'RecurrenceRuleInput');
        var enabledHidden = byId(scope + 'RecurrenceEnabledInput');
        return {
          type: String(typeHidden ? (typeHidden.value || '') : '').trim() || null,
          rule: String(ruleHidden ? (ruleHidden.value || '') : '').trim() || null,
          enabled: Number(enabledHidden ? (enabledHidden.value || 0) : 0) ? 1 : 0
        };
