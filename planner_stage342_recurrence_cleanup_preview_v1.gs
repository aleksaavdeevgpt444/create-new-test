        var riskItems = Array.isArray(sections.risk) ? sections.risk : [];
        var noDateItems = Array.isArray(sections.noDate) ? sections.noDate : [];
        var additionalItems = Array.isArray(sections.additional) ? sections.additional : [];
        var recurringItems = Array.isArray(sections.recurring) ? sections.recurring : [];
        var plannedWeekItems = (Array.isArray(data && data.activeWeekTasks) ? data.activeWeekTasks : []).filter(function (task) { return !!(task && task.due_at); });
        var unscheduledWeekItems = (Array.isArray(data && data.activeWeekTasks) ? data.activeWeekTasks : []).filter(function (task) { return !(task && task.due_at); });
        return {
          routeLabel: 'Inbox → Plan → Week → Today',
          weeklyFocusCount: mainItems.length,
          readyForTodayCount: mainItems.length + importantItems.filter(function (task) { return !!(task && task.due_at); }).length,
          needsSchedulingCount: noDateItems.length + unscheduledWeekItems.length,
          riskCount: riskItems.length,
          reserveCount: additionalItems.length,
          recurringCount: recurringItems.length,
          plannedWeekCount: plannedWeekItems.length,
          backlogCount: noDateItems.length,
          doneCount: data && data.stats ? Number(data.stats.done || 0) : 0,
          todayYmd: state.dayYmd || formatYmdLocal(new Date())
