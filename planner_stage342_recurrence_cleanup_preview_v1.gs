        if (/(telegram|\btg\b|бот)/i.test(source)) return 'Telegram';
  if (/(соф|садик|школ|ребен|ребён|семь|семейн|обед|поликлиник|врач)/i.test(source)) return 'Личное';
        if (/(соф|садик|школ|ребен|ребён|семь|семейн|обед|поликлиник|врач)/i.test(source)) return 'Личное';
