      function ensureTaskRiskDialog() {
        if (state.taskRiskDialog) return state.taskRiskDialog;
        var backdrop = document.createElement('div');
        backdrop.style.cssText = [
          'position:fixed','inset:0','display:none','align-items:center','justify-content:center','padding:20px',
          'background:rgba(7,10,18,.58)','backdrop-filter:blur(4px)','z-index:9999'
        ].join(';');

        var panel = document.createElement('div');
        panel.style.cssText = [
          'width:min(620px, calc(100vw - 24px))','max-height:calc(100vh - 40px)','overflow:auto',
          'background:var(--panel,#151925)','border:1px solid rgba(255,255,255,.10)','border-radius:18px',
          'box-shadow:0 24px 70px rgba(0,0,0,.45)','padding:20px','display:grid','gap:14px'
        ].join(';');

        panel.innerHTML = [
          '<div style="display:grid;gap:6px;">',
            '<div id="taskRiskDialogTitle" style="font-size:20px;font-weight:900;line-height:1.2;color:var(--text,#f5f7fb);">Риск / блокер</div>',
            '<div id="taskRiskDialogSubtitle" style="font-size:13px;line-height:1.5;color:var(--muted,rgba(255,255,255,.72));">Отметь риск, блокер и stalled-состояние без вмешательства в основную модель задачи.</div>',
          '</div>',
          '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;">',
            '<div><label class="field-label" for="taskRiskLevelSelect">Уровень риска</label><select id="taskRiskLevelSelect"><option value="none">Нет</option><option value="low">Низкий</option><option value="medium">Средний</option><option value="high">Высокий</option></select></div>',
            '<div><label class="field-label" for="taskDeadlineRiskSelect">Риск дедлайна</label><select id="taskDeadlineRiskSelect"><option value="normal">Нормально</option><option value="watch">Под наблюдением</option><option value="at-risk">Может не успеть</option><option value="critical">Критично</option></select></div>',
          '</div>',
          '<div><label class="field-label" for="taskRiskBlockedBySelect">Блокируется задачей</label><select id="taskRiskBlockedBySelect"><option value="">Нет блокера</option></select></div>',
          '<label class="checkbox-row"><input id="taskRiskStalledInput" type="checkbox" style="width:18px;height:18px;accent-color:var(--primary);margin-top:2px;" /><span>Пометить как stalled / застряла</span></label>',
          '<div id="taskRiskDialogHint" class="field-help">После сохранения риски сразу появятся в Сегодня OS, Плане и Неделе без обновления страницы.</div>',
          '<div style="display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap;">',
            '<button id="taskRiskDialogClearBtn" class="btn-ghost" type="button">Очистить</button>',
            '<button id="taskRiskDialogCancelBtn" class="btn-ghost" type="button">Отмена</button>',
            '<button id="taskRiskDialogSaveBtn" class="btn-primary" type="button">Сохранить</button>',
          '</div>'
        ].join('');

        backdrop.appendChild(panel);
        document.body.appendChild(backdrop);

        var dialog = {
          backdrop: backdrop,
          title: panel.querySelector('#taskRiskDialogTitle'),
          subtitle: panel.querySelector('#taskRiskDialogSubtitle'),
          riskLevel: panel.querySelector('#taskRiskLevelSelect'),
          deadlineRisk: panel.querySelector('#taskDeadlineRiskSelect'),
          blockedBy: panel.querySelector('#taskRiskBlockedBySelect'),
          stalled: panel.querySelector('#taskRiskStalledInput'),
          clearBtn: panel.querySelector('#taskRiskDialogClearBtn'),
          cancelBtn: panel.querySelector('#taskRiskDialogCancelBtn'),
          saveBtn: panel.querySelector('#taskRiskDialogSaveBtn'),
          currentTaskId: ''
        };

        function closeDialog() {
          dialog.currentTaskId = '';
          backdrop.style.display = 'none';
        }

        dialog.cancelBtn.addEventListener('click', closeDialog);
        backdrop.addEventListener('click', function (event) {
          if (event.target === backdrop) closeDialog();
        });
        dialog.clearBtn.addEventListener('click', function () {
          if (!dialog.currentTaskId) return;
          clearTaskRiskEntry(dialog.currentTaskId);
          closeDialog();
          rerenderRiskSurfaces();
          showSuccess('Риск-метки по задаче очищены.');
        });
        dialog.saveBtn.addEventListener('click', function () {
          if (!dialog.currentTaskId) return;
          var payload = {
            riskLevel: normalizeRiskLevel(dialog.riskLevel.value),
            blockedByTaskId: String(dialog.blockedBy.value || '').trim(),
            stalledSince: dialog.stalled.checked ? formatYmdLocal(new Date()) : '',
            deadlineRiskState: normalizeDeadlineRiskState(dialog.deadlineRisk.value),
            updatedAt: new Date().toISOString()
          };
          if (payload.blockedByTaskId === String(dialog.currentTaskId)) payload.blockedByTaskId = '';
          setTaskRiskEntry(dialog.currentTaskId, payload);
          closeDialog();
          rerenderRiskSurfaces();
          showSuccess('Риск-слой по задаче обновлён.');
        });

        state.taskRiskDialog = dialog;
        return dialog;
      }

      function openTaskRiskDialog(taskId) {
        var task = findTaskById(taskId);
        if (!(task && task.id)) {
          showError('Не удалось найти задачу для risk-layer.');
          return;
        }
        var dialog = ensureTaskRiskDialog();
        var entry = getTaskRiskEntry(task.id);
        dialog.currentTaskId = String(task.id);
        dialog.title.textContent = 'Риск / блокер · ' + (task.title || 'Без названия');
        dialog.subtitle.textContent = 'Настрой слой внимания для задачи: блокер, stalled и риск дедлайна. Это безопасная локальная надстройка поверх planner.';
        dialog.riskLevel.value = entry.riskLevel || 'none';
        dialog.deadlineRisk.value = entry.deadlineRiskState || 'normal';
        dialog.stalled.checked = !!entry.stalledSince;

        dialog.blockedBy.innerHTML = '<option value="">Нет блокера</option>';
        getShellTasks().filter(function (item) {
          return item && item.id && String(item.id) !== String(task.id) && normalizeStatus(item.status) !== STATUS.DONE && normalizeStatus(item.status) !== STATUS.CANCELED;
        }).sort(compareTasksByPriorityThenDue).slice(0, 120).forEach(function (item) {
          var option = document.createElement('option');
          option.value = String(item.id);
          option.textContent = (item.title || ('#' + item.id)) + ' · ' + normalizeProjectName(item.project_name);
          dialog.blockedBy.appendChild(option);
        });
        dialog.blockedBy.value = entry.blockedByTaskId || '';
        dialog.backdrop.style.display = 'flex';
      }


      function getDefaultMeditationSettings() {
        return {
          enabled: true,
          durationMinutes: 3,
          showInToday: true,
          showInFocus: true
        };
      }

      function normalizeMeditationSettings(value) {
        var defaults = getDefaultMeditationSettings();
        var normalized = Object.assign({}, defaults);
        if (!value || typeof value !== 'object') return normalized;
        normalized.enabled = value.enabled !== false;
        var minutes = Number(value.durationMinutes);
        if (minutes === 2 || minutes === 3 || minutes === 5 || minutes === 10) normalized.durationMinutes = minutes;
        normalized.showInToday = value.showInToday !== false;
        normalized.showInFocus = value.showInFocus !== false;
        return normalized;
      }

      function loadStoredMeditationSettings() {
        try {
          var raw = localStorage.getItem(MEDITATION_SETTINGS_STORAGE_KEY);
          if (!raw) return getDefaultMeditationSettings();
          return normalizeMeditationSettings(JSON.parse(raw));
        } catch (error) {
          return getDefaultMeditationSettings();
        }
      }

      function applyMeditationSettings(settings) {
        var normalized = normalizeMeditationSettings(settings || state.meditationSettings || getDefaultMeditationSettings());
        state.meditationSettings = normalized;
        try { localStorage.setItem(MEDITATION_SETTINGS_STORAGE_KEY, JSON.stringify(normalized)); } catch (error) {}
        if (byId('meditationEnabledInput')) byId('meditationEnabledInput').checked = !!normalized.enabled;
        if (byId('meditationDurationSelect')) byId('meditationDurationSelect').value = String(normalized.durationMinutes);
        if (byId('meditationShowTodayInput')) byId('meditationShowTodayInput').checked = !!normalized.showInToday;
        if (byId('meditationShowFocusInput')) byId('meditationShowFocusInput').checked = !!normalized.showInFocus;
        renderTodayRitualCard(state.dayYmd || formatYmdLocal(new Date()));
        if (state.focusSession) renderFocusSession();
      }

