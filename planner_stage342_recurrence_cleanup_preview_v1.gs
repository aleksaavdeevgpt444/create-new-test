        var currentRecurrenceType = String(currentTask && currentTask.recurrence_type || '');
        var currentRecurrenceRule = String(currentTask && currentTask.recurrence_rule || '');
        var currentRecurrenceEnabled = Number(currentTask && currentTask.recurrence_enabled || 0);
        var otherChanged = false;
        if (title !== String(currentTask && currentTask.title || '').trim()) otherChanged = true;
        if (projectName !== currentProjectName) otherChanged = true;
        if (taskProduct !== String(currentTask && currentTask.task_product || '').trim()) otherChanged = true;
        if (description !== String(currentTask && currentTask.description || '').trim()) otherChanged = true;
        if (priorityManual !== currentPriorityManual) otherChanged = true;
        if ((dateValue || '') !== (currentDateValue || '')) otherChanged = true;
        if ((timeValue || '') !== (currentTimeValue || '')) otherChanged = true;
        if ((Number(durationValue) || DEFAULT_EVENT_DURATION_MIN) !== (Number(currentDurationValue) || DEFAULT_EVENT_DURATION_MIN)) otherChanged = true;
        if (normalizeMinutesInputValue(plannedMinutesManual) !== currentPlannedMinutesManual) otherChanged = true;
