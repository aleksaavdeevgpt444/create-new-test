        appendEditorTaskHelpSection(card, 'Почему такая уверенность', data.confidenceReason || '', null);
        appendEditorTaskHelpSection(card, 'Следующий шаг', data.nextStep || 'Нажми «AI-разбор», чтобы получить следующий шаг.', null);
        appendEditorTaskHelpSection(card, 'С чего начать прямо сейчас', data.startAction || '', null);
