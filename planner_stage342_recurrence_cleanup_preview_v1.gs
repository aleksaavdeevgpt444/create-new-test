      function applyWorkspacePreset(presetKey) {
        var key = normalizeWorkspaceFilterValue(presetKey || 'all') || 'all';
        if (key === 'all') {
          resetWorkspaceFilters();
          return;
        }
        if (key === 'backlog') {
          setWorkspaceFilters({ search: '', status: 'all', priority: 'all', project: 'all', timing: 'backlog' });
          return;
        }
        if (key === 'overdue') {
          setWorkspaceFilters({ search: '', status: 'all', priority: 'all', project: 'all', timing: 'overdue' });
          return;
        }
        if (key === 'done') {
          setWorkspaceFilters({ search: '', status: STATUS.DONE, priority: 'all', project: 'all', timing: 'all' });
          return;
        }
        if (key === 'focus-week') {
          setWorkspaceFilters({ search: '', status: 'all', priority: 'medium', project: 'all', timing: 'week' });
          return;
        }
      }

      function getActiveWorkspacePresetKey(filters) {
        var safe = normalizeWorkspaceFilters(filters || state.workspaceFilters);
        if (!countActiveWorkspaceFilters(safe)) return 'all';
        if (!safe.search && safe.project === 'all' && safe.status === 'all' && safe.priority === 'all' && safe.timing === 'backlog') return 'backlog';
        if (!safe.search && safe.project === 'all' && safe.status === 'all' && safe.priority === 'all' && safe.timing === 'overdue') return 'overdue';
        if (!safe.search && safe.project === 'all' && safe.status === STATUS.DONE && safe.priority === 'all' && safe.timing === 'all') return 'done';
        if (!safe.search && safe.project === 'all' && safe.status === 'all' && safe.priority === 'medium' && safe.timing === 'week') return 'focus-week';
        return '';
      }

