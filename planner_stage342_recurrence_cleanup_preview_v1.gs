      async function deleteRecurringEditorTask(scope) {
        if (!state.editorTaskId || !state.userId) return;
        var task = findTaskById(state.editorTaskId);
        var title = task && task.title ? task.title : 'эту задачу';
        var deleteScope = 'current';
        var confirmText = 'Удалить только текущую задачу «' + title + '»? Следующие повторения останутся.';
        var confirmed = await confirmPlannerAction({
          title: 'Удалить только эту задачу',
          text: confirmText,
          confirmLabel: 'Удалить только эту',
          confirmClassName: 'btn-delete'
        });
        if (!confirmed) return;
        state.requestState = deleteScope === 'current' ? 'удаление-повтора-текущая' : 'удаление-повтора-хвост';
        updateDebugInfo();
        showError('');
        try {
          var endpoint = '/tasks/recurrence/delete-current';
          var taskId = state.editorTaskId;
          var deleteBody = { task_id: taskId, user_id: state.userId };
          await requestJsonWithWriteResilience(endpoint, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(deleteBody),
            __meta: { requestName: 'recurrence-delete-current', retryCount: 1, retryDelayMs: 260 }
          });
          if (state.moveModeTaskId === taskId) exitMoveMode();
          state.editorRecurringIntent = '';
          closeEditor();
          await loadPlanner();
        } catch (error) {
          state.requestState = 'error';
          updateDebugInfo();
          showError(String(error));
        }
      }

      async function resetTaskDate(taskId) {
        await scheduleTask(taskId, null, STATUS.POSTPONED, undefined);
