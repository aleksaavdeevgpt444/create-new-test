            if (state.pointerDragCandidate && state.pointerDragCandidate.pointerKey === getManualDragPointerKey(event)) {
              state.pointerDragCandidate = null;
            }
          }, { passive: true });

          element.addEventListener('pointercancel', function (event) {
            if (state.pointerDragCandidate && state.pointerDragCandidate.pointerKey === getManualDragPointerKey(event)) {
              state.pointerDragCandidate = null;
            }
          }, { passive: true });

          if (!window.PointerEvent) {
            element.addEventListener('mousedown', function (event) {
              beginPointerDragCandidate(element, payload, event);
            }, { passive: true });

            element.addEventListener('mouseup', function (event) {
              if (state.pointerDragCandidate && state.pointerDragCandidate.pointerKey === getManualDragPointerKey(event)) {
                state.pointerDragCandidate = null;
              }
            }, { passive: true });
          }

          element.addEventListener('dragstart', function (event) {
            event.preventDefault();
            state.pointerDragCandidate = null;
          });
        } else {
          element.addEventListener('dragstart', function (event) {
            state.pointerDragCandidate = null;
            suppressClicks(700);
            hideTaskHoverCard();
            document.body.classList.add('drag-card-preview');
            var rect = element.getBoundingClientRect();
            var offsetY = event && Number.isFinite(event.clientY) ? Math.max(0, Math.min(rect.height, event.clientY - rect.top)) : 0;
            var pixelsPerMinute = getHourHeightPx() / 60;
            var anchorOffsetMinutes = pixelsPerMinute > 0 ? (offsetY / pixelsPerMinute) : 0;
            var effectivePayload = Object.assign({}, payload || {}, {
              taskId: payload.taskId,
              durationMinutes: Number((payload && payload.durationMinutes) || element.dataset.durationMinutes || 0) || null,
              sourceElement: element,
              anchorOffsetMinutes: Math.max(0, anchorOffsetMinutes || 0)
            });
            var useLiveCalendarPreview = shouldUseLiveCalendarDragPreview(effectivePayload);
            if (!useLiveCalendarPreview) {
              element.classList.add('dragging');
            }
            try {
              if (useLiveCalendarPreview) {
                var dragImage = getInvisibleDragImage();
                event.dataTransfer.setDragImage(dragImage, 0, 0);
              } else {
                var dragImageData = buildUnifiedDragImageFromPayload(element, effectivePayload, event);
                if (dragImageData && dragImageData.node) {
                  event.dataTransfer.setDragImage(dragImageData.node, dragImageData.offsetX, dragImageData.offsetY);
                } else {
                  var dragImage = getInvisibleDragImage();
                  event.dataTransfer.setDragImage(dragImage, 0, 0);
                }
              }
            } catch (error) {}
            setDragPayload(event, effectivePayload);
          });

          element.addEventListener('dragend', function () {
            suppressClicks(700);
            clearDragStateVisuals();
            cleanupDragImageElement();
            state.dragPayload = null;
            clearPointerDragFlow();
          });
        }

        attachLongPress(element, payload.taskId, {
          disableTapOpen: !!(payload && payload.disableTapOpen),
          manualOnly: manualOnlyCalendarDrag
        });
      }

      function setupQueueDropTarget(queueElement, queueStatus) {
        if (!queueElement.classList.contains('move-target')) return;

        queueElement.addEventListener('dragover', function (event) {
          var payload = getDragPayload(event);
          if (!payload || !payload.taskId) return;
          event.preventDefault();
          queueElement.classList.add('drag-over');
        });

        queueElement.addEventListener('dragleave', function () {
          queueElement.classList.remove('drag-over');
        });

        queueElement.addEventListener('drop', function (event) {
          var payload = getDragPayload(event);
          queueElement.classList.remove('drag-over');
          if (!payload || !payload.taskId) return;
          event.preventDefault();
          dropTaskToQueue(payload.taskId, queueStatus);
        });

        queueElement.addEventListener('click', function () {
          if (!state.moveModeTaskId) return;
          var task = findTaskById(state.moveModeTaskId);
          if (!task) return;
          dropTaskToQueue(task.id, queueStatus);
          exitMoveMode();
        });
      }

      function dropTaskToQueue(taskId, queueStatus) {
        if (queueStatus === STATUS.PLANNED) return;
        updateTaskStatus(taskId, queueStatus);
      }

      function renderCounts(counts, weekCounts) {
        var safeCounts = counts || {};
        var safeWeekCounts = weekCounts || safeCounts || {};
        renderWeekSummary(safeWeekCounts);

        byId('queueCountNew').textContent = String(safeCounts.new || 0);
        byId('queueCountPlanned').textContent = String(safeWeekCounts.planned || 0);
        byId('queueCountDone').textContent = String(safeWeekCounts.done || 0);
        byId('queueCountCanceled').textContent = String(safeWeekCounts.canceled || 0);
