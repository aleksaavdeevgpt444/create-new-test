      function renderCalendarFrame() {
        var daysHead = byId('calendarDaysHead');
        var timeColumn = byId('timeColumn');
        var grid = byId('calendarGrid');
        var eventsLayer = byId('eventsLayer');

        daysHead.innerHTML = '';
        timeColumn.innerHTML = '';
        grid.innerHTML = '';
        eventsLayer.innerHTML = '';
        var weekPreview = document.createElement('div');
        weekPreview.id = 'weekDragPreview';
        weekPreview.className = 'today-drag-preview';
        eventsLayer.appendChild(weekPreview);
        var weekHoverPreview = document.createElement('div');
        weekHoverPreview.id = 'weekHoverPreview';
        weekHoverPreview.className = 'today-hover-preview';
        var weekHoverLabel = document.createElement('div');
        weekHoverLabel.id = 'weekHoverPreviewLabel';
        weekHoverLabel.className = 'today-hover-preview-label';
        weekHoverPreview.appendChild(weekHoverLabel);
        eventsLayer.appendChild(weekHoverPreview);

        var days = buildVisibleDays('week');
        var renderWindow = getCalendarRenderWindowHours();
        var slotCount = ((renderWindow.endHour - renderWindow.startHour) * 60) / state.gridStepMinutes;

        var todayYmd = formatYmdLocal(new Date());
        var selectedDayYmd = state.dayYmd || todayYmd;
        renderWorkflowDayContext('plannerWorkflowDayContext', 'planner', selectedDayYmd);
        renderPlannerExecutionFlow(state.weekStart || getCurrentWeekStartYmd());
        renderPlannerAuthorSystemCard(state.weekStart || getCurrentWeekStartYmd());

        days.forEach(function (day) {
          var head = document.createElement('div');
          head.className = 'calendar-day-head is-selectable' + (day.ymd === todayYmd ? ' is-today' : '') + (day.ymd === selectedDayYmd ? ' is-selected-day' : '');
          head.innerHTML = '<div class="day-name">' + day.name + '</div><div class="day-date">' + day.label + '</div>';
          head.title = 'Выбрать день и связать Week с Today/Plan';
          head.addEventListener('click', function () {
            state.dayYmd = day.ymd;
            renderCalendarFrame();
            renderWeekInlineMetrics();
            renderWorkflowDayContext('plannerWorkflowDayContext', 'planner', day.ymd);
          });
          daysHead.appendChild(head);
        });

        var renderWindow = getCalendarRenderWindowHours();
        for (var hour = renderWindow.startHour; hour < renderWindow.endHour; hour += 1) {
          var timeCell = document.createElement('div');
          timeCell.className = 'time-cell';
          timeCell.textContent = String(hour).padStart(2, '0') + ':00';
          timeColumn.appendChild(timeCell);
        }

        grid.addEventListener('mouseleave', function () { hideWeekHoverPreview(); });

        for (var dayIndex = 0; dayIndex < days.length; dayIndex += 1) {
          var dayCol = document.createElement('div');
          dayCol.className = 'calendar-day-column' + (days[dayIndex].ymd === todayYmd ? ' is-today' : '');

          var renderWindow = getCalendarRenderWindowHours();
        for (var hourIndex = 0; hourIndex <= (renderWindow.endHour - renderWindow.startHour); hourIndex += 1) {
            var line = document.createElement('div');
            line.className = 'hour-line';
            line.style.top = 'calc(' + hourIndex + ' * var(--hour-height))';
            dayCol.appendChild(line);
          }

          appendWeekDayBlockOverlays(dayCol, days[dayIndex].ymd);

          for (var slotIndex = 0; slotIndex < slotCount; slotIndex += 1) {
            var slot = document.createElement('div');
            slot.className = 'calendar-drop-slot move-target';
            slot.dataset.dayYmd = days[dayIndex].ymd;
            slot.dataset.time = timeFromSlotIndex(slotIndex);
            slot.style.top = ((slotIndex / slotCount) * 100) + '%';
            slot.style.height = (100 / slotCount) + '%';

            slot.addEventListener('mouseenter', function (event) {
              showWeekHoverPreview(event.currentTarget.dataset.dayYmd, event.currentTarget.dataset.time);
            });

            slot.addEventListener('mousemove', function (event) {
              showWeekHoverPreview(event.currentTarget.dataset.dayYmd, event.currentTarget.dataset.time);
            });

            slot.addEventListener('mouseleave', function () {
              hideWeekHoverPreview();
            });

            slot.addEventListener('dragover', function (event) {
              handleCalendarSlotDragOver(event, 'week');
            });

            slot.addEventListener('dragleave', function (event) {
              handleCalendarSlotDragLeave(event);
            });

            slot.addEventListener('drop', function (event) {
              handleCalendarSlotDrop(event, 'week');
            });

            slot.addEventListener('click', function (event) {
              if (state.moveModeTaskId) {
                event.preventDefault();
                dropTaskToSlot(state.moveModeTaskId, event.currentTarget.dataset.dayYmd, event.currentTarget.dataset.time, { targetView: 'week', ignoreAnchorOffset: true });
                exitMoveMode();
                return;
              }
              openCreateDrawer({ dayYmd: event.currentTarget.dataset.dayYmd, timeString: event.currentTarget.dataset.time });
            });

            dayCol.appendChild(slot);
          }

          grid.appendChild(dayCol);
        }

        syncCalendarHeaderScrollbarCompensation();
        applyViewControlSettings(state.viewControlSettings || getDefaultViewControlSettings());
      }

      async function dropTaskToSlot(taskId, dayYmd, timeString, payload) {
        try {
          var task = findTaskById(taskId);
          var durationMinutes = getPayloadDurationMinutes(payload, task);
          var previewStartMinutes = getAnchoredPreviewStartMinutes(timeString, payload, task, payload && payload.targetView ? payload.targetView : null);
          var dueAtIso = makeDueAtIso(dayYmd, minutesToClockLabel(previewStartMinutes));
          var nextStatus = getScheduleStatusForExistingTask(task);

          if (isRecurringCalendarTask(task)) {
            await scheduleRecurringTaskWithScope(task, dueAtIso, nextStatus, durationMinutes, 'current');
            return;
          }

          await scheduleTask(taskId, dueAtIso, nextStatus, durationMinutes);
        } catch (error) {
          showError(String(error));
        }
      }

      function formatDurationLabel(duration) {
        var safe = Math.max(Number(duration) || DEFAULT_EVENT_DURATION_MIN, 5);
        if (safe >= 60 && safe % 60 === 0) return (safe / 60) + ' ч';
        return safe + ' мин';
      }

      function getInvisibleDragImage() {
        if (state.invisibleDragImage) return state.invisibleDragImage;
        var canvas = document.createElement('canvas');
        canvas.width = 1;
        canvas.height = 1;
        state.invisibleDragImage = canvas;
        return canvas;
      }

      function cleanupDragImageElement() {
        if (!state.dragImageElement) return;
        try {
          if (state.dragImageElement.parentNode) state.dragImageElement.parentNode.removeChild(state.dragImageElement);
        } catch (error) {}
        state.dragImageElement = null;
      }

      function shouldUseLiveCalendarDragPreview(payload) {
        return isCalendarDragPayload(payload);
      }

      function restoreLiveCalendarDragElement() {
        var liveState = state.liveCalendarDragElement;
        if (!liveState || !liveState.element) {
          state.liveCalendarDragElement = null;
          return;
        }
        var element = liveState.element;
        try {
          element.classList.remove('drag-live-preview');
          if (liveState.originalParent) {
            if (liveState.originalNextSibling && liveState.originalNextSibling.parentNode === liveState.originalParent) {
              liveState.originalParent.insertBefore(element, liveState.originalNextSibling);
            } else {
              liveState.originalParent.appendChild(element);
            }
          }
        } catch (error) {}
        state.liveCalendarDragElement = null;
      }

      function mountLiveCalendarDragElement(preview, payload) {
        if (!preview || !payload || !payload.sourceElement) return false;
        var sourceElement = payload.sourceElement;
        var liveState = state.liveCalendarDragElement;
        if (liveState && liveState.element === sourceElement && liveState.preview === preview) {
          preview.classList.add('is-task-card');
          return true;
        }
        restoreLiveCalendarDragElement();
        state.liveCalendarDragElement = {
          element: sourceElement,
          originalParent: sourceElement.parentNode || null,
          originalNextSibling: sourceElement.nextSibling || null,
          preview: preview
        };
        sourceElement.classList.add('drag-live-preview');
        preview.classList.add('is-task-card');
        preview.textContent = '';
        preview.appendChild(sourceElement);
        return true;
      }

      function createUnifiedDragCardElement(task, startTimeString, duration, options) {
        if (!task) return null;
        var settings = options || {};
        var status = normalizeStatus(task.status) || STATUS.NEW;
        var overdue = !!settings.isOverdue || isOverdueTask(task);
        var card = document.createElement('div');
        var className = 'today-event';
        if (settings.compact) className += ' compact';
        if (settings.ultraCompact) className += ' ultra-compact';
        if (settings.narrowCard) className += ' narrow-card';
        if (status === STATUS.DONE) className += ' is-done';
        if (overdue) className += ' is-overdue';
        card.className = className;
        var localFormatTimeRangeByStart = (typeof formatTimeRangeByStart === 'function')
          ? formatTimeRangeByStart
          : function (rawStartTime, rawDurationMinutes) {
              if (!rawStartTime) return '—';
              var match = String(rawStartTime).trim().match(/^(\d{1,2}):(\d{2})$/);
              if (!match) return formatDurationLabel(rawDurationMinutes);
              var startHours = Math.max(0, Math.min(23, Number(match[1]) || 0));
              var startMinutes = Math.max(0, Math.min(59, Number(match[2]) || 0));
              var safeDuration = Math.max(Number(rawDurationMinutes) || DEFAULT_EVENT_DURATION_MIN, 5);
              var totalStart = startHours * 60 + startMinutes;
              var totalEnd = totalStart + safeDuration;
              var endHours = Math.floor(totalEnd / 60) % 24;
              var endMinutes = totalEnd % 60;
              var startLabel = String(startHours).padStart(2, '0') + ':' + String(startMinutes).padStart(2, '0');
              var endLabel = String(endHours).padStart(2, '0') + ':' + String(endMinutes).padStart(2, '0');
              return startLabel + '–' + endLabel;
            };

        var top = document.createElement('div');
        top.className = 'today-event-top';
        var time = document.createElement('div');
        time.className = 'today-event-time';
        time.textContent = startTimeString ? localFormatTimeRangeByStart(startTimeString, duration) : formatDurationLabel(duration);
        top.appendChild(time);
        if (overdue) {
          var warn = document.createElement('span');
          warn.className = 'today-event-overdue-mark';
          warn.textContent = '!';
          top.appendChild(warn);
        }
        top.appendChild(createStatusPill(status, status === STATUS.DONE ? '✓' : getStatusSingular(status)));

        var title = document.createElement('div');
        title.className = 'today-event-title';
        title.textContent = task.title || 'Без названия';

        var project = document.createElement('div');
        project.className = 'today-event-project';
        project.textContent = normalizeProjectName(task.project_name);

        var inline = document.createElement('div');
        inline.className = 'today-event-inline';
        inline.textContent = (startTimeString ? localFormatTimeRangeByStart(startTimeString, duration) : formatDurationLabel(duration)) + ' · ' + (task.title || 'Без названия') + ' · ' + normalizeProjectName(task.project_name);

        card.appendChild(top);
        card.appendChild(inline);
        card.appendChild(title);
        card.appendChild(project);
        return card;
      }

      function getDragPreviewTimeLabel(startTimeString, duration) {
        var localFormatTimeRangeByStart = (typeof formatTimeRangeByStart === 'function')
          ? formatTimeRangeByStart
          : function (rawStartTime, rawDurationMinutes) {
              if (!rawStartTime) return formatDurationLabel(rawDurationMinutes);
              var match = String(rawStartTime).trim().match(/^(\d{1,2}):(\d{2})$/);
              if (!match) return formatDurationLabel(rawDurationMinutes);
              var startHours = Math.max(0, Math.min(23, Number(match[1]) || 0));
              var startMinutes = Math.max(0, Math.min(59, Number(match[2]) || 0));
              var safeDuration = Math.max(Number(rawDurationMinutes) || DEFAULT_EVENT_DURATION_MIN, 5);
              var totalStart = startHours * 60 + startMinutes;
              var totalEnd = totalStart + safeDuration;
              var endHours = Math.floor(totalEnd / 60) % 24;
              var endMinutes = totalEnd % 60;
              return String(startHours).padStart(2, '0') + ':' + String(startMinutes).padStart(2, '0') + '–' + String(endHours).padStart(2, '0') + ':' + String(endMinutes).padStart(2, '0');
            };
        return startTimeString ? localFormatTimeRangeByStart(startTimeString, duration) : formatDurationLabel(duration);
      }

      function createDragVisualCloneFromSourceElement(sourceElement, task, startTimeString, duration) {
        if (!sourceElement || typeof sourceElement.cloneNode !== 'function') return null;
        var clone = sourceElement.cloneNode(true);
        if (!clone) return null;
        try {
          clone.removeAttribute('id');
          clone.setAttribute('draggable', 'false');
          clone.classList.remove('dragging', 'drag-over', 'resizing', 'selected');
          clone.style.pointerEvents = 'none';
          clone.style.transform = '';
          clone.style.transition = 'none';
          clone.style.left = '';
          clone.style.top = '';
          clone.style.right = '';
          clone.style.bottom = '';
          clone.style.position = 'relative';
          clone.style.width = '100%';
          clone.style.height = '100%';
          clone.style.maxWidth = 'none';
          clone.style.maxHeight = 'none';
          clone.style.minHeight = '0';
          clone.style.opacity = '';

          var timeLabel = getDragPreviewTimeLabel(startTimeString, duration);
          Array.prototype.forEach.call(clone.querySelectorAll('.today-event-time, .calendar-event-time'), function (node) {
            node.textContent = timeLabel;
          });
          Array.prototype.forEach.call(clone.querySelectorAll('.today-event-title, .calendar-event-title'), function (node) {
            node.textContent = task && task.title ? task.title : 'Без названия';
          });
          Array.prototype.forEach.call(clone.querySelectorAll('.today-event-project, .calendar-event-project'), function (node) {
            node.textContent = normalizeProjectName(task && task.project_name);
          });
          Array.prototype.forEach.call(clone.querySelectorAll('.today-event-inline, .calendar-event-inline'), function (node) {
            node.textContent = timeLabel + ' · ' + (task && task.title ? task.title : 'Без названия') + ' · ' + normalizeProjectName(task && task.project_name);
          });
        } catch (error) {}
        return clone;
      }

      function buildUnifiedDragImageFromPayload(element, payload, event) {
        if (!element) return null;
        cleanupDragImageElement();
        var rect = element.getBoundingClientRect();
        var task = findTaskById(payload && payload.taskId);
        if (!task) return null;
        var duration = getPayloadDurationMinutes(payload, task);
        var dueAt = payload && payload.dueAt ? payload.dueAt : task.due_at;
        var startTimeString = '';
        if (dueAt) {
          try {
            var dueDate = new Date(dueAt);
            if (!Number.isNaN(dueDate.getTime())) startTimeString = String(dueDate.getHours()).padStart(2, '0') + ':' + String(dueDate.getMinutes()).padStart(2, '0');
          } catch (error) {}
        }
        var visual = getSharedDragPreviewVisualState(duration, rect.width);
        var clone = createDragVisualCloneFromSourceElement(element, task, startTimeString, duration) || createUnifiedDragCardElement(task, startTimeString, duration, visual);
        if (!clone) return null;
        clone.classList.add('drag-image-clone');
        clone.style.width = Math.max(rect.width, 120) + 'px';
        clone.style.height = Math.max(rect.height, 36) + 'px';
        clone.style.opacity = '0.98';
        document.body.appendChild(clone);
        state.dragImageElement = clone;
        var offsetX = event && Number.isFinite(event.clientX) ? Math.max(0, Math.min(rect.width - 8, event.clientX - rect.left)) : 18;
        var offsetY = event && Number.isFinite(event.clientY) ? Math.max(0, Math.min(rect.height - 8, event.clientY - rect.top)) : 18;
        return { node: clone, offsetX: offsetX, offsetY: offsetY };
      }

      function getPayloadDurationMinutes(payload, task) {
        var payloadDuration = Number(payload && payload.durationMinutes);
        if (payloadDuration > 0) return payloadDuration;
        return getTaskDurationMinutes(task);
      }

      function clearDragPreviewContent(preview) {
        if (!preview) return;
        var liveState = state.liveCalendarDragElement;
        if (liveState && liveState.preview === preview) {
          restoreLiveCalendarDragElement();
        }
        preview.textContent = '';
        preview.classList.remove('priority-high', 'priority-medium', 'priority-low', 'is-overdue', 'compact', 'ultra-compact', 'title-only', 'is-task-card');
      }

      function fillDragPreviewContent(preview, task, startTimeString, duration, options, payload) {
        if (!preview || !task) return;
        if (shouldUseLiveCalendarDragPreview(payload) && mountLiveCalendarDragElement(preview, payload)) {
          return;
        }
        clearDragPreviewContent(preview);
        var settings = options || {};
        var sourceElement = payload && payload.sourceElement ? payload.sourceElement : null;
        var visualCard = createDragVisualCloneFromSourceElement(sourceElement, task, startTimeString, duration) || createUnifiedDragCardElement(task, startTimeString, duration, settings);
        if (!visualCard) return;
        preview.classList.add('is-task-card');
        preview.appendChild(visualCard);
      }

      function getHourHeightPx() {
        var raw = getComputedStyle(document.documentElement).getPropertyValue('--hour-height') || '64';
        var parsed = parseFloat(String(raw).replace('px', '').trim());
        return Number.isFinite(parsed) ? parsed : 64;
      }

      function applyResizePreview(resizeState) {
        if (!resizeState || !resizeState.cardEl) return;
        var renderWindow = getCalendarRenderWindowHours();
        var totalMinutes = (renderWindow.endHour - renderWindow.startHour) * 60;
        var heightPercent = Math.max((resizeState.currentDuration / totalMinutes) * 100, 3);
        resizeState.cardEl.style.height = 'calc(' + heightPercent + '% - 6px)';
        var minimumCardHeightPx = resizeState && resizeState.calendarView === 'day'
          ? getTodayCalendarMinimumCardHeightPx(resizeState.currentDuration)
          : 0;
        resizeState.cardEl.style.minHeight = minimumCardHeightPx > 0 ? (minimumCardHeightPx + 'px') : '';
        resizeState.cardEl.classList.toggle('is-short-task', minimumCardHeightPx > 0);
        var pxHeight = Math.max((resizeState.currentDuration / 60) * getHourHeightPx(), minimumCardHeightPx || 0);
        resizeState.cardEl.classList.toggle('compact', pxHeight < 84 && pxHeight >= 58);
        resizeState.cardEl.classList.toggle('ultra-compact', pxHeight < 58);
        if (resizeState.timeEl) resizeState.timeEl.textContent = resizeState.baseTimeText + ' · ' + formatDurationLabel(resizeState.currentDuration);
      }

      function startResize(event, task, card, timeEl) {
        hideTaskHoverCard();
        event.preventDefault();
        event.stopPropagation();
        suppressClicks(700);

        card.setAttribute('draggable', 'false');
        var initialDuration = Math.max(snapDurationToStep(task.duration_minutes || DEFAULT_EVENT_DURATION_MIN), getDurationStepMinutes());
        state.resizeState = {
          pointerId: event.pointerId,
          taskId: task.id,
          dueAt: task.due_at,
          status: normalizeStatus(task.status) || STATUS.PLANNED,
          calendarView: card && card.classList && card.classList.contains('calendar-event') ? 'week' : 'day',
          startY: event.clientY,
          startDuration: initialDuration,
          currentDuration: initialDuration,
          cardEl: card,
          timeEl: timeEl,
          baseTimeText: formatWithPlannerTimeZone(new Date(task.due_at), { hour: '2-digit', minute: '2-digit', hour12: false }, '—'),
          source: card.classList.contains('today-event') ? 'today' : 'planner'
        };

        card.classList.add('resizing');
        if (event.target && event.target.setPointerCapture) {
          try { event.target.setPointerCapture(event.pointerId); } catch (e) {}
        }
      }

      function updateResize(event) {
        var rs = state.resizeState;
        if (!rs || event.pointerId !== rs.pointerId) return;

        event.preventDefault();
        var deltaY = event.clientY - rs.startY;
        var pixelsPerMinute = getHourHeightPx() / 60;
        var deltaMinutes = deltaY / pixelsPerMinute;
        var resizeStep = getDurationStepMinutes();
        var snappedSteps = Math.round(deltaMinutes / resizeStep);
        var nextDuration = rs.startDuration + snappedSteps * resizeStep;
        nextDuration = Math.max(resizeStep, Math.min(720, nextDuration));

        if (nextDuration === rs.currentDuration) return;
        rs.currentDuration = nextDuration;
        applyResizePreview(rs);
      }

      function finishResize(event) {
        var rs = state.resizeState;
        suppressClicks(1200);
        if (!rs || (event && event.pointerId !== undefined && event.pointerId !== rs.pointerId)) return;

        state.resizeState = null;
        if (rs.cardEl) {
          rs.cardEl.classList.remove('resizing');
          var shouldStayManualDrag = !!(rs.cardEl.classList && (rs.cardEl.classList.contains('today-event') || rs.cardEl.classList.contains('calendar-event')));
          rs.cardEl.setAttribute('draggable', shouldStayManualDrag ? 'false' : (isTouchLikeDevice() ? 'false' : 'true'));
        }

        if (rs.currentDuration !== rs.startDuration) {
          var resizeTask = findTaskById(rs.taskId);
          scheduleTask(rs.taskId, rs.dueAt, getScheduleStatusForExistingTask(resizeTask), rs.currentDuration);
        } else {
          applyResizePreview(rs);
        }
      }

      function cancelResize(event) {
        var rs = state.resizeState;
        suppressClicks(700);
        if (!rs || (event && event.pointerId !== undefined && event.pointerId !== rs.pointerId)) return;
        state.resizeState = null;
        if (rs.cardEl) {
          rs.cardEl.classList.remove('resizing');
          var shouldStayManualDrag = !!(rs.cardEl.classList && (rs.cardEl.classList.contains('today-event') || rs.cardEl.classList.contains('calendar-event')));
          rs.cardEl.setAttribute('draggable', shouldStayManualDrag ? 'false' : (isTouchLikeDevice() ? 'false' : 'true'));
        }
        rs.currentDuration = rs.startDuration;
        applyResizePreview(rs);
      }

      function buildDayOverlapLayout(dayTasks) {
        var items = (dayTasks || []).map(function (task) {
          var start = new Date(task.due_at);
          var end = getTaskEndDate(task);
          return {
            task: task,
            startMs: start.getTime(),
            endMs: end ? end.getTime() : start.getTime() + getTaskDurationMinutes(task) * 60000,
            col: 0,
            cols: 1
          };
        }).sort(function (a, b) {
          if (a.startMs !== b.startMs) return a.startMs - b.startMs;
          return a.endMs - b.endMs;
        });

        var active = [];
        var cluster = [];
        var clusterMax = 1;
        var result = [];

        function finalizeCluster() {
          if (!cluster.length) return;
          cluster.forEach(function (item) { item.cols = Math.max(clusterMax, 1); result.push(item); });
          cluster = [];
          clusterMax = 1;
        }

        items.forEach(function (item) {
          active = active.filter(function (activeItem) { return activeItem.endMs > item.startMs; });
          if (!active.length) finalizeCluster();

          var used = {};
          active.forEach(function (activeItem) { used[activeItem.col] = true; });
          var col = 0;
          while (used[col]) col += 1;
          item.col = col;
          active.push(item);
          cluster.push(item);
          clusterMax = Math.max(clusterMax, active.length);
        });

        finalizeCluster();
        return result;
      }

