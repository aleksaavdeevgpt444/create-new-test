// STAGE 337 — Recurrence Duplication Audit helpers
// Read-only. Must not write to D1.
// ============================================================

/**
 * Build a normalized dedup key for a recurrence occurrence.
 * Primary key uses series_id + index when both are present.
 * Falls back to series_id + date + normalised title + space_key.
 */
function buildRecurrenceDuplicateGroupKey_(task) {
  if (!task) return null;
  const seriesId = String(task.recurrence_series_id || task.recurrence_parent_task_id || '').trim();
  if (!seriesId) return null;

  const recurrenceIndex = task.recurrence_index != null ? String(task.recurrence_index) : null;
  const normalizedTitle = String(task.title || '').trim().toLowerCase().replace(/\s+/g, ' ');
  const spaceKey = String(task.space_key || 'work').trim().toLowerCase();

  // Primary: series_id + index (most reliable)
  if (recurrenceIndex !== null && recurrenceIndex !== '' && recurrenceIndex !== '0') {
    return `series:${seriesId}|idx:${recurrenceIndex}`;
  }

  // Fallback: series_id + due_at date part + time part + title + space
  const dueAt = String(task.due_at || '').trim();
  const dueDatePart = dueAt ? dueAt.slice(0, 10) : 'nodate';
  const dueTimePart = dueAt && dueAt.length > 10 ? dueAt.slice(11, 16) : 'notime';
  return `series:${seriesId}|date:${dueDatePart}|time:${dueTimePart}|title:${normalizedTitle}|space:${spaceKey}`;
}

/**
 * Choose which task to keep when deduplicating a group.
 * Priority: done > has actual_minutes > has description > has task_product > newest updated_at.
 */
function chooseRecurrenceDuplicateKeepCandidate_(tasks) {
  if (!Array.isArray(tasks) || tasks.length === 0) return null;
  if (tasks.length === 1) return tasks[0];

  return tasks.slice().sort(function (a, b) {
    // done tasks first
    const aDone = (String(a.status || '') === 'done') ? 1 : 0;
    const bDone = (String(b.status || '') === 'done') ? 1 : 0;
    if (bDone !== aDone) return bDone - aDone;
    // has actual_minutes
    const aActual = (Number(a.actual_minutes) > 0) ? 1 : 0;
    const bActual = (Number(b.actual_minutes) > 0) ? 1 : 0;
    if (bActual !== aActual) return bActual - aActual;
    // has description
    const aDesc = (a.description && String(a.description).trim().length > 0) ? 1 : 0;
    const bDesc = (b.description && String(b.description).trim().length > 0) ? 1 : 0;
    if (bDesc !== aDesc) return bDesc - aDesc;
    // has task_product
    const aProd = (a.task_product && String(a.task_product).trim().length > 0) ? 1 : 0;
    const bProd = (b.task_product && String(b.task_product).trim().length > 0) ? 1 : 0;
    if (bProd !== aProd) return bProd - aProd;
    // newest updated_at
    const aUp = String(a.updated_at || a.created_at || '');
    const bUp = String(b.updated_at || b.created_at || '');
    if (bUp > aUp) return 1;
    if (bUp < aUp) return -1;
    return 0;
  })[0];
}

/**
 * Find all duplicate recurrence occurrence groups for a user.
 * Read-only — does not write anything to D1.
 * Returns an array of group objects describing duplicates found.
 */
async function findRecurrenceDuplicateGroups_(env, userId, options) {
  const normalizedUserId = String(userId || '').trim();
  if (!normalizedUserId) return [];

  const opts = options || {};
  const limit = Math.min(Number(opts.limit) || 2000, 5000);

  // Fetch all tasks that belong to any recurrence series for this user
  const result = await env.DB.prepare(`
    SELECT ${TASK_SELECT_FIELDS}
    FROM tasks
    WHERE user_id = ?
      AND (
        recurrence_series_id IS NOT NULL
        OR recurrence_parent_task_id IS NOT NULL
        OR (recurrence_enabled = 1 AND recurrence_type IS NOT NULL)
      )
    ORDER BY recurrence_series_id ASC, recurrence_index ASC, due_at ASC
    LIMIT ?
  `).bind(normalizedUserId, limit).all();

  const tasks = result.results || [];
  if (tasks.length === 0) return [];

  // Group tasks by dedup key
  const groupsByKey = {};
  for (const task of tasks) {
    const key = buildRecurrenceDuplicateGroupKey_(task);
    if (!key) continue;
    if (!groupsByKey[key]) groupsByKey[key] = [];
    groupsByKey[key].push(task);
  }

  // Collect groups with more than 1 task (actual duplicates)
  const duplicateGroups = [];
  for (const [key, groupTasks] of Object.entries(groupsByKey)) {
    if (groupTasks.length < 2) continue;
    const keepTask = chooseRecurrenceDuplicateKeepCandidate_(groupTasks);
    const duplicateTasks = groupTasks.filter(function (t) { return t.id !== (keepTask && keepTask.id); });
    const representative = groupTasks[0];
    // Stage339: response fields aligned to contract spec:
    // key / series_id / title / due_at / space_key / task_ids /
    // recommended_keep_id / recommended_duplicate_ids / reason
    const seriesId = representative.recurrence_series_id || representative.recurrence_parent_task_id || null;
    duplicateGroups.push({
      // contract fields
      key,
      series_id: seriesId,
      title: representative.title || null,
      due_at: representative.due_at || null,
      space_key: representative.space_key || null,
      task_ids: groupTasks.map(function (t) { return t.id; }),
      recommended_keep_id: keepTask ? keepTask.id : null,
      recommended_duplicate_ids: duplicateTasks.map(function (t) { return t.id; }),
      reason: 'same recurrence series/index or same series/date/title/space',
      // extra diagnostic fields (not in minimal spec but useful for investigation)
      group_key: key,
      recurrence_series_id: representative.recurrence_series_id || null,
      recurrence_parent_task_id: representative.recurrence_parent_task_id || null,
      recurrence_index: representative.recurrence_index != null ? representative.recurrence_index : null,
      count: groupTasks.length,
      tasks_summary: groupTasks.map(function (t) {
        return {
          id: t.id,
          status: t.status || null,
          due_at: t.due_at || null,
          recurrence_index: t.recurrence_index != null ? t.recurrence_index : null,
          recurrence_series_id: t.recurrence_series_id || null,
          actual_minutes: t.actual_minutes || null,
          has_description: !!(t.description && String(t.description).trim().length > 0),
          has_task_product: !!(t.task_product && String(t.task_product).trim().length > 0),
          updated_at: t.updated_at || null,
          created_at: t.created_at || null
        };
      })
    });
  }

  return duplicateGroups;
}

