      async function scheduleTask(taskId, dueAtIso, nextStatus, durationMinutes) {
        if (!state.userId) {
          showError('Сначала укажи user_id.');
          return;
        }

        var currentTask = findTaskById(taskId);
        var protectionSettings = state.focusProtectionSettings || getDefaultFocusProtectionSettings();
        if (currentTask && currentTask.id && isTaskFocusProtected(currentTask.id) && protectionSettings.enabled && protectionSettings.requireConfirmBeforeMove) {
          var currentDue = currentTask.due_at || null;
          var nextDue = dueAtIso || null;
          var currentDuration = Number(getTaskDurationMinutes(currentTask)) || 0;
          var nextDuration = durationMinutes !== undefined && durationMinutes !== null && durationMinutes !== '' ? Number(durationMinutes) || currentDuration : currentDuration;
          var isChangingSlot = currentDue !== nextDue || currentDuration !== nextDuration || nextStatus === STATUS.POSTPONED;
          if (isChangingSlot) {
            var allowProtectedMove = window.confirm('Этот слот помечен как защищённый фокус-блок. Перенести или снять его из плана?');
            if (!allowProtectedMove) return;
          }
        }

        state.requestState = 'планирование';
        updateDebugInfo();
        showError('');

        var recurringCurrentOnly = isRecurringEditorTask(currentTask);
        var optimistic = buildOptimisticScheduledTask(taskId, dueAtIso, nextStatus, durationMinutes, { detachSeries: recurringCurrentOnly });

        try {
          if (optimistic && optimistic.next) {
            applyTaskLocally(optimistic.next);
          }

          var body = { task_id: taskId, user_id: state.userId, due_at: dueAtIso };
          if (recurringCurrentOnly) body.recurrence_scope = 'current_only';
          if (nextStatus) body.status = nextStatus;
          if (durationMinutes !== undefined && durationMinutes !== null && durationMinutes !== '') {
            body.duration_minutes = Number(durationMinutes);
          }

          var response = await requestJsonWithWriteResilience('/tasks/schedule', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(body),
            __meta: { requestName: 'task-schedule', retryCount: 1, retryDelayMs: 260 }
          });

          if (response && response.item) {
            applyTaskLocally(response.item);
          }
          schedulePlannerReload(120);
          state.requestState = 'idle';
          updateDebugInfo();
        } catch (error) {
          if (optimistic && optimistic.previous) {
            applyTaskLocally(optimistic.previous);
          }
          state.requestState = 'error';
          updateDebugInfo();
          showError(String(error));
        }
      }

      async function updateTaskMeta(taskId, payload) {
        return requestJsonWithWriteResilience('/tasks/update', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(Object.assign({ task_id: taskId, user_id: state.userId }, payload || {})),
          __meta: { requestName: 'task-update-meta', retryCount: 1, retryDelayMs: 260 }
        });
      }


      function shouldRescheduleEditorTask(currentTask, nextStatus, dateValue, timeValue, durationValue) {
        if (normalizeStatus(nextStatus) !== STATUS.PLANNED) return false;
        if (!(dateValue && timeValue)) return false;
        var nextDueAtIso = makeDueAtIso(dateValue, timeValue);
        var currentStatus = normalizeStatus(currentTask && currentTask.status);
        var currentDueAtIso = currentTask && currentTask.due_at ? String(currentTask.due_at) : null;
        var currentDuration = Number(currentTask && currentTask.duration_minutes) || DEFAULT_EVENT_DURATION_MIN;
        var nextDuration = Number(durationValue) || DEFAULT_EVENT_DURATION_MIN;
