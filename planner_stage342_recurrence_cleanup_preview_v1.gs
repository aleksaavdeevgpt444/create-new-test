      var STRATEGIC_METHOD_REGISTRY = [
        { id: 'impact_effort', title: 'Impact / Effort', shortLabel: 'Impact / Effort' },
        { id: 'rice_ice', title: 'RICE / ICE', shortLabel: 'RICE / ICE' },
        { id: 'moscow', title: 'MoSCoW', shortLabel: 'MoSCoW' },
        { id: 'rolling_wave', title: 'Rolling Wave', shortLabel: 'Rolling Wave' },
        { id: 'toc', title: 'Theory of Constraints', shortLabel: 'ToC' },
        { id: 'critical_path', title: 'Critical Path', shortLabel: 'Critical Path' },
        { id: 'okr', title: 'OKR / Goal-based planning', shortLabel: 'OKR' },
        { id: 'twelve_week_year', title: '12 Week Year', shortLabel: '12 Week Year' },
        { id: 'quadrant_2', title: 'Quadrant 2 Planning', shortLabel: 'Quadrant 2' }
      ];

      function getStrategicMethodMeta(value) {
        var key = String(value || '').trim().toLowerCase();
        return STRATEGIC_METHOD_REGISTRY.find(function (item) { return item.id === key; }) || null;
      }

      function getDefaultStrategicLayerSettings() {
        return {
          enabled: true,
          showProjectsSummary: true,
          showGanttSummary: true,
          showPlanLayer: true,
          methods: {
            impactEffort: true,
            riceIce: true,
            moscow: true,
            rollingWave: true,
            toc: true,
            criticalPath: true,
            okr: true,
            twelveWeekYear: true,
            quadrant2: true
          },
          defaults: {
            projectMethod: 'impact_effort',
            cycleMethod: 'okr'
          }
        };
      }

      function normalizeStrategicLayerSettings(value) {
        var source = value && typeof value === 'object' ? value : {};
        var defaults = getDefaultStrategicLayerSettings();
        return {
          enabled: source.enabled !== undefined ? !!source.enabled : defaults.enabled,
          showProjectsSummary: source.showProjectsSummary !== undefined ? !!source.showProjectsSummary : defaults.showProjectsSummary,
          showGanttSummary: source.showGanttSummary !== undefined ? !!source.showGanttSummary : defaults.showGanttSummary,
          showPlanLayer: source.showPlanLayer !== undefined ? !!source.showPlanLayer : defaults.showPlanLayer,
          methods: {
            impactEffort: source.methods && source.methods.impactEffort !== undefined ? !!source.methods.impactEffort : defaults.methods.impactEffort,
            riceIce: source.methods && source.methods.riceIce !== undefined ? !!source.methods.riceIce : defaults.methods.riceIce,
            moscow: source.methods && source.methods.moscow !== undefined ? !!source.methods.moscow : defaults.methods.moscow,
            rollingWave: source.methods && source.methods.rollingWave !== undefined ? !!source.methods.rollingWave : defaults.methods.rollingWave,
            toc: source.methods && source.methods.toc !== undefined ? !!source.methods.toc : defaults.methods.toc,
            criticalPath: source.methods && source.methods.criticalPath !== undefined ? !!source.methods.criticalPath : defaults.methods.criticalPath,
            okr: source.methods && source.methods.okr !== undefined ? !!source.methods.okr : defaults.methods.okr,
            twelveWeekYear: source.methods && source.methods.twelveWeekYear !== undefined ? !!source.methods.twelveWeekYear : defaults.methods.twelveWeekYear,
            quadrant2: source.methods && source.methods.quadrant2 !== undefined ? !!source.methods.quadrant2 : defaults.methods.quadrant2
          },
          defaults: {
            projectMethod: getStrategicMethodMeta(source.defaults && source.defaults.projectMethod) ? String(source.defaults.projectMethod).trim().toLowerCase() : defaults.defaults.projectMethod,
            cycleMethod: getStrategicMethodMeta(source.defaults && source.defaults.cycleMethod) ? String(source.defaults.cycleMethod).trim().toLowerCase() : defaults.defaults.cycleMethod
          }
        };
      }

      function loadStoredStrategicLayerSettings() {
        try {
          var raw = localStorage.getItem(STRATEGIC_LAYER_SETTINGS_STORAGE_KEY);
          if (!raw) return getDefaultStrategicLayerSettings();
          return normalizeStrategicLayerSettings(JSON.parse(raw));
        } catch (error) {
          return getDefaultStrategicLayerSettings();
        }
      }

      function saveStoredStrategicLayerSettings() {
        try {
          localStorage.setItem(STRATEGIC_LAYER_SETTINGS_STORAGE_KEY, JSON.stringify(normalizeStrategicLayerSettings(state.strategicLayerSettings || getDefaultStrategicLayerSettings())));
        } catch (error) {}
      }

      function getStrategicMethodSelectOptionsHtml(allowEmptyLabel) {
        var options = ['<option value="">' + escapeHtml(String(allowEmptyLabel || 'Не выбрано')) + '</option>'];
        STRATEGIC_METHOD_REGISTRY.forEach(function (item) {
          options.push('<option value="' + escapeHtml(item.id) + '">' + escapeHtml(item.title) + '</option>');
        });
        return options.join('');
      }

      function syncStrategicLayerSettingsInputs() {
        var settings = normalizeStrategicLayerSettings(state.strategicLayerSettings || getDefaultStrategicLayerSettings());
        state.strategicLayerSettings = settings;
        [
          ['strategicLayerEnabledInput', settings.enabled],
          ['strategicProjectsSummaryInput', settings.showProjectsSummary],
          ['strategicGanttSummaryInput', settings.showGanttSummary],
          ['strategicPlanLayerInput', settings.showPlanLayer],
          ['strategicImpactEffortInput', settings.methods.impactEffort],
          ['strategicRiceIceInput', settings.methods.riceIce],
          ['strategicMoscowInput', settings.methods.moscow],
          ['strategicRollingWaveInput', settings.methods.rollingWave],
          ['strategicTocInput', settings.methods.toc],
          ['strategicCriticalPathInput', settings.methods.criticalPath],
          ['strategicOkrInput', settings.methods.okr],
          ['strategicTwelveWeekInput', settings.methods.twelveWeekYear],
          ['strategicQuadrant2Input', settings.methods.quadrant2]
        ].forEach(function (pair) {
          var node = byId(pair[0]);
          if (node) node.checked = !!pair[1];
        });
        var projectSelect = byId('strategicDefaultProjectMethodSelect');
        if (projectSelect) {
          projectSelect.innerHTML = getStrategicMethodSelectOptionsHtml('Не выбрано');
          projectSelect.value = settings.defaults.projectMethod || '';
        }
        var cycleSelect = byId('strategicDefaultCycleMethodSelect');
        if (cycleSelect) {
          cycleSelect.innerHTML = getStrategicMethodSelectOptionsHtml('Не выбрано');
          cycleSelect.value = settings.defaults.cycleMethod || '';
        }
      }

      function applyStrategicLayerSettings(settings, options) {
        state.strategicLayerSettings = normalizeStrategicLayerSettings(settings || getDefaultStrategicLayerSettings());
        saveStoredStrategicLayerSettings();
        syncStrategicLayerSettingsInputs();
        if (!(options && options.silent)) {
          if (state.currentView === 'projects') renderProjectsView();
          if (state.currentView === 'gantt') renderGanttView();
          if (state.currentView === 'plan') renderPlanView();
          showSuccess('Настройки project / strategic layer обновлены.');
        }
      }

      function updateStrategicLayerSetting(path, value) {
        var next = normalizeStrategicLayerSettings(state.strategicLayerSettings || getDefaultStrategicLayerSettings());
        if (path === 'enabled') next.enabled = !!value;
        else if (path === 'showProjectsSummary') next.showProjectsSummary = !!value;
        else if (path === 'showGanttSummary') next.showGanttSummary = !!value;
        else if (path === 'showPlanLayer') next.showPlanLayer = !!value;
        else if (path.indexOf('methods.') === 0) {
          var key = path.split('.')[1] || '';
          if (next.methods[key] !== undefined) next.methods[key] = !!value;
        } else if (path === 'defaults.projectMethod') {
          next.defaults.projectMethod = getStrategicMethodMeta(value) ? String(value).trim().toLowerCase() : '';
        } else if (path === 'defaults.cycleMethod') {
          next.defaults.cycleMethod = getStrategicMethodMeta(value) ? String(value).trim().toLowerCase() : '';
        }
        applyStrategicLayerSettings(next);
      }

      function normalizeProjectStrategyProfile(value) {
        var source = value && typeof value === 'object' ? value : {};
        function clamp5(raw) {
          var number = Number(raw);
          if (!Number.isFinite(number)) return 0;
          return Math.max(0, Math.min(5, Math.round(number)));
        }
        var primaryMethod = String(source.primaryMethod || source.primary_method || '').trim().toLowerCase();
        if (!getStrategicMethodMeta(primaryMethod)) primaryMethod = '';
        var rollingWave = String(source.rollingWave || source.rolling_wave || '').trim().toLowerCase();
        if (['now', 'next', 'later'].indexOf(rollingWave) === -1) rollingWave = '';
        var moscow = String(source.moscow || '').trim().toLowerCase();
        if (['must', 'should', 'could', 'wont'].indexOf(moscow) === -1) moscow = '';
        return {
          primaryMethod: primaryMethod,
          impact: clamp5(source.impact),
          effort: clamp5(source.effort),
          reach: clamp5(source.reach),
          confidence: clamp5(source.confidence),
          moscow: moscow,
          rollingWave: rollingWave,
          objective: String(source.objective || '').trim().slice(0, 260),
          keyResultTitle: String(source.keyResultTitle || source.key_result_title || '').trim().slice(0, 220),
          keyResultCurrent: Math.max(0, Number(source.keyResultCurrent || source.key_result_current) || 0),
          keyResultTarget: Math.max(0, Number(source.keyResultTarget || source.key_result_target) || 0),
          bottleneckNote: String(source.bottleneckNote || source.bottleneck_note || '').trim().slice(0, 240),
          cycleGoal: String(source.cycleGoal || source.cycle_goal || '').trim().slice(0, 240),
          quadrant2Focus: !!(source.quadrant2Focus || source.quadrant2_focus),
          updatedAt: String(source.updatedAt || source.updated_at || '')
        };
      }

      function loadStoredProjectStrategyProfiles() {
        try {
          var raw = localStorage.getItem(PROJECT_STRATEGY_PROFILES_STORAGE_KEY);
          if (!raw) return Object.create(null);
          var parsed = JSON.parse(raw);
          if (!parsed || typeof parsed !== 'object') return Object.create(null);
          var map = Object.create(null);
          Object.keys(parsed).forEach(function (key) {
            map[normalizeProjectName(key)] = normalizeProjectStrategyProfile(parsed[key]);
          });
          return map;
        } catch (error) {
          return Object.create(null);
        }
      }

      function saveStoredProjectStrategyProfiles() {
        try {
          var payload = Object.create(null);
          Object.keys(state.projectStrategyProfiles || {}).forEach(function (key) {
            payload[key] = normalizeProjectStrategyProfile(state.projectStrategyProfiles[key]);
          });
          localStorage.setItem(PROJECT_STRATEGY_PROFILES_STORAGE_KEY, JSON.stringify(payload));
        } catch (error) {}
      }

      function getProjectStrategyProfile(projectName) {
        var key = normalizeProjectName(projectName);
        if (!key || key === 'Без проекта') return normalizeProjectStrategyProfile({});
        return normalizeProjectStrategyProfile(state.projectStrategyProfiles && state.projectStrategyProfiles[key] ? state.projectStrategyProfiles[key] : {});
      }

      function setProjectStrategyProfile(projectName, value) {
        var key = normalizeProjectName(projectName);
        if (!key || key === 'Без проекта') return;
        var normalized = normalizeProjectStrategyProfile(Object.assign({}, value || {}, { updatedAt: new Date().toISOString() }));
        var hasValue = !!(normalized.primaryMethod || normalized.impact || normalized.effort || normalized.reach || normalized.confidence || normalized.moscow || normalized.rollingWave || normalized.objective || normalized.keyResultTitle || normalized.keyResultCurrent || normalized.keyResultTarget || normalized.bottleneckNote || normalized.cycleGoal || normalized.quadrant2Focus);
        if (!state.projectStrategyProfiles || typeof state.projectStrategyProfiles !== 'object') state.projectStrategyProfiles = Object.create(null);
        if (!hasValue) delete state.projectStrategyProfiles[key];
        else state.projectStrategyProfiles[key] = normalized;
        saveStoredProjectStrategyProfiles();
      }

      function getImpactEffortQuadrant(profile) {
        var impact = Number(profile && profile.impact) || 0;
        var effort = Number(profile && profile.effort) || 0;
        if (!(impact && effort)) return '';
        if (impact >= 4 && effort <= 2) return 'Быстрая победа';
        if (impact >= 4 && effort >= 3) return 'Стратегическая ставка';
        if (impact <= 2 && effort <= 2) return 'Лёгкое дополнение';
        return 'Низкий приоритет';
      }

      function getRiceScore(profile) {
        var reach = Number(profile && profile.reach) || 0;
        var impact = Number(profile && profile.impact) || 0;
        var confidence = Number(profile && profile.confidence) || 0;
        var effort = Number(profile && profile.effort) || 0;
        if (!(reach && impact && confidence && effort)) return 0;
        return (reach * impact * confidence) / Math.max(effort, 1);
      }

      function getProjectStrategyReadiness(profile) {
        var normalized = normalizeProjectStrategyProfile(profile || {});
        var checks = [
          { key: 'primaryMethod', title: 'Primary method', done: !!normalized.primaryMethod, hint: 'Выбери главный strategic engine проекта.', action: 'Выбрать Primary method.' },
          { key: 'impactEffort', title: 'Impact / Effort', done: !!(normalized.impact && normalized.effort), hint: 'Оцени эффект и усилия от 1 до 5.', action: 'Заполнить Impact и Effort.' },
          { key: 'rice', title: 'RICE / ICE', done: !!(normalized.reach && normalized.impact && normalized.confidence && normalized.effort), hint: 'Добавь Reach и Confidence, чтобы появился score.', action: 'Заполнить Reach и Confidence.' },
          { key: 'okr', title: 'OKR / Key Result', done: !!(normalized.objective && normalized.keyResultTitle && normalized.keyResultTarget > 0), hint: 'Опиши Objective, KR и целевое значение.', action: 'Заполнить Objective, Key Result и KR target.' },
          { key: 'wave', title: 'Rolling Wave', done: !!normalized.rollingWave, hint: 'Определи горизонт: Now / Next / Later.', action: 'Выбрать Rolling Wave.' },
          { key: 'moscow', title: 'MoSCoW', done: !!normalized.moscow, hint: 'Отметь Must / Should / Could / Won’t.', action: 'Выбрать MoSCoW.' },
          { key: 'constraint', title: 'Constraint', done: !!normalized.bottleneckNote, hint: 'Запиши узкое место или ограничение проекта.', action: 'Заполнить Bottleneck / constraint.' },
          { key: 'cycleGoal', title: '12 Week goal', done: !!normalized.cycleGoal, hint: 'Сформулируй цель текущего 12-недельного цикла.', action: 'Заполнить 12 Week goal.' },
          { key: 'quadrant2', title: 'Quadrant 2', done: !!normalized.quadrant2Focus, hint: 'Отметь, если проект важный, но его легко вытесняет срочное.', action: 'Отметить Quadrant 2 focus, если это стратегическая инвестиция.' }
        ];
        var doneCount = checks.filter(function (item) { return !!item.done; }).length;
        var total = checks.length || 1;
        var score = Math.round((doneCount / total) * 100);
        var nextCheck = checks.filter(function (item) { return !item.done; })[0] || null;
        return {
          profile: normalized,
          checks: checks,
          doneCount: doneCount,
          total: total,
          score: score,
          nextCheck: nextCheck,
          label: getProjectStrategyReadinessLabel(score)
        };
      }

      function getProjectStrategyReadinessLabel(score) {
        var number = Number(score) || 0;
        if (number >= 80) return 'сильный профиль';
        if (number >= 55) return 'рабочая основа';
        if (number >= 25) return 'черновик профиля';
        return 'профиль почти пуст';
      }

      function getProjectStrategyReadinessNextStep(readiness) {
        var data = readiness || getProjectStrategyReadiness({});
        if (data.nextCheck) return data.nextCheck.action || data.nextCheck.hint || 'Дозаполнить strategic profile.';
        return 'Профиль готов: теперь проверь стратегические действия в dashboard и недельном плане.';
      }

      function createProjectStrategyReadinessElement(projectName, profile, options) {
        try {
          var readiness = getProjectStrategyReadiness(profile || {});
          var compact = !!(options && options.compact);
          var box = document.createElement('div');
          box.className = compact ? 'project-card-note' : 'framework-knowledge-meta';
          var title = document.createElement('div');
          title.className = compact ? 'project-card-note-title' : 'framework-knowledge-title-row';
          if (compact) {
            title.textContent = 'Strategic profile readiness · ' + readiness.score + '%';
          } else {
            title.innerHTML = '<h4>Strategic profile readiness</h4><span class="framework-knowledge-badge status-partial">' + readiness.score + '%</span>';
          }
          box.appendChild(title);
          var body = document.createElement('div');
          body.className = compact ? 'project-card-note-body' : 'framework-knowledge-text';
          body.textContent = readiness.doneCount + '/' + readiness.total + ' · ' + readiness.label + '. Следующий шаг: ' + getProjectStrategyReadinessNextStep(readiness);
          box.appendChild(body);
          var chips = document.createElement('div');
          chips.className = 'shell-task-meta';
          readiness.checks.forEach(function (item) {
            chips.appendChild(createChip((item.done ? '✓ ' : '○ ') + item.title));
          });
          box.appendChild(chips);
          return box;
        } catch (error) {
          return null;
        }
      }

      function getProjectDialogDraftStrategyProfile() {
        var dialog = state.projectDialog || {};
        return normalizeProjectStrategyProfile({
          primaryMethod: dialog.primaryMethodSelect ? String(dialog.primaryMethodSelect.value || '').trim().toLowerCase() : '',
          impact: dialog.impactSelect ? Number(dialog.impactSelect.value || 0) : 0,
          effort: dialog.effortSelect ? Number(dialog.effortSelect.value || 0) : 0,
          reach: dialog.reachSelect ? Number(dialog.reachSelect.value || 0) : 0,
          confidence: dialog.confidenceSelect ? Number(dialog.confidenceSelect.value || 0) : 0,
          moscow: dialog.moscowSelect ? String(dialog.moscowSelect.value || '').trim().toLowerCase() : '',
          rollingWave: dialog.rollingWaveSelect ? String(dialog.rollingWaveSelect.value || '').trim().toLowerCase() : '',
          objective: dialog.objectiveInput ? String(dialog.objectiveInput.value || '').trim() : '',
          keyResultTitle: dialog.krTitleInput ? String(dialog.krTitleInput.value || '').trim() : '',
          keyResultCurrent: dialog.krCurrentInput ? Number(dialog.krCurrentInput.value || 0) : 0,
          keyResultTarget: dialog.krTargetInput ? Number(dialog.krTargetInput.value || 0) : 0,
          bottleneckNote: dialog.bottleneckInput ? String(dialog.bottleneckInput.value || '').trim() : '',
          cycleGoal: dialog.cycleGoalInput ? String(dialog.cycleGoalInput.value || '').trim() : '',
          quadrant2Focus: dialog.quadrant2Input ? !!dialog.quadrant2Input.checked : false
        });
      }

      function applyProjectDialogStrategyPreset(preset) {
        try {
          var dialog = state.projectDialog;
          if (!dialog) return;
          var settings = normalizeStrategicLayerSettings(state.strategicLayerSettings || getDefaultStrategicLayerSettings());
          if (preset === 'default') {
            if (dialog.primaryMethodSelect && !dialog.primaryMethodSelect.value) dialog.primaryMethodSelect.value = settings.defaults.projectMethod || 'impact_effort';
          } else if (preset === 'quick_win') {
            if (dialog.primaryMethodSelect) dialog.primaryMethodSelect.value = 'impact_effort';
            if (dialog.impactSelect && Number(dialog.impactSelect.value || 0) <= 0) dialog.impactSelect.value = '4';
            if (dialog.effortSelect && Number(dialog.effortSelect.value || 0) <= 0) dialog.effortSelect.value = '2';
            if (dialog.rollingWaveSelect && !dialog.rollingWaveSelect.value) dialog.rollingWaveSelect.value = 'now';
            if (dialog.moscowSelect && !dialog.moscowSelect.value) dialog.moscowSelect.value = 'should';
          } else if (preset === 'risk') {
            if (dialog.primaryMethodSelect) dialog.primaryMethodSelect.value = 'toc';
            if (dialog.rollingWaveSelect && !dialog.rollingWaveSelect.value) dialog.rollingWaveSelect.value = 'now';
            if (dialog.moscowSelect && !dialog.moscowSelect.value) dialog.moscowSelect.value = 'must';
          } else if (preset === 'okr') {
            if (dialog.primaryMethodSelect) dialog.primaryMethodSelect.value = 'okr';
            if (dialog.rollingWaveSelect && !dialog.rollingWaveSelect.value) dialog.rollingWaveSelect.value = 'next';
            if (dialog.quadrant2Input) dialog.quadrant2Input.checked = true;
          }
          renderProjectDialogStrategyReadiness();
        } catch (error) {
          console.warn('[project-strategy-preset-error]', error);
        }
      }

      function renderProjectDialogStrategyReadiness() {
        try {
          var dialog = state.projectDialog;
          if (!(dialog && dialog.strategyReadinessPanel)) return;
          var profile = getProjectDialogDraftStrategyProfile();
          var readiness = getProjectStrategyReadiness(profile);
          var checksHtml = readiness.checks.map(function (item) {
            return '<span class="metric-chip">' + escapeHtml((item.done ? '✓ ' : '○ ') + item.title) + '</span>';
          }).join('');
          dialog.strategyReadinessPanel.innerHTML = [
            '<div class="project-card-note-title">Strategic profile readiness · ' + readiness.score + '%</div>',
            '<div class="project-card-note-body">Заполнено ' + readiness.doneCount + '/' + readiness.total + ' · ' + escapeHtml(readiness.label) + '. Следующий шаг: ' + escapeHtml(getProjectStrategyReadinessNextStep(readiness)) + '</div>',
            '<div class="shell-task-meta" style="margin-top:8px;">' + checksHtml + '</div>',
            '<div class="project-actions" style="margin-top:10px;">',
              '<button type="button" class="btn-ghost" id="projectDialogPresetDefaultBtn">Default method</button>',
              '<button type="button" class="btn-ghost" id="projectDialogPresetQuickWinBtn">Quick win</button>',
              '<button type="button" class="btn-ghost" id="projectDialogPresetRiskBtn">Risk / bottleneck</button>',
              '<button type="button" class="btn-ghost" id="projectDialogPresetOkrBtn">OKR starter</button>',
            '</div>'
          ].join('');
          var defaultBtn = byId('projectDialogPresetDefaultBtn');
          var quickWinBtn = byId('projectDialogPresetQuickWinBtn');
          var riskBtn = byId('projectDialogPresetRiskBtn');
          var okrBtn = byId('projectDialogPresetOkrBtn');
          if (defaultBtn) defaultBtn.addEventListener('click', function () { applyProjectDialogStrategyPreset('default'); });
          if (quickWinBtn) quickWinBtn.addEventListener('click', function () { applyProjectDialogStrategyPreset('quick_win'); });
          if (riskBtn) riskBtn.addEventListener('click', function () { applyProjectDialogStrategyPreset('risk'); });
          if (okrBtn) okrBtn.addEventListener('click', function () { applyProjectDialogStrategyPreset('okr'); });
        } catch (error) {
          console.warn('[project-strategy-readiness-render-error]', error);
        }
      }

      function bindProjectDialogStrategyReadiness() {
        try {
          var dialog = state.projectDialog;
          if (!(dialog && !dialog.strategyReadinessBound)) return;
          [
            dialog.primaryMethodSelect, dialog.impactSelect, dialog.effortSelect, dialog.reachSelect, dialog.confidenceSelect,
            dialog.moscowSelect, dialog.rollingWaveSelect, dialog.objectiveInput, dialog.krTitleInput, dialog.krCurrentInput,
            dialog.krTargetInput, dialog.bottleneckInput, dialog.cycleGoalInput, dialog.quadrant2Input
          ].forEach(function (node) {
            if (!node) return;
            node.addEventListener('input', renderProjectDialogStrategyReadiness);
            node.addEventListener('change', renderProjectDialogStrategyReadiness);
          });
          dialog.strategyReadinessBound = true;
        } catch (error) {
          console.warn('[project-strategy-readiness-bind-error]', error);
        }
      }

      function getProjectCriticalPathCandidate(tasks) {
        return (Array.isArray(tasks) ? tasks : []).filter(function (task) {
          if (!(task && task.due_at)) return false;
          var meta = getTaskDependencyMeta(task);
          return !!(meta && (meta.blockedByTask || meta.blockingTaskIds && meta.blockingTaskIds.length));
        }).sort(compareTasksByDueAndUpdated)[0] || null;
      }

      function buildProjectStrategicSummary(projectName, tasks) {
        var profile = getProjectStrategyProfile(projectName);
        var list = Array.isArray(tasks) ? tasks.slice() : [];
        var moscowCounts = { must: 0, should: 0, could: 0, wont: 0 };
        var q2Count = 0;
        list.forEach(function (task) {
          var assignment = getTaskFrameworkAssignment(task && task.id);
          if (assignment.moscow && moscowCounts[assignment.moscow] !== undefined) moscowCounts[assignment.moscow] += 1;
          if (assignment.eisenhower === 'important_not_urgent') q2Count += 1;
        });
        var riceScore = getRiceScore(profile);
        var okrProgress = profile.keyResultTarget > 0 ? Math.max(0, Math.min(100, Math.round((profile.keyResultCurrent / profile.keyResultTarget) * 100))) : 0;
        var blockedCount = list.filter(function (task) { return !!(getTaskDependencyMeta(task).blockedByTask); }).length;
        return {
          profile: profile,
          impactEffortQuadrant: getImpactEffortQuadrant(profile),
          riceScore: riceScore,
          okrProgress: okrProgress,
          moscowCounts: moscowCounts,
          q2Count: q2Count,
          blockedCount: blockedCount,
          criticalTask: getProjectCriticalPathCandidate(list)
        };
      }

      function renderProjectStrategicPanel(projectName, tasks, options) {
        var settings = normalizeStrategicLayerSettings(state.strategicLayerSettings || getDefaultStrategicLayerSettings());
        if (!settings.enabled) return null;
        var summary = buildProjectStrategicSummary(projectName, tasks || []);
        var profile = summary.profile;
        var hasAny = !!(profile.primaryMethod || profile.impact || profile.effort || profile.reach || profile.confidence || profile.moscow || profile.rollingWave || profile.objective || profile.keyResultTitle || profile.bottleneckNote || profile.cycleGoal || profile.quadrant2Focus || summary.q2Count || summary.blockedCount || summary.criticalTask || summary.moscowCounts.must || summary.moscowCounts.should || summary.moscowCounts.could || summary.moscowCounts.wont);
        if (!hasAny && !(tasks && tasks.length)) return null;
        var compact = !!(options && options.compact);
        var box = document.createElement('div');
        box.className = compact ? 'project-card-note' : 'framework-knowledge-card';
        if (compact) {
          var titleNode = document.createElement('div');
          titleNode.className = 'project-card-note-title';
          titleNode.textContent = 'Strategic layer';
          box.appendChild(titleNode);
        } else {
          box.innerHTML = '<div class="framework-knowledge-title-row"><h4>Project Planning + Strategic Layer</h4><span class="framework-knowledge-badge status-partial">partial</span></div>';
        }
        var chips = document.createElement('div');
        chips.className = 'shell-task-meta';
        if (profile.primaryMethod) chips.appendChild(createChip('Primary: ' + getStrategicMethodTitle(profile.primaryMethod)));
        if (settings.methods.impactEffort && summary.impactEffortQuadrant) chips.appendChild(createChip(summary.impactEffortQuadrant));
        if (settings.methods.riceIce && summary.riceScore > 0) chips.appendChild(createChip('RICE: ' + summary.riceScore.toFixed(1)));
        if (settings.methods.moscow && profile.moscow) chips.appendChild(createChip('MoSCoW: ' + profile.moscow.toUpperCase()));
        if (settings.methods.rollingWave && profile.rollingWave) chips.appendChild(createChip('Wave: ' + profile.rollingWave));
        if (settings.methods.quadrant2 && (profile.quadrant2Focus || summary.q2Count)) chips.appendChild(createChip('Q2: ' + (summary.q2Count || 0)));
        if (settings.methods.twelveWeekYear && profile.cycleGoal) chips.appendChild(createChip('12 Week Year'));
        box.appendChild(chips);
        var readinessPanel = createProjectStrategyReadinessElement(projectName, profile, { compact: compact });
        if (readinessPanel) box.appendChild(readinessPanel);
        if (profile.objective) {
          var objective = document.createElement('div');
          objective.className = compact ? 'project-card-note-body' : 'framework-knowledge-text';
          objective.textContent = 'Objective: ' + profile.objective;
          box.appendChild(objective);
        }
        if (settings.methods.okr && profile.keyResultTitle) {
          var okr = document.createElement('div');
          okr.className = compact ? 'project-card-note-body' : 'framework-knowledge-text';
          var progressLabel = profile.keyResultTarget > 0 ? ('KR: ' + profile.keyResultCurrent + ' / ' + profile.keyResultTarget + ' · ' + summary.okrProgress + '%') : ('KR: ' + profile.keyResultTitle);
          okr.textContent = progressLabel;
          box.appendChild(okr);
        }
        if (settings.methods.toc && profile.bottleneckNote) {
          var bottleneck = document.createElement('div');
          bottleneck.className = compact ? 'project-card-note-body' : 'framework-knowledge-text';
          bottleneck.textContent = 'Узкое место: ' + profile.bottleneckNote;
          box.appendChild(bottleneck);
        } else if (settings.methods.toc && summary.blockedCount) {
          var blocked = document.createElement('div');
          blocked.className = compact ? 'project-card-note-body' : 'framework-knowledge-text';
          blocked.textContent = 'Сейчас с блокером: ' + summary.blockedCount + ' задач.';
          box.appendChild(blocked);
        }
        if (settings.methods.criticalPath && summary.criticalTask) {
          var critical = document.createElement('div');
          critical.className = compact ? 'project-card-note-body' : 'framework-knowledge-text';
          critical.textContent = 'Critical path candidate: ' + (summary.criticalTask.title || 'Без названия') + (summary.criticalTask.due_at ? (' · ' + formatShortDateTimeLocal(summary.criticalTask.due_at)) : '');
          box.appendChild(critical);
        }
        return box;
      }

      function renderProjectsStrategicCommandCards(commandCenter, visibleItems) {
        var settings = normalizeStrategicLayerSettings(state.strategicLayerSettings || getDefaultStrategicLayerSettings());
        if (!(settings.enabled && settings.showProjectsSummary && commandCenter)) return;
        var items = Array.isArray(visibleItems) ? visibleItems.slice() : [];
        var withProfiles = items.map(function (item) {
          return { item: item, summary: buildProjectStrategicSummary(item.name, item.tasks || []) };
        });
        var bestRice = withProfiles.filter(function (entry) { return entry.summary.riceScore > 0; }).sort(function (a, b) { return b.summary.riceScore - a.summary.riceScore; })[0] || null;
        var quickWin = withProfiles.filter(function (entry) { return entry.summary.impactEffortQuadrant === 'Быстрая победа'; })[0] || null;
        var bottleneck = withProfiles.filter(function (entry) { return !!(entry.summary.profile.bottleneckNote || entry.summary.blockedCount); }).sort(function (a, b) { return b.summary.blockedCount - a.summary.blockedCount; })[0] || null;
        var okrItem = withProfiles.filter(function (entry) { return !!(entry.summary.profile.objective || entry.summary.profile.keyResultTitle); }).sort(function (a, b) { return (b.summary.okrProgress || 0) - (a.summary.okrProgress || 0); })[0] || null;
        if (bestRice && settings.methods.riceIce) {
          commandCenter.appendChild(createProjectsCommandCard(1, 'RICE-лидер', bestRice.item.name + ' · score ' + bestRice.summary.riceScore.toFixed(1), 'Открыть', function () {
            state.projectsSearch = bestRice.item.name;
            renderProjectsView();
          }));
        }
        if (quickWin && settings.methods.impactEffort) {
          commandCenter.appendChild(createProjectsCommandCard(1, 'Быстрая победа', quickWin.item.name + ' выглядит как quick win по Impact / Effort.', 'Открыть', function () {
            state.projectsSearch = quickWin.item.name;
            renderProjectsView();
          }));
        }
        if (bottleneck && settings.methods.toc) {
          commandCenter.appendChild(createProjectsCommandCard(1, 'Узкое место', bottleneck.item.name + ' · блокеров: ' + bottleneck.summary.blockedCount, 'Открыть', function () {
            state.projectsSearch = bottleneck.item.name;
            renderProjectsView();
          }));
        }
        if (okrItem && settings.methods.okr) {
          commandCenter.appendChild(createProjectsCommandCard(1, 'OKR / Goal', okrItem.item.name + ' · progress ' + okrItem.summary.okrProgress + '%', 'Открыть', function () {
            state.projectsSearch = okrItem.item.name;
            renderProjectsView();
          }));
        }
      }

      function renderPlanStrategicLayer(data) {
        var settings = normalizeStrategicLayerSettings(state.strategicLayerSettings || getDefaultStrategicLayerSettings());
        if (!(settings.enabled && settings.showPlanLayer)) return null;
        var visibleWeekTasks = getPlanVisibleWeekTasks(data || getPlanViewData());
        var blockedCount = visibleWeekTasks.filter(function (task) { return !!(getTaskDependencyMeta(task).blockedByTask); }).length;
        var q2Count = visibleWeekTasks.filter(function (task) { return getTaskFrameworkAssignment(task.id).eisenhower === 'important_not_urgent'; }).length;
        var mustCount = visibleWeekTasks.filter(function (task) { return getTaskFrameworkAssignment(task.id).moscow === 'must'; }).length;
        var projectNames = Object.create(null);
        visibleWeekTasks.forEach(function (task) { projectNames[normalizeProjectName(task.project_name)] = true; });
        var projectList = Object.keys(projectNames).filter(function (name) { return name && name !== 'Без проекта'; });
        var okrProjects = projectList.filter(function (name) { var profile = getProjectStrategyProfile(name); return !!(profile.objective || profile.keyResultTitle); }).length;
        var cycleProjects = projectList.filter(function (name) { var profile = getProjectStrategyProfile(name); return !!profile.cycleGoal; }).length;
        var shell = document.createElement('section');
        shell.className = 'plan-week-simple-section';
        shell.innerHTML = '<div class="plan-week-simple-head"><div class="plan-week-simple-title-wrap"><div class="plan-week-simple-title">Стратегический слой недели</div><div class="plan-week-simple-subtitle">Связка проектов, задач недели и стратегического фокуса без выдуманной аналитики.</div></div><div class="plan-section-head-right"></div></div>';
        var right = shell.querySelector('.plan-section-head-right');
        if (right) right.appendChild(createChip(String(projectList.length)));
        var grid = document.createElement('div');
        grid.className = 'execution-flow-grid';
        if (settings.methods.moscow) grid.innerHTML += '<article class="execution-flow-card"><h4>MoSCoW</h4><p>Must-задач в видимой неделе: ' + mustCount + '.</p><div class="execution-flow-kpis"><span class="metric-chip">Проектов в срезе: ' + projectList.length + '</span></div></article>';
        if (settings.methods.quadrant2) grid.innerHTML += '<article class="execution-flow-card"><h4>Quadrant 2</h4><p>Важно, но не срочно: ' + q2Count + ' задач.</p><div class="execution-flow-kpis"><span class="metric-chip">Неделя как инвестиция в важное</span></div></article>';
        if (settings.methods.okr) grid.innerHTML += '<article class="execution-flow-card"><h4>OKR / Goals</h4><p>Проектов недели с objective / KR: ' + okrProjects + '.</p><div class="execution-flow-kpis"><span class="metric-chip">12 Week layer: ' + cycleProjects + '</span></div></article>';
        if (settings.methods.toc || settings.methods.criticalPath) grid.innerHTML += '<article class="execution-flow-card"><h4>Constraints / Critical Path</h4><p>С блокером в видимой неделе: ' + blockedCount + ' задач.</p><div class="execution-flow-kpis"><span class="metric-chip">Видимых задач: ' + visibleWeekTasks.length + '</span></div></article>';
        shell.appendChild(grid);
        return shell;
      }

      function upgradeFrameworkKnowledgeEntriesForStrategicLayer() {
        [
          ['impact_effort', 'partial', 'Оценка по двум осям: эффект и усилия. В системе появился project-layer для ручной оценки и quadrant-подсказок.'],
          ['rice_ice', 'partial', 'RICE / ICE для инициатив и проектов. В системе появился локальный project-layer с reach / impact / confidence / effort и score.'],
          ['moscow', 'partial', 'Must / Should / Could / Won’t. В системе появился task-level выбор и project/week strategic summaries.'],
          ['rolling_wave', 'partial', 'Now / Next / Later для проектов. В системе появился project strategic profile с горизонтом.'],
          ['toc', 'partial', 'Узкое место проекта и bottleneck planning. В системе появился bottleneck note и живой счётчик блокеров по проекту.'],
          ['critical_path', 'partial', 'Цепочка задач, от которой зависит срок. В системе появился candidate layer по зависимым задачам проекта.'],
          ['okr', 'partial', 'Objective → key result → tasks. В системе появился project goal/profile и KR-progress layer.'],
          ['twelve_week_year', 'partial', '12-недельный цикл и отдельная цель цикла. В системе появился project-level cycle goal.'],
          ['quadrant2', 'partial', 'Фокус на важном, но не срочном. В системе появился weekly summary по Q2-задачам и project flag.' ]
        ].forEach(function (pair) {
          var entry = FRAMEWORK_KNOWLEDGE_ENTRIES.find(function (item) { return item.id === pair[0]; });
          if (!entry) return;
          entry.status = pair[1];
          entry.summary = pair[2];
        });
      }
      upgradeFrameworkKnowledgeEntriesForStrategicLayer();

      function byId(id) { return document.getElementById(id); }

      function ensureTaskHoverCardElement() {
        if (state.taskHoverCardEl && state.taskHoverCardEl.parentNode) return state.taskHoverCardEl;
        var card = document.createElement('div');
        card.id = 'taskHoverCard';
        card.className = 'task-hover-card';
        card.innerHTML = '<div class="task-hover-card-title" id="taskHoverCardTitle"></div><div class="task-hover-card-meta" id="taskHoverCardMeta"></div>';;
        document.body.appendChild(card);
        state.taskHoverCardEl = card;
        return card;
      }

      function hideTaskHoverCard() {
        var card = state.taskHoverCardEl || byId('taskHoverCard');
        if (card) card.style.display = 'none';
      }

      function showTaskHoverCard(task, anchorElement) {
        if (!(task && anchorElement) || state.dragPayload || state.resizeState || state.moveModeTaskId || isTouchLikeDevice()) {
          hideTaskHoverCard();
          return;
        }
        var card = ensureTaskHoverCardElement();
        var titleNode = byId('taskHoverCardTitle');
        var metaNode = byId('taskHoverCardMeta');
        if (!card || !titleNode || !metaNode) return;
        titleNode.textContent = task.title || 'Без названия';
        metaNode.innerHTML = '';
        var durationChip = document.createElement('div');
        durationChip.className = 'task-hover-card-chip';
        durationChip.textContent = 'Длительность: ' + formatDurationLabel(getTaskDurationMinutes(task));
        metaNode.appendChild(durationChip);
        card.style.display = 'block';
        card.style.visibility = 'hidden';
        var rect = anchorElement.getBoundingClientRect();
        var cardRect = card.getBoundingClientRect();
        var preferredLeft = rect.right + 12;
        var fallbackLeft = rect.left - cardRect.width - 12;
        var left = preferredLeft;
        if (preferredLeft + cardRect.width > window.innerWidth - 12) left = Math.max(12, fallbackLeft);
        var top = Math.min(Math.max(12, rect.top), Math.max(12, window.innerHeight - cardRect.height - 12));
        card.style.left = Math.round(left) + 'px';
        card.style.top = Math.round(top) + 'px';
        card.style.visibility = 'visible';
      }

      function bindTaskHoverCard(element, task) {
        if (!(element && task)) return;
