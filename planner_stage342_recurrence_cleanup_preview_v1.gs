async function handleTelegramControlRunApi(request, env) {
  if (request.method !== 'POST') return textResponse('Method Not Allowed', 405);

  try {
    if (!env.TELEGRAM_BOT_TOKEN) {
      return jsonResponse({ ok: false, error: 'TELEGRAM_BOT_TOKEN is not configured' }, { status: 400 });
    }
    const body = await request.json();
    const userId = String(body?.user_id || '').trim();
    const action = String(body?.action || '').trim().toLowerCase();
    const timeZone = getConfiguredTelegramControlTimezone(env);
    const dayYmd = body?.day_ymd ? String(body.day_ymd).trim() : getTelegramTodayYmd(timeZone);
    if (!userId) return jsonResponse({ ok: false, error: 'user_id is required' }, { status: 400 });

    if (action === 'plan') {
      const appUrl = getAppUrlFromRequest(request, env);
      const result = await sendTelegramDayPlanMessage(env, {
        userId,
        dayYmd,
        timeZone,
        replyMarkup: buildTelegramPlannerOpenReplyMarkup(appUrl, 'Открыть день в Planner'),
      });
      return jsonResponse({ ok: true, action, user_id: userId, day_ymd: result.day_ymd, counts: result.counts });
    }
    if (action === 'next') {
      await handleTelegramNextCommand(env, userId, request);
      return jsonResponse({ ok: true, action, user_id: userId, day_ymd: dayYmd });
    }
    if (action === 'rest') {
      await handleTelegramRestCommand(env, userId);
      return jsonResponse({ ok: true, action, user_id: userId, day_ymd: dayYmd });
    }
    if (action === 'finish') {
      await handleTelegramFinishCommand(env, userId, request);
      return jsonResponse({ ok: true, action, user_id: userId, day_ymd: dayYmd });
    }
    if (action === 'focus') {
      await handleTelegramFocusCommand(env, userId, [], request);
      return jsonResponse({ ok: true, action, user_id: userId, day_ymd: dayYmd });
    }
    if (action === 'app') {
      await handleTelegramAppCommand(env, userId, request);
      return jsonResponse({ ok: true, action, user_id: userId, day_ymd: dayYmd });
    }
    if (action === 'fact') {
      const result = await sendTelegramDayFactMessage(env, userId, dayYmd, timeZone);
      return jsonResponse({ ok: true, action, user_id: userId, day_ymd: dayYmd, counts: result.counts });
    }

    return jsonResponse({ ok: false, error: 'Unsupported action' }, { status: 400 });
  } catch (error) {
    return jsonResponse({ ok: false, error: String(error) }, { status: 500 });
  }
}

