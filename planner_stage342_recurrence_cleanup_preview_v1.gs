        var blockingActiveTasks = blockingTasks.filter(function (item) {
          var itemStatus = normalizeStatus(item && item.status);
          return itemStatus !== STATUS.DONE && itemStatus !== STATUS.CANCELED;
        });
        var blockedByTitle = blockedByTask ? (blockedByTask.title || 'Без названия') : '';
        return {
          taskId: taskId,
          blockedByTaskId: blockedByTaskId || '',
          blockedByTask: blockedByTask || null,
          blockedByTitle: blockedByTitle,
          blockingTasks: blockingTasks,
          blockingActiveTasks: blockingActiveTasks,
          blockingCount: blockingTasks.length,
          blockingActiveCount: blockingActiveTasks.length,
          isBlocked: !!(isActive && blockedByTaskId),
          hasDependents: blockingActiveTasks.length > 0,
          isAttentionNeeded: !!((isActive && blockedByTaskId) || blockingActiveTasks.length > 0),
          tone: (isActive && blockedByTaskId) ? 'danger' : (blockingActiveTasks.length > 0 ? 'warn' : 'info')
        };
      }

      function getTaskDependencyMetaNodes(task) {
        var info = getTaskDependencyMeta(task);
        var chips = [];
        if (info.isBlocked) chips.push(createChip('Блокер' + (info.blockedByTitle ? ': ' + info.blockedByTitle : '')));
        if (info.blockingActiveCount > 0) chips.push(createChip('Блокирует: ' + info.blockingActiveCount));
        return chips;
      }

      function getDependencyTaskReasonLines(task) {
        var info = getTaskDependencyMeta(task);
        var lines = [];
        if (info.isBlocked) lines.push('Сначала нужно продвинуть задачу-блокер' + (info.blockedByTitle ? ': ' + info.blockedByTitle : '.'));
        if (info.blockingActiveCount > 0) lines.push('От этой задачи зависят другие задачи: ' + info.blockingActiveCount + '.');
        if (!lines.length) lines.push('Явных зависимостей по задаче сейчас нет.');
        return lines;
      }

      function getDependencyDigestData(tasks) {
        var seen = Object.create(null);
        var linkedTasks = (tasks || []).filter(function (task) {
          if (!(task && task.id) || seen[task.id]) return false;
          seen[task.id] = true;
          var info = getTaskDependencyMeta(task);
          return info.isBlocked || info.hasDependents;
        }).sort(function (a, b) {
          var aInfo = getTaskDependencyMeta(a);
          var bInfo = getTaskDependencyMeta(b);
          if (aInfo.isBlocked !== bInfo.isBlocked) return aInfo.isBlocked ? -1 : 1;
          if (aInfo.blockingActiveCount !== bInfo.blockingActiveCount) return bInfo.blockingActiveCount - aInfo.blockingActiveCount;
          return compareTasksByPriorityThenDue(a, b);
        });
        var blockedCount = linkedTasks.filter(function (task) { return getTaskDependencyMeta(task).isBlocked; }).length;
        var blockingCount = linkedTasks.filter(function (task) { return getTaskDependencyMeta(task).hasDependents; }).length;
        var chainCount = linkedTasks.filter(function (task) {
          var info = getTaskDependencyMeta(task);
          return info.isBlocked && info.hasDependents;
        }).length;
        return {
          tasks: linkedTasks,
          linkedCount: linkedTasks.length,
          blockedCount: blockedCount,
          blockingCount: blockingCount,
          chainCount: chainCount,
          leadTask: linkedTasks.length ? linkedTasks[0] : null,
          topTasks: linkedTasks.slice(0, 4)
        };
      }

      function createDependencyDigestStat(value, label, tone) {
        var item = document.createElement('div');
        item.className = 'risk-digest-stat';
