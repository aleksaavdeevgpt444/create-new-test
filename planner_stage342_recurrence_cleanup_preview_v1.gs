      function buildKnowledgeWizardResult(inputValue) {
        var input = normalizeKnowledgeWizardInput(inputValue || loadKnowledgeWizardInput());
        var recommenderInput = mapWizardInputToRecommenderInput(input);
        var result = buildInteractiveRecommenderResult(recommenderInput);
        var primarySystem = 'author';
        if (result.bestRole && result.bestRole.primarySystem) primarySystem = result.bestRole.primarySystem;
        var avoid = [];
        if (input.structure === 'low') avoid = ['rice_ice','toc','critical_path'].filter(function (id) { return result.frameworks.indexOf(id) < 0; });
        else if (input.priority === 'focus') avoid = ['rice_ice','critical_path'].filter(function (id) { return result.frameworks.indexOf(id) < 0; });
        else avoid = ['energy'].filter(function (id) { return result.frameworks.indexOf(id) < 0; });
        return Object.assign({}, result, {
          wizardInput: input,
          recommenderInput: recommenderInput,
          primarySystem: primarySystem,
          mainScreen: input.priority === 'planning' ? 'План' : (input.priority === 'strategy' ? 'Проекты / Гант' : 'Сегодня'),
          avoidFrameworks: avoid,
          previewLines: [
            'Роль: ' + (result.bestRole ? result.bestRole.title : '—'),
