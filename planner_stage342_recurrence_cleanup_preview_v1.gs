    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      background: radial-gradient(circle at top left, #1a2846 0%, #0d1220 56%);
      color: var(--text);
      font-family: var(--font-ui);
      min-height: 100%;
      font-size: var(--font-size-base);
    }

    body { min-height: 100vh; }
    button, input, select, textarea { font: inherit; }
    button {
      border: none;
      border-radius: 12px;
      padding: 10px 14px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 700;
      transition: transform .15s ease, opacity .15s ease, background .15s ease;
    }
    button:hover { transform: translateY(-1px); }
    button:active { transform: translateY(0); }
    textarea { resize: vertical; min-height: 88px; }

    .btn-primary { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #08101b; box-shadow: 0 10px 22px rgba(72,141,255,.18); }
    .btn-secondary { background: rgba(255,255,255,.075); color: var(--text); }
    .btn-ghost {
      background: rgba(255,255,255,.05);
      border: 1px solid rgba(255,255,255,.08);
      color: var(--muted);
    }

    .btn-ghost.is-loading,
    .btn-primary.is-loading,
    .btn-secondary.is-loading,
    .btn-square-ai.is-loading {
      pointer-events: none;
      cursor: wait;
      opacity: .88;
      transform: none !important;
    }
    .btn-square-ai.is-loading {
      color: transparent !important;
      position: relative;
    }
    .btn-square-ai.is-loading::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 50%;
      width: 16px;
      height: 16px;
      margin-left: -8px;
      margin-top: -8px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,.24);
      border-top-color: rgba(255,255,255,.95);
      animation: ai-button-spin .7s linear infinite;
      box-sizing: border-box;
    }
    @keyframes ai-button-spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .btn-success { background: rgba(123,224,161,.18); color: #dffaea; border: 1px solid rgba(123,224,161,.2); }
    .btn-danger { background: rgba(255,139,139,.18); color: #ffe2e2; border: 1px solid rgba(255,139,139,.22); }
    .btn-warning { background: rgba(255,211,111,.18); color: #fff1c2; border: 1px solid rgba(255,211,111,.22); }
    .btn-delete {
      background: rgba(255,92,92,.10);
      color: #ffd8d8;
      border: 1px solid rgba(255,92,92,.26);
      box-shadow: inset 0 0 0 1px rgba(255,92,92,.06);
    }

    .hero-title,
    .today-hero-title,
    .week-hero-title,
    .editor-title,
    .drawer-title {
      font-family: var(--font-ui);
      font-weight: var(--font-weight-heavy);
      letter-spacing: -.02em;
    }

    .hero-subtitle,
    .week-subtitle,
    .view-subtitle,
    .field-label,
    .project-metric-label,
    .calendar-height-meta,
    .week-status-label,
    .week-inline-metric-label {
      font-family: var(--font-ui);
      font-size: var(--font-size-small);
    }

    .btn-mini {
      padding: 5px 8px;
      border-radius: 10px;
      background: rgba(255,255,255,.06);
      color: var(--text);
      font-size: 10px;
      line-height: 1.1;
      min-height: 26px;
    }

    .btn-mini.success { background: rgba(123,224,161,.18); color: #dffaea; }
    .btn-mini.danger { background: rgba(255,139,139,.18); color: #ffe2e2; }
    .btn-mini.warning { background: rgba(255,211,111,.18); color: #fff1c2; }
    .btn-mini.info { background: rgba(111,167,255,.18); color: #e6f0ff; }

    .app {
      padding: calc(16px + var(--app-safe-top)) 16px 16px;
      display: grid;
      gap: 14px;
      min-height: 100vh;
    }

    .topbar {
      display: grid;
      grid-template-columns: minmax(320px, 1fr) auto;
      gap: 14px;
      align-items: stretch;
    }

    .hero {
      background: linear-gradient(135deg, rgba(111,167,255,.20), rgba(130,217,255,.08));
      border: 1px solid rgba(130,217,255,.18);
      border-radius: 24px;
      padding: 18px 20px 16px;
      box-shadow: var(--shadow);
      display: grid;
      gap: 8px;
      align-content: center;
    }

    .hero-title { font-size: 24px; font-weight: 900; margin-bottom: 0; letter-spacing: -.015em; }
    .hero-subtitle { display: block; font-size: 12px; line-height: 1.42; color: rgba(234,241,255,.66); max-width: 760px; }

    .toolbar {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
      align-items: center;
      background: rgba(255,255,255,.028);
      border: 1px solid rgba(255,255,255,.06);
      border-radius: 22px;
      padding: 12px;
      box-shadow: var(--shadow);
      align-content: center;
    }
    .toolbar #openCreateBtn {
      min-width: 196px;
      min-height: 50px;
      font-weight: 900;
      box-shadow: 0 12px 24px rgba(72,141,255,.20);
    }
    .toolbar #reloadTopBtn {
      opacity: .76;
      min-height: 40px;
      padding: 9px 14px;
      font-size: 12px;
    }
    .toolbar #openSettingsBtn {
      opacity: .58;
      min-height: 40px;
      padding: 9px 14px;
      font-size: 12px;
    }

    #prevWeekBtn, #nextWeekBtn {
      background: rgba(255,255,255,.04);
      color: rgba(234,241,255,.74);
      border-color: rgba(255,255,255,.08);
      min-height: 40px;
      padding: 9px 14px;
      font-size: 12px;
    }
    #jumpCurrentWeekBtn {
      min-height: 48px;
      min-width: 184px;
      font-weight: 900;
