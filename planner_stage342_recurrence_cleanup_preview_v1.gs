      function getPlanViewData() {
        var filter = state.planFilter || 'active';
        var sort = state.planSort || 'priority';
        var weekTasks = applyWorkspaceTaskFilters(getCurrentWeekTasks());
        var backlogTasks = applyWorkspaceTaskFilters(getBacklogTasks().filter(function (task) { return !task.due_at; }));
        var primaryMap = collectWeekPrimaryTaskIds();
        var doneTasks = weekTasks.filter(function (task) { return normalizeStatus(task.status) === STATUS.DONE; });
        var activeWeekTasks = weekTasks.filter(function (task) {
          var status = normalizeStatus(task.status);
          return status === STATUS.NEW || status === STATUS.PLANNED || status === STATUS.POSTPONED;
        });
        var sorter = sort === 'due' ? compareTasksByDueAndUpdated : compareTasksByPriorityThenDue;
        function pass(task) { return matchesPlanTaskFilter(task, filter); }
        var main = [];
        var risk = [];
        var important = [];
        var additional = [];
        var recurring = [];
        weekTasks.forEach(function (task) {
          if (!pass(task)) return;
          if (primaryMap[String(task.id)]) {
            main.push(task);
            return;
          }
          if (isTaskAttentionNeeded(task)) {
            risk.push(task);
            return;
          }
          if (isRecurringCalendarTask(task)) {
            recurring.push(task);
            return;
          }
          if (getTaskPriorityRank(task) >= 3 || isTaskFocusProtected(task.id)) {
            important.push(task);
            return;
          }
          additional.push(task);
        });
        var noDate = backlogTasks.filter(pass);
        var riskBacklog = getAttentionTasks(noDate.filter(function (task) { return isTaskAttentionNeeded(task); }));
        risk = getAttentionTasks(risk.concat(riskBacklog));
        noDate = noDate.filter(function (task) { return !isTaskAttentionNeeded(task); });
        main.sort(sorter);
        risk.sort(sorter);
        important.sort(sorter);
        additional.sort(sorter);
        recurring.sort(compareTasksByDueAndUpdated);
        noDate.sort(compareTasksByPriorityThenDue);
        var totalWeekPlanned = weekTasks.reduce(function (sum, task) { return sum + getTaskPlannedMinutesValue(task); }, 0);
        var focusProtectedCount = weekTasks.filter(function (task) { return isTaskFocusProtected(task.id); }).length;
        return {
          filter: filter,
          sort: sort,
          weekTasks: weekTasks,
          activeWeekTasks: activeWeekTasks,
          backlogTasks: backlogTasks,
          doneTasks: doneTasks,
          sections: {
            main: main,
            risk: risk,
            important: important,
            additional: additional,
            recurring: recurring,
            noDate: noDate
          },
          stats: {
            total: weekTasks.length,
            active: activeWeekTasks.length,
            done: doneTasks.length,
            backlog: backlogTasks.length,
            recurring: weekTasks.filter(function (task) { return isRecurringCalendarTask(task); }).length,
            totalPlanned: totalWeekPlanned,
            focusProtected: focusProtectedCount,
            attention: risk.length
          }
        };
      }

      function getTaskDueClockLabel(task) {
        if (!(task && task.due_at)) return '';
        var due = new Date(task.due_at);
        if (isNaN(due.getTime())) return '';
        return minutesToClockLabel(due.getHours() * 60 + due.getMinutes());
      }

      function getTaskDueIsoForDay(task, dayYmd) {
        var clock = getTaskDueClockLabel(task);
        if (clock) return makeDueAtIso(dayYmd, clock);
        return getSuggestedTodaySlotIso(dayYmd, task);
      }

      async function sendTaskToTodayFromPlan(taskId) {
        var task = findTaskById(taskId);
        if (!(task && task.id)) {
          showError('Не удалось найти задачу для переноса в Сегодня.');
          return;
        }
        var targetDay = state.dayYmd || formatYmdLocal(new Date());
        await scheduleTask(task.id, getTaskDueIsoForDay(task, targetDay), STATUS.PLANNED, getTaskDurationMinutes(task));
      }

      async function unscheduleTaskFromPlan(taskId) {
        var task = findTaskById(taskId);
        if (!(task && task.id)) {
          showError('Не удалось найти задачу.');
          return;
        }
        await scheduleTask(task.id, null, STATUS.POSTPONED, getTaskDurationMinutes(task));
      }

      async function raiseTaskPriorityFromPlan(taskId) {
        if (!state.userId) {
          showError('Сначала укажи user_id.');
          return;
        }
        var task = findTaskById(taskId);
        if (!(task && task.id)) {
          showError('Не удалось найти задачу для изменения приоритета.');
          return;
        }
        var current = getTaskPriorityRank(task);
        var next = current <= 0 ? 2 : Math.min(3, current + 1);
        if (current >= 3) {
          showSuccess('У задачи уже высокий приоритет.');
          return;
        }
        try {
          var response = await updateTaskMeta(task.id, { priority_manual: next });
          if (response && response.item) applyTaskLocally(response.item);
          await loadPlanner();
          showSuccess('Приоритет задачи обновлён.');
        } catch (error) {
          showError(String(error && error.message ? error.message : error));
        }
      }

      function openTaskInPlannerCalendar(taskId) {
        var task = findTaskById(taskId);
        if (!(task && task.id)) {
          showError('Не удалось открыть задачу в календаре.');
          return;
        }
        var taskDay = getTaskWeekDayYmd(task);
        if (taskDay) state.dayYmd = taskDay;
        setActiveView('planner');
        setTimeout(function () { openEditor(task.id); }, 0);
      }

      function toggleTaskPrimaryFromPlan(taskId) {
        var task = findTaskById(taskId);
        if (!(task && task.id && task.due_at)) {
