async function getAiWeeklyPlanningReview(env, payload) {
  const weekLabel = String(payload?.week_label || '').trim();
  const summary = payload?.summary || {};
  const tasks = Array.isArray(payload?.tasks) ? payload.tasks.slice(0, 36) : [];
  const capacity = Array.isArray(payload?.capacity_days) ? payload.capacity_days.slice(0, 7) : [];

  const tasksText = tasks.map((task, index) => {
    const parts = [
      `${index + 1}. ${String(task?.title || '').trim() || 'Без названия'}`,
      `день: ${String(task?.day_label || 'без даты')}`,
      `статус: ${String(task?.status_label || '—')}`,
      `проект: ${String(task?.project_name || 'Без проекта')}`,
      `приоритет: ${String(task?.priority_label || 'не задан')}`,
      `план: ${String(task?.planned_label || '—')}`,
      `факт: ${String(task?.actual_label || '—')}`,
      `риск: ${task?.attention ? 'да' : 'нет'}`,
      `фокус-защита: ${task?.focus_protected ? 'да' : 'нет'}`
    ];
    if (task?.product) parts.push(`продукт: ${String(task.product)}`);
    return parts.join(' · ');
  }).join('\n');

  const capacityText = capacity.map((item) => [
    String(item?.day_label || 'день'),
    `план: ${String(item?.planned_label || '—')}`,
    `ёмкость: ${String(item?.capacity_label || '—')}`,
    `свободно/перегруз: ${String(item?.delta_label || '—')}`,
    `риск: ${item?.tone || 'neutral'}`
  ].join(' · ')).join('\n');

  const prompt = [
    'Ты AI-помощник внутри персонального недельного планировщика.',
    'Отвечай только на русском языке.',
    'Верни только JSON по указанной схеме.',
    'Нужно сделать weekly review и подсказать безопасные решения по неделе.',
