      function updateRecurrenceUi(scope) {
        var dateInput = byId(scope + 'DateInput');
        var hasDate = !!parseDisplayDateToYmd(dateInput && dateInput.value);
        var typeHidden = byId(scope + 'RecurrenceTypeInput');
        var ruleHidden = byId(scope + 'RecurrenceRuleInput');
        var enabledHidden = byId(scope + 'RecurrenceEnabledInput');
        if (!hasDate) {
          if (typeHidden) typeHidden.value = '';
          if (ruleHidden) ruleHidden.value = '';
          if (enabledHidden) enabledHidden.value = '0';
        }
        updateTimeSummary(scope);
        if (scope === 'editor') {
          var editorTask = findTaskById(state.editorTaskId);
          renderEditorRecurrenceSummary(editorTask);
