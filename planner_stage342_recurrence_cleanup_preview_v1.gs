      try {
        const data = await telegramApi(env, "getMe", {});
        return jsonResponse({ ok: true, build: getClientAppBuildLabel(), telegram: data });
      } catch (error) {
        return jsonResponse({ ok: false, error: String(error) }, { status: 500 });
      }
    }

    if (url.pathname === "/telegram/set-webhook") {
      const authFailure = requireAdminRouteAuth(request, env, "/telegram/set-webhook");
      if (authFailure) return authFailure;
      try {
        const webhookUrl = `${url.origin}/telegram/webhook`;
        const data = await telegramApi(env, "setWebhook", {
          url: webhookUrl,
          secret_token: env.TELEGRAM_WEBHOOK_SECRET,
          allowed_updates: ["message"],
        });
        return jsonResponse({ ok: true, build: getClientAppBuildLabel(), webhookUrl, telegram: data });
      } catch (error) {
        return jsonResponse({ ok: false, error: String(error) }, { status: 500 });
      }
    }

    if (url.pathname === "/telegram/set-menu-button") {
      const authFailure = requireAdminRouteAuth(request, env, "/telegram/set-menu-button");
      if (authFailure) return authFailure;
      try {
        const chatId = url.searchParams.get("chat_id") || null;
        const appUrl = getAppUrlFromRequest(request, env);
        const data = await setTelegramMenuButton(env, { chatId, appUrl });
        return jsonResponse({ ok: true, build: getClientAppBuildLabel(), appUrl, scope: chatId ? "chat" : "default", chatId, telegram: data });
      } catch (error) {
        return jsonResponse({ ok: false, error: String(error) }, { status: 500 });
      }
    }

    if (url.pathname === "/telegram/webhook") return handleTelegramWebhook(request, env);

    if (url.pathname === "/ai/test-priority") {
      const authFailure = requireAdminRouteAuth(request, env, "/ai/test-priority");
      if (authFailure) return authFailure;
      try {
        const taskText = url.searchParams.get("text") || "Купить домен для планнера";
        const result = await getAiTaskAdvice(env, taskText);
        return jsonResponse({ ok: true, build: getClientAppBuildLabel(), input: taskText, ai: result });
      } catch (error) {
        return jsonResponse({ ok: false, error: String(error) }, { status: 500 });
      }
    }

        return jsonResponse({ ok: false, build: getClientAppBuildLabel(), error: "Not found", path: url.pathname }, { status: 404 });
      })();

      return maybeReportErrorResponse(env, request, response);
