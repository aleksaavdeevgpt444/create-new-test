      function getDefaultViewControlSettings() {
        var settings = {
          todayPreset: 'full',
          weekPreset: 'full',
          todayVisible: Object.create(null),
          weekVisible: Object.create(null)
        };
        TODAY_VIEW_BLOCK_REGISTRY.forEach(function (item) { settings.todayVisible[item.id] = item.defaultVisible !== false; });
        WEEK_VIEW_BLOCK_REGISTRY.forEach(function (item) { settings.weekVisible[item.id] = item.defaultVisible !== false; });
        return settings;
      }

      function normalizeViewControlVisibilityMap(source, registry) {
        var map = Object.create(null);
        var safeSource = source && typeof source === 'object' ? source : {};
        registry.forEach(function (item) {
          map[item.id] = safeSource[item.id] !== false;
        });
        return map;
      }

      function normalizeViewControlSettings(value) {
        var defaults = getDefaultViewControlSettings();
        var source = value && typeof value === 'object' ? value : {};
        var todayPreset = String(source.todayPreset || defaults.todayPreset || 'full').trim() || 'full';
        var weekPreset = String(source.weekPreset || defaults.weekPreset || 'full').trim() || 'full';
        if (!VIEW_CONTROL_PRESETS.today[todayPreset]) todayPreset = defaults.todayPreset;
        if (!VIEW_CONTROL_PRESETS.week[weekPreset]) weekPreset = defaults.weekPreset;
        return {
          todayPreset: todayPreset,
          weekPreset: weekPreset,
          todayVisible: normalizeViewControlVisibilityMap(source.todayVisible, TODAY_VIEW_BLOCK_REGISTRY),
          weekVisible: normalizeViewControlVisibilityMap(source.weekVisible, WEEK_VIEW_BLOCK_REGISTRY)
        };
      }

      function loadStoredViewControlSettings() {
        try {
          var raw = localStorage.getItem(VIEW_CONTROL_SETTINGS_STORAGE_KEY);
          if (!raw) return getDefaultViewControlSettings();
          return normalizeViewControlSettings(JSON.parse(raw));
        } catch (error) {
          return getDefaultViewControlSettings();
        }
      }

      function saveViewControlSettings() {
        try { localStorage.setItem(VIEW_CONTROL_SETTINGS_STORAGE_KEY, JSON.stringify(state.viewControlSettings || getDefaultViewControlSettings())); } catch (error) {}
      }

      function getViewRegistryByScreen(screen) {
        return screen === 'today' ? TODAY_VIEW_BLOCK_REGISTRY : WEEK_VIEW_BLOCK_REGISTRY;
      }

      function getViewVisibilityMapByScreen(screen) {
        var settings = state.viewControlSettings || getDefaultViewControlSettings();
        return screen === 'today' ? (settings.todayVisible || Object.create(null)) : (settings.weekVisible || Object.create(null));
      }

      function isViewBlockVisible(screen, blockId) {
        var visibleMap = getViewVisibilityMapByScreen(screen);
        return visibleMap[blockId] !== false;
      }

      function applyPresetToViewControlSettings(screen, preset) {
        var normalized = normalizeViewControlSettings(state.viewControlSettings || getDefaultViewControlSettings());
        var registry = getViewRegistryByScreen(screen);
        var presetMap = VIEW_CONTROL_PRESETS[screen] && VIEW_CONTROL_PRESETS[screen][preset] ? VIEW_CONTROL_PRESETS[screen][preset] : null;
        if (!presetMap) return normalized;
        var visibleMap = Object.create(null);
        registry.forEach(function (item) {
          visibleMap[item.id] = presetMap.indexOf(item.id) !== -1;
        });
        if (screen === 'today') {
          normalized.todayPreset = preset;
          normalized.todayVisible = visibleMap;
        } else {
          normalized.weekPreset = preset;
          normalized.weekVisible = visibleMap;
        }
        return normalized;
      }

      function setSingleViewBlockVisibility(screen, blockId, nextVisible) {
        var normalized = normalizeViewControlSettings(state.viewControlSettings || getDefaultViewControlSettings());
        if (screen === 'today') {
          normalized.todayVisible[blockId] = !!nextVisible;
          normalized.todayPreset = 'custom';
          if (byId('todayViewPresetSelect')) byId('todayViewPresetSelect').value = 'custom';
        } else {
          normalized.weekVisible[blockId] = !!nextVisible;
          normalized.weekPreset = 'custom';
          if (byId('weekViewPresetSelect')) byId('weekViewPresetSelect').value = 'custom';
        }
        applyViewControlSettings(normalized);
        if (screen === 'today' && blockId === 'today_time_analytics') {
          try { renderTodayTimeAnalytics(); } catch (error) { console.error('[today-time-analytics-toggle-render-error]', error); }
        }
        if (state.currentView === screen || (screen === 'week' && state.currentView === 'planner')) {
          try { renderKnowledgeBaseSummary(); } catch (error) {}
        }
      }

      function findViewBlockDefinitionById(screen, blockId) {
        var registry = getViewRegistryByScreen(screen);
        for (var index = 0; index < registry.length; index += 1) {
          if (registry[index].id === blockId) return registry[index];
        }
        return null;
      }

      function setBlockVisibilityByDefinition(definition, visible, currentScreen) {
        if (!definition || !definition.selector) return;
        var nodes = document.querySelectorAll(definition.selector);
        if (!nodes || !nodes.length) return;
        var shouldShow = currentScreen ? currentScreen === true : true;
        Array.prototype.forEach.call(nodes, function (node) {
          if (!node) return;
          node.style.display = visible ? '' : 'none';
          node.setAttribute('data-view-block-hidden', visible ? '0' : '1');
        });
      }

      function isSharedViewControlSelector(selector) {
        return selector === '#productMapShell' || selector === '#navigationReframeShell' || selector === '#coreFlowPolishShell';
      }

      function applyViewControlSettings(settings) {
        var normalized = normalizeViewControlSettings(settings || state.viewControlSettings || getDefaultViewControlSettings());
        state.viewControlSettings = normalized;
        saveViewControlSettings();
        var currentView = normalizeViewName(state.currentView || 'today');
        TODAY_VIEW_BLOCK_REGISTRY.forEach(function (item) {
          if (isSharedViewControlSelector(item.selector)) return;
          var visible = normalized.todayVisible[item.id] !== false;
          setBlockVisibilityByDefinition(item, currentView === 'today' ? visible : true);
        });
        WEEK_VIEW_BLOCK_REGISTRY.forEach(function (item) {
          if (isSharedViewControlSelector(item.selector)) return;
          var visible = normalized.weekVisible[item.id] !== false;
          setBlockVisibilityByDefinition(item, currentView === 'planner' ? visible : true);
        });
        if (currentView === 'today') {
          TODAY_VIEW_BLOCK_REGISTRY.forEach(function (item) {
            if (!isSharedViewControlSelector(item.selector)) return;
            setBlockVisibilityByDefinition(item, normalized.todayVisible[item.id] !== false);
          });
        } else if (currentView === 'planner') {
          WEEK_VIEW_BLOCK_REGISTRY.forEach(function (item) {
            if (!isSharedViewControlSelector(item.selector)) return;
            setBlockVisibilityByDefinition(item, normalized.weekVisible[item.id] !== false);
          });
        } else {
          [{ selector: '#productMapShell' }, { selector: '#navigationReframeShell' }, { selector: '#coreFlowPolishShell' }].forEach(function (definition) {
            setBlockVisibilityByDefinition(definition, true);
          });
        }
        syncViewControlSettingsInputs();
        if (currentView === 'today') {
          try { renderTodayTimeAnalytics(); } catch (error) { console.error('[today-time-analytics-render-error]', error); }
        }
        renderKnowledgeBaseSummary();
      }

      function createViewControlToggleHtml(screen, definition) {
        var checked = isViewBlockVisible(screen, definition.id) ? 'checked' : '';
        return '<label class="view-control-toggle">' +
          '<input type="checkbox" data-view-block-screen="' + escapeHtml(screen) + '" data-view-block-id="' + escapeHtml(definition.id) + '" ' + checked + ' />' +
          '<span class="view-control-toggle-copy">' +
            '<span class="view-control-toggle-title">' + escapeHtml(definition.title) + '</span>' +
            '<span class="view-control-toggle-note">' + escapeHtml(definition.subtitle) + '</span>' +
          '</span>' +
        '</label>';
      }

      function renderViewControlToggleList(screen) {
        var container = byId(screen === 'today' ? 'todayViewBlockControlList' : 'weekViewBlockControlList');
        if (!container) return;
        var registry = getViewRegistryByScreen(screen);
        container.innerHTML = registry.map(function (definition) {
          return createViewControlToggleHtml(screen, definition);
        }).join('');
      }

      function syncViewControlSettingsInputs() {
        var settings = normalizeViewControlSettings(state.viewControlSettings || getDefaultViewControlSettings());
        if (byId('todayViewPresetSelect')) byId('todayViewPresetSelect').value = settings.todayPreset || 'full';
        if (byId('weekViewPresetSelect')) byId('weekViewPresetSelect').value = settings.weekPreset || 'full';
        renderViewControlToggleList('today');
        renderViewControlToggleList('week');
        bindViewControlToggleDelegates();
      }

      function bindViewControlToggleDelegates() {
        ['todayViewBlockControlList', 'weekViewBlockControlList'].forEach(function (containerId) {
          var container = byId(containerId);
          if (!container || container.dataset.bound === '1') return;
          container.addEventListener('change', function (event) {
            var target = event.target;
            if (!target || target.type !== 'checkbox') return;
            var screen = String(target.getAttribute('data-view-block-screen') || '').trim();
            var blockId = String(target.getAttribute('data-view-block-id') || '').trim();
            if (!screen || !blockId) return;
            setSingleViewBlockVisibility(screen, blockId, !!target.checked);
          });
          container.dataset.bound = '1';
        });
      }

