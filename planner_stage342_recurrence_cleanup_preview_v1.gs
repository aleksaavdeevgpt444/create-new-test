        actions.appendChild(createProjectActionButton('Гант', 'btn-ghost', function () { setWorkspaceFilters({ project: item.name }, { skipRender: true }); setActiveView('gantt'); renderShellViews(); showSuccess('Открыт Гант по проекту «' + item.name + '».'); }));
