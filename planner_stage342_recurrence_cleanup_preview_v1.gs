      function updateFocusTimerUi() {
        if (!state.focusSession) return;
        var overlay = ensureFocusModeOverlay();
        var elapsedMs = getFocusSessionElapsedMs(state.focusSession);
        var plannedMs = Math.max(1, Number(state.focusSession.plannedMinutes) || 0) * 60 * 1000;
        var remainingMs = Math.max(0, plannedMs - elapsedMs);
        overlay.timer.textContent = formatFocusCountdown(remainingMs);
        overlay.timerNote.textContent = (state.focusSession.isPaused ? 'На паузе · ' : 'Прошло ')
          + formatDurationLabel(Math.max(1, Math.round(elapsedMs / 60000)))
          + (state.focusSession.isPaused ? '' : (' · осталось ' + formatDurationLabel(Math.max(0, Math.ceil(remainingMs / 60000)))));
        var progress = plannedMs > 0 ? Math.min(100, (elapsedMs / plannedMs) * 100) : 0;
        overlay.progressBar.style.width = progress.toFixed(2) + '%';
        updateFocusSessionBannerUi();
        persistFocusSession();
      }

      function ensureFocusTimerRunning() {
        if (state.focusTimerId) {
          clearInterval(state.focusTimerId);
          state.focusTimerId = null;
        }
        if (!state.focusSession || state.focusSession.isPaused) return;
        state.focusTimerId = setInterval(updateFocusTimerUi, 1000);
      }

      async function persistFocusActualMinutes(taskId, minutesToAdd) {
        if (!taskId || !state.userId || !Number.isFinite(minutesToAdd) || minutesToAdd <= 0) return;
        var current = findTaskById(taskId) || {};
        var baseActual = Number(normalizeMinutesInputValue(current.actual_minutes)) || 0;
        var nextActual = baseActual + minutesToAdd;
        var response = await requestJson('/tasks/update', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ task_id: taskId, user_id: state.userId, actual_minutes: nextActual })
        });
        if (response && response.item) {
          applyTaskLocally(response.item);
          if (state.editorTaskId === taskId) {
            state.editorCurrentTaskSnapshot = cloneTask(response.item);
            fillEditor(response.item);
          }
        }
      }

      async function stopFocusSession(options) {
        var session = state.focusSession;
        if (!session) return;
        state.focusSession = null;
        clearPersistedFocusSession();
        if (state.focusTimerId) {
          clearInterval(state.focusTimerId);
          state.focusTimerId = null;
        }
        var overlay = ensureFocusModeOverlay();
        overlay.backdrop.style.display = 'none';
        renderFocusSessionBanner();
        var elapsedMinutes = getFocusSessionElapsedMinutes(session);
        if (options && options.saveProgress) {
          try {
            await persistFocusActualMinutes(session.taskId, elapsedMinutes);
            appendWellbeingLog('focus', { taskId: session.taskId, elapsedMinutes: elapsedMinutes, plannedMinutes: session.plannedMinutes, wasPaused: !!session.isPaused });
            showSuccess('Фокус-сессия завершена. В задачу записано ' + formatDurationLabel(elapsedMinutes) + '.');
          } catch (error) {
            showError(String(error));
          }
        }
      }

      async function launchFocusModeFromEditor() {
        try {
          var task = getCurrentEditorTaskForFocus();
          if (!task || !task.id) {
            showError('Сначала открой задачу.');
            return;
          }
          var focusSettings = state.focusSettings || getDefaultFocusSettings();
          var minutes = null;
          if (focusSettings.askDurationBeforeStart) {
            minutes = await openFocusDurationDialog(task);
            if (!minutes) return;
          } else {
            minutes = resolveDefaultFocusMinutes(task);
          }
          startFocusSession(task, minutes);
        } catch (error) {
          showError(String(error && error.message ? error.message : error));
        }
      }

