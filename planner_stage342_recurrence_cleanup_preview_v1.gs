      function formatYmdLocal(date) {
        var year = date.getFullYear();
        var month = String(date.getMonth() + 1).padStart(2, '0');
        var day = String(date.getDate()).padStart(2, '0');
        return year + '-' + month + '-' + day;
      }

      function formatDateTimeLocal(iso) {
        return formatWithPlannerTimeZone(iso, { dateStyle: 'short', timeStyle: 'medium' }, '—');
      }

      function formatShortDateTimeLocal(iso) {
        var datePart = formatWithPlannerTimeZone(iso, { day: '2-digit', month: '2-digit' }, '—');
        var timePart = formatWithPlannerTimeZone(iso, { hour: '2-digit', minute: '2-digit', hour12: false }, '—');
        if (datePart === '—' || timePart === '—') return '—';
        return datePart + ', ' + timePart;
      }


      function formatDateShortDisplay(value) {
        return formatWithPlannerTimeZone(value, { day: '2-digit', month: '2-digit', year: '2-digit' }, '—');
      }
      function formatDateLong(value) {
        return formatWithPlannerTimeZone(value, { weekday: 'long', day: 'numeric', month: 'long' }, '—');
      }
      function formatDateTimeDisplay(value) {
        return formatWithPlannerTimeZone(value, {
          day: '2-digit',
          month: '2-digit',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false
        }, '—');
      }
      function getTaskDurationMinutes(task) {
        return Math.max(Number(task && task.duration_minutes) || DEFAULT_EVENT_DURATION_MIN, 5);
      }

      function getTaskEndDate(task) {
        if (!task || !task.due_at) return null;
        var start = new Date(task.due_at);
        if (isNaN(start.getTime())) return null;
        return new Date(start.getTime() + getTaskDurationMinutes(task) * 60000);
      }

      function formatTimeRange(startIso, durationMinutes, options) {
        if (!startIso) return '—';
        var start = new Date(startIso);
        if (isNaN(start.getTime())) return '—';
        var end = new Date(start.getTime() + Math.max(Number(durationMinutes) || DEFAULT_EVENT_DURATION_MIN, 5) * 60000);
        var startTime = formatWithPlannerTimeZone(start, { hour: '2-digit', minute: '2-digit', hour12: false }, '—');
        var endTime = formatWithPlannerTimeZone(end, { hour: '2-digit', minute: '2-digit', hour12: false }, '—');
        var timeRange = startTime + '–' + endTime;
        if (options && options.withDate) {
          return formatWithPlannerTimeZone(start, { day: '2-digit', month: '2-digit' }, '—') + ', ' + timeRange;
        }
        return timeRange;
      }

      function formatTimeRangeByStart(startTimeString, durationMinutes) {
        if (!startTimeString) return '—';
        var match = String(startTimeString).trim().match(/^(\d{1,2}):(\d{2})$/);
        if (!match) return formatDurationLabel(durationMinutes);
        var startHours = Math.max(0, Math.min(23, Number(match[1]) || 0));
        var startMinutes = Math.max(0, Math.min(59, Number(match[2]) || 0));
        var duration = Math.max(Number(durationMinutes) || DEFAULT_EVENT_DURATION_MIN, 5);
        var totalStart = startHours * 60 + startMinutes;
        var totalEnd = totalStart + duration;
        var endHours = Math.floor(totalEnd / 60) % 24;
        var endMinutes = totalEnd % 60;
        var startLabel = String(startHours).padStart(2, '0') + ':' + String(startMinutes).padStart(2, '0');
        var endLabel = String(endHours).padStart(2, '0') + ':' + String(endMinutes).padStart(2, '0');
        return startLabel + '–' + endLabel;
      }

      function startOfWeekLocal(date) {
        var copy = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        var day = copy.getDay();
        var diff = day === 0 ? -6 : 1 - day;
        copy.setDate(copy.getDate() + diff);
        copy.setHours(0, 0, 0, 0);
        return copy;
      }

      function getCurrentWeekStartYmd() { return formatYmdLocal(startOfWeekLocal(new Date())); }

      function shiftWeekYmd(ymd, delta) {
        var date = new Date(ymd + 'T00:00:00');
        date.setDate(date.getDate() + delta * 7);
        return formatYmdLocal(date);
      }

      function addDaysYmd(ymd, days) {
        var date = new Date(ymd + 'T00:00:00');
        date.setDate(date.getDate() + days);
        return formatYmdLocal(date);
      }

