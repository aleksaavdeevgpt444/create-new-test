function getDefaultFrameworkSettingsServer() {
  const enabled = Object.create(null);
  SERVER_FRAMEWORK_CORE_IDS.forEach((frameworkId) => {
    enabled[frameworkId] = frameworkId === 'time_blocking';
  });
  return {
    enabled,
    defaults: {
      task: SERVER_FRAMEWORK_DEFAULTS.task,
      day: SERVER_FRAMEWORK_DEFAULTS.day,
      week: SERVER_FRAMEWORK_DEFAULTS.week,
      project: SERVER_FRAMEWORK_DEFAULTS.project
    }
  };
}

function normalizeFrameworkSettingsServer(value) {
  const defaults = getDefaultFrameworkSettingsServer();
  const source = value && typeof value === 'object' ? value : {};
  const normalized = {
    enabled: Object.create(null),
    defaults: {
      task: '',
      day: '',
      week: '',
      project: ''
    }
  };
  SERVER_FRAMEWORK_CORE_IDS.forEach((frameworkId) => {
    normalized.enabled[frameworkId] = !!(source.enabled && source.enabled[frameworkId] === true);
    if (!(frameworkId in normalized.enabled)) normalized.enabled[frameworkId] = defaults.enabled[frameworkId] === true;
  });
  Object.keys(defaults.enabled).forEach((frameworkId) => {
    if (!(frameworkId in normalized.enabled)) normalized.enabled[frameworkId] = defaults.enabled[frameworkId] === true;
  });
  ['task', 'day', 'week', 'project'].forEach((scope) => {
    const raw = String(source.defaults && source.defaults[scope] || '').trim().toLowerCase();
    normalized.defaults[scope] = SERVER_FRAMEWORK_CORE_IDS.has(raw) ? raw : '';
  });
  if (!normalized.defaults.day) normalized.defaults.day = SERVER_FRAMEWORK_DEFAULTS.day;
  if (!normalized.defaults.week) normalized.defaults.week = SERVER_FRAMEWORK_DEFAULTS.week;
  return normalized;
}

// ─── STAGE 289 — Knowledge Recommendation State helpers ───────────────────────

/**
 * Нормализует knowledge_recommendation_state: JSON-объект с ключами role, bundle, primarySystem,
 * wizardInput, savedAt. Возвращает null при невалидных данных.
 * @param {any} raw
 * @returns {object|null}
 */
function normalizeKnowledgeRecommendationState(raw) {
  let parsed = raw;
  if (typeof raw === 'string') {
    try { parsed = JSON.parse(raw); } catch (_) { return null; }
  }
  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return null;
  return {
    role: String(parsed.role || '').trim().toLowerCase() || null,
    bundle: String(parsed.bundle || '').trim().toLowerCase() || null,
    primarySystem: String(parsed.primarySystem || parsed.primary_system || '').trim().toLowerCase() || null,
    wizardInput: (parsed.wizardInput && typeof parsed.wizardInput === 'object') ? parsed.wizardInput : null,
    savedAt: String(parsed.savedAt || parsed.saved_at || '').trim() || null,
  };
}

/**
 * Нормализует knowledge_recommendation_history — JSON array последних N записей.
 * @param {any} raw
 * @param {number} maxEntries
 * @returns {Array}
 */
function normalizeKnowledgeRecommendationHistory(raw, maxEntries = 5) {
  const max = typeof maxEntries === 'number' && maxEntries > 0 ? maxEntries : 5;
  let parsed = raw;
  if (typeof raw === 'string') {
    try { parsed = JSON.parse(raw); } catch (_) { return []; }
  }
  if (!Array.isArray(parsed)) return [];
  return parsed
    .map((entry) => {
      if (!entry || typeof entry !== 'object') return null;
      return {
        role: String(entry.role || '').trim().toLowerCase() || null,
        bundle: String(entry.bundle || '').trim().toLowerCase() || null,
        appliedAt: String(entry.appliedAt || entry.applied_at || '').trim() || null,
      };
    })
    .filter(Boolean)
    .slice(0, max);
}

/**
 * Добавляет новую запись в recommendation history, обрезает до maxEntries.
 * @param {Array} history
 * @param {object} entry
 * @param {number} maxEntries
 * @returns {Array}
 */
function appendKnowledgeRecommendationHistory(history, entry, maxEntries = 5) {
  const max = typeof maxEntries === 'number' && maxEntries > 0 ? maxEntries : 5;
  const current = normalizeKnowledgeRecommendationHistory(history, max);
  const newEntry = {
    role: entry && String(entry.role || '').trim().toLowerCase() || null,
    bundle: entry && String(entry.bundle || '').trim().toLowerCase() || null,
    appliedAt: entry && String(entry.appliedAt || '').trim() || new Date().toISOString(),
  };
  return [newEntry, ...current].slice(0, max);
}

// ─── END STAGE 289 helpers ────────────────────────────────────────────────────

async function getFrameworkSettingsRecord(env, userId) {
  return env.DB.prepare(`SELECT user_id, settings_json, created_at, updated_at, knowledge_recommendation_state, knowledge_last_applied_role, knowledge_last_applied_at, knowledge_recommendation_history FROM framework_user_settings WHERE user_id = ? LIMIT 1`).bind(String(userId)).first();
}

async function getFrameworkSettingsForUser(env, userId) {
  const row = await getFrameworkSettingsRecord(env, userId);
  if (!row || !row.settings_json) {
    return {
      settings: normalizeFrameworkSettingsServer(getDefaultFrameworkSettingsServer()),
      source: FRAMEWORKS_SYNC_SOURCE_DEFAULT,
      createdAt: null,
      updatedAt: null,
      knowledgeRecommendationState: null,
      knowledgeLastAppliedRole: null,
      knowledgeLastAppliedAt: null,
      knowledgeRecommendationHistory: [],
    };
  }
  try {
    return {
      settings: normalizeFrameworkSettingsServer(JSON.parse(String(row.settings_json || '{}'))),
      source: FRAMEWORKS_SYNC_SOURCE_SERVER,
      createdAt: String(row.created_at || ''),
      updatedAt: String(row.updated_at || ''),
      knowledgeRecommendationState: normalizeKnowledgeRecommendationState(row.knowledge_recommendation_state || null),
      knowledgeLastAppliedRole: String(row.knowledge_last_applied_role || '').trim() || null,
      knowledgeLastAppliedAt: String(row.knowledge_last_applied_at || '').trim() || null,
      knowledgeRecommendationHistory: normalizeKnowledgeRecommendationHistory(row.knowledge_recommendation_history || null),
    };
  } catch (error) {
    return {
      settings: normalizeFrameworkSettingsServer(getDefaultFrameworkSettingsServer()),
      source: FRAMEWORKS_SYNC_SOURCE_DEFAULT,
      createdAt: String(row.created_at || ''),
      updatedAt: String(row.updated_at || ''),
      knowledgeRecommendationState: null,
      knowledgeLastAppliedRole: null,
      knowledgeLastAppliedAt: null,
      knowledgeRecommendationHistory: [],
    };
  }
}

async function upsertFrameworkSettingsForUser(env, userId, settings) {
  const normalized = normalizeFrameworkSettingsServer(settings);
  const now = new Date().toISOString();
  const existing = await getFrameworkSettingsRecord(env, userId);

  // STAGE 289 — knowledge recommendation state fields (nullable, независимые от settings_json)
  const src = settings && typeof settings === 'object' ? settings : {};
  const hasKnowledgeRecommendationState = 'knowledgeRecommendationState' in src || 'knowledge_recommendation_state' in src;
  const hasKnowledgeLastAppliedRole = 'knowledgeLastAppliedRole' in src || 'knowledge_last_applied_role' in src;
  const hasKnowledgeLastAppliedAt = 'knowledgeLastAppliedAt' in src || 'knowledge_last_applied_at' in src;
  const hasKnowledgeRecommendationHistory = 'knowledgeRecommendationHistory' in src || 'knowledge_recommendation_history' in src;

  /** @param {string} k */ const _pick = (k, k2) => src[k] !== undefined ? src[k] : (src[k2] !== undefined ? src[k2] : undefined);

  const newRecommState = hasKnowledgeRecommendationState
    ? normalizeKnowledgeRecommendationState(_pick('knowledgeRecommendationState', 'knowledge_recommendation_state'))
    : undefined;
  const newLastAppliedRole = hasKnowledgeLastAppliedRole
    ? (String(_pick('knowledgeLastAppliedRole', 'knowledge_last_applied_role') || '').trim() || null)
    : undefined;
  const newLastAppliedAt = hasKnowledgeLastAppliedAt
    ? (String(_pick('knowledgeLastAppliedAt', 'knowledge_last_applied_at') || '').trim() || null)
    : undefined;
  const newHistory = hasKnowledgeRecommendationHistory
    ? normalizeKnowledgeRecommendationHistory(_pick('knowledgeRecommendationHistory', 'knowledge_recommendation_history'))
    : undefined;

  // Если нужно обновить историю — дочитать текущую и добавить новую запись (если передан appendHistory)
  let historyToSave = newHistory;
  if (src.appendKnowledgeHistory && typeof src.appendKnowledgeHistory === 'object') {
    const currentHistoryRaw = existing ? (existing.knowledge_recommendation_history || null) : null;
    const currentHistory = normalizeKnowledgeRecommendationHistory(currentHistoryRaw);
    historyToSave = appendKnowledgeRecommendationHistory(currentHistory, src.appendKnowledgeHistory);
  }

  if (existing) {
    let updateSql = `UPDATE framework_user_settings SET settings_json = ?, updated_at = ?`;
    const bindArgs = [JSON.stringify(normalized), now];
    if (newRecommState !== undefined) { updateSql += `, knowledge_recommendation_state = ?`; bindArgs.push(newRecommState ? JSON.stringify(newRecommState) : null); }
    if (newLastAppliedRole !== undefined) { updateSql += `, knowledge_last_applied_role = ?`; bindArgs.push(newLastAppliedRole); }
    if (newLastAppliedAt !== undefined) { updateSql += `, knowledge_last_applied_at = ?`; bindArgs.push(newLastAppliedAt); }
    if (historyToSave !== undefined) { updateSql += `, knowledge_recommendation_history = ?`; bindArgs.push(historyToSave.length ? JSON.stringify(historyToSave) : null); }
    updateSql += ` WHERE user_id = ?`;
    bindArgs.push(String(userId));
    await env.DB.prepare(updateSql).bind(...bindArgs).run();
    return {
      settings: normalized,
      createdAt: String(existing.created_at || now),
      updatedAt: now,
      source: FRAMEWORKS_SYNC_SOURCE_SERVER,
      knowledgeRecommendationState: newRecommState !== undefined ? newRecommState : normalizeKnowledgeRecommendationState(existing.knowledge_recommendation_state || null),
      knowledgeLastAppliedRole: newLastAppliedRole !== undefined ? newLastAppliedRole : (String(existing.knowledge_last_applied_role || '').trim() || null),
      knowledgeLastAppliedAt: newLastAppliedAt !== undefined ? newLastAppliedAt : (String(existing.knowledge_last_applied_at || '').trim() || null),
      knowledgeRecommendationHistory: historyToSave !== undefined ? historyToSave : normalizeKnowledgeRecommendationHistory(existing.knowledge_recommendation_history || null),
    };
  }
  await env.DB.prepare(`INSERT INTO framework_user_settings (user_id, settings_json, created_at, updated_at, knowledge_recommendation_state, knowledge_last_applied_role, knowledge_last_applied_at, knowledge_recommendation_history) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`)
    .bind(
      String(userId),
      JSON.stringify(normalized),
      now,
      now,
      newRecommState !== undefined ? (newRecommState ? JSON.stringify(newRecommState) : null) : null,
      newLastAppliedRole !== undefined ? newLastAppliedRole : null,
      newLastAppliedAt !== undefined ? newLastAppliedAt : null,
      historyToSave !== undefined && historyToSave.length ? JSON.stringify(historyToSave) : null,
    ).run();
  return {
    settings: normalized,
    createdAt: now,
    updatedAt: now,
    source: FRAMEWORKS_SYNC_SOURCE_SERVER,
    knowledgeRecommendationState: newRecommState !== undefined ? newRecommState : null,
    knowledgeLastAppliedRole: newLastAppliedRole !== undefined ? newLastAppliedRole : null,
    knowledgeLastAppliedAt: newLastAppliedAt !== undefined ? newLastAppliedAt : null,
    knowledgeRecommendationHistory: historyToSave !== undefined ? historyToSave : [],
  };
}

/**
 * @param {any} value
 */
function normalizeTaskFrameworkAssignmentServer(value = {}) {
  /** @type {any} */
  const source = value && typeof value === 'object' && !Array.isArray(value) ? value : {};
  const primaryFrameworkRaw = String(source['primaryFramework'] || source['primary_framework'] || '').trim().toLowerCase();
  const taskBlockId = String(source['taskBlockId'] || source['task_block_id'] || '').trim();
  const linkModeRaw = String(source['taskBlockLinkMode'] || source['task_block_link_mode'] || source['linkMode'] || source['link_mode'] || '').trim().toLowerCase();
  const dayPatternRaw = String(source['dayPattern'] || source['day_pattern'] || '').trim().toLowerCase();
  const eisenhowerRaw = String(source['eisenhower'] || '').trim().toLowerCase();
  const abcdeRaw = String(source['abcde'] || '').trim().toUpperCase();
  const moscowRaw = String(source['moscow'] || '').trim().toLowerCase();
  const energyRaw = String(source['energy'] || '').trim().toLowerCase();
  const dayPattern = ['big','medium','small'].includes(dayPatternRaw) ? dayPatternRaw : '';
  const eisenhower = ['important_urgent','important_not_urgent','not_important_urgent','not_important_not_urgent'].includes(eisenhowerRaw) ? eisenhowerRaw : '';
  const abcde = ['A','B','C','D','E'].includes(abcdeRaw) ? abcdeRaw : '';
  const moscow = ['must','should','could','wont'].includes(moscowRaw) ? moscowRaw : '';
  const energy = ['high','medium','low'].includes(energyRaw) ? energyRaw : '';
  const normalized = {
    primaryFramework: SERVER_FRAMEWORK_CORE_IDS.has(primaryFrameworkRaw) ? primaryFrameworkRaw : '',
    taskBlockId,
    taskBlockLinkMode: taskBlockId ? (['soft','hard'].includes(linkModeRaw) ? linkModeRaw : 'soft') : '',
    dayPattern,
    eisenhower,
    abcde,
    moscow,
    energy,
    updatedAt: source['updatedAt'] ? String(source['updatedAt']) : new Date().toISOString()
  };
  return normalized;
}

function hasTaskFrameworkAssignmentValue(value = {}) {
  const normalized = normalizeTaskFrameworkAssignmentServer(value);
  return !!(normalized.primaryFramework || normalized.taskBlockId || normalized.dayPattern || normalized.eisenhower || normalized.abcde || normalized.moscow || normalized.energy);
}

async function listFrameworkAssignments(env, userId, scopeType, scopeId) {
  await ensureFrameworksSchema(env);
  let stmt = null;
  if (scopeType && scopeId) {
    stmt = env.DB.prepare(`SELECT id, user_id, framework_code, scope_type, scope_id, value_json, source, created_at, updated_at FROM framework_assignments WHERE user_id = ? AND scope_type = ? AND scope_id = ? ORDER BY updated_at DESC`).bind(String(userId), String(scopeType), String(scopeId));
  } else if (scopeType) {
    stmt = env.DB.prepare(`SELECT id, user_id, framework_code, scope_type, scope_id, value_json, source, created_at, updated_at FROM framework_assignments WHERE user_id = ? AND scope_type = ? ORDER BY updated_at DESC`).bind(String(userId), String(scopeType));
  } else {
    stmt = env.DB.prepare(`SELECT id, user_id, framework_code, scope_type, scope_id, value_json, source, created_at, updated_at FROM framework_assignments WHERE user_id = ? ORDER BY updated_at DESC`).bind(String(userId));
  }
  const result = await stmt.all();
  const rows = Array.isArray(result && result.results) ? result.results : [];
  return rows.map((row) => {
    let parsed = {};
    try { parsed = row && row.value_json ? JSON.parse(String(row.value_json)) : {}; } catch (_) { parsed = {}; }
    const normalizedValue = row && row.scope_type === 'task' ? normalizeTaskFrameworkAssignmentServer(parsed) : parsed;
    return {
      id: String(row.id || ''),
      user_id: String(row.user_id || ''),
      framework_code: String(row.framework_code || ''),
      scope_type: String(row.scope_type || ''),
      scope_id: String(row.scope_id || ''),
      value: normalizedValue,
      value_json: normalizedValue,
      source: row && row.source ? String(row.source) : null,
      created_at: row && row.created_at ? String(row.created_at) : null,
      updated_at: row && row.updated_at ? String(row.updated_at) : null
    };
  });
}

async function upsertFrameworkAssignment(env, userId, scopeType, scopeId, frameworkCode, value, source = FRAMEWORKS_SYNC_SOURCE_SERVER) {
  await ensureFrameworksSchema(env);
  const now = new Date().toISOString();
  const normalizedValue = scopeType === 'task' ? normalizeTaskFrameworkAssignmentServer(value) : (value && typeof value === 'object' ? value : {});
  if (scopeType === 'task') {
    if (normalizedValue.taskBlockId) {
      await upsertTaskTimeBlockLinkForTask(env, userId, scopeId, normalizedValue.taskBlockId, normalizedValue.taskBlockLinkMode || 'soft');
    } else {
      await deleteTaskTimeBlockLinkForTask(env, userId, scopeId);
    }
  }
  const existing = await env.DB.prepare(`SELECT id, created_at FROM framework_assignments WHERE user_id = ? AND scope_type = ? AND scope_id = ? AND framework_code = ? LIMIT 1`).bind(String(userId), String(scopeType), String(scopeId), String(frameworkCode)).first();
  if (existing && existing.id) {
    await env.DB.prepare(`UPDATE framework_assignments SET value_json = ?, source = ?, updated_at = ? WHERE id = ?`).bind(JSON.stringify(normalizedValue), String(source || FRAMEWORKS_SYNC_SOURCE_SERVER), now, String(existing.id)).run();
    return {
      id: String(existing.id), user_id: String(userId), framework_code: String(frameworkCode), scope_type: String(scopeType), scope_id: String(scopeId),
      value: normalizedValue, value_json: normalizedValue, source: String(source || FRAMEWORKS_SYNC_SOURCE_SERVER), created_at: String(existing.created_at || now), updated_at: now
    };
  }
  const id = crypto.randomUUID();
  await env.DB.prepare(`INSERT INTO framework_assignments (id, user_id, framework_code, scope_type, scope_id, value_json, source, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`).bind(id, String(userId), String(frameworkCode), String(scopeType), String(scopeId), JSON.stringify(normalizedValue), String(source || FRAMEWORKS_SYNC_SOURCE_SERVER), now, now).run();
  return { id, user_id: String(userId), framework_code: String(frameworkCode), scope_type: String(scopeType), scope_id: String(scopeId), value: normalizedValue, value_json: normalizedValue, source: String(source || FRAMEWORKS_SYNC_SOURCE_SERVER), created_at: now, updated_at: now };
}

async function deleteFrameworkAssignment(env, userId, scopeType, scopeId, frameworkCode) {
  await ensureFrameworksSchema(env);
  if (scopeType === 'task' && scopeId) await deleteTaskTimeBlockLinkForTask(env, userId, scopeId);
  if (frameworkCode) {
    await env.DB.prepare(`DELETE FROM framework_assignments WHERE user_id = ? AND scope_type = ? AND scope_id = ? AND framework_code = ?`).bind(String(userId), String(scopeType), String(scopeId), String(frameworkCode)).run();
  } else {
    await env.DB.prepare(`DELETE FROM framework_assignments WHERE user_id = ? AND scope_type = ? AND scope_id = ?`).bind(String(userId), String(scopeType), String(scopeId)).run();
  }
  return true;
}

async function handleFrameworkSettingsApi(request, env) {
  const url = new URL(request.url);
  const method = String(request.method || 'GET').toUpperCase();
  const body = method === 'GET' || method === 'HEAD' ? {} : await readJsonBodySafe(request);
  const userId = readRequestUserIdFromUrlBodyOrHeader(url, body, request);
  if (!userId) return buildMissingUserIdJsonResponse('/frameworks/settings');
  await ensureFrameworksSchema(env);
  if (method === 'GET') {
    const result = await getFrameworkSettingsForUser(env, userId);
    return jsonResponse({
      ok: true,
      build: getClientAppBuildLabel(),
      settings: result.settings,
      source: result.source,
      created_at: result.createdAt,
      updated_at: result.updatedAt,
      user_id: String(userId),
      // STAGE 289 — knowledge recommendation state
      knowledge_recommendation_state: result.knowledgeRecommendationState,
      knowledge_last_applied_role: result.knowledgeLastAppliedRole,
      knowledge_last_applied_at: result.knowledgeLastAppliedAt,
      knowledge_recommendation_history: result.knowledgeRecommendationHistory,
    });
  }
  if (method === 'PUT' || method === 'POST') {
    /** @type {any} */
    const payloadSource = body && typeof body === 'object' && !Array.isArray(body) ? body : {};
    /** @type {any} */
    const payload = payloadSource && payloadSource['settings'] && typeof payloadSource['settings'] === 'object' ? payloadSource['settings'] : payloadSource;
    // STAGE 289 — прокидываем knowledge-поля из body в payload для upsert
    const mergedPayload = Object.assign({}, payload);
    if ('knowledgeRecommendationState' in payloadSource) mergedPayload.knowledgeRecommendationState = payloadSource.knowledgeRecommendationState;
    if ('knowledge_recommendation_state' in payloadSource) mergedPayload.knowledge_recommendation_state = payloadSource.knowledge_recommendation_state;
    if ('knowledgeLastAppliedRole' in payloadSource) mergedPayload.knowledgeLastAppliedRole = payloadSource.knowledgeLastAppliedRole;
    if ('knowledge_last_applied_role' in payloadSource) mergedPayload.knowledge_last_applied_role = payloadSource.knowledge_last_applied_role;
    if ('knowledgeLastAppliedAt' in payloadSource) mergedPayload.knowledgeLastAppliedAt = payloadSource.knowledgeLastAppliedAt;
    if ('knowledge_last_applied_at' in payloadSource) mergedPayload.knowledge_last_applied_at = payloadSource.knowledge_last_applied_at;
    if ('knowledgeRecommendationHistory' in payloadSource) mergedPayload.knowledgeRecommendationHistory = payloadSource.knowledgeRecommendationHistory;
    if ('knowledge_recommendation_history' in payloadSource) mergedPayload.knowledge_recommendation_history = payloadSource.knowledge_recommendation_history;
    if ('appendKnowledgeHistory' in payloadSource) mergedPayload.appendKnowledgeHistory = payloadSource.appendKnowledgeHistory;
    const saved = await upsertFrameworkSettingsForUser(env, userId, mergedPayload);
    return jsonResponse({
      ok: true,
      build: getClientAppBuildLabel(),
      settings: saved.settings,
      source: saved.source,
      created_at: saved.createdAt,
      updated_at: saved.updatedAt,
      user_id: String(userId),
      // STAGE 289
      knowledge_recommendation_state: saved.knowledgeRecommendationState,
      knowledge_last_applied_role: saved.knowledgeLastAppliedRole,
      knowledge_last_applied_at: saved.knowledgeLastAppliedAt,
      knowledge_recommendation_history: saved.knowledgeRecommendationHistory,
    });
  }
  return jsonResponse({ ok: false, error: 'Method not allowed', build: getClientAppBuildLabel() }, { status: 405 });
}

async function handleFrameworkAssignmentsApi(request, env) {
  const url = new URL(request.url);
  const method = String(request.method || 'GET').toUpperCase();
  const body = method === 'GET' || method === 'HEAD' ? {} : await readJsonBodySafe(request);
  const userId = readRequestUserIdFromUrlBodyOrHeader(url, body, request);
  if (!userId) return buildMissingUserIdJsonResponse('/frameworks/assignments');
  await ensureFrameworksSchema(env);
  if (method === 'GET') {
    const scopeType = String(url.searchParams.get('scope_type') || body.scope_type || '').trim();
    const scopeId = String(url.searchParams.get('scope_id') || body.scope_id || body.scopeId || '').trim();
    const items = await listFrameworkAssignments(env, userId, scopeType || null, scopeId || null);
    return jsonResponse({ ok: true, build: getClientAppBuildLabel(), items, user_id: String(userId), source: items.length ? FRAMEWORKS_SYNC_SOURCE_SERVER : FRAMEWORKS_SYNC_SOURCE_DEFAULT });
  }
  if (method === 'PUT' || method === 'POST') {
    const scopeType = String(body.scope_type || body.scopeType || '').trim() || 'task';
    const items = Array.isArray(body.items) ? body.items : [];
    const saved = [];
    for (const item of items) {
      const scopeId = String(item && (item.scope_id || item.scopeId) || '').trim();
      if (!scopeId) continue;
      const value = item && (item.value !== undefined ? item.value : item.value_json);
      if (!hasTaskFrameworkAssignmentValue(value || {})) {
        await deleteFrameworkAssignment(env, userId, scopeType, scopeId, String(item && item.framework_code || item && item.frameworkCode || 'task_framework'));
        continue;
      }
      const entry = await upsertFrameworkAssignment(env, userId, scopeType, scopeId, String(item && item.framework_code || item && item.frameworkCode || 'task_framework'), value || {}, FRAMEWORKS_SYNC_SOURCE_SERVER);
      saved.push(entry);
    }
    const itemsAfter = await listFrameworkAssignments(env, userId, scopeType, null);
    return jsonResponse({ ok: true, build: getClientAppBuildLabel(), items: itemsAfter, saved_count: saved.length, user_id: String(userId), source: FRAMEWORKS_SYNC_SOURCE_SERVER });
  }
  return jsonResponse({ ok: false, error: 'Method not allowed', build: getClientAppBuildLabel() }, { status: 405 });
}

async function handleFrameworkAssignmentApi(request, env) {
  const url = new URL(request.url);
  const method = String(request.method || 'GET').toUpperCase();
  const body = method === 'DELETE' || method === 'PUT' || method === 'POST' ? await readJsonBodySafe(request) : {};
  const userId = readRequestUserIdFromUrlBodyOrHeader(url, body, request);
  if (!userId) return buildMissingUserIdJsonResponse('/frameworks/assignment');
  const scopeType = String(body.scope_type || '').trim() || 'task';
  const scopeId = String(body.scope_id || '').trim();
  if (!scopeId) return jsonResponse({ ok: false, error: 'scope_id is required' }, { status: 400 });
  const frameworkCode = String(body.framework_code || 'task_framework').trim() || 'task_framework';
  if (method === 'PUT' || method === 'POST') {
    const value = body.value !== undefined ? body.value : body.value_json;
    if (!hasTaskFrameworkAssignmentValue(value || {})) {
      await deleteFrameworkAssignment(env, userId, scopeType, scopeId, frameworkCode);
      return jsonResponse({ ok: true, build: getClientAppBuildLabel(), deleted: true, scope_id: scopeId });
    }
    const saved = await upsertFrameworkAssignment(env, userId, scopeType, scopeId, frameworkCode, value || {}, FRAMEWORKS_SYNC_SOURCE_SERVER);
    return jsonResponse({ ok: true, build: getClientAppBuildLabel(), item: saved });
  }
  if (method === 'DELETE') {
    await deleteFrameworkAssignment(env, userId, scopeType, scopeId, frameworkCode);
    return jsonResponse({ ok: true, build: getClientAppBuildLabel(), deleted: true, scope_id: scopeId });
  }
  return jsonResponse({ ok: false, error: 'Method not allowed' }, { status: 405 });
}


function parseServerClockToMinutes(value) {
  const raw = String(value || '').trim();
  const parts = raw.split(':');
  if (parts.length < 2) return 0;
  const hours = Math.max(0, Math.min(23, Number(parts[0] || 0)));
  const minutes = Math.max(0, Math.min(59, Number(parts[1] || 0)));
  return (hours * 60) + minutes;
}

function minutesToServerClockLabel(totalMinutes) {
  const normalized = Math.max(0, Number(totalMinutes) || 0);
  const hours = Math.floor(normalized / 60);
  const minutes = normalized % 60;
  return String(hours).padStart(2, '0') + ':' + String(minutes).padStart(2, '0');
}

function formatServerYmd(date) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return year + '-' + month + '-' + day;
}

function getServerWeekdayCode(dayYmd) {
  const date = new Date(String(dayYmd || '') + 'T00:00:00');
  if (Number.isNaN(date.getTime())) return 'MO';
  return ['SU', 'MO', 'TU', 'WE', 'TH', 'FR', 'SA'][date.getDay()] || 'MO';
}

function normalizeServerDayList(value) {
  const allowedDays = ['MO', 'TU', 'WE', 'TH', 'FR', 'SA', 'SU'];
  const source = Array.isArray(value)
    ? value
    : String(value || '').trim()
      ? String(value || '').split(',').map((item) => item.trim())
      : [];
  const normalized = source
    .map((item) => String(item || '').trim().toUpperCase())
    .filter((item) => allowedDays.includes(item));
  return Array.from(new Set(normalized.length ? normalized : ['MO', 'TU', 'WE', 'TH', 'FR']));
}

function normalizeTimeBlockTemplateServer(value = {}) {
  const raw = /** @type {any} */ (value);
  const source = (raw && typeof raw === 'object' && !Array.isArray(raw)) ? raw : /** @type {any} */ ({});
  const title = String(source['title'] || '').trim();
  if (!title) return null;
  let startMinutes = parseServerClockToMinutes(source['startTime'] || source['start_time'] || source['start'] || '09:00');
  let endMinutes = parseServerClockToMinutes(source['endTime'] || source['end_time'] || source['end'] || '10:00');
  if (!(Number.isFinite(startMinutes) && Number.isFinite(endMinutes))) return null;
  if (endMinutes <= startMinutes) endMinutes = Math.min(startMinutes + 60, 24 * 60 - 5);
  const days = normalizeServerDayList(source['days'] || source['days_of_week']);
  const kind = String(source['kind'] || source['task_type_rule'] || 'focus').trim().toLowerCase() || 'focus';
  const capacityMinutes = Math.max(Number(source['capacityMinutes'] || source['capacity_minutes']) || (endMinutes - startMinutes), 0);
  return {
    id: String(source['id'] || ('block_' + Date.now() + '_' + Math.random().toString(16).slice(2))).trim(),
    title,
    startTime: minutesToServerClockLabel(startMinutes),
    endTime: minutesToServerClockLabel(endMinutes),
    startMinutes,
    endMinutes,
    durationMinutes: Math.max(endMinutes - startMinutes, 5),
    kind,
    days,
    color: String(source['color'] || '').trim(),
    energyType: String(source['energyType'] || source['energy_type'] || '').trim().toLowerCase(),
    capacityMinutes,
    bindingModeDefault: String(source['bindingModeDefault'] || source['binding_mode_default'] || 'soft').trim().toLowerCase() || 'soft',
    isActive: source['isActive'] === undefined ? (source['is_active'] === undefined ? 1 : Number(source['is_active']) ? 1 : 0) : (source['isActive'] ? 1 : 0),
    createdAt: String(source['createdAt'] || source['created_at'] || new Date().toISOString()),
    updatedAt: String(source['updatedAt'] || source['updated_at'] || new Date().toISOString())
  };
}

function normalizeTimeBlockInstanceServer(value = {}) {
