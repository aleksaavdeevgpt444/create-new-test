      function evaluateTaskProductQualityFromDraft(draft) {
        var title = String(draft && draft.title || '').trim();
        var product = String(draft && draft.task_product || '').trim();
        var description = String(draft && draft.description || '').trim();
        var normalizedTitle = title.toLowerCase();
        var normalizedProduct = product.toLowerCase();
        var wordCount = normalizedProduct ? normalizedProduct.replaceAll('\\n', ' ').replaceAll('\\t', ' ').split(' ').filter(Boolean).length : 0;
        var sameAsTitle = !!(normalizedProduct && normalizedTitle && normalizedProduct === normalizedTitle);
        var hasResultMarker = /(готов|создан|собран|согласован|запущен|отправлен|опубликован|настроен|заполнен|документ|таблиц|таблица|отчет|отчёт|план|бриф|макет|список|карточк|текст|сценар|схем|релиз|выгрузк|дашборд|презентац|файл|шаблон|чек-?лист|прототип|договор|кп|лендинг|бот|summary|саммари)/i.test(product);
        var hasMeasurement = /([0-9]+|%|шт|мин|час|ссылка|ссылки|до[ ]+[0-9]|не[ ]+(менее|более)|список|таблица|файл|слайды|этап|пункт)/i.test(product);
        var hasOutcomeConnector = /(чтобы|в результате|итогом|на выходе|должен|должна|получить|получен|готовый|готова|готово)/i.test(product);
        var genericLead = /^(сделать|доделать|разобраться|проработать|проверить|подготовить|заняться|улучшить|оформить|написать|создать|обновить|запустить|собрать|настроить|посмотреть|оценить|провести|согласовать)/i.test(product);
        var hasDescriptionSupport = description.length >= 24;

        if (!product) {
          return {
            statusKey: 'empty',
            statusLabel: 'Нет продукта',
            score: 0,
            wordCount: 0,
            sameAsTitle: false,
            hasResultMarker: false,
            hasMeasurement: false,
            hasOutcomeConnector: false,
            hasDescriptionSupport: hasDescriptionSupport
          };
        }

        if (sameAsTitle || wordCount < 2 || product.length < 12 || (genericLead && !hasResultMarker && !hasMeasurement && !hasOutcomeConnector)) {
          return {
            statusKey: 'vague',
            statusLabel: 'Нужно уточнить',
            score: 45,
            wordCount: wordCount,
            sameAsTitle: sameAsTitle,
            hasResultMarker: hasResultMarker,
            hasMeasurement: hasMeasurement,
            hasOutcomeConnector: hasOutcomeConnector,
            hasDescriptionSupport: hasDescriptionSupport
          };
        }

        if ((hasResultMarker && wordCount >= 4) || (hasMeasurement && wordCount >= 3) || (hasOutcomeConnector && hasResultMarker)) {
          return {
            statusKey: 'strong',
            statusLabel: 'Результат понятен',
            score: 100,
            wordCount: wordCount,
            sameAsTitle: sameAsTitle,
            hasResultMarker: hasResultMarker,
            hasMeasurement: hasMeasurement,
            hasOutcomeConnector: hasOutcomeConnector,
            hasDescriptionSupport: hasDescriptionSupport
          };
        }

        return {
          statusKey: 'partial',
          statusLabel: 'В целом понятно',
          score: 75,
          wordCount: wordCount,
          sameAsTitle: sameAsTitle,
          hasResultMarker: hasResultMarker,
          hasMeasurement: hasMeasurement,
          hasOutcomeConnector: hasOutcomeConnector,
          hasDescriptionSupport: hasDescriptionSupport
        };
      }

