    .editor-deepening-row{display:grid;grid-template-columns:minmax(280px,1fr) minmax(320px,1.1fr);gap:12px;margin-top:12px}
    .editor-linked-list,.editor-history-list{display:grid;gap:10px}
    .editor-linked-card,.editor-history-item{border:1px solid var(--line);border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.015));padding:12px 14px}
    .editor-linked-card-title,.editor-history-item-title{font-weight:800;color:var(--text)}
    .editor-linked-card-meta,.editor-history-item-meta{margin-top:6px;font-size:12px;color:var(--muted);display:flex;flex-wrap:wrap;gap:8px}
    .editor-linked-card-note,.editor-history-item-note{margin-top:8px;font-size:13px;line-height:1.45;color:var(--text-soft)}
.editor-risk-summary{display:grid;gap:12px}
    .editor-risk-summary-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px}
    .editor-risk-summary-actions{display:flex;flex-wrap:wrap;gap:8px}
    .editor-risk-summary-list{display:grid;gap:10px}
    .today-risk-digest-card,.plan-risk-digest-card{display:grid;gap:14px}
    .risk-digest-summary-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px}
    .risk-digest-stat{border:1px solid var(--line);border-radius:14px;padding:12px;background:rgba(255,255,255,.03);display:grid;gap:4px}
    .risk-digest-stat.is-warn{border-color:rgba(245,158,11,.35);background:rgba(245,158,11,.08)}
    .risk-digest-stat.is-danger{border-color:rgba(239,68,68,.35);background:rgba(239,68,68,.08)}
    .risk-digest-stat strong{font-size:18px;line-height:1;color:var(--text)}
    .risk-digest-stat span{font-size:12px;color:var(--muted)}
    .risk-digest-task-list{display:grid;gap:10px}
    .risk-digest-task-card{border:1px solid var(--line);border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.015));padding:12px 14px;display:grid;gap:8px}
    .risk-digest-task-card.is-danger{border-color:rgba(239,68,68,.35);background:rgba(239,68,68,.08)}
    .risk-digest-task-card.is-warn{border-color:rgba(245,158,11,.35);background:rgba(245,158,11,.08)}
    .risk-digest-task-title{font-weight:800;color:var(--text)}
    .risk-digest-task-note{font-size:13px;line-height:1.45;color:var(--text-soft)}
    .risk-digest-task-actions{display:flex;flex-wrap:wrap;gap:8px}
    .editor-history-item{position:relative;padding-left:16px}
    .editor-history-item:before{content:'';position:absolute;left:0;top:14px;bottom:14px;width:3px;border-radius:999px;background:linear-gradient(180deg,var(--primary),transparent)}
    .editor-dependency-form{display:grid;gap:8px}
    .editor-linked-section{margin-top:14px;display:grid;gap:10px}
    .editor-empty-note{padding:12px 14px;border:1px dashed var(--line);border-radius:14px;color:var(--muted);font-size:13px;background:rgba(255,255,255,.02)}
    .chip.is-blocked{background:rgba(255,180,80,.14);border-color:rgba(255,180,80,.28);color:#ffd48a}

    .focus-session-shell{display:grid;gap:12px;margin:10px 0 2px;padding:14px 16px;border:1px solid color-mix(in srgb, var(--accent-2) 26%, var(--line));border-radius:18px;background:linear-gradient(180deg,color-mix(in srgb, var(--primary) 12%, rgba(255,255,255,.05)),rgba(255,255,255,.018))}
