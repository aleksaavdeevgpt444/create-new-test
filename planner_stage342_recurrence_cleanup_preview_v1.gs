    .toolbar-primary-block {
      background: linear-gradient(180deg, color-mix(in srgb, var(--accent-color) 14%, rgba(255,255,255,.08)), rgba(255,255,255,.04));
      border-color: color-mix(in srgb, var(--accent-color) 34%, var(--border-color) 66%);
