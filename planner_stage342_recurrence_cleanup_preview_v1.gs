      function parseTelegramTaskNotifyClockMinutes(value, fallbackMinutes) {
        var match = String(value || '').trim().match(/^(\d{2}):(\d{2})$/);
        if (!match) return Number.isFinite(Number(fallbackMinutes)) ? Number(fallbackMinutes) : 0;
        var hours = Math.max(0, Math.min(23, Number(match[1]) || 0));
        var minutes = Math.max(0, Math.min(59, Number(match[2]) || 0));
        return hours * 60 + minutes;
      }

      function getPlannerNowDate() {
        return new Date();
      }

      function getPlannerClockMinutes(date) {
        var current = date instanceof Date ? date : new Date();
        try {
          var formatter = new Intl.DateTimeFormat('en-GB', {
            timeZone: getPlannerTimeZone(),
            hour: '2-digit',
            minute: '2-digit',
            hour12: false
          });
          var parts = formatter.formatToParts(current).reduce(function (acc, part) {
            if (part.type !== 'literal') acc[part.type] = part.value;
            return acc;
          }, {});
          var hours = Number(parts.hour);
          var minutes = Number(parts.minute);
          if (Number.isFinite(hours) && Number.isFinite(minutes)) return hours * 60 + minutes;
        } catch (error) {}
        return current.getHours() * 60 + current.getMinutes();
      }

      function isTelegramTaskNotifyInQuietHours(settings, now) {
        var normalized = normalizeTelegramTaskNotifySettings(settings || state.telegramTaskNotifySettings || getDefaultTelegramTaskNotifySettings());
        if (!normalized.enabled || !normalized.quietHoursEnabled) return false;
        var startMinutes = parseTelegramTaskNotifyClockMinutes(normalized.quietStart, 23 * 60);
        var endMinutes = parseTelegramTaskNotifyClockMinutes(normalized.quietEnd, 8 * 60);
        var currentMinutes = getPlannerClockMinutes(now || getPlannerNowDate());
        if (startMinutes === endMinutes) return true;
        if (startMinutes < endMinutes) return currentMinutes >= startMinutes && currentMinutes < endMinutes;
        return currentMinutes >= startMinutes || currentMinutes < endMinutes;
      }

      function getTelegramTaskNotifyQuietHoursLabel(settings) {
        var normalized = normalizeTelegramTaskNotifySettings(settings || state.telegramTaskNotifySettings || getDefaultTelegramTaskNotifySettings());
