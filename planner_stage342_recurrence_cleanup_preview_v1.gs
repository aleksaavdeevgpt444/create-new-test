      function openProjectDialog(project) {
        var dialog = ensureProjectDialog();
        var item = project || {};
        var normalizedName = String(item.name || '').trim();
        dialog.mode = normalizedName ? 'edit' : 'create';
        dialog.originalName = normalizedName;
        dialog.title.textContent = normalizedName ? 'Проект: ' + normalizedName : 'Новый проект';
        dialog.subtitle.textContent = normalizedName
          ? 'Обнови приоритет, описание, заметки и ссылки проекта. Название оставлено защищённым, чтобы не ломать привязки к задачам.'
          : 'Создай проект как отдельную рабочую сущность. Потом его можно будет выбирать в задачах.';
        dialog.nameInput.value = normalizedName;
        dialog.nameInput.disabled = !!normalizedName;
        dialog.prioritySelect.value = String(item.priority || '').trim();
        dialog.descriptionInput.value = String(item.description || '').trim();
        dialog.notesInput.value = String(item.notes || '').trim();
        var strategyProfile = getProjectStrategyProfile(normalizedName || item.name || '');
        if (dialog.primaryMethodSelect) { dialog.primaryMethodSelect.innerHTML = getStrategicMethodSelectOptionsHtml('Не выбрано'); dialog.primaryMethodSelect.value = strategyProfile.primaryMethod || (normalizedName ? '' : (normalizeStrategicLayerSettings(state.strategicLayerSettings || getDefaultStrategicLayerSettings()).defaults.projectMethod || '')); }
        if (dialog.impactSelect) dialog.impactSelect.value = String(strategyProfile.impact || 0);
        if (dialog.effortSelect) dialog.effortSelect.value = String(strategyProfile.effort || 0);
        if (dialog.reachSelect) dialog.reachSelect.value = String(strategyProfile.reach || 0);
        if (dialog.confidenceSelect) dialog.confidenceSelect.value = String(strategyProfile.confidence || 0);
        if (dialog.moscowSelect) dialog.moscowSelect.value = strategyProfile.moscow || '';
        if (dialog.rollingWaveSelect) dialog.rollingWaveSelect.value = strategyProfile.rollingWave || '';
        if (dialog.objectiveInput) dialog.objectiveInput.value = strategyProfile.objective || '';
        if (dialog.krTitleInput) dialog.krTitleInput.value = strategyProfile.keyResultTitle || '';
        if (dialog.krCurrentInput) dialog.krCurrentInput.value = strategyProfile.keyResultCurrent || '';
        if (dialog.krTargetInput) dialog.krTargetInput.value = strategyProfile.keyResultTarget || '';
        if (dialog.bottleneckInput) dialog.bottleneckInput.value = strategyProfile.bottleneckNote || '';
        if (dialog.cycleGoalInput) dialog.cycleGoalInput.value = strategyProfile.cycleGoal || '';
        if (dialog.quadrant2Input) dialog.quadrant2Input.checked = !!strategyProfile.quadrant2Focus;
        dialog.linksInput.value = String(item.links_text || '').trim();
        bindProjectDialogStrategyReadiness();
        renderProjectDialogStrategyReadiness();
        dialog.backdrop.classList.add('visible');
        setTimeout(function () {
          try {
            (normalizedName ? dialog.descriptionInput : dialog.nameInput).focus();
          } catch (error) {}
        }, 20);
      }

      function closeProjectDialog() {
        if (!(state.projectDialog && state.projectDialog.backdrop)) return;
        state.projectDialog.backdrop.classList.remove('visible');
      }

      async function saveProjectDialog() {
        var dialog = ensureProjectDialog();
        if (!state.userId) {
          showError('Сначала укажи user_id.');
          return;
        }
        var payload = {
          user_id: state.userId,
          name: String(dialog.nameInput.value || '').trim(),
          priority: String(dialog.prioritySelect.value || '').trim(),
          description: String(dialog.descriptionInput.value || '').trim(),
          notes: String(dialog.notesInput.value || '').trim(),
          links_text: String(dialog.linksInput.value || '').trim()
        };
        if (!payload.name) {
          showError('Название проекта не может быть пустым.');
          return;
        }
        showError('');
        try {
          var response = await requestJson('/projects/upsert', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload)
          });
          state.allProjects = response && response.items ? response.items : state.allProjects;
          setProjectStrategyProfile(payload.name, {
            primaryMethod: dialog.primaryMethodSelect ? String(dialog.primaryMethodSelect.value || '').trim().toLowerCase() : '',
            impact: dialog.impactSelect ? Number(dialog.impactSelect.value || 0) : 0,
            effort: dialog.effortSelect ? Number(dialog.effortSelect.value || 0) : 0,
            reach: dialog.reachSelect ? Number(dialog.reachSelect.value || 0) : 0,
            confidence: dialog.confidenceSelect ? Number(dialog.confidenceSelect.value || 0) : 0,
            moscow: dialog.moscowSelect ? String(dialog.moscowSelect.value || '').trim().toLowerCase() : '',
            rollingWave: dialog.rollingWaveSelect ? String(dialog.rollingWaveSelect.value || '').trim().toLowerCase() : '',
            objective: dialog.objectiveInput ? String(dialog.objectiveInput.value || '').trim() : '',
            keyResultTitle: dialog.krTitleInput ? String(dialog.krTitleInput.value || '').trim() : '',
            keyResultCurrent: dialog.krCurrentInput ? Number(dialog.krCurrentInput.value || 0) : 0,
            keyResultTarget: dialog.krTargetInput ? Number(dialog.krTargetInput.value || 0) : 0,
            bottleneckNote: dialog.bottleneckInput ? String(dialog.bottleneckInput.value || '').trim() : '',
            cycleGoal: dialog.cycleGoalInput ? String(dialog.cycleGoalInput.value || '').trim() : '',
            quadrant2Focus: dialog.quadrant2Input ? !!dialog.quadrant2Input.checked : false
          });
          closeProjectDialog();
          populateProjectSelect('createProjectSelect', true);
          populateProjectSelect('editorProjectSelect', true);
          renderProjectsView();
          showSuccess(dialog.mode === 'edit' ? 'Проект обновлён.' : 'Проект создан.');
        } catch (error) {
          showError(String(error && error.message ? error.message : error));
        }
      }

      function getActiveProjectTasks(tasks) {
        return (tasks || []).filter(function (task) {
          var status = normalizeStatus(task.status) || STATUS.NEW;
          return [STATUS.NEW, STATUS.PLANNED, STATUS.POSTPONED].indexOf(status) >= 0 && (!task.due_at || isTaskInActivePeriod(task, 'week'));
        });
      }


      function getWeekStartForYmd(ymd) {
        var date = new Date(String(ymd || formatYmdLocal(new Date())) + 'T00:00:00');
        if (isNaN(date.getTime())) return getCurrentWeekStartYmd();
        var day = date.getDay();
        var diff = day === 0 ? -6 : 1 - day;
        date.setDate(date.getDate() + diff);
        return formatYmdLocal(date);
      }

      function getTodayDate() {
        return new Date((state.dayYmd || formatYmdLocal(new Date())) + 'T00:00:00');
      }

      function getTasksForDay(dayYmd) {
        return getShellTasks().filter(function (task) {
          if (!task || !task.due_at) return false;
          return formatYmdLocal(new Date(task.due_at)) === dayYmd;
        }).sort(compareTasksByDueAndUpdated);
      }

      function getBacklogTasks() {
        return getShellTasks().filter(function (task) {
          var status = normalizeStatus(task.status) || STATUS.NEW;
          return status === STATUS.NEW || status === STATUS.POSTPONED;
        }).sort(compareTasksByDueAndUpdated).slice(0, 20);
      }

      function formatMinutesHoursLabel(totalMinutes) {
        var minutes = Math.max(0, Math.round(Number(totalMinutes) || 0));
        var hours = Math.floor(minutes / 60);
        var rest = minutes % 60;
        if (hours <= 0) return String(rest) + ' мин';
        if (rest === 0) return String(hours) + ' ч';
        return String(hours) + ' ч ' + String(rest) + ' мин';
      }

      function aggregateTaskTimeMetrics(tasks) {
        var relevant = getTasksForActiveSpaceMetrics(tasks).filter(function (task) {
          var status = normalizeStatus(task && task.status);
          return status === STATUS.PLANNED || status === STATUS.DONE;
        });

        var planned = 0;
        var actual = 0;

        relevant.forEach(function (task) {
          planned += Number(getEffectivePlannedMinutesClient(task)) || 0;
          actual += Number(normalizeMinutesInputValue(task && task.actual_minutes)) || 0;
        });

        return {
          count: relevant.length,
          planned: planned,
          actual: actual,
          delta: actual - planned
        };
      }

      function getCurrentWeekTasks() {
        var startYmd = state.weekStart || getCurrentWeekStartYmd();
        var start = new Date(startYmd + 'T00:00:00');
        var end = new Date(start.getTime() + 7 * 86400000);

        return getShellTasks().filter(function (task) {
          if (!task || !task.due_at) return false;
          var due = new Date(task.due_at);
          if (isNaN(due.getTime())) return false;
          return due >= start && due < end;
        }).sort(compareTasksByDueAndUpdated);
      }

      function ensureTodayTimeAnalyticsContainer() {
        var existing = byId('todayTimeAnalytics');
        if (existing) return existing;
        var todayShell = byId('todayView');
        if (!todayShell) return null;
        var anchor = byId('todayDeliverySummary') || byId('todayDashboardStrip') || byId('todayCalendarShell');
        var container = document.createElement('div');
        container.id = 'todayTimeAnalytics';
        container.className = 'time-analytics-grid';
        container.setAttribute('data-view-block-recovered', '1');
        if (anchor && anchor.parentNode) {
          if (anchor.id === 'todayCalendarShell') anchor.parentNode.insertBefore(container, anchor);
          else anchor.parentNode.insertBefore(container, anchor.nextSibling);
        } else {
          todayShell.insertBefore(container, todayShell.firstChild || null);
        }
        return container;
      }

      function renderTodayTimeAnalytics() {
        var container = ensureTodayTimeAnalyticsContainer();
        if (!container) return;
        var isVisible = isViewBlockVisible('today', 'today_time_analytics');
        if (!isVisible) {
          container.innerHTML = '';
          container.style.display = 'none';
          container.setAttribute('data-view-block-hidden', '1');
          return;
        }
        container.style.display = 'grid';
        container.setAttribute('data-view-block-hidden', '0');

        var dayYmd = state.dayYmd || formatYmdLocal(new Date());
        var dayTasks = getTasksForDay(dayYmd);
        var metrics = aggregateTaskTimeMetrics(dayTasks);

        // STAGE 290 — расширенный факт: считаем задачи с зафиксированным actual_minutes
        var doneWithActual = getTasksForActiveSpaceMetrics(dayTasks).filter(function (task) {
          return normalizeStatus(task && task.status) === STATUS.DONE && Number(normalizeMinutesInputValue(task.actual_minutes)) > 0;
        });
        var plannedWithActual = getTasksForActiveSpaceMetrics(dayTasks).filter(function (task) {
          return normalizeStatus(task && task.status) === STATUS.PLANNED && Number(normalizeMinutesInputValue(task.actual_minutes)) > 0;
        });
        var allWithActual = doneWithActual.concat(plannedWithActual);
        var doneCount = getTasksForActiveSpaceMetrics(dayTasks).filter(function (t) { return normalizeStatus(t && t.status) === STATUS.DONE; }).length;
        var deltaLabel = metrics.delta === 0 ? '0' : ((metrics.delta > 0 ? '+' : '−') + formatMinutesHoursLabel(Math.abs(metrics.delta)));
        var deltaTone = metrics.delta > 0 ? 'is-negative' : (metrics.delta < 0 ? 'is-positive' : '');

        container.innerHTML = '';

        // Карточка 1: план
        var cardPlan = document.createElement('div');
        cardPlan.className = 'time-analytics-card';
        var planVal = document.createElement('strong');
        planVal.textContent = formatMinutesHoursLabel(metrics.planned);
        var planLabel = document.createElement('span');
        planLabel.textContent = 'План';
        cardPlan.appendChild(planVal);
        cardPlan.appendChild(planLabel);
        container.appendChild(cardPlan);

        // Карточка 2: факт (actual_minutes)
        var cardActual = document.createElement('div');
        cardActual.className = 'time-analytics-card';
        var actVal = document.createElement('strong');
        actVal.textContent = formatMinutesHoursLabel(metrics.actual);
        var actLabel = document.createElement('span');
        actLabel.textContent = allWithActual.length ? ('Факт · ' + allWithActual.length + ' задач') : 'Факт';
        cardActual.appendChild(actVal);
        cardActual.appendChild(actLabel);
        container.appendChild(cardActual);

        // Карточка 3: разница план/факт
        var cardDelta = document.createElement('div');
        cardDelta.className = 'time-analytics-card' + (deltaTone ? ' ' + deltaTone : '');
        var deltaVal = document.createElement('strong');
        deltaVal.textContent = deltaLabel;
        var deltaSpan = document.createElement('span');
        deltaSpan.textContent = metrics.delta > 0 ? 'Перерасход' : (metrics.delta < 0 ? 'Экономия' : 'Точно в план');
        cardDelta.appendChild(deltaVal);
        cardDelta.appendChild(deltaSpan);
        container.appendChild(cardDelta);

        // Карточка 4: STAGE 290 — выполнено задач
        var cardDone = document.createElement('div');
        cardDone.className = 'time-analytics-card' + (doneCount > 0 ? ' is-positive' : '');
        var doneVal = document.createElement('strong');
        doneVal.textContent = String(doneCount);
        var doneSpan = document.createElement('span');
        doneSpan.textContent = doneWithActual.length ? ('Выполнено · факт у ' + doneWithActual.length) : 'Выполнено задач';
        cardDone.appendChild(doneVal);
        cardDone.appendChild(doneSpan);
        container.appendChild(cardDone);

        // STAGE 290 — список задач с зафиксированным фактом (до 5 шт)
        if (allWithActual.length) {
          var factList = document.createElement('div');
          factList.className = 'time-analytics-fact-list';
          factList.style.cssText = 'grid-column:1/-1; margin-top:4px; display:flex; flex-wrap:wrap; gap:6px;';
          allWithActual.slice(0, 5).forEach(function (task) {
            var chip = document.createElement('div');
            chip.className = 'today-delivery-chip';
            var statusDot = normalizeStatus(task.status) === STATUS.DONE ? '✓ ' : '· ';
            chip.textContent = statusDot + (task.title || 'Без названия').slice(0, 32) + ' — ' + formatMinutesHoursLabel(Number(normalizeMinutesInputValue(task.actual_minutes)));
            chip.style.cursor = 'pointer';
            chip.title = 'Открыть задачу';
            chip.addEventListener('click', function () { openEditor(task.id); });
            factList.appendChild(chip);
          });
          if (allWithActual.length > 5) {
            var moreChip = document.createElement('div');
            moreChip.className = 'today-delivery-chip';
            moreChip.textContent = '+ ещё ' + (allWithActual.length - 5);
            moreChip.style.opacity = '0.6';
            factList.appendChild(moreChip);
          }
          container.appendChild(factList);
        }
      }

      function hideTodayDragPreview() {
        var preview = byId('todayDragPreview');
        if (preview) {
          preview.style.display = 'none';
          clearDragPreviewContent(preview);
        }
        Array.prototype.forEach.call(document.querySelectorAll('.today-drop-slot.range-hover'), function (el) { el.classList.remove('range-hover'); });
      }

      function hideWeekDragPreview() {
        var preview = byId('weekDragPreview');
        if (preview) {
          preview.style.display = 'none';
          clearDragPreviewContent(preview);
        }
        Array.prototype.forEach.call(document.querySelectorAll('.calendar-drop-slot.range-hover'), function (el) { el.classList.remove('range-hover'); });
      }

      function getSharedDragPreviewVisualState(duration, previewWidth) {
        var hourHeightPx = getHourHeightPx();
        var heightPx = (Math.max(Number(duration) || DEFAULT_EVENT_DURATION_MIN, state.gridStepMinutes || 5) / 60) * hourHeightPx;
        var widthPx = Number(previewWidth) || 0;
        return {
          compact: heightPx < 84 && heightPx >= 58,
          ultraCompact: heightPx < 58,
          titleOnly: false,
          narrowCard: widthPx > 0 ? (widthPx < 260 || heightPx < 84) : (heightPx < 84)
        };
      }

      function getSoftCalendarSnapThresholdMinutes(gridStep) {
        var safeStep = Math.max(Number(gridStep) || 15, 5);
        return Math.max(4, Math.min(Math.round(safeStep * 0.45), 12));
      }

      function getCalendarExactMinutesFromClientY(gridRect, clientY) {
        if (!gridRect || !Number.isFinite(clientY)) return null;
        var interactionWindow = getCalendarInteractionWindowHours();
        var totalMinutes = Math.max((interactionWindow.endHour - interactionWindow.startHour) * 60, Math.max(Number(state.gridStepMinutes) || 15, 5));
        var relativeY = Math.max(0, Math.min(gridRect.height, clientY - gridRect.top));
        var ratio = gridRect.height > 0 ? (relativeY / gridRect.height) : 0;
        return interactionWindow.startHour * 60 + ratio * totalMinutes;
      }

      function clampCalendarStartMinutes(minutes, durationMinutes) {
        var interactionWindow = getCalendarInteractionWindowHours();
        var gridStep = Math.max(Number(state.gridStepMinutes) || 15, 5);
        var safeDuration = Math.max(Number(durationMinutes) || DEFAULT_EVENT_DURATION_MIN, gridStep);
        var minStartMinutes = interactionWindow.startHour * 60;
        var maxStartMinutes = interactionWindow.endHour * 60 - safeDuration;
        return Math.max(minStartMinutes, Math.min(maxStartMinutes, minutes));
      }

      function applySoftCalendarSnapMinutes(exactMinutes, gridStep) {
        var safeExact = Number(exactMinutes);
        var safeStep = Math.max(Number(gridStep) || 15, 5);
        if (!Number.isFinite(safeExact)) return null;
        var nearest = Math.round(safeExact / safeStep) * safeStep;
        var delta = nearest - safeExact;
        var threshold = getSoftCalendarSnapThresholdMinutes(safeStep);
        var distance = Math.abs(delta);
        if (distance >= threshold) return safeExact;
        var blend = 1 - (distance / Math.max(threshold, 1));
        return safeExact + delta * blend * blend;
      }

      function resolveCalendarPreviewReferenceMinutesFromClientY(gridRect, clientY, payload) {
        var exactMinutes = getCalendarExactMinutesFromClientY(gridRect, clientY);
        if (!Number.isFinite(exactMinutes)) return null;
        var task = payload && payload.taskId ? findTaskById(payload.taskId) : null;
        var durationMinutes = getPayloadDurationMinutes(payload, task);
        var gridStep = Math.max(Number(state.gridStepMinutes) || 15, 5);
        var softMinutes = applySoftCalendarSnapMinutes(exactMinutes, gridStep);
        if (!Number.isFinite(softMinutes)) softMinutes = exactMinutes;
        return clampCalendarStartMinutes(softMinutes, durationMinutes);
      }

      function getWeekCalendarMagneticDayIndex(relativeX, colWidth, days) {
        if (!(colWidth > 0) || !days || !days.length) return 0;
        var rawIndex = Math.max(0, Math.min(days.length - 1, Math.floor(relativeX / colWidth)));
        var prevTarget = state.calendarDragTarget;
        if (!prevTarget || prevTarget.view !== 'week' || !prevTarget.dayYmd) return rawIndex;

        var prevIndex = -1;
        for (var i = 0; i < days.length; i += 1) {
          if (days[i].ymd === prevTarget.dayYmd) {
            prevIndex = i;
            break;
          }
        }
        if (prevIndex < 0) return rawIndex;

        var magneticInsetPx = Math.min(colWidth * 0.18, 36);
        var currentLeft = prevIndex * colWidth;
        var currentRight = currentLeft + colWidth;
        if (relativeX >= currentLeft - magneticInsetPx && relativeX <= currentRight + magneticInsetPx) {
          return prevIndex;
        }
        return rawIndex;
      }

      function getSharedCalendarPreviewFrame(targetView, dayYmd, duration, timeString, payload, task) {
        var renderWindow = getCalendarRenderWindowHours();
        var totalMinutes = (renderWindow.endHour - renderWindow.startHour) * 60;
        var previewStartMinutes = getAnchoredPreviewStartMinutes(timeString, payload, task, targetView);
        var renderWindow = getCalendarRenderWindowHours();
        var relativeStart = previewStartMinutes - renderWindow.startHour * 60;
        if (relativeStart < 0) relativeStart = 0;

        var frame = {
          display: 'flex',
          top: 'calc(' + ((relativeStart / totalMinutes) * 100) + '% + 2px)',
          height: 'calc(' + (Math.max((duration / totalMinutes) * 100, 3)) + '% - 6px)',
          left: '',
          right: '',
          width: ''
        };

        if (targetView === 'today') {
          frame.left = '8px';
          frame.right = '8px';
          frame.width = 'auto';
          return frame;
        }

        var days = buildVisibleDays('week');
        var dayIndex = -1;
        for (var i = 0; i < days.length; i += 1) {
          if (days[i].ymd === dayYmd) {
            dayIndex = i;
            break;
          }
        }
        if (dayIndex < 0) return null;

        var dayWidth = 100 / Math.max(days.length, 1);
        frame.left = 'calc(' + (dayIndex * dayWidth) + '% + 8px)';
        frame.width = 'calc(' + dayWidth + '% - 16px)';
        frame.right = 'auto';
        return frame;
      }

      function applySharedCalendarPreviewFrame(preview, frame) {
        if (!preview || !frame) return;
        preview.style.display = frame.display || 'flex';
        preview.style.top = frame.top || '';
        preview.style.height = frame.height || '';
        preview.style.left = frame.left || '';
        preview.style.right = frame.right || '';
        preview.style.width = frame.width || '';
      }

      function applySharedCalendarRangeHover(targetView, dayYmd, timeString, duration, payload, task) {
        var selector = targetView === 'today' ? '.today-drop-slot' : '.calendar-drop-slot';
        var dayKeyAttr = 'data-day-ymd="' + dayYmd + '"';
        Array.prototype.forEach.call(document.querySelectorAll(selector + '.range-hover'), function (el) {
          el.classList.remove('range-hover');
        });

        if (isCalendarDragPayload(payload)) return;

        var startMinutes = getAnchoredPreviewStartMinutes(timeString, payload, task, targetView);
        var totalDuration = Math.max(Number(duration) || DEFAULT_EVENT_DURATION_MIN, Number(state.gridStepMinutes) || 15);
        var gridStep = Math.max(Number(state.gridStepMinutes) || 15, 5);
        var endMinutes = startMinutes + totalDuration;

        Array.prototype.forEach.call(document.querySelectorAll(selector + '[' + dayKeyAttr + ']'), function (slot) {
          var slotTime = slot.dataset.time || '';
          if (!slotTime) return;
          var slotMinutes = parseClockToMinutes(slotTime);
          if (slotMinutes >= startMinutes && slotMinutes < endMinutes) {
            slot.classList.add('range-hover');
          }
        });
      }

      function showSharedCalendarDragPreview(targetView, dayYmd, timeString, payloadOrTaskId) {
        var preview = byId(targetView === 'today' ? 'todayDragPreview' : 'weekDragPreview');
        if (!preview) return;
        var payload = payloadOrTaskId && typeof payloadOrTaskId === 'object' ? payloadOrTaskId : null;
        var taskId = payload && payload.taskId ? payload.taskId : payloadOrTaskId;
        var task = findTaskById(taskId);
        if (!task) return;

        var duration = getPayloadDurationMinutes(payload, task);
        var frame = getSharedCalendarPreviewFrame(targetView, dayYmd, duration, timeString, payload, task);
        if (!frame) return;

        applySharedCalendarPreviewFrame(preview, frame);
        var sharedVisual = getSharedDragPreviewVisualState(duration, preview.getBoundingClientRect().width);
        fillDragPreviewContent(preview, task, buildAnchoredPreviewTimeString(timeString, payload, task, targetView), duration, sharedVisual, payload);
        applySharedCalendarRangeHover(targetView, dayYmd, timeString, duration, payload, task);
      }

      function getDragAnchorOffsetMinutes(payload) {
        var raw = Number(payload && payload.anchorOffsetMinutes);
        return Number.isFinite(raw) ? Math.max(0, raw) : 0;
      }

      function shouldUseExactSlotStart(targetView, payload) {
        if (payload && payload.ignoreAnchorOffset) return true;
        if (!payload) return true;
        if (payload.source === 'queue' || payload.source === 'list' || payload.source === 'backlog') return true;
        if (payload.source === 'today' || payload.source === 'week' || payload.source === 'calendar') return false;
        return targetView === 'today';
      }

      function getAnchoredPreviewStartMinutes(timeString, payload, task, targetView) {
        var previewReferenceMinutes = Number(payload && payload.previewReferenceMinutes);
        var slotStartMinutes = Number.isFinite(previewReferenceMinutes) ? previewReferenceMinutes : parseClockToMinutes(timeString);
        var durationMinutes = getPayloadDurationMinutes(payload, task);
        var gridStep = Math.max(Number(state.gridStepMinutes) || 15, 5);
        var adjustedMinutes = slotStartMinutes;
        if (!shouldUseExactSlotStart(targetView, payload)) {
          var anchorOffsetMinutes = getDragAnchorOffsetMinutes(payload);
          adjustedMinutes = slotStartMinutes - anchorOffsetMinutes;
        }
        if (payload && payload.previewSoftSnap) {
          var softMinutes = applySoftCalendarSnapMinutes(adjustedMinutes, gridStep);
          if (Number.isFinite(softMinutes)) adjustedMinutes = softMinutes;
          return clampCalendarStartMinutes(adjustedMinutes, durationMinutes);
        }
        adjustedMinutes = Math.round(adjustedMinutes / gridStep) * gridStep;
        return clampCalendarStartMinutes(adjustedMinutes, durationMinutes);
      }

      function buildAnchoredPreviewTimeString(timeString, payload, task, targetView) {
        return minutesToClockLabel(getAnchoredPreviewStartMinutes(timeString, payload, task, targetView));
      }

      function isCalendarDragPayload(payload) {
        return !!(payload && payload.taskId && (payload.source === 'today' || payload.source === 'week' || payload.source === 'calendar'));
      }

      function isSchedulableTaskDragPayload(payload) {
        return !!(payload && payload.taskId && (
          payload.source === 'queue' ||
          payload.source === 'list' ||
          payload.source === 'backlog' ||
          payload.source === 'today' ||
          payload.source === 'week' ||
          payload.source === 'calendar'
        ));
      }

      function resolveCalendarTimeStringFromClientY(gridRect, clientY) {
        var exactMinutes = getCalendarExactMinutesFromClientY(gridRect, clientY);
        if (!Number.isFinite(exactMinutes)) return null;
        var gridStep = Math.max(Number(state.gridStepMinutes) || 30, 5);
        var snappedMinutes = Math.round(exactMinutes / gridStep) * gridStep;
        snappedMinutes = clampCalendarStartMinutes(snappedMinutes, gridStep);
        return minutesToClockLabel(snappedMinutes);
      }

      function resolveTodayCalendarDragTarget(clientX, clientY, payload, useSoftPreview) {
        var grid = byId('todayGrid');
        if (!grid) return null;
        var rect = grid.getBoundingClientRect();
        if (clientX < rect.left || clientX > rect.right || clientY < rect.top || clientY > rect.bottom) return null;
        var previewMinutes = useSoftPreview ? resolveCalendarPreviewReferenceMinutesFromClientY(rect, clientY, payload) : null;
        var dropTime = resolveCalendarTimeStringFromClientY(rect, clientY);
        return {
          view: 'today',
          dayYmd: state.dayYmd || formatYmdLocal(new Date()),
          time: Number.isFinite(previewMinutes) ? minutesToClockLabel(Math.round(previewMinutes)) : dropTime,
          previewReferenceMinutes: Number.isFinite(previewMinutes) ? previewMinutes : null,
          dropTime: dropTime
        };
      }

      function resolveWeekCalendarDragTarget(clientX, clientY, payload, useSoftPreview) {
        var grid = byId('calendarGrid');
        if (!grid) return null;
        var rect = grid.getBoundingClientRect();
        if (clientX < rect.left || clientX > rect.right || clientY < rect.top || clientY > rect.bottom) return null;

        var days = buildVisibleDays('week');
        if (!days.length) return null;
        var colWidth = rect.width / days.length;
        if (!(colWidth > 0)) return null;
        var relativeX = Math.max(0, Math.min(rect.width - 1, clientX - rect.left));
        var dayIndex = getWeekCalendarMagneticDayIndex(relativeX, colWidth, days);
        var previewMinutes = useSoftPreview ? resolveCalendarPreviewReferenceMinutesFromClientY(rect, clientY, payload) : null;
        var dropTime = resolveCalendarTimeStringFromClientY(rect, clientY);

        return {
          view: 'week',
          dayYmd: days[dayIndex].ymd,
          time: Number.isFinite(previewMinutes) ? minutesToClockLabel(Math.round(previewMinutes)) : dropTime,
          previewReferenceMinutes: Number.isFinite(previewMinutes) ? previewMinutes : null,
          dropTime: dropTime
        };
      }

      function resolveActiveCalendarDragTarget(clientX, clientY, payload, useSoftPreview) {
        var todaySection = byId('todayView');
        var weekSection = byId('plannerView');
        var todayActive = !!(todaySection && todaySection.classList.contains('active'));
        var weekActive = !!(weekSection && weekSection.classList.contains('active'));

        if (todayActive) return resolveTodayCalendarDragTarget(clientX, clientY, payload, useSoftPreview);
        if (weekActive) return resolveWeekCalendarDragTarget(clientX, clientY, payload, useSoftPreview);

        return resolveTodayCalendarDragTarget(clientX, clientY, payload, useSoftPreview) || resolveWeekCalendarDragTarget(clientX, clientY, payload, useSoftPreview);
      }

      function showCalendarDragPreviewForTarget(target, payload) {
        if (!target) return;
        var previewPayload = Object.assign({}, payload || {}, {
          previewSoftSnap: true,
          previewReferenceMinutes: Number.isFinite(Number(target.previewReferenceMinutes)) ? Number(target.previewReferenceMinutes) : null
        });
        if (target.view === 'today') {
          showTodayDragPreview(target.dayYmd, target.time, previewPayload);
          hideWeekDragPreview();
        } else {
          showWeekDragPreview(target.dayYmd, target.time, previewPayload);
          hideTodayDragPreview();
        }
      }

      function handleGlobalCalendarDragOver(event) {
        var payload = getDragPayload(event);
        if (!isSchedulableTaskDragPayload(payload)) return;

        var target = resolveActiveCalendarDragTarget(event.clientX, event.clientY, payload, true);
        if (!target || !target.time) {
          state.calendarDragTarget = null;
          hideTodayDragPreview();
          hideWeekDragPreview();
          return;
        }

        state.calendarDragTarget = target;
        event.preventDefault();
        showCalendarDragPreviewForTarget(target, payload);
      }

      function handleGlobalCalendarDrop(event) {
        var payload = getDragPayload(event);
        if (!isSchedulableTaskDragPayload(payload)) return;

        var target = state.calendarDragTarget || resolveActiveCalendarDragTarget(event.clientX, event.clientY, payload, true);
        state.calendarDragTarget = null;
        hideTodayDragPreview();
        hideWeekDragPreview();

        if (!target || !target.time) return;
        event.preventDefault();
        dropTaskToSlot(payload.taskId, target.dayYmd, target.dropTime || target.time, Object.assign({}, payload || {}, {
          targetView: target.view
        }));
      }

      function handleCalendarSlotDragOver(event, targetView) {
        var payload = getDragPayload(event);
        if (!isSchedulableTaskDragPayload(payload)) return;
        var slot = event.currentTarget;
        if (!slot) return;
        var dayYmd = slot.dataset.dayYmd;
        var time = slot.dataset.time;
        if (!dayYmd || !time) return;
        event.preventDefault();
        slot.classList.add('drag-over');
        var target = {
          view: targetView,
          dayYmd: dayYmd,
          time: time,
          dropTime: time,
          previewReferenceMinutes: parseClockToMinutes(time)
        };
        state.calendarDragTarget = target;
        showCalendarDragPreviewForTarget(target, payload);
      }

      function handleCalendarSlotDragLeave(event) {
        var slot = event.currentTarget;
        if (!slot) return;
        slot.classList.remove('drag-over');
      }

      function handleCalendarSlotDrop(event, targetView) {
        var payload = getDragPayload(event);
        var slot = event.currentTarget;
        if (slot) slot.classList.remove('drag-over');
        if (!isSchedulableTaskDragPayload(payload) || !slot) return;
        var dayYmd = slot.dataset.dayYmd;
        var time = slot.dataset.time;
        if (!dayYmd || !time) return;
        event.preventDefault();
        state.calendarDragTarget = null;
        hideTodayDragPreview();
        hideWeekDragPreview();
        dropTaskToSlot(payload.taskId, dayYmd, time, Object.assign({}, payload || {}, {
          targetView: targetView
        }));
      }

      function showWeekDragPreview(dayYmd, timeString, payloadOrTaskId) {
        showSharedCalendarDragPreview('week', dayYmd, timeString, payloadOrTaskId);
      }

      function showTodayDragPreview(dayYmd, timeString, payloadOrTaskId) {
        showSharedCalendarDragPreview('today', dayYmd, timeString, payloadOrTaskId);
      }

      function hideTodayHoverPreview() {
        var preview = byId('todayHoverPreview');
        if (preview) preview.style.display = 'none';
      }

      function showTodayHoverPreview(dayYmd, timeString) {
        if (state.dragPayload || state.resizeState || state.moveModeTaskId || isTouchLikeDevice()) return;
        var preview = byId('todayHoverPreview');
        var label = byId('todayHoverPreviewLabel');
        if (!preview || !label) return;
        if (dayYmd !== (state.dayYmd || formatYmdLocal(new Date()))) return;
        var renderWindow = getCalendarRenderWindowHours();
        var totalMinutes = (renderWindow.endHour - renderWindow.startHour) * 60;
        var startMinutes = parseClockToMinutes(timeString);
        var renderWindow = getCalendarRenderWindowHours();
        var relativeStart = startMinutes - renderWindow.startHour * 60;
        if (relativeStart < 0) relativeStart = 0;
        label.textContent = formatSlotHoverLabel(timeString, state.gridStepMinutes);
        preview.style.display = 'block';
        preview.style.top = 'calc(' + ((relativeStart / totalMinutes) * 100) + '% + 2px)';
        preview.style.height = 'calc(' + Math.max((Number(state.gridStepMinutes || 15) / totalMinutes) * 100, 1.4) + '% - 6px)';
        var minimumPreviewHeightPx = getTodayCalendarMinimumCardHeightPx(state.gridStepMinutes || 15);
        preview.style.minHeight = minimumPreviewHeightPx > 0 ? (minimumPreviewHeightPx + 'px') : '';
      }

      function hideWeekHoverPreview() {
        var preview = byId('weekHoverPreview');
        if (preview) preview.style.display = 'none';
      }

      function showWeekHoverPreview(dayYmd, timeString) {
        if (state.dragPayload || state.resizeState || state.moveModeTaskId || isTouchLikeDevice()) return;
        var preview = byId('weekHoverPreview');
        var label = byId('weekHoverPreviewLabel');
        if (!preview || !label) return;
        var days = buildVisibleDays('week');
        var dayIndex = days.findIndex(function (day) { return day.ymd === dayYmd; });
        if (dayIndex < 0) return;
        var renderWindow = getCalendarRenderWindowHours();
        var totalMinutes = (renderWindow.endHour - renderWindow.startHour) * 60;
        var startMinutes = parseClockToMinutes(timeString);
        var renderWindow = getCalendarRenderWindowHours();
        var relativeStart = startMinutes - renderWindow.startHour * 60;
        if (relativeStart < 0) relativeStart = 0;
        var dayWidth = 100 / Math.max(days.length, 1);
        label.textContent = formatSlotHoverLabel(timeString, state.gridStepMinutes);
        preview.style.display = 'block';
        preview.style.left = 'calc(' + (dayIndex * dayWidth) + '% + 8px)';
        preview.style.width = 'calc(' + dayWidth + '% - 16px)';
        preview.style.top = 'calc(' + ((relativeStart / totalMinutes) * 100) + '% + 2px)';
        preview.style.height = 'calc(' + Math.max((Number(state.gridStepMinutes || 15) / totalMinutes) * 100, 1.4) + '% - 6px)';
