        var after = normalizeFrameworkSettings(afterSettings || getDefaultFrameworkSettings());
        var enabled = [];
        var disabled = [];
        FRAMEWORK_CORE_REGISTRY.forEach(function (item) {
          var wasOn = before.enabled && before.enabled[item.id] === true;
          var willBeOn = after.enabled && after.enabled[item.id] === true;
          if (!wasOn && willBeOn) enabled.push(item.id);
          if (wasOn && !willBeOn) disabled.push(item.id);
        });
        return { enabled: enabled, disabled: disabled };
