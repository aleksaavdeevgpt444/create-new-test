      function requestBrowserNotificationPermission() {
        if (!(typeof Notification !== 'undefined' && Notification && typeof Notification.requestPermission === 'function')) return Promise.resolve('unsupported');
        try {
          return Notification.requestPermission();
        } catch (error) {
          return Promise.resolve('denied');
        }
