        if (commandCenter) commandCenter.innerHTML = '';
        if (toggleBtn) {
          toggleBtn.textContent = state.projectsHideInactive === false ? 'Все проекты' : 'Только активные';
          toggleBtn.classList.toggle('btn-secondary', state.projectsHideInactive !== false);
          toggleBtn.classList.toggle('btn-ghost', state.projectsHideInactive === false);
        }

        var filterSettings = getProjectFilterSettings();
        if (searchInput && searchInput.value !== filterSettings.search) searchInput.value = filterSettings.search;
        if (prioritySelect) prioritySelect.value = filterSettings.priority;
        if (focusSelect) focusSelect.value = filterSettings.focus;
        if (sortSelect) sortSelect.value = filterSettings.sort;

        var projectMap = {};
        (state.allProjects || []).forEach(function (project) {
          var key = normalizeProjectName(project && project.name);
          projectMap[key] = {
            name: key,
            meta: project || null,
            tasks: getProjectTasksByName(key)
          };
        });
        getShellTasks().forEach(function (task) {
          var key = normalizeProjectName(task && task.project_name);
          if (!projectMap[key]) projectMap[key] = { name: key, meta: null, tasks: [] };
          projectMap[key].tasks.push(task);
        });

        var allItems = Object.keys(projectMap).map(function (key) {
          var item = projectMap[key];
          var stats = getProjectStats(item.tasks || []);
          return {
            name: item.name,
            meta: item.meta || null,
            tasks: item.tasks || [],
            stats: stats
          };
        });

        var visibleItems = allItems.filter(function (item) {
          if (state.projectsHideInactive !== false && item.stats.activeCount <= 0) return false;
          return projectMatchesProjectsFilters(item, filterSettings);
        }).sort(function (a, b) {
          return compareProjectItems(a, b, filterSettings.sort);
        });

        if (summaryStrip) {
          var overall = {
            projectCount: visibleItems.length,
            activeTasks: visibleItems.reduce(function (sum, item) { return sum + item.stats.activeCount; }, 0),
            today: visibleItems.reduce(function (sum, item) { return sum + item.stats.todayCount; }, 0),
            week: visibleItems.reduce(function (sum, item) { return sum + item.stats.weekCount; }, 0),
            backlog: visibleItems.reduce(function (sum, item) { return sum + item.stats.backlogCount; }, 0),
            overdue: visibleItems.reduce(function (sum, item) { return sum + item.stats.overdueCount; }, 0)
          };
          summaryStrip.appendChild(createProjectsSummaryCard(overall.projectCount, 'Видимых проектов'));
          summaryStrip.appendChild(createProjectsSummaryCard(overall.activeTasks, 'Активных задач'));
          summaryStrip.appendChild(createProjectsSummaryCard(overall.today, 'Today'));
          summaryStrip.appendChild(createProjectsSummaryCard(overall.week, 'Неделя'));
          summaryStrip.appendChild(createProjectsSummaryCard(overall.backlog, 'Backlog'));
          summaryStrip.appendChild(createProjectsSummaryCard(overall.overdue, 'Просрочено'));
        }

        if (commandCenter) {
          var highPriorityProjects = visibleItems.filter(function (item) { return getProjectPriorityRankByValue(item.meta && item.meta.priority) >= 3; });
          var attentionProjects = visibleItems.filter(function (item) { return item.stats.overdueCount > 0 || item.stats.todayCount > 0; });
          var backlogProjects = visibleItems.filter(function (item) { return item.stats.backlogCount > 0; });
          var inactiveProjects = allItems.filter(function (item) { return item.stats.activeCount <= 0; });
          commandCenter.appendChild(createProjectsCommandCard(highPriorityProjects.length, 'Высокий приоритет', 'Проекты, которые нужно держать в фокусе недели и дня.', 'Показать', function () { state.projectsPriorityFilter = 'high'; renderProjectsView(); }));
          commandCenter.appendChild(createProjectsCommandCard(attentionProjects.length, 'Требуют внимания', 'Есть просрочка или задачи на сегодня, которые нельзя потерять.', 'Показать', function () { state.projectsFocus = 'attention'; renderProjectsView(); }));
          commandCenter.appendChild(createProjectsCommandCard(backlogProjects.length, 'Есть backlog', 'Проекты, где задачи ещё не разложены по слотам.', 'Показать', function () { state.projectsFocus = 'backlog'; renderProjectsView(); }));
          commandCenter.appendChild(createProjectsCommandCard(inactiveProjects.length, 'Неактивные', 'Проекты без активных задач. Можно вернуть их в работу или оставить архивным слоем.', state.projectsHideInactive === false ? 'Скрыть' : 'Показать', function () { state.projectsHideInactive = state.projectsHideInactive === false; renderProjectsView(); }));
          renderProjectsStrategicCommandCards(commandCenter, visibleItems);
        }

        if (!visibleItems.length) {
          var empty = document.createElement('div');
          empty.className = 'empty-state';
          empty.textContent = state.projectsHideInactive === false
            ? 'По текущему фильтру проекты не найдены.'
            : 'Нет проектов с активными задачами под текущий фильтр. Переключи режим, сбрось фильтры или создай новый проект.';
          container.appendChild(empty);
          return;
        }

        var activeItems = visibleItems.filter(function (item) { return item.stats.activeCount > 0; });
        var inactiveItems = visibleItems.filter(function (item) { return item.stats.activeCount <= 0; });

        if (activeItems.length) {
          container.appendChild(createProjectsSection('Активные проекты', 'Проекты, в которых сейчас есть живая работа, риски или backlog.', activeItems, { emptyText: 'Активных проектов пока нет.' }));
        }
        if (inactiveItems.length) {
          container.appendChild(createProjectsSection('Неактивные проекты', 'Проекты без активных задач. Здесь удобно хранить подготовленные, завершённые или временно замороженные направления.', inactiveItems, { emptyText: 'Неактивных проектов нет.' }));
        }
      }

      function createBoardSectionShell(title, subtitle) {
        var shell = document.createElement('section');
        shell.className = 'board-section-shell';
        var head = document.createElement('div');
        head.className = 'board-section-head';
        var copy = document.createElement('div');
        var titleNode = document.createElement('div');
        titleNode.className = 'board-section-title';
        titleNode.textContent = title;
        copy.appendChild(titleNode);
        if (subtitle) {
          var subtitleNode = document.createElement('div');
          subtitleNode.className = 'board-section-subtitle';
          subtitleNode.textContent = subtitle;
          copy.appendChild(subtitleNode);
        }
        head.appendChild(copy);
        shell.appendChild(head);
        return shell;
      }

      function getBoardColumnOverviewItems(tasks) {
        var groups = {
          new: [], planned: [], done: [], canceled: [], postponed: []
        };
        (Array.isArray(tasks) ? tasks : []).forEach(function (task) {
          var status = normalizeStatus(task && task.status) || STATUS.NEW;
          if (!groups[status]) groups[status] = [];
          groups[status].push(task);
        });
        return QUEUE_ORDER.map(function (status) {
          var items = groups[status] || [];
          var blocked = items.filter(function (task) { return !!(getTaskDependencyMeta(task).blockedByTask); }).length;
          var overdue = items.filter(function (task) { return isTaskOverdueForWorkspace(task); }).length;
          var scheduled = items.filter(function (task) { return !!(task && task.due_at); }).length;
          var dominantProject = '';
          var projectCounts = Object.create(null);
          items.forEach(function (task) {
            var key = normalizeProjectName(task && task.project_name || '');
            if (!key) return;
            projectCounts[key] = (projectCounts[key] || 0) + 1;
          });
          Object.keys(projectCounts).sort(function (a, b) { return projectCounts[b] - projectCounts[a]; }).slice(0, 1).forEach(function (key) { dominantProject = key; });
          var nextDueTask = items.filter(function (task) { return !!(task && task.due_at); }).sort(compareTasksByDueAndUpdated)[0] || null;
          return {
            status: status,
            label: getStatusLabel(status),
            items: items,
            count: items.length,
            blocked: blocked,
            overdue: overdue,
            scheduled: scheduled,
            backlog: Math.max(items.length - scheduled, 0),
            dominantProject: dominantProject,
            nextDueTask: nextDueTask,
            plannedMinutes: items.reduce(function (sum, task) { return sum + getTaskPlannedMinutesValue(task); }, 0)
          };
        });
      }

      function createBoardInsightCard(config) {
        var card = document.createElement('div');
        card.className = 'board-insight-card';
        if (config.tone) card.classList.add('is-' + config.tone);
        var head = document.createElement('div');
        head.className = 'board-insight-head';
        var title = document.createElement('div');
        title.className = 'board-insight-title';
        title.textContent = config.title;
        var value = document.createElement('div');
        value.className = 'board-insight-value';
        value.textContent = String(config.value || 0);
        head.appendChild(title);
        head.appendChild(value);
        card.appendChild(head);
        if (config.note) {
          var note = document.createElement('div');
          note.className = 'board-insight-note';
          note.textContent = config.note;
          card.appendChild(note);
        }
        if (Array.isArray(config.meta) && config.meta.length) {
          var meta = document.createElement('div');
          meta.className = 'board-insight-meta';
          config.meta.forEach(function (item) {
            if (!item) return;
            var chip = document.createElement('div');
            chip.className = 'board-badge';
            if (item.tone) chip.classList.add('is-' + item.tone);
            chip.textContent = item.label;
            meta.appendChild(chip);
          });
          card.appendChild(meta);
        }
        if (Array.isArray(config.actions) && config.actions.length) {
          var actions = document.createElement('div');
          actions.className = 'board-insight-actions';
          config.actions.forEach(function (action) {
            if (action) actions.appendChild(action);
          });
          card.appendChild(actions);
        }
        return card;
      }

      function renderBoardLaneInsights(tasks) {
        var section = createBoardSectionShell('Контроль колонок', 'Сначала смотри на здоровье самих колонок: где копится блокировка, где просрочка, а где уже пора вытягивать top 3 в Today.');
        var grid = document.createElement('div');
        grid.className = 'board-insight-grid';
        getBoardColumnOverviewItems(tasks).forEach(function (info) {
          var tone = info.overdue > 0 ? 'danger' : (info.blocked > 0 ? 'warn' : '');
          var note = info.count
            ? ('План: ' + formatMinutesHoursLabel(info.plannedMinutes) + ' · ближайшая: ' + (info.nextDueTask ? formatTimeRange(info.nextDueTask.due_at, getTaskDurationMinutes(info.nextDueTask), { withDate: true }) : 'без даты'))
            : 'Колонка пока пустая. Можно использовать её как чистый вход или резерв.';
          var actions = [
            createBoardColumnAction('К колонке', function () { scrollToBoardColumn(info.status); })
          ];
          if (info.items.length) actions.push(createBoardColumnAction('Открыть 1-ю', function () { openFirstBoardTask(info.items); }));
          if (info.status === STATUS.NEW || info.status === STATUS.POSTPONED) {
            actions.push(createBoardColumnAction('В план top 3', function () { pushBoardBacklogToPlanned(info.items, 3); }));
          } else if (info.status === STATUS.PLANNED) {
            actions.push(createBoardColumnAction('В Today top 3', function () { sendBoardTasksToToday(info.items, 3); }));
          }
          grid.appendChild(createBoardInsightCard({
            title: info.label,
            value: info.count,
            tone: tone,
            note: note,
            meta: [
              { label: 'С блокером: ' + info.blocked, tone: info.blocked ? 'warn' : '' },
              { label: 'Просрочено: ' + info.overdue, tone: info.overdue ? 'danger' : '' },
              { label: info.scheduled ? ('С датой: ' + info.scheduled) : ('Backlog: ' + info.backlog), tone: '' },
              info.dominantProject ? { label: 'Проект: ' + info.dominantProject } : null
            ],
            actions: actions
          }));
        });
        section.appendChild(grid);
        return section;
      }

      function getBoardProjectClusters(tasks) {
        var projectMetaMap = getProjectMetaMap();
        var buckets = Object.create(null);
        (Array.isArray(tasks) ? tasks : []).forEach(function (task) {
          var name = normalizeProjectName(task && task.project_name || '');
          if (!name) name = 'Без проекта';
          if (!buckets[name]) buckets[name] = [];
          buckets[name].push(task);
        });
        return Object.keys(buckets).map(function (name) {
          var items = buckets[name].slice().sort(compareTasksByPriorityThenDue);
          var meta = projectMetaMap[name] || null;
          var active = items.filter(function (task) { return isProjectTaskActive(task); });
          var overdue = active.filter(function (task) { return isProjectTaskOverdue(task); });
          var today = active.filter(function (task) { return task && task.due_at && formatYmdLocal(new Date(task.due_at)) === (state.dayYmd || formatYmdLocal(new Date())); });
          var week = active.filter(function (task) {
            var ymd = getTaskWeekDayYmd(task);
            return !!ymd && isTaskInWeekRange(ymd, state.weekStart || getCurrentWeekStartYmd());
          });
          var backlog = active.filter(function (task) { return !task || !task.due_at; });
          return {
            name: name,
            meta: meta,
            items: items,
            activeCount: active.length,
            overdueCount: overdue.length,
            todayCount: today.length,
            weekCount: week.length,
            backlogCount: backlog.length,
            firstTask: items[0] || null,
            note: String((meta && (meta.notes || meta.description)) || '').trim()
          };
        }).sort(function (a, b) {
          if (a.overdueCount !== b.overdueCount) return b.overdueCount - a.overdueCount;
          if (a.activeCount !== b.activeCount) return b.activeCount - a.activeCount;
          return a.name.localeCompare(b.name, 'ru', { sensitivity: 'base' });
        }).slice(0, 8);
      }

      function renderBoardProjectClusters(tasks) {
        var section = createBoardSectionShell('Проектные кластеры доски', 'Отсюда удобно быстро переключать доску в проектный срез, открывать верхнюю задачу и разбирать backlog по направлениям.');
        var grid = document.createElement('div');
        grid.className = 'board-insight-grid';
        getBoardProjectClusters(tasks).forEach(function (cluster) {
          var tone = cluster.overdueCount > 0 ? 'danger' : (cluster.backlogCount > 0 ? 'warn' : '');
          var card = document.createElement('div');
          card.className = 'board-project-cluster-card';
          if (tone) card.classList.add('is-' + tone);
          var head = document.createElement('div');
          head.className = 'board-project-cluster-head';
          var title = document.createElement('div');
          title.className = 'board-project-cluster-title';
          title.textContent = cluster.name;
          var count = document.createElement('div');
          count.className = 'board-project-cluster-count';
          count.textContent = String(cluster.activeCount);
          head.appendChild(title);
          head.appendChild(count);
          card.appendChild(head);
          var note = document.createElement('div');
          note.className = 'board-project-cluster-note';
          note.textContent = cluster.note || (cluster.firstTask ? ('Верхняя задача: ' + String(cluster.firstTask.title || 'Без названия')) : 'В текущем board-срезе проект пуст.');
          card.appendChild(note);
          var meta = document.createElement('div');
          meta.className = 'board-project-cluster-meta';
          [
            { label: 'Сегодня: ' + cluster.todayCount },
            { label: 'Неделя: ' + cluster.weekCount },
            { label: 'Backlog: ' + cluster.backlogCount, tone: cluster.backlogCount ? 'warn' : '' },
            { label: 'Просрочка: ' + cluster.overdueCount, tone: cluster.overdueCount ? 'danger' : '' },
            cluster.meta && cluster.meta.priority ? { label: 'Приоритет проекта: ' + getProjectPriorityLabel(cluster.meta.priority) } : null
          ].forEach(function (item) {
            if (!item) return;
            var chip = document.createElement('div');
            chip.className = 'board-badge';
            if (item.tone) chip.classList.add('is-' + item.tone);
            chip.textContent = item.label;
            meta.appendChild(chip);
          });
          card.appendChild(meta);
          var actions = document.createElement('div');
          actions.className = 'board-project-cluster-actions';
          actions.appendChild(createBoardColumnAction('Фильтр проекта', function () {
            setBoardControlState({ projectFilter: cluster.name });
          }));
          if (cluster.firstTask && cluster.firstTask.id) actions.appendChild(createBoardColumnAction('Открыть 1-ю', function () { openEditor(cluster.firstTask.id); }));
          actions.appendChild(createBoardColumnAction('К проектам', function () {
            setWorkspaceFilters({ project: cluster.name }, { skipRender: true });
            setActiveView('projects');
            renderShellViews();
            showSuccess('Открыт проектный срез по «' + cluster.name + '».');
          }));
          card.appendChild(actions);
          grid.appendChild(card);
        });
        if (!grid.children.length) {
          var empty = document.createElement('div');
          empty.className = 'empty-state';
          empty.textContent = 'В текущем board-срезе пока нет проектных кластеров.';
          section.appendChild(empty);
        } else {
          section.appendChild(grid);
        }
        return section;
      }

      function renderBoardView() {
        var container = byId('boardShell');
        if (!container) return;
        container.innerHTML = '';
        renderBoardToolbarState();
        var tasks = getBoardCurrentTasks();
        renderBoardKanbanControlLayer(tasks);
        renderBoardSummaryStrip(tasks);
        renderBoardCommandCenter(tasks);
        container.appendChild(renderBoardLaneInsights(tasks));
        container.appendChild(renderBoardProjectClusters(tasks));
        var columns = {
          new: [], planned: [], done: [], canceled: [], postponed: []
        };
        tasks.forEach(function (task) {
          var status = normalizeStatus(task.status) || STATUS.NEW;
          if (!columns[status]) columns[status] = [];
          columns[status].push(task);
        });
        var comparator = getBoardComparator(state.boardSort || 'due');
        QUEUE_ORDER.forEach(function (status) {
          var col = document.createElement('div');
          col.className = 'board-column';
          col.setAttribute('data-board-status', status);
          var items = (columns[status] || []).slice().sort(comparator);
          var head = document.createElement('div');
          head.className = 'board-column-head';
          var headTop = document.createElement('div');
          headTop.className = 'board-column-head-top';
          var title = document.createElement('div');
          title.className = 'board-column-title';
          title.textContent = getStatusLabel(status);
          var count = document.createElement('div');
          count.className = 'board-column-count';
          count.textContent = String(items.length);
          headTop.appendChild(title);
          headTop.appendChild(count);
          head.appendChild(headTop);
          var note = document.createElement('div');
          note.className = 'board-column-note';
          var blockedCount = items.filter(function (task) { return !!(getTaskDependencyMeta(task).blockedByTask); }).length;
          var attentionCount = getAttentionTasks(items).length;
          var totalPlanned = items.reduce(function (sum, task) { return sum + getTaskPlannedMinutesValue(task); }, 0);
          note.textContent = 'Сортировка: ' + getBoardSortLabel(state.boardSort || 'due') + ' · внимания: ' + attentionCount + ' · с блокером: ' + blockedCount + ' · план: ' + formatMinutesHoursLabel(totalPlanned);
          head.appendChild(note);
          var actions = document.createElement('div');
          actions.className = 'board-column-actions';
          actions.appendChild(createBoardColumnAction('Открыть первое', function () {
            if (items[0] && items[0].id) openEditor(items[0].id);
          }));
          actions.appendChild(createBoardColumnAction('В Today top 3', function () {
            sendBoardTasksToToday(items, 3);
          }));
          actions.appendChild(createBoardColumnAction('На завтра top 3', function () {
            moveBoardTasksToTomorrow(items, 3);
          }));
          if (status === STATUS.NEW || status === STATUS.POSTPONED) {
            actions.appendChild(createBoardColumnAction('В план top 3', function () {
              pushBoardBacklogToPlanned(items, 3);
            }));
          } else if (status === STATUS.PLANNED) {
            actions.appendChild(createBoardColumnAction('Готово top 3', function () {
              getBoardPrimaryTasks(items, 3).forEach(function (task) { updateTaskStatus(task.id, STATUS.DONE); });
            }));
          }
          head.appendChild(actions);
          col.appendChild(head);
          var listNote = document.createElement('div');
          listNote.className = 'board-column-list-note';
          listNote.textContent = items.length ? 'В колонке ' + items.length + ' задач. Открывай первую или быстро отправляй top 3 в день.' : 'Пока пусто.';
          col.appendChild(listNote);
          var list = document.createElement('div');
          list.className = 'board-list';
          if (!items.length) {
