      }

      function getDayColumnMinPx() {
        var raw = getComputedStyle(document.documentElement).getPropertyValue('--day-col-min') || '134';
        var parsed = parseFloat(String(raw).replace('px', '').trim());
        return Number.isFinite(parsed) ? parsed : 134;
      }

      function syncCalendarGeometry() {
        var panel = byId('calendarPanel');
        var headerTrack = byId('calendarDaysHead');
        var grid = byId('calendarGrid');
        var gridShell = byId('calendarGridShell');
        var headerViewport = byId('calendarHeaderViewport');
        var gridViewport = byId('calendarGridViewport');
        if (!panel || !headerTrack || !grid || !gridShell || !gridViewport || !headerViewport) return;

        var dayMin = getDayColumnMinPx();
        var viewportWidth = Math.max(gridViewport.clientWidth || 0, headerViewport.clientWidth || 0);
        var dayWidth = Math.max(dayMin, Math.floor(viewportWidth / 7) || dayMin);
        var totalWidth = dayWidth * 7;
        var template = 'repeat(7, ' + dayWidth + 'px)';

        panel.style.setProperty('--day-col-width', dayWidth + 'px');
        headerTrack.style.gridTemplateColumns = template;
        headerTrack.style.width = totalWidth + 'px';
        grid.style.gridTemplateColumns = template;
        grid.style.width = totalWidth + 'px';
        gridShell.style.width = totalWidth + 'px';
      }

      function syncCalendarHeaderScroll() {
        var headerViewport = byId('calendarHeaderViewport');
        var gridViewport = byId('calendarGridViewport');
        if (!headerViewport || !gridViewport) return;
        if (Math.abs(headerViewport.scrollLeft - gridViewport.scrollLeft) > 1) {
          headerViewport.scrollLeft = gridViewport.scrollLeft;
        }
      }

      function syncCalendarHeaderScrollbarCompensation() {
        syncCalendarGeometry();
        syncCalendarHeaderScroll();
      }

      function wireCalendarScrollSync() {
        var headerViewport = byId('calendarHeaderViewport');
        var gridViewport = byId('calendarGridViewport');
        if (!headerViewport || !gridViewport || gridViewport.dataset.synced) return;

        var syncing = false;

        function syncFromGrid() {
          if (syncing) return;
          syncing = true;
          headerViewport.scrollLeft = gridViewport.scrollLeft;
          syncing = false;
        }

        function syncFromHeader() {
          if (syncing) return;
          syncing = true;
          gridViewport.scrollLeft = headerViewport.scrollLeft;
          syncing = false;
        }

        gridViewport.addEventListener('scroll', syncFromGrid, { passive: true });
        headerViewport.addEventListener('scroll', syncFromHeader, { passive: true });
        window.addEventListener('resize', function () {
          syncCalendarGeometry();
          syncCalendarHeaderScroll();
        }, { passive: true });

        gridViewport.dataset.synced = '1';
        syncCalendarGeometry();
        syncCalendarHeaderScroll();
      }

      function getPriorityClass(priorityNumber) {
        if (priorityNumber === 3) return 'priority-high';
        if (priorityNumber === 2) return 'priority-medium';
        if (priorityNumber === 1) return 'priority-low';
        return '';
      }

      function createChip(text) {
        var chip = document.createElement('span');
        chip.className = 'meta-chip';
        chip.textContent = text;
        chip.title = text;
        return chip;
      }

      function createStatusPill(status, labelOverride) {
        var pill = document.createElement('span');
        pill.className = 'status-pill ' + getStatusClass(status);
        pill.textContent = labelOverride || getStatusLabel(status);
        return pill;
      }

      function buildWeekDays() {
        return buildVisibleDays();
      }

      function timeFromSlotIndex(slotIndex) {
        var interactionWindow = getCalendarInteractionWindowHours();
        var totalMinutes = interactionWindow.startHour * 60 + slotIndex * state.gridStepMinutes;
        var hours = Math.floor(totalMinutes / 60);
        var minutes = totalMinutes % 60;
        return String(hours).padStart(2, '0') + ':' + String(minutes).padStart(2, '0');
      }

      function parseClockToMinutes(value) {
        var raw = String(value || '').trim();
        var parts = raw.split(':');
        if (parts.length < 2) return 0;
        return Number(parts[0] || 0) * 60 + Number(parts[1] || 0);
      }

      function minutesToClockLabel(totalMinutes) {
        var normalized = Math.max(0, Number(totalMinutes) || 0);
        var hours = Math.floor(normalized / 60);
        var minutes = normalized % 60;
        return String(hours).padStart(2, '0') + ':' + String(minutes).padStart(2, '0');
      }

      function formatSlotHoverLabel(timeString, durationMinutes) {
        var startMinutes = parseClockToMinutes(timeString);
        var safeDuration = Math.max(Number(durationMinutes) || Number(state.gridStepMinutes) || 15, Number(state.gridStepMinutes) || 15);
        var rangeLabel = minutesToClockLabel(startMinutes) + '–' + minutesToClockLabel(startMinutes + safeDuration);
        if (safeDuration <= 0) return rangeLabel;
        return rangeLabel + ' · ' + formatDurationLabel(safeDuration);
      }

      function makeDueAtIso(dayYmd, timeString) {
        var localDate = new Date(dayYmd + 'T' + timeString + ':00');
        if (isNaN(localDate.getTime())) throw new Error('Не удалось собрать дату/время для слота.');
        return localDate.toISOString();
      }

      function normalizeStatus(status) {
        var value = String(status || '').trim().toLowerCase();
        if (value === 'inbox') return STATUS.NEW;
        if (value === 'today') return STATUS.PLANNED;
        if (value === 'planned') return STATUS.PLANNED;
        if (value === STATUS.NEW || value === STATUS.PLANNED || value === STATUS.DONE || value === STATUS.CANCELED || value === STATUS.POSTPONED) return value;
        return value || STATUS.NEW;
      }

      function getScheduleStatusForExistingTask(task) {
        var current = normalizeStatus(task && task.status);
        if (current === STATUS.NEW || current === STATUS.POSTPONED) return STATUS.PLANNED;
        return current || STATUS.PLANNED;
      }

      function getDurationStepMinutes() {
        return Math.max(Number(state.gridStepMinutes) || 5, 5);
      }

      function snapDurationToStep(value) {
        var step = getDurationStepMinutes();
        var parsed = Number(value);
        if (!Number.isFinite(parsed)) return Math.max(step, DEFAULT_EVENT_DURATION_MIN);
        return Math.max(step, Math.round(parsed / step) * step);
      }

      function normalizeMinutesInputValue(value) {
        if (value === null || value === undefined || value === '') return null;
        var parsed = Math.round(Number(value));
        if (!Number.isFinite(parsed) || parsed < 1) return null;
        return Math.min(parsed, 1440);
      }

      function getEffectivePlannedMinutesClient(source) {
        var manual = normalizeMinutesInputValue(source && (source.planned_minutes_manual !== undefined ? source.planned_minutes_manual : source.plannedMinutesManual));
        if (manual !== null) return manual;
        return snapDurationToStep(source && (source.duration_minutes !== undefined ? source.duration_minutes : source.durationMinutes));
      }

      function formatMinutesShort(value) {
        var minutes = normalizeMinutesInputValue(value);
        return minutes === null ? '—' : (String(minutes) + ' мин');
      }

      function isEditorPlannedMinutesManual() {
        var input = byId('editorPlannedMinutesInput');
        return !!(input && input.dataset.mode === 'manual');
      }

      function getEditorPlannedMinutesAutoValue(source) {
        var base = source || state.editorCurrentTaskSnapshot || {};
        var durationSource = byId('editorDurationInput') ? byId('editorDurationInput').value : (base.duration_minutes || base.durationMinutes);
        return getEffectivePlannedMinutesClient({
          planned_minutes_manual: null,
          duration_minutes: durationSource
        });
      }

      function refreshEditorPlannedMinutesField(source) {
        var input = byId('editorPlannedMinutesInput');
        if (!input) return;
        if (isEditorPlannedMinutesManual()) {
          input.classList.remove('is-auto-derived');
          return;
        }
        var autoValue = getEditorPlannedMinutesAutoValue(source);
        input.value = autoValue != null ? String(autoValue) : '';
        input.dataset.mode = 'auto';
        input.classList.add('is-auto-derived');
      }

      function getEditorPlannedMinutesManualValue() {
        var input = byId('editorPlannedMinutesInput');
        if (!input) return null;
        if (!isEditorPlannedMinutesManual()) return null;
        return normalizeMinutesInputValue(input.value);
      }

      function formatMinutesDeltaShort(value) {
        if (value === null || value === undefined || value === '' || !Number.isFinite(Number(value))) return '—';
        var diff = Math.round(Number(value));
        if (diff === 0) return '0 мин';
        return (diff > 0 ? '+' : '−') + String(Math.abs(diff)) + ' мин';
      }

      function getEditorTimeMetricsState(source) {
        var durationInput = byId('editorDurationInput');
        var actualInput = byId('editorActualMinutesInput');
        var duration = normalizeMinutesInputValue(durationInput && durationInput.value);
        if (duration === null) {
          duration = normalizeMinutesInputValue(source && (source.duration_minutes !== undefined ? source.duration_minutes : source.durationMinutes));
        }
        var plannedManual = getEditorPlannedMinutesManualValue();
        var plannedAuto = getEditorPlannedMinutesAutoValue(source);
        var plannedEffective = plannedManual !== null ? plannedManual : plannedAuto;
        var actual = normalizeMinutesInputValue(actualInput && actualInput.value);
        var delta = plannedEffective !== null && actual !== null ? Math.round(actual - plannedEffective) : null;

        var statusKey = 'empty';
        var statusLabel = 'Нет данных';
        var title = 'Пока нет полных данных по времени';
        var summaryNote = 'Заполни план и факт, чтобы увидеть точное отклонение по времени.';

        if (plannedEffective !== null && actual === null) {
          statusKey = 'planned';
          statusLabel = 'В плане';
          title = 'По задаче есть только план';
          summaryNote = plannedManual !== null
            ? 'План зафиксирован вручную. Когда появится факт, здесь сразу покажется отклонение относительно плана.'
            : 'План сейчас считается автоматически из длительности задачи. Когда появится факт, здесь сразу покажется отклонение.';
        } else if (plannedEffective !== null && actual !== null && delta < 0) {
          statusKey = 'under';
          statusLabel = 'Факт меньше плана';
          title = 'На задачу ушло меньше времени, чем было запланировано';
          summaryNote = 'Факт ниже плана на ' + formatMinutesShort(Math.abs(delta)) + '. Проверь, это реальная экономия времени или стоит уточнить план.';
        } else if (plannedEffective !== null && actual !== null && delta > 0) {
          statusKey = 'over';
          statusLabel = 'Факт больше плана';
          title = 'На задачу ушло больше времени, чем было запланировано';
          summaryNote = 'Факт выше плана на ' + formatMinutesShort(delta) + '. Это сигнал пересмотреть длительность, плановое время или декомпозицию задачи.';
        } else if (plannedEffective !== null && actual !== null && delta === 0) {
          statusKey = 'match';
          statusLabel = 'Факт совпадает';
          title = 'План и факт по времени совпадают';
          summaryNote = 'Оценка времени оказалась точной: фактическое время полностью совпало с планом.';
        } else if (actual !== null && plannedEffective === null) {
          statusKey = 'empty';
          statusLabel = 'Нет данных';
          title = 'Факт есть, но плана недостаточно';
          summaryNote = 'Сейчас зафиксирован факт, но у задачи нет опорного планового значения для сравнения.';
        }

        var planSourceLabel = plannedManual !== null ? 'Ручной план' : (plannedEffective !== null ? 'Авто из длительности' : 'План не задан');
        var planSourceShort = plannedManual !== null ? 'ручной' : (plannedEffective !== null ? 'авто' : '—');
        var planCardNote = 'План пока не задан';
        if (plannedManual !== null) {
          planCardNote = 'Ручное значение';
          if (plannedAuto !== null) planCardNote += ' · авто было бы ' + formatMinutesShort(plannedAuto);
        } else if (plannedEffective !== null) {
          planCardNote = 'Авто из длительности ' + formatMinutesShort(duration);
        }

        var deltaCardNote = 'Нет данных для сравнения';
        if (delta !== null) {
          if (delta < 0) deltaCardNote = 'На ' + formatMinutesShort(Math.abs(delta)) + ' меньше плана';
          else if (delta > 0) deltaCardNote = 'На ' + formatMinutesShort(delta) + ' больше плана';
          else deltaCardNote = 'Без отклонения';
        } else if (plannedEffective !== null) {
          deltaCardNote = 'Появится после ввода факта';
        }

        return {
          duration: duration,
          planned_manual: plannedManual,
          planned_auto: plannedAuto,
          planned_effective: plannedEffective,
          actual: actual,
          delta: delta,
          statusKey: statusKey,
          statusLabel: statusLabel,
          title: title,
          summaryNote: summaryNote,
          planSourceLabel: planSourceLabel,
          planSourceShort: planSourceShort,
