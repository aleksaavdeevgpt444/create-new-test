      function buildKnowledgeImplementationPlan(resultValue) {
        var result = resultValue || buildKnowledgeWizardResult(loadKnowledgeWizardInput());
        var bestRole = result.bestRole || null;
        var bestBundle = result.bestBundle || null;
        var frameworks = Array.isArray(result.frameworks) ? result.frameworks.slice() : [];
        var toAdd = Array.isArray(result.toAdd) ? result.toAdd.slice() : [];
        var avoid = Array.isArray(result.avoidFrameworks) ? result.avoidFrameworks.slice() : [];
        var nowItems = [];
        var nextItems = [];
        var laterItems = [];
        nowItems.push('Проверить текущий главный экран: ' + (result.mainScreen || 'Сегодня') + '.');
        if (bestRole) nowItems.push('Применить роль: ' + bestRole.title + '.');
        if (bestBundle) nowItems.push('Включить связку: ' + bestBundle.title + '.');
        if (toAdd.length) nextItems.push('Усилить методики: ' + toAdd.map(getFrameworkTitle).join(', ') + '.');
        else nextItems.push('Не добавлять новые методики: текущая база уже близка к рекомендации.');
        if (frameworks.length) nextItems.push('Использовать как рабочий набор: ' + frameworks.map(getFrameworkTitle).join(', ') + '.');
        laterItems.push('После 3–5 рабочих дней вернуться к wizard и пересобрать режим по фактической нагрузке.');
        if (avoid.length) laterItems.push('Пока не перегружать систему: ' + avoid.map(getFrameworkTitle).join(', ') + '.');
        if (String(result.primarySystem || '').trim()) laterItems.push('Позже проверить, подходит ли primary system: ' + result.primarySystem + '.');
        return { createdAt: new Date().toISOString(), roleId: bestRole ? bestRole.id : '', roleTitle: bestRole ? bestRole.title : '', bundleId: bestBundle ? bestBundle.id : '', bundleTitle: bestBundle ? bestBundle.title : '', mainScreen: result.mainScreen || 'Сегодня', primarySystem: result.primarySystem || '', frameworks: frameworks, toAdd: toAdd, avoid: avoid, nowItems: nowItems, nextItems: nextItems, laterItems: laterItems };
      }

      function loadKnowledgeImplementationPlanHistory() {
        try {
          var raw = localStorage.getItem(KNOWLEDGE_IMPLEMENTATION_PLAN_STORAGE_KEY);
          var parsed = raw ? JSON.parse(raw) : [];
          return Array.isArray(parsed) ? parsed.filter(function (item) { return item && typeof item === 'object'; }).slice(0, 5) : [];
        } catch (error) { return []; }
      }

      function saveKnowledgeImplementationPlanSnapshot(plan) {
        try {
          var history = loadKnowledgeImplementationPlanHistory();
          history.unshift(plan || buildKnowledgeImplementationPlan());
          localStorage.setItem(KNOWLEDGE_IMPLEMENTATION_PLAN_STORAGE_KEY, JSON.stringify(history.slice(0, 5)));
        } catch (error) {}
      }

      function clearKnowledgeImplementationPlanHistory() {
        try { localStorage.removeItem(KNOWLEDGE_IMPLEMENTATION_PLAN_STORAGE_KEY); } catch (error) {}
