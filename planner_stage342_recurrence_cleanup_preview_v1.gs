      function getKnowledgeFrameworkDefaultDiff(beforeSettings, afterSettings) {
        var before = normalizeFrameworkSettings(beforeSettings || getDefaultFrameworkSettings());
        var after = normalizeFrameworkSettings(afterSettings || getDefaultFrameworkSettings());
        var rows = [];
        var labels = { task: 'Задача', day: 'День', week: 'Неделя', project: 'Проект' };
        ['task', 'day', 'week', 'project'].forEach(function (scope) {
          var oldValue = String(before.defaults && before.defaults[scope] || '');
          var newValue = String(after.defaults && after.defaults[scope] || '');
          if (oldValue !== newValue) rows.push({ label: labels[scope] || scope, before: oldValue ? getFrameworkTitle(oldValue) : 'Не выбрано', after: newValue ? getFrameworkTitle(newValue) : 'Не выбрано' });
