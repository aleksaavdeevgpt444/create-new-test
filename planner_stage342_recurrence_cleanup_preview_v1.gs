      function syncRitualTaskPickState(listEl, maxTasks) {
        if (!listEl) return;
        var inputs = Array.prototype.slice.call(listEl.querySelectorAll('input[type="checkbox"]'));
        var selectedCount = inputs.filter(function (input) { return input.checked; }).length;
        inputs.forEach(function (input) {
          var row = input.closest('.ritual-task-pick-item');
          if (row) row.classList.toggle('is-checked', !!input.checked);
          input.disabled = !input.checked && selectedCount >= maxTasks;
        });
      }

      function buildRitualTaskPickItem(task, checked, maxTasks, listEl) {
        var row = document.createElement('label');
        row.className = 'ritual-task-pick-item' + (checked ? ' is-checked' : '');

        var checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.value = task.id;
        checkbox.checked = !!checked;

        var copy = document.createElement('div');
        copy.className = 'ritual-task-pick-copy';

        var title = document.createElement('strong');
        title.className = 'ritual-task-pick-title';
        title.textContent = task.title || 'Без названия';
        copy.appendChild(title);

        var meta = document.createElement('div');
        meta.className = 'ritual-task-pick-meta';
        meta.appendChild(createChip(normalizeProjectName(task.project_name)));
        meta.appendChild(createStatusPill(normalizeStatus(task.status), getStatusSingular(normalizeStatus(task.status))));
        if (task.due_at) meta.appendChild(createChip(formatTimeRange(task.due_at, getTaskDurationMinutes(task), { withDate: false })));
        copy.appendChild(meta);

        checkbox.addEventListener('change', function () {
          syncRitualTaskPickState(listEl, maxTasks);
        });

        row.appendChild(checkbox);
        row.appendChild(copy);
        return row;
      }

      function openDayRitualDialog(dayYmd) {
        var dialog = ensureDayRitualDialog();
        var ritual = loadDayRitual(dayYmd);
        var settings = state.ritualSettings || getDefaultRitualSettings();
        var candidates = getRitualCandidateTasks(dayYmd);

        dialog.backdrop.dataset.dayYmd = dayYmd;
        dialog.energy.value = ritual.energy || '';
        dialog.intention.value = ritual.intention || '';
        dialog.taskPickLabel.textContent = 'Главные задачи (до ' + settings.maxMainTasks + ')';
        dialog.taskPickList.innerHTML = '';

        if (!candidates.length) {
          var empty = document.createElement('div');
          empty.className = 'muted-small';
          empty.textContent = 'Подходящих активных задач на этот день пока нет. Можно сначала накидать задачи в день или выбрать их позже.';
          dialog.taskPickList.appendChild(empty);
        } else {
          candidates.forEach(function (task) {
            var checked = (ritual.topTaskIds || []).includes(task.id);
            dialog.taskPickList.appendChild(buildRitualTaskPickItem(task, checked, settings.maxMainTasks, dialog.taskPickList));
          });
          syncRitualTaskPickState(dialog.taskPickList, settings.maxMainTasks);
        }

        dialog.backdrop.style.display = 'flex';
      }

