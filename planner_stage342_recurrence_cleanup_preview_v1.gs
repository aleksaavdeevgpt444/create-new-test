function loadTaskFrameworkAssignmentsServerSyncUserId() {
  try {
    return String(localStorage.getItem(TASK_FRAMEWORK_ASSIGNMENTS_SERVER_SYNC_KEY) || '').trim();
  } catch (error) {
    return '';
  }
}

function saveTaskFrameworkAssignmentsServerSyncUserId(userId) {
  try {
    if (!userId) {
      localStorage.removeItem(TASK_FRAMEWORK_ASSIGNMENTS_SERVER_SYNC_KEY);
      return;
    }
    localStorage.setItem(TASK_FRAMEWORK_ASSIGNMENTS_SERVER_SYNC_KEY, String(userId));
  } catch (error) {}
}

function buildTaskFrameworkAssignmentsRequestUrl(scopeId) {
  var safeUserId = String(state.userId || '').trim();
  var url = '/frameworks/assignments';
  var params = [];
  if (safeUserId) params.push('user_id=' + encodeURIComponent(safeUserId));
  params.push('scope_type=task');
  if (scopeId) params.push('scope_id=' + encodeURIComponent(String(scopeId)));
  if (params.length) url += '?' + params.join('&');
  return url;
}

function requestTaskFrameworkAssignmentsFromServer(scopeId) {
  if (!state.userId) return Promise.resolve(null);
  return requestJson(buildTaskFrameworkAssignmentsRequestUrl(scopeId), {
    method: 'GET',
    __meta: { requestName: 'task-framework-assignments-get', reportServerErrors: true, reportTransportErrors: false, timeoutMs: 5000 }
  });
}

function applyTaskFrameworkAssignmentsFromServerItems(items, options) {
  var map = Object.create(null);
  (Array.isArray(items) ? items : []).forEach(function (item) {
    var scopeId = String(item && item.scope_id || '').trim();
    if (!scopeId) return;
    map[scopeId] = normalizeTaskFrameworkAssignment(item && item.value_json ? item.value_json : item && item.value ? item.value : item);
  });
  state.taskFrameworkAssignments = map;
  saveStoredTaskFrameworkAssignments();
  if (!(options && options.skipSyncMarker)) saveTaskFrameworkAssignmentsServerSyncUserId(String(state.userId || ''));
  return map;
}

function persistTaskFrameworkAssignmentsBulkToServer(assignmentsMap, options) {
  if (!state.userId) return Promise.resolve(null);
  var items = [];
  Object.keys(assignmentsMap || {}).forEach(function (taskId) {
    var normalized = normalizeTaskFrameworkAssignment(assignmentsMap[taskId]);
    var hasValue = !!(normalized.primaryFramework || normalized.taskBlockId || normalized.dayPattern || normalized.eisenhower || normalized.abcde || normalized.moscow || normalized.energy);
    if (!hasValue) return;
    items.push({
      scope_id: String(taskId),
      framework_code: 'task_framework',
      value: normalized
    });
  });
  return requestJson(buildTaskFrameworkAssignmentsRequestUrl(), {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      user_id: String(state.userId || ''),
      scope_type: 'task',
      items: items
    }),
    __meta: { requestName: 'task-framework-assignments-put-bulk', reportServerErrors: !(options && options.silent) }
  }).then(function (data) {
    saveTaskFrameworkAssignmentsServerSyncUserId(String(state.userId || ''));
    if (data && Array.isArray(data.items)) applyTaskFrameworkAssignmentsFromServerItems(data.items, { skipSyncMarker: true });
    setServerSyncState('taskFrameworkAssignmentsSyncState', { source: 'server', status: 'saved', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'task assignments' });
    return data;
  }).catch(function (error) {
    setServerSyncState('taskFrameworkAssignmentsSyncState', { source: 'fallback', status: 'fallback', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'task assignments' });
    if (!(options && options.silent)) throw error;
    return null;
  });
}

function persistTaskFrameworkAssignmentToServer(taskId, assignment, options) {
  if (!state.userId) return Promise.resolve(null);
  var normalized = normalizeTaskFrameworkAssignment(assignment || {});
  var hasValue = !!(normalized.primaryFramework || normalized.taskBlockId || normalized.dayPattern || normalized.eisenhower || normalized.abcde || normalized.moscow || normalized.energy);
  if (!hasValue) {
    return requestJson('/frameworks/assignment', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ user_id: String(state.userId || ''), scope_type: 'task', scope_id: String(taskId || '') }),
      __meta: { requestName: 'task-framework-assignment-delete', reportServerErrors: !(options && options.silent) }
    }).then(function (data) {
      saveTaskFrameworkAssignmentsServerSyncUserId(String(state.userId || ''));
      setServerSyncState('taskFrameworkAssignmentsSyncState', { source: 'server', status: 'saved', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'task assignments' });
      return data;
    }).catch(function (error) {
      setServerSyncState('taskFrameworkAssignmentsSyncState', { source: 'fallback', status: 'fallback', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'task assignments' });
      if (!(options && options.silent)) throw error;
      return null;
    });
  }
  return requestJson('/frameworks/assignment', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      user_id: String(state.userId || ''),
      scope_type: 'task',
      scope_id: String(taskId || ''),
      framework_code: 'task_framework',
      value: normalized
    }),
    __meta: { requestName: 'task-framework-assignment-put', reportServerErrors: !(options && options.silent) }
  }).then(function (data) {
    saveTaskFrameworkAssignmentsServerSyncUserId(String(state.userId || ''));
    setServerSyncState('taskFrameworkAssignmentsSyncState', { source: 'server', status: 'saved', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'task assignments' });
    return data;
  }).catch(function (error) {
    setServerSyncState('taskFrameworkAssignmentsSyncState', { source: 'fallback', status: 'fallback', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'task assignments' });
    if (!(options && options.silent)) throw error;
    return null;
  });
}

function hydrateTaskFrameworkAssignmentsFromServer() {
  if (!state.userId) return Promise.resolve(null);
  return requestTaskFrameworkAssignmentsFromServer().then(function (data) {
    if (!data) return null;
    var items = Array.isArray(data.items) ? data.items : [];
    if (items.length) {
      applyTaskFrameworkAssignmentsFromServerItems(items);
      setServerSyncState('taskFrameworkAssignmentsSyncState', { source: 'server', status: 'loaded', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'task assignments' });
      return data;
    }
    var localMap = state.taskFrameworkAssignments && typeof state.taskFrameworkAssignments === 'object'
      ? state.taskFrameworkAssignments
      : loadStoredTaskFrameworkAssignments();
    var localKeys = Object.keys(localMap || {});
    var hasMeaningfulLocalChanges = localKeys.length > 0 || loadTaskFrameworkAssignmentsServerSyncUserId() !== String(state.userId || '');
    if (!hasMeaningfulLocalChanges) {
      state.taskFrameworkAssignments = Object.create(null);
      saveStoredTaskFrameworkAssignments();
      saveTaskFrameworkAssignmentsServerSyncUserId(String(state.userId || ''));
      return data;
    }
    return persistTaskFrameworkAssignmentsBulkToServer(localMap, { silent: true }).then(function (saved) {
      if (saved && Array.isArray(saved.items)) {
        applyTaskFrameworkAssignmentsFromServerItems(saved.items, { skipSyncMarker: true });
        saveTaskFrameworkAssignmentsServerSyncUserId(String(state.userId || ''));
        return saved;
      }
      return data;
    });
  }).catch(function () {
    return null;
  });
}

