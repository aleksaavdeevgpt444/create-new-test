          return (b && b.count || 0) - (a && a.count || 0);
        })[0] || null;
        var riskRow = allRows.slice().sort(function (a, b) {
          var aRisk = (a && a.attentionCount || 0) + (a && a.blockedCount || 0);
          var bRisk = (b && b.attentionCount || 0) + (b && b.blockedCount || 0);
          if (bRisk !== aRisk) return bRisk - aRisk;
          return (b && b.plannedMinutes || 0) - (a && a.plannedMinutes || 0);
        })[0] || null;
        var doneRow = allRows.slice().sort(function (a, b) {
          if ((b && b.doneCount || 0) !== (a && a.doneCount || 0)) return (b && b.doneCount || 0) - (a && a.doneCount || 0);
          return (b && b.count || 0) - (a && a.count || 0);
        })[0] || null;
        shell.appendChild(createBoardCommandCard('Проектов в диаграмме: ' + visibleRows.length, 'Weekly / month / quarter срез по проектам без потери стратегического горизонта.', '', [
