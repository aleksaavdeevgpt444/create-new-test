          var syncedAt = sync.syncedAt ? escapeHtml(formatDateTimeDisplay(sync.syncedAt)) : '—';
          var details = sync.details ? ('<div class="knowledge-chip-row" style="margin-top:8px;"><span class="knowledge-chip">' + escapeHtml(sync.details) + '</span></div>') : '';
