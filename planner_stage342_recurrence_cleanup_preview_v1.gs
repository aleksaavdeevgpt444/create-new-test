    return jsonResponse({ ok: true, build: getClientAppBuildLabel(), item: saved, user_id: String(userId), source: FRAMEWORKS_SYNC_SOURCE_SERVER });
  }
  if (method === 'DELETE') {
    const instanceId = String(body.id || body.instance_id || url.searchParams.get('id') || url.searchParams.get('instance_id') || '').trim();
    if (!instanceId) return jsonResponse({ ok: false, error: 'instance_id is required', build: getClientAppBuildLabel() }, { status: 400 });
