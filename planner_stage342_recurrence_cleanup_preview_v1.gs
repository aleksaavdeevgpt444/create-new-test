      function getDefaultReminderSettings() {
        return {
          enabled: true,
          showTodayCenter: true,
          browserNotifications: false,
          defaultLeadMinutes: 15,
          upcomingWindowMinutes: 180
        };
      }

      function normalizeReminderSettings(value) {
        var defaults = getDefaultReminderSettings();
        var normalized = Object.assign({}, defaults);
        if (!value || typeof value !== 'object') return normalized;
        normalized.enabled = value.enabled !== false;
        normalized.showTodayCenter = value.showTodayCenter !== false;
        normalized.browserNotifications = value.browserNotifications === true;
        var lead = Number(value.defaultLeadMinutes);
        if ([0, 5, 10, 15, 30, 60].indexOf(lead) >= 0) normalized.defaultLeadMinutes = lead;
        var upcoming = Number(value.upcomingWindowMinutes);
        if ([60, 120, 180, 360, 720].indexOf(upcoming) >= 0) normalized.upcomingWindowMinutes = upcoming;
        return normalized;
      }

