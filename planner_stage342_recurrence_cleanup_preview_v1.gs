function buildLocalCreateAssist(payload) {
  const title = trimAiText(payload?.title);
  const description = trimAiText(payload?.description);
  const projectName = normalizeAiProjectSuggestion(payload?.project_name, '') || inferProjectSuggestionFromText(payload);
  const transformed = buildLocalTaskResultTransform(payload);
  return {
    title_suggestion: title || transformed.title_result_suggestion,
    project_suggestion: projectName,
    description_suggestion: description,
    product_suggestion: transformed.product_result_suggestion,
    fallback_used: true,
  };
}

async function getAiCreateAssist(env, payload) {
  const title = String(payload?.title || '').trim();
  const description = String(payload?.description || '').trim();
  const projectName = String(payload?.project_name || '').trim();
  const taskProduct = String(payload?.task_product || '').trim();
  const sourceText = [
    title ? 'Название: ' + title : '',
    description ? 'Описание: ' + description : '',
    taskProduct ? 'Текущий продукт: ' + taskProduct : '',
    projectName ? 'Текущий проект: ' + projectName : ''
  ].filter(Boolean).join('\n');
  if (!sourceText) throw new Error('Нужен текст задачи для AI-подсказки');

  const startedAt = Date.now();
  try {
    const semanticHints = await buildAiSemanticHintsText(env, {
      userId: payload?.user_id ? String(payload.user_id) : null,
      taskId: payload?.task_id ? String(payload.task_id) : null,
      text: sourceText,
      label: 'Похожие прошлые задачи по смыслу'
    });

    const prompt = [
      'Нужно помочь заполнить задачу при создании.',
      'Верни только JSON.',
      'Нужно предложить: title_suggestion, project_suggestion, description_suggestion, product_suggestion.',
      'title_suggestion — короткое рабочее название текущего действия.',
      'project_suggestion — осмысленное название проекта или пустая строка, если проект неясен.',
      'description_suggestion — краткое полезное описание без воды.',
      'product_suggestion — конкретный результат задачи после выполнения на 100%, а не процесс.',
      'Не копируй поля друг в друга буквально.',
      '',
      'Данные задачи:',
      sourceText,
      semanticHints ? '\n' + semanticHints : ''
    ].join('\n');
    const schema = {
      type: 'object',
      properties: {
        title_suggestion: { type: 'string' },
        project_suggestion: { type: 'string' },
        description_suggestion: { type: 'string' },
        product_suggestion: { type: 'string' }
      },
      required: ['title_suggestion', 'project_suggestion', 'description_suggestion', 'product_suggestion']
    };

    return await callPlannerJsonWithSchema(env, {
      operation: 'create-ai',
      user_id: payload?.user_id ? String(payload.user_id) : null,
      prompt,
      schema,
      temperature: 0.2,
    });
  } catch (error) {
    if (!isAiSoftFallbackError(error)) throw error;
    const fallback = buildLocalCreateAssist(payload || {});
    const normalized = attachLocalAiFallbackMeta(env, 'create-ai', fallback, error, { startedAt, requestId: 'local-create-ai-' + Date.now() });
    await logAiLocalFallback(env, 'create-ai', payload || {}, error, getAiProviderMeta(normalized), 'AI create assist soft fallback used');
    return normalized;
  }
}

