        renderEditorDependencySummaryPanel(taskId);
        var blockedByTaskId = getTaskBlockedByTaskId(taskId);
        select.innerHTML = '<option value="">Нет блокера</option>';
        state.allTasks.filter(function (item) { return item && item.id && item.id !== taskId; }).sort(compareTasksByDueAndUpdated).forEach(function (item) {
          var option = document.createElement('option');
          option.value = item.id;
          option.textContent = (item.title || 'Без названия') + ' · ' + normalizeProjectName(item.project_name);
