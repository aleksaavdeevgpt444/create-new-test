function buildGeneratedTimeBlockInstance(template, dayYmd) {
  return normalizeTimeBlockInstanceServer({
    id: String(template && template.id || ''),
    template_id: String(template && template.id || ''),
    date_ymd: String(dayYmd || ''),
    title: template && template.title,
    start_time: template && template.startTime,
    end_time: template && template.endTime,
    duration_minutes: template && template.durationMinutes,
    color: template && template.color,
    energy_type: template && template.energyType,
    task_type_rule: template && template.kind,
    capacity_minutes: template && template.capacityMinutes,
    binding_mode: template && template.bindingModeDefault,
    status: 'generated'
  });
}

function buildTimeBlockDayItems(templates, instanceRows, startYmd, endYmd) {
  const items = [];
  const byDateTemplate = Object.create(null);
  (Array.isArray(instanceRows) ? instanceRows : []).forEach((item) => {
    if (!item || !item.dateYmd) return;
    const key = String(item.dateYmd) + '::' + String(item.templateId || item.id || '');
    byDateTemplate[key] = item;
    items.push(item);
  });
  const startDate = new Date(String(startYmd || '') + 'T00:00:00');
  const endDate = new Date(String(endYmd || '') + 'T00:00:00');
  if (Number.isNaN(startDate.getTime()) || Number.isNaN(endDate.getTime())) return items;
  for (let cursor = new Date(startDate); cursor.getTime() <= endDate.getTime(); cursor.setDate(cursor.getDate() + 1)) {
    const dayYmd = formatServerYmd(cursor);
    const weekday = getServerWeekdayCode(dayYmd);
    (Array.isArray(templates) ? templates : []).forEach((template) => {
      if (!template || !Array.isArray(template.days) || !template.days.includes(weekday)) return;
      const key = dayYmd + '::' + String(template.id || '');
      if (byDateTemplate[key]) return;
      items.push(buildGeneratedTimeBlockInstance(template, dayYmd));
    });
  }
  return items.sort((a, b) => {
    const aKey = String(a && a.dateYmd || '') + ' ' + String(a && a.startTime || '');
    const bKey = String(b && b.dateYmd || '') + ' ' + String(b && b.startTime || '');
    return aKey.localeCompare(bKey, 'ru');
  });
}


// ============================================================
// STAGE 334 — Telegram Agent Planning API v1
// ============================================================
function getPlannerTimezone_(env) {
  return getConfiguredTelegramControlTimezone(env);
}

function normalizeAgentYmd_(value, fallbackYmd) {
  const raw = String(value || '').trim();
  if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) return raw;
  return fallbackYmd;
}

function normalizeAgentClock_(value, fallbackClock) {
  const raw = String(value || '').trim();
  if (/^\d{1,2}:\d{2}$/.test(raw)) {
    const parts = raw.split(':');
    const h = Math.max(0, Math.min(23, Number(parts[0] || 0)));
    const m = Math.max(0, Math.min(59, Number(parts[1] || 0)));
    return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');
  }
  return fallbackClock;
}

function getAgentDateRangeForUrgency_(urgency, env) {
  const tz = getPlannerTimezone_(env);
  const today = getTelegramTodayYmd(tz);
  const normalizedUrgency = normalizeTaskUrgency_(urgency);

  // Stage 336: urgency=today means "urgent / nearest practical slot",
  // not a hard limit to the current calendar day. If a task is created late
  // or today is already full, the agent must be able to offer tomorrow.
  if (normalizedUrgency === 'today') return { from: today, to: addDaysToServerYmd(today, 1) };
  if (normalizedUrgency === 'next_3_days') return { from: today, to: addDaysToServerYmd(today, 3) };
  if (normalizedUrgency === 'next_7_days') return { from: today, to: addDaysToServerYmd(today, 7) };
  if (normalizedUrgency === 'next_14_days') return { from: today, to: addDaysToServerYmd(today, 14) };
  if (normalizedUrgency === 'later_14_days') return { from: addDaysToServerYmd(today, 15), to: addDaysToServerYmd(today, 30) };

  return { from: today, to: addDaysToServerYmd(today, 7) };
}

function normalizeAgentDateRange_(params, env) {
  const urgency = normalizeTaskUrgency_(params && params.urgency);
  const fallback = getAgentDateRangeForUrgency_(urgency, env);
  let from = normalizeAgentYmd_(params && (params.from || params.from_date || params.start_date), fallback.from);
  let to = normalizeAgentYmd_(params && (params.to || params.to_date || params.end_date), fallback.to);
  if (to < from) to = from;
  return { from, to, urgency };
}

function agentClockToMinutes_(clock) {
  return parseServerClockToMinutes(clock);
}

function agentMinutesToClock_(minutes) {
  return minutesToServerClockLabel(Math.max(0, Math.min(24 * 60, Number(minutes) || 0)));
}

function agentIsoToYmd_(iso, env) {
  if (!iso) return '';
  try {
    const tz = getPlannerTimezone_(env);
    const parts = getTelegramTimeZoneDateParts(new Date(iso), tz);
    return `${String(parts.year).padStart(4, '0')}-${String(parts.month).padStart(2, '0')}-${String(parts.day).padStart(2, '0')}`;
  } catch (error) {
    return String(iso || '').slice(0, 10);
  }
}

function agentIsoToClock_(iso, env) {
  if (!iso) return '';
  try {
    const tz = getPlannerTimezone_(env);
    const parts = getTelegramTimeZoneDateParts(new Date(iso), tz);
    return String(parts.hour).padStart(2, '0') + ':' + String(parts.minute).padStart(2, '0');
  } catch (error) {
    return String(iso || '').slice(11, 16);
  }
}

function agentDateTimeToIso_(dateYmd, clock, env) {
  const normalizedClock = normalizeAgentClock_(clock, '09:00');
  const parts = normalizedClock.split(':');
  return zonedDateTimeToUtcIso(dateYmd, Number(parts[0] || 0), Number(parts[1] || 0), getPlannerTimezone_(env));
}

function inferAgentTaskTypesFromBlock_(block) {
  const rawList = [];
  if (block && Array.isArray(block.allowed_task_types)) rawList.push(...block.allowed_task_types);
  ['kind', 'task_type_rule', 'taskTypeRule', 'energyType', 'energy_type'].forEach((key) => {
    const raw = block && block[key] != null ? String(block[key]) : '';
    raw.split(/[;,|]/).forEach((part) => { if (String(part || '').trim()) rawList.push(part); });
  });
  const title = String(block && block.title || '').toLowerCase();
  if (!rawList.length) {
    if (/wb|wildberries|артикул|реклам/.test(title)) rawList.push('wb_ops', 'analytics');
    else if (/аналит|анализ/.test(title)) rawList.push('analytics');
    else if (/координац|коммуникац|созвон|звон/.test(title)) rawList.push('coordination');
    else if (/код|разработ|dev|development/.test(title)) rawList.push('development');
    else if (/финанс|документ/.test(title)) rawList.push('finance_docs');
    else if (/хаб|inbox|входящ/.test(title)) rawList.push('inbox_review');
    else if (/личн/.test(title)) rawList.push('personal');
    else if (/встреч/.test(title)) rawList.push('meeting');
    else rawList.push('focus', 'development', 'analytics');
  }
  return Array.from(new Set(rawList.map(normalizeTaskType_)));
}

function mapPlanningBlockForAgent_(item, space) {
  if (!item || !item.dateYmd || !item.startTime || !item.endTime) return null;
  const date = String(item.dateYmd);
  const start = normalizeAgentClock_(item.startTime, '09:00');
  const end = normalizeAgentClock_(item.endTime, '10:00');
  const startMin = agentClockToMinutes_(start);
  const endMin = agentClockToMinutes_(end);
  if (endMin <= startMin) return null;
  const allowed = inferAgentTaskTypesFromBlock_(item);
  const normalizedSpace = normalizeAgentSpaceKey_(item.spaceKey || item.space_key || space || 'work');
  return {
    id: date + '_' + String(item.id || item.templateId || ('block_' + start.replace(':', ''))),
    original_block_id: String(item.id || ''),
    title: String(item.title || 'Блок планирования'),
    date,
    start_time: start,
    end_time: end,
    duration_min: endMin - startMin,
    space: normalizedSpace === 'all' ? normalizeTaskSpaceKey(space || 'work') : normalizedSpace,
    allowed_task_types: allowed,
    allowed_projects: [],
    importance_preference: 'medium',
    is_flexible: String(item.bindingMode || item.binding_mode || '').toLowerCase() !== 'fixed',
    can_be_overbooked: false,
    can_split_tasks: false,
    color: String(item.color || ''),
    description: String(item.notes || ''),
    source: item.status === 'generated' ? 'template' : 'instance'
  };
}

async function getPlanningBlocksForAgent_(env, userId, fromDate, toDate, space) {
  if (!env || !env.DB) return [];
  await ensureFrameworksSchema(env);
  const normalizedSpace = normalizeAgentSpaceKey_(space || 'work');
  const templates = await listTimeBlockTemplatesForUser(env, userId);
  const instances = await listTimeBlockInstancesForUserRange(env, userId, fromDate, toDate);
  const items = buildTimeBlockDayItems(templates, instances, fromDate, toDate);
  return (items || [])
    .map((item) => mapPlanningBlockForAgent_(item, normalizedSpace))
    .filter((block) => block && (normalizedSpace === 'all' || block.space === normalizedSpace));
}

function getAgentTaskImportanceRank_(importance) {
  const normalized = normalizeTaskImportance_(importance);
  if (normalized === 'high') return 3;
  if (normalized === 'medium') return 2;
  return 1;
}

function mapScheduledTaskForAgent_(row, env) {
  if (!row || !row.due_at) return null;
  const date = agentIsoToYmd_(row.due_at, env);
  const start = agentIsoToClock_(row.due_at, env);
  const duration = normalizeEstimatedMinutes_(row.duration_minutes || row.planned_minutes_manual || 30) || 30;
  const end = agentMinutesToClock_(agentClockToMinutes_(start) + duration);
  const taskType = getTaskTypeForAgent_(row);
  const importance = normalizeTaskImportanceFromTask_(row);
  const status = normalizeStatus(row.status) || String(row.status || 'planned');
  const isDone = status === TASK_STATUSES.DONE;
  const isMeeting = taskType === 'meeting';
  const isReminder = taskType === 'reminder';
  const isRecurring = !!(
    Number(row.recurrence_enabled || 0) === 1
    || normalizeRecurrenceType(row.recurrence_type)
    || String(row.recurrence_rule || '').trim()
    || row.recurrence_series_id
    || row.recurrence_parent_task_id
  );
  return {
    id: String(row.id || ''),
    title: String(row.title || 'Без названия'),
    date,
    start_time: start,
    end_time: end,
    duration_min: duration,
    task_type: taskType,
    importance,
    urgency: normalizeTaskUrgency_(row.urgency),
    status,
    project: row.project_name || 'Без проекта',
    space: normalizeTaskSpaceKey(row.space_key),
    is_movable: !isDone && !isMeeting && !isReminder && !isRecurring,
    is_recurring: isRecurring,
    is_meeting: isMeeting,
    is_fixed_time: isMeeting,
    blocks_time: status === TASK_STATUSES.PLANNED && !isReminder,
    source: row.source || 'planner',
    source_type: row.source_type || null,
    source_url: row.source_url || row.linked_resource_url || null,
    linked_resource_url: row.linked_resource_url || row.source_url || null,
    linked_resource_title: row.linked_resource_title || null,
    linked_hub_record_id: row.linked_hub_record_id || row.source_record_id || null
  };
}

// Stage341 RECURRENCE_READ_ONLY_SAFE: this function must not call syncRecurringSeriesFromTask
async function getScheduledTasksForAgent_(env, userId, fromDate, toDate, space) {
  if (!env || !env.DB) return [];
  await ensureTasksSchema(env);
  const normalizedSpace = normalizeAgentSpaceKey_(space || 'work');
  const fromIso = zonedDateTimeToUtcIso(fromDate, 0, 0, getPlannerTimezone_(env));
  const toExclusiveIso = zonedDateTimeToUtcIso(addDaysToServerYmd(toDate, 1), 0, 0, getPlannerTimezone_(env));
  const statuses = Array.from(new Set([...getStatusSqlValues(TASK_STATUSES.PLANNED), ...getStatusSqlValues(TASK_STATUSES.DONE)]));
  const statusFilter = buildStatusFilterClause(statuses);
  const rows = await env.DB.prepare(`
    SELECT ${TASK_SELECT_FIELDS}
    FROM tasks
    WHERE user_id = ?
      AND status IN (${statusFilter.placeholders})
      AND due_at IS NOT NULL
      AND due_at >= ?
      AND due_at < ?
    ORDER BY due_at ASC
    LIMIT 500
  `).bind(String(userId), ...statusFilter.values, fromIso, toExclusiveIso).all();
  return ((rows && rows.results) || [])
    .map((row) => mapScheduledTaskForAgent_(row, env))
    .filter((task) => task && (normalizedSpace === 'all' || task.space === normalizedSpace));
}


function isAgentTaskBusyForSlotGuard_(task) {
  if (!task || !task.date || !task.start_time || !task.end_time) return false;

  const status = normalizeStatus(task.status) || String(task.status || '').trim().toLowerCase();

  if (status === TASK_STATUSES.NEW) return false;
  if (status === TASK_STATUSES.DONE) return false;
  if (status === TASK_STATUSES.CANCELED) return false;
  if (status === TASK_STATUSES.POSTPONED) return false;

  // Reminders are notifications, not hard occupied calendar blocks.
  if (task.task_type === 'reminder') return false;

  const start = agentClockToMinutes_(task.start_time);
  const end = agentClockToMinutes_(task.end_time);

  if (!Number.isFinite(start) || !Number.isFinite(end)) return false;
  if (end <= start) return false;

  return true;
}

function buildAgentBusyIntervalsForSlotGuard_(tasks) {
  return (Array.isArray(tasks) ? tasks : [])
    .filter((task) => isAgentTaskBusyForSlotGuard_(task))
    .map((task) => ({
      date: String(task.date || ''),
      start_time: String(task.start_time || ''),
      end_time: String(task.end_time || ''),
      start_min: agentClockToMinutes_(task.start_time),
      end_min: agentClockToMinutes_(task.end_time),
      task_id: String(task.id || ''),
      title: String(task.title || 'Занятая задача'),
      task_type: String(task.task_type || ''),
      status: String(task.status || ''),
      is_recurring: !!task.is_recurring
    }))
    .filter((busy) => (
      busy.date
      && Number.isFinite(busy.start_min)
      && Number.isFinite(busy.end_min)
      && busy.end_min > busy.start_min
    ))
    .sort((a, b) => String(a.date + a.start_time).localeCompare(String(b.date + b.start_time)));
}

function agentSlotOverlapsBusyInterval_(slot, busy) {
  if (!slot || !busy) return false;
  if (String(slot.date || '') !== String(busy.date || '')) return false;

  const slotStart = agentClockToMinutes_(slot.start_time);
  const slotEnd = agentClockToMinutes_(slot.end_time);
  const busyStart = Number(busy.start_min);
  const busyEnd = Number(busy.end_min);

  if (!Number.isFinite(slotStart) || !Number.isFinite(slotEnd)) return false;
  if (!Number.isFinite(busyStart) || !Number.isFinite(busyEnd)) return false;
  if (slotEnd <= slotStart || busyEnd <= busyStart) return false;

  return slotStart < busyEnd && slotEnd > busyStart;
}

function filterAgentSlotsByBusyOverlap_(slots, tasks) {
  const busyIntervals = buildAgentBusyIntervalsForSlotGuard_(tasks);
  const accepted = [];
  const rejected = [];

  (Array.isArray(slots) ? slots : []).forEach((slot) => {
    const overlap = busyIntervals.find((busy) => agentSlotOverlapsBusyInterval_(slot, busy));

    if (overlap) {
      rejected.push({
        date: slot.date,
        start_time: slot.start_time,
        end_time: slot.end_time,
        block_title: slot.block_title,
        busy_task_id: overlap.task_id,
        busy_title: overlap.title,
        busy_start_time: overlap.start_time,
        busy_end_time: overlap.end_time
      });
      return;
    }

    accepted.push(slot);
  });

  return {
    slots: accepted,
    busy_intervals: busyIntervals,
    removed_count: rejected.length,
    removed_slots: rejected.slice(0, 10)
  };
}


function iterateAgentDateRange_(fromDate, toDate) {
  const result = [];
  let cursor = normalizeAgentYmd_(fromDate, '');
  const end = normalizeAgentYmd_(toDate, cursor);

  if (!cursor) return result;

  let guard = 0;

  while (cursor <= end && guard < 45) {
    result.push(cursor);
    cursor = addDaysToServerYmd(cursor, 1);
    guard += 1;
  }

  return result;
}

function buildCalendarFreeIntervalsForAgent_(fromDate, toDate, tasks, options = {}) {
  const startClock = normalizeAgentClock_(options.start_time || options.startTime || '09:00', '09:00');
  const endClock = normalizeAgentClock_(options.end_time || options.endTime || '19:00', '19:00');
  const startMin = agentClockToMinutes_(startClock);
  const endMin = agentClockToMinutes_(endClock);
  const space = normalizeAgentSpaceKey_(options.space || 'work');
  const dates = iterateAgentDateRange_(fromDate, toDate);

  if (!Number.isFinite(startMin) || !Number.isFinite(endMin) || endMin <= startMin) {
    return [];
  }

  const result = [];

  dates.forEach((date) => {
    const busy = (Array.isArray(tasks) ? tasks : [])
      .filter((task) => isAgentTaskBusyForSlotGuard_(task) && task.date === date)
      .map((task) => ({
        start: Math.max(startMin, agentClockToMinutes_(task.start_time)),
        end: Math.min(endMin, agentClockToMinutes_(task.end_time)),
        task_id: task.id,
        title: task.title
      }))
      .filter((item) => item.end > item.start)
      .sort((a, b) => a.start - b.start);

    let cursor = startMin;

    busy.forEach((item) => {
      if (item.start > cursor) {
        result.push({
          date,
          block_id: 'calendar_workday_' + date,
          block_title: 'Свободное рабочее окно',
          start_time: agentMinutesToClock_(cursor),
          end_time: agentMinutesToClock_(item.start),
          duration_min: item.start - cursor,
          allowed_task_types: [],
          space,
          is_flexible: true,
          source: 'calendar_free_window'
        });
      }

      cursor = Math.max(cursor, item.end);
    });

    if (cursor < endMin) {
      result.push({
        date,
        block_id: 'calendar_workday_' + date,
        block_title: 'Свободное рабочее окно',
        start_time: agentMinutesToClock_(cursor),
        end_time: agentMinutesToClock_(endMin),
        duration_min: endMin - cursor,
        allowed_task_types: [],
        space,
        is_flexible: true,
        source: 'calendar_free_window'
      });
    }
  });

  return result.filter((slot) => Number(slot.duration_min || 0) >= 5);
}

function mergeAgentFreeIntervals_(blockIntervals, calendarIntervals) {
  const merged = [];
  const seen = new Set();

  function keyOf(slot) {
    return [
      String(slot && slot.date || ''),
      String(slot && slot.start_time || ''),
      String(slot && slot.end_time || ''),
      String(slot && slot.block_id || '')
    ].join('|');
  }

  (Array.isArray(blockIntervals) ? blockIntervals : []).forEach((slot) => {
    const key = keyOf(slot);
    if (!key || seen.has(key)) return;
    seen.add(key);
    merged.push(slot);
  });

  (Array.isArray(calendarIntervals) ? calendarIntervals : []).forEach((slot) => {
    const key = keyOf(slot);
    if (!key || seen.has(key)) return;
    seen.add(key);
    merged.push(slot);
  });

  return merged
    .filter((slot) => slot && slot.date && slot.start_time && slot.end_time)
    .sort((a, b) => String(a.date + a.start_time + a.end_time).localeCompare(String(b.date + b.start_time + b.end_time)));
}

function buildFreeIntervalsInsideBlocks_(blocks, tasks) {
  const result = [];
  (Array.isArray(blocks) ? blocks : []).forEach((block) => {
    if (!block || !block.date || !block.start_time || !block.end_time) return;
    const blockStart = agentClockToMinutes_(block.start_time);
    const blockEnd = agentClockToMinutes_(block.end_time);
    if (blockEnd <= blockStart) return;
    const busy = (Array.isArray(tasks) ? tasks : [])
      .filter((task) => isAgentTaskBusyForSlotGuard_(task) && task.date === block.date)
      .map((task) => ({
        start: Math.max(blockStart, agentClockToMinutes_(task.start_time)),
        end: Math.min(blockEnd, agentClockToMinutes_(task.end_time)),
        task_id: task.id,
        title: task.title
      }))
      .filter((item) => item.end > item.start)
      .sort((a, b) => a.start - b.start);
    let cursor = blockStart;
    busy.forEach((item) => {
      if (item.start > cursor) {
        result.push({
          date: block.date,
          block_id: block.id,
          block_title: block.title,
          start_time: agentMinutesToClock_(cursor),
          end_time: agentMinutesToClock_(item.start),
          duration_min: item.start - cursor,
          allowed_task_types: block.allowed_task_types || [],
          space: block.space,
          is_flexible: !!block.is_flexible
        });
      }
      cursor = Math.max(cursor, item.end);
    });
    if (cursor < blockEnd) {
      result.push({
        date: block.date,
        block_id: block.id,
        block_title: block.title,
        start_time: agentMinutesToClock_(cursor),
        end_time: agentMinutesToClock_(blockEnd),
        duration_min: blockEnd - cursor,
        allowed_task_types: block.allowed_task_types || [],
        space: block.space,
        is_flexible: !!block.is_flexible
      });
    }
  });
  return result.filter((slot) => Number(slot.duration_min || 0) >= 5);
}

function scoreSlotForTask_(slot, taskRequest, env) {
  let score = 0;
  const allowed = Array.isArray(slot && slot.allowed_task_types) ? slot.allowed_task_types : [];
  const taskType = normalizeTaskType_(taskRequest && taskRequest.task_type);
  const matchesTaskType = allowed.includes(taskType);
  const slotDuration = Number(slot && slot.duration_min || 0);
  const requestedDuration = Number(taskRequest && taskRequest.duration_min || 0);
  const today = getTelegramTodayYmd(getPlannerTimezone_(env));

  // Stage 336: day blocks are a soft visual/planning preference, not a hard rule.
  // A matching block receives a higher score, but any free slot with enough
  // duration is still allowed. This is especially important for high-priority tasks.
  if (matchesTaskType) score += 50;
  else score += 15;

  if (slotDuration >= requestedDuration) score += 25;

  if (taskRequest && taskRequest.urgency === 'today') {
    score += slot && slot.date === today ? 25 : 18;
  }
  if (taskRequest && taskRequest.urgency === 'next_3_days') score += 20;
  if (taskRequest && taskRequest.urgency === 'next_7_days') score += 14;

  if (taskRequest && taskRequest.importance === 'high') score += 20;
  if (taskRequest && taskRequest.importance === 'low' && !matchesTaskType) score -= 10;

  if (slot && slot.is_flexible === false && matchesTaskType) score += 8;

  return score;
}

function buildAgentSlotReason_(slot, taskRequest) {
  const allowed = Array.isArray(slot && slot.allowed_task_types) ? slot.allowed_task_types : [];
  const taskType = normalizeTaskType_(taskRequest && taskRequest.task_type);
  const blockMatchesTaskType = allowed.includes(taskType);

  if (blockMatchesTaskType) return 'Слот подходит по типу задачи и длительности.';
  if (taskRequest && taskRequest.importance === 'high') {
    return 'Слот свободен. Блок не специализирован под этот тип задачи, но задача высокой важности, поэтому слот допустим.';
  }
  return 'Слот свободен. Блок не специализирован под этот тип задачи, но может быть использован при необходимости.';
}

function findAgentTaskSlots_(planningContext, taskRequest, env) {
  const duration = Number(taskRequest && taskRequest.duration_min || 0);
  if (duration <= 0) {
    return {
      best_slots: [],
      fallback_slots: [],
      busy_intervals: buildAgentBusyIntervalsForSlotGuard_(planningContext && planningContext.tasks),
      busy_overlap_removed_count: 0,
      busy_overlap_removed_slots: []
    };
  }

  const rawCandidates = (planningContext && Array.isArray(planningContext.free_intervals) ? planningContext.free_intervals : [])
    .filter((slot) => Number(slot && slot.duration_min || 0) >= duration)
    .map((slot) => {
      const startMin = agentClockToMinutes_(slot.start_time);
      const endTime = agentMinutesToClock_(startMin + duration);
      const allowed = Array.isArray(slot && slot.allowed_task_types) ? slot.allowed_task_types : [];
      const taskType = normalizeTaskType_(taskRequest && taskRequest.task_type);
      const blockMatchesTaskType = allowed.includes(taskType);
      const score = scoreSlotForTask_(slot, taskRequest, env);
      return {
        date: slot.date,
        start_time: slot.start_time,
        end_time: endTime,
        duration_min: duration,
        block_id: slot.block_id,
        block_title: slot.block_title,
        block_matches_task_type: blockMatchesTaskType,
        is_allowed: true,
        score,
        reason: buildAgentSlotReason_(slot, taskRequest)
      };
    });

  // Stage 337: existing scheduled tasks are hard busy intervals.
  // Day blocks remain soft preferences, but no best/fallback slot may overlap
  // an already scheduled task.
  const overlapGuard = filterAgentSlotsByBusyOverlap_(rawCandidates, planningContext && planningContext.tasks);

  const candidates = overlapGuard.slots
    .sort((a, b) => b.score - a.score || String(a.date + a.start_time).localeCompare(String(b.date + b.start_time)));

  // Stage 336/337/338: do not require a high score threshold. Any non-overlapping
  // free interval with enough duration is a valid slot; score only controls ordering.
  const best = candidates.slice(0, 3);
  const bestKeys = new Set(best.map((slot) => slot.date + ' ' + slot.start_time + ' ' + slot.block_id));
  const fallback = candidates.filter((slot) => !bestKeys.has(slot.date + ' ' + slot.start_time + ' ' + slot.block_id)).slice(0, 3);

  return {
    best_slots: best,
    fallback_slots: fallback,
    busy_intervals: overlapGuard.busy_intervals,
    busy_overlap_removed_count: overlapGuard.removed_count,
    busy_overlap_removed_slots: overlapGuard.removed_slots
  };
}

function isAgentTaskProtectedFromReschedule_(task) {
  if (!task) return true;
  const status = normalizeStatus(task.status);
  if (status === TASK_STATUSES.DONE || status === TASK_STATUSES.CANCELED) return true;
  if (task.task_type === 'meeting' || task.task_type === 'reminder') return true;
  if (task.is_meeting || task.is_fixed_time || task.is_fixed || task.fixed_time || task.locked) return true;
  if (task.is_recurring || task.recurrence_id || task.repeat_rule || task.recurrence_rule || task.recurrence_series_id || task.recurrence_parent_task_id || Number(task.recurrence_enabled || 0) === 1) return true;
  return false;
}

function findRescheduleCandidatesForAgent_(tasks, taskRequest, freeIntervals = []) {
  const requestRank = getAgentTaskImportanceRank_(taskRequest && taskRequest.importance);
  const movable = (Array.isArray(tasks) ? tasks : [])
    .filter((task) => task && task.blocks_time !== false && task.is_movable)
    .filter((task) => !isAgentTaskProtectedFromReschedule_(task))
    .filter((task) => getAgentTaskImportanceRank_(task.importance) < requestRank)
    .filter((task) => getAgentTaskImportanceRank_(task.importance) < 3)
    .sort((a, b) => getAgentTaskImportanceRank_(a.importance) - getAgentTaskImportanceRank_(b.importance) || String(a.date + a.start_time).localeCompare(String(b.date + b.start_time)))
    .slice(0, 6);
  return movable.map((task) => {
    const replacement = (Array.isArray(freeIntervals) ? freeIntervals : []).find((slot) => {
      return Number(slot && slot.duration_min || 0) >= Number(task.duration_min || 0);
    });
    const item = {
      task_id: task.id,
      title: task.title,
      current_date: task.date,
      current_start_time: task.start_time,
      current_end_time: task.end_time,
      importance: task.importance,
      urgency: task.urgency,
      movable_reason: task.importance === 'low'
        ? 'Низкая важность, можно перенести ради более важной задачи.'
        : 'Средняя важность, можно рассмотреть перенос после подтверждения пользователя.'
    };
    if (replacement) {
      item.suggested_new_slot = {
        date: replacement.date,
        start_time: replacement.start_time,
        end_time: agentMinutesToClock_(agentClockToMinutes_(replacement.start_time) + Number(task.duration_min || 0)),
        block_title: replacement.block_title,
        block_matches_task_type: Array.isArray(replacement.allowed_task_types)
          ? replacement.allowed_task_types.includes(task.task_type)
          : false
      };
    }
    return item;
  });
}

function buildAgentPayloadHash_(payload) {
  const text = (() => { try { return JSON.stringify(payload || {}); } catch (error) { return String(payload || ''); } })();
  let hash = 2166136261;
  for (let i = 0; i < text.length; i += 1) {
    hash ^= text.charCodeAt(i);
    hash = Math.imul(hash, 16777619);
  }
  return (hash >>> 0).toString(16);
}

async function logAgentAction_(env, entry) {
  try {
    if (!env || !env.DB || !entry || !entry.user_id) return;
    await ensureTasksSchema(env);
    const details = entry.details_json !== undefined ? entry.details_json : (entry.details || entry.payload || null);
    const detailsText = details == null ? null : (() => { try { return JSON.stringify(details).slice(0, 12000); } catch (error) { return JSON.stringify({ note: 'details_stringify_failed' }); } })();
    await env.DB.prepare(`
      INSERT INTO agent_action_log (id, user_id, source, action_type, status, task_id, confirmation_id, payload_hash, message, details_json, build, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      crypto.randomUUID(),
      String(entry.user_id),
      String(entry.source || 'telegram_agent'),
      String(entry.action_type || 'unknown'),
      String(entry.status || 'info'),
      entry.task_id ? String(entry.task_id) : null,
      entry.confirmation_id ? String(entry.confirmation_id) : null,
      entry.payload_hash || buildAgentPayloadHash_(entry.payload || details || {}),
      entry.message ? String(entry.message).slice(0, 1000) : null,
      detailsText,
      getClientAppBuildLabel(),
      new Date().toISOString()
    ).run();
  } catch (error) {
    console.log('[agent_action_log_failed]', String(error));
  }
}

function parseAgentActionLogDetails_(row) {
  if (!row || !row.details_json) return null;
  try { return JSON.parse(row.details_json); } catch (error) { return { raw: row.details_json }; }
}

async function getSuccessfulAgentActionByConfirmation_(env, { userId, confirmationId, actionType = null }) {
  if (!env || !env.DB || !userId || !confirmationId) return null;
  await ensureTasksSchema(env);
  if (actionType) {
    return env.DB.prepare(`
      SELECT id, user_id, source, action_type, status, task_id, confirmation_id, payload_hash, message, details_json, build, created_at
      FROM agent_action_log
      WHERE user_id = ? AND confirmation_id = ? AND action_type = ? AND status = 'success'
      ORDER BY created_at DESC
      LIMIT 1
    `).bind(String(userId), String(confirmationId), String(actionType)).first();
  }
  return env.DB.prepare(`
    SELECT id, user_id, source, action_type, status, task_id, confirmation_id, payload_hash, message, details_json, build, created_at
    FROM agent_action_log
    WHERE user_id = ? AND confirmation_id = ? AND status = 'success'
    ORDER BY created_at DESC
    LIMIT 1
  `).bind(String(userId), String(confirmationId)).first();
}

function resolveAgentCreateActionTypeFromTaskInput_(taskInput) {
  const taskType = normalizeTaskType_(taskInput && taskInput.task_type);
  if (taskType === 'meeting') return 'create_meeting';
  if (taskType === 'reminder') return 'create_reminder';
  return 'create_task';
}

function getAgentErrorField_(error, key) {
  if (!error || typeof error !== 'object') return null;
  try { return error[key]; } catch (_) { return null; }
}

async function buildAgentAlreadyAppliedResponse_(env, { userId, existingLog, defaultMessage = 'Действие уже было применено ранее' }) {
  const details = parseAgentActionLogDetails_(existingLog) || {};
  const response = {
    ok: true,
    already_applied: true,
    action_type: existingLog && existingLog.action_type ? String(existingLog.action_type) : null,
    confirmation_id: existingLog && existingLog.confirmation_id ? String(existingLog.confirmation_id) : null,
    task_id: existingLog && existingLog.task_id ? String(existingLog.task_id) : null,
    message: defaultMessage,
    build: getClientAppBuildLabel()
  };
  if (Array.isArray(details.results)) response.results = details.results;
  if (details && details.item) response.item = details.item;
  if (response.task_id && !response.item) {
    try {
      const task = await getTaskById(env, { taskId: response.task_id, userId: String(userId) });
      if (task) response.item = task;
    } catch (error) {}
  }
  return response;
}

async function assertAgentConfirmationIdNotReusedForOtherAction_(env, { userId, confirmationId, actionType }) {
  const existingAny = await getSuccessfulAgentActionByConfirmation_(env, { userId, confirmationId });
  if (existingAny && String(existingAny.action_type || '') !== String(actionType || '')) {
    const error = new Error('confirmation_id_already_used_for_other_action');
    error['reason'] = 'confirmation_id_already_used_for_other_action';
    error['existing_action_type'] = String(existingAny.action_type || '');
    throw error;
  }
  return existingAny;
}

function assertAgentActionAllowed_(action) {
  const allowed = ['create_task', 'create_meeting', 'create_reminder', 'reschedule_task'];
  const type = String(action && action.type || '').trim();
  if (!allowed.includes(type)) throw new Error('Agent action is not allowed: ' + type);
  if (type === 'delete_task') throw new Error('Agent cannot delete tasks in v1');
  if (type === 'reschedule_task' && !String(action.task_id || '').trim()) throw new Error('reschedule_task requires task_id');
  return type;
}

// Stage341 RECURRENCE_READ_ONLY_SAFE: this function must not call syncRecurringSeriesFromTask
// Agent planning context is a pure read — it must never materialise occurrences
async function getAgentPlanningContext_(env, params) {
  const userId = String(params && (params.user_id || params.userId) || '').trim();
  if (!userId) return { ok: false, error: 'user_id is required' };
  const space = normalizeAgentSpaceKey_(params && params.space || 'work');
  const range = normalizeAgentDateRange_(params || {}, env);
  const taskRequest = {
    title: String(params && params.title || '').trim(),
    task_type: normalizeTaskType_(params && params.task_type),
    importance: normalizeTaskImportance_(params && params.importance),
    urgency: range.urgency,
    duration_min: normalizeEstimatedMinutes_(params && params.duration_min),
    project: String(params && params.project || '').trim(),
    soft_blocks: String(params && params.soft_blocks || '1') !== '0',
    allow_any_block: String(params && params.allow_any_block || '').trim() === '1'
      || normalizeTaskImportance_(params && params.importance) === 'high'
  };
  if (taskRequest.duration_min === 0) {
    return {
      ok: true,
      should_schedule: false,
      reason: 'too_short',
      message: 'Задача короче 10 минут. Лучше сделать её сразу.',
      build: getClientAppBuildLabel(),
      user_id: userId,
      space,
      from: range.from,
      to: range.to,
      timezone: getPlannerTimezone_(env),
      request: taskRequest,
      blocks: [],
      tasks: [],
      free_intervals: [],
      best_slots: [],
      fallback_slots: [],
      reschedule_candidates: [],
      warnings: []
    };
  }
  const [blocks, tasks] = await Promise.all([
    getPlanningBlocksForAgent_(env, userId, range.from, range.to, space),
    getScheduledTasksForAgent_(env, userId, range.from, range.to, space)
  ]);
  const blockFreeIntervals = buildFreeIntervalsInsideBlocks_(blocks, tasks);
  const calendarFreeIntervals = buildCalendarFreeIntervalsForAgent_(range.from, range.to, tasks, {
    space,
    start_time: params && (params.workday_start || params.day_start || params.start_work_time) || '09:00',
    end_time: params && (params.workday_end || params.day_end || params.end_work_time) || '19:00'
  });
  const freeIntervals = mergeAgentFreeIntervals_(blockFreeIntervals, calendarFreeIntervals);
  const slotResult = findAgentTaskSlots_({ blocks, tasks, free_intervals: freeIntervals }, taskRequest, env);
  const rescheduleCandidates = findRescheduleCandidatesForAgent_(tasks, taskRequest, freeIntervals);
  const warnings = [];
  if (!blocks.length) warnings.push('planning_blocks_empty');
  if (!blockFreeIntervals.length && calendarFreeIntervals.length) warnings.push('calendar_free_window_fallback_used');
  if (blockFreeIntervals.length && calendarFreeIntervals.length) warnings.push('calendar_free_windows_merged');
  if (Number(slotResult.busy_overlap_removed_count || 0) > 0) warnings.push('busy_overlap_slots_filtered');
  if (!slotResult.best_slots.length && !slotResult.fallback_slots.length) warnings.push('no_free_slot_for_requested_duration');
  return {
    ok: true,
    should_schedule: true,
    build: getClientAppBuildLabel(),
    user_id: userId,
    space,
    from: range.from,
    to: range.to,
    timezone: getPlannerTimezone_(env),
    request: taskRequest,
    blocks,
    tasks,
    busy_intervals: slotResult.busy_intervals || buildAgentBusyIntervalsForSlotGuard_(tasks),
    busy_overlap_removed_count: Number(slotResult.busy_overlap_removed_count || 0),
    busy_overlap_removed_slots: slotResult.busy_overlap_removed_slots || [],
    block_free_intervals_count: blockFreeIntervals.length,
    calendar_free_intervals_count: calendarFreeIntervals.length,
    free_intervals: freeIntervals,
    best_slots: slotResult.best_slots,
    fallback_slots: slotResult.fallback_slots,
    reschedule_candidates: rescheduleCandidates,
    warnings
  };
}

function isAgentTooShortTaskError_(error) {
  return error instanceof Error && error.message === 'AGENT_TASK_TOO_SHORT';
}

function buildAgentTaskInputFromPayload_(payload, env) {
  const source = payload && (payload.task || payload.item || payload);
  const title = String(source && source.title || '').trim();
  if (!title) throw new Error('task.title is required');
  const taskType = normalizeTaskType_(source.task_type || source.type);
  const duration = normalizeEstimatedMinutes_(source.duration_min || source.duration_minutes || source.estimated_minutes || (taskType === 'reminder' ? 10 : 30));
  if (duration === 0) {
    throw new Error('AGENT_TASK_TOO_SHORT');
  }
  const dateYmd = normalizeAgentYmd_(source.date || source.date_ymd || source.day, getTelegramTodayYmd(getPlannerTimezone_(env)));
  const startTime = normalizeAgentClock_(source.start_time || source.startTime, '09:00');
  const endTime = source.end_time || source.endTime
    ? normalizeAgentClock_(source.end_time || source.endTime, agentMinutesToClock_(agentClockToMinutes_(startTime) + duration))
    : agentMinutesToClock_(agentClockToMinutes_(startTime) + duration);
  const remindAtRaw = source.remind_at || source.remindAt || null;
  const remindAtIso = remindAtRaw ? normalizeIsoDateTime(remindAtRaw) : null;
  return {
    title,
    description: source.description || null,
    task_product: source.task_product || null,
    project_name: normalizeProjectNameServer(source.project_name || source.project || 'Без проекта'),
    priority_manual: mapPriorityLevelToNumber(normalizeTaskImportance_(source.importance)) || 2,
    due_at: taskType === 'reminder' && remindAtIso ? null : agentDateTimeToIso_(dateYmd, startTime, env),
    remind_at: remindAtIso,
    duration_minutes: duration,
    planned_minutes_manual: duration,
    source: payload.source || source.source || 'telegram_agent',
    source_type: source.source_type || 'telegram_agent',
    source_url: source.source_url || source.linked_resource_url || source.linked_resource_url || null,
    source_record_id: source.source_record_id || source.linked_hub_record_id || null,
    linked_resource_url: source.linked_resource_url || source.source_url || null,
    linked_resource_title: source.linked_resource_title || null,
    linked_hub_record_id: source.linked_hub_record_id || source.source_record_id || null,
    show_in_month: 0,
    space_key: source.space || source.space_key || 'work',
    telegram_notify_type: null,
    task_type: taskType,
    importance: normalizeTaskImportance_(source.importance),
    urgency: normalizeTaskUrgency_(source.urgency),
    _agent_date: dateYmd,
    _agent_start_time: startTime,
    _agent_end_time: endTime
  };
}

async function handleAgentPlanningContextApi(request, env) {
  if (String(request.method || 'GET').toUpperCase() !== 'GET') return textResponse('Method Not Allowed', 405);
  const url = new URL(request.url);
  // Stage338: use safe helper instead of Object.fromEntries(url.searchParams.entries()) to avoid TS/Worker lib risk
  const params = searchParamsToObject(url.searchParams);
  const userId = readRequestUserIdFromUrlBodyOrHeader(url, params, request);
  if (userId) params.user_id = userId;
  const context = await getAgentPlanningContext_(env, params);
  return jsonResponse(context, { status: context.ok === false ? 400 : 200 });
}

async function handleAgentTaskCreateConfirmedApi(request, env) {
  if (String(request.method || 'POST').toUpperCase() !== 'POST') return textResponse('Method Not Allowed', 405);
  const body = await readJsonBodySafe(request);
  const url = new URL(request.url);
  const userId = readRequestUserIdFromUrlBodyOrHeader(url, body, request);
  if (!userId) return buildMissingUserIdJsonResponse('/agent/tasks/create-confirmed');
  const confirmationId = String(body.confirmation_id || '').trim();
  if (!confirmationId) return jsonResponse({ ok: false, error: 'confirmation_id is required' }, { status: 400 });
  try {
    const taskInput = buildAgentTaskInputFromPayload_({ ...body, task: body.task || body.item || body }, env);
    const actionType = resolveAgentCreateActionTypeFromTaskInput_(taskInput);
    const existingAny = await assertAgentConfirmationIdNotReusedForOtherAction_(env, { userId: String(userId), confirmationId, actionType });
    if (existingAny) {
      const already = await buildAgentAlreadyAppliedResponse_(env, {
        userId: String(userId),
        existingLog: existingAny,
        defaultMessage: actionType === 'create_meeting'
          ? 'Встреча уже была создана по этому подтверждению'
          : (actionType === 'create_reminder' ? 'Напоминание уже было создано по этому подтверждению' : 'Задача уже была создана по этому подтверждению')
      });
      return jsonResponse(already);
    }
    const { task } = await createTaskRecord(env, { ...taskInput, user_id: String(userId) });
    await upsertProjectRecord(env, { userId: String(userId), name: taskInput.project_name });
    await logAgentAction_(env, {
      user_id: String(userId),
      source: body.source || 'telegram_agent',
      action_type: actionType,
      status: 'success',
      task_id: task && task.id,
      confirmation_id: confirmationId,
      payload: body,
      details: { item: task },
      message: actionType === 'create_meeting'
        ? 'Created meeting from confirmed Telegram agent proposal'
        : (actionType === 'create_reminder' ? 'Created reminder from confirmed Telegram agent proposal' : 'Created task from confirmed Telegram agent proposal')
    });
    return jsonResponse({
      ok: true,
      action_type: actionType,
      task_id: task && task.id,
      item: task,
      message: actionType === 'create_meeting' ? 'Встреча создана' : (actionType === 'create_reminder' ? 'Напоминание создано' : 'Задача создана'),
      build: getClientAppBuildLabel()
    });
  } catch (error) {
    const errorReason = getAgentErrorField_(error, 'reason') ? String(getAgentErrorField_(error, 'reason')) : '';
    if (errorReason === 'confirmation_id_already_used_for_other_action') {
      return jsonResponse({
        ok: false,
        error: 'confirmation_id_already_used_for_other_action',
        existing_action_type: getAgentErrorField_(error, 'existing_action_type') || null,
        confirmation_id: confirmationId,
        build: getClientAppBuildLabel()
      }, { status: 409 });
    }
    await logAgentAction_(env, { user_id: String(userId), source: body.source || 'telegram_agent', action_type: 'create_task', status: 'error', confirmation_id: confirmationId, payload: body, message: String(error) });
    if (isAgentTooShortTaskError_(error)) return jsonResponse({ ok: true, should_schedule: false, reason: 'too_short', message: 'Задача короче 10 минут. Лучше сделать её сразу.', build: getClientAppBuildLabel() });
    return jsonResponse({ ok: false, error: String(error), build: getClientAppBuildLabel() }, { status: 500 });
  }
}

async function handleAgentTasksApplyPlanApi(request, env) {
  if (String(request.method || 'POST').toUpperCase() !== 'POST') return textResponse('Method Not Allowed', 405);
  const body = await readJsonBodySafe(request);
  const url = new URL(request.url);
  const userId = readRequestUserIdFromUrlBodyOrHeader(url, body, request);
  if (!userId) return buildMissingUserIdJsonResponse('/agent/tasks/apply-plan');
  const confirmationId = String(body.confirmation_id || '').trim();
  if (!confirmationId) return jsonResponse({ ok: false, error: 'confirmation_id is required' }, { status: 400 });
  const actions = Array.isArray(body.actions) ? body.actions : [];
  if (!actions.length) return jsonResponse({ ok: false, error: 'actions are required' }, { status: 400 });
  if (actions.length > 5) return jsonResponse({ ok: false, error: 'too_many_actions_for_agent_v1' }, { status: 400 });

  const actionType = 'apply_plan';
  try {
    const existingAny = await assertAgentConfirmationIdNotReusedForOtherAction_(env, { userId: String(userId), confirmationId, actionType });
    if (existingAny) {
      const already = await buildAgentAlreadyAppliedResponse_(env, { userId: String(userId), existingLog: existingAny, defaultMessage: 'План уже был применён по этому подтверждению' });
      return jsonResponse(already);
    }
  } catch (error) {
    const errorReason = getAgentErrorField_(error, 'reason') ? String(getAgentErrorField_(error, 'reason')) : '';
    if (errorReason === 'confirmation_id_already_used_for_other_action') {
      return jsonResponse({
        ok: false,
        error: 'confirmation_id_already_used_for_other_action',
        existing_action_type: getAgentErrorField_(error, 'existing_action_type') || null,
        confirmation_id: confirmationId,
        build: getClientAppBuildLabel()
      }, { status: 409 });
    }
    return jsonResponse({ ok: false, error: String(error), build: getClientAppBuildLabel() }, { status: 500 });
  }

  const results = [];
  try {
    for (const action of actions) {
      const type = assertAgentActionAllowed_(action);
      if (type === 'create_task' || type === 'create_meeting' || type === 'create_reminder') {
        const taskPayload = type === 'create_task' ? action.task : (action.meeting || action.reminder || action.task || action);
        const taskInput = buildAgentTaskInputFromPayload_({ ...body, task: { ...taskPayload, task_type: type === 'create_meeting' ? 'meeting' : (type === 'create_reminder' ? 'reminder' : taskPayload && taskPayload.task_type) } }, env);
        const { task } = await createTaskRecord(env, { ...taskInput, user_id: String(userId) });
        await upsertProjectRecord(env, { userId: String(userId), name: taskInput.project_name });
        results.push({ type, ok: true, task_id: task && task.id, item: task });
      }
      if (type === 'reschedule_task') {
        const taskId = String(action.task_id || '').trim();
        const existing = await getTaskById(env, { taskId, userId: String(userId) });
        if (!existing) throw new Error('Task not found: ' + taskId);
        const mapped = mapScheduledTaskForAgent_(existing, env);
        if (!mapped || !mapped.is_movable) throw new Error('Task is not movable for agent v1: ' + taskId);
        const newDate = normalizeAgentYmd_(action.new_date || action.date, mapped.date);
        const newStart = normalizeAgentClock_(action.new_start_time || action.start_time, mapped.start_time);
        const duration = normalizeEstimatedMinutes_(action.duration_min || mapped.duration_min) || mapped.duration_min || 30;
        const dueAt = agentDateTimeToIso_(newDate, newStart, env);
        const updated = await updateTaskSchedule(env, { taskId, userId: String(userId), dueAt, nextStatus: TASK_STATUSES.PLANNED, durationMinutes: duration });
        results.push({ type, ok: true, task_id: taskId, item: updated, reason: String(action.reason || '') });
      }
    }
    await logAgentAction_(env, { user_id: String(userId), source: body.source || 'telegram_agent', action_type: actionType, status: 'success', confirmation_id: confirmationId, payload: body, details: { results }, message: 'Applied confirmed Telegram agent plan' });
    return jsonResponse({ ok: true, results, message: 'План применён', build: getClientAppBuildLabel() });
  } catch (error) {
    await logAgentAction_(env, { user_id: String(userId), source: body.source || 'telegram_agent', action_type: actionType, status: 'error', confirmation_id: confirmationId, payload: body, details: { results }, message: String(error) });
    return jsonResponse({ ok: false, error: String(error), partial_results: results, build: getClientAppBuildLabel() }, { status: 500 });
  }
}

