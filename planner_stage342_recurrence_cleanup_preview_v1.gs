function normalizeTaskImportanceFromTask_(task) {
  if (task && task.importance) return normalizeTaskImportance_(task.importance);
  const priority = Number(task && (task.priority_manual ?? task.priority_ai));
  if (priority >= 3) return 'high';
  if (priority === 1) return 'low';
  return 'medium';
}

