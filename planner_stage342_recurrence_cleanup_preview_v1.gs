/**
 * Stage338: normalize partial audit event input so all optional fields are explicitly defaulted.
 * Prevents TS2345 / destructuring errors when callers omit optional fields.
 * @param {object} [event]
 */
function normalizeAgentAuditEventInput_(event) {
  const e = event || {};
  return {
    user_id: String(e.user_id || '').trim(),
    telegram_message_id: e.telegram_message_id ? String(e.telegram_message_id) : null,
    proposal_id: e.proposal_id ? String(e.proposal_id) : null,
    confirmation_id: e.confirmation_id ? String(e.confirmation_id) : null,
    event_type: String(e.event_type || 'unknown'),
    status: String(e.status || 'success'),
    payload_json: e.payload_json !== undefined ? e.payload_json : null,
    result_json: e.result_json !== undefined ? e.result_json : null,
    error_message: e.error_message ? String(e.error_message).slice(0, 500) : null
  };
}

/**
 * Log an agent audit event. All fields except user_id are optional.
 * @param {object} env
 * @param {object} [event]
 */
async function logAgentAuditEvent(env, event) {
  try {
    const e = normalizeAgentAuditEventInput_(event);
    if (!env || !env.DB || !e.user_id) return;
    await ensureAgentAuditSchema(env);
    const payloadText = e.payload_json != null ? (() => { try { return JSON.stringify(e.payload_json).slice(0, 6000); } catch (_) { return null; } })() : null;
    const resultText = e.result_json != null ? (() => { try { return JSON.stringify(e.result_json).slice(0, 4000); } catch (_) { return null; } })() : null;
    await env.DB.prepare(`
      INSERT INTO agent_audit_log (id, created_at, user_id, telegram_message_id, proposal_id, confirmation_id, event_type, status, payload_json, result_json, error_message, build)
      VALUES (?,?,?,?,?,?,?,?,?,?,?,?)
    `).bind(
      crypto.randomUUID(),
      new Date().toISOString(),
      e.user_id,
      e.telegram_message_id,
      e.proposal_id,
      e.confirmation_id,
      e.event_type,
      e.status,
      payloadText,
      resultText,
      e.error_message,
      getClientAppBuildLabel()
    ).run();
  } catch (error) {
    console.error('[logAgentAuditEvent]', String(error));
  }
}

