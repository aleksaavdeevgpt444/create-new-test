          meta: nextActionTask ? buildTodayOsTaskMeta(nextActionTask).slice(0, 4) : [createChip(command.freeSlotLabel ? ('Ближайшее окно: ' + command.freeSlotLabel) : 'Сегодня без слота')],
          accent: !!nextActionTask,
