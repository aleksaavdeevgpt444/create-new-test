              { title: 'Закрой старый цикл', text: 'Мысленно заверши прошлую задачу одной фразой.' },
              { title: 'Смена внимания', text: 'Посмотри вдаль, отпусти плечи и ослабь напряжение в теле.' },
              { title: 'Новый вход', text: 'Назови новый фокус и первую точку входа в него.' }
            ]
          },
          endday: {
            key: 'endday',
            title: 'Завершить день',
            subtitle: 'Спокойно закрыть рабочий день и не нести его хвостом дальше.',
            defaultMinutes: 5,
            steps: [
              { title: 'Подведение итога', text: 'Отметь, что уже сделано, без обесценивания дня.' },
              { title: 'Снятие хвостов', text: 'Запиши один незавершённый вопрос, чтобы не держать его в голове.' },
              { title: 'Выход', text: 'Сделай несколько медленных вдохов и отпусти рабочий темп.' }
            ]
          }
        };
      }

      function getMeditationProgram(programKey) {
        var programs = getMeditationPrograms();
        return programs[String(programKey || '').trim()] || programs.gather;
      }

      function resolveMeditationDurationMinutes(programKey) {
        var settings = state.meditationSettings || getDefaultMeditationSettings();
        var program = getMeditationProgram(programKey);
        var minutes = Number(settings.durationMinutes);
        if (!Number.isFinite(minutes) || minutes <= 0) minutes = Number(program.defaultMinutes) || 3;
        return minutes;
      }

      function getRitualCandidateTasks(dayYmd) {
        var seen = Object.create(null);
        var items = [];
        getTasksForDay(dayYmd).concat(getBacklogTasks()).forEach(function (task) {
          if (!(task && task.id) || seen[task.id]) return;
          var status = normalizeStatus(task.status);
          if (!(status === STATUS.NEW || status === STATUS.PLANNED || status === STATUS.POSTPONED)) return;
          seen[task.id] = 1;
          items.push(task);
        });
        return items.slice(0, 12);
      }

      function isTaskEligibleForDayPlan(task, options) {
        if (!(task && task.id)) return false;
        var status = normalizeStatus(task.status) || STATUS.NEW;
        if (options && options.allowBacklog) {
          return [STATUS.NEW, STATUS.PLANNED, STATUS.POSTPONED, STATUS.DONE].indexOf(status) >= 0;
        }
        return status === STATUS.PLANNED || status === STATUS.DONE;
      }

      function buildDayPlanSectionItem(task) {
        return {
          id: task.id,
          title: String(task.title || 'Без названия').trim() || 'Без названия',
          planned_minutes: Number(getEffectivePlannedMinutesClient(task)) || Number(getTaskDurationMinutes(task)) || DEFAULT_EVENT_DURATION_MIN
        };
      }

      function getTodayDayPlanSections(dayYmd) {
        var ritual = loadDayRitual(dayYmd);
        var mainIds = Array.isArray(ritual.topTaskIds) ? ritual.topTaskIds.map(function (id) { return String(id); }) : [];
        var seen = Object.create(null);
        var primary = [];
        var additional = [];
        var recurring = [];

        mainIds.forEach(function (taskId) {
          var task = findTaskById(taskId);
          if (!isTaskEligibleForDayPlan(task, { allowBacklog: true })) return;
          if (seen[task.id]) return;
          seen[task.id] = 1;
          primary.push(buildDayPlanSectionItem(task));
        });

        getTasksForDay(dayYmd).forEach(function (task) {
          if (!isTaskEligibleForDayPlan(task)) return;
          if (seen[task.id]) return;
          seen[task.id] = 1;
          if (isRecurringCalendarTask(task)) {
            recurring.push(buildDayPlanSectionItem(task));
          } else {
            additional.push(buildDayPlanSectionItem(task));
          }
        });

        return { primary: primary, additional: additional, recurring: recurring };
      }

      function getTodayPlanDeliveryCounts(dayYmd, sections) {
        var safeSections = sections || getTodayDayPlanSections(dayYmd || state.dayYmd || formatYmdLocal(new Date()));
        var primary = Array.isArray(safeSections.primary) ? safeSections.primary : [];
        var additional = Array.isArray(safeSections.additional) ? safeSections.additional : [];
        var recurring = Array.isArray(safeSections.recurring) ? safeSections.recurring : [];
        var total = primary.length + additional.length + recurring.length;
        var plannedMinutes = 0;
        primary.concat(additional).concat(recurring).forEach(function (item) {
          plannedMinutes += Number(item && item.planned_minutes) || 0;
        });
        return {
          primary: primary.length,
          additional: additional.length,
          recurring: recurring.length,
          total: total,
          plannedMinutes: plannedMinutes
        };
      }

      function getTodayFactDeliveryPreview(dayYmd) {
        var tasks = getTasksForDay(dayYmd || state.dayYmd || formatYmdLocal(new Date()));
        var completed = 0;
        var remaining = 0;
        var actualMinutes = 0;
        tasks.forEach(function (task) {
          var status = normalizeStatus(task.status);
          if (status === STATUS.DONE) {
            completed += 1;
            actualMinutes += Number(task.actual_minutes) || 0;
            return;
          }
          if (status === STATUS.PLANNED || status === STATUS.NEW || status === STATUS.POSTPONED) remaining += 1;
        });
        return {
          completed: completed,
          remaining: remaining,
          actualMinutes: actualMinutes
        };
      }

      function sanitizeTelegramDeliveryCounts(raw) {
        var safe = raw && typeof raw === 'object' ? raw : {};
        var output = {};
        Object.keys(safe).forEach(function (key) {
          var value = Number(safe[key]);
          if (Number.isFinite(value)) output[key] = Math.max(0, Math.round(value));
        });
        return output;
      }

      function normalizeTelegramDayDeliveryState(raw) {
        var safe = raw && typeof raw === 'object' ? raw : {};
        var days = Object.create(null);
        if (safe.days && typeof safe.days === 'object') {
          Object.keys(safe.days).forEach(function (dayKey) {
            if (!/^\d{4}-\d{2}-\d{2}$/.test(String(dayKey || ''))) return;
            var entry = safe.days[dayKey] && typeof safe.days[dayKey] === 'object' ? safe.days[dayKey] : {};
            days[dayKey] = {
              planSentAt: String(entry.planSentAt || '').trim(),
              factSentAt: String(entry.factSentAt || '').trim(),
              planCounts: sanitizeTelegramDeliveryCounts(entry.planCounts),
              factCounts: sanitizeTelegramDeliveryCounts(entry.factCounts),
              lastAction: String(entry.lastAction || '').trim(),
              lastActionAt: String(entry.lastActionAt || '').trim(),
              lastActionStatus: String(entry.lastActionStatus || '').trim()
            };
          });
        }
        return { days: days };
      }

      function loadStoredTelegramDayDeliveryState() {
        try {
          return normalizeTelegramDayDeliveryState(JSON.parse(localStorage.getItem(TELEGRAM_DAY_DELIVERY_STATE_STORAGE_KEY) || '{}'));
        } catch (error) {
          return normalizeTelegramDayDeliveryState(null);
        }
      }

      function persistTelegramDayDeliveryState() {
        try {
          localStorage.setItem(TELEGRAM_DAY_DELIVERY_STATE_STORAGE_KEY, JSON.stringify(normalizeTelegramDayDeliveryState(state.telegramDayDeliveryState)));
        } catch (error) {}
      }

      function getTelegramDayDeliverySnapshot(dayYmd) {
        var normalized = normalizeTelegramDayDeliveryState(state.telegramDayDeliveryState);
        state.telegramDayDeliveryState = normalized;
        var key = dayYmd || state.dayYmd || formatYmdLocal(new Date());
        return normalized.days[key] || {
          planSentAt: '',
          factSentAt: '',
          planCounts: {},
          factCounts: {},
          lastAction: '',
          lastActionAt: '',
          lastActionStatus: ''
        };
      }

      function setTelegramDayDeliverySnapshot(dayYmd, patch) {
        var key = dayYmd || state.dayYmd || formatYmdLocal(new Date());
        var normalized = normalizeTelegramDayDeliveryState(state.telegramDayDeliveryState);
        var next = Object.assign({}, normalized.days[key] || {
          planSentAt: '',
          factSentAt: '',
          planCounts: {},
          factCounts: {},
          lastAction: '',
          lastActionAt: '',
          lastActionStatus: ''
        }, patch || {});
        next.planCounts = sanitizeTelegramDeliveryCounts(next.planCounts);
        next.factCounts = sanitizeTelegramDeliveryCounts(next.factCounts);
        normalized.days[key] = next;
        var dayKeys = Object.keys(normalized.days).sort();
        while (dayKeys.length > 21) {
          delete normalized.days[dayKeys.shift()];
        }
        state.telegramDayDeliveryState = normalized;
        persistTelegramDayDeliveryState();
      }

      function formatTelegramDayDeliveryStamp(value) {
        if (!value) return '—';
        var date = new Date(value);
        if (isNaN(date.getTime())) return '—';
        return date.toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
      }

      function renderTodayDeliverySummary(dayYmd) {
        var container = byId('todayDeliverySummary');
        if (!container) return;
        var targetDay = dayYmd || state.dayYmd || formatYmdLocal(new Date());
        var hasUser = !!String(state.userId || '').trim();
        if (!hasUser) {
          container.style.display = 'none';
          container.innerHTML = '';
          return;
        }
        container.style.display = '';
        container.innerHTML = '';

        var planCounts = getTodayPlanDeliveryCounts(targetDay);
        var factPreview = getTodayFactDeliveryPreview(targetDay);
        var deliveryState = getTelegramDayDeliverySnapshot(targetDay);

        function appendCard(className, title, subtitle, chips) {
          var card = document.createElement('div');
          card.className = 'today-delivery-card ' + className;
          card.innerHTML = '<strong>' + escapeHtml(title) + '</strong><span>' + escapeHtml(subtitle) + '</span>';
          if (Array.isArray(chips) && chips.length) {
            var row = document.createElement('div');
            row.className = 'today-delivery-chip-row';
            chips.forEach(function (chipText) {
              var chip = document.createElement('div');
              chip.className = 'today-delivery-chip';
              chip.textContent = chipText;
              row.appendChild(chip);
            });
            card.appendChild(row);
          }
          container.appendChild(card);
        }

        appendCard(
          'is-plan',
          'План в чат: ' + planCounts.total + ' задач',
          planCounts.total ? ('Суммарно ' + formatMinutesHoursLabel(planCounts.plannedMinutes) + ' в сообщении по дню.') : 'На выбранный день пока нечего отправлять как план.',
          [
            'Главные: ' + planCounts.primary,
            'Доп.: ' + planCounts.additional,
            'Повтор: ' + planCounts.recurring
          ]
        );

        appendCard(
          'is-fact',
          'Факт дня: ' + factPreview.completed + ' выполнено',
          factPreview.completed || factPreview.remaining ? ('В сообщении о факте будет видно завершение дня и переносы.') : 'На день пока нет завершённых или активных задач.',
          [
            'Факт: ' + formatMinutesHoursLabel(factPreview.actualMinutes || 0),
            'Осталось: ' + factPreview.remaining
          ]
        );

        var statusBits = [];
        if (deliveryState.planSentAt) statusBits.push('План: ' + formatTelegramDayDeliveryStamp(deliveryState.planSentAt));
        if (deliveryState.factSentAt) statusBits.push('Факт: ' + formatTelegramDayDeliveryStamp(deliveryState.factSentAt));
        if (!statusBits.length) statusBits.push('Отправок по этому дню ещё не было');
        appendCard(
          'is-status',
          deliveryState.lastAction ? ('Последнее: ' + getTelegramControlActionMeta(deliveryState.lastAction).title) : 'Telegram delivery status',
          statusBits.join(' · '),
          [
            deliveryState.planCounts && deliveryState.planCounts.total ? ('Отправлено планом: ' + deliveryState.planCounts.total) : 'План ещё не отправлялся',
            deliveryState.factCounts && (deliveryState.factCounts.completed || deliveryState.factCounts.moved) ? ('Факт: ' + (deliveryState.factCounts.completed || 0) + ' / переносов: ' + (deliveryState.factCounts.moved || 0)) : 'Факт ещё не отправлялся'
          ]
        );
      }

      function updateTodaySendPlanControls() {
        var btn = byId('todaySendPlanBtn');
        var note = byId('todaySendPlanNote');
        if (!btn) return;
        var hasUser = !!String(state.userId || '').trim();
        var dayYmd = state.dayYmd || formatYmdLocal(new Date());
        var planCounts = getTodayPlanDeliveryCounts(dayYmd);
        var deliveryState = getTelegramDayDeliverySnapshot(dayYmd);
        btn.disabled = state.dayPlanSendPending || state.dayFactSendPending || !hasUser;
        btn.textContent = state.dayPlanSendPending ? 'Отправка...' : (planCounts.total ? ('План в чат · ' + planCounts.total) : 'Отправить план в чат');
        if (note) {
          note.textContent = hasUser
            ? ('План: ' + planCounts.total + ' задач · ' + formatMinutesHoursLabel(planCounts.plannedMinutes) + (deliveryState.planSentAt ? (' · последний план: ' + formatTelegramDayDeliveryStamp(deliveryState.planSentAt)) : ''))
            : 'Сначала укажи user_id или открой planner через Telegram Mini App.';
        }
      }

      function updateTodaySendFactControls() {
        var btn = byId('todaySendFactBtn');
        if (!btn) return;
        var hasUser = !!String(state.userId || '').trim();
        var dayYmd = state.dayYmd || formatYmdLocal(new Date());
        var factPreview = getTodayFactDeliveryPreview(dayYmd);
        var deliveryState = getTelegramDayDeliverySnapshot(dayYmd);
        btn.disabled = state.dayFactSendPending || state.dayPlanSendPending || !hasUser;
        btn.textContent = state.dayFactSendPending ? 'Отправка...' : ((factPreview.completed || factPreview.remaining) ? ('Факт в чат · ' + factPreview.completed) : 'Отправить факт в чат');
        btn.title = deliveryState.factSentAt ? ('Последний факт: ' + formatTelegramDayDeliveryStamp(deliveryState.factSentAt)) : 'Отправить факт дня в Telegram';
      }


      function normalizeTelegramControlState(raw) {
        var safe = raw && typeof raw === 'object' ? raw : {};
        return {
          lastAction: String(safe.lastAction || '').trim(),
          lastActionAt: String(safe.lastActionAt || '').trim(),
          lastActionStatus: String(safe.lastActionStatus || '').trim() || 'idle',
          lastActionDayYmd: String(safe.lastActionDayYmd || '').trim(),
          lastError: String(safe.lastError || '').trim(),
          totalSuccess: Number.isFinite(Number(safe.totalSuccess)) ? Math.max(0, Math.round(Number(safe.totalSuccess))) : 0
        };
      }

      function loadStoredTelegramControlState() {
        try {
          return normalizeTelegramControlState(JSON.parse(localStorage.getItem(TELEGRAM_CONTROL_STATE_STORAGE_KEY) || '{}'));
        } catch (error) {
          return normalizeTelegramControlState(null);
        }
      }

      function persistTelegramControlState() {
        try {
          localStorage.setItem(TELEGRAM_CONTROL_STATE_STORAGE_KEY, JSON.stringify(normalizeTelegramControlState(state.telegramControlState)));
        } catch (error) {}
      }

      function setTelegramControlState(patch) {
        state.telegramControlState = Object.assign({}, normalizeTelegramControlState(state.telegramControlState), patch || {});
        persistTelegramControlState();
      }

      function getTelegramControlActionMeta(action) {
        var key = String(action || '').trim();
        var map = {
          plan: { key: 'plan', title: 'План в чат', description: 'Отправить план дня в Telegram', button: 'План' },
          next: { key: 'next', title: 'Что дальше', description: 'Попросить бота выбрать следующий шаг', button: 'Что дальше' },
          rest: { key: 'rest', title: 'Остаток дня', description: 'Показать остаток дня и просрочку', button: 'Остаток' },
          focus: { key: 'focus', title: 'Фокус', description: 'Подготовить фокус по следующей задаче', button: 'Фокус' },
          finish: { key: 'finish', title: 'Завершить день', description: 'Собрать остаток и быстрые команды на закрытие дня', button: 'Закрыть день' },
          fact: { key: 'fact', title: 'Факт дня', description: 'Отправить факт дня в Telegram', button: 'Факт' },
          app: { key: 'app', title: 'Открыть Planner', description: 'Отправить в Telegram кнопку открытия Mini App', button: 'Открыть в TG' }
        };
        return map[key] || { key: key || 'unknown', title: key || '—', description: '', button: key || '—' };
      }

      function formatTelegramControlActionTime(value) {
        if (!value) return '—';
        var date = new Date(value);
        if (isNaN(date.getTime())) return '—';
        return date.toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
      }

      async function runTelegramControlAction(action, options) {
        options = options || {};
        var targetAction = String(action || '').trim();
        if (!targetAction) return false;
        if (state.telegramControlPendingAction) return false;
        if (!String(state.userId || '').trim()) {
          showError('Сначала укажи user_id или открой planner через Telegram Mini App.');
          renderTodayTelegramControlCard(state.dayYmd || formatYmdLocal(new Date()));
          return false;
        }

        state.telegramControlPendingAction = targetAction;
        renderTodayTelegramControlCard(options.dayYmd || state.dayYmd || formatYmdLocal(new Date()));
        var meta = getTelegramControlActionMeta(targetAction);

        try {
          var response = await requestJson('/telegram/control-run', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              user_id: state.userId,
              action: targetAction,
              day_ymd: options.dayYmd || state.dayYmd || formatYmdLocal(new Date())
            })
          });
          setTelegramControlState({
            lastAction: targetAction,
            lastActionAt: new Date().toISOString(),
            lastActionStatus: 'sent',
            lastActionDayYmd: options.dayYmd || state.dayYmd || formatYmdLocal(new Date()),
            lastError: '',
            totalSuccess: normalizeTelegramControlState(state.telegramControlState).totalSuccess + 1
          });
          var actionDay = options.dayYmd || state.dayYmd || formatYmdLocal(new Date());
          if (targetAction === 'plan') {
            markRitualPlanSent(actionDay);
            setTelegramDayDeliverySnapshot(actionDay, {
              planSentAt: new Date().toISOString(),
              planCounts: response && response.counts ? response.counts : getTodayPlanDeliveryCounts(actionDay),
              lastAction: targetAction,
              lastActionAt: new Date().toISOString(),
              lastActionStatus: 'sent'
            });
          }
          if (targetAction === 'fact') {
            markRitualFactSent(actionDay);
            setTelegramDayDeliverySnapshot(actionDay, {
              factSentAt: new Date().toISOString(),
              factCounts: response && response.counts ? response.counts : getTodayFactDeliveryPreview(actionDay),
              lastAction: targetAction,
              lastActionAt: new Date().toISOString(),
              lastActionStatus: 'sent'
            });
          }
          rerenderTodayOs(actionDay);
          showSuccess(options.successMessage || (meta.title + ' отправлен(а) в Telegram.'));
          return true;
        } catch (error) {
          setTelegramControlState({
            lastAction: targetAction,
            lastActionAt: new Date().toISOString(),
            lastActionStatus: 'error',
            lastActionDayYmd: options.dayYmd || state.dayYmd || formatYmdLocal(new Date()),
            lastError: String(error || '')
          });
          renderTodayTelegramControlCard(options.dayYmd || state.dayYmd || formatYmdLocal(new Date()));
          showError(String(error));
          return false;
        } finally {
          state.telegramControlPendingAction = '';
          renderTodayTelegramControlCard(options.dayYmd || state.dayYmd || formatYmdLocal(new Date()));
        }
      }

      function renderTodayTelegramControlCard(dayYmd) {
        var container = byId('todayTelegramControlCard');
        if (!container) return;
        var targetDay = dayYmd || state.dayYmd || formatYmdLocal(new Date());
        if (!String(state.userId || '').trim()) {
          container.style.display = 'none';
          container.innerHTML = '';
          return;
        }
        container.style.display = '';
        container.innerHTML = '';

        var controlState = normalizeTelegramControlState(state.telegramControlState);
        var isTelegramAuth = state.authMode === 'telegram' && state.telegramUser;
        var lastMeta = getTelegramControlActionMeta(controlState.lastAction);
        var pendingMeta = getTelegramControlActionMeta(state.telegramControlPendingAction);
        var ritual = loadDayRitual(targetDay);
        var stats = getDayRitualTaskStats(targetDay, ritual);

        var head = document.createElement('div');
        head.className = 'ritual-head';
        head.innerHTML = '' +
          '<div>' +
            '<div class="ritual-title">Telegram Control</div>' +
            '<div class="ritual-subtitle">Удалённые действия по дню: бот может прислать план, факт, следующий шаг и сценарий закрытия дня.</div>' +
          '</div>' +
          '<div class="ritual-status-pill ' + (isTelegramAuth ? 'is-good' : 'is-warn') + '">' + (isTelegramAuth ? 'Mini App connected' : 'Web + user_id') + '</div>';

        var summaryGrid = document.createElement('div');
        summaryGrid.className = 'ritual-summary-grid';
        [
          { label: 'Режим', value: isTelegramAuth ? ('@' + (state.telegramUser.username || 'без username')) : ('user_id ' + state.userId) },
          { label: 'Последнее действие', value: controlState.lastAction ? lastMeta.title : 'Пока не отправлялось' },
          { label: 'Когда', value: controlState.lastActionAt ? formatTelegramControlActionTime(controlState.lastActionAt) : '—' },
          { label: 'Статус', value: state.telegramControlPendingAction ? ('Отправка: ' + pendingMeta.title) : (controlState.lastActionStatus === 'error' ? 'Ошибка' : (controlState.lastActionStatus === 'sent' ? 'Отправлено' : 'Ожидание')) },
          { label: 'Главные задачи', value: String(stats.mainCount || 0) },
          { label: 'Успешных действий', value: String(controlState.totalSuccess || 0) }
        ].forEach(function (item) {
          var card = document.createElement('div');
          card.className = 'ritual-summary-card';
          card.innerHTML = '<strong>' + escapeHtml(item.value) + '</strong><span>' + escapeHtml(item.label) + '</span>';
          summaryGrid.appendChild(card);
        });

        var actions = document.createElement('div');
        actions.className = 'ritual-actions';
        ['plan','next','rest','focus','finish','fact','app'].forEach(function (key) {
          var meta = getTelegramControlActionMeta(key);
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = key === 'plan' || key === 'next' || key === 'focus' ? 'btn-secondary' : 'btn-ghost';
          btn.textContent = state.telegramControlPendingAction === key ? 'Отправка...' : meta.button;
          btn.disabled = !!state.telegramControlPendingAction;
          btn.title = meta.description;
          btn.addEventListener('click', function () {
            runTelegramControlAction(key, { dayYmd: targetDay });
          });
          actions.appendChild(btn);
        });

        var helper = document.createElement('div');
        helper.className = 'ritual-helper-note';
        helper.textContent = controlState.lastActionStatus === 'error' && controlState.lastError
          ? ('Последняя ошибка Telegram Control: ' + controlState.lastError)
          : 'Этот блок нужен для удалённого контроля дня через Telegram без ручного ввода команд. Особенно полезен для плана, факта, остатка дня и быстрого возврата в Mini App.';

        container.appendChild(head);
        container.appendChild(summaryGrid);
        container.appendChild(actions);
        container.appendChild(helper);
      }

      async function sendDayPlanToChat(options) {
        options = options || {};
        if (state.dayPlanSendPending || state.dayFactSendPending) return false;
        if (!String(state.userId || '').trim()) {
          if (!options.silentError) showError('Сначала укажи user_id или открой planner через /app в Telegram.');
          updateTodaySendPlanControls();
          updateTodaySendFactControls();
          return false;
        }

        var dayYmd = options.dayYmd || state.dayYmd || formatYmdLocal(new Date());
        var sections = options.sections || getTodayDayPlanSections(dayYmd);
        var previousRequestState = state.requestState;

        state.dayPlanSendPending = true;
        state.requestState = 'отправка-плана-в-чат';
        updateDebugInfo();
        updateTodaySendPlanControls();
        updateTodaySendFactControls();
        if (!options.preserveMessages) showError('');

        try {
          var response = await requestJson('/telegram/send-day-plan', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              user_id: state.userId,
              day_ymd: dayYmd,
              sections: sections
            })
          });
          setTelegramDayDeliverySnapshot(dayYmd, {
            planSentAt: new Date().toISOString(),
            planCounts: response && response.counts ? response.counts : getTodayPlanDeliveryCounts(dayYmd, sections),
            lastAction: 'plan',
            lastActionAt: new Date().toISOString(),
            lastActionStatus: 'sent'
          });
          renderTodayDeliverySummary(dayYmd);
          if (!options.silentSuccess) showSuccess(options.successMessage || 'План на день отправлен в чат.');
          return true;
        } catch (error) {
          state.requestState = 'error';
          updateDebugInfo();
          if (!options.silentError) showError(String(error));
          return false;
        } finally {
          state.dayPlanSendPending = false;
          if (state.requestState !== 'error') state.requestState = state.planner ? 'loaded' : (previousRequestState || 'idle');
          updateDebugInfo();
          updateTodaySendPlanControls();
          updateTodaySendFactControls();
        }
      }

      async function sendDayFactToChat(options) {
        options = options || {};
        if (state.dayFactSendPending || state.dayPlanSendPending) return false;
        if (!String(state.userId || '').trim()) {
          if (!options.silentError) showError('Сначала укажи user_id или открой planner через /app в Telegram.');
          updateTodaySendPlanControls();
          updateTodaySendFactControls();
          return false;
        }

        var dayYmd = options.dayYmd || state.dayYmd || formatYmdLocal(new Date());
        var previousRequestState = state.requestState;

        state.dayFactSendPending = true;
        state.requestState = 'отправка-факта-в-чат';
        updateDebugInfo();
        updateTodaySendPlanControls();
        updateTodaySendFactControls();
        if (!options.preserveMessages) showError('');

        try {
          var response = await requestJson('/telegram/send-day-fact', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              user_id: state.userId,
              day_ymd: dayYmd
            })
          });
          setTelegramDayDeliverySnapshot(dayYmd, {
            factSentAt: new Date().toISOString(),
            factCounts: response && response.counts ? response.counts : getTodayFactDeliveryPreview(dayYmd),
            lastAction: 'fact',
            lastActionAt: new Date().toISOString(),
            lastActionStatus: 'sent'
          });
          renderTodayDeliverySummary(dayYmd);
          if (!options.silentSuccess) showSuccess(options.successMessage || 'Факт дня отправлен в чат.');
          return true;
        } catch (error) {
          state.requestState = 'error';
          updateDebugInfo();
          if (!options.silentError) showError(String(error));
          return false;
        } finally {
          state.dayFactSendPending = false;
          if (state.requestState !== 'error') state.requestState = state.planner ? 'loaded' : (previousRequestState || 'idle');
          updateDebugInfo();
          updateTodaySendPlanControls();
          updateTodaySendFactControls();
        }
      }

      function renderTodayRitualCard(dayYmd) {
        var container = byId('todayRitualCard');
        if (!container) return;
        var settings = state.ritualSettings || getDefaultRitualSettings();
        if (!settings.enabled || !settings.showTodayCard || !state.userId) {
          container.style.display = 'none';
          container.innerHTML = '';
          return;
        }

        var targetDay = dayYmd || formatYmdLocal(new Date());
        var ritual = loadDayRitual(targetDay);
        state.dayRitual = ritual;
        var modeMeta = getWorkModeMeta(state.workMode);
        var ritualStats = getDayRitualTaskStats(targetDay, ritual);
        var selectedTasks = ritualStats.selectedTasks;
        var nextMainTask = ritualStats.firstPendingTask;
        var focusTask = ritual.focusTaskId ? findTaskById(ritual.focusTaskId) : null;
        var hasReviewNote = !!String(ritual.reviewNote || '').trim();

        container.style.display = 'grid';
        container.innerHTML = '';

        var head = document.createElement('div');
        head.className = 'today-ritual-head';

        var headMain = document.createElement('div');
        var title = document.createElement('div');
        title.className = 'today-ritual-title';
        title.textContent = 'Ритуал дня';
