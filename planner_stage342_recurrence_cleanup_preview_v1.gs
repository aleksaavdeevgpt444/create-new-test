      async function persistChecklistItemText(itemId, nextText, options) {
        if (!itemId || !state.userId) return;
        var item = (state.editorChecklist || []).find(function (entry) { return entry.id === itemId; });
        var previousSaved = String(item && item._saved_text || item && item.text || '');
        var trimmed = String(nextText == null ? '' : nextText).trim();
        if (!trimmed) {
          if (!(options && options.silent)) showError('Текст пункта чек-листа не может быть пустым.');
          updateChecklistItemTextLocal(itemId, previousSaved);
          renderChecklist();
          return;
        }
        if (trimmed === previousSaved) {
          updateChecklistItemTextLocal(itemId, trimmed);
          return;
        }
        var data = await requestJson('/tasks/checklist/update', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ item_id: itemId, user_id: state.userId, text: trimmed })
        });
        setEditorChecklistState(data.items || [], state.editorTaskId);
        renderChecklist();
      }

      async function flushChecklistItemSave(itemId, nextText) {
