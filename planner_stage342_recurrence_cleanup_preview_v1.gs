    env.DB.prepare(`SELECT id, user_id, name, priority, description, notes, links_text, created_at, updated_at FROM projects WHERE user_id = ? ORDER BY name COLLATE NOCASE ASC`).bind(String(userId)).all(),
    env.DB.prepare(`SELECT DISTINCT project_name AS name FROM tasks WHERE user_id = ? AND project_name IS NOT NULL AND TRIM(project_name) <> '' ORDER BY project_name COLLATE NOCASE ASC`).bind(String(userId)).all()
  ]);
  const map = {};
  (rows.results || []).forEach((row) => {
    map[row.name] = {
      id: row.id,
      user_id: row.user_id,
      name: row.name,
      priority: row.priority || null,
      description: row.description || null,
      notes: row.notes || null,
      links_text: row.links_text || null,
      created_at: row.created_at || null,
      updated_at: row.updated_at || null,
    };
  });
  (taskNames.results || []).forEach((row) => {
    const name = normalizeProjectNameServer(row.name);
    if (!map[name]) {
      map[name] = {
        id: `${String(userId)}::${name.toLowerCase()}`,
        user_id: String(userId),
        name,
        priority: null,
        description: null,
        notes: null,
        links_text: null,
        created_at: null,
        updated_at: null,
      };
    }
  });
  return Object.values(map).sort((a, b) => String(a.name || '').localeCompare(String(b.name || ''), 'ru'));
}

