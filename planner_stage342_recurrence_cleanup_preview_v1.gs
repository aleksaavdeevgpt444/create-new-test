      function renderTodayAgendaPanels(dayYmd) {
        var dayTasks = getTasksForDay(dayYmd).slice().sort(compareTasksByDueAndUpdated);
        var agenda = byId('todayAgendaList');
        if (agenda) {
          agenda.innerHTML = '';
          var planned = dayTasks.filter(function (task) { return normalizeStatus(task.status) === STATUS.PLANNED; });
          var activeOther = dayTasks.filter(function (task) {
            var status = normalizeStatus(task.status);
            return status !== STATUS.PLANNED && status !== STATUS.DONE;
          });
          var done = dayTasks.filter(function (task) { return normalizeStatus(task.status) === STATUS.DONE; });
          var groups = document.createElement('div');
          groups.className = 'today-agenda-groups';
          groups.appendChild(createTodayAgendaGroup({
            title: 'В слоте и в работе',
            note: 'Таймлайн выбранного дня. Здесь быстрее всего открыть задачу или подсветить её в календаре.',
            tasks: planned,
            dayYmd: dayYmd,
            emptyText: 'На выбранный день пока нет задач в слоте.'
          }));
          groups.appendChild(createTodayAgendaGroup({
            title: 'Нужно довести',
            note: 'Задачи дня, которые ещё не ушли в done. Их удобно добивать из списка, если календарь уже собран.',
            tasks: activeOther,
            dayYmd: dayYmd,
            emptyText: 'Все дополнительные задачи дня либо в слоте, либо уже выполнены.'
          }));
          groups.appendChild(createTodayAgendaGroup({
            title: 'Выполнено',
            note: 'Закрытые задачи выбранного дня. Блок нужен для быстрого контроля факта без ухода в историю.',
            tasks: done,
            dayYmd: dayYmd,
            allowSchedule: false,
            emptyText: 'Выполненных задач за выбранный день пока нет.'
          }));
          agenda.appendChild(groups);
        }
        var backlogContainer = byId('todayBacklogList');
        if (backlogContainer) {
          backlogContainer.innerHTML = '';
          var backlog = getBacklogTasks();
          var newBacklog = backlog.filter(function (task) {
            var status = normalizeStatus(task.status);
            return status === STATUS.NEW || status === STATUS.POSTPONED;
          }).sort(compareTasksByPriorityThenDue);
          var pausedBacklog = backlog.filter(function (task) {
            var status = normalizeStatus(task.status);
            return status !== STATUS.NEW && status !== STATUS.POSTPONED;
          }).sort(compareTasksByPriorityThenDue);
          var groups = document.createElement('div');
          groups.className = 'today-backlog-groups';
          groups.appendChild(createTodayAgendaGroup({
            title: 'Без времени — можно втянуть в день',
            note: 'Быстрый слой задач без слота. Их удобно точечно отправлять в ближайшее окно календаря.',
            tasks: newBacklog,
            dayYmd: dayYmd,
            emptyText: 'Задач без времени сейчас нет.'
          }));
          groups.appendChild(createTodayAgendaGroup({
            title: 'Отложенные и пауза',
            note: 'Задачи, которые лучше оставить в weekly/intake слое до отдельного решения.',
            tasks: pausedBacklog,
            dayYmd: dayYmd,
            emptyText: 'Отложенных задач сейчас нет.'
          }));
          backlogContainer.appendChild(groups);
        }
      }

      function renderTodayView() {
        var dayYmd = state.dayYmd || formatYmdLocal(new Date());
        var todayDate = new Date(dayYmd + 'T00:00:00');
        var dayTasks = getTasksForDay(dayYmd);
        var activeDayTasks = dayTasks.filter(function (task) {
          var status = normalizeStatus(task.status);
          return status === STATUS.PLANNED || status === STATUS.DONE;
        });
        var doneCount = dayTasks.filter(function (task) { return normalizeStatus(task.status) === STATUS.DONE; }).length;
        var overdueCount = getShellTasks().filter(function (task) {
          var status = normalizeStatus(task.status);
          return (status === STATUS.PLANNED || status === STATUS.POSTPONED || status === STATUS.NEW) && isOverdueTask(task);
        }).length;
        var backlog = getBacklogTasks();

        if (byId('todayDayTitle')) byId('todayDayTitle').textContent = formatWithPlannerTimeZone(todayDate, { weekday: 'long', day: 'numeric', month: 'long' }, '—');
        var todayOsData = getTodayOsData(dayYmd);
        if (byId('todayDaySubtitle')) {
          // STAGE 290 — добавлен факт actual_minutes в subtitle
          var _dayMetrics = aggregateTaskTimeMetrics(dayTasks);
          var _actualLabel = _dayMetrics.actual > 0 ? ' · факт: ' + formatMinutesHoursLabel(_dayMetrics.actual) : '';
          byId('todayDaySubtitle').textContent = 'Исполнение дня: ' + String(todayOsData.mainTasks.length || 0) + ' главных · план ' + formatMinutesHoursLabel(todayOsData.plannedMinutes) + _actualLabel + ' · ёмкость ' + formatMinutesHoursLabel(todayOsData.capacityMinutes) + ' · ' + (todayOsData.overflowMinutes > 0 ? 'перегруз: ' + formatMinutesHoursLabel(todayOsData.overflowMinutes) : 'свободно: ' + formatMinutesHoursLabel(todayOsData.freeMinutes));
        }
        if (byId('todaySendPlanNote')) byId('todaySendPlanNote').textContent = 'Сегодня — главный экран исполнения: здесь план и факт дня, фокус, следующий шаг и контроль перегруза. Weekly review остаётся в Плане.';
        renderWorkflowDayContext('todayWorkflowDayContext', 'today', dayYmd);
        renderTodayDashboardStrip(dayYmd);
        updateTodaySendPlanControls();
        updateTodaySendFactControls();
