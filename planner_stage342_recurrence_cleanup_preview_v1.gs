        var recurrencePreset = byId('taskTemplateRecurrencePresetSelect') ? String(byId('taskTemplateRecurrencePresetSelect').value || 'none') : 'none';
        var recurrenceType = recurrencePreset === 'none' ? null : recurrencePreset;
