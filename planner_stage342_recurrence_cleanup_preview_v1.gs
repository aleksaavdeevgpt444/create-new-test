function normalizeEstimatedMinutes_(value) {
  const minutes = Number(value || 0);
  if (!Number.isFinite(minutes) || minutes <= 0) return 30;
  if (minutes < 10) return 0;
  return Math.round(minutes / 5) * 5;
}

function normalizeTelegramNotifyType(value) {
  const normalized = String(value || '').trim().toLowerCase();
  if (!normalized || normalized === 'auto') return null;
  if (['coordination', 'recurring', 'focus', 'current', 'none'].includes(normalized)) return normalized;
  return null;
}

function getTelegramNotifyTypeSelectValue(value) {
  return normalizeTelegramNotifyType(value) || 'auto';
}

function normalizeOptionalTaskMinutes(value, max = 1440) {
  if (value === null || value === undefined || value === "") return null;
  const parsed = Number(value);
  if (!Number.isFinite(parsed)) throw new Error("minutes value must be a number");
  const rounded = Math.round(parsed);
  if (rounded < 1 || rounded > max) {
    throw new Error(`minutes value must be between 1 and ${max}`);
  }
  return rounded;
}

function getEffectivePlannedMinutesServer(taskLike) {
  const manual = normalizeOptionalTaskMinutes(taskLike?.planned_minutes_manual);
  if (manual !== null) return manual;
  return normalizeDurationMinutes(taskLike?.duration_minutes) ?? DEFAULT_EVENT_DURATION_FOR_SERVER();
}

