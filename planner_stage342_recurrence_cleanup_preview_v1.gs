      function bindSplitResize(handleId, applyWidth, getStartWidth, minPercent, maxPercent, containerId) {
        var handle = byId(handleId);
        var container = byId(containerId);
        if (!handle || !container || handle.dataset.boundSplitter) return;
        handle.dataset.boundSplitter = '1';
        handle.addEventListener('pointerdown', function (event) {
          if (window.matchMedia('(max-width: 960px)').matches) return;
          event.preventDefault();
          var startX = event.clientX;
          var startWidth = getStartWidth();
          var rect = container.getBoundingClientRect();
          function onMove(moveEvent) {
            var delta = moveEvent.clientX - startX;
            var nextPercent = startWidth + (delta / Math.max(rect.width, 1)) * 100;
            nextPercent = Math.max(minPercent, Math.min(maxPercent, nextPercent));
            applyWidth(nextPercent);
          }
          function onUp() {
            window.removeEventListener('pointermove', onMove);
            window.removeEventListener('pointerup', onUp);
            window.removeEventListener('pointercancel', onUp);
          }
          window.addEventListener('pointermove', onMove);
          window.addEventListener('pointerup', onUp);
          window.addEventListener('pointercancel', onUp);
        });
      }

      function bindHeightResize(handleId, applyHeight, getStartHeight, minPx, maxPx) {
        var handle = byId(handleId);
        if (!handle || handle.dataset.boundHeightSplitter) return;
        handle.dataset.boundHeightSplitter = '1';
        handle.addEventListener('pointerdown', function (event) {
          if (window.matchMedia('(max-width: 960px)').matches) return;
          event.preventDefault();
          var startY = event.clientY;
          var startHeight = getStartHeight();
          function onMove(moveEvent) {
            var delta = moveEvent.clientY - startY;
            var renderWindow = getCalendarRenderWindowHours();
            var nextHeight = startHeight + (delta / Math.max(renderWindow.endHour - renderWindow.startHour, 1));
            nextHeight = Math.max(minPx, Math.min(maxPx, nextHeight));
            applyHeight(nextHeight);
          }
          function onUp() {
            window.removeEventListener('pointermove', onMove);
            window.removeEventListener('pointerup', onUp);
            window.removeEventListener('pointercancel', onUp);
          }
          window.addEventListener('pointermove', onMove);
          window.addEventListener('pointerup', onUp);
          window.addEventListener('pointercancel', onUp);
        });
      }


