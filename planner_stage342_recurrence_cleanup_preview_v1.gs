async function getAiDayPlanningReview(env, payload) {
  const dayYmd = String(payload?.day_ymd || '').trim();
  const dayLabel = String(payload?.day_label || dayYmd || 'день').trim();
  const summary = payload?.summary || {};
  const tasks = Array.isArray(payload?.day_tasks) ? payload.day_tasks.slice(0, 20) : [];
  const capacityDays = Array.isArray(payload?.capacity_days) ? payload.capacity_days.slice(0, 7) : [];
  const weekContext = payload?.week_context || {};

  const tasksText = tasks.map((task, index) => {
    const parts = [
      `${index + 1}. ${String(task?.title || '').trim() || 'Без названия'}`,
      `время: ${String(task?.time_label || 'без времени')}`,
      `статус: ${String(task?.status_label || '—')}`,
      `проект: ${String(task?.project_name || 'Без проекта')}`,
      `приоритет: ${String(task?.priority_label || 'не задан')}`,
      `план: ${String(task?.planned_label || '—')}`,
      `факт: ${String(task?.actual_label || '—')}`,
      `внимание: ${task?.attention ? 'да' : 'нет'}`,
      `фокус-защита: ${task?.focus_protected ? 'да' : 'нет'}`
    ];
    if (task?.product) parts.push(`продукт: ${String(task.product)}`);
    return parts.join(' · ');
  }).join('\n');

  const capacityText = capacityDays.map((item) => [
    String(item?.day_label || 'день'),
    `план: ${String(item?.planned_label || '—')}`,
    `ёмкость: ${String(item?.capacity_label || '—')}`,
    `свободно/перегруз: ${String(item?.delta_label || '—')}`,
    `тон: ${item?.tone || 'neutral'}`
  ].join(' · ')).join('\n');

  const prompt = [
    'Ты AI-помощник внутри персонального планировщика.',
    'Отвечай только на русском языке.',
    'Верни только JSON по указанной схеме.',
    'Нужно сделать короткий review дня и подсказать безопасный следующий ход.',
    'Не придумывай новые данные, опирайся только на входные данные.',
    'Если день перегружен — предложи, что оставить, что перенести и куда логичнее сдвинуть.',
    '',
    `День: ${dayLabel}`,
    `Дата: ${dayYmd || 'не указана'}`,
    `Сводка дня: активных ${summary.active || 0}, выполнено ${summary.done || 0}, внимания ${summary.attention || 0}, плановая нагрузка ${summary.total_planned_label || '—'}, ёмкость ${summary.capacity_label || '—'}, свободно/перегруз ${summary.delta_label || '—'}.`,
    `Контекст недели: рисков ${weekContext.attention || 0}, backlog ${weekContext.backlog || 0}, перегружено дней ${weekContext.overflow_days || 0}.`,
    '',
    'Дни недели и ёмкость:',
    capacityText || 'Нет данных по неделе.',
    '',
    'Задачи дня:',
    tasksText || 'Нет задач дня.'
  ].join('\n');
  const schema = {
    type: 'object',
    properties: {
      summary_title: { type: 'string' },
      planning_note: { type: 'string' },
      best_move: { type: 'string' },
      overload_note: { type: 'string' },
      suggested_moves: { type: 'array', items: { type: 'string' } },
      next_actions: { type: 'array', items: { type: 'string' } },
      defer_candidates: { type: 'array', items: { type: 'string' } },
      best_target_day_ymd: { type: 'string' }
    },
    required: ['summary_title', 'planning_note', 'best_move', 'overload_note', 'suggested_moves', 'next_actions', 'defer_candidates', 'best_target_day_ymd']
  };
  const parsed = await callPlannerJsonWithSchema(env, {
    operation: 'day-planning-ai',
    user_id: payload?.user_id ? String(payload.user_id) : null,
    prompt,
    schema,
    temperature: 0.25,
  });

  const output = {
    summary_title: sanitizeAiHelpTextValue(parsed?.summary_title, '', 120),
    planning_note: sanitizeAiHelpTextValue(parsed?.planning_note, '', 320),
    best_move: sanitizeAiHelpTextValue(parsed?.best_move, '', 220),
    overload_note: sanitizeAiHelpTextValue(parsed?.overload_note, '', 220),
    suggested_moves: sanitizeAiHelpListValue(parsed?.suggested_moves, 4),
    next_actions: sanitizeAiHelpListValue(parsed?.next_actions, 4),
    defer_candidates: sanitizeAiHelpListValue(parsed?.defer_candidates, 4),
    best_target_day_ymd: String(parsed?.best_target_day_ymd || '').trim()
  };
  return attachAiProviderMetaFromSource(output, parsed);
}

