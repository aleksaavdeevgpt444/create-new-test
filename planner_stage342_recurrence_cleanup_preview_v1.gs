      async function deleteTask(taskId) {
        if (!taskId || !state.userId) return;
        var task = findTaskById(taskId);
        var taskTitle = task && task.title ? task.title : 'эту задачу';
        var isRecurringChain = !!(task && task.recurrence_series_id && Number(task.recurrence_enabled || 0) === 1);
        if (isRecurringChain) {
          if (state.editorTaskId !== taskId) openEditor(taskId);
          await deleteRecurringEditorTask('current');
          return;
        }
        var confirmText = ('Удалить задачу «' + taskTitle + '»? Это действие нельзя отменить.');
        var confirmed = await confirmPlannerAction({
          title: 'Удалить задачу',
          text: confirmText,
          confirmLabel: 'Удалить',
          confirmClassName: 'btn-delete'
        });
        if (!confirmed) return;

        state.requestState = 'удаление-задачи';
        updateDebugInfo();
        showError('');

        try {
          await requestJson('/tasks/delete', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ task_id: taskId, user_id: state.userId })
          });
          if (state.moveModeTaskId === taskId) exitMoveMode();
          if (state.editorTaskId === taskId) closeEditor();
          await loadPlanner();
        } catch (error) {
          state.requestState = 'error';
          updateDebugInfo();
          showError(String(error));
        }
      }


      async function duplicateEditorTaskFromDialog(options) {
        options = options || {};
        if (!state.editorTaskId || !state.userId) return;
        var sourceTask = findTaskById(state.editorTaskId);
        if (!sourceTask) return;

        var title = String((byId('editorTitleInput') && byId('editorTitleInput').value) || sourceTask.title || '').trim();
        if (!title) {
          showError('Название задачи не может быть пустым.');
          return;
        }

        var projectName = getProjectValueFromUi('editor') || sourceTask.project_name || 'Без проекта';
        var taskProduct = String((byId('editorProductInput') && byId('editorProductInput').value) || sourceTask.task_product || '').trim();
        var description = String((byId('editorDescriptionInput') && byId('editorDescriptionInput').value) || sourceTask.description || '').trim();
        var priorityManual = byId('editorPrioritySelect')
          ? String(byId('editorPrioritySelect').value || sourceTask.priority_manual || '').trim()
          : String(sourceTask.priority_manual || '').trim();
        var telegramNotifyType = byId('editorTelegramNotifyTypeSelect')
          ? String(byId('editorTelegramNotifyTypeSelect').value || getTelegramNotifyTypeSelectValue(sourceTask.telegram_notify_type)).trim()
          : getTelegramNotifyTypeSelectValue(sourceTask.telegram_notify_type);
        var plannedMinutesManual = getEditorPlannedMinutesManualValue();
        var checklistItems = [];
        var dueAtIso = null;
        var dateValue = options.dateValue || '';
        var timeValue = options.timeValue || '';
        var durationValue = snapDurationToStep(options.durationValue || (byId('editorDurationInput') && byId('editorDurationInput').value) || sourceTask.duration_minutes || DEFAULT_EVENT_DURATION_MIN);
        var recurrenceEnabled = Number(options.recurrenceEnabled || 0);
        var recurrenceType = recurrenceEnabled === 1 ? String(options.recurrenceType || '') : '';
        var recurrenceRule = recurrenceEnabled === 1 ? String(options.recurrenceRule || '') : '';

        if (dateValue && timeValue) {
          dueAtIso = makeDueAtIso(dateValue, timeValue);
        }

        state.requestState = 'копирование-задачи';
        updateDebugInfo();
        showError('');

        try {
          var created = await requestJson('/tasks/create', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              user_id: state.userId,
              title: title,
              project_name: projectName || 'Без проекта',
              task_product: taskProduct || '',
              priority_manual: priorityManual || null,
              telegram_notify_type: telegramNotifyType === 'auto' ? null : telegramNotifyType,
              description: description || '',
              due_at: dueAtIso,
              duration_minutes: durationValue,
              planned_minutes_manual: plannedMinutesManual,
              recurrence_type: recurrenceType || null,
              recurrence_rule: recurrenceRule || null,
              recurrence_enabled: recurrenceEnabled ? 1 : 0,
              source: sourceTask.source || (state.authMode === 'telegram' ? 'mini-app' : 'web-app')
            })
          });

          var createdTask = created && created.item ? created.item : null;
          var newTaskId = createdTask && createdTask.id ? createdTask.id : null;
          if (!newTaskId) throw new Error('Не удалось создать копию задачи.');

          try {
            var listData = await requestJson('/tasks/checklist?task_id=' + encodeURIComponent(sourceTask.id) + '&user_id=' + encodeURIComponent(state.userId), { method: 'GET' });
            checklistItems = (listData && listData.items) ? listData.items : [];
          } catch (checklistError) {
            checklistItems = [];
          }

          for (var i = 0; i < checklistItems.length; i += 1) {
            var itemText = String(checklistItems[i] && checklistItems[i].text || '').trim();
            if (!itemText) continue;
            await requestJson('/tasks/checklist/add', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ task_id: newTaskId, user_id: state.userId, text: itemText })
            });
          }

          await loadPlanner();
          openEditor(newTaskId);

          requestJson('/tasks/refresh-ai', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ task_id: newTaskId, user_id: state.userId })
          }).then(function () {
            return loadPlanner();
          }).then(function () {
            if (state.editorTaskId === newTaskId) openEditor(newTaskId);
          }).catch(function () {});
        } catch (error) {
          state.requestState = 'error';
          updateDebugInfo();
          showError(String(error));
        }
      }

      function openDuplicateTaskDialog() {
        if (!state.editorTaskId) return;
        var currentTask = findTaskById(state.editorTaskId);
        if (!currentTask) return;
        var dateValue = parseDisplayDateToYmd(String((byId('editorDateInput') && byId('editorDateInput').value) || '').trim());
        var timeValue = String((byId('editorTimeInput') && byId('editorTimeInput').value) || '').trim();
        var fallbackDateValue = '';
