      function syncTimeDialogTriggers(scope) {
        ['DateInput','TimeInput','DurationInput'].forEach(function (suffix) {
          var field = byId(scope + suffix);
          if (!field) return;
          field.classList.add('time-dialog-trigger');
        });
      }

      function parseDisplayDateToYmd(value) {
        var raw = String(value || '').trim();
        if (!raw) return '';
        if (/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(raw)) return raw;
        if (/^[0-9]{2}[.][0-9]{2}[.][0-9]{2}$/.test(raw)) {
          var parts = raw.split('.');
          return '20' + parts[2] + '-' + parts[1] + '-' + parts[0];
        }
        if (/^[0-9]{2}[.][0-9]{2}[.][0-9]{4}$/.test(raw)) {
          var p = raw.split('.');
          return p[2] + '-' + p[1] + '-' + p[0];
        }
        return raw;
      }
      function buildTimeSummaryDisplay(dateValue, timeValue, durationValue, recurrenceType, recurrenceEnabled) {
        var normalizedDate = parseDisplayDateToYmd(dateValue);
        var dateText = normalizedDate ? formatDateShortDisplay(normalizedDate) : 'Без даты';
        var timeText = timeValue || 'Без времени';
        var durationText = formatDurationLabel(Number(durationValue) || DEFAULT_EVENT_DURATION_MIN);
        var recurrenceText = recurrenceEnabled && recurrenceType ? (' · ' + recurrenceLabel(recurrenceType)) : '';
        return {
          main: normalizedDate ? (dateText + ' · ' + timeText) : (timeValue ? ('— · ' + timeText) : 'Дата и время не выбраны'),
          sub: 'Длительность: ' + durationText + recurrenceText
        };
      }

      function getFallbackScheduleContext(scope) {
        if (scope === 'editor' && state.editorCurrentTaskSnapshot) {
          var dueAt = state.editorCurrentTaskSnapshot.due_at || null;
          if (dueAt) {
            var dueDate = new Date(dueAt);
            if (!isNaN(dueDate.getTime())) {
              return {
                dateValue: formatDateShortDisplay(dueDate),
                timeValue: String(dueDate.getHours()).padStart(2, '0') + ':' + String(dueDate.getMinutes()).padStart(2, '0'),
                durationValue: String(Math.max(Number(state.editorCurrentTaskSnapshot.duration_minutes) || DEFAULT_EVENT_DURATION_MIN, state.gridStepMinutes || 5)),
                recurrenceType: state.editorCurrentTaskSnapshot.recurrence_type || '',
                recurrenceRule: state.editorCurrentTaskSnapshot.recurrence_rule || '',
                recurrenceEnabled: String(state.editorCurrentTaskSnapshot.recurrence_enabled ? 1 : 0)
              };
            }
          }
        }
        if (scope === 'create' && state.createPrefillSlot) {
          return {
            dateValue: state.createPrefillSlot.dayYmd ? formatDateShortDisplay(state.createPrefillSlot.dayYmd) : '',
            timeValue: state.createPrefillSlot.time || '',
            durationValue: String(state.createPrefillSlot.durationMinutes || DEFAULT_EVENT_DURATION_MIN),
            recurrenceType: '',
            recurrenceRule: '',
            recurrenceEnabled: '0'
          };
        }
        return null;
      }

      function updateTimeSummary(scope) {
        var dateInput = byId(scope + 'DateInput');
        var timeInput = byId(scope + 'TimeInput');
        var durationInput = byId(scope + 'DurationInput');
        var typeHidden = byId(scope + 'RecurrenceTypeInput');
        var enabledHidden = byId(scope + 'RecurrenceEnabledInput');
        var button = byId(scope + 'TimeSummaryBtn');
        var main = byId(scope + 'TimeSummaryMain');
        var sub = byId(scope + 'TimeSummarySub');
        if (!dateInput || !timeInput || !durationInput) return;
        var dateValue = String(dateInput.value || '').trim();
        var timeValue = String(timeInput.value || '').trim();
        var durationValue = durationInput.value;
        var recurrenceType = typeHidden && typeHidden.value;
        var recurrenceEnabled = Number(enabledHidden && enabledHidden.value || 0);
        var normalizedDate = parseDisplayDateToYmd(dateValue);
        if ((!normalizedDate || (!timeValue && scope === 'editor')) && scope === 'editor' && state.editorCurrentTaskSnapshot && state.editorCurrentTaskSnapshot.due_at) {
          var dueDate = new Date(state.editorCurrentTaskSnapshot.due_at);
          if (!isNaN(dueDate.getTime())) {
            normalizedDate = normalizedDate || formatYmdLocal(dueDate);
            timeValue = timeValue || (String(dueDate.getHours()).padStart(2, '0') + ':' + String(dueDate.getMinutes()).padStart(2, '0'));
            durationValue = durationValue || String(Math.max(Number(state.editorCurrentTaskSnapshot.duration_minutes) || DEFAULT_EVENT_DURATION_MIN, state.gridStepMinutes || 5));
            if (!dateInput.value) dateInput.value = normalizedDate;
            if (!timeInput.value) timeInput.value = timeValue;
            if (!durationInput.value) durationInput.value = durationValue;
          }
        }
        if (!normalizedDate || (!timeValue && scope === 'editor')) {
          var fallback = getFallbackScheduleContext(scope);
          if (fallback) {
            normalizedDate = normalizedDate || parseDisplayDateToYmd(fallback.dateValue || '') || '';
            timeValue = timeValue || fallback.timeValue || '';
            durationValue = fallback.durationValue || durationValue;
            recurrenceType = fallback.recurrenceType || recurrenceType;
            recurrenceEnabled = Number(fallback.recurrenceEnabled || recurrenceEnabled || 0);
            if (dateInput && !dateInput.value && normalizedDate) dateInput.value = normalizedDate;
            if (timeInput && !timeInput.value) timeInput.value = timeValue;
            if (durationInput && !durationInput.value) durationInput.value = durationValue;
          }
        }
        var summary = buildTimeSummaryDisplay(normalizedDate || dateValue, timeValue, durationValue, recurrenceType, recurrenceEnabled);
        if (main) main.textContent = summary.main;
        if (sub) sub.textContent = summary.sub;
        if (button) button.classList.toggle('is-empty', !(normalizedDate || timeValue));
      }

      function suppressClicks(ms) {
