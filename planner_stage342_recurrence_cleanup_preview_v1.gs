      function hydrateDayBlockTemplatesFromServer() {
        if (!state.userId) return Promise.resolve(null);
        return requestDayBlockTemplatesFromServer().then(function (data) {
          if (!data) return null;
          var items = Array.isArray(data.items) ? data.items : [];
          if (items.length) {
            applyDayBlockTemplatesFromServerItems(items);
            setServerSyncState('dayBlockTemplatesSyncState', { source: 'server', status: 'loaded', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'templates' });
            return data;
          }
          var localTemplates = Array.isArray(state.dayBlockTemplates) ? state.dayBlockTemplates : loadStoredDayBlockTemplates();
          var hasMeaningfulLocalChanges = (localTemplates || []).length > 0 || loadDayBlockTemplatesServerSyncUserId() !== String(state.userId || '');
          if (!hasMeaningfulLocalChanges) {
            state.dayBlockTemplates = [];
            saveStoredDayBlockTemplates();
            saveDayBlockTemplatesServerSyncUserId(String(state.userId || ''));
            setServerSyncState('dayBlockTemplatesSyncState', { source: 'server', status: 'loaded', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'templates' });
            return data;
          }
          return persistDayBlockTemplatesBulkToServer(localTemplates, { silent: true }).then(function (saved) {
            if (saved) setServerSyncState('dayBlockTemplatesSyncState', { source: 'migrated', status: 'migrated', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'templates' });
            return saved || data;
          });
        }).catch(function () {
          setServerSyncState('dayBlockTemplatesSyncState', { source: 'fallback', status: 'fallback', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'templates' });
          return null;
        });
      }

      function persistDayBlockTemplatesBulkToServer(templates, options) {
        var queue = (Array.isArray(templates) ? templates : []).map(normalizeDayBlockTemplate).filter(Boolean);
        if (!queue.length || !state.userId) return Promise.resolve(null);
        var chain = Promise.resolve();
        queue.forEach(function (template) {
          chain = chain.then(function () { return persistDayBlockTemplateToServer(template, { silent: true }); });
        });
        return chain.then(function () {
          saveDayBlockTemplatesServerSyncUserId(String(state.userId || ''));
          return requestDayBlockTemplatesFromServer();
        }).then(function (data) {
          if (data && Array.isArray(data.items)) applyDayBlockTemplatesFromServerItems(data.items, { skipSyncMarker: true });
          return data;
        }).catch(function (error) {
          if (!(options && options.silent)) throw error;
          return null;
        });
