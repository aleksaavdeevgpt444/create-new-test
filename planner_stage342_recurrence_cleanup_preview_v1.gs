        if (input.complexity === complexity) score += 3;
        if (input.complexity === 'low' && complexity === 'medium') score -= 1;
        if (input.complexity === 'high' && complexity === 'low') score -= 1;
        return score;
      }

      function buildInteractiveRecommenderResult(inputValue) {
        var input = normalizeKnowledgeRecommenderInput(inputValue || loadKnowledgeRecommenderInput());
        var roles = buildRoleRecommendationRows().map(function (row) { return Object.assign({}, row, { interactiveScore: scoreRoleForInteractiveInput(row, input) }); }).sort(function (a, b) { return b.interactiveScore - a.interactiveScore; });
        var bundles = buildBundleRecommendationRows().map(function (row) { return Object.assign({}, row, { interactiveScore: scoreBundleForInteractiveInput(row, input) }); }).sort(function (a, b) { return b.interactiveScore - a.interactiveScore; });
        var bestRole = roles[0] || null;
        var bestBundle = bundles[0] || null;
        var frameworks = [];
        if (bestRole && Array.isArray(bestRole.preferredFrameworks)) frameworks = frameworks.concat(bestRole.preferredFrameworks);
        if (bestBundle && Array.isArray(bestBundle.frameworks)) frameworks = frameworks.concat(bestBundle.frameworks);
        frameworks = frameworks.filter(function (id, index, arr) { return id && arr.indexOf(id) === index; });
        var active = (buildKnowledgeCenterState().activeFrameworkIds || []);
        var toAdd = frameworks.filter(function (id) { return active.indexOf(id) < 0; });
        var reasons = [];
        reasons.push('Тип работы: ' + getKnowledgeInteractiveLabel(input.workType) + '.');
        reasons.push('Главный запрос: ' + getKnowledgeInteractiveLabel(input.planningNeed) + ', входящие: ' + getKnowledgeInteractiveLabel(input.incomingLoad).toLowerCase() + '.');
        if (bestRole) reasons.push('Роль-кандидат: ' + bestRole.title + ' — лучше всего совпадает с выбранным режимом.');
        if (bestBundle) reasons.push('Связка-кандидат: ' + bestBundle.title + ' — ' + (bestBundle.explainWhy || bestBundle.summary || 'подходит по текущему профилю.'));
        if (toAdd.length) reasons.push('Для усиления можно добавить: ' + toAdd.map(getFrameworkTitle).join(', ') + '.');
        return { input: input, roles: roles, bundles: bundles, bestRole: bestRole, bestBundle: bestBundle, frameworks: frameworks, toAdd: toAdd, reasons: reasons };
      }

