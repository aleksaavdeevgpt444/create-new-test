        return normalizeKnowledgeRecommenderInput({ workType: byId('kcpWorkTypeSelect') ? byId('kcpWorkTypeSelect').value : '', incomingLoad: byId('kcpIncomingLoadSelect') ? byId('kcpIncomingLoadSelect').value : '', planningNeed: byId('kcpPlanningNeedSelect') ? byId('kcpPlanningNeedSelect').value : '', teamMode: byId('kcpTeamModeSelect') ? byId('kcpTeamModeSelect').value : '', complexity: byId('kcpComplexitySelect') ? byId('kcpComplexitySelect').value : '' });
