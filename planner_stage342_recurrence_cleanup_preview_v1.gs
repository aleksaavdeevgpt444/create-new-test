    payload?.plan_fact_delta_minutes !== undefined && payload?.plan_fact_delta_minutes !== null ? 'Отклонение план/факт, минут: ' + String(payload.plan_fact_delta_minutes).trim() : 'Отклонение план/факт, минут: '
  ].join('\n');

  const startedAt = Date.now();
  try {
    const semanticHints = await buildAiSemanticHintsText(env, {
      userId: payload?.user_id ? String(payload.user_id) : null,
      taskId: payload?.task_id ? String(payload.task_id) : null,
      text: parts,
      label: 'Похожие прошлые задачи по смыслу'
    });

    const prompt = [
      'Нужно сделать полезный AI-разбор задачи для старта исполнения.',
      'Верни только JSON.',
      'Нужны поля: summary_title, next_step, start_action, first_visible_result, start_in_5_minutes, blockers, missing_data, missing_decisions, mini_plan, decomposition_steps, focus_minutes, execution_mode, confidence, confidence_reason, dependency_note, risk_note.',
      'Каждый совет должен быть конкретным и исполнимым без дополнительной расшифровки.',
      'Не используй пустые советы без объекта действия.',
      'focus_minutes может быть только 15, 25 или 50.',
      '',
      'Данные задачи:',
      parts,
      semanticHints ? '\n' + semanticHints : ''
    ].join('\n');
    const schema = {
      type: 'object',
      properties: {
        summary_title: { type: 'string' },
        next_step: { type: 'string' },
        start_action: { type: 'string' },
        first_visible_result: { type: 'string' },
        start_in_5_minutes: { type: 'string' },
        blockers: { type: 'array', items: { type: 'string' } },
        missing_data: { type: 'array', items: { type: 'string' } },
        missing_decisions: { type: 'array', items: { type: 'string' } },
        mini_plan: { type: 'array', items: { type: 'string' } },
        decomposition_steps: { type: 'array', items: { type: 'string' } },
        focus_minutes: { type: 'number' },
        execution_mode: { type: 'string' },
        confidence: { type: 'string' },
        confidence_reason: { type: 'string' },
        dependency_note: { type: 'string' },
        risk_note: { type: 'string' }
      },
      required: ['summary_title', 'next_step', 'start_action', 'first_visible_result', 'start_in_5_minutes', 'blockers', 'missing_data', 'missing_decisions', 'mini_plan', 'decomposition_steps', 'focus_minutes', 'execution_mode', 'confidence', 'confidence_reason', 'dependency_note', 'risk_note']
    };

    return await callPlannerJsonWithSchema(env, {
      operation: 'next-step-ai',
      user_id: payload?.user_id ? String(payload.user_id) : null,
      prompt,
      schema,
      temperature: 0.2,
    });
  } catch (error) {
    if (!isAiSoftFallbackError(error)) throw error;
    const fallback = buildTaskExecutionHelpFallback(payload || {});
    const normalized = attachLocalAiFallbackMeta(env, 'next-step-ai', fallback, error, { startedAt, requestId: 'local-next-step-ai-' + Date.now() });
    await logAiLocalFallback(env, 'next-step-ai', payload || {}, error, getAiProviderMeta(normalized), 'AI task execution help soft fallback used');
    return normalized;
  }
}

function buildTaskExecutionHelpFallback(payload) {
  const title = trimAiText(payload?.title, 'задачу');
  const blockedByTitle = trimAiText(payload?.blocked_by_title);
  const inferredProject = inferProjectSuggestionFromText(payload || {});
  const guidance = getTaskExecutionConcreteGuidance(payload || {});
  const blockers = blockedByTitle ? ['Задача зависит от: ' + blockedByTitle] : [];
  const missingData = [];
  const missingDecisions = [];
  if (!trimAiText(payload?.task_product)) missingData.push('Сформулируй продукт задачи');
  if (!trimAiText(payload?.project_name) && inferredProject) missingData.push('Подтверди проект «' + inferredProject + '»');
  else if (!trimAiText(payload?.project_name)) missingData.push('Выбери проект или направление');
  if (!trimAiText(payload?.description)) missingData.push('Добавь краткий контекст в описание');
  if (!trimAiText(payload?.task_product)) missingDecisions.push('Что считается готовым результатом задачи');
  if (!trimAiText(payload?.project_name) && inferredProject) missingDecisions.push('Подходит ли проект «' + inferredProject + '» для этой задачи');
  else if (!trimAiText(payload?.project_name)) missingDecisions.push('К какому проекту или направлению относится задача');

  if (guidance) {
    const miniPlan = guidance.miniPlan.slice(0, 4);
    if (!trimAiText(payload?.project_name) && inferredProject) miniPlan.unshift('Подтверди проект «' + inferredProject + '»');
    return {
      summary_title: guidance.summaryTitle,
      next_step: guidance.nextStep,
      start_action: guidance.startAction,
      first_visible_result: guidance.firstVisibleResult,
      start_in_5_minutes: guidance.startInFiveMinutes,
      blockers,
      missing_data: missingData.slice(0, 5),
      missing_decisions: missingDecisions.slice(0, 4),
      mini_plan: miniPlan,
      decomposition_steps: guidance.decompositionSteps.slice(0, 5),
      focus_minutes: guidance.focusMinutes || 25,
      execution_mode: guidance.executionMode || 'Пошаговый старт',
      confidence: blockers.length || missingData.length ? 'средняя' : 'высокая',
      confidence_reason: blockers.length || missingData.length ? 'Использован локальный fallback: сценарий старта собран по содержанию задачи, но часть полей ещё требует подтверждения.' : 'Использован локальный fallback: практический сценарий старта собран по содержанию задачи.',
      dependency_note: blockedByTitle ? ('Для старта сначала нужно продвинуть задачу-блокер: ' + blockedByTitle + '.') : 'Явных зависимостей для старта не найдено.',
      risk_note: 'Убедись, что перед стартом подтверждены проект, результат и основные ограничения задачи.'
    };
  }

  return {
    summary_title: 'Сначала уточни рабочую формулировку задачи',
    next_step: 'Сформулируй ближайший конкретный шаг по задаче «' + title + '» с указанием, что именно нужно открыть или зафиксировать.',
    start_action: 'Открой материалы по задаче и выпиши первый физический шаг без общих слов.',
    first_visible_result: 'Появился первый зафиксированный промежуточный результат по задаче.',
    start_in_5_minutes: 'За 5 минут выпиши первый конкретный шаг и один ожидаемый промежуточный результат.',
    blockers,
    missing_data: missingData.slice(0, 5),
    missing_decisions: missingDecisions.slice(0, 4),
    mini_plan: ['Уточнить результат задачи', 'Определить первый шаг', 'Подтвердить проект или направление'],
    decomposition_steps: ['Уточнить результат', 'Определить первый шаг', 'Подтвердить проект'],
    focus_minutes: 25,
    execution_mode: 'Пошаговый старт',
    confidence: 'средняя',
    confidence_reason: 'Использован локальный fallback без ответа AI.',
    dependency_note: blockedByTitle ? ('Задача зависит от: ' + blockedByTitle + '.') : 'Явных зависимостей для старта не найдено.',
    risk_note: 'При необходимости уточни формулировку задачи перед запуском.'
  };
}

function isAiSoftFallbackError(error) {
  if (!error) return false;
  if (error && error.name === 'AbortError') return true;
  if (error && error.__transportError) return true;
  if (error && error.__serverResponse && Number(error.__status || 0) > 0 && Number(error.__status || 0) < 500 && Number(error.__status || 0) !== 429) return false;
  const classified = classifyAiProviderError(error);
  if (classified && ['timeout', 'quota_exceeded', 'rate_limited', 'empty_response', 'invalid_response', 'not_configured'].includes(classified.status)) return true;
  const text = String(error && error.message ? error.message : error || '').toLowerCase();
  return /quota|429|resource_exhausted|rate limit|gemini|gemma|groq|qwen|invalid json|empty response|provider chain failed|provider is not available|sanitizeaihelp|normalizeaifocusminutes|timeout|network|transport|fetch failed|aborted/.test(text);
}

function buildLocalAiProviderMeta(env, operation, error, options = {}) {
  const classified = classifyAiProviderError(error);
  const startedAt = Number(options && options.startedAt) || Date.now();
  const durationMs = Math.max(0, Date.now() - startedAt);
  return {
    request_id: String(options && options.requestId || ('local-' + Date.now())),
    provider: 'local_fallback',
    label: 'Local fallback',
    model: 'local-rules-v1',
    channel: 'local',
    operation: operation ? String(operation) : 'ai',
    attempt: Number(options && options.attempt) || 0,
    chain_label: 'Gemini → Gemma → Qwen → Local fallback',
    duration_ms: durationMs,
    fallback: true,
    fallback_reason: classified && classified.status ? String(classified.status) : 'error',
    provider_error: classified && classified.message ? String(classified.message) : String(error && error.message ? error.message : error || '')
  };
}

function attachLocalAiFallbackMeta(env, operation, payload, error, options = {}) {
  return attachAiProviderMeta(payload, buildLocalAiProviderMeta(env, operation, error, options));
}

async function logAiLocalFallback(env, endpointName, body, error, aiMeta, message) {
  const details = Object.assign(
    {},
    summarizeAiPayloadForReport(body || {}),
    {
      ai_module_version: AI_MODULE_VERSION,
      ai_provider: aiMeta && aiMeta.provider ? String(aiMeta.provider) : 'local_fallback',
      ai_provider_label: aiMeta && aiMeta.label ? String(aiMeta.label) : 'Local fallback',
      ai_model: aiMeta && aiMeta.model ? String(aiMeta.model) : 'local-rules-v1',
      ai_chain: aiMeta && aiMeta.chain_label ? String(aiMeta.chain_label) : 'Gemini → Gemma → Qwen → Local fallback',
      ai_fallback: true,
      ai_fallback_reason: aiMeta && aiMeta.fallback_reason ? String(aiMeta.fallback_reason) : null,
      ai_provider_error: aiMeta && aiMeta.provider_error ? String(aiMeta.provider_error) : null
    }
  );
  await writeAiDiagnosticsLog(env, {
    user_id: body && body.user_id ? String(body.user_id) : null,
    endpoint: endpointName,
    operation: endpointName,
    severity: 'warning',
    status: 'soft_fallback',
    message: message ? String(message) : 'AI provider chain unavailable, local fallback used',
    details
  });
}

function buildAiEndpointResponseMeta(aiMeta) {
  return {
    ai_request_id: aiMeta && aiMeta.request_id ? String(aiMeta.request_id) : null,
    ai_provider: aiMeta && aiMeta.provider ? String(aiMeta.provider) : null,
    ai_provider_label: aiMeta && aiMeta.label ? String(aiMeta.label) : null,
    ai_provider_chain: aiMeta && aiMeta.chain_label ? String(aiMeta.chain_label) : null,
    ai_model: aiMeta && aiMeta.model ? String(aiMeta.model) : null,
    ai_channel: aiMeta && aiMeta.channel ? String(aiMeta.channel) : null,
    ai_fallback: !!(aiMeta && aiMeta.fallback),
    ai_fallback_reason: aiMeta && aiMeta.fallback_reason ? String(aiMeta.fallback_reason) : null,
    ai_provider_errors: aiMeta && Array.isArray(aiMeta.provider_errors) ? aiMeta.provider_errors.slice(0, 6) : null,
    ai_chain_timeout_ms: aiMeta && Number.isFinite(Number(aiMeta.chain_timeout_ms)) ? Math.round(Number(aiMeta.chain_timeout_ms)) : null,
    ai_provider_timeout_ms: aiMeta && Number.isFinite(Number(aiMeta.provider_timeout_ms)) ? Math.round(Number(aiMeta.provider_timeout_ms)) : null
  };
}

function buildAiEndpointSuccessPayload(payloadKey, payloadValue, aiMeta, extra = {}) {
  const response = Object.assign({
    ok: true,
    build: getClientAppBuildLabel(),
    ai_module_version: AI_MODULE_VERSION,
    generated_at: new Date().toISOString()
  }, buildAiEndpointResponseMeta(aiMeta), extra || {});
  response[payloadKey] = payloadValue;
  return response;
}

function buildAiEndpointFailurePayload(error, report, fallbackText = 'AI request failed') {
  const classified = classifyAiProviderError(error);
  const aiMeta = error && typeof error === 'object' && (error.ai_request_id || error.ai_provider_chain)
    ? {
        request_id: error.ai_request_id ? String(error.ai_request_id) : null,
        chain_label: error.ai_provider_chain ? String(error.ai_provider_chain) : null,
        fallback: false,
        fallback_reason: classified && classified.status ? String(classified.status) : null,
        provider_errors: error.ai_provider_errors && Array.isArray(error.ai_provider_errors) ? error.ai_provider_errors.slice(0, 6) : null,
        chain_timeout_ms: Number.isFinite(Number(error.ai_chain_timeout_ms)) ? Number(error.ai_chain_timeout_ms) : null,
        provider_timeout_ms: Number.isFinite(Number(error.ai_provider_timeout_ms)) ? Number(error.ai_provider_timeout_ms) : null
      }
    : null;
  return Object.assign({
    ok: false,
    build: getClientAppBuildLabel(),
    ai_module_version: AI_MODULE_VERSION,
    error: report && report.sent ? (fallbackText + '. Report sent to Telegram.') : (fallbackText + '. Telegram report was not delivered.'),
    error_code: classified && classified.status ? String(classified.status) : 'error',
    details: error && error.message ? String(error.message) : String(error),
    telegram_report: report || null,
    ai_error_summary: aiMeta && aiMeta.provider_errors ? aiMeta.provider_errors.join(' | ') : null
  }, buildAiEndpointResponseMeta(aiMeta));
}

function buildLocalTaskAdvice(taskText, options = {}) {
  const sourceText = String(taskText || '').trim();
  const normalized = sourceText.toLowerCase();
  let priorityLevel = 'medium';
  if (/срочно|сегодня|дедлайн|критич|urgent|asap/.test(normalized)) priorityLevel = 'high';
  else if (/идея|когда[- ]нибудь|позже|не срочно|на потом|если будет время/.test(normalized)) priorityLevel = 'low';
  const projectGuess = normalizeAiProjectSuggestion(options && options.project_name ? String(options.project_name) : '', '') || inferProjectSuggestionFromText({ title: sourceText, description: sourceText });
  const guidance = getTaskExecutionConcreteGuidance({ title: sourceText, project_name: projectGuess || '' });
  return {
    priority_level: priorityLevel,
    priority_reason: priorityLevel === 'high'
      ? 'В формулировке есть признаки срочности или близкого дедлайна.'
      : (priorityLevel === 'low'
        ? 'Формулировка больше похожа на отложенную или несрочную задачу.'
        : 'В формулировке нет явных признаков высокой или низкой срочности.'),
    project_guess: projectGuess || '',
    next_step: guidance && guidance.nextStep ? guidance.nextStep : 'Уточни первый конкретный следующий шаг по задаче.',
    search_queries: [],
    needs_web_search: false,
    fallback_used: true
  };
}

async function handleTaskNextStepAiApi(request, env) {
  if (request.method !== 'POST') return textResponse('Method Not Allowed', 405);

  /** @type {{ [key: string]: any, user_id?: string }} */
  let body = {};
  const startedAt = Date.now();
  try {
    body = await request.json();
    const help = await getAiTaskExecutionHelp(env, body || {});
    const aiMeta = getAiProviderMeta(help);
    try {
      await logAiEndpointSuccess(env, 'next-step-ai', body, { ai_module_version: AI_MODULE_VERSION, ai_provider: aiMeta && aiMeta.provider || null, ai_model: aiMeta && aiMeta.model || null, ai_chain: aiMeta && aiMeta.chain_label || null, ai_fallback: !!(aiMeta && aiMeta.fallback), ai_fallback_reason: aiMeta && aiMeta.fallback_reason || null });
    } catch (logError) {
      console.warn('[planner-ai] next-step-ai success log failed', logError);
    }
    return jsonResponse(buildAiEndpointSuccessPayload('help', help, aiMeta));
  } catch (error) {
    let report = null;
    try {
      report = await reportAiEndpointFailure(env, request, 'next-step-ai', body, error);
    } catch (reportError) {
      report = { ok: false, sent: false, reason: 'report_exception', delivered_count: 0, failed_count: 0, chat_ids: [], error: reportError && reportError.message ? String(reportError.message) : String(reportError) };
    }
    const fallback = buildTaskExecutionHelpFallback(body || {});
    const normalized = attachLocalAiFallbackMeta(env, 'next-step-ai', fallback, error, { startedAt, requestId: 'route-fallback-next-step-ai-' + Date.now() });
    const aiMeta = getAiProviderMeta(normalized);
    try {
      await logAiLocalFallback(env, 'next-step-ai', body || {}, error, aiMeta, 'AI next-step endpoint hard fallback used');
    } catch (fallbackLogError) {
      console.warn('[planner-ai] next-step-ai fallback log failed', fallbackLogError);
    }
    return jsonResponse(buildAiEndpointSuccessPayload('help', normalized, aiMeta, {
      ai_endpoint_fallback: true,
      ai_endpoint_error: error && error.message ? String(error.message) : String(error),
      telegram_report: report || null
    }));
  }
}

function summarizeAiPayloadForReport(payload) {
  const title = trimErrorReportText(String(payload?.title || '').trim(), 180);
  const projectName = trimErrorReportText(String(payload?.project_name || '').trim(), 120);
  const description = trimErrorReportText(String(payload?.description || '').trim(), 240);
  const taskProduct = trimErrorReportText(String(payload?.task_product || '').trim(), 180);
  const taskId = trimErrorReportText(String(payload?.task_id || '').trim(), 80);
  const userId = trimErrorReportText(String(payload?.user_id || '').trim(), 80);
  return {
    user_id: userId || null,
    task_id: taskId || null,
    title: title || null,
    project_name: projectName || null,
    description: description || null,
    task_product: taskProduct || null,
  };
}

async function reportAiEndpointFailure(env, request, endpointName, body, error) {
  try {
    const url = new URL(request.url);
    const aiErrorMeta = error && typeof error === 'object'
      ? /** @type {{ ai_request_id?: string, ai_provider_chain?: string, ai_provider_errors?: string[] }} */ (error)
      : null;
    await writeAiDiagnosticsLog(env, {
      user_id: body?.user_id ? String(body.user_id) : null,
      endpoint: endpointName,
      operation: endpointName,
      severity: 'error',
      status: 'error',
      message: error && error.message ? String(error.message) : String(error),
      details: { request_path: url.pathname + (url.search || ''), payload: summarizeAiPayloadForReport(body || {}), ai_request_id: aiErrorMeta && aiErrorMeta.ai_request_id ? String(aiErrorMeta.ai_request_id) : null, ai_provider_chain: aiErrorMeta && aiErrorMeta.ai_provider_chain ? String(aiErrorMeta.ai_provider_chain) : null, ai_provider_errors: aiErrorMeta && aiErrorMeta.ai_provider_errors ? aiErrorMeta.ai_provider_errors : null }
    });
    return await reportTelegramError(env, {
      source: 'ai-endpoint',
      phase: endpointName,
      method: request.method,
      path: url.pathname + (url.search || ''),
      status: 500,
      userId: body?.user_id ? String(body.user_id) : null,
      message: endpointName + ' failed',
      errorText: normalizeErrorTextForReport(error),
      timestamp: new Date().toISOString(),
      url: request.url,
      extra: summarizeAiPayloadForReport(body || {}),
      fallbackChatId: body?.user_id ? String(body.user_id) : null,
    });
  } catch (reportError) {
    return { ok: false, sent: false, reason: 'report_exception', delivered_count: 0, failed_count: 0, chat_ids: [], error: reportError && reportError.message ? String(reportError.message) : String(reportError) };
  }
}

async function logAiEndpointSuccess(env, endpointName, body, extra = {}) {
  return writeAiDiagnosticsLog(env, {
    user_id: body?.user_id ? String(body.user_id) : null,
    endpoint: endpointName,
    operation: endpointName,
    severity: 'info',
    status: 'success',
    message: extra && extra.message ? String(extra.message) : 'AI request ok',
    details: Object.assign({}, summarizeAiPayloadForReport(body || {}), extra || {})
  });
}

