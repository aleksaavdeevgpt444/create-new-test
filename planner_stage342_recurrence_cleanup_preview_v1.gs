        var guide = getKnowledgeStrategicEngineGuide(method && method.id);
        if (!guide) return '';
        var enabled = isStrategicMethodEnabled(bridgeState.settings, method.id);
        var projectDefault = bridgeState.settings.defaults && bridgeState.settings.defaults.projectMethod === method.id;
        var cycleDefault = bridgeState.settings.defaults && bridgeState.settings.defaults.cycleMethod === method.id;
