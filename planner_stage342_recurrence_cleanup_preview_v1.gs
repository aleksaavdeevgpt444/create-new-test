    ORDER BY updated_at DESC
  `)
    .bind(String(userId))
    .all();
  return (rows.results || []).map((row) => ({
    user_id: row.user_id,
    task_id: row.task_id,
    blocked_by_task_id: row.blocked_by_task_id || null,
    created_at: row.created_at || null,
    updated_at: row.updated_at || null,
  }));
}

async function getTaskDependencyState(env, { userId, taskId }) {
  const userIdString = String(userId);
  const taskIdString = String(taskId);
  const row = await env.DB.prepare(`
    SELECT user_id, task_id, blocked_by_task_id, created_at, updated_at
    FROM task_dependencies
    WHERE user_id = ? AND task_id = ?
    LIMIT 1
  `)
    .bind(userIdString, taskIdString)
    .first();
  const blockedByTask = row && row.blocked_by_task_id ? await getTaskById(env, { taskId: row.blocked_by_task_id, userId: userIdString }) : null;
  const blockingRows = await env.DB.prepare(`
    SELECT task_id
    FROM task_dependencies
    WHERE user_id = ? AND blocked_by_task_id = ?
    ORDER BY updated_at DESC
  `)
    .bind(userIdString, taskIdString)
    .all();
  const blockingTasks = [];
  for (const item of (blockingRows.results || [])) {
    if (!item.task_id) continue;
    const relatedTask = await getTaskById(env, { taskId: item.task_id, userId: userIdString });
    if (relatedTask) blockingTasks.push(relatedTask);
  }
  return {
    task_id: taskIdString,
    blocked_by_task_id: row && row.blocked_by_task_id ? row.blocked_by_task_id : null,
    blocked_by_task: blockedByTask,
    blocking_tasks: blockingTasks,
    created_at: row && row.created_at ? row.created_at : null,
    updated_at: row && row.updated_at ? row.updated_at : null,
  };
}

async function setTaskBlockedBy(env, { userId, taskId, blockedByTaskId }) {
  const userIdString = String(userId);
  const taskIdString = String(taskId);
  const blockedByTaskIdString = blockedByTaskId ? String(blockedByTaskId) : null;
  if (blockedByTaskIdString && blockedByTaskIdString === taskIdString) throw new Error('Задача не может блокироваться сама собой');
  const task = await getTaskById(env, { taskId: taskIdString, userId: userIdString });
  if (!task) throw new Error('Task not found');
  if (blockedByTaskIdString) {
    const blockerTask = await getTaskById(env, { taskId: blockedByTaskIdString, userId: userIdString });
    if (!blockerTask) throw new Error('Блокирующая задача не найдена');
  }
  const previous = await getTaskDependencyState(env, { userId: userIdString, taskId: taskIdString });
  const now = new Date().toISOString();
  await env.DB.prepare(`
    INSERT INTO task_dependencies (user_id, task_id, blocked_by_task_id, created_at, updated_at)
    VALUES (?, ?, ?, ?, ?)
    ON CONFLICT(user_id, task_id) DO UPDATE SET
      blocked_by_task_id = excluded.blocked_by_task_id,
      updated_at = excluded.updated_at
  `)
    .bind(userIdString, taskIdString, blockedByTaskIdString, now, now)
    .run();
  await addTaskHistory(env, {
    userId: userIdString,
    taskId: taskIdString,
    eventType: 'dependency_changed',
    payload: { previous_blocked_by_task_id: previous.blocked_by_task_id || null, blocked_by_task_id: blockedByTaskIdString || null },
    createdAt: now
  });
  return getTaskDependencyState(env, { userId: userIdString, taskId: taskIdString });
}

function readPlannerIngestSecret(env) {
  return env?.PLANNER_INGEST_SECRET || env?.IDEAS_HUB_INGEST_SECRET || "";
}

function isAuthorizedHubIngestRequest(request, env) {
  const configured = readPlannerIngestSecret(env);
  if (!configured) return true;
  const headerSecret = request.headers.get("x-planner-ingest-secret") || request.headers.get("x-ideas-hub-secret") || "";
  return headerSecret && headerSecret === configured;
}

async function updateTaskWithAi(env, taskId, aiResult) {
