    .toolbar-secondary-block {
      align-content: start;
    }
    .toolbar-block-label {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--text-soft, var(--text-muted));
    }
    .toolbar-primary-note {
      font-size: 11px;
      line-height: 1.42;
      color: var(--text-soft, var(--text-muted));
    }
    .toolbar-secondary-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
    }
    .toolbar #openCreateBtn {
