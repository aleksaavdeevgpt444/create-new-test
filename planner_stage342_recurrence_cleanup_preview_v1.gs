        copy.appendChild(statusLine);

        var descriptionText = item.meta && item.meta.description ? String(item.meta.description).trim() : '';
        if (descriptionText) {
          var description = document.createElement('div');
          description.className = 'project-card-description';
          description.textContent = descriptionText;
          copy.appendChild(description);
        }

        head.appendChild(copy);

        var headActions = document.createElement('div');
        headActions.className = 'project-actions';
        headActions.appendChild(createProjectActionButton('Редактировать', 'btn-secondary', function () { openProjectDialog(item.meta || { name: item.name }); }));
        if (item.stats.previewTasks.length) {
          headActions.appendChild(createProjectActionButton('Открыть 1-ю', 'btn-ghost', function () { openEditor(item.stats.previewTasks[0].id); }));
        }
        head.appendChild(headActions);
        card.appendChild(head);

        var notesText = item.meta && item.meta.notes ? String(item.meta.notes).trim() : '';
        if (notesText) {
          var noteBox = document.createElement('div');
