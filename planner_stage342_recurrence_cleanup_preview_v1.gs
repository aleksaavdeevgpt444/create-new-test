      function getNavigationReframeActions(viewName) {
        var normalized = normalizeViewName(viewName || state.currentView || 'today');
        return NAVIGATION_REFRAME_ACTIONS[normalized] || NAVIGATION_REFRAME_ACTIONS.today;
      }

      function getNavigationRouteIndex(viewName) {
        return NAVIGATION_REFRAME_ROUTE.indexOf(normalizeViewName(viewName || state.currentView || 'today'));
      }

      function openViewFromNavigation(viewName) {
        var normalized = normalizeViewName(viewName || 'today');
        setActiveView(normalized);
        if (normalized === 'today') return renderTodayView();
        if (normalized === 'plan') return renderPlanView();
        if (normalized === 'planner') return openPlannerWeekViewSafe();
        if (normalized === 'inbox') return renderInboxView();
        if (normalized === 'board') return renderBoardView();
        if (normalized === 'projects') return renderProjectsView();
        if (normalized === 'gantt') return renderGanttView();
        if (normalized === 'templates') return renderTemplatesView();
        if (normalized === 'month') return renderMonthView();
      }

      function createNavigationActionButton(action) {
        if (!action || !action.view || !action.label) return '';
        var className = action.kind === 'primary' ? 'btn-primary' : (action.kind === 'secondary' ? 'btn-secondary' : 'btn-ghost');
        return '<button type="button" class="' + className + '" data-navigation-action-view="' + escapeHtml(action.view) + '">' + escapeHtml(action.label) + '</button>';
      }

      function isCoreWorkflowView(viewName) {
        var normalized = normalizeViewName(viewName || state.currentView || 'today');
        return normalized === 'today' || normalized === 'plan' || normalized === 'planner' || normalized === 'inbox';
      }


      function isSupportOrUtilityWorkflowView(viewName) {
        return !isCoreWorkflowView(viewName) && normalizeViewName(viewName || state.currentView || 'today') !== 'settings';
      }

