        var top = document.createElement('div');
        top.className = 'inbox-task-top';
        var title = document.createElement('div');
        title.className = 'inbox-task-title';
        title.textContent = task.title || 'Без названия';
        top.appendChild(title);
        var stageChip = createChip(getInboxStageLabel(stage));
        stageChip.classList.add('inbox-stage-chip');
        top.appendChild(stageChip);
        card.appendChild(top);

        var meta = document.createElement('div');
        meta.className = 'inbox-task-meta';
        meta.appendChild(createChip(getInboxSourceLabel(getInboxSourceKey(task))));
        meta.appendChild(createChip(normalizeProjectName(task.project_name)));
        meta.appendChild(createChip('План: ' + formatMinutesHoursLabel(getTaskPlannedMinutesValue(task))));
        if (task.created_at) meta.appendChild(createChip('Создана: ' + formatDateShortDisplay(task.created_at)));
