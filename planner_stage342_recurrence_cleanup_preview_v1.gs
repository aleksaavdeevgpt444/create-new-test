/**
 * Сохраняет recommendation state (результат wizard/recommender) серверно.
 * Не блокирует, тихая ошибка.
 * @param {object} recommState — { role, bundle, primarySystem, wizardInput }
 */

function getKnowledgeRoleLabelById(value) {
  var key = String(value || '').trim().toLowerCase();
  var role = (typeof getStructureRoleProfileMeta === 'function') ? getStructureRoleProfileMeta(key) : null;
  if (role && role.title) return role.title;
  if (typeof getKnowledgeInteractiveLabel === 'function') return getKnowledgeInteractiveLabel(key);
  return key || '—';
}

function getKnowledgeBundleLabelById(value) {
  var key = String(value || '').trim().toLowerCase();
  var bundle = (typeof getFrameworkBundleById === 'function') ? getFrameworkBundleById(key) : null;
  return bundle && bundle.title ? bundle.title : (key || '—');
}

function applyKnowledgeServerStateFields(data) {
  if (!data || typeof data !== 'object') return;
  if (data.knowledge_recommendation_state !== undefined) state.knowledgeRecommendationState = data.knowledge_recommendation_state || null;
  if (data.knowledge_last_applied_role !== undefined) state.knowledgeLastAppliedRole = String(data.knowledge_last_applied_role || '').trim() || null;
  if (data.knowledge_last_applied_at !== undefined) state.knowledgeLastAppliedAt = String(data.knowledge_last_applied_at || '').trim() || null;
  if (Array.isArray(data.knowledge_recommendation_history)) state.knowledgeRecommendationHistory = data.knowledge_recommendation_history;
}

function setKnowledgeRecommendationSyncState(status, details) {
  state.knowledgeRecommendationSyncState = {
    status: String(status || 'idle'),
    details: String(details || ''),
    syncedAt: new Date().toISOString(),
    userId: String(state.userId || '')
  };
  try { renderKnowledgeRecommendationStatePanel(); } catch (error) {}
}

function getKnowledgeRecommendationSyncLabel(status) {
  var value = String(status || 'idle');
  if (value === 'saved') return 'Сохранено на сервере';
  if (value === 'saving') return 'Сохраняется';
  if (value === 'loaded') return 'Загружено с сервера';
  if (value === 'fallback') return 'Локальный fallback';
  if (value === 'local') return 'Локально';
  return 'Ожидает действия';
}

function persistKnowledgeRecommendationStateToServer(recommState) {
  var normalizedState = Object.assign({}, recommState || {}, { savedAt: new Date().toISOString() });
  state.knowledgeRecommendationState = normalizedState;
  if (!state.userId) {
    setKnowledgeRecommendationSyncState('local', 'Нет user_id: recommendation state сохранён только в текущей сессии.');
    try { renderKnowledgeCenterProSummary(); } catch (error) {}
    return Promise.resolve(null);
  }
  setKnowledgeRecommendationSyncState('saving', 'Сохраняем recommendation state wizard на сервер.');
  var payload = {
    user_id: String(state.userId || ''),
    settings: normalizeFrameworkSettings(state.frameworkSettings || getDefaultFrameworkSettings()),
    knowledgeRecommendationState: normalizedState,
  };
  return requestJson(buildFrameworkSettingsRequestUrl(), {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
    __meta: { requestName: 'knowledge-recommendation-state-put', reportServerErrors: false },
  }).then(function (data) {
    applyKnowledgeServerStateFields(data);
    setKnowledgeRecommendationSyncState('saved', 'recommendation_state');
    try { renderKnowledgeCenterProSummary(); } catch (error) {}
    try { renderKnowledgeRecommendationStatePanel(); } catch (error) {}
    return data;
  }).catch(function () {
    setKnowledgeRecommendationSyncState('fallback', 'Сервер не принял recommendation state, UI продолжает работать локально.');
    try { renderKnowledgeCenterProSummary(); } catch (error) {}
    return null;
  });
}

/**
 * Сохраняет applied role/bundle серверно и добавляет запись в историю.
 * @param {string} roleId — id применённой роли
 * @param {string|null} bundleId — id применённой связки (если есть)
 */
function persistKnowledgeAppliedStateToServer(roleId, bundleId) {
  var safeRoleId = String(roleId || '').trim() || '';
  var safeBundleId = String(bundleId || '').trim() || '';
  var currentRoleId = String(state.knowledgeLastAppliedRole || '').trim() || String(state.structureLayerSettings && state.structureLayerSettings.roleProfile || '').trim() || '';
  var roleForHistory = safeRoleId || currentRoleId || null;
  var now = new Date().toISOString();

  if (roleForHistory) state.knowledgeLastAppliedRole = roleForHistory;
  state.knowledgeLastAppliedAt = now;
  if (!Array.isArray(state.knowledgeRecommendationHistory)) state.knowledgeRecommendationHistory = [];
  state.knowledgeRecommendationHistory = [{ role: roleForHistory, bundle: safeBundleId || null, appliedAt: now }].concat(state.knowledgeRecommendationHistory).slice(0, 5);

  if (!state.userId) {
    setKnowledgeRecommendationSyncState('local', 'Нет user_id: applied state сохранён только локально.');
    try { renderKnowledgeCenterProSummary(); } catch (error) {}
    return Promise.resolve(null);
  }

  setKnowledgeRecommendationSyncState('saving', 'Сохраняем применённый Knowledge-режим на сервер.');
  var payload = {
    user_id: String(state.userId || ''),
    settings: normalizeFrameworkSettings(state.frameworkSettings || getDefaultFrameworkSettings()),
    appendKnowledgeHistory: {
      role: roleForHistory,
      bundle: safeBundleId || null,
      appliedAt: now,
    },
  };
  if (roleForHistory) {
    payload.knowledgeLastAppliedRole = roleForHistory;
    payload.knowledgeLastAppliedAt = now;
  }

  return requestJson(buildFrameworkSettingsRequestUrl(), {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
    __meta: { requestName: 'knowledge-applied-state-put', reportServerErrors: false },
  }).then(function (data) {
