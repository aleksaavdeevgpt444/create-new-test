  <script>
    (function () {
      // ============================================================
      // STAGE 311 — BOOT DIAGNOSTICS GUARD
      // Назначение: не менять бизнес-логику planner, а сделать отказоустойчивую
      // диагностику клиентской загрузки. Если следующий этап снова сломает render/init,
      // пользователь увидит понятную панель ошибки вместо "пустого" интерфейса.
      // ============================================================
      var PLANNER_BOOT_DIAGNOSTIC_BUILD = '${APP_BUILD}';
      var PLANNER_BOOT_DIAGNOSTIC_KEY = 'planner_boot_diagnostics_v1';
      window.__plannerBootDiagnostics = window.__plannerBootDiagnostics || {
        build: PLANNER_BOOT_DIAGNOSTIC_BUILD,
        startedAt: new Date().toISOString(),
        lastStep: 'script-start',
        errors: []
      };

      function markPlannerBootStep(step, details) {
        try {
          var boot = window.__plannerBootDiagnostics || {};
          boot.build = PLANNER_BOOT_DIAGNOSTIC_BUILD;
          boot.lastStep = String(step || 'unknown');
          boot.lastStepAt = new Date().toISOString();
          if (details) boot.lastDetails = String(details).slice(0, 500);
          window.__plannerBootDiagnostics = boot;
          try { localStorage.setItem(PLANNER_BOOT_DIAGNOSTIC_KEY, JSON.stringify(boot)); } catch (_) {}
        } catch (_) {}
      }

      function normalizePlannerBootError(error) {
        var message = 'Unknown client error';
        var stack = '';
        var name = 'Error';
        try {
          if (error) {
            name = error.name ? String(error.name) : name;
            message = error.message ? String(error.message) : String(error);
            stack = error.stack ? String(error.stack) : '';
          }
        } catch (_) {}
        return { name: name, message: message, stack: stack };
      }

      function storePlannerBootError(phase, error, extra) {
        var normalized = normalizePlannerBootError(error);
        var entry = {
          build: PLANNER_BOOT_DIAGNOSTIC_BUILD,
          phase: String(phase || 'unknown'),
          message: normalized.message,
          name: normalized.name,
          stack: normalized.stack,
          url: window.location && window.location.href ? String(window.location.href) : '',
          lastStep: window.__plannerBootDiagnostics && window.__plannerBootDiagnostics.lastStep ? String(window.__plannerBootDiagnostics.lastStep) : '',
          timestamp: new Date().toISOString(),
          extra: extra || null
        };
        try {
          var boot = window.__plannerBootDiagnostics || {};
          boot.errors = Array.isArray(boot.errors) ? boot.errors : [];
          boot.errors.unshift(entry);
          boot.errors = boot.errors.slice(0, 10);
          window.__plannerBootDiagnostics = boot;
          localStorage.setItem(PLANNER_BOOT_DIAGNOSTIC_KEY, JSON.stringify(boot));
        } catch (_) {}
        return entry;
      }

      function reportPlannerBootErrorSafe(entry) {
        try {
          if (typeof reportClientError === 'function') {
            reportClientError({
              phase: entry.phase || 'boot-diagnostics',
              message: entry.message || 'Client boot error',
              stack: entry.stack || '',
              build: entry.build || PLANNER_BOOT_DIAGNOSTIC_BUILD,
              last_step: entry.lastStep || '',
              url: entry.url || ''
            }, { forceFetch: false });
          }
        } catch (_) {}
      }

      function showPlannerBootErrorPanel(entry) {
        try {
          var existing = document.getElementById('plannerBootErrorPanel');
          if (!existing) {
            existing = document.createElement('div');
            existing.id = 'plannerBootErrorPanel';
            existing.style.cssText = 'position:fixed;left:18px;right:18px;bottom:18px;z-index:999999;background:#111827;color:#e5e7eb;border:1px solid rgba(248,113,113,.55);box-shadow:0 24px 80px rgba(0,0,0,.45);border-radius:18px;padding:16px 18px;font-family:system-ui,-apple-system,Segoe UI,sans-serif;max-height:42vh;overflow:auto;';
            document.body.appendChild(existing);
          }
          var safeMessage = String(entry && entry.message ? entry.message : 'Ошибка клиентской загрузки').replace(/[<>&]/g, function (ch) { return ({ '<':'&lt;', '>':'&gt;', '&':'&amp;' })[ch]; });
          var safePhase = String(entry && entry.phase ? entry.phase : 'boot').replace(/[<>&]/g, function (ch) { return ({ '<':'&lt;', '>':'&gt;', '&':'&amp;' })[ch]; });
          var safeStep = String(entry && entry.lastStep ? entry.lastStep : '—').replace(/[<>&]/g, function (ch) { return ({ '<':'&lt;', '>':'&gt;', '&':'&amp;' })[ch]; });
          var safeStack = String(entry && entry.stack ? entry.stack : '').replace(/[<>&]/g, function (ch) { return ({ '<':'&lt;', '>':'&gt;', '&':'&amp;' })[ch]; });
          existing.innerHTML = '' +
            '<div style="display:flex;align-items:flex-start;gap:12px;justify-content:space-between;">' +
              '<div>' +
                '<div style="font-weight:800;font-size:15px;margin-bottom:4px;color:#fecaca;">Planner: ошибка загрузки интерфейса</div>' +
                '<div style="font-size:13px;line-height:1.45;color:#cbd5e1;">Build: <b>' + PLANNER_BOOT_DIAGNOSTIC_BUILD + '</b> · phase: <b>' + safePhase + '</b> · last step: <b>' + safeStep + '</b></div>' +
              '</div>' +
              '<button type="button" id="plannerBootErrorCloseBtn" style="background:#1f2937;color:#e5e7eb;border:1px solid rgba(148,163,184,.35);border-radius:10px;padding:7px 10px;cursor:pointer;">Скрыть</button>' +
            '</div>' +
            '<div style="margin-top:10px;font-size:13px;line-height:1.45;color:#fff;white-space:pre-wrap;">' + safeMessage + '</div>' +
            (safeStack ? '<details style="margin-top:10px;"><summary style="cursor:pointer;color:#93c5fd;">Показать stack trace</summary><pre style="white-space:pre-wrap;font-size:12px;line-height:1.35;color:#cbd5e1;margin:8px 0 0;">' + safeStack + '</pre></details>' : '') +
            '<div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">' +
              '<button type="button" id="plannerBootErrorCopyBtn" style="background:#2563eb;color:#fff;border:0;border-radius:10px;padding:8px 12px;cursor:pointer;font-weight:700;">Скопировать ошибку</button>' +
              '<button type="button" id="plannerBootErrorReloadBtn" style="background:#374151;color:#fff;border:0;border-radius:10px;padding:8px 12px;cursor:pointer;">Обновить страницу</button>' +
            '</div>';
          var closeBtn = document.getElementById('plannerBootErrorCloseBtn');
          if (closeBtn) closeBtn.onclick = function () { existing.style.display = 'none'; };
          var reloadBtn = document.getElementById('plannerBootErrorReloadBtn');
          if (reloadBtn) reloadBtn.onclick = function () { window.location.reload(); };
          var copyBtn = document.getElementById('plannerBootErrorCopyBtn');
          if (copyBtn) copyBtn.onclick = function () {
            var text = JSON.stringify(entry || {}, null, 2);
            try {
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text);
                copyBtn.textContent = 'Скопировано';
              } else {
                var textarea = document.createElement('textarea');
                textarea.value = text;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);
                copyBtn.textContent = 'Скопировано';
              }
            } catch (_) { copyBtn.textContent = 'Не удалось скопировать'; }
          };
        } catch (_) {}
      }

      function handlePlannerBootError(phase, error, extra) {
        var entry = storePlannerBootError(phase, error, extra);
        try { console.error('[planner boot diagnostics]', entry); } catch (_) {}
        showPlannerBootErrorPanel(entry);
        reportPlannerBootErrorSafe(entry);
        return entry;
      }

      function runPlannerBootStep(step, fn) {
        markPlannerBootStep(step + ':start');
        try {
          var result = typeof fn === 'function' ? fn() : null;
          if (result && typeof result.then === 'function') {
            return result.then(function (value) {
              markPlannerBootStep(step + ':done');
              return value;
            }).catch(function (error) {
              handlePlannerBootError(step + ':async-error', error);
              return null;
            });
          }
          markPlannerBootStep(step + ':done');
          return result;
        } catch (error) {
          handlePlannerBootError(step + ':sync-error', error);
          return null;
        }
      }

      window.addEventListener('error', function (event) {
        if (!event) return;
        handlePlannerBootError('window.error.early', event.error || new Error(event.message || 'Window error'), {
          line: event.lineno || null,
          column: event.colno || null,
          filename: event.filename || ''
        });
      });
      window.addEventListener('unhandledrejection', function (event) {
        var reason = event && event.reason;
        handlePlannerBootError('unhandledrejection.early', reason || new Error('Unhandled promise rejection'));
      });
      markPlannerBootStep('script-start');
