        appendEditorTaskHelpSection(card, 'Первый видимый результат', data.firstVisibleResult || '', null);
        appendEditorTaskHelpSection(card, 'Мини-план', '', Array.isArray(data.miniPlan) ? data.miniPlan : []);
        appendEditorTaskHelpSection(card, 'Декомпозиция', '', Array.isArray(data.decompositionSteps) ? data.decompositionSteps : []);
        appendEditorTaskHelpSection(card, 'Зависимости', data.dependencyNote || '', null);
        appendEditorTaskHelpSection(card, 'Риски', data.riskNote || '', null);

        if (Array.isArray(data.blockers) && data.blockers.length) {
          var blockersWrap = document.createElement('div');
          blockersWrap.className = 'editor-task-help-summary-tags';
          data.blockers.forEach(function (item) {
            var chip = createChip(item);
            chip.classList.add('is-warning');
            blockersWrap.appendChild(chip);
          });
          card.appendChild(blockersWrap);
        }

        if (Array.isArray(data.missingData) && data.missingData.length) {
          var missingWrap = document.createElement('div');
          missingWrap.className = 'editor-task-help-summary-tags';
          data.missingData.forEach(function (item) {
            var chip = createChip('Нужно: ' + item);
            chip.classList.add('is-warning');
            missingWrap.appendChild(chip);
          });
          card.appendChild(missingWrap);
        }

        if (Array.isArray(data.missingDecisions) && data.missingDecisions.length) {
          var decisionsWrap = document.createElement('div');
          decisionsWrap.className = 'editor-task-help-summary-tags';
          data.missingDecisions.forEach(function (item) {
            var chip = createChip('Решить: ' + item);
            chip.classList.add('is-warning');
