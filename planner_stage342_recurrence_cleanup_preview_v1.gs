          taskList.appendChild(empty);
        } else {
          selectedTasks.forEach(function (task) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'ritual-linked-task' + (normalizeStatus(task.status) === STATUS.DONE ? ' is-done' : '');
            btn.textContent = task.title || 'Без названия';
            btn.addEventListener('click', function () { openEditor(task.id); });
            taskList.appendChild(btn);
