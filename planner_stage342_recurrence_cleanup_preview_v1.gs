            empty.textContent = 'Пока пусто.';
            list.appendChild(empty);
          } else {
            items.forEach(function (task) { list.appendChild(createBoardTaskCard(task)); });
          }
          col.appendChild(list);
          container.appendChild(col);
        });
      }



      function getTaskPriorityRank(task) {
        var manual = Number(task && task.priority_manual);
        if (Number.isFinite(manual) && manual > 0) return manual;
        var ai = Number(task && task.priority_ai);
        if (Number.isFinite(ai) && ai > 0) return ai;
        return 0;
      }

      function getTaskPlannedMinutesValue(task) {
        var status = normalizeStatus(task && task.status) || STATUS.NEW;
        if (status !== STATUS.PLANNED && status !== STATUS.DONE) return 0;
        return Math.max(Number(getEffectivePlannedMinutesClient(task)) || Number(getTaskDurationMinutes(task)) || 0, 0);
      }

      function compareTasksByPriorityThenDue(a, b) {
        var priorityDiff = getTaskPriorityRank(b) - getTaskPriorityRank(a);
        if (priorityDiff !== 0) return priorityDiff;
        return compareTasksByDueAndUpdated(a, b);
      }

      function isTaskInWeekRange(dayYmd, weekStartYmd) {
        if (!(dayYmd && weekStartYmd)) return false;
        var start = new Date(weekStartYmd + 'T00:00:00');
        var target = new Date(dayYmd + 'T00:00:00');
        if (isNaN(start.getTime()) || isNaN(target.getTime())) return false;
        var end = new Date(start.getTime() + 7 * 86400000);
        return target >= start && target < end;
      }

      function getTaskWeekDayYmd(task) {
        if (!(task && task.due_at)) return '';
        var due = new Date(task.due_at);
        if (isNaN(due.getTime())) return '';
        return formatYmdLocal(due);
      }

      function isTaskPrimaryForRitualDay(task, dayYmd) {
        if (!(task && task.id && dayYmd)) return false;
        var ritual = loadDayRitual(dayYmd);
        var ids = Array.isArray(ritual.topTaskIds) ? ritual.topTaskIds.map(function (id) { return String(id); }) : [];
        return ids.indexOf(String(task.id)) >= 0;
      }

      function collectWeekPrimaryTaskIds() {
        var map = Object.create(null);
        buildVisibleDays('week').forEach(function (day) {
          var ritual = loadDayRitual(day.ymd);
          var ids = Array.isArray(ritual.topTaskIds) ? ritual.topTaskIds : [];
          ids.forEach(function (id) {
            map[String(id)] = true;
          });
        });
        return map;
      }

      function matchesPlanTaskFilter(task, filterKey) {
        var filter = String(filterKey || state.planFilter || 'active');
        var status = normalizeStatus(task && task.status);
        if (filter === 'all') return true;
        if (filter === 'planned') return status === STATUS.PLANNED;
        if (filter === 'done') return status === STATUS.DONE;
        return status === STATUS.NEW || status === STATUS.PLANNED || status === STATUS.POSTPONED;
      }


      function normalizeTodayAiPlanningState(raw) {
        var review = raw && raw.review && typeof raw.review === 'object' ? raw.review : null;
        return {
          dayYmd: String(raw && raw.dayYmd || '').trim(),
          signature: String(raw && raw.signature || '').trim(),
          generatedAt: String(raw && raw.generatedAt || '').trim(),
          source: String(raw && raw.source || '').trim() || 'local',
          status: String(raw && raw.status || '').trim() || 'idle',
          review: review ? {
            summary_title: String(review.summary_title || '').trim(),
            planning_note: String(review.planning_note || '').trim(),
            best_move: String(review.best_move || '').trim(),
            overload_note: String(review.overload_note || '').trim(),
            suggested_moves: Array.isArray(review.suggested_moves) ? review.suggested_moves.map(function (item) { return String(item || '').trim(); }).filter(Boolean).slice(0, 4) : [],
            next_actions: Array.isArray(review.next_actions) ? review.next_actions.map(function (item) { return String(item || '').trim(); }).filter(Boolean).slice(0, 4) : [],
            defer_candidates: Array.isArray(review.defer_candidates) ? review.defer_candidates.map(function (item) { return String(item || '').trim(); }).filter(Boolean).slice(0, 4) : [],
            best_target_day_ymd: String(review.best_target_day_ymd || '').trim()
          } : null
        };
      }

      function loadStoredTodayAiPlanningState() {
        try {
          var raw = localStorage.getItem(TODAY_AI_PLANNING_STATE_STORAGE_KEY);
          if (!raw) return normalizeTodayAiPlanningState({});
          return normalizeTodayAiPlanningState(JSON.parse(raw));
        } catch (error) {
          return normalizeTodayAiPlanningState({});
        }
      }

      function persistTodayAiPlanningState() {
        try { localStorage.setItem(TODAY_AI_PLANNING_STATE_STORAGE_KEY, JSON.stringify(normalizeTodayAiPlanningState(state.todayAiPlanningState || {}))); } catch (error) {}
      }

      function setTodayAiPlanningState(next) {
        state.todayAiPlanningState = normalizeTodayAiPlanningState(next || {});
        persistTodayAiPlanningState();
      }

      function buildTodayAiPlanningSignature(dayYmd) {
        var dayTasks = getTasksForDay(dayYmd);
        var parts = dayTasks.map(function (task) {
          return [
            String(task && task.id || ''),
            String(task && task.updated_at || ''),
            String(task && task.status || ''),
            String(task && task.due_at || ''),
            String((task && task.priority_manual) || (task && task.priority_ai) || ''),
            String(task && task.project_name || ''),
            String(task && task.actual_minutes || ''),
            String(task && task.planned_minutes_manual || ''),
            String(task && task.duration_minutes || '')
          ].join('|');
        }).sort();
        var capacity = splitDayTasksByCapacity(dayYmd, dayTasks);
        return [
          dayYmd,
          capacity.capacityMinutes || 0,
          capacity.plannedMinutes || 0,
          capacity.overflowMinutes || 0,
          parts.join('||')
        ].join('::');
      }

      function getTodayAiPlanningPayload(dayYmd) {
        var dayTasks = getTasksForDay(dayYmd);
        var capacity = splitDayTasksByCapacity(dayYmd, dayTasks);
        var weekStart = state.weekStart || getCurrentWeekStartYmd();
        var weekCapacity = getWeekCapacityDayDetails(weekStart);
        var activeTasks = dayTasks.filter(function (task) {
          var status = normalizeStatus(task && task.status);
          return status === STATUS.PLANNED || status === STATUS.NEW || status === STATUS.POSTPONED || status === STATUS.DONE;
        });
        var doneTasks = dayTasks.filter(function (task) { return normalizeStatus(task && task.status) === STATUS.DONE; });
        return {
          user_id: String(state.userId || '').trim(),
          day_ymd: dayYmd,
          day_label: formatWithPlannerTimeZone(new Date(dayYmd + 'T00:00:00'), { weekday: 'long', day: 'numeric', month: 'long' }, dayYmd),
          summary: {
            active: activeTasks.length,
            done: doneTasks.length,
            attention: getAttentionTasks(activeTasks).length,
            total_planned_label: formatMinutesHoursLabel(capacity.plannedMinutes || 0),
            capacity_label: formatMinutesHoursLabel(capacity.capacityMinutes || 0),
            delta_label: ((capacity.overflowMinutes || 0) > 0 ? '-' : '+') + formatMinutesHoursLabel((capacity.overflowMinutes || 0) > 0 ? capacity.overflowMinutes : capacity.freeMinutes)
          },
          week_context: {
            attention: getAttentionTasks(getCurrentWeekTasks()).length,
            backlog: getBacklogTasks().length,
            overflow_days: getWeekCapacitySummary(weekStart).overflowDays || 0
          },
          capacity_days: Array.isArray(weekCapacity) ? weekCapacity.map(function (day) {
            return {
              day_ymd: day.dayYmd,
              day_label: day.label,
              planned_label: formatMinutesHoursLabel(day.plannedMinutes || 0),
              capacity_label: formatMinutesHoursLabel(day.capacityMinutes || 0),
              delta_label: ((day.overflowMinutes || 0) > 0 ? '-' : '+') + formatMinutesHoursLabel((day.overflowMinutes || 0) > 0 ? day.overflowMinutes : day.freeMinutes),
              tone: day.loadMeta && day.loadMeta.tone ? day.loadMeta.tone : 'normal'
            };
          }) : [],
          day_tasks: activeTasks.slice().sort(compareTasksByDueAndUpdated).slice(0, 20).map(function (task) {
            return {
              id: task.id,
              title: task.title || '',
              product: task.task_product || '',
              time_label: task.due_at ? formatTimeByYmdWithPlannerTimeZone(task.due_at, dayYmd, '—') : 'без времени',
              status_label: getStatusLabel(normalizeStatus(task.status)),
              project_name: normalizeProjectName(task.project_name),
              priority_label: getPriorityText(getTaskPriorityRank(task)) || 'не задан',
              planned_label: formatMinutesHoursLabel(getTaskPlannedMinutesValue(task)),
              actual_label: formatMinutesHoursLabel(Math.max(0, Number(task && task.actual_minutes || 0) || 0)),
              attention: !!isTaskAttentionNeeded(task),
              focus_protected: !!isTaskFocusProtected(task.id)
            };
          })
        };
      }

      function buildFallbackTodayAiPlanning(dayYmd) {
        var dayTasks = getTasksForDay(dayYmd);
        var capacity = splitDayTasksByCapacity(dayYmd, dayTasks);
        var activeTasks = dayTasks.filter(function (task) {
          var status = normalizeStatus(task && task.status);
          return status === STATUS.PLANNED || status === STATUS.NEW || status === STATUS.POSTPONED;
        }).slice().sort(compareTasksByDueAndUpdated);
        var attentionTasks = getAttentionTasks(activeTasks);
        var overflowTasks = Array.isArray(capacity.overflowTasks) ? capacity.overflowTasks.slice(0, 4) : [];
        var bestDayCard = getWeekCapacityDayDetails(state.weekStart || getCurrentWeekStartYmd()).filter(function (day) {
          return day.dayYmd !== dayYmd && (day.freeMinutes || 0) > 0 && (day.overflowMinutes || 0) <= 0;
        }).sort(function (a, b) { return (b.freeMinutes || 0) - (a.freeMinutes || 0); })[0] || null;
        var summaryTitle = 'День выглядит исполнимым';
        var planningNote = 'День собран в исполнимом объёме. Сохрани фокус на главном и не добирай лишнее из backlog.';
        var bestMove = activeTasks.length ? ('Начни с задачи «' + (activeTasks[0].title || 'Без названия') + '» и не добавляй новые слоты, пока не закроешь текущий фокус.') : 'День пустой. Выбери 1–3 главные задачи и поставь их в Today.';
        var overloadNote = capacity.overflowMinutes > 0 ? ('Перегруз дня: ' + formatMinutesHoursLabel(capacity.overflowMinutes) + '. Часть задач лучше вынести в неделю или на другой день.') : 'Критичного перегруза по минутам не видно.';
        if (capacity.overflowMinutes > 0) {
          summaryTitle = 'День перегружен';
          planningNote = 'План дня превышает ёмкость. Сначала разгрузи overflow, потом докладывай дополнительные задачи.';
        } else if (attentionTasks.length) {
          summaryTitle = 'День исполним, но требует внимания';
          planningNote = 'По минутам день собран, но есть задачи с риском, stalled-состоянием или блокером.';
        }
        var suggestedMoves = [];
        if (overflowTasks.length) suggestedMoves.push('Вынеси из дня: ' + overflowTasks.map(function (task) { return task.title || 'Без названия'; }).join(', ') + '.');
        if (bestDayCard) suggestedMoves.push('Лучший день для разгрузки: ' + bestDayCard.label + '.');
        if (attentionTasks.length) suggestedMoves.push('Сначала сними риски и блокеры у задач с пометкой внимания.');
        if (!suggestedMoves.length) suggestedMoves.push('Держи день компактным: главное → фокус → только потом дополнительное.');
        var nextActions = [
          activeTasks.length ? 'Открой первую задачу дня и проверь её следующий шаг.' : 'Добавь в Today первую главную задачу недели.',
          capacity.overflowMinutes > 0 ? 'Разгрузи overflow-задачи до старта фокуса.' : 'Сохрани буфер под непредвиденные задачи.',
          attentionTasks.length ? 'Открой риск-слой дня и снимай блокеры до выполнения.' : 'После главного перейди к дополнительным без перегруза.'
        ].filter(Boolean).slice(0, 4);
        return {
          summary_title: summaryTitle,
          planning_note: planningNote,
          best_move: bestMove,
          overload_note: overloadNote,
          suggested_moves: suggestedMoves.slice(0, 4),
          next_actions: nextActions,
          defer_candidates: overflowTasks.map(function (task) { return task.title || 'Без названия'; }).slice(0, 4),
          best_target_day_ymd: bestDayCard ? (bestDayCard.dayYmd || '') : ''
        };
      }

      function requestTodayAiPlanning(dayYmd) {
        return requestJson('/ai/day-plan', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(getTodayAiPlanningPayload(dayYmd))
        });
      }

      function refreshTodayAiPlanning(dayYmd, forceAi) {
        var signature = buildTodayAiPlanningSignature(dayYmd);
        var fallback = buildFallbackTodayAiPlanning(dayYmd);
        if (!(forceAi || String(state.userId || '').trim())) {
          setTodayAiPlanningState({ dayYmd: dayYmd, signature: signature, generatedAt: new Date().toISOString(), source: 'local', status: 'ready', review: fallback });
          renderTodayView();
          return Promise.resolve();
        }
        state.todayAiPlanningPending = true;
        renderTodayView();
        return requestTodayAiPlanning(dayYmd)
          .then(function (response) {
            setTodayAiPlanningState({ dayYmd: dayYmd, signature: signature, generatedAt: new Date().toISOString(), source: 'ai', status: 'ready', review: response && response.review ? response.review : fallback });
            showSuccess('AI план дня обновлён.');
          })
          .catch(function () {
            setTodayAiPlanningState({ dayYmd: dayYmd, signature: signature, generatedAt: new Date().toISOString(), source: 'local', status: 'fallback', review: fallback });
            showError('AI план дня не удалось получить. Показан локальный обзор дня.');
          })
          .finally(function () {
            state.todayAiPlanningPending = false;
            renderTodayView();
          });
      }

      function renderTodayAiPlanningPanel(dayYmd) {
        var container = byId('todayAiPlanningCard');
        if (!container) return;
        container.innerHTML = '';
        container.style.display = '';
        var signature = buildTodayAiPlanningSignature(dayYmd);
        var stored = normalizeTodayAiPlanningState(state.todayAiPlanningState || loadStoredTodayAiPlanningState());
        state.todayAiPlanningState = stored;
        var isCurrent = stored.dayYmd === dayYmd && stored.signature === signature && stored.review;
        var review = isCurrent ? stored.review : buildFallbackTodayAiPlanning(dayYmd);
        var isStale = !isCurrent || stored.source === 'local' || stored.status === 'fallback';
        if (isStale) container.classList.add('is-stale');
        else container.classList.remove('is-stale');

        var head = document.createElement('div');
        head.className = 'plan-ai-review-head';
        var main = document.createElement('div');
        var title = document.createElement('div');
        title.className = 'today-side-title';
        title.textContent = review.summary_title || 'AI план дня';
        main.appendChild(title);
        var note = document.createElement('div');
        note.className = 'today-side-subtitle';
        note.textContent = review.planning_note || 'AI-помощник по дню: как разгрузить Today, что оставить главным и куда безопаснее переносить задачи.';
        main.appendChild(note);
        var meta = document.createElement('div');
        meta.className = 'plan-ai-review-meta';
        meta.appendChild(createChip((stored.source === 'ai' && isCurrent) ? 'Источник: AI' : 'Источник: локальный обзор'));
        meta.appendChild(createChip('Обновлено: ' + formatPlanAiReviewStamp(stored.generatedAt)));
        if (review.best_target_day_ymd) meta.appendChild(createChip('Лучший день: ' + review.best_target_day_ymd));
        if (isStale) meta.appendChild(createChip('Нужен refresh'));
        main.appendChild(meta);
        head.appendChild(main);

        var actions = document.createElement('div');
        actions.className = 'plan-ai-review-actions';
        var refreshBtn = document.createElement('button');
        refreshBtn.type = 'button';
        refreshBtn.className = 'btn-secondary';
        refreshBtn.textContent = state.todayAiPlanningPending ? 'AI анализ...' : ((stored.source === 'ai' && isCurrent) ? 'Обновить AI план' : 'AI план дня');
        refreshBtn.disabled = !!state.todayAiPlanningPending;
        refreshBtn.addEventListener('click', function () { refreshTodayAiPlanning(dayYmd, true); });
        actions.appendChild(refreshBtn);

        var fallbackBtn = document.createElement('button');
        fallbackBtn.type = 'button';
        fallbackBtn.className = 'btn-ghost';
        fallbackBtn.textContent = 'Локальный обзор';
        fallbackBtn.addEventListener('click', function () {
          setTodayAiPlanningState({ dayYmd: dayYmd, signature: signature, generatedAt: new Date().toISOString(), source: 'local', status: 'ready', review: buildFallbackTodayAiPlanning(dayYmd) });
          renderTodayView();
        });
        actions.appendChild(fallbackBtn);

        if (review.best_target_day_ymd) {
          var bestBtn = document.createElement('button');
          bestBtn.type = 'button';
          bestBtn.className = 'btn-ghost';
          bestBtn.textContent = 'Открыть лучший день';
          bestBtn.addEventListener('click', function () {
            state.dayYmd = review.best_target_day_ymd;
            setActiveView('today');
            renderTodayView();
          });
          actions.appendChild(bestBtn);
        }

        var weekBtn = document.createElement('button');
        weekBtn.type = 'button';
        weekBtn.className = 'btn-ghost';
        weekBtn.textContent = 'К Неделе';
        weekBtn.addEventListener('click', function () { setActiveView('planner'); openPlannerWeekViewSafe(); });
        actions.appendChild(weekBtn);
        head.appendChild(actions);
        container.appendChild(head);

        var grid = document.createElement('div');
        grid.className = 'plan-ai-review-grid';
        grid.appendChild(createPlanAiReviewCard('Лучший ход', review.best_move));
        grid.appendChild(createPlanAiReviewCard('Перегруз и буфер', review.overload_note));
        grid.appendChild(createPlanAiReviewCard('Предлагаемые ходы', review.suggested_moves));
        grid.appendChild(createPlanAiReviewCard('Следующие действия', review.next_actions));
        if (Array.isArray(review.defer_candidates) && review.defer_candidates.length) {
          grid.appendChild(createPlanAiReviewCard('Кандидаты на перенос', review.defer_candidates));
        }
        container.appendChild(grid);
      }

      function getPlanWeekRangeLabel() {
        var days = buildVisibleDays('week');
        if (!days.length) return 'Текущая неделя';
        var first = days[0].date;
        var last = days[days.length - 1].date;
        return formatWithPlannerTimeZone(first, { day: 'numeric', month: 'long' }, '—') + ' — ' + formatWithPlannerTimeZone(last, { day: 'numeric', month: 'long' }, '—');
      }

      function normalizePlanAiReviewState(raw) {
        var review = raw && raw.review && typeof raw.review === 'object' ? raw.review : null;
        return {
          weekStart: String(raw && raw.weekStart || '').trim(),
          signature: String(raw && raw.signature || '').trim(),
          generatedAt: String(raw && raw.generatedAt || '').trim(),
          source: String(raw && raw.source || '').trim() || 'local',
          status: String(raw && raw.status || '').trim() || 'idle',
          review: review ? {
            summary_title: String(review.summary_title || '').trim(),
            weekly_focus: String(review.weekly_focus || '').trim(),
            review_note: String(review.review_note || '').trim(),
            top_priorities: Array.isArray(review.top_priorities) ? review.top_priorities.map(function (item) { return String(item || '').trim(); }).filter(Boolean).slice(0, 4) : [],
            overload_risks: Array.isArray(review.overload_risks) ? review.overload_risks.map(function (item) { return String(item || '').trim(); }).filter(Boolean).slice(0, 4) : [],
            suggested_moves: Array.isArray(review.suggested_moves) ? review.suggested_moves.map(function (item) { return String(item || '').trim(); }).filter(Boolean).slice(0, 4) : [],
            next_actions: Array.isArray(review.next_actions) ? review.next_actions.map(function (item) { return String(item || '').trim(); }).filter(Boolean).slice(0, 4) : [],
            best_day_ymd: String(review.best_day_ymd || '').trim()
          } : null
        };
      }

      function loadStoredPlanAiReviewState() {
        try {
          var raw = localStorage.getItem(PLAN_AI_REVIEW_STATE_STORAGE_KEY);
          if (!raw) return normalizePlanAiReviewState({});
          return normalizePlanAiReviewState(JSON.parse(raw));
        } catch (error) {
          return normalizePlanAiReviewState({});
        }
      }

      function persistPlanAiReviewState() {
        try { localStorage.setItem(PLAN_AI_REVIEW_STATE_STORAGE_KEY, JSON.stringify(normalizePlanAiReviewState(state.planAiReviewState || {}))); } catch (error) {}
      }

      function setPlanAiReviewState(next) {
        state.planAiReviewState = normalizePlanAiReviewState(next || {});
        persistPlanAiReviewState();
      }

      function buildPlanAiReviewSignature(data) {
        var weekStart = state.weekStart || getCurrentWeekStartYmd();
        var tasks = (data && Array.isArray(data.weekTasks) ? data.weekTasks : []).map(function (task) {
          return [
            String(task && task.id || ''),
            String(task && task.updated_at || ''),
            String(task && task.status || ''),
            String(task && task.due_at || ''),
            String((task && task.priority_manual) || (task && task.priority_ai) || ''),
            String(task && task.project_name || '')
          ].join('|');
        }).sort();
        return weekStart + '::' + tasks.join('||');
      }

      function formatPlanAiReviewStamp(value) {
        if (!value) return '—';
        var date = new Date(value);
        if (isNaN(date.getTime())) return '—';
        return date.toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
      }

      function getPlanAiReviewPayload(data) {
        var weekStart = state.weekStart || getCurrentWeekStartYmd();
        var capacity = getCapacityManagementWeekData(weekStart);
        return {
          user_id: String(state.userId || '').trim(),
          week_start: weekStart,
          week_label: getPlanWeekRangeLabel(),
          summary: {
            total: data && data.stats ? data.stats.total : 0,
            active: data && data.stats ? data.stats.active : 0,
            done: data && data.stats ? data.stats.done : 0,
            backlog: data && data.stats ? data.stats.backlog : 0,
            recurring: data && data.stats ? data.stats.recurring : 0,
            attention: data && data.stats ? data.stats.attention : 0,
            main: data && data.sections ? (data.sections.main || []).length : 0,
            total_planned_label: formatMinutesHoursLabel(data && data.stats ? data.stats.totalPlanned : 0)
          },
          capacity_days: Array.isArray(capacity && capacity.days) ? capacity.days.map(function (day) {
            return {
              day_ymd: day.dayYmd,
              day_label: day.dayLabel,
              planned_label: formatMinutesHoursLabel(day.plannedMinutes || 0),
              capacity_label: formatMinutesHoursLabel(day.capacityMinutes || 0),
              delta_label: ((day.deltaMinutes || 0) > 0 ? '+' : (day.deltaMinutes || 0) < 0 ? '-' : '±') + formatMinutesHoursLabel(Math.abs(day.deltaMinutes || 0)),
              tone: day.tone || 'neutral'
            };
          }) : [],
          tasks: (data && Array.isArray(data.weekTasks) ? data.weekTasks : []).slice(0, 28).map(function (task) {
            return {
              id: task.id,
              title: task.title || '',
              product: task.task_product || '',
              day_label: task.due_at ? formatYmdLocal(new Date(task.due_at)) : 'без даты',
              status_label: getStatusLabel(normalizeStatus(task.status)),
              project_name: normalizeProjectName(task.project_name),
              priority_label: getPriorityText(getTaskPriorityRank(task)) || 'не задан',
              planned_label: formatMinutesHoursLabel(getTaskPlannedMinutesValue(task)),
              actual_label: formatMinutesHoursLabel(Math.max(0, Number(task && task.actual_minutes || 0) || 0)),
              attention: !!isTaskAttentionNeeded(task),
              focus_protected: !!isTaskFocusProtected(task.id)
            };
          })
        };
      }

      function buildFallbackPlanAiReview(data) {
        var capacity = getCapacityManagementWeekData(state.weekStart || getCurrentWeekStartYmd());
        var overloadDays = (capacity && Array.isArray(capacity.days) ? capacity.days : []).filter(function (day) { return (day.deltaMinutes || 0) < 0; });
        var warningDays = (capacity && Array.isArray(capacity.days) ? capacity.days : []).filter(function (day) { return (day.deltaMinutes || 0) >= 0 && (day.warningLevel === 'warning' || day.warningLevel === 'danger'); });
        var main = data && data.sections ? data.sections.main || [] : [];
        var important = data && data.sections ? data.sections.important || [] : [];
        var noDate = data && data.sections ? data.sections.noDate || [] : [];
        var risk = data && data.sections ? data.sections.risk || [] : [];
        var topTasks = (main.length ? main : important).slice(0, 3).map(function (task) { return task.title || 'Без названия'; });
        var overloadNotes = overloadDays.slice(0, 3).map(function (day) { return day.dayLabel + ': перегруз ' + ((day.deltaMinutes || 0) > 0 ? '+' : (day.deltaMinutes || 0) < 0 ? '-' : '±') + formatMinutesHoursLabel(Math.abs(day.deltaMinutes || 0)); });
        var moveNotes = [];
        if (noDate.length) moveNotes.push('Подними из backlog 1–2 задачи без даты только после разгрузки рисковых дней.');
        if (risk.length) moveNotes.push('Сначала разберите секцию «Риски недели» и блокеры, потом докладывайте важное в Today.');
        if (overloadDays.length) moveNotes.push('Разгрузите перегруженные дни: ' + overloadDays.slice(0, 2).map(function (day) { return day.dayLabel; }).join(', ') + '.');
        if (!moveNotes.length && warningDays.length) moveNotes.push('На днях без буфера держите только главные задачи и фокус-защиту.');
        var bestDay = '';
        var bestDayCard = (capacity && Array.isArray(capacity.days) ? capacity.days : []).slice().sort(function (a, b) { return (b.deltaMinutes || 0) - (a.deltaMinutes || 0); }).find(function (day) { return (day.deltaMinutes || 0) > 0; });
        if (bestDayCard) bestDay = bestDayCard.dayYmd || '';
        return {
          summary_title: overloadDays.length ? 'Неделя требует разгрузки' : (risk.length ? 'Неделя под контролем, но начни с рисков' : 'Неделя выглядит управляемо'),
          weekly_focus: main.length ? ('Главный фокус недели — удержать и довести: ' + main.slice(0, 3).map(function (task) { return task.title || 'Без названия'; }).join(', ') + '.') : 'Сначала собери 1–3 главные задачи недели, затем распределяй остальное по Today и неделе.',
          review_note: overloadDays.length ? 'Есть дни, где план уже превышает ёмкость. Не добавляй туда backlog, пока не разгрузишь перегруз.' : 'Слой Plan готов для weekly review: сначала риски и главное, потом дополнительные и повторы.',
          top_priorities: topTasks.length ? topTasks : ['Нет явного набора главных задач недели.'],
          overload_risks: overloadNotes.length ? overloadNotes : (risk.slice(0, 3).map(function (task) { return task.title || 'Без названия'; }).length ? risk.slice(0, 3).map(function (task) { return task.title || 'Без названия'; }) : ['Критичного перегруза по ёмкости не видно.']),
          suggested_moves: moveNotes.length ? moveNotes.slice(0, 4) : ['Подготовь Today через главные задачи недели и сохранённые виды.'],
          next_actions: [
            main.length ? 'Проверь главные задачи недели и убедись, что они стоят в правильных днях.' : 'Выбери 1–3 главные задачи через ритуал дня и недельный обзор.',
            risk.length ? 'Открой секцию «Риски недели» и сними блокеры.' : 'Проверь, нет ли задач с риском или stalled-состоянием.',
            noDate.length ? 'Подтяни из backlog только то, что реально успеет в текущую ёмкость.' : 'Сохрани свободный буфер для непредвиденных задач.'
          ].filter(Boolean).slice(0, 4),
          best_day_ymd: bestDay
        };
      }

      function requestPlanAiReview(data) {
        var payload = getPlanAiReviewPayload(data);
        return requestJson('/ai/weekly-plan', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload)
        });
      }

      function refreshPlanAiReview(forceAi) {
        var data = getPlanViewData();
        var signature = buildPlanAiReviewSignature(data);
        var fallback = buildFallbackPlanAiReview(data);
        if (!(forceAi || String(state.userId || '').trim())) {
          setPlanAiReviewState({ weekStart: state.weekStart || getCurrentWeekStartYmd(), signature: signature, generatedAt: new Date().toISOString(), source: 'local', status: 'ready', review: fallback });
          renderPlanView();
          return Promise.resolve();
        }
        state.planAiReviewPending = true;
        renderPlanView();
        return requestPlanAiReview(data)
          .then(function (response) {
            setPlanAiReviewState({ weekStart: state.weekStart || getCurrentWeekStartYmd(), signature: signature, generatedAt: new Date().toISOString(), source: 'ai', status: 'ready', review: response && response.review ? response.review : fallback });
            showSuccess('AI weekly review обновлён.');
          })
          .catch(function () {
            setPlanAiReviewState({ weekStart: state.weekStart || getCurrentWeekStartYmd(), signature: signature, generatedAt: new Date().toISOString(), source: 'local', status: 'fallback', review: fallback });
            showError('AI review не удалось получить. Показан локальный weekly review.');
          })
          .finally(function () {
            state.planAiReviewPending = false;
            renderPlanView();
          });
      }

