      async function loadPlanner(options) {
        options = options || {};
        if (!state.userId) {
          showError('Сначала укажи user_id или открой страницу через /app в Telegram.');
          return;
        }

        var requestedUserId = String(state.userId || '').trim();
        var requestedWeekStart = String(state.weekStart || '').trim();
        if (state.loadInFlightPromise) {
          if (requestedUserId !== String(state.plannerLastRequestedUserId || '') || requestedWeekStart !== String(state.plannerLastRequestedWeekStart || '')) {
            queuePlannerReload(options.reason || 'planner-context-changed');
          } else {
            queuePlannerReload(options.reason || 'planner-load-coalesced');
          }
          return state.loadInFlightPromise;
        }

        state.requestState = 'loading';
        state.plannerLoadStartedAt = Date.now();
        state.plannerLastRequestedUserId = requestedUserId;
        state.plannerLastRequestedWeekStart = requestedWeekStart;
        updateDebugInfo();
        showError('');
        updateWeekLabels();

        var controller = new AbortController();
        state.currentAbortController = controller;
        var loadSeq = ++state.loadSeq;
        var previousAllTasks = Array.isArray(state.allTasks) ? state.allTasks.slice() : [];
        var previousAllProjects = Array.isArray(state.allProjects) ? state.allProjects.slice() : [];
        var previousDependencyMap = cloneDependencyMap(state.dependencyMap);

        state.loadInFlightPromise = (async function () {
          var timeoutId = setTimeout(function () { controller.abort(); }, REQUEST_TIMEOUT_MS);
          try {
            var data = await fetchPlannerReadJson('/tasks/planner', {
              week_start: requestedWeekStart,
              queue_limit: String(PLANNER_QUEUE_LOAD_LIMIT)
            }, controller, 'planner-load');
            if (loadSeq !== state.loadSeq) return;
            if (hasPlannerLoadContextChanged(requestedUserId, requestedWeekStart)) {
              queuePlannerReload('planner-stale-response');
              return;
            }

            state.planner = data.planner;
            state.plannerSource = 'planner-api';

            var auxiliaryResults = await Promise.allSettled([
              fetchPlannerReadJson('/tasks', { limit: '400' }, controller, 'planner-all-tasks'),
              fetchPlannerReadJson('/projects', {}, controller, 'planner-projects'),
              fetchPlannerReadJson('/tasks/dependencies-map', {}, controller, 'planner-dependencies'),
              hydrateInboxStageMap()
            ]);

            if (hasPlannerLoadContextChanged(requestedUserId, requestedWeekStart)) {
              queuePlannerReload('planner-stale-aux-response');
              return;
            }

            var tasksResult = auxiliaryResults[0];
            if (tasksResult && tasksResult.status === 'fulfilled') {
              state.allTasks = tasksResult.value && tasksResult.value.items ? (tasksResult.value.items || []) : [];
            } else {
              state.allTasks = previousAllTasks;
            }

            var projectsResult = auxiliaryResults[1];
            if (projectsResult && projectsResult.status === 'fulfilled') {
              state.allProjects = projectsResult.value && projectsResult.value.items ? (projectsResult.value.items || []) : [];
            } else {
              state.allProjects = previousAllProjects;
            }

            var dependenciesResult = auxiliaryResults[2];
            if (dependenciesResult && dependenciesResult.status === 'fulfilled') {
              state.dependencyMap = normalizeDependencyMap((dependenciesResult.value && dependenciesResult.value.items) || []);
            } else {
              state.dependencyMap = previousDependencyMap;
            }

            await hydrateDayBlockInstancesForVisibleRange({ silent: true });
            state.lastLoadAt = new Date().toLocaleString();
            state.requestState = 'loaded';
            renderPlanner(data.planner);
            renderShellViews();
            state.liveOverdueSignature = buildLiveOverdueSignature();
            refreshLiveNowIndicators();
            refreshReminderWatcher();
            updateWeekLabels();
            updateDebugInfo();
          } catch (error) {
            if (error && error.name === 'AbortError') {
              if (loadSeq === state.loadSeq) {
                state.requestState = 'aborted';
                updateDebugInfo();
              }
              return;
            }

            state.requestState = 'error';
            updateDebugInfo();
            showError(String(error));
          } finally {
            clearTimeout(timeoutId);
            if (state.currentAbortController === controller) state.currentAbortController = null;
            state.loadInFlightPromise = null;
            state.plannerLoadStartedAt = 0;
            state.plannerLastRequestedUserId = '';
            state.plannerLastRequestedWeekStart = '';
            if (state.pendingPlannerReload) setTimeout(flushPendingPlannerReload, 0);
          }
        })();

        return state.loadInFlightPromise;
      }

      async function updateTaskStatus(taskId, nextStatus) {
        if (!state.userId) {
          showError('Сначала укажи user_id.');
          return;
        }
        hideTaskHoverCard();
        var currentTask = findTaskById(taskId);
        var protectionSettings = state.focusProtectionSettings || getDefaultFocusProtectionSettings();
        if (currentTask && currentTask.id && isTaskFocusProtected(currentTask.id) && protectionSettings.enabled && protectionSettings.requireConfirmBeforeMove) {
          if (nextStatus === STATUS.POSTPONED || nextStatus === STATUS.CANCELED || nextStatus === STATUS.NEW) {
            var allowProtectedStatusChange = window.confirm('Эта задача стоит в защищённом фокус-слоте. Изменить её статус и вывести слот из защищённого режима?');
            if (!allowProtectedStatusChange) return;
          }
        }
        state.requestState = 'смена-статуса';
        updateDebugInfo();
        showError('');
