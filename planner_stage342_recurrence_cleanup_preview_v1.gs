      function bindWeekNavSticky() {
        var shell = byId('weekNavShell');
        if (!shell || shell.dataset.boundSticky) return;
        function applyStickyState() {
          shell.classList.toggle('is-condensed', window.scrollY > 120);
          syncStickyOffsets();
        ensureLiveNowTicker();
        }
        window.addEventListener('scroll', applyStickyState, { passive: true });
