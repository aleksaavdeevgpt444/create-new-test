function getConfiguredAiProviderTimeoutMs(env, options) {
  const candidates = [options && options.providerTimeoutMs, env && env.AI_PROVIDER_TIMEOUT_MS, AI_PROVIDER_REQUEST_TIMEOUT_MS_DEFAULT];
  for (let i = 0; i < candidates.length; i += 1) {
    const parsed = Number(candidates[i]);
    if (Number.isFinite(parsed) && parsed >= 5000 && parsed <= 180000) return Math.round(parsed);
  }
  return AI_PROVIDER_REQUEST_TIMEOUT_MS_DEFAULT;
}

function getConfiguredAiChainTimeoutMs(env, options) {
  const candidates = [options && options.chainTimeoutMs, options && options.timeoutMs, env && env.AI_CHAIN_TIMEOUT_MS, env && env.AI_REQUEST_TIMEOUT_MS, 90000];
  for (let i = 0; i < candidates.length; i += 1) {
    const parsed = Number(candidates[i]);
    if (Number.isFinite(parsed) && parsed >= 15000 && parsed <= 180000) return Math.round(parsed);
  }
  return 90000;
}

function getAiProviderAttemptTimeoutMs(chainTimeoutMs, preferredProviderTimeoutMs, attemptIndex, totalProviders, chainStartedAt) {
  const minimumTimeoutMs = 5000;
  const reservePerRemainingProviderMs = 5000;
  const elapsedMs = Math.max(0, Date.now() - Number(chainStartedAt || Date.now()));
  const remainingBudgetMs = Math.max(minimumTimeoutMs, Math.round(Number(chainTimeoutMs || 0) - elapsedMs));
  const remainingProviders = Math.max(1, Number(totalProviders || 1) - Number(attemptIndex || 0));
  const reservedForRestMs = Math.max(0, (remainingProviders - 1) * reservePerRemainingProviderMs);
  const availableForCurrentMs = Math.max(minimumTimeoutMs, remainingBudgetMs - reservedForRestMs);
  const fairShareMs = Math.max(minimumTimeoutMs, Math.floor(remainingBudgetMs / remainingProviders));
  return Math.max(minimumTimeoutMs, Math.min(Number(preferredProviderTimeoutMs || minimumTimeoutMs), availableForCurrentMs, fairShareMs));
}

function getAiProviderChain(env) {
