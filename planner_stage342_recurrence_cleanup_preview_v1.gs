          var singleDefaultDiff = getKnowledgeFrameworkDefaultDiff(currentFramework, afterSingleFramework);
          return {
            type: 'framework',
            id: request.id,
            title: frameworkEntry ? frameworkEntry.title : getFrameworkTitle(request.id),
            subtitle: frameworkEntry ? (frameworkEntry.summary || frameworkEntry.bestFor || '') : 'Включит методику в core framework settings.',
            enabledFrameworks: singleEnabledDiff.enabled,
