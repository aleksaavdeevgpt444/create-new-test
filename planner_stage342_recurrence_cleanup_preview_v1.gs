async function handleRecurrenceDuplicatesApi(request, env) {
  // Read-only: only GET is allowed
  if (String(request.method || 'GET').toUpperCase() !== 'GET') {
    return textResponse('Method Not Allowed', 405);
  }

  const url = new URL(request.url);
  const userId = url.searchParams.get('user_id') || null;
  if (!userId) {
    return jsonResponse({
      ok: false,
      error: 'user_id is required',
      route: '/diagnostics/recurrence-duplicates',
      hint: 'Call /diagnostics/recurrence-duplicates?user_id=...',
      build: getClientAppBuildLabel()
    }, { status: 400 });
  }

  try {
    const limitParam = Math.min(Number(url.searchParams.get('limit') || 2000), 5000);
    const groups = await findRecurrenceDuplicateGroups_(env, userId, { limit: limitParam });

    // Stage339: response format aligned to contract spec
    const duplicateGroupsCount = groups.length;
    const duplicateTasksCount = groups.reduce(function (acc, g) {
      return acc + (Array.isArray(g.recommended_duplicate_ids) ? g.recommended_duplicate_ids.length : 0);
    }, 0);

    return jsonResponse({
      ok: true,
      user_id: String(userId),
      // contract fields
      duplicate_groups_count: duplicateGroupsCount,
      duplicate_tasks_count: duplicateTasksCount,
      groups,
      // backward-compat aliases
      count_groups: duplicateGroupsCount,
      count_duplicate_tasks: duplicateTasksCount,
      duplicate_groups: groups,
      note: 'Read-only. No changes made. Use /maintenance/recurrence-deduplicate-preview to preview cleanup.',
      build: getClientAppBuildLabel()
    });
  } catch (error) {
    return jsonResponse({
      ok: false,
      error: String(error),
      route: '/diagnostics/recurrence-duplicates',
      build: getClientAppBuildLabel()
    }, { status: 500 });
  }
}
