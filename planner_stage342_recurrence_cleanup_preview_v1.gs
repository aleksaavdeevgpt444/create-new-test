      function renderInboxView() {
        var summary = getInboxSummary();
        var sourceSelect = byId('inboxSourceFilterSelect');
        if (sourceSelect) {
          var previous = state.inboxSourceFilter || 'all';
          sourceSelect.innerHTML = '';
          summary.sources.forEach(function (item) {
            var option = document.createElement('option');
            option.value = item.value;
            option.textContent = item.label;
            sourceSelect.appendChild(option);
          });
          var hasCurrent = summary.sources.some(function (item) { return item.value === previous; });
          state.inboxSourceFilter = hasCurrent ? previous : 'all';
          sourceSelect.value = state.inboxSourceFilter;
        }
        if (byId('inboxStageFilterSelect')) byId('inboxStageFilterSelect').value = state.inboxFilter || 'active';

        var cards = byId('inboxSummaryGrid');
        if (cards) {
          cards.innerHTML = '';
          cards.appendChild(createInboxSummaryCard(summary.activeCount, 'Активно во входящих', ''));
          cards.appendChild(createInboxSummaryCard(summary.newCount, 'Новых', 'is-new'));
          cards.appendChild(createInboxSummaryCard(summary.triagedCount, 'Разобрано', ''));
          cards.appendChild(createInboxSummaryCard(summary.planCount, 'В план', ''));
          cards.appendChild(createInboxSummaryCard(summary.projectsCount, 'В проекты', ''));
          cards.appendChild(createInboxSummaryCard(summary.archiveCount, 'В архиве', 'is-muted'));
        }
        renderInboxBridgeCard();

        var sourceFilter = state.inboxSourceFilter || 'all';
        var stageFilter = state.inboxFilter || 'active';
        function pass(task, stage) {
          if (sourceFilter !== 'all' && getInboxSourceKey(task) !== sourceFilter) return false;
          if (stageFilter === 'archive') return stage === 'archive';
          if (stageFilter === 'active') return stage !== 'archive';
          return true;
        }

        renderInboxSection('inboxStageNew', 'inboxCountNew', applyWorkspaceTaskFilters(summary.collections.new.filter(function (task) { return pass(task, 'new'); })), 'new', 'Новых задач во входящем слое пока нет.');
        renderInboxSection('inboxStageTriaged', 'inboxCountTriaged', applyWorkspaceTaskFilters(summary.collections.triaged.filter(function (task) { return pass(task, 'triaged'); })), 'triaged', 'Разобранных, но ещё не встроенных задач пока нет.');
        renderInboxSection('inboxStagePlan', 'inboxCountPlan', applyWorkspaceTaskFilters(summary.collections.plan.filter(function (task) { return pass(task, 'plan'); })), 'plan', 'Секция «В план» пока пуста.');
        renderInboxSection('inboxStageProjects', 'inboxCountProjects', applyWorkspaceTaskFilters(summary.collections.projects.filter(function (task) { return pass(task, 'projects'); })), 'projects', 'Секция «В проекты» пока пуста.');
        renderInboxSection('inboxStageArchive', 'inboxCountArchive', applyWorkspaceTaskFilters(summary.collections.archive.filter(function (task) { return pass(task, 'archive'); })).slice(0, 30), 'archive', 'Архив Inbox пуст.');
        applySideSectionsState(byId('inboxView') || document);
      }

      function getProjectPriorityRankByValue(value) {
        var safe = String(value || '').trim().toLowerCase();
        if (safe === 'high') return 3;
        if (safe === 'medium') return 2;
        if (safe === 'low') return 1;
        return 0;
      }

      function getProjectLatestActivityTs(item) {
        var stamps = [];
        (item && item.tasks || []).forEach(function (task) {
          if (task && task.updated_at) stamps.push(new Date(task.updated_at).getTime());
          if (task && task.due_at) stamps.push(new Date(task.due_at).getTime());
        });
        if (item && item.meta && item.meta.updated_at) stamps.push(new Date(item.meta.updated_at).getTime());
        if (item && item.meta && item.meta.created_at) stamps.push(new Date(item.meta.created_at).getTime());
        stamps = stamps.filter(function (value) { return isFinite(value); });
        return stamps.length ? Math.max.apply(Math, stamps) : 0;
      }

      function getProjectSearchHaystack(item) {
        return [
          item && item.name || '',
          item && item.meta && item.meta.description || '',
          item && item.meta && item.meta.notes || '',
          item && item.meta && item.meta.links_text || ''
        ].join(' ').toLowerCase();
      }

      function getProjectFilterSettings() {
        var focus = String(state.projectsFocus || 'active').trim() || 'active';
        if (['active', 'all', 'attention', 'today', 'week', 'backlog', 'inactive'].indexOf(focus) < 0) focus = 'active';
        var priority = String(state.projectsPriorityFilter || 'all').trim() || 'all';
        if (['all', 'high', 'medium', 'low', 'none'].indexOf(priority) < 0) priority = 'all';
        var sort = String(state.projectsSort || 'attention').trim() || 'attention';
        if (['attention', 'priority', 'size', 'updated', 'name'].indexOf(sort) < 0) sort = 'attention';
        return {
          search: String(state.projectsSearch || '').trim(),
          focus: focus,
          priority: priority,
          sort: sort
        };
      }

      function getProjectCardStatusText(item) {
        if (!(item && item.stats)) return 'Пока нет активных задач.';
        if (item.stats.overdueCount > 0) return 'Есть просроченные задачи, проект требует внимания.';
        if (item.stats.todayCount > 0) return 'В проекте есть задачи на сегодня.';
        if (item.stats.weekCount > 0) return 'Проект уже разложен по неделе.';
        if (item.stats.backlogCount > 0) return 'В проекте есть backlog без слотов.';
        if (item.stats.activeCount > 0) return 'Есть активные задачи без срочного риска.';
        return 'Активных задач сейчас нет.';
      }

      function projectMatchesProjectsFilters(item, settings) {
        var safe = settings || getProjectFilterSettings();
        if (!item) return false;
        if (safe.search) {
          if (getProjectSearchHaystack(item).indexOf(safe.search.toLowerCase()) === -1) return false;
        }
        var priorityValue = item && item.meta && item.meta.priority ? String(item.meta.priority).trim().toLowerCase() : '';
        var priorityFilterValue = priorityValue || 'none';
        if (safe.priority !== 'all' && priorityFilterValue !== safe.priority) return false;
        if (safe.focus === 'active' && item.stats.activeCount <= 0) return false;
        if (safe.focus === 'attention' && item.stats.overdueCount <= 0 && item.stats.todayCount <= 0) return false;
        if (safe.focus === 'today' && item.stats.todayCount <= 0) return false;
        if (safe.focus === 'week' && item.stats.weekCount <= 0) return false;
        if (safe.focus === 'backlog' && item.stats.backlogCount <= 0) return false;
        if (safe.focus === 'inactive' && item.stats.activeCount > 0) return false;
        return true;
      }

      function compareProjectItems(a, b, sortKey) {
        var safeSort = String(sortKey || 'attention');
        if (safeSort === 'priority') {
          return getProjectPriorityRankByValue(b && b.meta && b.meta.priority) - getProjectPriorityRankByValue(a && a.meta && a.meta.priority)
            || b.stats.overdueCount - a.stats.overdueCount
            || b.stats.todayCount - a.stats.todayCount
            || b.stats.activeCount - a.stats.activeCount
            || a.name.localeCompare(b.name, 'ru');
        }
        if (safeSort === 'size') {
          return b.stats.activeCount - a.stats.activeCount
            || b.stats.weekCount - a.stats.weekCount
            || b.stats.backlogCount - a.stats.backlogCount
            || a.name.localeCompare(b.name, 'ru');
        }
        if (safeSort === 'updated') {
          return getProjectLatestActivityTs(b) - getProjectLatestActivityTs(a)
            || b.stats.overdueCount - a.stats.overdueCount
            || a.name.localeCompare(b.name, 'ru');
        }
        if (safeSort === 'name') {
          return a.name.localeCompare(b.name, 'ru');
        }
        return b.stats.overdueCount - a.stats.overdueCount
          || b.stats.todayCount - a.stats.todayCount
          || getProjectPriorityRankByValue(b && b.meta && b.meta.priority) - getProjectPriorityRankByValue(a && a.meta && a.meta.priority)
          || b.stats.activeCount - a.stats.activeCount
          || a.name.localeCompare(b.name, 'ru');
      }

