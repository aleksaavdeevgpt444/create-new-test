        const queueLimit = Number(url.searchParams.get("queue_limit")) || PLANNER_QUEUE_LIMIT;
        if (!userId) {
          return jsonResponse({
            ok: false,
            error: "user_id is required",
            build: getClientAppBuildLabel(),
            hint: "Open /app?user_id=... or call /tasks/planner?user_id=...",
            example: `${url.origin}/tasks/planner?user_id=1436885461&week_start=${getServerCurrentWeekStartYmd()}`
          }, { status: 400 });
