      function updateExecutionFlowSetting(path, value) {
        var next = normalizeExecutionFlowSettings(state.executionFlowSettings || getDefaultExecutionFlowSettings());
        if (path === 'today.enabled') next.today.enabled = !!value;
        else if (path === 'today.oneThreeFive') next.today.oneThreeFive = !!value;
        else if (path === 'today.eisenhower') next.today.eisenhower = !!value;
        else if (path === 'today.abcde') next.today.abcde = !!value;
        else if (path === 'today.gtd') next.today.gtd = !!value;
        else if (path === 'today.energy') next.today.energy = !!value;
        else if (path === 'today.capacity') next.today.capacity = !!value;
        else if (path === 'week.enabled') next.week.enabled = !!value;
        else if (path === 'week.weeklyReview') next.week.weeklyReview = !!value;
