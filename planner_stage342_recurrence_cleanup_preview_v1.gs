    { provider: 'gemini', label: 'Gemini', model: getConfiguredGeminiGenerationModel(env), channel: 'gemini_api' },
    { provider: 'gemma', label: 'Gemma', model: getConfiguredGemmaGenerationModel(env), channel: 'gemini_api' },
    { provider: 'qwen', label: 'Qwen', model: getConfiguredQwenGenerationModel(env), channel: 'groq' }
  ];
}

function getAiProviderChainLabel(env) {
