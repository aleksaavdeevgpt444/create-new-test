          var focusPreview = document.createElement('div');
          focusPreview.className = 'ritual-review-preview';
          focusPreview.innerHTML = '<strong>Последний фокус</strong><span>' + escapeHtml(focusTask.title) + '</span>';
          taskList.appendChild(focusPreview);
