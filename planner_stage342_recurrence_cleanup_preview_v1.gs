      function getFrameworkMeta(frameworkId) {
        var key = String(frameworkId || '').trim().toLowerCase();
        for (var i = 0; i < FRAMEWORK_CORE_REGISTRY.length; i += 1) {
          if (FRAMEWORK_CORE_REGISTRY[i].id === key) return FRAMEWORK_CORE_REGISTRY[i];
        }
        return null;
      }

      function getFrameworkTitle(frameworkId) {
        var meta = getFrameworkMeta(frameworkId);
        if (meta) return meta.title;
        var knowledgeEntry = getFrameworkKnowledgeEntryById(frameworkId);
        return knowledgeEntry ? knowledgeEntry.title : 'Без методики';
      }

      function getDefaultFrameworkSettings() {
        var settings = {
          enabled: Object.create(null),
          defaults: {
            task: '',
            day: 'time_blocking',
            week: 'weekly_review',
            project: ''
          }
        };
        FRAMEWORK_CORE_REGISTRY.forEach(function (item) {
          settings.enabled[item.id] = item.defaultEnabled === true;
        });
        return settings;
      }

      function normalizeFrameworkSettings(value) {
        var defaults = getDefaultFrameworkSettings();
        var source = value && typeof value === 'object' ? value : {};
        var normalized = {
          enabled: Object.create(null),
          defaults: {
            task: '',
            day: '',
            week: '',
            project: ''
          }
        };
        FRAMEWORK_CORE_REGISTRY.forEach(function (item) {
          normalized.enabled[item.id] = source.enabled && source.enabled[item.id] === true ? true : defaults.enabled[item.id] === true;
        });
        ['task', 'day', 'week', 'project'].forEach(function (scope) {
          var raw = String(source.defaults && source.defaults[scope] || defaults.defaults[scope] || '').trim().toLowerCase();
          normalized.defaults[scope] = getFrameworkMeta(raw) ? raw : '';
        });
        return normalized;
      }

      function loadStoredFrameworkSettings() {
        try {
          var raw = localStorage.getItem(FRAMEWORK_SETTINGS_STORAGE_KEY);
          if (!raw) return getDefaultFrameworkSettings();
          return normalizeFrameworkSettings(JSON.parse(raw));
        } catch (error) {
          return getDefaultFrameworkSettings();
        }
      }

      function saveStoredFrameworkSettings() {
        try {
          localStorage.setItem(FRAMEWORK_SETTINGS_STORAGE_KEY, JSON.stringify(normalizeFrameworkSettings(state.frameworkSettings || getDefaultFrameworkSettings())));
        } catch (error) {}
      }

      function getDefaultServerSyncState() {
        return { source: 'fallback', status: 'idle', userId: '', syncedAt: '', details: '' };
      }

      function normalizeServerSyncState(value) {
        var source = value && typeof value === 'object' ? value : {};
        return {
          source: ['server', 'migrated', 'fallback'].indexOf(String(source.source || '').trim().toLowerCase()) >= 0 ? String(source.source || '').trim().toLowerCase() : 'fallback',
          status: String(source.status || 'idle').trim().toLowerCase() || 'idle',
          userId: String(source.userId || source.user_id || '').trim(),
          syncedAt: String(source.syncedAt || source.synced_at || '').trim(),
          details: String(source.details || '').trim()
        };
      }

      function formatServerSyncStateLabel(value) {
        var normalized = normalizeServerSyncState(value);
        if (normalized.source === 'server') return 'Сервер';
        if (normalized.source === 'migrated') return 'Миграция';
        return 'Fallback';
      }

      function setServerSyncState(key, value) {
        if (!state || !key) return;
        var current = normalizeServerSyncState(state[key] || getDefaultServerSyncState());
        state[key] = normalizeServerSyncState(Object.assign({}, current, value || {}));
