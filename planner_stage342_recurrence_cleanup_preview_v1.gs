          blocksCount: Array.isArray(context.blockingTasks) ? context.blockingTasks.length : 0,
          riskLevel: String(riskInfo.riskLevel || 'none'),
          deadlineRisk: String(riskInfo.deadlineRiskState || 'normal'),
          stalledSince: String(riskInfo.stalledSince || '').trim()
        });
      }

      function buildEditorTaskHelpRequestPayload(sourceTask) {
        var draft = collectEditorTaskDraftForReadiness(sourceTask);
        var context = getEditorTaskHelpContext(sourceTask || findTaskById(draft.id) || { id: draft.id });
        var riskInfo = context.riskInfo || getTaskRiskMeta({});
        var readiness = buildEditorExecutionReadinessData(sourceTask);
        var planned = Number(draft.planned_minutes_effective || 0) || 0;
        var actual = draft.actual_minutes != null ? Number(draft.actual_minutes) || 0 : null;
        return {
          title: draft.title || '',
          project_name: draft.project_name || '',
          task_product: draft.task_product || '',
          description: draft.description || '',
          status: normalizeStatus(draft.status || STATUS.NEW),
          date_value: draft.date_value || '',
          time_value: draft.time_value || '',
          duration_minutes: draft.duration_minutes || null,
          planned_minutes_manual: getEditorPlannedMinutesManualValue(),
          actual_minutes: draft.actual_minutes,
          blocked_by_task_id: context.blockedByTaskId || '',
          blocked_by_title: context.blockedByTitle || '',
          blocking_task_titles: context.blockingTaskTitles || [],
          risk_level: riskInfo.riskLevel || 'none',
          deadline_risk_state: riskInfo.deadlineRiskState || 'normal',
          stalled_since: riskInfo.stalledSince || '',
          readiness_percent: Math.max(0, parseInt(String((readiness && readiness.meta && readiness.meta[0] || '').replace(/[^0-9]/g, '')), 10) || 0),
          plan_fact_delta_minutes: actual != null && planned > 0 ? (actual - planned) : null,
          _signature: buildEditorTaskHelpSignature(draft)
        };
      }

      function buildEditorTaskHelpFallback(sourceTask) {
        var draft = collectEditorTaskDraftForReadiness(sourceTask);
        var productQuality = evaluateTaskProductQualityFromDraft(draft);
        var context = getEditorTaskHelpContext(sourceTask || findTaskById(draft.id) || { id: draft.id });
        var riskInfo = context.riskInfo || getTaskRiskMeta({});
        var blockers = [];
        var missingData = [];
        var missingDecisions = [];
        var miniPlan = [];
        var decompositionSteps = [];
        var nextStep = '';
        var startAction = '';
        var startInFiveMinutes = '';
        var firstVisibleResult = '';
        var dependencyNote = 'Явных зависимостей для старта не найдено.';
        var riskNote = 'Явных сигналов риска для старта не видно.';
        var confidenceReason = 'Оценка собрана из заполненности полей задачи.';
        var tone = 'warning';
        var summaryTitle = 'Задачу стоит разобрать перед стартом';
        var note = 'Быстрый разбор собран из текущих полей задачи. Для более точного сценария запуска нажми «AI-разбор».';
        var executionMode = 'Подготовка к исполнению';
        var confidence = 'базовая';
        var focusMinutes = getEditorTaskHelpFocusMinutes(draft.planned_minutes_effective || draft.duration_minutes || 25);
        var inferredProject = normalizeAiProjectSuggestion(inferProjectSuggestionFromText(draft), '');
        var concreteGuidance = getTaskExecutionConcreteGuidance(draft);

        if (!draft.title) missingData.push('Добавь понятное название задачи');
        if (!draft.task_product) missingData.push('Сформулируй продукт задачи');
        if (!draft.has_due && draft.status !== STATUS.NEW) missingData.push('Уточни дату и время выполнения');
        if (!draft.has_due && draft.status === STATUS.NEW) missingData.push('Поставь задачу в план, когда она будет готова');
        if (!(draft.duration_minutes > 0)) missingData.push('Задай длительность');
        if (!draft.project_name || draft.project_name === 'Без проекта') missingData.push(inferredProject ? ('Подтверди проект «' + inferredProject + '»') : 'Выбери проект или направление');
        if (!draft.description || draft.description.length < 12) missingData.push('Добавь контекст в описание');
        if (productQuality.statusKey === 'vague') blockers.push('Продукт задачи пока слишком общий');
        if (draft.status === STATUS.POSTPONED) blockers.push('Задача сейчас в статусе «перенесена»');
        if (draft.status === STATUS.CANCELED) blockers.push('Задача отменена');
        if (context.blockedByTitle) {
          blockers.push('Есть блокер: ' + context.blockedByTitle);
          dependencyNote = 'Для старта сначала нужно продвинуть задачу-блокер: ' + context.blockedByTitle + '.';
        }
        if (context.blockingTaskTitles.length) {
          dependencyNote += ' Эта задача сама влияет на: ' + context.blockingTaskTitles.join(', ') + '.';
        }
        if (riskInfo.isStalled) blockers.push('Задача стоит без движения' + (riskInfo.stalledSince ? ' с ' + formatDateShortDisplay(riskInfo.stalledSince) : ''));
        if (riskInfo.deadlineRiskState !== 'normal') blockers.push('Есть риск дедлайна: ' + getDeadlineRiskLabel(riskInfo.deadlineRiskState));
        if (riskInfo.riskLevel && riskInfo.riskLevel !== 'none') blockers.push('Ручной риск: ' + getRiskLevelLabel(riskInfo.riskLevel));
        if (riskInfo.isAttentionNeeded) {
          riskNote = getRiskTaskReasonLines(sourceTask || findTaskById(draft.id) || { id: draft.id }).join(' ') || 'По задаче есть сигналы риска и внимания.';
        }

        if (!draft.task_product) missingDecisions.push('Что считается готовым результатом задачи');
        if (!draft.project_name || draft.project_name === 'Без проекта') missingDecisions.push(inferredProject ? ('Подходит ли проект «' + inferredProject + '» для этой задачи') : 'К какому проекту или направлению относится задача');
        if (!draft.has_due && draft.status !== STATUS.NEW) missingDecisions.push('Когда именно задача должна быть выполнена');

        if (draft.status === STATUS.DONE) {
          tone = 'success';
          summaryTitle = 'Задача уже выполнена';
          note = 'Сейчас важнее проверить итог, факт времени и при необходимости зафиксировать результат в описании или истории.';
          nextStep = 'Проверь результат задачи и убедись, что итог действительно можно считать завершённым.';
          startAction = 'Открой описание или продукт задачи и зафиксируй финальный результат.';
          startInFiveMinutes = 'Открой продукт задачи и сравни его с фактическим результатом.';
          firstVisibleResult = 'Зафиксирован и проверен итог задачи.';
          miniPlan = ['Проверь продукт задачи', 'Сверь план и факт времени', 'При необходимости зафиксируй итог в описании'];
          decompositionSteps = ['Проверь итог задачи', 'Сверь план/факт', 'Закрой хвосты по описанию или истории'];
          executionMode = 'Проверка результата';
          confidence = 'высокая';
          confidenceReason = 'Статус задачи уже завершённый, осталось проверить качество результата.';
        } else if (concreteGuidance) {
          summaryTitle = concreteGuidance.summaryTitle;
          note = 'Ниже — практичный сценарий старта, собранный из текущих полей задачи. Для более точной версии нажми «AI-разбор».';
          nextStep = concreteGuidance.nextStep;
          startAction = concreteGuidance.startAction;
          startInFiveMinutes = concreteGuidance.startInFiveMinutes;
          firstVisibleResult = concreteGuidance.firstVisibleResult;
          miniPlan = concreteGuidance.miniPlan.slice(0, 4);
          decompositionSteps = concreteGuidance.decompositionSteps.slice(0, 5);
          if ((!draft.project_name || draft.project_name === 'Без проекта') && inferredProject) miniPlan.unshift('Подтверди проект «' + inferredProject + '»');
          executionMode = concreteGuidance.executionMode || executionMode;
          focusMinutes = concreteGuidance.focusMinutes || focusMinutes;
          confidence = missingData.length || blockers.length ? 'средняя' : 'высокая';
          confidenceReason = missingData.length || blockers.length ? 'Сценарий старта уже понятен по содержанию задачи, но часть полей ещё требует подтверждения.' : 'Сценарий старта собран из конкретного содержания задачи и выглядит исполнимым.';
        } else if (missingData.length || blockers.length) {
          if (!draft.task_product) {
            nextStep = 'Сначала определи, что именно должно быть готово на выходе по этой задаче.';
            startAction = 'Заполни поле «Продукт задачи» не действием, а конкретным результатом.';
            startInFiveMinutes = 'Сформулируй один проверяемый итог задачи одним предложением.';
            firstVisibleResult = 'Появилась чёткая формулировка результата задачи.';
            miniPlan.push('Уточни продукт задачи');
            decompositionSteps.push('Сформулируй результат', 'Проверь, можно ли его измерить или увидеть');
          } else if (!draft.description || draft.description.length < 12) {
            nextStep = 'Добавь краткий контекст: что уже известно, какие есть ограничения и что считается хорошим итогом.';
            startAction = 'Заполни описание 1–3 конкретными вводными по задаче.';
            startInFiveMinutes = 'Добавь один абзац контекста: исходные данные, ограничение и ожидаемый результат.';
            firstVisibleResult = 'В задаче есть минимальный рабочий контекст для старта.';
            miniPlan.push('Добавь контекст в описание');
            decompositionSteps.push('Опиши исходные данные', 'Укажи ограничение или критерий качества');
          } else if (!draft.has_due) {
            nextStep = 'Поставь задачу в конкретный слот, чтобы она стала исполнимой, а не оставалась абстрактной.';
            startAction = 'Открой время и выбери дату, старт и длительность.';
            startInFiveMinutes = 'Выбери ближайший реальный слот и зафиксируй длительность.';
            firstVisibleResult = 'У задачи появился конкретный слот в плане.';
            miniPlan.push('Поставь задачу в план');
            decompositionSteps.push('Выбери день', 'Поставь старт', 'Зафиксируй длительность');
          } else {
            nextStep = sourceTask && sourceTask.ai_next_step ? sourceTask.ai_next_step : 'Убери главный пробел в данных и только потом переходи к исполнению.';
            startAction = 'Закрой первый недостающий элемент, который мешает старту.';
            startInFiveMinutes = context.blockedByTitle ? ('Открой задачу-блокер «' + context.blockedByTitle + '» и продвинь её на один шаг.') : 'Закрой первый недостающий элемент, который мешает старту.';
            firstVisibleResult = 'Убран главный пробел в данных или закрыт один блокер перед стартом.';
          }
          if (!miniPlan.length) miniPlan.push('Устрани главный пробел в данных');
          if (draft.project_name && draft.project_name !== 'Без проекта') miniPlan.push('Проверь связь с проектом «' + draft.project_name + '»');
          if (draft.has_due) miniPlan.push('После уточнения верни задачу в исполнение');
          if (!decompositionSteps.length) decompositionSteps = miniPlan.slice(0, 3);
          confidenceReason = 'У задачи ещё есть незаполненные поля или блокеры, поэтому сценарий старта пока промежуточный.';
        } else {
          tone = 'success';
          summaryTitle = 'Задача выглядит готовой к исполнению';
          note = (sourceTask && sourceTask.ai_next_step)
            ? 'Базовые поля уже собраны. Ниже показан ближайший следующий шаг из текущих AI-подсказок. Для более глубокого разбора нажми «AI-разбор».'
            : 'Базовые поля уже собраны. Можно входить в работу или уточнить стартовый шаг через «AI-разбор».';
          nextStep = sourceTask && sourceTask.ai_next_step ? sourceTask.ai_next_step : 'Открой задачу и сделай первый конкретный исполнимый шаг по результату.';
          startAction = draft.has_due
            ? 'Запусти работу с самого маленького физического действия, которое двигает задачу к результату.'
            : 'Сначала выбери слот в календаре, затем сразу начни с первого конкретного действия.';
          startInFiveMinutes = 'Подготовь всё необходимое и сделай первый микро-шаг, который точно занимает меньше 5 минут.';
          firstVisibleResult = 'Получен первый проверяемый промежуточный результат по продукту задачи.';
          miniPlan = [
            'Сделай первый шаг по продукту задачи',
            'Дойди до промежуточного видимого результата',
            'Сверь результат с формулировкой продукта'
          ];
          decompositionSteps = [
            'Подготовь входные данные или окружение',
            'Сделай первый конкретный шаг',
            'Проверь промежуточный результат',
            'Реши, нужен ли второй фокус-цикл'
          ];
          executionMode = draft.has_due ? 'Прямой старт' : 'Сборка в слот';
          confidence = 'средняя';
          confidenceReason = 'Ключевые поля заполнены, задача выглядит исполнимой без дополнительной декомпозиции.';
        }

        return {
          visible: !!draft.id,
          tone: tone,
          sourceType: 'fallback',
          sourceLabel: 'Базовый разбор',
          summaryTitle: summaryTitle,
          note: note,
          nextStep: nextStep,
          startAction: startAction,
          startInFiveMinutes: startInFiveMinutes,
          firstVisibleResult: firstVisibleResult,
          miniPlan: miniPlan.slice(0, 4),
          decompositionSteps: decompositionSteps.slice(0, 5),
          blockers: blockers.slice(0, 5),
          missingData: missingData.slice(0, 5),
          missingDecisions: missingDecisions.slice(0, 4),
          dependencyNote: dependencyNote,
          riskNote: riskNote,
          focusMinutes: focusMinutes,
          executionMode: executionMode,
          confidence: confidence,
          confidenceReason: confidenceReason,
          signature: buildEditorTaskHelpSignature(draft)
        };
      }

      function buildEditorTaskHelpViewData(sourceTask) {
        var draft = collectEditorTaskDraftForReadiness(sourceTask);
        var signature = buildEditorTaskHelpSignature(draft);
        var helpState = state.editorTaskHelpState || null;
        if (!draft.id) return { visible: false };
        if (helpState && helpState.taskId === draft.id && helpState.loading) {
          return {
            visible: true,
            tone: 'warning',
            sourceType: 'loading',
            sourceLabel: 'AI-разбор',
            summaryTitle: 'AI анализирует задачу',
            note: 'Собираю ближайший шаг, мини-план и недостающие данные по текущему черновику.',
            nextStep: '',
            startAction: '',
            miniPlan: [],
            decompositionSteps: [],
            blockers: [],
            missingData: [],
            missingDecisions: [],
            startInFiveMinutes: '',
            firstVisibleResult: '',
            dependencyNote: '',
            riskNote: '',
            confidenceReason: '',
            focusMinutes: getEditorTaskHelpFocusMinutes(draft.planned_minutes_effective || draft.duration_minutes || 25),
            executionMode: 'Анализ',
            confidence: 'в процессе',
            signature: signature,
            loading: true,
            stale: false,
            error: ''
          };
        }

        if (helpState && helpState.taskId === draft.id && helpState.data) {
          return Object.assign({}, helpState.data, {
            visible: true,
            stale: helpState.signature !== signature,
            signature: signature,
            error: helpState.error || ''
          });
        }

        var fallback = buildEditorTaskHelpFallback(sourceTask);
        if (helpState && helpState.taskId === draft.id && helpState.error) {
          fallback.error = helpState.error;
        }
        return fallback;
      }

      function createEditorTaskHelpAction(label, className, handler) {
        return { label: label, className: className || 'btn-ghost', handler: handler };
      }

      function appendEditorTaskHelpSection(container, titleText, contentText, listItems) {
        if ((!contentText || !String(contentText).trim()) && !(Array.isArray(listItems) && listItems.length)) return;
        var section = document.createElement('div');
        section.className = 'editor-task-help-summary-section';
        var title = document.createElement('div');
        title.className = 'editor-task-help-summary-section-title';
        title.textContent = titleText;
        section.appendChild(title);
        if (contentText && String(contentText).trim()) {
          var text = document.createElement('div');
          text.className = 'editor-task-help-summary-section-text';
          text.textContent = String(contentText).trim();
          section.appendChild(text);
        }
        if (Array.isArray(listItems) && listItems.length) {
          var list = document.createElement('ol');
          list.className = 'editor-task-help-summary-list';
          listItems.forEach(function (item) {
            var li = document.createElement('li');
            li.textContent = item;
            list.appendChild(li);
          });
          section.appendChild(list);
        }
        container.appendChild(section);
      }

      async function requestEditorTaskHelpAi() {
        if (!state.editorTaskId) return;
        var sourceTask = findTaskById(state.editorTaskId) || {};
        var payload = buildEditorTaskHelpRequestPayload(sourceTask);
        if (!String(payload.title || '').trim()) {
          showError('Сначала задай название задачи, потом запускай AI-разбор.');
          return;
        }
        var taskId = state.editorTaskId;
        var seq = (state.editorTaskHelpSeq || 0) + 1;
        state.editorTaskHelpSeq = seq;
        state.editorTaskHelpState = {
          taskId: taskId,
          loading: true,
          error: '',
          data: state.editorTaskHelpState && state.editorTaskHelpState.taskId === taskId ? state.editorTaskHelpState.data : null,
          signature: payload._signature
        };
        renderEditorTaskHelpSummary(sourceTask);
        showError('');
        try {
          var response = await requestJson('/tasks/next-step-ai', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
            __meta: { reportServerErrors: true, reportTransportErrors: false, requestName: 'ai-next-step-editor', timeoutMs: AI_REQUEST_TIMEOUT_MS }
          });
          if (seq !== state.editorTaskHelpSeq || taskId !== state.editorTaskId) return;
          var help = response && response.help ? response.help : null;
          var aiSourceLabel = response && response.ai_fallback ? 'Локальный fallback' : (getAiResponseSourceLabel(response) || 'AI-разбор');
          var aiSourceNote = response && response.ai_fallback
            ? 'Ниже — локально собранный fallback-разбор: он используется, когда AI-провайдеры временно недоступны или вернули пустой ответ.'
            : 'Ниже — прямой AI-ответ по текущему черновику задачи без локальной смысловой нормализации.';
          state.editorTaskHelpState = {
            taskId: taskId,
            loading: false,
            error: '',
            signature: payload._signature,
            data: {
              visible: true,
              tone: (help && (!help.blockers || !help.blockers.length) && (!help.missing_data || !help.missing_data.length)) ? 'success' : 'warning',
              sourceType: response && response.ai_fallback ? 'fallback' : 'ai',
              sourceLabel: aiSourceLabel,
              summaryTitle: help && help.summary_title ? help.summary_title : 'AI разбор задачи',
              note: aiSourceNote,
              nextStep: help && help.next_step ? help.next_step : '',
              startAction: help && help.start_action ? help.start_action : '',
              miniPlan: help && Array.isArray(help.mini_plan) ? help.mini_plan : [],
              decompositionSteps: help && Array.isArray(help.decomposition_steps) ? help.decomposition_steps : [],
              blockers: help && Array.isArray(help.blockers) ? help.blockers : [],
              missingData: help && Array.isArray(help.missing_data) ? help.missing_data : [],
              missingDecisions: help && Array.isArray(help.missing_decisions) ? help.missing_decisions : [],
              startInFiveMinutes: help && help.start_in_5_minutes ? help.start_in_5_minutes : '',
              firstVisibleResult: help && help.first_visible_result ? help.first_visible_result : '',
              dependencyNote: help && help.dependency_note ? help.dependency_note : '',
              riskNote: help && help.risk_note ? help.risk_note : '',
              focusMinutes: getEditorTaskHelpFocusMinutes(help && help.focus_minutes),
              executionMode: help && help.execution_mode ? help.execution_mode : 'Пошаговый старт',
              confidence: help && help.confidence ? help.confidence : 'средняя',
              confidenceReason: help && help.confidence_reason ? help.confidence_reason : '',
              signature: payload._signature
            }
          };
          renderEditorTaskHelpSummary(findTaskById(taskId) || sourceTask);
        } catch (error) {
          if (seq !== state.editorTaskHelpSeq || taskId !== state.editorTaskId) return;
          var aiErrorMessage = getAiUiErrorMessage(error, 'Не удалось получить AI-разбор задачи.');
          var shouldUseClientFallback = isTransportRequestError(error) || isTimeoutRequestError(error);
          if (shouldUseClientFallback) {
            var fallbackTask = findTaskById(taskId) || sourceTask;
            var fallbackData = buildEditorTaskHelpFallback(fallbackTask);
            fallbackData.sourceType = 'fallback';
            fallbackData.sourceLabel = isTimeoutRequestError(error) ? 'Базовый разбор · таймаут AI' : 'Базовый разбор · сеть';
            fallbackData.note = 'AI-разбор временно недоступен из-за сети или таймаута. Ниже показан локальный базовый разбор по текущим полям задачи; его можно использовать без ожидания AI.';
            fallbackData.error = aiErrorMessage;
            fallbackData.signature = payload._signature;
            state.editorTaskHelpState = {
              taskId: taskId,
              loading: false,
              error: aiErrorMessage,
              signature: payload._signature,
              data: fallbackData
            };
            renderEditorTaskHelpSummary(fallbackTask);
            console.warn('[planner-ai] ai-next-step-editor client fallback used', error);
            return;
          }
          state.editorTaskHelpState = {
            taskId: taskId,
            loading: false,
            error: aiErrorMessage,
            signature: payload._signature,
            data: null
          };
          renderEditorTaskHelpSummary(findTaskById(taskId) || sourceTask);
          reportAiClientFailure('ai-next-step-editor', error, { task_id: taskId });
          showError(aiErrorMessage);
        }
      }

      function renderEditorTaskHelpSummary(sourceTask) {
        var container = byId('editorTaskHelpSummary');
        if (!container) return;
        var data = buildEditorTaskHelpViewData(sourceTask);
        container.innerHTML = '';
        container.className = 'editor-task-help-summary';
        if (!(data && data.visible)) {
          container.classList.add('is-empty');
          container.innerHTML = '<div class="editor-task-help-summary-empty">Открой задачу, чтобы увидеть разбор ближайшего шага.</div>';
          return;
        }

        var card = document.createElement('div');
        card.className = 'editor-task-help-summary-card is-' + (data.sourceType || 'fallback');
        if (data.tone === 'success') card.classList.add('is-success');
        else if (data.tone === 'warning') card.classList.add('is-warning');
        if (data.loading) card.classList.add('is-loading');

        var head = document.createElement('div');
        head.className = 'editor-task-help-summary-head';

        var main = document.createElement('div');
        main.className = 'editor-task-help-summary-main';

        var label = document.createElement('div');
        label.className = 'editor-task-help-summary-label';
        label.textContent = 'AI Task Help / Next-Step AI';
        main.appendChild(label);

        var title = document.createElement('div');
