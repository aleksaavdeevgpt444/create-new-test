            card.appendChild(meta);
            var note = document.createElement('div');
            note.className = 'editor-linked-card-note';
            note.textContent = 'Пока эта задача не будет продвинута, зависимая задача будет считаться заблокированной.';
            card.appendChild(note);
            var actions = document.createElement('div');
