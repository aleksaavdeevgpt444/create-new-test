      function collectEditorTaskDraftForReadiness(sourceTask) {
        var source = sourceTask || findTaskById(state.editorTaskId) || {};
        var titleInput = byId('editorTitleInput');
        var productInput = byId('editorProductInput');
        var descriptionInput = byId('editorDescriptionInput');
        var statusSelect = byId('editorStatusSelect');
        var projectModeSelect = byId('editorProjectModeSelect');
        var projectSelect = byId('editorProjectSelect');
        var projectInput = byId('editorProjectInput');
        var dateInput = byId('editorDateInput');
        var timeInput = byId('editorTimeInput');
        var durationInput = byId('editorDurationInput');
        var plannedInput = byId('editorPlannedMinutesInput');
        var actualInput = byId('editorActualMinutesInput');

        var projectValue = '';
        if (projectModeSelect && projectModeSelect.value === 'list' && projectSelect) {
          projectValue = String(projectSelect.value || '').trim();
        } else if (projectInput) {
          projectValue = String(projectInput.value || '').trim();
        } else {
          projectValue = String(source.project_name || source.projectName || '').trim();
        }

        var dateValue = String((dateInput && dateInput.value) || '').trim();
        var timeValue = String((timeInput && timeInput.value) || '').trim();
        var durationValue = normalizeMinutesInputValue(durationInput && durationInput.value);
        var plannedManual = getEditorPlannedMinutesManualValue();
        var plannedEffective = plannedManual !== null ? plannedManual : getEditorPlannedMinutesAutoValue(source);
        var actualMinutes = normalizeMinutesInputValue(actualInput && actualInput.value);

        return {
          id: source.id || state.editorTaskId || '',
          title: String((titleInput && titleInput.value) || source.title || '').trim(),
          task_product: String((productInput && productInput.value) || source.task_product || '').trim(),
          description: String((descriptionInput && descriptionInput.value) || source.description || '').trim(),
          status: normalizeStatus((statusSelect && statusSelect.value) || source.status || STATUS.NEW),
          project_name: projectValue,
          date_value: dateValue,
          time_value: timeValue,
          has_due: !!(dateValue && timeValue),
          duration_minutes: durationValue !== null ? durationValue : getTaskDurationMinutes(source),
          planned_minutes_effective: plannedEffective,
          actual_minutes: actualMinutes,
          recurrence_enabled: Number((byId('editorRecurrenceEnabledInput') && byId('editorRecurrenceEnabledInput').value) || source.recurrence_enabled || 0) || 0
        };
      }

      function buildEditorExecutionReadinessData(sourceTask) {
        var draft = collectEditorTaskDraftForReadiness(sourceTask);
        var productQuality = evaluateTaskProductQualityFromDraft(draft);
        var missing = [];
        if (!draft.title) missing.push('Название');
        if (!draft.task_product) missing.push('Продукт');
        if (!draft.has_due) missing.push('Дата и время');
        if (!(draft.duration_minutes > 0)) missing.push('Длительность');
        if (!draft.project_name || draft.project_name === 'Без проекта') missing.push('Проект');
        if (!draft.description || draft.description.length < 12) missing.push('Контекст');
        var readyCount = 6 - missing.length;
        var score = Math.max(Math.round((readyCount / 6) * 100), 0);

        var data = {
          visible: !!draft.id,
          tone: 'warning',
          label: 'Готовность к исполнению',
          title: 'Задачу стоит уточнить перед стартом',
          note: 'Для уверенного старта задаче не хватает нескольких элементов. Дополни ключевые поля и потом уже запускай её в исполнение.',
          meta: [
            'Готовность: ' + score + '%',
            'Статус: ' + getStatusSingular(draft.status),
            'План: ' + formatMinutesShort(draft.planned_minutes_effective),
            'Продукт: ' + productQuality.statusLabel.toLowerCase()
          ],
          actions: [],
          missing: missing
        };

        if (draft.status === STATUS.DONE) {
          data.tone = 'success';
          data.title = 'Задача уже завершена';
          data.note = 'Задача закрыта. Можно проверить факт, историю и продукт результата, если нужно оформить итог.';
          data.actions.push({
            label: 'К истории',
            className: 'btn-ghost',
            handler: function () { scrollEditorFieldIntoView('editorHistoryPanel'); }
          });
          return data;
        }

        if (!missing.length) {
          if (productQuality.statusKey === 'vague') {
            data.tone = 'warning';
            data.title = 'Задача почти готова, но результат ещё стоит уточнить';
            data.note = 'Базовые поля уже заполнены, но продукт задачи пока слишком общий. Уточни конечный результат, чтобы задача была проще для исполнения и проверки.';
            data.actions.push(
              {
                label: 'Усилить продукт AI',
                className: 'btn-secondary',
                handler: function () { refreshEditorAi('product'); }
              },
              {
                label: 'К продукту',
                className: 'btn-ghost',
                handler: function () { scrollEditorFieldIntoView('editorProductInput'); }
              }
            );
            return data;
          }

          data.tone = 'success';
          data.title = draft.has_due ? 'Задача готова к исполнению' : 'Задача собрана, осталось поставить в план';
          data.note = draft.has_due
            ? 'У задачи есть понятный результат, контекст и время. Её можно сразу запускать в фокус или вести как основную задачу дня.'
            : 'Содержательно задача уже собрана. Выбери дату и время, чтобы превратить её в исполнимый блок дня.';
          data.actions.push(
            draft.has_due
              ? {
                  label: 'Начать фокус',
                  className: 'btn-secondary',
                  handler: function () { if (draft.id) startFocusModeFromTaskId(draft.id); }
                }
              : {
                  label: 'Открыть время',
                  className: 'btn-secondary',
                  handler: function () { openTimeDialog('editor'); }
                },
            {
              label: 'К описанию',
              className: 'btn-ghost',
              handler: function () { scrollEditorFieldIntoView('editorDescriptionInput'); }
            }
          );
          return data;
        }

        if (!draft.title || !draft.has_due || !(draft.duration_minutes > 0)) {
          data.tone = 'danger';
          data.title = 'Задача ещё не готова к старту';
          data.note = 'Сначала заполни базовые поля: название, время и длительность. После этого уже имеет смысл планировать или запускать задачу в фокус.';
        }

        if (missing.indexOf('Дата и время') !== -1) {
          data.actions.push({
            label: 'Открыть время',
            className: 'btn-secondary',
            handler: function () { openTimeDialog('editor'); }
          });
        }
        if (missing.indexOf('Продукт') !== -1) {
          data.actions.push({
            label: 'К продукту',
            className: 'btn-ghost',
            handler: function () { scrollEditorFieldIntoView('editorProductInput'); }
          });
        }
        if (missing.indexOf('Контекст') !== -1) {
          data.actions.push({
            label: 'К описанию',
            className: 'btn-ghost',
            handler: function () { scrollEditorFieldIntoView('editorDescriptionInput'); }
          });
        }
        if (missing.indexOf('Проект') !== -1) {
          data.actions.push({
            label: 'К проекту',
            className: 'btn-ghost',
            handler: function () { scrollEditorFieldIntoView('editorProjectModeSelect'); }
          });
        }
        return data;
      }

      function renderEditorExecutionReadiness(sourceTask) {
        var container = byId('editorExecutionReadiness');
        if (!container) return;
        var data = buildEditorExecutionReadinessData(sourceTask);
        container.innerHTML = '';
        container.className = 'editor-execution-readiness';
        if (!(data && data.visible)) return;
        container.classList.add('visible');
        if (data.tone === 'success') container.classList.add('is-success');
        else if (data.tone === 'danger') container.classList.add('is-danger');
        else container.classList.add('is-warning');

        var head = document.createElement('div');
        head.className = 'editor-execution-readiness-head';

        var main = document.createElement('div');
        main.className = 'editor-execution-readiness-main';

        var label = document.createElement('div');
        label.className = 'editor-execution-readiness-label';
        label.textContent = data.label || 'Готовность к исполнению';
        main.appendChild(label);

        var title = document.createElement('div');
        title.className = 'editor-execution-readiness-title';
        title.textContent = data.title || '';
        main.appendChild(title);

        var note = document.createElement('div');
        note.className = 'editor-execution-readiness-note';
        note.textContent = data.note || '';
        main.appendChild(note);

        if (Array.isArray(data.meta) && data.meta.length) {
          var meta = document.createElement('div');
          meta.className = 'editor-execution-readiness-meta';
          data.meta.forEach(function (item) {
            meta.appendChild(createChip(item));
          });
          main.appendChild(meta);
        }

        if (Array.isArray(data.missing) && data.missing.length) {
          var missingMeta = document.createElement('div');
          missingMeta.className = 'editor-execution-readiness-meta';
          data.missing.forEach(function (item) {
            var chip = createChip('Нет: ' + item);
            chip.classList.add('is-warning');
            missingMeta.appendChild(chip);
          });
          main.appendChild(missingMeta);
