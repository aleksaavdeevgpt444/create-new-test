      }

      function getDefaultFocusSettings() {
        return {
          defaultMinutes: 25,
          askDurationBeforeStart: true,
          showChecklistInOverlay: true
        };
      }

      function normalizeFocusSettings(value) {
        var defaults = getDefaultFocusSettings();
        var normalized = Object.assign({}, defaults);
        if (!value || typeof value !== 'object') return normalized;
        var minutes = Number(value.defaultMinutes);
        if (minutes === 15 || minutes === 25 || minutes === 50 || minutes === 90) normalized.defaultMinutes = minutes;
        normalized.askDurationBeforeStart = value.askDurationBeforeStart !== false;
        normalized.showChecklistInOverlay = value.showChecklistInOverlay !== false;
        return normalized;
      }

      function loadStoredFocusSettings() {
        try {
          var raw = localStorage.getItem(FOCUS_SETTINGS_STORAGE_KEY);
          if (!raw) return getDefaultFocusSettings();
          return normalizeFocusSettings(JSON.parse(raw));
        } catch (error) {
          return getDefaultFocusSettings();
        }
      }

      function applyFocusSettings(settings) {
        var normalized = normalizeFocusSettings(settings || state.focusSettings || getDefaultFocusSettings());
        state.focusSettings = normalized;
        try { localStorage.setItem(FOCUS_SETTINGS_STORAGE_KEY, JSON.stringify(normalized)); } catch (error) {}
        if (byId('focusDefaultMinutesSelect')) byId('focusDefaultMinutesSelect').value = String(normalized.defaultMinutes);
        if (byId('focusAskDurationInput')) byId('focusAskDurationInput').checked = !!normalized.askDurationBeforeStart;
        if (byId('focusChecklistInput')) byId('focusChecklistInput').checked = !!normalized.showChecklistInOverlay;
        if (state.focusSession) renderFocusSession();
      }

      function getDefaultFocusProtectionSettings() {
        return {
          enabled: true,
          weeklyTargetMinutes: 300,
          autoProtectOnFocusStart: true,
          requireConfirmBeforeMove: true,
          showWeekBadge: true
        };
      }

      function normalizeFocusProtectionSettings(value) {
        var defaults = getDefaultFocusProtectionSettings();
        var normalized = Object.assign({}, defaults);
        if (!value || typeof value !== 'object') return normalized;
        normalized.enabled = value.enabled !== false;
        var target = Number(value.weeklyTargetMinutes);
        if ([120, 180, 240, 300, 360, 480, 600].indexOf(target) >= 0) normalized.weeklyTargetMinutes = target;
        normalized.autoProtectOnFocusStart = value.autoProtectOnFocusStart !== false;
        normalized.requireConfirmBeforeMove = value.requireConfirmBeforeMove !== false;
        normalized.showWeekBadge = value.showWeekBadge !== false;
        return normalized;
      }

      function loadStoredFocusProtectionSettings() {
        try {
          var raw = localStorage.getItem(FOCUS_PROTECTION_SETTINGS_STORAGE_KEY);
          if (!raw) return getDefaultFocusProtectionSettings();
          return normalizeFocusProtectionSettings(JSON.parse(raw));
        } catch (error) {
          return getDefaultFocusProtectionSettings();
        }
      }

      function normalizeProtectedFocusTaskIds(value) {
        var map = Object.create(null);
        if (!value) return map;
        if (Array.isArray(value)) {
          value.forEach(function (id) {
            var key = String(id || '').trim();
            if (key) map[key] = 1;
          });
          return map;
        }
        if (typeof value === 'object') {
          Object.keys(value).forEach(function (id) {
            var key = String(id || '').trim();
            if (key && value[id]) map[key] = 1;
          });
        }
        return map;
      }

      function loadStoredProtectedFocusTaskIds() {
        try {
          var raw = localStorage.getItem(PROTECTED_FOCUS_TASKS_STORAGE_KEY);
          if (!raw) return Object.create(null);
          return normalizeProtectedFocusTaskIds(JSON.parse(raw));
        } catch (error) {
          return Object.create(null);
        }
      }

      function persistProtectedFocusTaskIds() {
        try {
          localStorage.setItem(PROTECTED_FOCUS_TASKS_STORAGE_KEY, JSON.stringify(Object.keys(state.protectedFocusTaskIds || Object.create(null))));
        } catch (error) {}
      }

      function isTaskFocusProtected(taskOrId) {
        var key = typeof taskOrId === 'object' && taskOrId ? String(taskOrId.id || '').trim() : String(taskOrId || '').trim();
        if (!key) return false;
        var settings = state.focusProtectionSettings || getDefaultFocusProtectionSettings();
        if (!settings.enabled) return false;
        return !!(state.protectedFocusTaskIds && state.protectedFocusTaskIds[key]);
      }

      function setTaskFocusProtected(taskId, isProtected) {
        var key = String(taskId || '').trim();
        if (!key) return;
        if (!state.protectedFocusTaskIds) state.protectedFocusTaskIds = Object.create(null);
        if (isProtected) state.protectedFocusTaskIds[key] = 1;
        else delete state.protectedFocusTaskIds[key];
        persistProtectedFocusTaskIds();
      }

      function toggleTaskFocusProtection(taskId, options) {
        var task = findTaskById(taskId);
        if (!(task && task.id)) {
          showError('Не удалось найти задачу для защиты слота.');
          return;
        }
        if (!task.due_at) {
          showError('Защитить можно только задачу, которая уже стоит в календаре.');
          return;
        }
        var nextValue = !isTaskFocusProtected(task.id);
        setTaskFocusProtected(task.id, nextValue);
        if (!(options && options.silent)) showSuccess(nextValue ? 'Фокус-слот защищён.' : 'Защита фокус-слота снята.');
        if (state.currentView === 'today') rerenderTodayOs(state.dayYmd || formatYmdLocal(new Date()));
        if (state.currentView === 'planner' && state.planner) {
          renderWeekInlineMetrics();
          renderScheduledEvents(getScheduledTasksForCurrentPeriod());
        }
        if (state.focusSession) renderFocusSession();
      }

      function getProtectedFocusTasksForWeek(startYmd) {
        var weekStart = startYmd || state.weekStart || getCurrentWeekStartYmd();
        return getCurrentWeekTasks().filter(function (task) {
          return !!(task && task.id && task.due_at && isTaskFocusProtected(task.id));
        });
      }

      function getProtectedFocusProgress(startYmd) {
        var settings = state.focusProtectionSettings || getDefaultFocusProtectionSettings();
        var tasks = getProtectedFocusTasksForWeek(startYmd);
        var protectedMinutes = tasks.reduce(function (sum, task) {
          return sum + Math.max(Number(getEffectivePlannedMinutesClient(task)) || Number(getTaskDurationMinutes(task)) || 0, 0);
        }, 0);
        var targetMinutes = Math.max(0, Number(settings.weeklyTargetMinutes) || 0);
        return {
          tasks: tasks,
          protectedMinutes: protectedMinutes,
          targetMinutes: targetMinutes,
          progressPercent: targetMinutes > 0 ? Math.min(100, Math.round((protectedMinutes / targetMinutes) * 100)) : 0
        };
      }

      function applyFocusProtectionSettings(settings) {
        var normalized = normalizeFocusProtectionSettings(settings || state.focusProtectionSettings || getDefaultFocusProtectionSettings());
        state.focusProtectionSettings = normalized;
        try { localStorage.setItem(FOCUS_PROTECTION_SETTINGS_STORAGE_KEY, JSON.stringify(normalized)); } catch (error) {}
        if (byId('focusProtectionEnabledInput')) byId('focusProtectionEnabledInput').checked = !!normalized.enabled;
        if (byId('focusProtectionWeeklyTargetSelect')) byId('focusProtectionWeeklyTargetSelect').value = String(normalized.weeklyTargetMinutes);
        if (byId('focusProtectionAutoProtectInput')) byId('focusProtectionAutoProtectInput').checked = !!normalized.autoProtectOnFocusStart;
        if (byId('focusProtectionConfirmMoveInput')) byId('focusProtectionConfirmMoveInput').checked = !!normalized.requireConfirmBeforeMove;
        if (byId('focusProtectionWeekBadgeInput')) byId('focusProtectionWeekBadgeInput').checked = !!normalized.showWeekBadge;
        if (state.currentView === 'today') rerenderTodayOs(state.dayYmd || formatYmdLocal(new Date()));
        if (state.currentView === 'planner' && state.planner) {
          renderWeekInlineMetrics();
          renderScheduledEvents(getScheduledTasksForCurrentPeriod());
        }
        if (state.focusSession) renderFocusSession();
      }


      function getDefaultRiskSettings() {
        return {
          enabled: true,
          autoStalledDays: 5,
          showWeekBadges: true,
          showTodayQueue: true,
          showPlanSection: true
        };
      }

      function normalizeRiskSettings(value) {
        var defaults = getDefaultRiskSettings();
        var normalized = Object.assign({}, defaults);
        if (!value || typeof value !== 'object') return normalized;
        normalized.enabled = value.enabled !== false;
        var autoDays = Number(value.autoStalledDays);
        if ([0, 3, 5, 7, 14].indexOf(autoDays) >= 0) normalized.autoStalledDays = autoDays;
        normalized.showWeekBadges = value.showWeekBadges !== false;
        normalized.showTodayQueue = value.showTodayQueue !== false;
        normalized.showPlanSection = value.showPlanSection !== false;
        return normalized;
      }

      function loadStoredRiskSettings() {
        try {
          var raw = localStorage.getItem(RISK_SETTINGS_STORAGE_KEY);
          if (!raw) return getDefaultRiskSettings();
          return normalizeRiskSettings(JSON.parse(raw));
        } catch (error) {
          return getDefaultRiskSettings();
        }
      }

      function getTaskRiskMapStorageKey() {
        if (!state.userId) return null;
        return TASK_RISK_MAP_STORAGE_PREFIX + String(state.userId);
      }

      function normalizeDeadlineRiskState(value) {
        var raw = String(value || '').trim().toLowerCase();
        if (raw === 'watch' || raw === 'at-risk' || raw === 'critical') return raw;
        return 'normal';
      }

      function normalizeRiskLevel(value) {
        var raw = String(value || '').trim().toLowerCase();
        if (raw === 'low' || raw === 'medium' || raw === 'high') return raw;
        return 'none';
      }

      function normalizeTaskRiskEntry(value) {
        var normalized = {
          riskLevel: 'none',
          blockedByTaskId: '',
          stalledSince: '',
          deadlineRiskState: 'normal',
          updatedAt: null
        };
        if (!value || typeof value !== 'object') return normalized;
        normalized.riskLevel = normalizeRiskLevel(value.riskLevel);
        normalized.blockedByTaskId = String(value.blockedByTaskId || '').trim();
        normalized.stalledSince = /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(String(value.stalledSince || '')) ? String(value.stalledSince) : '';
        normalized.deadlineRiskState = normalizeDeadlineRiskState(value.deadlineRiskState);
        normalized.updatedAt = value.updatedAt || null;
        return normalized;
      }

      function normalizeTaskRiskMap(value) {
        var map = Object.create(null);
        if (!value || typeof value !== 'object') return map;
        Object.keys(value).forEach(function (key) {
          var taskId = String(key || '').trim();
          if (!taskId) return;
          map[taskId] = normalizeTaskRiskEntry(value[key]);
        });
        return map;
      }

      function loadStoredTaskRiskMap() {
        try {
          var key = getTaskRiskMapStorageKey();
          if (!key) return Object.create(null);
          var raw = localStorage.getItem(key);
          if (!raw) return Object.create(null);
          return normalizeTaskRiskMap(JSON.parse(raw));
        } catch (error) {
          return Object.create(null);
        }
      }

      function saveStoredTaskRiskMap() {
        try {
          var key = getTaskRiskMapStorageKey();
          if (!key) return;
          localStorage.setItem(key, JSON.stringify(state.taskRiskMap || {}));
        } catch (error) {}
      }

      function getTaskRiskEntry(taskOrId) {
        var key = typeof taskOrId === 'object' && taskOrId ? String(taskOrId.id || '').trim() : String(taskOrId || '').trim();
        if (!key) return normalizeTaskRiskEntry(null);
        if (!state.taskRiskMap) state.taskRiskMap = Object.create(null);
        return normalizeTaskRiskEntry(state.taskRiskMap[key]);
      }

      function setTaskRiskEntry(taskId, payload) {
        var key = String(taskId || '').trim();
        if (!key) return;
        if (!state.taskRiskMap) state.taskRiskMap = Object.create(null);
        state.taskRiskMap[key] = normalizeTaskRiskEntry(payload);
        saveStoredTaskRiskMap();
      }

      function clearTaskRiskEntry(taskId) {
        var key = String(taskId || '').trim();
        if (!key || !state.taskRiskMap) return;
        delete state.taskRiskMap[key];
        saveStoredTaskRiskMap();
      }

      function getRiskLevelRank(level) {
        var normalized = normalizeRiskLevel(level);
        if (normalized === 'high') return 3;
        if (normalized === 'medium') return 2;
        if (normalized === 'low') return 1;
        return 0;
      }

      function getRiskLevelLabel(level) {
        var normalized = normalizeRiskLevel(level);
        if (normalized === 'high') return 'высокий';
        if (normalized === 'medium') return 'средний';
        if (normalized === 'low') return 'низкий';
        return 'нет';
      }

      function getDeadlineRiskLabel(stateValue) {
        var normalized = normalizeDeadlineRiskState(stateValue);
        if (normalized === 'critical') return 'критичный';
        if (normalized === 'at-risk') return 'может не успеть';
        if (normalized === 'watch') return 'под наблюдением';
        return 'нормально';
      }

      function getRiskToneByScore(score) {
        if (score >= 4) return 'high';
        if (score >= 2) return 'warn';
        return 'info';
      }

      function createRiskChip(text, tone) {
        var chip = createChip(text);
        chip.classList.add('risk-chip');
        chip.classList.add('risk-' + (tone || 'info'));
        return chip;
      }

      function getTaskRiskMeta(task) {
        var entry = getTaskRiskEntry(task);
        var settings = state.riskSettings || getDefaultRiskSettings();
        var status = normalizeStatus(task && task.status);
        var isActive = !!(task && task.id && status !== STATUS.DONE && status !== STATUS.CANCELED);
        var blockedByTaskId = String(entry.blockedByTaskId || '').trim();
        var blockerTask = blockedByTaskId ? findTaskById(blockedByTaskId) : null;
        var blockerTitle = blockerTask && blockerTask.id ? (blockerTask.title || ('#' + blockerTask.id)) : (blockedByTaskId ? ('#' + blockedByTaskId) : '');
        var autoStalledSince = '';
        if (settings.enabled && !entry.stalledSince && isActive && Number(settings.autoStalledDays) > 0) {
          var refIso = task && (task.updated_at || task.created_at) ? String(task.updated_at || task.created_at) : '';
          var refDate = refIso ? new Date(refIso) : null;
          if (refDate && !isNaN(refDate.getTime())) {
            var diffDays = Math.floor((Date.now() - refDate.getTime()) / 86400000);
            if (diffDays >= Number(settings.autoStalledDays)) autoStalledSince = formatYmdLocal(refDate);
          }
        }
        var stalledSince = entry.stalledSince || autoStalledSince || '';
        var riskLevel = entry.riskLevel || 'none';
        var deadlineRiskState = entry.deadlineRiskState || 'normal';
        var attentionScore = 0;
        if (blockedByTaskId) attentionScore = Math.max(attentionScore, 4);
        if (deadlineRiskState === 'critical') attentionScore = Math.max(attentionScore, 4);
        if (deadlineRiskState === 'at-risk') attentionScore = Math.max(attentionScore, 3);
        if (deadlineRiskState === 'watch') attentionScore = Math.max(attentionScore, 2);
        if (stalledSince) attentionScore = Math.max(attentionScore, 2);
        attentionScore = Math.max(attentionScore, getRiskLevelRank(riskLevel));
        return {
          entry: entry,
          blockedByTaskId: blockedByTaskId,
          blockerTitle: blockerTitle,
          isBlocked: !!blockedByTaskId,
          stalledSince: stalledSince,
          isStalled: !!stalledSince,
          riskLevel: riskLevel,
          deadlineRiskState: deadlineRiskState,
          attentionScore: attentionScore,
          tone: getRiskToneByScore(attentionScore),
          isAttentionNeeded: settings.enabled && attentionScore > 0
        };
      }

      function getTaskRiskMetaNodes(task) {
        var info = getTaskRiskMeta(task);
        var chips = [];
        if (!(state.riskSettings || getDefaultRiskSettings()).enabled) return chips;
        if (info.isBlocked) chips.push(createRiskChip('Блокер' + (info.blockerTitle ? ': ' + info.blockerTitle : ''), 'high'));
        if (info.deadlineRiskState !== 'normal') chips.push(createRiskChip('Дедлайн: ' + getDeadlineRiskLabel(info.deadlineRiskState), info.deadlineRiskState === 'watch' ? 'warn' : 'high'));
        if (info.isStalled) chips.push(createRiskChip('Стоит' + (info.stalledSince ? ' с ' + formatDateShortDisplay(info.stalledSince) : ''), 'warn'));
        if (info.riskLevel !== 'none') chips.push(createRiskChip('Риск: ' + getRiskLevelLabel(info.riskLevel), info.riskLevel === 'low' ? 'info' : info.riskLevel === 'medium' ? 'warn' : 'high'));
        return chips;
      }

      function isTaskAttentionNeeded(task) {
        return !!getTaskRiskMeta(task).isAttentionNeeded;
      }

      function getAttentionTasks(tasks) {
        var seen = Object.create(null);
        return (tasks || []).filter(function (task) {
          if (!(task && task.id) || seen[task.id]) return false;
          seen[task.id] = true;
          return isTaskAttentionNeeded(task);
        }).sort(function (a, b) {
          var aScore = getTaskRiskMeta(a).attentionScore;
          var bScore = getTaskRiskMeta(b).attentionScore;
          if (aScore !== bScore) return bScore - aScore;
          return compareTasksByPriorityThenDue(a, b);
        });
      }

      function getRiskTaskReasonLines(task) {
        var info = getTaskRiskMeta(task);
        var lines = [];
        if (info.isBlocked) lines.push('Блокируется задачей' + (info.blockerTitle ? ': ' + info.blockerTitle : '.'));
        if (info.deadlineRiskState !== 'normal') lines.push('Дедлайн: ' + getDeadlineRiskLabel(info.deadlineRiskState) + '.');
        if (info.isStalled) lines.push('Стоит без движения' + (info.stalledSince ? ' с ' + formatDateShortDisplay(info.stalledSince) : '') + '.');
        if (info.riskLevel !== 'none') lines.push('Уровень риска: ' + getRiskLevelLabel(info.riskLevel) + '.');
        if (!lines.length) lines.push('Явных блокеров и рисков по задаче сейчас нет.');
        return lines;
      }

      function getRiskDigestData(tasks) {
        var attentionTasks = getAttentionTasks(tasks || []);
        var blockedCount = 0;
        var stalledCount = 0;
        var deadlineCount = 0;
        var highCount = 0;
        attentionTasks.forEach(function (task) {
          var info = getTaskRiskMeta(task);
          if (info.isBlocked) blockedCount += 1;
          if (info.isStalled) stalledCount += 1;
          if (info.deadlineRiskState !== 'normal') deadlineCount += 1;
          if (info.riskLevel === 'high' || info.deadlineRiskState === 'critical' || info.isBlocked) highCount += 1;
        });
        return {
          tasks: attentionTasks,
          attentionCount: attentionTasks.length,
          blockedCount: blockedCount,
          stalledCount: stalledCount,
          deadlineCount: deadlineCount,
          highCount: highCount,
          topTasks: attentionTasks.slice(0, 4),
          leadTask: attentionTasks.length ? attentionTasks[0] : null
        };
      }

      function createRiskDigestStat(value, label, tone) {
        var item = document.createElement('div');
        item.className = 'risk-digest-stat';
        if (tone) item.classList.add('is-' + tone);
        var strong = document.createElement('strong');
        strong.textContent = String(value || 0);
        var span = document.createElement('span');
        span.textContent = label;
        item.appendChild(strong);
        item.appendChild(span);
        return item;
      }

      function createRiskDigestTaskCard(task, options) {
        options = options || {};
        var info = getTaskRiskMeta(task);
        var card = document.createElement('div');
        card.className = 'risk-digest-task-card';
        if (info.tone === 'high') card.classList.add('is-danger');
        else if (info.tone === 'warn') card.classList.add('is-warn');

        var title = document.createElement('div');
        title.className = 'risk-digest-task-title';
        title.textContent = task.title || 'Без названия';
        card.appendChild(title);

        var meta = document.createElement('div');
        meta.className = 'editor-linked-card-meta';
        meta.appendChild(createChip(normalizeProjectName(task.project_name)));
        meta.appendChild(createStatusPill(normalizeStatus(task.status), getStatusSingular(normalizeStatus(task.status))));
        if (task.due_at) meta.appendChild(createChip(formatTimeRange(task.due_at, getTaskDurationMinutes(task), { withDate: true })));
        getTaskRiskMetaNodes(task).forEach(function (node) { meta.appendChild(node); });
        card.appendChild(meta);

        var note = document.createElement('div');
        note.className = 'risk-digest-task-note';
        note.textContent = getRiskTaskReasonLines(task).join(' · ');
        card.appendChild(note);

        var actions = document.createElement('div');
        actions.className = 'risk-digest-task-actions';

        var openBtn = document.createElement('button');
        openBtn.type = 'button';
        openBtn.className = 'btn-ghost';
        openBtn.textContent = 'Открыть';
        openBtn.addEventListener('click', function () { openEditor(task.id); });
