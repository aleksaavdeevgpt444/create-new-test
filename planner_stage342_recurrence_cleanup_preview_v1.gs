        if (!stack) return null;
        host = document.createElement('div');
        host.id = 'plannerCapacityHost';
        host.className = 'planner-capacity-host';
        stack.insertBefore(host, stack.firstChild);
        return host;
      }

      function renderPlannerCapacityPanel() {
        var host = ensurePlannerCapacityHost();
        if (!host) return;
        host.innerHTML = '';
        host.appendChild(createCapacityManagementPanel(getCapacityManagementWeekData(state.weekStart || getCurrentWeekStartYmd()), {
          title: 'Capacity · Неделя',
          showWeekAction: false
        }));
      }

      function applyCapacitySettings(settings) {
        var normalized = normalizeCapacitySettings(settings || state.capacitySettings || getDefaultCapacitySettings());
        state.capacitySettings = normalized;
        try { localStorage.setItem(CAPACITY_SETTINGS_STORAGE_KEY, JSON.stringify(normalized)); } catch (error) {}
        if (byId('capacityModeSelect')) byId('capacityModeSelect').value = normalized.mode;
        if (byId('capacityManualMinutesSelect')) byId('capacityManualMinutesSelect').value = String(normalized.manualDailyCapacityMinutes);
        if (byId('capacityReserveMinutesSelect')) byId('capacityReserveMinutesSelect').value = String(normalized.reserveMinutes);
        if (byId('capacityWarnPercentSelect')) byId('capacityWarnPercentSelect').value = String(normalized.overloadWarnPercent);
        if (byId('capacityShowOverflowInput')) byId('capacityShowOverflowInput').checked = !!normalized.showOverflowQueue;
        renderWeekInlineMetrics();
        if (state.currentView === 'today') renderTodayView();
        else if (state.currentView === 'plan') renderPlanView();
