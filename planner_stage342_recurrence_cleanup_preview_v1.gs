        if (String(settings && settings.scope || 'all') === 'project') {
          var projectName = String(settings && settings.projectName || '').trim().toLowerCase();
          if (!projectName) return false;
          return String(task.project_name || '').trim().toLowerCase() === projectName;
        }
        if (String(settings && settings.scope || 'all') === 'types') {
          var taskTypes = getTelegramTaskNotificationTypeKeys(task, state.dayYmd || formatYmdLocal(new Date()));
          return taskTypes.some(function (key) { return (settings.types || []).indexOf(key) >= 0; });
        }
        return true;
