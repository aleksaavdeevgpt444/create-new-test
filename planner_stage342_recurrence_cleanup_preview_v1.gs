      function populateEditorBadges(task) {
        var container = byId('editorBadges');
        container.innerHTML = '';
        container.appendChild(createStatusPill(normalizeStatus(task.status), getStatusSingular(normalizeStatus(task.status))));
        var effectivePriority = getEffectivePriorityNumber(task);
        if (effectivePriority) container.appendChild(createChip(getPriorityText(effectivePriority)));
        container.appendChild(createChip(formatDurationLabel(getTaskDurationMinutes(task))));
        container.appendChild(createChip('План: ' + formatMinutesShort(getEffectivePlannedMinutesClient(task))));
        if (normalizeMinutesInputValue(task.actual_minutes) !== null) container.appendChild(createChip('Факт: ' + formatMinutesShort(task.actual_minutes)));
        if (task && task.id && isTaskBlocked(task.id)) { var blockedChip = createChip('Есть блокер'); blockedChip.classList.add('is-blocked'); container.appendChild(blockedChip); }
        if (isOverdueTask(task)) {
          var overdue = createStatusPill(task.status, '‼ Просрочена');
          overdue.classList.add('overdue');
          container.appendChild(overdue);
        }
      }


      function autoGrowTextarea(textarea, minHeightPx) {
        if (!textarea) return;
        var minHeight = Math.max(Number(minHeightPx || 0) || 0, 0);
        textarea.style.overflowY = 'hidden';
        textarea.style.height = 'auto';
        var nextHeight = Math.max(Number(textarea.scrollHeight || 0) || 0, minHeight);
        if (nextHeight > 0) textarea.style.height = String(nextHeight) + 'px';
      }

      function syncEditorTitleInputAutoHeight() {
        var input = byId('editorTitleInput');
        if (!input) return;
        autoGrowTextarea(input, 74);
      }

      function resetEditorTitleInputAutoHeight() {
        var input = byId('editorTitleInput');
        if (!input) return;
        input.style.overflowY = 'hidden';
        input.style.height = '74px';
      }

      function syncCreateTitleInputAutoHeight() {
        var input = byId('createTitleInput');
        if (!input || String(input.tagName || '').toLowerCase() !== 'textarea') return;
        autoGrowTextarea(input, 58);
      }

      function resetCreateTitleInputAutoHeight() {
        var input = byId('createTitleInput');
        if (!input || String(input.tagName || '').toLowerCase() !== 'textarea') return;
        input.style.overflowY = 'hidden';
        input.style.height = '58px';
      }

      function syncTaskDescriptionInputAutoHeight(prefix) {
        var scope = prefix === 'editor' ? 'editor' : 'create';
        var input = byId(scope + 'DescriptionInput');
        if (!input || String(input.tagName || '').toLowerCase() !== 'textarea') return;
        autoGrowTextarea(input, scope === 'editor' ? 112 : 110);
      }

      function resetTaskDescriptionInputAutoHeight(prefix) {
        var scope = prefix === 'editor' ? 'editor' : 'create';
        var input = byId(scope + 'DescriptionInput');
        if (!input || String(input.tagName || '').toLowerCase() !== 'textarea') return;
        input.style.overflowY = 'hidden';
        input.style.height = scope === 'editor' ? '112px' : '110px';
      }

      function getEditorDrawerElement() {
        try {
          return document.querySelector('#editorBackdrop .editor-drawer');
        } catch (error) {
          return null;
        }
      }

      function getEditorDrawerResizeClientX(event) {
        if (!event) return null;
        if (event.touches && event.touches.length && Number.isFinite(Number(event.touches[0].clientX))) {
          return Number(event.touches[0].clientX);
        }
        if (event.changedTouches && event.changedTouches.length && Number.isFinite(Number(event.changedTouches[0].clientX))) {
          return Number(event.changedTouches[0].clientX);
        }
        if (Number.isFinite(Number(event.clientX))) return Number(event.clientX);
        return null;
      }

      function getEditorDrawerViewportMaxWidth() {
        try {
          return Math.max(360, Math.min(1400, Math.floor((window.innerWidth || 1024) - 18)));
        } catch (error) {
          return 1000;
        }
      }

      function normalizeEditorDrawerWidth(value) {
        var numeric = Number(value);
        if (!Number.isFinite(numeric) || numeric <= 0) numeric = 760;
        var maxWidth = getEditorDrawerViewportMaxWidth();
        var minWidth = Math.min(560, maxWidth);
        return Math.max(minWidth, Math.min(maxWidth, Math.round(numeric)));
      }

      function loadEditorDrawerWidth() {
        try {
          var stored = localStorage.getItem(EDITOR_DRAWER_WIDTH_STORAGE_KEY);
          return normalizeEditorDrawerWidth(stored || 760);
        } catch (error) {
          return normalizeEditorDrawerWidth(760);
        }
      }

      function saveEditorDrawerWidth(width) {
        try {
          localStorage.setItem(EDITOR_DRAWER_WIDTH_STORAGE_KEY, String(normalizeEditorDrawerWidth(width)));
        } catch (error) {}
      }

      function applyEditorDrawerWidth(width, options) {
        options = options || {};
        var normalized = normalizeEditorDrawerWidth(width);
        try {
          document.documentElement.style.setProperty('--editor-drawer-width', normalized + 'px');
          var drawer = getEditorDrawerElement();
          if (drawer) {
            if ((window.innerWidth || 0) <= 760) {
              drawer.style.width = '100%';
              drawer.style.maxWidth = '100%';
            } else {
              drawer.style.width = normalized + 'px';
              drawer.style.maxWidth = 'calc(100vw - 18px)';
            }
            drawer.dataset.drawerWidth = String(normalized);
            drawer.dataset.drawerSize = normalized >= 1180 ? 'max' : (normalized >= 920 ? 'wide' : (normalized >= 680 ? 'medium' : 'compact'));
            drawer.classList.toggle('editor-drawer-size-compact', drawer.dataset.drawerSize === 'compact');
            drawer.classList.toggle('editor-drawer-size-medium', drawer.dataset.drawerSize === 'medium');
            drawer.classList.toggle('editor-drawer-size-wide', drawer.dataset.drawerSize === 'wide');
            drawer.classList.toggle('editor-drawer-size-max', drawer.dataset.drawerSize === 'max');
          }
          var handle = byId('editorDrawerResizeHandle');
          if (handle) {
            handle.setAttribute('aria-valuenow', String(normalized));
            handle.setAttribute('aria-valuetext', 'Ширина карточки задачи ' + normalized + ' пикселей');
          }
          if (options.persist) saveEditorDrawerWidth(normalized);
          if (options.refresh !== false) scheduleDynamicDrawerLayoutRefresh('editor');
        } catch (error) {}
        return normalized;
      }

      function initEditorDrawerWidth() {
        applyEditorDrawerWidth(loadEditorDrawerWidth(), { persist: false, refresh: false });
      }

      function removeEditorDrawerWidthResizeListeners() {
        try { document.removeEventListener('pointermove', updateEditorDrawerWidthResize, false); } catch (error) {}
        try { document.removeEventListener('pointerup', finishEditorDrawerWidthResize, false); } catch (error) {}
        try { document.removeEventListener('pointercancel', cancelEditorDrawerWidthResize, false); } catch (error) {}
        try { document.removeEventListener('mousemove', updateEditorDrawerWidthResize, false); } catch (error) {}
        try { document.removeEventListener('mouseup', finishEditorDrawerWidthResize, false); } catch (error) {}
        try { document.removeEventListener('touchmove', updateEditorDrawerWidthResize, false); } catch (error) {}
        try { document.removeEventListener('touchend', finishEditorDrawerWidthResize, false); } catch (error) {}
        try { document.removeEventListener('touchcancel', cancelEditorDrawerWidthResize, false); } catch (error) {}
      }

      function addEditorDrawerWidthResizeListeners() {
        removeEditorDrawerWidthResizeListeners();
        document.addEventListener('pointermove', updateEditorDrawerWidthResize, { passive: false });
        document.addEventListener('pointerup', finishEditorDrawerWidthResize, { passive: false });
        document.addEventListener('pointercancel', cancelEditorDrawerWidthResize, { passive: false });
        document.addEventListener('mousemove', updateEditorDrawerWidthResize, { passive: false });
        document.addEventListener('mouseup', finishEditorDrawerWidthResize, { passive: false });
        document.addEventListener('touchmove', updateEditorDrawerWidthResize, { passive: false });
        document.addEventListener('touchend', finishEditorDrawerWidthResize, { passive: false });
        document.addEventListener('touchcancel', cancelEditorDrawerWidthResize, { passive: false });
      }

      function cancelEditorDrawerWidthResize() {
        if (!state.editorDrawerResizeState) return;
        state.editorDrawerResizeState = null;
        try { document.body.classList.remove('editor-drawer-resizing'); } catch (error) {}
        removeEditorDrawerWidthResizeListeners();
      }

      function updateEditorDrawerWidthResize(event) {
        var resizeState = state.editorDrawerResizeState;
        if (!resizeState) return;
