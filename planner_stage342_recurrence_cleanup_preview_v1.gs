          ]
        }));
        strip.appendChild(createBoardControlOverviewCard({
          value: control.plannedItems.length,
          label: 'Колонка в работе',
          note: control.plannedItems.length ? 'Плановые задачи — это основной operational поток. Здесь удобно быстро добивать хвосты.' : 'Колонка “в плане” сейчас пустая.',
          actions: [
            createBoardKanbanAction('К колонке “в плане”', function () { scrollToBoardColumn(STATUS.PLANNED); }, 'primary'),
            createBoardKanbanAction('Готово top 3', function () { getBoardPrimaryTasks(control.plannedItems, 3).forEach(function (task) { updateTaskStatus(task.id, STATUS.DONE); }); }, 'ghost')
          ]
        }));
        shell.appendChild(strip);

        var cards = document.createElement('div');
        cards.className = 'board-command-center';
        cards.appendChild(createBoardCommandCard('Снять застревание', control.blockedItems.length ? ('С блокером сейчас ' + control.blockedItems.length + '. Лучше сначала разобрать верхние узкие места, а уже потом ускорять Today.') : 'Активных блокеров в текущем срезе нет.', control.blockedItems.length ? 'warn' : '', [
          createBoardCommandAction('К блокерам', function () { setBoardControlState({ focus: 'blocked' }); }),
          createBoardCommandAction('Открыть 1-ю', function () { openFirstBoardTask(control.blockedItems); }),
          createBoardCommandAction('К Плану', function () { setActiveView('plan'); renderPlanView(); })
        ]));
        cards.appendChild(createBoardCommandCard('Разобрать backlog', control.backlogItems.length ? ('Backlog без даты: ' + control.backlogItems.length + '. Этот слой лучше чистить здесь и в Плане, чтобы не захламлять неделю.') : 'Backlog без даты сейчас чистый.', '', [
          createBoardCommandAction('К backlog', function () { setBoardControlState({ timing: 'backlog', focus: 'backlog' }); }),
          createBoardCommandAction('Открыть 1-ю', function () { openFirstBoardTask(control.backlogItems); }),
          createBoardCommandAction('Открыть План', function () { setActiveView('plan'); renderPlanView(); })
        ]));
        cards.appendChild(createBoardCommandCard('Ускорить поток', control.plannedItems.length ? ('В колонке “в плане” ' + control.plannedItems.length + ' задач. Отсюда удобно быстро вытаскивать top 3 в Today или закрывать верхние карточки.') : 'Колонка “в плане” сейчас не перегружена.', '', [
          createBoardCommandAction('К колонке', function () { scrollToBoardColumn(STATUS.PLANNED); }),
          createBoardCommandAction('В Today top 3', function () { sendBoardTasksToToday(control.plannedItems, 3); }),
          createBoardCommandAction('Готово top 3', function () { getBoardPrimaryTasks(control.plannedItems, 3).forEach(function (task) { updateTaskStatus(task.id, STATUS.DONE); }); })
        ]));
        cards.appendChild(createBoardCommandCard('Закрыть хвосты', control.overdueItems.length ? ('Просроченных задач ' + control.overdueItems.length + '. Их лучше быстро решить: в Today, на завтра или обратно в backlog.') : 'Просрочка под контролем.', control.overdueItems.length ? 'danger' : '', [
          createBoardCommandAction('К просрочке', function () { setBoardControlState({ timing: 'overdue', focus: 'attention' }); }),
          createBoardCommandAction('В Today top 3', function () { sendBoardTasksToToday(control.overdueItems, 3); }),
          createBoardCommandAction('На завтра top 3', function () { moveBoardTasksToTomorrow(control.overdueItems, 3); })
        ]));
        shell.appendChild(cards);

        host.appendChild(shell);
      }

      function getBoardFocusLabel(focusKey) {
        var focus = String(focusKey || 'all');
        if (focus === 'attention') return 'требуют внимания';
        if (focus === 'blocked') return 'с блокером';
        if (focus === 'week') return 'неделя';
        if (focus === 'backlog') return 'backlog';
        if (focus === 'done') return 'выполненные';
        return 'все задачи';
      }

      function renderBoardProjectFilterOptions(tasks) {
        var select = byId('boardProjectFilterSelect');
        if (!select) return;
        var current = normalizeBoardProjectFilterValue(state.boardProjectFilter || 'all');
        var names = [];
        (Array.isArray(tasks) ? tasks : []).forEach(function (task) {
          var name = String(task && task.project_name || '').trim();
          if (name && names.indexOf(name) === -1) names.push(name);
        });
        names.sort(function (a, b) { return a.localeCompare(b, 'ru', { sensitivity: 'base' }); });
        select.innerHTML = '';
        var allOption = document.createElement('option');
        allOption.value = 'all';
        allOption.textContent = 'Все проекты';
        select.appendChild(allOption);
        names.forEach(function (name) {
          var option = document.createElement('option');
          option.value = name;
          option.textContent = name;
          select.appendChild(option);
        });
        select.value = names.indexOf(current) >= 0 ? current : 'all';
      }

      function applyBoardViewFilters(tasks) {
        var list = Array.isArray(tasks) ? tasks.slice() : [];
        var projectFilter = normalizeBoardProjectFilterValue(state.boardProjectFilter || 'all');
        var priorityFilter = String(state.boardPriorityFilter || 'all');
        var timingFilter = String(state.boardTimingFilter || 'all');
        return list.filter(function (task) {
          if (projectFilter !== 'all' && String(task && task.project_name || '').trim() !== projectFilter) return false;
          if (priorityFilter !== 'all' && getBoardTaskPriorityKey(task) !== priorityFilter) return false;
          if (timingFilter === 'scheduled' && !(task && task.due_at)) return false;
          if (timingFilter === 'backlog' && !!(task && task.due_at)) return false;
          if (timingFilter === 'overdue' && !isTaskOverdueForWorkspace(task)) return false;
          if (timingFilter === 'today' && getTaskWeekDayYmd(task) !== getWorkspaceTodayYmd()) return false;
          return true;
        });
      }

      function getBoardCurrentTasks() {
        var base = getBoardFocusTasks(applyWorkspaceTaskFilters(getShellTasks()));
        renderBoardProjectFilterOptions(base);
        return applyBoardViewFilters(base);
      }

      function getBoardPrimaryTasks(tasks, limit) {
        return (Array.isArray(tasks) ? tasks.slice() : []).sort(compareTasksByPriorityThenDue).slice(0, Math.max(1, Number(limit) || 3));
      }

      async function sendBoardTasksToToday(tasks, limit) {
        var items = getBoardPrimaryTasks(tasks, limit);
        if (!items.length) { showSuccess('Подходящих задач для Today нет.'); return; }
        for (var i = 0; i < items.length; i += 1) {
          await scheduleTask(items[i].id, getTaskDueIsoForDay(items[i], getWorkspaceTodayYmd()), STATUS.PLANNED, getTaskDurationMinutes(items[i]));
        }
        showSuccess('Задачи отправлены в Today.');
      }

      async function moveBoardTasksToTomorrow(tasks, limit) {
        var items = getBoardPrimaryTasks(tasks, limit);
        if (!items.length) { showSuccess('Подходящих задач для переноса нет.'); return; }
        var tomorrow = addDaysYmd(getWorkspaceTodayYmd(), 1);
        for (var i = 0; i < items.length; i += 1) {
          await scheduleTask(items[i].id, getTaskDueIsoForDay(items[i], tomorrow), STATUS.PLANNED, getTaskDurationMinutes(items[i]));
        }
        showSuccess('Задачи перенесены на завтра.');
      }

      async function pushBoardBacklogToPlanned(tasks, limit) {
        var items = getBoardPrimaryTasks((Array.isArray(tasks) ? tasks : []).filter(function (task) { return !(task && task.due_at); }), limit);
        if (!items.length) { showSuccess('Backlog-задач для планирования нет.'); return; }
        for (var i = 0; i < items.length; i += 1) {
          await scheduleTask(items[i].id, getTaskDueIsoForDay(items[i], getWorkspaceTodayYmd()), STATUS.PLANNED, getTaskDurationMinutes(items[i]));
        }
        showSuccess('Backlog-задачи отправлены в план на сегодня.');
      }

      function openFirstBoardTask(tasks) {
        var first = getBoardPrimaryTasks(tasks, 1)[0];
        if (first && first.id) openEditor(first.id);
      }

      function createBoardCommandAction(label, onClick) {
        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'board-command-action';
        button.textContent = label;
        button.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          onClick();
        });
        return button;
      }

      function createBoardCommandCard(title, note, tone, actions) {
        var card = document.createElement('div');
        card.className = 'board-command-card';
        if (tone) card.classList.add('is-' + tone);
        var strong = document.createElement('strong');
        strong.textContent = title;
        var span = document.createElement('span');
        span.textContent = note;
        card.appendChild(strong);
        card.appendChild(span);
        var actionsWrap = document.createElement('div');
        actionsWrap.className = 'board-command-actions';
        (actions || []).forEach(function (item) { actionsWrap.appendChild(item); });
        card.appendChild(actionsWrap);
        return card;
      }

      function renderBoardCommandCenter(tasks) {
        var shell = byId('boardCommandCenter');
        if (!shell) return;
        shell.innerHTML = '';
        var list = Array.isArray(tasks) ? tasks : [];
        var top = getBoardPrimaryTasks(list, 3);
        var blocked = list.filter(function (task) { return !!(getTaskDependencyMeta(task).blockedByTask); });
        var backlog = list.filter(function (task) { return !(task && task.due_at); });
        var overdue = list.filter(isTaskOverdueForWorkspace);
        shell.appendChild(createBoardCommandCard('Top 3 колонок', top.length ? top.map(function (task) { return task.title; }).join(' · ') : 'Сейчас в срезе нет задач.', '', [
          createBoardCommandAction('Открыть 1-ю', function () { openFirstBoardTask(list); }),
          createBoardCommandAction('В Today top 3', function () { sendBoardTasksToToday(list, 3); }),
          createBoardCommandAction('На завтра top 3', function () { moveBoardTasksToTomorrow(list, 3); })
        ]));
        shell.appendChild(createBoardCommandCard('Блокеры', blocked.length ? 'С блокером: ' + blocked.length + '. Открой и разбери верхние узкие места.' : 'Активных блокеров в текущем срезе нет.', blocked.length ? 'warn' : '', [
          createBoardCommandAction('Открыть 1-ю', function () { openFirstBoardTask(blocked); }),
          createBoardCommandAction('В Today top 3', function () { sendBoardTasksToToday(blocked, 3); })
        ]));
        shell.appendChild(createBoardCommandCard('Backlog без даты', backlog.length ? 'Без даты: ' + backlog.length + '. Подходит для быстрой раскладки в день.' : 'Backlog без даты пуст.', '', [
          createBoardCommandAction('Открыть 1-ю', function () { openFirstBoardTask(backlog); }),
          createBoardCommandAction('В план top 3', function () { pushBoardBacklogToPlanned(backlog, 3); })
        ]));
        shell.appendChild(createBoardCommandCard('Просрочка', overdue.length ? 'Просрочено: ' + overdue.length + '. Стоит вытянуть верхние задачи в Today или быстро перенести.' : 'Просроченных задач в срезе нет.', overdue.length ? 'danger' : '', [
          createBoardCommandAction('Открыть 1-ю', function () { openFirstBoardTask(overdue); }),
          createBoardCommandAction('В Today top 3', function () { sendBoardTasksToToday(overdue, 3); }),
          createBoardCommandAction('На завтра top 3', function () { moveBoardTasksToTomorrow(overdue, 3); })
        ]));
      }

      function createBoardTaskCard(task) {
        var card = createShellTaskCard(task);
        card.classList.add('board-task-card');
        var badges = document.createElement('div');
        badges.className = 'board-task-badges';
        var projectBadge = document.createElement('div');
        projectBadge.className = 'board-badge';
        projectBadge.textContent = String(task && task.project_name || 'Без проекта');
        badges.appendChild(projectBadge);
        var priorityBadge = document.createElement('div');
        priorityBadge.className = 'board-badge';
        var priorityKey = getBoardTaskPriorityKey(task);
        if (priorityKey === 'high') priorityBadge.classList.add('is-danger');
        else if (priorityKey === 'medium') priorityBadge.classList.add('is-warn');
        else if (priorityKey === 'low') priorityBadge.classList.add('is-focus');
        priorityBadge.textContent = getBoardTaskPriorityLabel(task);
        badges.appendChild(priorityBadge);
        if (isTaskOverdueForWorkspace(task)) {
          var overdueBadge = document.createElement('div');
          overdueBadge.className = 'board-badge is-danger';
          overdueBadge.textContent = 'Просрочено';
          badges.appendChild(overdueBadge);
        }
        if (getTaskDependencyMeta(task).blockedByTask) {
          var blockedBadge = document.createElement('div');
          blockedBadge.className = 'board-badge is-warn';
          blockedBadge.textContent = 'Есть блокер';
          badges.appendChild(blockedBadge);
        }
        var status = normalizeStatus(task && task.status) || STATUS.NEW;
        if (!task || !task.due_at) {
          var backlogBadge = document.createElement('div');
          backlogBadge.className = 'board-badge';
          backlogBadge.textContent = 'Backlog';
          badges.appendChild(backlogBadge);
        } else if (formatYmdLocal(new Date(task.due_at)) === (state.dayYmd || formatYmdLocal(new Date()))) {
          var todayBadge = document.createElement('div');
          todayBadge.className = 'board-badge is-focus';
          todayBadge.textContent = 'Сегодня';
          badges.appendChild(todayBadge);
        }
        card.appendChild(badges);
        var productText = String(task && (task.task_product || task.description) || '').trim();
        if (productText) {
          var product = document.createElement('div');
          product.className = 'board-task-product';
          product.textContent = productText.length > 160 ? (productText.slice(0, 157) + '…') : productText;
          card.appendChild(product);
        }
        var miniMeta = document.createElement('div');
        miniMeta.className = 'board-task-mini-meta';
        var plannedMinutes = getTaskPlannedMinutesValue(task);
        if (plannedMinutes > 0) {
          var plannedChip = document.createElement('div');
          plannedChip.className = 'board-badge';
          plannedChip.textContent = 'План: ' + formatMinutesHoursLabel(plannedMinutes);
          miniMeta.appendChild(plannedChip);
        }
        if (task && task.actual_minutes) {
          var actualChip = document.createElement('div');
          actualChip.className = 'board-badge';
          actualChip.textContent = 'Факт: ' + formatMinutesHoursLabel(Math.max(Number(task.actual_minutes) || 0, 0));
          miniMeta.appendChild(actualChip);
        }
        if (task && task.space_key) {
          var spaceChip = document.createElement('div');
          spaceChip.className = 'board-badge';
          spaceChip.textContent = 'Пространство: ' + (String(task.space_key) === 'personal' ? 'Личное' : 'Рабочее');
          miniMeta.appendChild(spaceChip);
        }
        if (miniMeta.children.length) card.appendChild(miniMeta);
        var footer = document.createElement('div');
        footer.className = 'board-task-footer';
        var note = document.createElement('div');
        note.className = 'board-column-note';
        var dueText = task && task.due_at ? formatTimeRange(task.due_at, getTaskDurationMinutes(task), { withDate: true }) : 'Без даты';
        var plannedText = formatMinutesHoursLabel(plannedMinutes);
        note.textContent = dueText + ' · ' + plannedText;
        footer.appendChild(note);
        var actions = document.createElement('div');
        actions.className = 'board-task-actions';
        actions.appendChild(createBoardTaskAction('Открыть', function () { openEditor(task.id); }));
        actions.appendChild(createBoardTaskAction('К Today', function () { sendBoardTasksToToday([task], 1); }));
        actions.appendChild(createBoardTaskAction('На завтра', function () { moveBoardTasksToTomorrow([task], 1); }));
        actions.appendChild(createBoardTaskAction('К проекту', function () { setBoardControlState({ projectFilter: normalizeProjectName(task && task.project_name || '') || 'all' }); }));
        if (status !== STATUS.PLANNED) {
          actions.appendChild(createBoardTaskAction('В план', function () { updateTaskStatus(task.id, STATUS.PLANNED); }));
        } else {
          actions.appendChild(createBoardTaskAction('Готово', function () { updateTaskStatus(task.id, STATUS.DONE); }, 'success'));
        }
        if (status === STATUS.DONE || status === STATUS.CANCELED) {
          actions.appendChild(createBoardTaskAction('Во входящие', function () { updateTaskStatus(task.id, STATUS.NEW); }));
        }
        footer.appendChild(actions);
        card.appendChild(footer);
        return card;
      }


      function getBoardFocusOptions() {
        return ['all', 'attention', 'blocked', 'week', 'backlog', 'done'];
      }

      function getBoardFocusTasks(tasks) {
        var focus = getBoardFocusOptions().indexOf(state.boardFocus) >= 0 ? state.boardFocus : 'all';
        var list = Array.isArray(tasks) ? tasks.slice() : [];
        if (focus === 'attention') return getAttentionTasks(list);
        if (focus === 'blocked') return list.filter(function (task) { return !!(getTaskDependencyMeta(task).blockedByTask); });
        if (focus === 'week') return list.filter(function (task) {
          var ymd = getTaskWeekDayYmd(task);
          return !!ymd && isTaskInWeekRange(ymd, state.weekStart || getCurrentWeekStartYmd());
        });
        if (focus === 'backlog') return list.filter(function (task) {
          var status = normalizeStatus(task && task.status) || STATUS.NEW;
          return status === STATUS.NEW || status === STATUS.POSTPONED;
        });
        if (focus === 'done') return list.filter(function (task) { return (normalizeStatus(task && task.status) || STATUS.NEW) === STATUS.DONE; });
        return list;
      }

      function getBoardSortLabel(sortKey) {
        if (sortKey === 'priority') return 'приоритет';
        if (sortKey === 'updated') return 'обновление';
        if (sortKey === 'project') return 'проект';
        return 'время';
      }

      function getBoardComparator(sortKey) {
        if (sortKey === 'priority') return compareTasksByPriorityThenDue;
        if (sortKey === 'updated') {
          return function (a, b) {
            var aUpdated = a && a.updated_at ? new Date(a.updated_at).getTime() : 0;
            var bUpdated = b && b.updated_at ? new Date(b.updated_at).getTime() : 0;
            if (aUpdated !== bUpdated) return bUpdated - aUpdated;
            return compareTasksByDueAndUpdated(a, b);
          };
        }
        if (sortKey === 'project') {
          return function (a, b) {
            var aProject = normalizeProjectName(a && a.project_name || '');
            var bProject = normalizeProjectName(b && b.project_name || '');
            var cmp = aProject.localeCompare(bProject, 'ru', { sensitivity: 'base' });
            if (cmp !== 0) return cmp;
            return compareTasksByDueAndUpdated(a, b);
          };
        }
        return compareTasksByDueAndUpdated;
      }

