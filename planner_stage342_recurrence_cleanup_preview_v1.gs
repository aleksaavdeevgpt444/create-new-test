      function formatSprintRangeLabel(startYmd, endYmd) {
        var startDate = new Date(startYmd + 'T00:00:00');
        var endDate = new Date(endYmd + 'T00:00:00');
        return formatWithPlannerTimeZone(startDate, { day: 'numeric', month: 'long' }, '—') + ' → ' + formatWithPlannerTimeZone(endDate, { day: 'numeric', month: 'long' }, '—');
      }

      function shiftYmd(ymd, daysDelta) {
        var date = new Date(String(ymd || '') + 'T00:00:00');
        if (Number.isNaN(date.getTime())) return formatYmdLocal(new Date());
        date.setDate(date.getDate() + Number(daysDelta || 0));
        return formatYmdLocal(date);
      }

      function getSprintWindow(anchorYmd, startDow) {
        var date = new Date(String(anchorYmd || formatYmdLocal(new Date())) + 'T00:00:00');
        if (Number.isNaN(date.getTime())) date = new Date();
        var safeDow = Math.max(0, Math.min(6, Number(startDow) || 1));
        while (date.getDay() !== safeDow) date.setDate(date.getDate() - 1);
        var startYmd = formatYmdLocal(date);
        var endYmd = shiftYmd(startYmd, 6);
        return { startYmd: startYmd, endYmd: endYmd };
      }

      function isTaskWithinYmdRange(task, startYmd, endYmd) {
        if (!(task && task.due_at)) return false;
        var ymd = formatYmdLocal(new Date(task.due_at));
        return ymd >= startYmd && ymd <= endYmd;
      }

