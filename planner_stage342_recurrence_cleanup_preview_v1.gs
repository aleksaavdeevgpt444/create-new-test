    .view-nav.is-current-support .view-nav-group-support,
    .view-nav.is-current-utility .view-nav-group-utility {
      border-color: rgba(111,167,255,.18);
      box-shadow: 0 12px 24px rgba(7,12,23,.10);
    }

    .week-nav-shell {
      top: 10px;
    }
    .week-nav {
      grid-template-columns: minmax(252px, .84fr) minmax(360px, 1.08fr) auto;
      gap: 12px;
      padding: 12px 14px;
      border-radius: 20px;
      align-items: stretch;
    }
    .week-nav-controls {
      display: grid;
      gap: 8px;
      align-content: start;
      padding: 8px;
      border-radius: 16px;
      border: 1px solid color-mix(in srgb, var(--border-color) 84%, var(--accent-color) 16%);
      background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
    }
    .week-period-panel {
      display: grid;
      gap: 8px;
      align-content: start;
      padding: 12px 14px;
      border-radius: 16px;
      border: 1px solid color-mix(in srgb, var(--border-color) 82%, var(--accent-color) 18%);
      background: linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.05));
      box-shadow: 0 14px 28px rgba(16, 24, 40, .10);
    }
    .week-period-eyebrow {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--text-soft, var(--text-muted));
    }
    .week-center-stack {
      gap: 8px;
    }
    .week-title {
      font-size: 20px;
      line-height: 1.06;
      letter-spacing: -0.02em;
    }
    .week-subtitle {
      font-size: 11px;
      line-height: 1.42;
      max-width: 680px;
    }
    .period-toggle {
      gap: 6px;
      padding: 6px;
      width: max-content;
      max-width: 100%;
      border-radius: 14px;
      border: 1px solid color-mix(in srgb, var(--border-color) 84%, var(--accent-color) 16%);
      background: rgba(255,255,255,.06);
    }
    .period-toggle .btn-secondary,
    .period-toggle .btn-ghost {
      min-height: 36px;
      padding: 8px 12px;
      font-size: 12px;
      border-radius: 12px;
    }
    .period-toggle .is-active {
      box-shadow: 0 10px 18px rgba(72,141,255,.16);
    }
    .week-inline-metrics {
      justify-content: flex-end;
      align-content: start;
      gap: 8px;
      min-width: 220px;
    }

    @media (max-width: 1120px) {
      .topbar,
      .view-nav,
      .week-nav {
        grid-template-columns: 1fr;
      }
      .view-nav-group-primary {
        grid-column: auto;
      }
      .week-inline-metrics {
        justify-content: flex-start;
        min-width: 0;
      }
    }
    @media (max-width: 720px) {
      .toolbar {
        padding: 8px;
      }
      .toolbar-primary-block,
      .toolbar-secondary-block,
      .week-nav-controls,
      .week-period-panel {
        padding: 10px;
      }
      .toolbar-secondary-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
      .toolbar #reloadTopBtn,
      .toolbar #openSettingsBtn {
        min-width: 0;
        width: 100%;
      }
      .period-toggle {
        width: 100%;
      }
      .period-toggle .btn-secondary,
