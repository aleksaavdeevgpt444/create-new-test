          : 'Собери день: выбери состояние, 1–3 главные задачи и зафиксируй вход в работу.';
        headMain.appendChild(title);
        headMain.appendChild(subtitle);

        var meta = document.createElement('div');
        meta.className = 'today-ritual-meta';
        meta.appendChild(createChip(modeMeta.label));
        meta.appendChild(createChip(ritual.reviewCompletedAt ? 'День закрыт' : (ritual.startedAt ? 'Старт дня зафиксирован' : 'Ритуал не начат')));
        if (ritual.planSentAt) meta.appendChild(createChip('План отправлен'));
        if (ritual.focusStartedAt) meta.appendChild(createChip('Фокус запущен'));
        if (ritual.factSentAt) meta.appendChild(createChip('Факт отправлен'));

        head.appendChild(headMain);
        head.appendChild(meta);

        var summaryGrid = document.createElement('div');
        summaryGrid.className = 'ritual-summary-grid';

        var stateCard = document.createElement('div');
        stateCard.className = 'ritual-summary-card';
        stateCard.innerHTML = '<strong>Состояние</strong><span>' + escapeHtml(ritual.energy || 'Не выбрано') + '</span>';

        var focusCard = document.createElement('div');
        focusCard.className = 'ritual-summary-card';
        focusCard.innerHTML = '<strong>Намерение</strong><span>' + escapeHtml(ritual.intention || modeMeta.description) + '</span>';

        var mainTasksCard = document.createElement('div');
        mainTasksCard.className = 'ritual-summary-card';
        mainTasksCard.innerHTML = '<strong>Главные задачи</strong><span>' + escapeHtml(ritualStats.progressLabel || (selectedTasks.length ? (selectedTasks.length + ' из ' + settings.maxMainTasks) : 'Пока не выбраны')) + '</span>';

        var timeCard = document.createElement('div');
        timeCard.className = 'ritual-summary-card';
        timeCard.innerHTML = '<strong>План / факт</strong><span>' + (ritualStats.plannedMinutes > 0 ? (formatMinutesHoursLabel(ritualStats.plannedMinutes) + ' / ' + formatMinutesHoursLabel(ritualStats.actualMinutes) + ' · ' + formatMinutesDeltaShort(ritualStats.delta)) : 'Нет времени по главным задачам') + '</span>';

        var nextCard = document.createElement('div');
        nextCard.className = 'ritual-summary-card';
        nextCard.innerHTML = '<strong>Следующий старт</strong><span>' + escapeHtml(nextMainTask ? nextMainTask.title : (selectedTasks.length ? 'Главные задачи уже закрыты' : 'Сначала выбери главные задачи')) + '</span>';

        var reviewCard = document.createElement('div');
        reviewCard.className = 'ritual-summary-card';
        reviewCard.innerHTML = '<strong>Закрытие дня</strong><span>' + escapeHtml(ritualStats.reviewLabel) + '</span>';

        summaryGrid.appendChild(stateCard);
        summaryGrid.appendChild(focusCard);
        summaryGrid.appendChild(mainTasksCard);
        summaryGrid.appendChild(timeCard);
        summaryGrid.appendChild(nextCard);
        summaryGrid.appendChild(reviewCard);

        var taskList = document.createElement('div');
