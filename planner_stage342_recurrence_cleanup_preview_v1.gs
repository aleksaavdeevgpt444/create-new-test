          actions: [
            createBoardKanbanAction('К backlog', function () { setBoardControlState({ timing: 'backlog', focus: 'backlog' }); }, 'primary'),
            createBoardKanbanAction('В Today top 3', function () { pushBoardBacklogToPlanned(control.backlogItems, 3); }, 'ghost')
          ]
        }));
        strip.appendChild(createBoardControlOverviewCard({
          value: control.overdueItems.length,
          label: 'Просрочка',
          tone: control.overdueItems.length ? 'danger' : '',
          note: control.overdueItems.length ? 'Просроченные задачи лучше быстро перетянуть в Today или перенести на завтра.' : 'Просроченных задач в срезе нет.',
          actions: [
