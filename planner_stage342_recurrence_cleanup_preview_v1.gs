            telegramCard.style.display = 'none';
          }
          var riskCard = byId('todayRiskDigestCard');
          if (riskCard) {
            riskCard.innerHTML = '';
            riskCard.style.display = 'none';
          }
          var dependencyCard = byId('todayDependencyDigestCard');
          if (dependencyCard) {
            dependencyCard.innerHTML = '';
            dependencyCard.style.display = 'none';
          }
          var aiCard = byId('todayAiPlanningCard');
          if (aiCard) {
            aiCard.innerHTML = '';
            aiCard.style.display = 'none';
          }
        }
        try {
          renderTodayExecutionFrameworks(dayYmd);
          renderTodayAuthorSystemCard(dayYmd);
          renderTodayOsHero(dayYmd);
          renderTodayOsPanel(dayYmd);
          renderTodayDayBlocks(dayYmd);
