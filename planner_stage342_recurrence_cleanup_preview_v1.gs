      async function loadEditorDependencyState(taskId, options) {
        options = options || {};
        var seq = options.seq;
        if (!(taskId && state.userId)) return;
        try {
          var data = await requestJson('/tasks/dependency?task_id=' + encodeURIComponent(taskId) + '&user_id=' + encodeURIComponent(state.userId), {
            __meta: { reportTransportErrors: options.reportTransportErrors === true, requestName: 'editor-dependency' }
          });
          if (!isActiveEditorAuxLoad(taskId, seq)) return;
          if (data && data.item) {
            setEditorDependencyStateValue(data.item, taskId);
          } else {
            setEditorDependencyStateValue(null, taskId);
          }
        } catch (error) {
          if (!isActiveEditorAuxLoad(taskId, seq)) return;
          if (Object.prototype.hasOwnProperty.call(state.editorDependencyCache || {}, String(taskId || ''))) {
            state.editorDependencyState = cloneEditorDependencyItem(state.editorDependencyCache[String(taskId || '')]);
          }
        }
        if (!isActiveEditorAuxLoad(taskId, seq)) return;
        renderEditorDependencyPanel(taskId);
        if (state.editorTaskId === taskId) renderEditorDependencySummaryPanel(taskId);
      }

      async function saveTaskDependency(taskId, blockedByTaskId) {
        if (!(taskId && state.userId)) return;
        var data = await requestJson('/tasks/dependency/set', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ task_id: taskId, user_id: state.userId, blocked_by_task_id: blockedByTaskId || null })
        });
        if (data && data.item) {
          setEditorDependencyStateValue(data.item, taskId);
          renderEditorDependencyPanel(taskId);
          if (state.editorTaskId === taskId) renderEditorDependencySummaryPanel(taskId);
          renderShellViews();
          if (state.planner) renderPlanner(state.planner);
          if (state.currentView === 'today') renderTodayView();
          if (state.currentView === 'plan') renderPlanView();
          loadEditorHistory(taskId);
          showSuccess(data.item.blocked_by_task_id ? 'Блокер сохранён.' : 'Блокер снят.');
        }
      }

      async function loadEditorHistory(taskId, options) {
        options = options || {};
        var seq = options.seq;
        if (!(taskId && state.userId)) return;
        try {
          var data = await requestJson('/tasks/history?task_id=' + encodeURIComponent(taskId) + '&user_id=' + encodeURIComponent(state.userId) + '&limit=40', {
            __meta: { reportTransportErrors: options.reportTransportErrors === true, requestName: 'editor-history' }
          });
          if (!isActiveEditorAuxLoad(taskId, seq)) return;
          setEditorHistoryState(data && data.items ? data.items : [], taskId);
        } catch (error) {
          if (!isActiveEditorAuxLoad(taskId, seq)) return;
          if (Object.prototype.hasOwnProperty.call(state.editorHistoryCache || {}, String(taskId || ''))) {
            state.editorTaskHistory = cloneEditorHistoryItems(state.editorHistoryCache[String(taskId || '')] || []);
          }
        }
        if (!isActiveEditorAuxLoad(taskId, seq)) return;
        renderEditorHistoryPanel();
      }

      function scheduleEditorAuxiliaryPanelsLoad(taskId) {
        if (!taskId) return;
        clearEditorAuxiliaryLoadTimer();
        var seq = Number(state.editorAuxLoadSeq || 0) + 1;
        state.editorAuxLoadSeq = seq;
        state.editorAuxLoadTimerId = setTimeout(function () {
          state.editorAuxLoadTimerId = null;
          if (!isActiveEditorAuxLoad(taskId, seq)) return;
          Promise.allSettled([
            loadChecklistItems(taskId, { seq: seq, reportTransportErrors: false }),
            loadEditorDependencyState(taskId, { seq: seq, reportTransportErrors: false }),
            loadEditorHistory(taskId, { seq: seq, reportTransportErrors: false })
          ]).then(function () {
            if (!isActiveEditorAuxLoad(taskId, seq)) return;
          });
        }, 60);
      }

      function cancelCurrentRequest() {
        if (state.currentAbortController) {
          try { state.currentAbortController.abort(); } catch (error) {}
          state.currentAbortController = null;
        }
      }

      async function authenticateViaTelegram() {
        if (!window.Telegram || !window.Telegram.WebApp) return false;

        var webApp = window.Telegram.WebApp;
        try {
          webApp.ready();
          if (typeof webApp.expand === 'function') webApp.expand();
          if (typeof webApp.requestFullscreen === 'function') {
            try { webApp.requestFullscreen(); } catch (error) {}
          }
        } catch (error) {
          console.error(error);
        }

        var initData = webApp.initData || '';
        if (!initData) return false;

        try {
          state.requestState = 'telegram-auth';
          updateDebugInfo();

          var data = await requestJson('/auth/telegram', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ init_data: initData })
          });

          var user = data.auth && data.auth.user ? data.auth.user : null;
          if (!user || !user.id) throw new Error('Telegram user not found after auth');

          state.authMode = 'telegram';
          state.telegramUser = user;
          state.userId = String(user.id);
          state.authSessionToken = data && data.session && data.session.token ? String(data.session.token) : '';
          state.taskRiskMap = loadStoredTaskRiskMap();
          saveUserId(state.userId);
          saveSessionToken(state.authSessionToken);
          setUserIdToUrl(state.userId);
          byId('userIdInput').value = state.userId;
          updateAuthBadge();
          state.requestState = 'telegram-auth-ok';
          updateDebugInfo();
          return true;
        } catch (error) {
          state.requestState = 'telegram-auth-failed';
          updateDebugInfo();
          showError('Ошибка Telegram auth: ' + String(error));
          return false;
        }
      }

      async function restorePersistedAuthSession() {
        try {
          var data = await requestJson('/auth/session', {
            method: 'GET',
            cache: 'no-store',
            silentError: true,
            reportTransportErrors: false,
            reportServerErrors: false
          });
          var session = data && data.session ? data.session : null;
          if (!session || !session.user_id) return false;
          state.authMode = session.auth_mode || 'session';
          state.userId = String(session.user_id);
          state.authSessionToken = session.token ? String(session.token) : (state.authSessionToken || '');
          state.telegramUser = state.telegramUser && String(state.telegramUser.id || '') === state.userId ? state.telegramUser : null;
          state.taskRiskMap = loadStoredTaskRiskMap();
          saveUserId(state.userId);
          if (state.authSessionToken) saveSessionToken(state.authSessionToken);
          setUserIdToUrl(state.userId);
          byId('userIdInput').value = state.userId;
          updateAuthBadge();
          updateDebugInfo();
          return true;
        } catch (error) {
          return false;
        }
      }

      async function clearServerSessionCookie() {
        try {
          await fetch('/auth/session/clear', {
            method: 'POST',
            cache: 'no-store',
            credentials: 'same-origin',
            headers: appendAuthSessionHeaders({ 'content-type': 'application/json' })
          });
        } catch (error) {}
      }

      function applyManualUserId(userId) {
        state.userId = userId;
        state.taskRiskMap = loadStoredTaskRiskMap();
        state.authMode = 'manual';
        state.telegramUser = null;
        state.authSessionToken = '';
        saveUserId(userId);
        clearStoredSessionToken();
        clearServerSessionCookie();
        setUserIdToUrl(userId);
        byId('userIdInput').value = userId;
        updateAuthBadge();
        updateDebugInfo();
      }

