        if (!items.length) {
          showError('В этой секции нет задач для переноса в Today.');
          return;
        }
        var moved = 0;
        for (var i = 0; i < items.length; i += 1) {
          var task = items[i];
          if (!(task && task.id)) continue;
          await sendTaskToTodayFromPlan(task.id);
          moved += 1;
        }
        if (moved > 0) showSuccess('В Today отправлено: ' + moved + '.');
        if (state.currentView === 'plan') renderPlanView();
      }

      async function movePlanSectionToTomorrow(sectionKey, limit) {
        var data = getPlanViewData();
        var items = getPlanSectionItemsByKey(data, sectionKey).slice(0, Math.max(1, Number(limit) || 3));
        if (!items.length) {
          showError('В этой секции нет задач для переноса на завтра.');
          return;
        }
        var moved = 0;
        for (var i = 0; i < items.length; i += 1) {
