      function renderKnowledgeDeepList(title, items) {
        var list = Array.isArray(items) ? items : [];
        return '<div class="knowledge-method-deep-card"><div class="knowledge-method-deep-title">' + escapeHtml(title || '') + '</div><ul class="knowledge-method-deep-list">' + list.map(function (item) { return '<li>' + escapeHtml(item || '') + '</li>'; }).join('') + '</ul></div>';
      }

      function getKnowledgeMethodSettingsState(row, activeFrameworkIds) {
        var kState = buildKnowledgeCenterState();
        var settings = normalizeFrameworkSettings(kState.frameworkSettings || getDefaultFrameworkSettings());
        var id = String(row && row.id || '').trim().toLowerCase();
        var defaults = [];
        var labels = { task: 'default задачи', day: 'default дня', week: 'default недели', project: 'default проекта' };
        Object.keys(labels).forEach(function (scope) {
          if (String(settings.defaults && settings.defaults[scope] || '') === id) defaults.push(labels[scope]);
        });
        var matchingBundles = FRAMEWORK_BUNDLE_REGISTRY.filter(function (bundle) { return (bundle.frameworks || []).indexOf(id) >= 0; }).map(function (bundle) { return bundle.title; });
        var matchingRoles = STRUCTURE_ROLE_PROFILE_REGISTRY.filter(function (profile) { var meta = getRoleRecommendationMeta(profile.id); return (meta.preferredFrameworks || []).indexOf(id) >= 0; }).map(function (profile) { return profile.title; });
        return { active: (activeFrameworkIds || []).indexOf(id) >= 0, coreAvailable: !!getFrameworkMeta(id), defaults: defaults, matchingBundles: matchingBundles, matchingRoles: matchingRoles, currentRoleTitle: (getStructureRoleProfileMeta(kState.currentRoleProfileId) || {}).title || '—' };
      }

      function renderKnowledgeMethodDeepHtml(row, activeFrameworkIds) {
        var guide = getKnowledgeMethodDeepGuide(row.id);
        var methodState = getKnowledgeMethodSettingsState(row, activeFrameworkIds);
        var recommendedBundleId = row.bundles && row.bundles[0] ? row.bundles[0] : '';
        var recommendedBundle = recommendedBundleId ? getFrameworkBundleById(recommendedBundleId) : null;
        var statePills = ['<span class="knowledge-method-state-pill ' + (methodState.active ? 'is-good' : 'is-warn') + '">' + (methodState.active ? 'Активна' : 'Не включена') + '</span>', '<span class="knowledge-method-state-pill">Роль сейчас: ' + escapeHtml(methodState.currentRoleTitle) + '</span>', '<span class="knowledge-method-state-pill">Default: ' + escapeHtml(methodState.defaults.length ? methodState.defaults.join(', ') : 'не выбран') + '</span>'];
        if (methodState.matchingBundles.length) statePills.push('<span class="knowledge-method-state-pill">Связки: ' + escapeHtml(methodState.matchingBundles.slice(0, 2).join(', ')) + '</span>');
        if (methodState.matchingRoles.length) statePills.push('<span class="knowledge-method-state-pill">Роли: ' + escapeHtml(methodState.matchingRoles.slice(0, 3).join(', ')) + '</span>');
        var actions = [];
        if (methodState.coreAvailable && !methodState.active) actions.push('<button class="btn-primary" type="button" data-kcp-framework-apply="' + escapeHtml(row.id) + '">Включить методику</button>');
        if (recommendedBundle) actions.push('<button class="btn-ghost" type="button" data-kcp-bundle-apply="' + escapeHtml(recommendedBundle.id) + '">Включить связку</button>');
        return '<div class="knowledge-method-deep"><div class="knowledge-method-deep-card"><div class="knowledge-method-deep-title">Что это</div><div class="knowledge-method-note">' + escapeHtml(guide.what || row.summary || '') + '</div><div class="knowledge-method-state-row">' + statePills.join('') + '</div></div><div class="knowledge-method-deep-grid">' + renderKnowledgeDeepList('Когда применять', guide.when) + renderKnowledgeDeepList('Когда не применять', guide.avoid) + renderKnowledgeDeepList('Экраны Planner', guide.screens) + renderKnowledgeDeepList('Что включить', guide.settings) + renderKnowledgeDeepList('Типичные ошибки', guide.mistakes) + renderKnowledgeDeepList('Старт на 1 неделю', guide.weekStart) + '</div>' + (actions.length ? '<div class="knowledge-method-actions">' + actions.join('') + '</div>' : '<div class="knowledge-method-note">Для этой методики пока нет прямого core-переключателя. Используйте её как ориентир в Knowledge Center.</div>') + '</div>';
      }

      function renderKnowledgeMethodCard(row, activeFrameworkIds, expandedMethodId) {
        var active = (activeFrameworkIds || []).indexOf(row.id) >= 0;
        var status = row.implementationStatus || row.status || 'planned';
        var category = getKnowledgeMethodCategory(row.id);
        var worksWith = (row.worksBestWith || []).map(getFrameworkTitle).filter(Boolean).slice(0, 3).join(', ');
        var expanded = normalizeKnowledgeMethodId(expandedMethodId) === normalizeKnowledgeMethodId(row.id);
        return '<article class="knowledge-method-card ' + (active ? 'is-active-core' : '') + '">' +
          '<div class="knowledge-method-top"><div><div class="knowledge-method-name">' + escapeHtml(row.title || '') + '</div><div class="knowledge-method-note">' + escapeHtml(row.bestFor || row.summary || '') + '</div></div><span class="framework-knowledge-status ' + getFrameworkStatusTone(status) + '">' + escapeHtml(getFrameworkStatusLabel(status)) + '</span></div>' +
          '<div class="knowledge-method-meta">' +
            '<span class="knowledge-method-chip">' + escapeHtml(getKnowledgeMethodCategoryLabel(category)) + '</span>' +
            '<span class="knowledge-method-chip">Горизонт: ' + escapeHtml(getKnowledgeLabel(row.horizon || row.cadence)) + '</span>' +
            '<span class="knowledge-method-chip">Сложность: ' + escapeHtml(getKnowledgeLabel(row.complexity)) + '</span>' +
            '<span class="knowledge-method-chip">Стиль: ' + escapeHtml(getKnowledgeLabel(row.executionStyle)) + '</span>' +
            (active ? '<span class="knowledge-method-chip">Активно</span>' : '') +
          '</div>' +
          '<div class="knowledge-method-note"><strong>Сочетать:</strong> ' + escapeHtml(worksWith || '—') + '</div>' +
          '<div class="knowledge-method-actions"><button class="btn-ghost" type="button" data-kcp-method-details="' + escapeHtml(row.id) + '">' + (expanded ? 'Свернуть' : 'Подробнее') + '</button>' + (getFrameworkMeta(row.id) && !active ? '<button class="btn-primary" type="button" data-kcp-framework-apply="' + escapeHtml(row.id) + '">Включить методику</button>' : '') + '</div>' +
          (expanded ? renderKnowledgeMethodDeepHtml(row, activeFrameworkIds) : '') +
        '</article>';
      }

      function bindKnowledgeMethodFilters(container) {
        if (!container) return;
        Array.prototype.forEach.call(container.querySelectorAll('[data-kcp-method-filter]'), function (button) {
          if (button.dataset.bound === '1') return;
          button.addEventListener('click', function () {
            saveKnowledgeMethodFilter(button.getAttribute('data-kcp-method-filter') || 'all');
            renderFrameworkComparisonBlock();
          });
          button.dataset.bound = '1';
        });
        Array.prototype.forEach.call(container.querySelectorAll('[data-kcp-method-details]'), function (button) {
          if (button.dataset.bound === '1') return;
          button.addEventListener('click', function () {
            toggleKnowledgeMethodDetails(button.getAttribute('data-kcp-method-details') || '');
          });
          button.dataset.bound = '1';
        });
        bindKnowledgeProActions(container);
      }

      function renderFrameworkComparisonBlock() {
        var container = byId('knowledgeFrameworkComparison');
        if (!container) return;
        var kState = buildKnowledgeCenterState();
        var rows = buildFrameworkComparisonRows();
        var activeFilter = loadKnowledgeMethodFilter();
        var activeFrameworkIds = kState.activeFrameworkIds || [];
        var filteredRows = rows.filter(function (row) { return matchesKnowledgeMethodFilter(row, activeFilter, activeFrameworkIds); });
        var expandedMethodId = loadKnowledgeExpandedMethodId();
        var activeLabel = (getKnowledgeMethodFilterOptions().find(function (item) { return item.id === activeFilter; }) || { label: 'Все' }).label;
        var statsHtml = '<div class="knowledge-chip-row"><span class="knowledge-chip">Показано: ' + filteredRows.length + ' / ' + rows.length + '</span><span class="knowledge-chip">Активно: ' + activeFrameworkIds.length + '</span><span class="knowledge-chip">Фильтр: ' + escapeHtml(activeLabel) + '</span>' + (expandedMethodId ? '<span class="knowledge-chip">Открыто: ' + escapeHtml(getFrameworkTitle(expandedMethodId)) + '</span>' : '') + '</div>';
        container.innerHTML = '<section class="knowledge-pro-panel"><div class="knowledge-pro-head"><div><h3 class="knowledge-pro-title">Сравнение и карточки методик</h3><div class="knowledge-pro-subtitle">Теперь каждая методика раскрывается в практическую инструкцию: когда применять, какие экраны использовать, какие настройки включить, типичные ошибки и быстрый старт на неделю.</div></div></div>' + renderKnowledgeMethodFilterBar(activeFilter) + statsHtml + (filteredRows.length ? '<div class="knowledge-method-grid">' + filteredRows.map(function (row) { return renderKnowledgeMethodCard(row, activeFrameworkIds, expandedMethodId); }).join('') + '</div>' : '<div class="knowledge-method-empty">По выбранному фильтру методик не найдено. Выберите другой фильтр.</div>') + '</section>';
        bindKnowledgeMethodFilters(container);
      }


