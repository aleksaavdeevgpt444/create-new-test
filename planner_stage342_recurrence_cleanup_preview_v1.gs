      }

      function getPlanPriorityBoardData(data) {
        var source = [];
        var seen = Object.create(null);
        function pushTask(task) {
          if (!(task && task.id)) return;
          var id = String(task.id);
          if (seen[id]) return;
          seen[id] = true;
          if (normalizeStatus(task.status) === STATUS.DONE || normalizeStatus(task.status) === STATUS.CANCELED) return;
          source.push(task);
        }
        (data.sections.main || []).forEach(pushTask);
        (data.sections.risk || []).forEach(pushTask);
        (data.sections.important || []).forEach(pushTask);
        (data.sections.additional || []).forEach(pushTask);
        (data.sections.recurring || []).forEach(pushTask);
        (data.sections.noDate || []).forEach(pushTask);

        var buckets = {
          high: { key: 'high', title: 'Высокий приоритет', note: 'Критичные задачи недели', items: [] },
          medium: { key: 'medium', title: 'Средний приоритет', note: 'Основной рабочий слой', items: [] },
          low: { key: 'low', title: 'Низкий приоритет', note: 'Лёгкие и фоново-полезные', items: [] },
          none: { key: 'none', title: 'Без приоритета', note: 'Нуждаются в решении по важности', items: [] }
        };
        source.forEach(function (task) { buckets[getPlanPriorityBucketKey(task)].items.push(task); });
        Object.keys(buckets).forEach(function (key) {
          var bucket = buckets[key];
          bucket.items.sort(compareTasksByPriorityThenDue);
          bucket.count = bucket.items.length;
          bucket.totalPlanned = bucket.items.reduce(function (sum, task) { return sum + getTaskPlannedMinutesValue(task); }, 0);
        });
        return [buckets.high, buckets.medium, buckets.low, buckets.none];
      }

      function getPlanPriorityBucketByKey(data, bucketKey) {
        return getPlanPriorityBoardData(data).find(function (bucket) { return bucket.key === bucketKey; }) || null;
      }

      async function sendPlanPriorityBucketToToday(bucketKey, limit) {
        var data = getPlanViewData();
        var bucket = getPlanPriorityBucketByKey(data, bucketKey);
        var items = bucket && Array.isArray(bucket.items) ? bucket.items.slice(0, Math.max(1, Number(limit) || 3)) : [];
        if (!items.length) {
          showError('В этой колонке нет задач для переноса в Today.');
          return;
        }
        var moved = 0;
        for (var i = 0; i < items.length; i += 1) {
          var task = items[i];
          if (!(task && task.id)) continue;
          await sendTaskToTodayFromPlan(task.id);
          moved += 1;
        }
        if (moved > 0) showSuccess('В Today отправлено: ' + moved + '.');
        if (state.currentView === 'plan') renderPlanView();
      }

      function openFirstPlanPriorityTask(bucketKey) {
        var data = getPlanViewData();
        var bucket = getPlanPriorityBucketByKey(data, bucketKey);
        var task = bucket && bucket.items && bucket.items[0] ? bucket.items[0] : null;
        if (!(task && task.id)) {
          showError('В этой колонке нет задачи для открытия.');
          return;
        }
        openEditor(task.id);
      }
      function getPlanSectionItemsByKey(data, sectionKey) {
        var sections = data && data.sections ? data.sections : null;
        if (!sections) return [];
        var list = sections[sectionKey];
        return Array.isArray(list) ? list : [];
      }

      async function sendPlanSectionToToday(sectionKey, limit) {
        var data = getPlanViewData();
