function loadFrameworkSettingsServerSyncUserId() {
  try {
    return String(localStorage.getItem(FRAMEWORK_SETTINGS_SERVER_SYNC_KEY) || '').trim();
  } catch (error) {
    return '';
  }
}

function saveFrameworkSettingsServerSyncUserId(userId) {
  try {
    if (!userId) {
      localStorage.removeItem(FRAMEWORK_SETTINGS_SERVER_SYNC_KEY);
      return;
    }
    localStorage.setItem(FRAMEWORK_SETTINGS_SERVER_SYNC_KEY, String(userId));
  } catch (error) {}
}

function buildFrameworkSettingsRequestUrl() {
  var safeUserId = String(state.userId || '').trim();
  var url = '/frameworks/settings';
  if (safeUserId) url += '?user_id=' + encodeURIComponent(safeUserId);
  return url;
}

function requestFrameworkSettingsFromServer() {
  if (!state.userId) return Promise.resolve(null);
  return requestJson(buildFrameworkSettingsRequestUrl(), {
    method: 'GET',
    __meta: { requestName: 'framework-settings-get', reportServerErrors: true, reportTransportErrors: false, timeoutMs: 5000 }
  });
}

function persistFrameworkSettingsToServer(settings, options) {
  if (!state.userId) return Promise.resolve(null);
  var payload = {
    user_id: String(state.userId || ''),
    settings: normalizeFrameworkSettings(settings || getDefaultFrameworkSettings())
  };
  return requestJson(buildFrameworkSettingsRequestUrl(), {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
    __meta: { requestName: 'framework-settings-put', reportServerErrors: !(options && options.silent) }
  }).then(function (data) {
    saveFrameworkSettingsServerSyncUserId(String(state.userId || ''));
    setServerSyncState('frameworkSettingsSyncState', { source: 'server', status: 'saved', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'settings' });
    return data;
  }).catch(function (error) {
    setServerSyncState('frameworkSettingsSyncState', { source: 'fallback', status: 'fallback', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'settings' });
    if (!(options && options.silent)) throw error;
    return null;
  });
}

function hydrateFrameworkSettingsFromServer() {
  if (!state.userId) return Promise.resolve(null);
  return requestFrameworkSettingsFromServer().then(function (data) {
    if (!data) return null;
    var source = String(data.source || '');
    // STAGE 292 — читаем knowledge recommendation поля через общий helper, чтобы не держать разные ветки server-truth.
    function _applyKnowledgeServerFields(d) {
      applyKnowledgeServerStateFields(d);
      if (d && (d.knowledge_recommendation_state !== undefined || d.knowledge_last_applied_role !== undefined || d.knowledge_recommendation_history !== undefined)) {
        setKnowledgeRecommendationSyncState('loaded', 'framework_settings');
      }
    }
    if (source === 'server' && data.settings) {
      applyFrameworkSettings(data.settings, { silent: true, skipServerSync: true });
      _applyKnowledgeServerFields(data);
      saveFrameworkSettingsServerSyncUserId(String(state.userId || ''));
      setServerSyncState('frameworkSettingsSyncState', { source: 'server', status: 'loaded', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'settings' });
      return data;
    }
    var localSettings = normalizeFrameworkSettings(state.frameworkSettings || loadStoredFrameworkSettings() || getDefaultFrameworkSettings());
    var hasMeaningfulLocalChanges = JSON.stringify(localSettings) !== JSON.stringify(getDefaultFrameworkSettings()) || loadFrameworkSettingsServerSyncUserId() !== String(state.userId || '');
    if (!hasMeaningfulLocalChanges) {
      applyFrameworkSettings(data.settings || getDefaultFrameworkSettings(), { silent: true, skipServerSync: true });
      _applyKnowledgeServerFields(data);
      return data;
    }
    return persistFrameworkSettingsToServer(localSettings, { silent: true }).then(function (saved) {
      if (saved && saved.settings) {
        applyFrameworkSettings(saved.settings, { silent: true, skipServerSync: true });
        _applyKnowledgeServerFields(saved);
        setServerSyncState('frameworkSettingsSyncState', { source: 'migrated', status: 'migrated', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'settings' });
        return saved;
      }
      return data;
    });
  }).catch(function () {
    setServerSyncState('frameworkSettingsSyncState', { source: 'fallback', status: 'fallback', userId: String(state.userId || ''), syncedAt: new Date().toISOString(), details: 'settings' });
    return null;
  });
}

