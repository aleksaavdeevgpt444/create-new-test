      function getKnowledgeWizardLabel(value) {
        var labels = {
          author: 'Авторская система planner', manager: 'Руководитель / менеджер', creator: 'Creator / дизайнер', project: 'Project / PM', knowledge: 'Knowledge worker', operations: 'Операционный поток', personal: 'Личная система',
          incoming: 'Много входящих', projects: 'Много проектов', mixed: 'Смешанная работа', routine: 'Рутина и координация', creative: 'Создание и глубокая работа',
          overload: 'Перегруз', chaos: 'Хаос входящих', focus: 'Не хватает фокуса', strategy: 'Не хватает стратегии', review: 'Нет регулярного review',
          low: 'Минимальная', medium: 'Средняя', high: 'Расширенная', execution: 'Исполнение', planning: 'Планирование', control: 'Контроль'
        };
        return labels[String(value || '').trim()] || getKnowledgeInteractiveLabel(value);
