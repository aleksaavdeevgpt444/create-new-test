function getConfiguredTelegramControlTimezone(env) {
  const candidates = [
    env && env.TELEGRAM_CONTROL_TIMEZONE,
    env && env.APP_TIMEZONE,
    env && env.DEFAULT_TIMEZONE,
    TELEGRAM_CONTROL_TIMEZONE
  ];
  for (let i = 0; i < candidates.length; i += 1) {
    const safe = String(candidates[i] || '').trim();
    if (!safe) continue;
    try {
      Intl.DateTimeFormat('en-US', { timeZone: safe }).format(new Date());
      return safe;
    } catch (error) {}
  }
  return TELEGRAM_CONTROL_TIMEZONE;
}

function extractTelegramCommand(text) {
  if (!text || !text.startsWith("/")) return null;
  return text.split(/\s+/)[0].split("@")[0];
}

function extractTelegramCommandParts(text) {
  if (!text || !text.startsWith("/")) return null;
  const parts = text.trim().split(/\s+/);
  return { command: parts[0].split("@")[0], args: parts.slice(1) };
}

function normalizeStatus(value) {
  if (value === null || value === undefined || value === "") return null;
  const normalized = String(value).trim().toLowerCase();

  if (TASK_STATUS_GROUPS[normalized]) return normalized;
  if (LEGACY_STATUS_ALIASES[normalized]) return LEGACY_STATUS_ALIASES[normalized];

  if (normalized === "новые" || normalized === "новая" || normalized === "входящие") return TASK_STATUSES.NEW;
  if (normalized === "в плане" || normalized === "план" || normalized === "запланировано" || normalized === "запланированная") {
    return TASK_STATUSES.PLANNED;
  }
  if (normalized === "выполнено" || normalized === "выполнена" || normalized === "готово" || normalized === "завершено") {
    return TASK_STATUSES.DONE;
  }
  if (normalized === "отменено" || normalized === "отменена") return TASK_STATUSES.CANCELED;
  if (normalized === "перенесено" || normalized === "перенесена") return TASK_STATUSES.POSTPONED;
  return null;
}

function getStatusSqlValues(status) {
  const normalized = normalizeStatus(status);
  if (!normalized) return [];
  return TASK_STATUS_GROUPS[normalized] || [normalized];
}

function normalizeIsoDateTime(value) {
  if (value === null || value === undefined || value === "") return null;
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) throw new Error(`Invalid datetime value: ${value}`);
  return parsed.toISOString();
}

function normalizeDurationMinutes(value) {
  if (value === null || value === undefined || value === "") return null;
  const parsed = Number(value);
  if (!Number.isFinite(parsed)) throw new Error("duration_minutes must be a number");
  const rounded = Math.round(parsed);
  if (rounded < 5 || rounded > 720) {
    throw new Error("duration_minutes must be between 5 and 720");
  }
  return rounded;
}

function normalizeRecurrenceType(value) {
  if (value === null || value === undefined || value === "") return null;
  const normalized = String(value).trim().toLowerCase();
  const allowed = ["weekdays", "daily", "weekly", "monthly", "yearly", "custom"];
  return allowed.includes(normalized) ? normalized : null;
}

function normalizeRecurrenceEnabled(type, enabled) {
  const normalizedType = normalizeRecurrenceType(type);
  if (!normalizedType) return 0;
  return enabled === false || enabled === 0 || enabled === "0" ? 0 : 1;
}

function shouldMaterializeRecurrence(task) {
  return !!(task && Number(task.recurrence_enabled || 0) === 1 && normalizeRecurrenceType(task.recurrence_type) && task.due_at);
}

function getTaskSeriesId(task) {
  if (!task) return null;
  return task.recurrence_series_id || null;
}

function getTaskRecurrenceIndex(task) {
  const parsed = Number(task && task.recurrence_index);
  return Number.isFinite(parsed) ? parsed : 0;
}

function isTaskRecurringInstance(task) {
  return !!(
    task
    && (
      getTaskSeriesId(task)
      || task.recurrence_parent_task_id
      || Number(task.recurrence_enabled || 0) === 1
      || normalizeRecurrenceType(task.recurrence_type)
    )
  );
}

function getRecurrenceWeekdaySet(type, rule) {
  const normalizedType = normalizeRecurrenceType(type);
  const map = { SU: 0, MO: 1, TU: 2, WE: 3, TH: 4, FR: 5, SA: 6 };
  if (normalizedType === 'weekdays') return [1, 2, 3, 4, 5];
  if (normalizedType !== 'custom') return null;
  const values = String(rule || '').split(',').map((x) => x.trim().toUpperCase()).filter(Boolean);
  const days = values.map((value) => map[value]).filter((value) => Number.isInteger(value));
  return Array.from(new Set(days)).sort((a, b) => a - b);
}

function daysInUtcMonth(year, monthIndex) {
  return new Date(Date.UTC(year, monthIndex + 1, 0)).getUTCDate();
}

function addUtcDays(iso, days) {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) throw new Error(`Invalid recurrence date: ${iso}`);
  date.setUTCDate(date.getUTCDate() + days);
  return date.toISOString();
}

function addUtcMonthsPreserveDay(iso, months) {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) throw new Error(`Invalid recurrence date: ${iso}`);
  const year = date.getUTCFullYear();
  const month = date.getUTCMonth();
  const day = date.getUTCDate();
  const hours = date.getUTCHours();
  const minutes = date.getUTCMinutes();
  const seconds = date.getUTCSeconds();
  const ms = date.getUTCMilliseconds();
  const targetMonthIndex = month + months;
  const targetYear = year + Math.floor(targetMonthIndex / 12);
  const normalizedMonth = ((targetMonthIndex % 12) + 12) % 12;
  const safeDay = Math.min(day, daysInUtcMonth(targetYear, normalizedMonth));
  return new Date(Date.UTC(targetYear, normalizedMonth, safeDay, hours, minutes, seconds, ms)).toISOString();
}

function addUtcYearsPreserveDay(iso, years) {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) throw new Error(`Invalid recurrence date: ${iso}`);
  const year = date.getUTCFullYear() + years;
  const month = date.getUTCMonth();
  const day = Math.min(date.getUTCDate(), daysInUtcMonth(year, month));
  return new Date(Date.UTC(year, month, day, date.getUTCHours(), date.getUTCMinutes(), date.getUTCSeconds(), date.getUTCMilliseconds())).toISOString();
}

function computeNextOccurrenceDueAt(currentIso, recurrenceType, recurrenceRule) {
  const normalizedType = normalizeRecurrenceType(recurrenceType);
  if (!normalizedType) return null;

  if (normalizedType === 'daily') return addUtcDays(currentIso, 1);
  if (normalizedType === 'weekly') return addUtcDays(currentIso, 7);
  if (normalizedType === 'monthly') return addUtcMonthsPreserveDay(currentIso, 1);
  if (normalizedType === 'yearly') return addUtcYearsPreserveDay(currentIso, 1);

  const allowedDays = getRecurrenceWeekdaySet(normalizedType, recurrenceRule);
  if (allowedDays && allowedDays.length) {
    let cursor = currentIso;
    for (let i = 0; i < 14; i += 1) {
      cursor = addUtcDays(cursor, 1);
      const nextDate = new Date(cursor);
      if (allowedDays.includes(nextDate.getUTCDay())) return cursor;
    }
    return null;
  }

  return null;
}

function getRecurrenceHorizonCount(recurrenceType) {
  const normalizedType = normalizeRecurrenceType(recurrenceType);
  if (normalizedType === 'yearly') return 8;
  if (normalizedType === 'monthly') return 18;
  return RECURRENCE_FUTURE_OCCURRENCES;
}

