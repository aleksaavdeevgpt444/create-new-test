        grid-template-columns: 1fr;
      }
      .view-nav-group-primary,
      .view-nav-group-support,
      .view-nav-group-utility {
        padding: 10px;
      }
    }


  </style>
</head>
<body>
  <div class="app">
    <div class="topbar">
      <div class="hero" id="shellHeroCard">
