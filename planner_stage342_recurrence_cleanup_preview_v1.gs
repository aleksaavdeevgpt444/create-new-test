        ]));
        if (loadRow) {
          shell.appendChild(createBoardCommandCard('Самая большая нагрузка · ' + loadRow.project, formatMinutesHoursLabel(loadRow.plannedMinutes) + ' · задач: ' + loadRow.count, 'warn', [
            createBoardCommandAction('Фильтр', function () {
