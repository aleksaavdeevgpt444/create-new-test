      function getBrowserTimeZone() {
        try {
          return Intl.DateTimeFormat().resolvedOptions().timeZone || 'Europe/Warsaw';
        } catch (error) {
          return 'Europe/Warsaw';
        }
      }

      function getSupportedPlannerTimeZones() {
        return ['browser', 'Europe/Warsaw', 'Europe/Berlin', 'Europe/London', 'Europe/Moscow', 'Asia/Yekaterinburg', 'Asia/Almaty', 'UTC'];
      }

      function padHourOption(value) {
        return String(value).padStart(2, '0') + ':00';
      }

      function fillPlanningHourSelect(selectId, fromHour, toHourInclusive, allowTwentyFour) {
        var select = byId(selectId);
        if (!select) return;
        if (select.dataset.filled === '1') return;
        select.innerHTML = '';
        for (var hour = fromHour; hour <= toHourInclusive; hour += 1) {
          if (hour === 24 && !allowTwentyFour) continue;
          var option = document.createElement('option');
          option.value = String(hour);
          option.textContent = hour === 24 ? '24:00' : padHourOption(hour);
          select.appendChild(option);
        }
        select.dataset.filled = '1';
      }

      function getDefaultPlanningSettings() {
        return {
          timeZone: 'browser',
          startHour: 8,
          endHour: 23
        };
      }

      function normalizePlanningSettings(value) {
        var defaults = getDefaultPlanningSettings();
        var source = value && typeof value === 'object' ? value : {};
        var allowed = getSupportedPlannerTimeZones();
        var timeZone = String(source.timeZone || defaults.timeZone || 'browser').trim() || 'browser';
        if (allowed.indexOf(timeZone) === -1) timeZone = defaults.timeZone;
        var startHour = Math.max(0, Math.min(23, Number(source.startHour)));
        if (!isFinite(startHour)) startHour = defaults.startHour;
        startHour = Math.round(startHour);
        var endHour = Math.max(1, Math.min(24, Number(source.endHour)));
        if (!isFinite(endHour)) endHour = defaults.endHour;
        endHour = Math.round(endHour);
        if (endHour <= startHour) endHour = Math.min(24, startHour + 1);
        return {
          timeZone: timeZone,
          startHour: startHour,
          endHour: endHour
        };
      }

      function loadStoredPlanningSettings() {
        try {
          var raw = localStorage.getItem(PLANNING_SETTINGS_STORAGE_KEY);
          if (!raw) return getDefaultPlanningSettings();
          return normalizePlanningSettings(JSON.parse(raw));
        } catch (error) {
          return getDefaultPlanningSettings();
        }
      }

      function getPlannerTimeZone() {
        var settings = state.planningSettings || getDefaultPlanningSettings();
        return settings.timeZone === 'browser' ? getBrowserTimeZone() : settings.timeZone;
      }

      function getPlanningWindowHours() {
        return {
          startHour: Number(PLANNING_WINDOW_START_HOUR) || getDefaultPlanningSettings().startHour,
          endHour: Number(PLANNING_WINDOW_END_HOUR) || getDefaultPlanningSettings().endHour
        };
      }

      function getCalendarRenderWindowHours() {
        return {
          startHour: Number(CALENDAR_RENDER_START_HOUR) || getDefaultPlanningSettings().startHour,
          endHour: Number(CALENDAR_RENDER_END_HOUR) || getDefaultPlanningSettings().endHour
        };
      }

      function getCalendarInteractionWindowHours() {
        return {
          startHour: Number(CALENDAR_INTERACTION_START_HOUR) || getDefaultPlanningSettings().startHour,
          endHour: Number(CALENDAR_INTERACTION_END_HOUR) || getDefaultPlanningSettings().endHour
        };
      }

      function getCalendarVisibleHours() {
        var renderWindow = getCalendarRenderWindowHours();
        return Math.max(Number(renderWindow.endHour) - Number(renderWindow.startHour), 1);
      }

      function syncCalendarWindowFromPlanningSettings(settings) {
        var normalized = normalizePlanningSettings(settings || state.planningSettings || getDefaultPlanningSettings());
        PLANNING_WINDOW_START_HOUR = normalized.startHour;
        PLANNING_WINDOW_END_HOUR = normalized.endHour;
        if (PLANNING_WINDOW_END_HOUR <= PLANNING_WINDOW_START_HOUR) PLANNING_WINDOW_END_HOUR = Math.min(24, PLANNING_WINDOW_START_HOUR + 1);

        CALENDAR_RENDER_START_HOUR = PLANNING_WINDOW_START_HOUR;
        CALENDAR_RENDER_END_HOUR = PLANNING_WINDOW_END_HOUR;
        CALENDAR_INTERACTION_START_HOUR = PLANNING_WINDOW_START_HOUR;
        CALENDAR_INTERACTION_END_HOUR = PLANNING_WINDOW_END_HOUR;

        try {
          document.documentElement.style.setProperty('--calendar-visible-hours', String(getCalendarVisibleHours()));
          document.documentElement.style.setProperty('--planner-visible-hours', String(getCalendarVisibleHours()));
          document.documentElement.style.setProperty('--planner-start-hour', String(CALENDAR_RENDER_START_HOUR));
          document.documentElement.style.setProperty('--planner-end-hour', String(CALENDAR_RENDER_END_HOUR));
        } catch (error) {}
      }

      function formatWithPlannerTimeZone(value, options, fallback) {
        if (value === null || value === undefined || value === '') return fallback || '—';
        var date = value instanceof Date ? value : new Date(value);
        if (isNaN(date.getTime())) return fallback || '—';
        var formatOptions = Object.assign({ timeZone: getPlannerTimeZone() }, options || {});
        try {
          return new Intl.DateTimeFormat('ru-RU', formatOptions).format(date);
        } catch (error) {
          var safeOptions = Object.assign({}, formatOptions);
          delete safeOptions.timeZone;
          return new Intl.DateTimeFormat('ru-RU', safeOptions).format(date);
        }
      }

      function formatTimeByYmdWithPlannerTimeZone(value, dayYmd, fallback) {
        if (value === null || value === undefined || value === '') return fallback || '—';
        var date = value instanceof Date ? value : new Date(value);
        if (isNaN(date.getTime())) return fallback || '—';
        return formatWithPlannerTimeZone(date, { hour: '2-digit', minute: '2-digit' }, fallback || '—');
      }

      function syncPlanningSettingsInputs(settings) {
        var normalized = normalizePlanningSettings(settings || state.planningSettings || getDefaultPlanningSettings());
        fillPlanningHourSelect('planningStartHourSelect', 0, 23, false);
        fillPlanningHourSelect('planningEndHourSelect', 1, 24, true);
        if (byId('planningTimeZoneSelect')) byId('planningTimeZoneSelect').value = normalized.timeZone;
        if (byId('planningStartHourSelect')) byId('planningStartHourSelect').value = String(normalized.startHour);
        if (byId('planningEndHourSelect')) byId('planningEndHourSelect').value = String(normalized.endHour);
        var info = byId('planningSettingsInfo');
        if (info) {
          var browserTz = getBrowserTimeZone();
          var effectiveTz = normalized.timeZone === 'browser' ? browserTz : normalized.timeZone;
