async function createTaskRecord(env, taskInput) {
  const now = new Date().toISOString();
  const taskId = crypto.randomUUID();
  const normalizedDueAt = normalizeIsoDateTime(taskInput.due_at);
  const normalizedRemindAt = taskInput.remind_at ? normalizeIsoDateTime(taskInput.remind_at) : null;
  const normalizedDuration = normalizeDurationMinutes(taskInput.duration_minutes) ?? DEFAULT_EVENT_DURATION_FOR_SERVER();
  const taskStatus = normalizedDueAt ? TASK_STATUSES.PLANNED : TASK_STATUSES.NEW;
  const normalizedPriorityManual = normalizePriorityManualValue(taskInput.priority_manual);
  const normalizedRecurrenceType = normalizeRecurrenceType(taskInput.recurrence_type);
  const normalizedRecurrenceEnabled = normalizeRecurrenceEnabled(taskInput.recurrence_type, taskInput.recurrence_enabled);
  const recurrenceSeriesId = normalizedDueAt && normalizedRecurrenceType && normalizedRecurrenceEnabled === 1 ? taskId : null;

  await insertTask(env, {
    id: taskId,
    user_id: String(taskInput.user_id),
    title: taskInput.title,
    task_product: taskInput.task_product ?? null,
    description: taskInput.description ?? null,
    status: taskStatus,
    priority_manual: normalizedPriorityManual,
    priority_ai: null,
    project_name: taskInput.project_name || "Без проекта",
    due_at: normalizedDueAt,
    duration_minutes: normalizedDuration,
    planned_minutes_manual: normalizeOptionalTaskMinutes(taskInput.planned_minutes_manual),
    actual_minutes: normalizeOptionalTaskMinutes(taskInput.actual_minutes),
    show_in_month: normalizeShowInMonthValue(taskInput.show_in_month),
    space_key: normalizeTaskSpaceKey(taskInput.space_key),
    remind_at: normalizedRemindAt,
    source: taskInput.source || "web",
    source_record_id: taskInput.source_record_id || null,
    source_type: taskInput.source_type || null,
    source_url: taskInput.source_url || null,
    linked_resource_url: taskInput.linked_resource_url || null,
    linked_resource_title: taskInput.linked_resource_title || null,
    linked_hub_record_id: taskInput.linked_hub_record_id || null,
    telegram_notify_type: normalizeTelegramNotifyType(taskInput.telegram_notify_type),
    task_type: normalizeTaskType_(taskInput.task_type),
    importance: normalizeTaskImportance_(taskInput.importance),
    urgency: normalizeTaskUrgency_(taskInput.urgency),
    ai_priority_reason: null,
    ai_project_guess: null,
    ai_next_step: null,
    recurrence_type: normalizedRecurrenceType,
    recurrence_rule: taskInput.recurrence_rule || null,
    recurrence_enabled: normalizedRecurrenceEnabled,
    recurrence_series_id: recurrenceSeriesId,
    recurrence_parent_task_id: null,
    recurrence_index: 0,
    created_at: now,
    updated_at: now,
  });

  const task = await getTaskById(env, { taskId, userId: String(taskInput.user_id) });
  await addTaskHistory(env, {
    userId: String(taskInput.user_id),
    taskId,
    eventType: 'created',
    payload: { title: task && task.title ? task.title : String(taskInput.title || ''), status: task && task.status ? task.status : taskStatus, due_at: task && task.due_at ? task.due_at : normalizedDueAt },
    createdAt: now
  });
  return { task, taskId };
}

async function createTaskWithAi(env, taskInput) {
  const { task, taskId } = await createTaskRecord(env, taskInput);

  let aiResult = null;
  try {
    aiResult = await getAiTaskAdvice(env, taskInput.title, { userId: String(taskInput.user_id) });
    await updateTaskWithAi(env, taskId, aiResult);
  } catch (aiError) {
    console.log("AI enrichment failed:", String(aiError));
  }

  return { task: await getTaskById(env, { taskId, userId: String(taskInput.user_id) }), aiResult };
}

async function updateTaskStatus(env, { taskId, userId, nextStatus }) {
  const normalizedStatus = normalizeStatus(nextStatus);
  if (!normalizedStatus) throw new Error(`Unsupported status: ${nextStatus}`);

  const clearDueAt = isClearingDueAtStatus(normalizedStatus);
  const previousTask = await getTaskById(env, { taskId, userId: String(userId) });
  const historyStamp = new Date().toISOString();
  await env.DB.prepare(`
    UPDATE tasks
    SET
      status = ?,
      due_at = CASE WHEN ? = 1 THEN NULL ELSE due_at END,
      updated_at = ?
    WHERE id = ? AND user_id = ?
  `)
    .bind(normalizedStatus, clearDueAt ? 1 : 0, historyStamp, taskId, String(userId))
    .run();

  await addTaskHistory(env, {
    userId: String(userId),
    taskId,
    eventType: 'status_changed',
    payload: { previous_status: previousTask && previousTask.status ? previousTask.status : null, next_status: normalizedStatus },
    createdAt: historyStamp
  });

  return getTaskById(env, { taskId, userId: String(userId) });
}

async function updateTaskSchedule(env, { taskId, userId, dueAt, nextStatus = null, durationMinutes = undefined }) {
  const existingTask = await getTaskById(env, { taskId, userId: String(userId) });
  if (!existingTask) throw new Error("Task not found");

  const normalizedStatus = nextStatus ? normalizeStatus(nextStatus) : null;
  const normalizedDueAt = dueAt === null || dueAt === undefined || dueAt === "" ? null : normalizeIsoDateTime(dueAt);
  const normalizedDuration = durationMinutes === undefined ? undefined : (normalizeDurationMinutes(durationMinutes) ?? DEFAULT_EVENT_DURATION_FOR_SERVER());

  let effectiveStatus = normalizedStatus;
  if (!effectiveStatus) {
    const currentStatus = normalizeStatus(existingTask.status);
    const isFinalStatus = currentStatus === TASK_STATUSES.DONE || currentStatus === TASK_STATUSES.CANCELED;
    if (isFinalStatus) {
      effectiveStatus = currentStatus;
    } else if (normalizedDueAt) {
      effectiveStatus = TASK_STATUSES.PLANNED;
    } else if (currentStatus === TASK_STATUSES.PLANNED || existingTask.due_at) {
      effectiveStatus = TASK_STATUSES.POSTPONED;
    } else {
      effectiveStatus = TASK_STATUSES.NEW;
    }
  }

  const historyStamp = new Date().toISOString();
  if (normalizedDuration === undefined) {
    await env.DB.prepare(`
      UPDATE tasks
      SET
        due_at = ?,
        status = ?,
        updated_at = ?
      WHERE id = ? AND user_id = ?
    `)
      .bind(normalizedDueAt, effectiveStatus, historyStamp, taskId, String(userId))
      .run();
  } else {
    await env.DB.prepare(`
      UPDATE tasks
      SET
        due_at = ?,
        duration_minutes = ?,
        status = ?,
        updated_at = ?
      WHERE id = ? AND user_id = ?
    `)
      .bind(normalizedDueAt, normalizedDuration, effectiveStatus, historyStamp, taskId, String(userId))
      .run();
  }

  await addTaskHistory(env, {
    userId: String(userId),
    taskId,
    eventType: 'schedule_changed',
    payload: {
      previous_due_at: existingTask && existingTask.due_at ? existingTask.due_at : null,
      next_due_at: normalizedDueAt,
      previous_status: existingTask && existingTask.status ? existingTask.status : null,
      next_status: effectiveStatus,
      previous_duration_minutes: existingTask ? normalizeDurationMinutes(existingTask.duration_minutes) : null,
      next_duration_minutes: normalizedDuration === undefined ? normalizeDurationMinutes(existingTask.duration_minutes) : normalizedDuration
    },
    createdAt: historyStamp
  });

  return getTaskById(env, { taskId, userId: String(userId) });
}

async function updateTaskMeta(env, { taskId, userId, title, taskProduct, description, projectName, priorityManual, durationMinutes, plannedMinutesManual, actualMinutes, showInMonth = undefined, spaceKey = undefined, telegramNotifyType = undefined, remindAt = undefined, recurrenceType, recurrenceRule, recurrenceEnabled }) {
  const previousTask = await getTaskById(env, { taskId, userId: String(userId) });
  if (!previousTask) throw new Error("Task not found");

  const sets = [];
  const values = [];
  const historyPayload = {};

  function pushChange(column, historyKey, fromValue, toValue) {
    if (fromValue === toValue) return;
    sets.push(column + ' = ?');
    values.push(toValue);
    historyPayload[historyKey] = { from: fromValue, to: toValue };
  }

  if (title !== undefined) {
    const nextTitle = String(title || "").trim();
    if (!nextTitle) throw new Error("title is required");
    pushChange('title', 'title', previousTask && previousTask.title ? String(previousTask.title).trim() : null, nextTitle);
  }

  if (taskProduct !== undefined) {
    const nextTaskProduct = taskProduct ? String(taskProduct).trim() : null;
    const previousTaskProduct = previousTask && previousTask.task_product ? String(previousTask.task_product).trim() : null;
    pushChange('task_product', 'task_product', previousTaskProduct, nextTaskProduct);
  }

  if (description !== undefined) {
    const nextDescription = description ? String(description).trim() : null;
    const previousDescription = previousTask && previousTask.description ? String(previousTask.description).trim() : null;
    pushChange('description', 'description', previousDescription, nextDescription);
  }

  if (projectName !== undefined) {
    const nextProjectName = normalizeProjectNameServer(projectName);
    const previousProjectName = normalizeProjectNameServer(previousTask && previousTask.project_name ? previousTask.project_name : 'Без проекта');
    pushChange('project_name', 'project_name', previousProjectName, nextProjectName);
  }

  if (priorityManual !== undefined) {
    const nextPriority = priorityManual === null || priorityManual === '' ? null : Number(priorityManual);
    const normalizedNextPriority = Number.isFinite(nextPriority) ? nextPriority : null;
    const previousPriority = previousTask && previousTask.priority_manual != null ? Number(previousTask.priority_manual) : null;
    pushChange('priority_manual', 'priority_manual', previousPriority, normalizedNextPriority);
  }

  if (durationMinutes !== undefined) {
    const nextDuration = normalizeDurationMinutes(durationMinutes) ?? DEFAULT_EVENT_DURATION_FOR_SERVER();
    const previousDuration = normalizeDurationMinutes(previousTask && previousTask.duration_minutes) ?? DEFAULT_EVENT_DURATION_FOR_SERVER();
    pushChange('duration_minutes', 'duration_minutes', previousDuration, nextDuration);
  }

  if (plannedMinutesManual !== undefined) {
    const nextPlannedMinutes = normalizeOptionalTaskMinutes(plannedMinutesManual);
    const previousPlannedMinutes = normalizeOptionalTaskMinutes(previousTask && previousTask.planned_minutes_manual);
    pushChange('planned_minutes_manual', 'planned_minutes_manual', previousPlannedMinutes, nextPlannedMinutes);
  }

  if (actualMinutes !== undefined) {
    const nextActualMinutes = normalizeOptionalTaskMinutes(actualMinutes);
    const previousActualMinutes = normalizeOptionalTaskMinutes(previousTask && previousTask.actual_minutes);
    pushChange('actual_minutes', 'actual_minutes', previousActualMinutes, nextActualMinutes);
  }

  if (showInMonth !== undefined) {
    const nextShowInMonth = normalizeShowInMonthValue(showInMonth);
    const previousShowInMonth = normalizeShowInMonthValue(previousTask && previousTask.show_in_month);
    pushChange('show_in_month', 'show_in_month', previousShowInMonth, nextShowInMonth);
  }

  if (spaceKey !== undefined) {
    const nextSpaceKey = normalizeTaskSpaceKey(spaceKey);
    const previousSpaceKey = normalizeTaskSpaceKey(previousTask && previousTask.space_key);
    pushChange('space_key', 'space_key', previousSpaceKey, nextSpaceKey);
  }

  if (telegramNotifyType !== undefined) {
    const nextTelegramNotifyType = normalizeTelegramNotifyType(telegramNotifyType);
    const previousTelegramNotifyType = normalizeTelegramNotifyType(previousTask && previousTask.telegram_notify_type);
    pushChange('telegram_notify_type', 'telegram_notify_type', previousTelegramNotifyType, nextTelegramNotifyType);
  }

  if (remindAt !== undefined) {
    const nextRemindAt = remindAt ? normalizeIsoDateTime(remindAt) : null;
    const previousRemindAt = previousTask && previousTask.remind_at ? normalizeIsoDateTime(previousTask.remind_at) : null;
    pushChange('remind_at', 'remind_at', previousRemindAt, nextRemindAt);
  }

  const previousRecurrenceType = normalizeRecurrenceType(previousTask && previousTask.recurrence_type);
  const previousRecurrenceRule = previousTask && previousTask.recurrence_rule ? String(previousTask.recurrence_rule).trim() : null;
  const previousRecurrenceEnabled = normalizeRecurrenceEnabled(previousRecurrenceType, previousTask && previousTask.recurrence_enabled);

  const nextRecurrenceTypeCandidate = recurrenceType !== undefined ? normalizeRecurrenceType(recurrenceType) : previousRecurrenceType;
  const nextRecurrenceRuleCandidate = recurrenceRule !== undefined ? (recurrenceRule ? String(recurrenceRule).trim() : null) : previousRecurrenceRule;
  const nextRecurrenceEnabledCandidate = (recurrenceEnabled !== undefined || recurrenceType !== undefined)
    ? normalizeRecurrenceEnabled(nextRecurrenceTypeCandidate, recurrenceEnabled)
    : previousRecurrenceEnabled;

  if (recurrenceType !== undefined) {
    pushChange('recurrence_type', 'recurrence_type', previousRecurrenceType, nextRecurrenceTypeCandidate);
  }

  if (recurrenceRule !== undefined) {
    pushChange('recurrence_rule', 'recurrence_rule', previousRecurrenceRule, nextRecurrenceRuleCandidate);
  }

  if (recurrenceEnabled !== undefined || recurrenceType !== undefined) {
    pushChange('recurrence_enabled', 'recurrence_enabled', previousRecurrenceEnabled, nextRecurrenceEnabledCandidate);
  }

  if (!sets.length) return previousTask;

  sets.push('updated_at = ?');
  values.push(new Date().toISOString());
  values.push(taskId, String(userId));

  const historyStamp = new Date().toISOString();
  await env.DB.prepare(`
    UPDATE tasks
    SET ${sets.join(', ')}
    WHERE id = ? AND user_id = ?
  `)
    .bind(...values)
    .run();

  await addTaskHistory(env, {
    userId: String(userId),
    taskId,
    eventType: 'meta_changed',
    payload: historyPayload,
    createdAt: historyStamp
  });

  return getTaskById(env, { taskId, userId: String(userId) });
}

async function deleteTaskRecord(env, { taskId, userId }) {
  const normalizedUserId = String(userId);
  const existingTask = await getTaskById(env, { taskId, userId: normalizedUserId });
  if (!existingTask) throw new Error("Task not found");

  const seriesId = getTaskSeriesId(existingTask);
  const startIndex = getTaskRecurrenceIndex(existingTask);

  let taskIdsToDelete = [taskId];
  if (seriesId) {
    const rows = await env.DB.prepare(`
      SELECT id
      FROM tasks
      WHERE user_id = ? AND recurrence_series_id = ? AND recurrence_index >= ?
      ORDER BY recurrence_index ASC
    `)
      .bind(normalizedUserId, seriesId, startIndex)
      .all();
    const ids = (rows.results || []).map((row) => row.id).filter(Boolean);
    if (ids.length) taskIdsToDelete = ids;
  }

  for (const currentTaskId of taskIdsToDelete) {
    const historyTask = await getTaskById(env, { taskId: currentTaskId, userId: normalizedUserId });
    await addTaskHistory(env, {
      userId: normalizedUserId,
      taskId: currentTaskId,
      eventType: 'deleted',
      payload: { title: historyTask && historyTask.title ? historyTask.title : null, status: historyTask && historyTask.status ? historyTask.status : null },
      createdAt: new Date().toISOString()
    });
    await deleteTaskArtifacts(env, { taskId: currentTaskId, userId: normalizedUserId });
  }

  return { deleted: true, taskId, deleted_task_ids: taskIdsToDelete };
}

async function deleteTaskArtifacts(env, { taskId, userId }) {
  // OPT-1 stage326: batch 3 sequential DELETEs → 1 round-trip
  const normalizedUserId = String(userId);
  await env.DB.batch([
    env.DB.prepare(`DELETE FROM task_checklist WHERE task_id = ? AND user_id = ?`).bind(taskId, normalizedUserId),
    env.DB.prepare(`DELETE FROM task_dependencies WHERE user_id = ? AND (task_id = ? OR blocked_by_task_id = ?)`).bind(normalizedUserId, taskId, taskId),
    env.DB.prepare(`DELETE FROM tasks WHERE id = ? AND user_id = ?`).bind(taskId, normalizedUserId),
  ]);
}

async function deleteSingleTaskRecord(env, { taskId, userId }) {
  const normalizedUserId = String(userId);
  const existingTask = await getTaskById(env, { taskId, userId: normalizedUserId });
  if (!existingTask) throw new Error('Task not found');
  await addTaskHistory(env, {
    userId: normalizedUserId,
    taskId,
    eventType: 'deleted',
    payload: { title: existingTask && existingTask.title ? existingTask.title : null, status: existingTask && existingTask.status ? existingTask.status : null },
    createdAt: new Date().toISOString()
  });
  await deleteTaskArtifacts(env, { taskId, userId: normalizedUserId });
  return { deleted: true, taskId, deleted_task_ids: [taskId] };
}

async function detachTaskFromRecurringSeries(env, { taskId, userId }) {
  const normalizedUserId = String(userId);
  const existingTask = await getTaskById(env, { taskId, userId: normalizedUserId });
  if (!existingTask) throw new Error('Task not found');

  const seriesId = getTaskSeriesId(existingTask);
  const hasRecurrenceShape = isTaskRecurringInstance(existingTask);
  if (!seriesId && !hasRecurrenceShape) return existingTask;

  const previousParentId = existingTask.recurrence_parent_task_id || null;
  if (seriesId) {
    let childRow = await env.DB.prepare(`
      SELECT id
      FROM tasks
      WHERE user_id = ? AND recurrence_series_id = ? AND recurrence_parent_task_id = ?
      ORDER BY recurrence_index ASC
      LIMIT 1
    `)
      .bind(normalizedUserId, seriesId, taskId)
      .first();

    if (!childRow) {
      childRow = await env.DB.prepare(`
        SELECT id
        FROM tasks
        WHERE user_id = ? AND recurrence_series_id = ? AND recurrence_index > ?
        ORDER BY recurrence_index ASC
        LIMIT 1
      `)
        .bind(normalizedUserId, seriesId, getTaskRecurrenceIndex(existingTask))
        .first();
    }

    if (childRow && childRow.id) {
      await env.DB.prepare(`
        UPDATE tasks
        SET recurrence_parent_task_id = ?, updated_at = ?
        WHERE id = ? AND user_id = ?
      `)
        .bind(previousParentId, new Date().toISOString(), childRow.id, normalizedUserId)
        .run();
    }
  }

  const now = new Date().toISOString();
  await env.DB.prepare(`
    UPDATE tasks
    SET
      recurrence_type = NULL,
      recurrence_rule = NULL,
      recurrence_enabled = 0,
      recurrence_series_id = NULL,
      recurrence_parent_task_id = NULL,
      recurrence_index = 0,
      updated_at = ?
    WHERE id = ? AND user_id = ?
  `)
    .bind(now, taskId, normalizedUserId)
    .run();

  await addTaskHistory(env, {
    userId: normalizedUserId,
    taskId,
    eventType: 'recurrence_detached',
    payload: {
      scope: 'current_only',
      previous_recurrence_type: existingTask.recurrence_type || null,
      previous_recurrence_rule: existingTask.recurrence_rule || null,
      previous_recurrence_series_id: existingTask.recurrence_series_id || null,
      previous_recurrence_index: getTaskRecurrenceIndex(existingTask)
    },
    createdAt: now
  });

  return getTaskById(env, { taskId, userId: normalizedUserId });
}

async function applyTaskEditorStateServer(env, {
  taskId,
  userId,
  title,
  taskProduct,
  description,
  projectName,
  priorityManual,
  durationMinutes,
  plannedMinutesManual,
  actualMinutes,
  showInMonth,
  spaceKey,
  recurrenceType,
  recurrenceRule,
  recurrenceEnabled,
  status,
  dueAt,
  syncSeries = false,
}) {
  const normalizedUserId = String(userId);
  let currentTask = await getTaskById(env, { taskId, userId: normalizedUserId });
  if (!currentTask) throw new Error('Task not found');

  const nextProjectName = projectName === undefined ? undefined : normalizeProjectNameServer(projectName);
  currentTask = await updateTaskMeta(env, {
    taskId,
    userId: normalizedUserId,
    title,
    taskProduct,
    description,
    projectName: nextProjectName,
    priorityManual,
    durationMinutes,
    plannedMinutesManual,
    actualMinutes,
    showInMonth,
    spaceKey,
    remindAt: currentTask ? currentTask.remind_at : undefined,
    recurrenceType,
    recurrenceRule,
    recurrenceEnabled,
  });

  const nextStatus = status == null ? normalizeStatus(currentTask.status) : normalizeStatus(status);
  if (!nextStatus) throw new Error('Valid status is required');

  if (nextStatus === TASK_STATUSES.PLANNED) {
    if (dueAt === null || dueAt === undefined || dueAt === '') {
      throw new Error('Для статуса «В плане» нужно выбрать дату и время');
    }
    currentTask = await updateTaskSchedule(env, {
      taskId,
      userId: normalizedUserId,
      dueAt,
      nextStatus: TASK_STATUSES.PLANNED,
      durationMinutes,
    });
  } else if (nextStatus === TASK_STATUSES.POSTPONED) {
    currentTask = await updateTaskSchedule(env, {
      taskId,
      userId: normalizedUserId,
      dueAt: null,
      nextStatus: TASK_STATUSES.POSTPONED,
      durationMinutes,
    });
  } else {
    currentTask = await updateTaskStatus(env, {
      taskId,
      userId: normalizedUserId,
      nextStatus,
    });
  }

  if (syncSeries) {
    currentTask = await syncRecurringSeriesFromTask(env, { taskId, userId: normalizedUserId, _debugCaller: 'applyTaskEditorStateServer' });
  }

  if (nextProjectName) {
    await upsertProjectRecord(env, { userId: normalizedUserId, name: nextProjectName });
  }

  return currentTask;
}

async function replaceChecklistFromTemplateTask(env, { sourceTaskId, targetTaskId, userId }) {
  const normalizedUserId = String(userId);
  const sourceItems = await listChecklistItems(env, { taskId: sourceTaskId, userId: normalizedUserId });
  await env.DB.prepare(`DELETE FROM task_checklist WHERE task_id = ? AND user_id = ?`).bind(targetTaskId, normalizedUserId).run();
  const now = new Date().toISOString();
  for (const item of sourceItems) {
    const text = String(item.text || '').trim();
    if (!text) continue;
    await env.DB.prepare(`
      INSERT INTO task_checklist (id, task_id, user_id, text, is_done, linked_task_id, created_at, updated_at)
      VALUES (?, ?, ?, ?, 0, NULL, ?, ?)
    `)
      .bind(crypto.randomUUID(), targetTaskId, normalizedUserId, text, now, now)
      .run();
  }
}

async function deleteTasksByIds(env, { userId, taskIds }) {
  const normalizedUserId = String(userId);
  for (const currentTaskId of taskIds || []) {
    await deleteTaskArtifacts(env, { taskId: currentTaskId, userId: normalizedUserId });
  }
}

async function syncRecurringSeriesFromTask(env, { taskId, userId, _debugCaller }) {
  // STAGE 337 DEBUG: track who called sync, how many rows wanted vs created
  const _syncDebugCaller = String(_debugCaller || 'unknown');
  const _syncStartMs = Date.now();

  const normalizedUserId = String(userId);
  let anchorTask = await getTaskById(env, { taskId, userId: normalizedUserId });
  if (!anchorTask) throw new Error('Task not found');

  let seriesId = getTaskSeriesId(anchorTask);
  const anchorIndex = getTaskRecurrenceIndex(anchorTask);
  if (shouldMaterializeRecurrence(anchorTask) && !seriesId) {
    seriesId = anchorTask.id;
    await env.DB.prepare(`
      UPDATE tasks
      SET recurrence_series_id = ?, recurrence_parent_task_id = NULL, recurrence_index = COALESCE(recurrence_index, 0), updated_at = ?
      WHERE id = ? AND user_id = ?
    `)
      .bind(seriesId, new Date().toISOString(), anchorTask.id, normalizedUserId)
      .run();
    anchorTask = await getTaskById(env, { taskId, userId: normalizedUserId });
  }

  if (!seriesId) {
    // STAGE 337 DEBUG: anchor has no series — nothing to materialise
    console.log('[stage337][syncRecurring] caller=' + _syncDebugCaller + ' taskId=' + taskId + ' no_series_id — skipped');
    return anchorTask;
  }

  const existingFutureRows = await env.DB.prepare(`
    SELECT ${TASK_SELECT_FIELDS}
    FROM tasks
    WHERE user_id = ? AND recurrence_series_id = ? AND recurrence_index > ?
    ORDER BY recurrence_index ASC
  `)
    .bind(normalizedUserId, seriesId, anchorIndex)
    .all();
  const existingFuture = existingFutureRows.results || [];

  if (!shouldMaterializeRecurrence(anchorTask)) {
    // STAGE 337 DEBUG: recurrence disabled — cleaning up future occurrences
    console.log('[stage337][syncRecurring] caller=' + _syncDebugCaller + ' taskId=' + taskId + ' series=' + seriesId + ' recurrence_disabled — deleting ' + existingFuture.length + ' future rows');
    await deleteTasksByIds(env, { userId: normalizedUserId, taskIds: existingFuture.map((row) => row.id) });
    return getTaskById(env, { taskId, userId: normalizedUserId });
  }

  const horizonCount = getRecurrenceHorizonCount(anchorTask.recurrence_type);

  // STAGE 337 DEBUG: log sync start state
  console.log('[stage337][syncRecurring] caller=' + _syncDebugCaller + ' taskId=' + taskId + ' series=' + seriesId + ' anchorIndex=' + anchorIndex + ' type=' + anchorTask.recurrence_type + ' wantedOccurrences=' + horizonCount + ' existingFutureCount=' + existingFuture.length);

  let cursorDueAt = anchorTask.due_at;
  let parentTaskId = anchorTask.id;
  const now = new Date().toISOString();
  const keptIds = [];
  let _countUpdated = 0;
  let _countCreated = 0;

  for (let step = 1; step <= horizonCount; step += 1) {
    const nextDueAt = computeNextOccurrenceDueAt(cursorDueAt, anchorTask.recurrence_type, anchorTask.recurrence_rule);
    if (!nextDueAt) break;
    const targetIndex = anchorIndex + step;
    const existing = existingFuture[step - 1] || null;

    if (existing) {
      await env.DB.prepare(`
        UPDATE tasks
        SET
          title = ?,
          task_product = ?,
          description = ?,
          status = ?,
          priority_manual = ?,
          project_name = ?,
          due_at = ?,
          duration_minutes = ?,
          planned_minutes_manual = ?,
          show_in_month = ?,
          space_key = ?,
          source = ?,
          recurrence_type = ?,
          recurrence_rule = ?,
          recurrence_enabled = ?,
          recurrence_series_id = ?,
          recurrence_parent_task_id = ?,
          recurrence_index = ?,
          updated_at = ?
        WHERE id = ? AND user_id = ?
      `)
        .bind(
          anchorTask.title,
          anchorTask.task_product || null,
          anchorTask.description || null,
          TASK_STATUSES.PLANNED,
          anchorTask.priority_manual ?? null,
          anchorTask.project_name || 'Без проекта',
          nextDueAt,
          normalizeDurationMinutes(anchorTask.duration_minutes) ?? DEFAULT_EVENT_DURATION_FOR_SERVER(),
          normalizeOptionalTaskMinutes(anchorTask.planned_minutes_manual),
          normalizeShowInMonthValue(anchorTask.show_in_month),
          normalizeTaskSpaceKey(anchorTask.space_key),
          anchorTask.source || 'web-app',
          anchorTask.recurrence_type || null,
          anchorTask.recurrence_rule || null,
          Number(anchorTask.recurrence_enabled || 0),
          seriesId,
          parentTaskId,
          targetIndex,
          now,
          existing.id,
          normalizedUserId
        )
        .run();
      await replaceChecklistFromTemplateTask(env, { sourceTaskId: anchorTask.id, targetTaskId: existing.id, userId: normalizedUserId });
      keptIds.push(existing.id);
      parentTaskId = existing.id;
      _countUpdated += 1;
    } else {
      const newTaskId = crypto.randomUUID();
      console.log('[stage337][syncRecurring] INSERT occurrence step=' + step + ' targetIndex=' + targetIndex + ' candidate=' + newTaskId + ' due=' + nextDueAt + ' series=' + seriesId);
      // Stage340: use guard instead of direct insertTask to prevent duplicates
      const occurrencePayload = {
        id: newTaskId,
        user_id: normalizedUserId,
        title: anchorTask.title,
        task_product: anchorTask.task_product || null,
        description: anchorTask.description || null,
        status: TASK_STATUSES.PLANNED,
        priority_manual: anchorTask.priority_manual ?? null,
        priority_ai: null,
        project_name: anchorTask.project_name || 'Без проекта',
        due_at: nextDueAt,
        duration_minutes: normalizeDurationMinutes(anchorTask.duration_minutes) ?? DEFAULT_EVENT_DURATION_FOR_SERVER(),
        planned_minutes_manual: normalizeOptionalTaskMinutes(anchorTask.planned_minutes_manual),
        show_in_month: normalizeShowInMonthValue(anchorTask.show_in_month),
        space_key: normalizeTaskSpaceKey(anchorTask.space_key),
        remind_at: null,
        source: anchorTask.source || 'web-app',
        ai_priority_reason: null,
        ai_project_guess: null,
        ai_next_step: null,
        recurrence_type: anchorTask.recurrence_type || null,
        recurrence_rule: anchorTask.recurrence_rule || null,
        recurrence_enabled: Number(anchorTask.recurrence_enabled || 0),
        recurrence_series_id: seriesId,
        recurrence_parent_task_id: parentTaskId,
        recurrence_index: targetIndex,
        created_at: now,
        updated_at: now,
      };
      const insertResult = await insertRecurringOccurrenceIfMissing_(env, occurrencePayload);
      const actualTaskId = insertResult.id;
      await replaceChecklistFromTemplateTask(env, { sourceTaskId: anchorTask.id, targetTaskId: actualTaskId, userId: normalizedUserId });
      keptIds.push(actualTaskId);
      parentTaskId = actualTaskId;
      if (insertResult.created) {
        _countCreated += 1;
      } else {
        // existing occurrence reused — not a new creation
        _countUpdated += 1;
      }
    }

    cursorDueAt = nextDueAt;
  }

  const extraFutureIds = existingFuture.slice(keptIds.length).map((row) => row.id);
  if (extraFutureIds.length) {
    // STAGE 337 DEBUG: extra future rows being deleted (orphans beyond horizon)
    console.log('[stage337][syncRecurring] deleting ' + extraFutureIds.length + ' extra future rows beyond horizon series=' + seriesId);
    await deleteTasksByIds(env, { userId: normalizedUserId, taskIds: extraFutureIds });
  }

  // STAGE 337 DEBUG: summary
  const _elapsed = Date.now() - _syncStartMs;
  console.log('[stage337][syncRecurring] DONE caller=' + _syncDebugCaller + ' series=' + seriesId + ' wanted=' + horizonCount + ' existing=' + existingFuture.length + ' created=' + _countCreated + ' updated=' + _countUpdated + ' deletedExtra=' + extraFutureIds.length + ' ms=' + _elapsed);

  return getTaskById(env, { taskId, userId: normalizedUserId });
}

async function listChecklistItems(env, { taskId, userId }) {
  const result = await env.DB.prepare(`
    SELECT id, task_id, user_id, text, is_done, linked_task_id, created_at, updated_at
    FROM task_checklist
    WHERE task_id = ? AND user_id = ?
    ORDER BY created_at ASC
  `).bind(taskId, String(userId)).all();
  return result.results || [];
