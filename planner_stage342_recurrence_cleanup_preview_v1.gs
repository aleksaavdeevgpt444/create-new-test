}

function normalizeJsonSchemaForWorkersAi(schema) {
  if (Array.isArray(schema)) return schema.map(normalizeJsonSchemaForWorkersAi);
  if (!(schema && typeof schema === 'object')) return schema;
  const output = {};
  Object.keys(schema).forEach((key) => {
    const value = schema[key];
    if (key === 'type' && typeof value === 'string') {
      output[key] = value.toLowerCase();
      return;
    }
    output[key] = normalizeJsonSchemaForWorkersAi(value);
  });
  return output;
}

function buildGeminiJsonRequest(prompt, schema, temperature) {
  return {
    contents: [{ parts: [{ text: String(prompt || '').trim() }] }],
    generationConfig: {
      response_mime_type: 'application/json',
      response_schema: normalizeJsonSchemaForWorkersAi(schema || {}),
      temperature: Number.isFinite(Number(temperature)) ? Number(temperature) : 0.2,
    },
  };
}

function buildGroqJsonPrompt(prompt, schema) {
  return [
    String(prompt || '').trim(),
    '',
    'Верни только один JSON-объект без markdown и без пояснений.',
    'Он должен максимально соответствовать этой JSON-схеме:',
    JSON.stringify(schema || {}, null, 2)
  ].join('\n');
}

function tryExtractJsonPayload(value) {
  if (value === null || value === undefined) return null;
  if (typeof value === 'string') {
    let safe = String(value || '').trim();
    if (!safe) return null;
    safe = safe.replace(/^```(?:json)?\s*/i, '').replace(/```$/i, '').trim();
    const direct = tryParseJsonSafe(safe);
    if (direct) return direct;
    const objectMatch = safe.match(/\{[\s\S]*\}$/);
    if (objectMatch) return tryParseJsonSafe(objectMatch[0]);
    return null;
  }
  if (Array.isArray(value)) return null;
  if (typeof value === 'object') return value;
  return null;
}

function extractGroqMessageContent(data) {
  return data?.choices?.[0]?.message?.content || data?.output_text || data?.text || '';
}

function normalizeGroqJsonResult(raw) {
  const direct = tryExtractJsonPayload(raw);
  if (direct && typeof direct === 'object' && !Array.isArray(direct)) return direct;
  throw new Error('Qwen returned invalid JSON');
}

function createAiTimeoutError(providerLabel, timeoutMs) {
  const error = new Error(String(providerLabel || 'AI') + ' timeout after ' + String(timeoutMs) + 'ms');
  error.name = 'AbortError';
  return error;
}

async function fetchWithAiTimeout(url, init, timeoutMs, providerLabel) {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => {
    try {
      controller.abort();
    } catch (abortError) {}
  }, timeoutMs);
  try {
    return await fetch(url, Object.assign({}, init || {}, { signal: controller.signal }));
  } catch (error) {
    if (error && error.name === 'AbortError') throw createAiTimeoutError(providerLabel, timeoutMs);
    throw error;
  } finally {
    clearTimeout(timeoutId);
  }
}

function getAiProviderMeta(value) {
  return value && value.__ai_provider_meta ? value.__ai_provider_meta : null;
}

function attachAiProviderMeta(target, meta) {
  if (!target || typeof target !== 'object' || Array.isArray(target) || !meta) return target;
  try {
    Object.defineProperty(target, '__ai_provider_meta', {
      value: meta,
      enumerable: false,
      configurable: true,
      writable: true,
    });
  } catch (error) {
    target.__ai_provider_meta = meta;
  }
  return target;
}

function attachAiProviderMetaFromSource(target, source) {
  return attachAiProviderMeta(target, getAiProviderMeta(source));
}

function normalizeAiProviderPayload(result, meta) {
  if (!(result && typeof result === 'object') || Array.isArray(result)) {
    throw new Error(String(meta && meta.label || 'AI') + ' returned invalid JSON');
  }
  if (!Object.keys(result).length) {
    throw new Error(String(meta && meta.label || 'AI') + ' returned empty response');
  }
  return attachAiProviderMeta(result, meta);
}

function classifyAiProviderError(error) {
  const message = String(error && error.message ? error.message : error || '').trim();
  const lower = message.toLowerCase();
  if ((error && error.name === 'AbortError') || lower.includes('timeout')) return { status: 'timeout', message: message || 'timeout' };
  if (!message) return { status: 'error', message: 'unknown error' };
  if (lower.includes('internal error encountered') || lower.includes('internal error') || lower.includes('service unavailable') || lower.includes('backend error') || lower.includes('503')) {
    return { status: 'provider_unavailable', message };
  }
  if (lower.includes('not configured') || lower.includes('missing api key') || lower.includes('api key')) return { status: 'not_configured', message };
  if (lower.includes('daily free allocation') || lower.includes('free allocation') || lower.includes('quota exceeded') || lower.includes('resource_exhausted') || lower.includes('resource exhausted') || lower.includes('free_tier_requests')) {
    return { status: 'quota_exceeded', message };
  }
  if (lower.includes('rate limit') || lower.includes('too many requests') || lower.includes('429')) return { status: 'rate_limited', message };
  if (lower.includes('empty response') || lower.includes('empty text') || lower.includes('returned empty')) return { status: 'empty_response', message };
  if (lower.includes('invalid json') || lower.includes('malformed json')) return { status: 'invalid_response', message };
  return { status: 'error', message };
}

function formatAiFallbackReasonLabel(reason) {
  const safe = String(reason || '').trim().toLowerCase();
  if (!safe) return 'ошибка';
  if (safe === 'timeout') return 'таймаут';
  if (safe === 'quota_exceeded') return 'квота';
  if (safe === 'rate_limited') return 'лимит частоты';
  if (safe === 'empty_response') return 'пустой ответ';
  if (safe === 'invalid_response') return 'некорректный JSON';
  if (safe === 'provider_unavailable') return 'провайдер временно недоступен';
  if (safe === 'not_configured') return 'не настроен';
  return safe.replace(/_/g, ' ');
}

