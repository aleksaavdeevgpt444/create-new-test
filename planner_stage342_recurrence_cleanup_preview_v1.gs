async function handleTelegramAuthApi(request, env) {
  if (request.method !== "POST") return textResponse("Method Not Allowed", 405);

  let body = null;
  try {
    body = await request.json();
    const initDataRaw = body?.init_data;
    const validation = await validateTelegramInitData(initDataRaw, env.TELEGRAM_BOT_TOKEN);

    if (!validation.ok) {
      return jsonResponse({ ok: false, error: validation.error }, { status: 401 });
    }
    const session = await createUserSessionToken(env, {
      user_id: validation && validation.user && validation.user.id ? String(validation.user.id) : '',
      username: validation && validation.user && validation.user.username ? String(validation.user.username) : null,
      auth_mode: 'telegram'
    });
    const headers = new Headers();
    headers.append('set-cookie', buildUserSessionCookieValue(request, session.token, USER_SESSION_MAX_AGE_SEC));
    return jsonResponse({
      ok: true,
      auth: validation,
      session: {
        token: session.token,
        user_id: session.payload && session.payload.uid ? String(session.payload.uid) : '',
        auth_mode: session.payload && session.payload.auth_mode ? String(session.payload.auth_mode) : 'telegram',
        expires_at: session.expires_at,
        issued_at: session.payload && session.payload.iat ? new Date(session.payload.iat * 1000).toISOString() : null
      }
    }, { headers });
  } catch (error) {
    return jsonResponse({ ok: false, error: String(error) }, { status: 500 });
  }
}

async function handleUserSessionStatusApi(request, env) {
  if (request.method !== 'GET') return textResponse('Method Not Allowed', 405);
  const session = await resolveUserSessionContext(request, env);
  if (!session.ok) {
    return jsonResponse({
      ok: false,
      has_session: false,
      strict_mode: isUserSessionStrictModeEnabled(env),
      reason: String(session && session.error || (session && session.token_present ? 'invalid_session' : 'missing_session'))
    }, { status: 401 });
  }
  const payload = session.payload || {};
  const expiresAtIso = payload && payload.exp ? new Date(Number(payload.exp) * 1000).toISOString() : null;
  const issuedAtIso = payload && payload.iat ? new Date(Number(payload.iat) * 1000).toISOString() : null;
  const headers = new Headers();
  if (session.token) {
    const remainingSec = Math.max(60, Number(payload.exp || 0) - Math.floor(Date.now() / 1000));
    headers.append('set-cookie', buildUserSessionCookieValue(request, session.token, remainingSec));
  }
  return jsonResponse({
    ok: true,
    has_session: true,
    session: {
      token: session.token || '',
      user_id: session.user_id ? String(session.user_id) : '',
      auth_mode: payload && payload.auth_mode ? String(payload.auth_mode) : 'session',
      username: payload && payload.username ? String(payload.username) : null,
      expires_at: expiresAtIso,
      issued_at: issuedAtIso
    }
  }, { headers });
}

