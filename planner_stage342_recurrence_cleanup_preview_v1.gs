          clearTaskTemplateForm();
          showSuccess('Шаблон задачи сохранён.');
        } catch (error) {
          showError(String(error && error.message ? error.message : error));
        }
      }

      function deleteTaskTemplate(templateId) {
        var key = String(templateId || '').trim();
        if (!key) return;
        state.taskTemplates = (state.taskTemplates || []).filter(function (item) { return String(item.id) !== key; });
        saveStoredTaskTemplates();
        renderTemplatesView();
        showSuccess('Шаблон удалён.');
      }

      async function createTaskFromTemplate(templateId, mode) {
        var key = String(templateId || '').trim();
        var template = (state.taskTemplates || []).find(function (item) { return String(item.id) === key; });
        if (!template) { showError('Не удалось найти шаблон.'); return; }
        if (!state.userId) { showError('Сначала укажи user_id.'); return; }
        showError('');
        try {
          var created = await requestJson('/tasks/create', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              user_id: state.userId,
              title: template.title,
              project_name: template.projectName || 'Без проекта',
              task_product: '',
              description: template.description || '',
              priority_manual: template.priorityManual || null,
              due_at: null,
              duration_minutes: Number(template.durationMinutes) || 30,
              source: 'template',
              recurrence_type: template.recurrenceType || null,
              recurrence_rule: template.recurrenceRule || null,
              recurrence_enabled: template.recurrenceEnabled ? 1 : 0
            })
          });
          var item = created && created.item ? created.item : null;
          if (!(item && item.id)) throw new Error('Сервер не вернул созданную задачу.');
          if (mode === 'today') {
            var targetDay = state.dayYmd || formatYmdLocal(new Date());
            var dueAtIso = getSuggestedTodaySlotIso(targetDay, Object.assign({}, item, { duration_minutes: Number(template.durationMinutes) || 30 }));
            await requestJson('/tasks/schedule', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                task_id: item.id,
                user_id: state.userId,
                due_at: dueAtIso,
                status: STATUS.PLANNED,
                duration_minutes: Number(template.durationMinutes) || 30
              })
            });
          } else if (mode === 'plan') {
            setInboxTaskStage(item.id, 'plan', { silent: true, skipRender: true });
          } else {
            setInboxTaskStage(item.id, 'new', { silent: true, skipRender: true });
          }
          await loadPlanner();
          setActiveView(mode === 'today' ? 'today' : (mode === 'plan' ? 'plan' : 'inbox'));
          showSuccess(mode === 'today' ? 'Задача создана из шаблона и поставлена в Today.' : 'Задача создана из шаблона.');
        } catch (error) {
          showError(String(error && error.message ? error.message : error));
        }
      }

      function collectDayBlockFormPayload() {
        var title = String((byId('dayBlockTitleInput') && byId('dayBlockTitleInput').value) || '').trim();
        if (!title) throw new Error('Укажи название блока дня.');
        var start = String((byId('dayBlockStartInput') && byId('dayBlockStartInput').value) || '').trim() || '09:00';
        var end = String((byId('dayBlockEndInput') && byId('dayBlockEndInput').value) || '').trim() || '10:00';
        var days = [];
        var container = byId('dayBlockWeekdays');
        if (container) {
          Array.prototype.forEach.call(container.querySelectorAll('input[type="checkbox"]'), function (input) { if (input.checked) days.push(String(input.value || '').trim().toUpperCase()); });
        }
        if (!days.length) throw new Error('Выбери хотя бы один день недели.');
        return normalizeDayBlockTemplate({
          title: title,
          startTime: start,
          endTime: end,
          days: days,
          kind: String((byId('dayBlockKindSelect') && byId('dayBlockKindSelect').value) || 'focus').trim().toLowerCase()
        });
      }

      function saveDayBlockFromForm() {
        try {
          var payload = collectDayBlockFormPayload();
          var editingId = String(state.editingDayBlockId || '').trim();
          if (editingId) {
            payload.id = editingId;
            state.dayBlockTemplates = (state.dayBlockTemplates || []).map(function (item) {
              return String(item && item.id || '') === editingId ? Object.assign({}, item, payload) : item;
            }).filter(Boolean);
          } else {
            state.dayBlockTemplates = [payload].concat((state.dayBlockTemplates || []).filter(Boolean));
          }
          state.dayBlockTemplates = (state.dayBlockTemplates || []).map(normalizeDayBlockTemplate).filter(Boolean).sort(function (a, b) { return a.startMinutes - b.startMinutes; }).slice(0, 42);
          saveStoredDayBlockTemplates();
          var finalize = function () {
            renderTemplatesView();
            hydrateDayBlockInstancesForVisibleRange({ silent: true }).finally(function () {
              renderTodayDayBlocks(state.dayYmd || formatYmdLocal(new Date()));
              renderWeekDayBlocksGuide();
              renderWeekInlineMetrics();
              clearDayBlockForm();
              showSuccess(editingId ? 'Блок дня обновлён.' : 'Блок дня сохранён.');
              if (state.editorTaskId) renderEditorFrameworkPanel(findTaskById(state.editorTaskId));
            });
          };
          if (state.userId) {
            persistDayBlockTemplateToServer(payload, { silent: true }).finally(finalize);
          } else {
            finalize();
          }
        } catch (error) {
          showError(String(error && error.message ? error.message : error));
        }
      }

      function deleteDayBlock(blockId) {
        var key = String(blockId || '').trim();
        if (!key) return;
        state.dayBlockTemplates = (state.dayBlockTemplates || []).filter(function (item) { return String(item.id) !== key; });
        if (String(state.editingDayBlockId || '').trim() === key) state.editingDayBlockId = '';
        saveStoredDayBlockTemplates();
        var finalize = function () {
          renderTemplatesView();
          hydrateDayBlockInstancesForVisibleRange({ silent: true }).finally(function () {
            renderTodayDayBlocks(state.dayYmd || formatYmdLocal(new Date()));
            renderWeekDayBlocksGuide();
            renderWeekInlineMetrics();
            syncDayBlockFormEditingUi();
            if (state.editorTaskId) renderEditorFrameworkPanel(findTaskById(state.editorTaskId));
            showSuccess('Блок дня удалён.');
          });
        };
        if (state.userId) {
          deleteDayBlockTemplateOnServer(key, { silent: true }).finally(finalize);
        } else {
          finalize();
        }
      }

      function setDayBlockPanelVisibility(panelId, visible) {
        var panel = byId(panelId);
        if (!panel) return;
        panel.style.display = visible ? '' : 'none';
      }

      function getDayBlockVisualClass(kind) {
        var key = String(kind || '').trim().toLowerCase();
        if (key === 'focus') return 'is-focus';
        if (key === 'meetings') return 'is-meetings';
        if (key === 'admin') return 'is-admin';
        if (key === 'personal') return 'is-personal';
        return '';
      }

      function taskIntersectsDayBlock(task, dayYmd, block) {
        if (!task || !task.due_at || !block) return false;
        var start = new Date(task.due_at);
        if (isNaN(start.getTime())) return false;
        if (formatYmdLocal(start) !== dayYmd) return false;
        var duration = Math.max(Number(getTaskDurationMinutes(task)) || DEFAULT_EVENT_DURATION_MIN, 5);
        var end = new Date(start.getTime() + duration * 60000);
        var taskStartMinutes = start.getHours() * 60 + start.getMinutes();
        var taskEndMinutes = end.getHours() * 60 + end.getMinutes();
        var renderWindow = getCalendarRenderWindowHours();
        var blockStartMinutes = Number(block.startMinutes) || (renderWindow.startHour * 60);
        var blockEndMinutes = Number(block.endMinutes) || (renderWindow.endHour * 60);
        return taskStartMinutes < blockEndMinutes && taskEndMinutes > blockStartMinutes;
      }

      function dayBlockHasScheduledTaskOverlap(dayYmd, block) {
        return getTasksForDay(dayYmd).some(function (task) {
          return taskIntersectsDayBlock(task, dayYmd, block);
        });
      }

      function createDayBlockOverlayElement(block, totalMinutes, baseClassName, options) {
        if (!block || !totalMinutes) return null;
        options = options || {};
        var renderWindow = getCalendarRenderWindowHours();
        var dayStartMinutes = renderWindow.startHour * 60;
        var dayEndMinutes = renderWindow.endHour * 60;
        var startMinutes = Math.max(Number(block.startMinutes) || dayStartMinutes, dayStartMinutes);
        var endMinutes = Math.min(Number(block.endMinutes) || dayEndMinutes, dayEndMinutes);
        if (endMinutes <= startMinutes) return null;
        var relativeStart = startMinutes - dayStartMinutes;
        var relativeDuration = endMinutes - startMinutes;
        var topPercent = (relativeStart / totalMinutes) * 100;
        var heightPercent = Math.max((relativeDuration / totalMinutes) * 100, 2.8);
        var visualClass = getDayBlockVisualClass(block.kind);
        var overlay = document.createElement('div');
        var hasScheduledOverlap = !!options.hasScheduledOverlap;
        var isCompact = relativeDuration <= 45;
        overlay.className = baseClassName
          + (visualClass ? ' ' + visualClass : '')
          + (hasScheduledOverlap ? ' is-occupied' : '')
          + (isCompact ? ' compact' : '');
        overlay.style.top = 'calc(' + topPercent + '% + 2px)';
        overlay.style.height = 'calc(' + heightPercent + '% - 6px)';
        overlay.title = (block.title || 'Блок дня') + ' · ' + block.startTime + '–' + block.endTime;
        var content = document.createElement('div');
        content.className = baseClassName + '-content';
        if (!isCompact) {
          var chip = document.createElement('div');
          chip.className = baseClassName + '-chip';
          chip.textContent = getDayBlockKindLabel(block.kind) + ' · ' + block.startTime + '–' + block.endTime;
          content.appendChild(chip);
        }
        var title = document.createElement('div');
        title.className = baseClassName + '-title';
        title.textContent = block.title || 'Блок дня';
        content.appendChild(title);
        if (!isCompact && relativeDuration >= 35 && !hasScheduledOverlap) {
          var note = document.createElement('div');
          note.className = baseClassName + '-note';
          note.textContent = 'Для задач: ' + (block.title || 'этого блока');
          content.appendChild(note);
        }
        overlay.appendChild(content);
        return overlay;
      }

      function renderTodayDayBlockOverlays(dayYmd) {
        var eventsLayer = byId('todayEventsLayer');
        if (!eventsLayer) return;
        var existing = byId('todayDayBlockOverlayLayer');
        if (existing && existing.parentNode) existing.parentNode.removeChild(existing);
        var settings = state.dayBlockSettings || getDefaultDayBlockSettings();
        if (!(settings.enabled && settings.showInToday)) return;
        var blocks = getMatchingDayBlocks(dayYmd);
        if (!blocks.length) return;
        var renderWindow = getCalendarRenderWindowHours();
        var totalMinutes = (renderWindow.endHour - renderWindow.startHour) * 60;
        var layer = document.createElement('div');
        layer.id = 'todayDayBlockOverlayLayer';
        layer.className = 'day-block-overlay-layer';
        blocks.forEach(function (block) {
          var overlay = createDayBlockOverlayElement(block, totalMinutes, 'day-block-overlay', {
            hasScheduledOverlap: dayBlockHasScheduledTaskOverlap(dayYmd, block)
          });
          if (overlay) layer.appendChild(overlay);
        });
        if (!layer.childNodes.length) return;
        eventsLayer.insertBefore(layer, eventsLayer.firstChild || null);
      }

      function appendWeekDayBlockOverlays(dayCol, dayYmd) {
        if (!dayCol) return;
        var settings = state.dayBlockSettings || getDefaultDayBlockSettings();
        if (!(settings.enabled && settings.showInWeek)) return;
        var blocks = getMatchingDayBlocks(dayYmd);
        if (!blocks.length) return;
        var renderWindow = getCalendarRenderWindowHours();
        var totalMinutes = (renderWindow.endHour - renderWindow.startHour) * 60;
        var layer = document.createElement('div');
        layer.className = 'calendar-day-block-overlay-layer';
        blocks.forEach(function (block) {
          var overlay = createDayBlockOverlayElement(block, totalMinutes, 'calendar-day-block-overlay', {
            hasScheduledOverlap: dayBlockHasScheduledTaskOverlap(dayYmd, block)
          });
          if (overlay) layer.appendChild(overlay);
        });
        if (!layer.childNodes.length) return;
        dayCol.appendChild(layer);
      }

      function renderTodayDayBlocks(dayYmd) {
        var container = byId('todayDayBlocksStrip');
        if (!container) return;
        var summaryHost = ensureTodayDayBlocksSummaryHost();
        container.innerHTML = '';
        if (summaryHost) {
          summaryHost.innerHTML = '';
          summaryHost.style.display = 'none';
        }
        var counter = byId('todayDayBlocksCount');
        if (counter) counter.textContent = '0';
        var settings = state.dayBlockSettings || getDefaultDayBlockSettings();
        if (!settings.enabled || !settings.showInToday) {
          container.classList.remove('is-visible');
          setDayBlockPanelVisibility('todayDayBlocksPanel', false);
          return;
        }
        var summary = getDayBlocksDaySummary(dayYmd);
        var blocks = summary.blocks || [];
        if (counter) counter.textContent = String(blocks.length || 0);
        if (!blocks.length) {
          container.classList.remove('is-visible');
          setDayBlockPanelVisibility('todayDayBlocksPanel', false);
          return;
        }
        setDayBlockPanelVisibility('todayDayBlocksPanel', true);
        if (summaryHost) {
          var temporal = getDayBlocksTemporalState(dayYmd, blocks);
          var statusText = temporal.currentBlock ? ('Сейчас: ' + temporal.currentBlock.title + ' · до ' + temporal.currentBlock.endTime) : (temporal.nextBlock ? ('Дальше: ' + temporal.nextBlock.title + ' · с ' + temporal.nextBlock.startTime) : 'Сегодня блоки уже завершены');
          summaryHost.appendChild(createDayBlocksSummaryStat(String(summary.blockCount), 'Блоков на день'));
          summaryHost.appendChild(createDayBlocksSummaryStat(statusText, 'Текущий ориентир'));
          summaryHost.appendChild(createDayBlocksSummaryStat(formatMinutesHoursLabel(summary.overlapMinutes), 'План внутри блоков'));
          summaryHost.appendChild(createDayBlocksSummaryStat(summary.overflowMinutes > 0 ? formatMinutesHoursLabel(summary.overflowMinutes) : formatMinutesHoursLabel(summary.freeMinutes), summary.overflowMinutes > 0 ? 'Перегруз блоков' : 'Свободно в блоках', summary.overflowMinutes > 0 ? 'danger' : (summary.outsideMinutes > 0 ? 'warning' : '')));
          if (summary.outsideCount > 0) summaryHost.appendChild(createDayBlocksSummaryStat(formatMinutesHoursLabel(summary.outsideMinutes), 'Вне блоков · ' + summary.outsideCount + ' задач', 'warning'));
          summaryHost.style.display = 'grid';
        }
        var now = new Date();
        var isCurrentDay = dayYmd === formatYmdLocal(now);
        var currentMinutes = now.getHours() * 60 + now.getMinutes();
        summary.bundles.forEach(function (bundle) {
          var block = bundle.block;
          var card = document.createElement('div');
          var toneClass = '';
          if (bundle.overflowMinutes > 0) toneClass += ' is-overflow';
          else if (bundle.taskCount === 0) toneClass += ' is-warning';
          if (isCurrentDay) {
            if (currentMinutes >= block.startMinutes && currentMinutes < block.endMinutes) toneClass += ' is-current';
            else if (currentMinutes < block.startMinutes) toneClass += ' is-upcoming';
            else toneClass += ' is-complete';
          }
          card.className = 'day-block-card' + toneClass;
          var time = document.createElement('div');
          time.className = 'day-block-time';
          time.textContent = block.startTime + '–' + block.endTime;
          var title = document.createElement('div');
          title.className = 'day-block-title';
          title.textContent = block.title;
          var meta = document.createElement('div');
          meta.className = 'day-block-meta';
          var kind = document.createElement('span');
          kind.className = 'day-block-chip';
          kind.textContent = getDayBlockKindLabel(block.kind);
          var duration = document.createElement('span');
          duration.className = 'day-block-chip';
          duration.textContent = 'Ёмкость: ' + formatMinutesHoursLabel(bundle.capacityMinutes);
          var taskCount = document.createElement('span');
          taskCount.className = 'day-block-chip';
          taskCount.textContent = bundle.taskCount ? ('Задач: ' + bundle.taskCount) : 'Пока пусто';
          meta.appendChild(kind);
          meta.appendChild(duration);
          meta.appendChild(taskCount);
          if (toneClass.indexOf('is-current') >= 0) { var live = document.createElement('span'); live.className = 'day-block-chip'; live.textContent = 'Сейчас'; meta.appendChild(live); }
          if (toneClass.indexOf('is-upcoming') >= 0) { var upcoming = document.createElement('span'); upcoming.className = 'day-block-chip'; upcoming.textContent = 'Дальше'; meta.appendChild(upcoming); }
          card.appendChild(time);
          card.appendChild(title);
          card.appendChild(meta);
          var detailGrid = document.createElement('div');
          detailGrid.className = 'day-block-detail-grid';
          detailGrid.appendChild(createDayBlockMetricItem(formatMinutesHoursLabel(bundle.overlapMinutes), 'План внутри блока'));
          detailGrid.appendChild(createDayBlockMetricItem(bundle.doneCount + ' / ' + bundle.taskCount, 'Выполнено / всего'));
          detailGrid.appendChild(createDayBlockMetricItem(bundle.overflowMinutes > 0 ? formatMinutesHoursLabel(bundle.overflowMinutes) : formatMinutesHoursLabel(bundle.freeMinutes), bundle.overflowMinutes > 0 ? 'Перегруз блока' : 'Свободно'));
          detailGrid.appendChild(createDayBlockMetricItem(bundle.linkedCount ? (bundle.linkedCount + ' · hard ' + bundle.hardLinkedCount) : 'Нет привязок', 'Связь задач с блоком'));
          card.appendChild(detailGrid);
          if (bundle.energyMismatchCount > 0 || bundle.kindMismatchCount > 0) {
            var warning = document.createElement('div');
            warning.className = 'field-help';
            var parts = [];
            if (bundle.energyMismatchCount > 0) parts.push('Energy mismatch: ' + bundle.energyMismatchCount);
            if (bundle.kindMismatchCount > 0) parts.push('Type mismatch: ' + bundle.kindMismatchCount);
            warning.textContent = parts.join(' · ');
            card.appendChild(warning);
          }
          var actions = document.createElement('div');
          actions.className = 'day-block-actions';
          var openDayBtn = document.createElement('button');
          openDayBtn.type = 'button';
          openDayBtn.className = 'btn-ghost';
          openDayBtn.textContent = 'Обновить день';
          openDayBtn.addEventListener('click', function () {
            state.dayYmd = dayYmd;
            renderTodayView();
          });
          actions.appendChild(openDayBtn);
          if (bundle.taskCount && bundle.tasks[0] && bundle.tasks[0].id) {
            var openTaskBtn = document.createElement('button');
            openTaskBtn.type = 'button';
            openTaskBtn.className = 'btn-secondary';
            openTaskBtn.textContent = 'Открыть задачу';
            openTaskBtn.addEventListener('click', function () { openEditor(bundle.tasks[0].id); });
            actions.appendChild(openTaskBtn);
          }
          card.appendChild(actions);
          container.appendChild(card);
        });
        container.classList.add('is-visible');
      }

      function renderWeekDayBlocksGuide() {
        var container = byId('weekDayBlocksGuide');
        if (!container) return;
        var summaryHost = ensureWeekDayBlocksSummaryHost();
        container.innerHTML = '';
        if (summaryHost) {
          summaryHost.innerHTML = '';
          summaryHost.style.display = 'none';
        }
        var counter = byId('weekDayBlocksCount');
        if (counter) counter.textContent = '0';
        var settings = state.dayBlockSettings || getDefaultDayBlockSettings();
        if (!settings.enabled || !settings.showInWeek) {
          setDayBlockPanelVisibility('weekDayBlocksCard', false);
          return;
        }
        var days = buildVisibleDays('week');
        if (!Array.isArray(days) || !days.length) {
          setDayBlockPanelVisibility('weekDayBlocksCard', false);
          return;
        }
        var totalBlocks = 0;
        var weekBlockMinutes = 0;
        var weekOverlapMinutes = 0;
        var weekOutsideMinutes = 0;
        var weekOverflowMinutes = 0;
        var daysWithWarnings = 0;
        var daysWithOverflow = 0;
        var todayYmd = formatYmdLocal(new Date());
        days.forEach(function (day) {
          var summary = getDayBlocksDaySummary(day.ymd);
          var blocks = summary.blocks;
          totalBlocks += blocks.length;
          weekBlockMinutes += summary.totalBlockMinutes;
          weekOverlapMinutes += summary.overlapMinutes;
          weekOutsideMinutes += summary.outsideMinutes;
          weekOverflowMinutes += summary.overflowMinutes;
          if (summary.tone === 'warning') daysWithWarnings += 1;
          if (summary.tone === 'overflow') daysWithOverflow += 1;

          var card = document.createElement('div');
          card.className = 'planner-day-block-day' + (day.ymd === todayYmd ? ' is-today' : '') + (summary.tone === 'warning' ? ' is-warning' : summary.tone === 'overflow' ? ' is-overflow' : '');

          var head = document.createElement('div');
          head.className = 'planner-day-block-head';

          var titleWrap = document.createElement('div');
          titleWrap.className = 'planner-day-block-title-wrap';
          var title = document.createElement('strong');
          title.textContent = day.label.split(',')[0];
          var sub = document.createElement('span');
          sub.textContent = formatDateShortDisplay(day.ymd);
          titleWrap.appendChild(title);
          titleWrap.appendChild(sub);

          var count = document.createElement('div');
          count.className = 'planner-day-block-count';
          count.textContent = blocks.length ? String(blocks.length) : '0';

          head.appendChild(titleWrap);
          head.appendChild(count);
          card.appendChild(head);

          var summaryGrid = document.createElement('div');
          summaryGrid.className = 'planner-day-block-day-summary';
          summaryGrid.appendChild(createPlannerDayBlockMeta(formatMinutesHoursLabel(summary.totalBlockMinutes), 'Ёмкость блоков'));
          summaryGrid.appendChild(createPlannerDayBlockMeta(formatMinutesHoursLabel(summary.overlapMinutes), 'План в блоках'));
          summaryGrid.appendChild(createPlannerDayBlockMeta(summary.overflowMinutes > 0 ? formatMinutesHoursLabel(summary.overflowMinutes) : formatMinutesHoursLabel(summary.freeMinutes), summary.overflowMinutes > 0 ? 'Перегруз блоков' : 'Свободно в блоках'));
          summaryGrid.appendChild(createPlannerDayBlockMeta(summary.outsideCount ? (String(summary.outsideCount) + ' задач') : '0 задач', summary.outsideCount ? ('Вне блоков · ' + formatMinutesHoursLabel(summary.outsideMinutes)) : 'Вне блоков нет'));
          card.appendChild(summaryGrid);

          var actions = document.createElement('div');
          actions.className = 'planner-day-block-actions';
          var openDayBtn = document.createElement('button');
          openDayBtn.type = 'button';
          openDayBtn.className = 'btn-secondary';
          openDayBtn.textContent = 'Открыть день';
          openDayBtn.addEventListener('click', function () { openDayInTodayView(day.ymd); });
          actions.appendChild(openDayBtn);
          var openWeekBtn = document.createElement('button');
          openWeekBtn.type = 'button';
          openWeekBtn.className = 'btn-secondary';
          openWeekBtn.textContent = 'Неделя';
          openWeekBtn.addEventListener('click', function () { openPlannerWeekViewSafe(); });
          actions.appendChild(openWeekBtn);
          card.appendChild(actions);

          var list = document.createElement('div');
          list.className = 'planner-day-block-list';
          if (!blocks.length) {
            var empty = document.createElement('div');
            empty.className = 'planner-day-block-item empty';
            empty.textContent = 'Нет блоков на этот день';
            list.appendChild(empty);
          } else {
            summary.bundles.forEach(function (bundle) {
              var block = bundle.block;
              var visualClass = getDayBlockVisualClass(block.kind);
              var item = document.createElement('div');
              item.className = 'planner-day-block-item' + (visualClass ? ' ' + visualClass : '') + (bundle.overflowMinutes > 0 ? ' is-admin' : '');

              var time = document.createElement('div');
              time.className = 'planner-day-block-item-time';
              time.textContent = block.startTime + '–' + block.endTime;

              var blockTitle = document.createElement('div');
              blockTitle.className = 'planner-day-block-item-title';
              blockTitle.textContent = block.title;

              var note = document.createElement('div');
              note.className = 'planner-day-block-item-note';
              note.textContent = bundle.taskCount ? ('Задач: ' + bundle.taskCount + ' · план: ' + formatMinutesHoursLabel(bundle.overlapMinutes) + (bundle.overflowMinutes > 0 ? (' · перегруз: ' + formatMinutesHoursLabel(bundle.overflowMinutes)) : (' · свободно: ' + formatMinutesHoursLabel(bundle.freeMinutes)))) : 'Блок пустой — можно использовать как свободное окно.';

              item.appendChild(time);
              item.appendChild(blockTitle);
              item.appendChild(note);
              list.appendChild(item);
            });
          }

          card.appendChild(list);
          container.appendChild(card);
        });
        if (summaryHost) {
          summaryHost.appendChild(createDayBlocksSummaryStat(String(totalBlocks || 0), 'Блоков на неделю'));
          summaryHost.appendChild(createDayBlocksSummaryStat(formatMinutesHoursLabel(weekBlockMinutes), 'Ёмкость блоков недели'));
          summaryHost.appendChild(createDayBlocksSummaryStat(formatMinutesHoursLabel(weekOverlapMinutes), 'План внутри блоков'));
          summaryHost.appendChild(createDayBlocksSummaryStat(weekOverflowMinutes > 0 ? formatMinutesHoursLabel(weekOverflowMinutes) : formatMinutesHoursLabel(Math.max(weekBlockMinutes - weekOverlapMinutes, 0)), weekOverflowMinutes > 0 ? 'Перегруз блоков' : 'Свободно в блоках', weekOverflowMinutes > 0 ? 'danger' : (weekOutsideMinutes > 0 ? 'warning' : '')));
          if (weekOutsideMinutes > 0) summaryHost.appendChild(createDayBlocksSummaryStat(formatMinutesHoursLabel(weekOutsideMinutes), 'План вне блоков · дней: ' + (daysWithWarnings + daysWithOverflow), 'warning'));
          summaryHost.style.display = 'grid';
        }
        if (counter) counter.textContent = String(totalBlocks || 0);
        setDayBlockPanelVisibility('weekDayBlocksCard', true);
      }

      function createTemplateSummaryCard(value, label) {
        var card = document.createElement('div');
        card.className = 'templates-summary-card';
        var strong = document.createElement('strong');
        strong.textContent = String(value || 0);
        var span = document.createElement('span');
        span.textContent = label;
        card.appendChild(strong);
        card.appendChild(span);
        return card;
      }

      function renderTemplatesView() {
        syncDayBlockFormEditingUi();
        var summary = byId('templatesSummaryGrid');
        var taskList = byId('taskTemplateList');
        var blockList = byId('dayBlockList');
        if (!summary || !taskList || !blockList) return;
        summary.innerHTML = '';
        taskList.innerHTML = '';
        blockList.innerHTML = '';

        var templates = (state.taskTemplates || []).slice();
        var blocks = (state.dayBlockTemplates || []).slice().sort(function (a, b) { return a.startMinutes - b.startMinutes; });
        var recurringCount = templates.filter(function (item) { return !!(item && item.recurrenceEnabled && item.recurrenceType); }).length;
        var todayBlocks = getMatchingDayBlocks(state.dayYmd || formatYmdLocal(new Date())).length;
        summary.appendChild(createTemplateSummaryCard(templates.length, 'Шаблонов задач'));
        summary.appendChild(createTemplateSummaryCard(recurringCount, 'С повтором'));
        summary.appendChild(createTemplateSummaryCard(blocks.length, 'Блоков дня'));
        summary.appendChild(createTemplateSummaryCard(todayBlocks, 'Блоков на выбранный день'));

        syncDayBlockSettingsInputs(state.dayBlockSettings || getDefaultDayBlockSettings());
        updateTaskTemplateRecurrenceUi();

        if (!templates.length) {
          var emptyTpl = document.createElement('div');
          emptyTpl.className = 'templates-empty-state';
          emptyTpl.textContent = 'Шаблонов пока нет. Создай первый шаблон задачи, чтобы быстро отправлять повторяющиеся сценарии в Inbox или Today.';
          taskList.appendChild(emptyTpl);
        } else {
          templates.forEach(function (template) {
            var card = document.createElement('div');
            card.className = 'template-item';
            card.innerHTML = '<div class="template-item-head"><div><div class="template-item-title">' + escapeHtml(template.title) + '</div><div class="template-inline-note">' + escapeHtml(template.description || 'Без описания') + '</div></div><button class="btn-delete" type="button" data-template-action="delete" data-template-id="' + escapeHtml(template.id) + '">Удалить</button></div>';
            var meta = document.createElement('div');
            meta.className = 'template-item-meta';
            meta.appendChild(createChip(normalizeProjectName(template.projectName)));
            meta.appendChild(createChip('План: ' + formatMinutesHoursLabel(template.durationMinutes)));
            if (template.priorityManual) meta.appendChild(createChip('Приоритет: ' + escapeHtml(getPriorityLabel(template.priorityManual))));
            meta.appendChild(createChip(getTemplateRecurrenceLabel(template)));
            card.appendChild(meta);
            var actions = document.createElement('div');
            actions.className = 'template-item-actions';
            actions.innerHTML = '<button class="btn-secondary" type="button" data-template-action="to-inbox" data-template-id="' + escapeHtml(template.id) + '">В Inbox</button><button class="btn-ghost" type="button" data-template-action="to-plan" data-template-id="' + escapeHtml(template.id) + '">В Plan</button><button class="btn-primary" type="button" data-template-action="to-today" data-template-id="' + escapeHtml(template.id) + '">На сегодня</button>';
            card.appendChild(actions);
            taskList.appendChild(card);
          });
        }

        if (!blocks.length) {
          var emptyBlocks = document.createElement('div');
          emptyBlocks.className = 'templates-empty-state';
          emptyBlocks.textContent = 'Блоков дня пока нет. Добавь хотя бы один блок, чтобы planner начал показывать ориентиры в Today и Неделе.';
          blockList.appendChild(emptyBlocks);
        } else {
          blocks.forEach(function (block) {
            var card = document.createElement('div');
            card.className = 'day-block-item-card';
            card.innerHTML = '<div class="day-block-item-head"><div><div class="day-block-item-title">' + escapeHtml(block.title) + '</div><div class="day-block-inline-note">' + escapeHtml(block.startTime + '–' + block.endTime) + ' · ' + escapeHtml(getDayBlockKindLabel(block.kind)) + '</div></div><div class="settings-inline-row" style="gap:8px;"><button class="btn-ghost" type="button" data-day-block-action="edit" data-day-block-id="' + escapeHtml(block.id) + '">Редактировать</button><button class="btn-delete" type="button" data-day-block-action="delete" data-day-block-id="' + escapeHtml(block.id) + '">Удалить</button></div></div>';
            var meta = document.createElement('div');
            meta.className = 'day-block-item-meta';
            meta.appendChild(createChip('Длительность: ' + formatMinutesHoursLabel(getDayBlockDurationMinutes(block))));
            meta.appendChild(createChip('Дни: ' + block.days.join(', ')));
            card.appendChild(meta);
            blockList.appendChild(card);
          });
        }
      }

      function getAllowedViews() {
        return ['today', 'inbox', 'templates', 'planner', 'projects', 'board', 'plan', 'gantt', 'month', 'settings'];
      }

      function isPrimaryWorkflowViewName(value) {
        var normalized = normalizeViewName(value || state.currentView || 'today');
        return normalized === 'inbox' || normalized === 'plan' || normalized === 'planner' || normalized === 'today';
      }

      function isSupportWorkflowViewName(value) {
        var normalized = normalizeViewName(value || state.currentView || 'today');
        return normalized === 'board' || normalized === 'projects' || normalized === 'gantt';
      }

      function isUtilityWorkflowViewName(value) {
        var normalized = normalizeViewName(value || state.currentView || 'today');
        return normalized === 'templates' || normalized === 'month';
      }

      function normalizeViewName(value) {
        var candidate = String(value || '').trim().toLowerCase();
        return getAllowedViews().indexOf(candidate) >= 0 ? candidate : 'today';
      }

