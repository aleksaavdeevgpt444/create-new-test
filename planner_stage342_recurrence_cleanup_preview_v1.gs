      function getDefaultCapacitySettings() {
        return {
          mode: 'workmode',
          manualDailyCapacityMinutes: 480,
          reserveMinutes: 60,
          overloadWarnPercent: 85,
          showOverflowQueue: true
        };
      }

      function normalizeCapacitySettings(value) {
        var defaults = getDefaultCapacitySettings();
        var normalized = Object.assign({}, defaults);
        if (!value || typeof value !== 'object') return normalized;
        normalized.mode = String(value.mode || '').trim() === 'manual' ? 'manual' : 'workmode';
        var manual = Number(value.manualDailyCapacityMinutes);
        if ([240, 300, 360, 420, 480, 540, 600].indexOf(manual) >= 0) normalized.manualDailyCapacityMinutes = manual;
        var reserve = Number(value.reserveMinutes);
        if ([0, 30, 60, 90, 120].indexOf(reserve) >= 0) normalized.reserveMinutes = reserve;
        var warn = Number(value.overloadWarnPercent);
        if ([75, 85, 90, 100].indexOf(warn) >= 0) normalized.overloadWarnPercent = warn;
        normalized.showOverflowQueue = value.showOverflowQueue !== false;
        return normalized;
      }

      function loadStoredCapacitySettings() {
        try {
          var raw = localStorage.getItem(CAPACITY_SETTINGS_STORAGE_KEY);
          if (!raw) return getDefaultCapacitySettings();
          return normalizeCapacitySettings(JSON.parse(raw));
        } catch (error) {
          return getDefaultCapacitySettings();
        }
      }

      function getWorkModeCapacityMinutes(mode) {
        var normalized = normalizeWorkMode(mode || state.workMode || 'balanced');
        if (normalized === 'deep') return 360;
        if (normalized === 'admin') return 300;
        if (normalized === 'light') return 240;
        return 480;
      }

      function getEffectiveCapacityMinutes(dayYmd) {
        var settings = state.capacitySettings || getDefaultCapacitySettings();
        var blockCapacity = getDayBlocksCapacityMinutes(dayYmd);
        var base = blockCapacity > 0
          ? blockCapacity
          : (settings.mode === 'manual'
            ? Number(settings.manualDailyCapacityMinutes) || 480
            : getWorkModeCapacityMinutes(state.workMode || 'balanced'));
        var reserve = Math.max(0, Number(settings.reserveMinutes) || 0);
        var planningWindow = getPlanningWindowHours();
        var calendarWindowMinutes = Math.max(0, (Number(planningWindow.endHour) - Number(planningWindow.startHour)) * 60);
        return Math.max(60, Math.min(calendarWindowMinutes, base) - reserve);
      }

      function getCapacityLoadMeta(plannedMinutes, capacityMinutes) {
        var settings = state.capacitySettings || getDefaultCapacitySettings();
        var planned = Math.max(0, Number(plannedMinutes) || 0);
        var capacity = Math.max(0, Number(capacityMinutes) || 0);
        var warnPercent = Math.max(1, Number(settings.overloadWarnPercent) || 85);
        var loadLevel = capacity > 0 ? Math.round((planned / capacity) * 100) : 0;
        if (capacity <= 0) {
          return { tone: 'neutral', label: 'Ёмкость не задана', shortLabel: 'без ёмкости', loadLevel: 0 };
        }
        if (planned > capacity) {
          return { tone: 'overflow', label: 'День перегружен', shortLabel: 'перегруз', loadLevel: loadLevel };
        }
        if (loadLevel >= warnPercent) {
          return { tone: 'warning', label: 'На пределе ёмкости', shortLabel: 'на пределе', loadLevel: loadLevel };
        }
        return { tone: 'normal', label: 'В рамках ёмкости', shortLabel: 'в норме', loadLevel: loadLevel };
      }

      function splitDayTasksByCapacity(dayYmd, tasks) {
        var scheduled = getTasksForActiveSpace(tasks).filter(function (task) {
          var status = normalizeStatus(task && task.status);
          return task && task.due_at && (status === STATUS.PLANNED || status === STATUS.DONE);
        }).slice().sort(compareTasksByDueAndUpdated);
        var capacityMinutes = getEffectiveCapacityMinutes(dayYmd);
        var plannedSum = 0;
        var inCapacityTasks = [];
        var overflowTasks = [];
        scheduled.forEach(function (task) {
          var taskMinutes = Math.max(Number(getEffectivePlannedMinutesClient(task)) || Number(getTaskDurationMinutes(task)) || 0, 0);
          if (taskMinutes <= 0) taskMinutes = DEFAULT_EVENT_DURATION_MIN;
          if (plannedSum + taskMinutes <= capacityMinutes || inCapacityTasks.length === 0 && plannedSum <= capacityMinutes) {
            inCapacityTasks.push(task);
          } else {
            overflowTasks.push(task);
          }
          plannedSum += taskMinutes;
        });
        return {
          capacityMinutes: capacityMinutes,
          plannedMinutes: plannedSum,
          inCapacityTasks: inCapacityTasks,
          overflowTasks: overflowTasks,
          overflowMinutes: Math.max(0, plannedSum - capacityMinutes),
          freeMinutes: Math.max(0, capacityMinutes - plannedSum),
          loadMeta: getCapacityLoadMeta(plannedSum, capacityMinutes)
        };
      }

      function getWeekCapacitySummary(startYmd) {
        var start = new Date((startYmd || state.weekStart || getCurrentWeekStartYmd()) + 'T00:00:00');
        var totalCapacity = 0;
        var totalPlanned = 0;
        var overflowDays = 0;
        var freeMinutes = 0;
        for (var i = 0; i < 7; i += 1) {
          var cursor = new Date(start.getTime() + i * 86400000);
          var dayYmd = formatYmdLocal(cursor);
          var daySplit = splitDayTasksByCapacity(dayYmd, getTasksForDay(dayYmd));
          totalCapacity += daySplit.capacityMinutes;
          totalPlanned += daySplit.plannedMinutes;
          freeMinutes += Math.max(0, daySplit.freeMinutes);
          if (daySplit.overflowMinutes > 0) overflowDays += 1;
        }
        return {
          capacityMinutes: totalCapacity,
          plannedMinutes: totalPlanned,
          overflowDays: overflowDays,
          freeMinutes: freeMinutes,
          overflowMinutes: Math.max(0, totalPlanned - totalCapacity),
          loadMeta: getCapacityLoadMeta(totalPlanned, totalCapacity)
        };
      }


      function getWeekCapacityDayDetails(startYmd) {
        var start = new Date((startYmd || state.weekStart || getCurrentWeekStartYmd()) + 'T00:00:00');
        var items = [];
        for (var i = 0; i < 7; i += 1) {
          var cursor = new Date(start.getTime() + i * 86400000);
          var dayYmd = formatYmdLocal(cursor);
          var dayTasks = getTasksForDay(dayYmd);
          var daySplit = splitDayTasksByCapacity(dayYmd, dayTasks);
          var scheduledTasks = dayTasks.filter(function (task) {
            return task && task.due_at && normalizeStatus(task.status) === STATUS.PLANNED;
          });
          var activeDayTasks = dayTasks.filter(function (task) {
            var status = normalizeStatus(task && task.status);
            return status === STATUS.NEW || status === STATUS.PLANNED || status === STATUS.POSTPONED;
          });
          var attentionTasks = getAttentionTasks(activeDayTasks);
          var focusProtectedCount = scheduledTasks.filter(function (task) {
            return task && task.id && isTaskFocusProtected(task.id);
          }).length;
          items.push({
            dayYmd: dayYmd,
            label: formatWithPlannerTimeZone(cursor, { weekday: 'short', day: 'numeric', month: 'short' }, '—'),
            shortLabel: formatWithPlannerTimeZone(cursor, { weekday: 'short', day: 'numeric' }, '—'),
            scheduledCount: scheduledTasks.length,
            attentionCount: attentionTasks.length,
            focusProtectedCount: focusProtectedCount,
            capacityMinutes: daySplit.capacityMinutes,
            plannedMinutes: daySplit.plannedMinutes,
            freeMinutes: daySplit.freeMinutes,
            overflowMinutes: daySplit.overflowMinutes,
            overflowTasks: daySplit.overflowTasks || [],
            loadMeta: daySplit.loadMeta || getCapacityLoadMeta(daySplit.plannedMinutes, daySplit.capacityMinutes),
            firstOverflowTask: daySplit.overflowTasks && daySplit.overflowTasks.length ? daySplit.overflowTasks[0] : null
          });
        }
        return items;
      }

      function getCapacityManagementWeekData(startYmd) {
        var normalizedStart = startYmd || state.weekStart || getCurrentWeekStartYmd();
        var summary = getWeekCapacitySummary(normalizedStart);
        var days = getWeekCapacityDayDetails(normalizedStart);
        var overflowDays = days.filter(function (item) { return (item.overflowMinutes || 0) > 0; });
        var warningDays = days.filter(function (item) { return item.loadMeta && item.loadMeta.tone === 'warning'; });
        var attentionDays = days.filter(function (item) { return (item.attentionCount || 0) > 0; });
        var tone = 'normal';
        var title = 'Нагрузка недели под контролем';
        var note = 'План недели помещается в текущую ёмкость. Свободный буфер можно оставить под фокус, переносы или добор backlog-задач.';
        if (overflowDays.length) {
          tone = 'danger';
          title = 'Неделя перегружена';
          note = 'Перегружено дней: ' + overflowDays.length + '. Вынеси overflow на завтра или верни часть задач в недельный слой, чтобы Today оставался исполнимым.';
        } else if (warningDays.length) {
          tone = 'warning';
          title = 'Неделя близка к пределу';
          note = 'Есть дней на пределе ёмкости: ' + warningDays.length + '. Лучше заранее оставить буфер и не перегружать их дополнительными слотами.';
        } else if (attentionDays.length) {
          tone = 'warning';
          title = 'Ёмкость в норме, но есть риск-дни';
          note = 'По минутам неделя собрана, но некоторые дни требуют внимания из-за stalled-задач, блокеров или риска дедлайна.';
        }
        return {
          startYmd: normalizedStart,
          summary: summary,
          days: days,
          overflowDays: overflowDays,
          warningDays: warningDays,
          attentionDays: attentionDays,
          tone: tone,
          title: title,
          note: note
        };
      }

