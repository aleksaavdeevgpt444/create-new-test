      function showError(message) {
        var box = byId('errorBox');
        if (!box) return;
        if (state.successHideTimerId) {
          clearTimeout(state.successHideTimerId);
          state.successHideTimerId = null;
        }
        box.classList.remove('is-success');
        if (!message) {
          box.style.display = 'none';
          box.textContent = '';
          return;
        }
        box.style.display = 'block';
        box.textContent = message;
      }


      function escapeHtml(value) {
        return String(value == null ? '' : value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function showSuccess(message) {
        var box = byId('errorBox');
        if (!box) return;
        if (state.successHideTimerId) {
          clearTimeout(state.successHideTimerId);
          state.successHideTimerId = null;
        }
        if (!message) {
          showError('');
          return;
        }
        box.style.display = 'block';
        box.classList.add('is-success');
        box.textContent = message;
        state.successHideTimerId = setTimeout(function () {
          if (!box) return;
          box.classList.remove('is-success');
          box.style.display = 'none';
          box.textContent = '';
          state.successHideTimerId = null;
        }, 4200);
      }

      function saveUserId(userId) { localStorage.setItem(STORAGE_KEY, userId); }
      function saveSessionToken(token) {
        var safe = String(token || '').trim();
        if (!safe) { localStorage.removeItem(SESSION_TOKEN_STORAGE_KEY); return; }
        localStorage.setItem(SESSION_TOKEN_STORAGE_KEY, safe);
      }
      function loadStoredSessionToken() {
        return localStorage.getItem(SESSION_TOKEN_STORAGE_KEY) || '';
      }
      function clearStoredSessionToken() {
        localStorage.removeItem(SESSION_TOKEN_STORAGE_KEY);
      }

      function getClientAuthTransportMode() {
        if (state && state.authSessionToken) return 'session';
        if (state && state.userId) return 'manual';
        return '';
      }

      function isSessionAuthActive() {
        return !!(state && state.authSessionToken && state.authMode !== 'manual');
      }

      function shouldExposeUserIdInUrl() {
        return !isSessionAuthActive();
      }

      function appendAuthSessionHeaders(headers) {
        var nextHeaders = new Headers(headers || {});
        var authMode = getClientAuthTransportMode();
        if (authMode) nextHeaders.set('x-planner-auth-mode', authMode);
        if (state && state.authSessionToken) nextHeaders.set('x-planner-session', String(state.authSessionToken));
        return nextHeaders;
