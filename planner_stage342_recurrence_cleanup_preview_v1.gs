      function applyHierarchyToneClass(element, tone) {
        if (!element || !element.classList) return;
        ['is-focus-today', 'is-focus-plan', 'is-focus-planner'].forEach(function(className) {
          element.classList.remove(className);
        });
        if (tone === 'today') element.classList.add('is-focus-today');
        if (tone === 'plan') element.classList.add('is-focus-plan');
        if (tone === 'planner') element.classList.add('is-focus-planner');
      }

