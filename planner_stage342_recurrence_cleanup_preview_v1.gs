      function createTodayAgendaTaskCard(task, options) {
        options = options || {};
        var targetDay = options.dayYmd || state.dayYmd || formatYmdLocal(new Date());
        var wrap = document.createElement('div');
        wrap.className = 'today-agenda-task-card';
        var card = createShellTaskCard(task);
        wrap.appendChild(card);
        var actions = document.createElement('div');
        actions.className = 'today-agenda-inline-actions';
        if (task && task.due_at) {
          var slotBtn = document.createElement('button');
          slotBtn.type = 'button';
          slotBtn.className = 'today-agenda-link-btn';
          slotBtn.textContent = 'К слоту';
          slotBtn.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            scrollTodayCalendarIntoView(task.id);
          });
          actions.appendChild(slotBtn);
        } else if (options.allowSchedule !== false) {
          var scheduleBtn = document.createElement('button');
          scheduleBtn.type = 'button';
          scheduleBtn.className = 'today-agenda-link-btn';
          scheduleBtn.textContent = 'В день';
          scheduleBtn.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            scheduleTask(task.id, getSuggestedTodaySlotIso(targetDay, task), STATUS.PLANNED, getTaskDurationMinutes(task));
          });
          actions.appendChild(scheduleBtn);
        }
        var focusBtn = document.createElement('button');
        focusBtn.type = 'button';
        focusBtn.className = 'today-agenda-link-btn';
        focusBtn.textContent = 'Фокус';
        focusBtn.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          startFocusModeFromTaskId(task.id);
        });
        actions.appendChild(focusBtn);
        wrap.appendChild(actions);
        return wrap;
      }

