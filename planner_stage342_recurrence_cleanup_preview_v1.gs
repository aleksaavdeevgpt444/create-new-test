async function readJsonBodySafe(request) {
  try {
    if (!request) return {};
    const method = String(request.method || 'GET').toUpperCase();
    if (method === 'GET' || method === 'HEAD') return {};
    const cloned = request.clone ? request.clone() : request;
    const parsed = await cloned.json();
    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
  } catch (error) {
    return {};
  }
}

function readRequestHeaderUserId(request) {
  try {
    return String(request && request.headers ? (request.headers.get('x-authenticated-user-id') || '') : '').trim();
  } catch (error) {
    return '';
  }
}

function readRequestUserIdFromUrlBodyOrHeader(url, body, request) {
  const queryUserId = readRequestUserIdFromUrl(url);
  if (queryUserId) return queryUserId;
  const bodyUserId = String(body && (body.user_id || body.userId || body.userID) || '').trim();
  if (bodyUserId) return bodyUserId;
  return readRequestHeaderUserId(request);
}

function buildMissingUserIdJsonResponse(routeName) {
  return jsonResponse({
    ok: false,
    error: 'user_id is required',
    build: getClientAppBuildLabel(),
    route: routeName || '',
    hint: 'Передайте user_id в query string или JSON body. Для session-auth запросов user_id добавляется автоматически.'
  }, { status: 400 });
}

async function countUserRowsSafe(env, tableName, userId) {
  try {
    if (!env || !env.DB || !tableName || !userId) return null;
    const row = await env.DB.prepare(`SELECT COUNT(*) AS count FROM ${tableName} WHERE user_id = ?`).bind(String(userId)).first();
    return Number(row && row.count) || 0;
  } catch (error) {
    return null;
  }
}

function buildDataCheckString(params) {
  const pairs = [];
  for (const [key, value] of params.entries()) {
    if (key === "hash") continue;
    pairs.push(`${key}=${value}`);
  }
  pairs.sort((a, b) => a.localeCompare(b));
  return pairs.join("\n");
}

async function hmacSha256Raw(keyBytes, message) {
  const cryptoKey = await crypto.subtle.importKey(
    "raw",
    keyBytes,
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign"]
  );
  return crypto.subtle.sign("HMAC", cryptoKey, new TextEncoder().encode(message));
}

function bufferToHex(buffer) {
  return [...new Uint8Array(buffer)].map((byte) => byte.toString(16).padStart(2, "0")).join("");
}

async function validateTelegramInitData(initDataRaw, botToken) {
  if (!initDataRaw || typeof initDataRaw !== "string") return { ok: false, error: "init_data is required" };

  const params = new URLSearchParams(initDataRaw);
  const hash = params.get("hash");
  if (!hash) return { ok: false, error: "hash is missing in init_data" };

  const dataCheckString = buildDataCheckString(params);
  const secretKey = await hmacSha256Raw(new TextEncoder().encode("WebAppData"), botToken);
  const calculatedHashBuffer = await hmacSha256Raw(secretKey, dataCheckString);
  const calculatedHash = bufferToHex(calculatedHashBuffer);
  if (calculatedHash !== hash) return { ok: false, error: "invalid init_data signature" };

  const authDate = Number(params.get("auth_date") || 0);
  const nowSec = Math.floor(Date.now() / 1000);
  if (!authDate || nowSec - authDate > MAX_INIT_DATA_AGE_SEC) {
    return { ok: false, error: "init_data is expired" };
  }

  let user = null;
  const rawUser = params.get("user");
  if (rawUser) {
    try {
      user = JSON.parse(rawUser);
    } catch (error) {
      return { ok: false, error: "failed to parse user from init_data" };
    }
  }

  if (!user || !user.id) return { ok: false, error: "telegram user is missing in init_data" };

  return {
    ok: true,
    auth_date: authDate,
    query_id: params.get("query_id") || null,
    user,
    start_param: params.get("start_param") || params.get("tgWebAppStartParam") || null,
  };
}

// STAGE 288 — server hardening: helper для конфигурируемого таймаута Telegram API.
// Не нарушает обратную совместимость: при отсутствии env-переменной возвращает дефолт.
function getConfiguredTelegramApiTimeoutMs(env) {
  const fromEnv = Number(env && env.TELEGRAM_API_TIMEOUT_MS);
  if (Number.isFinite(fromEnv) && fromEnv > 0) return fromEnv;
  return TELEGRAM_API_REQUEST_TIMEOUT_MS_DEFAULT;
}

async function telegramApi(env, method, payload) {
  // STAGE 288 — server hardening: timeout + response.ok + safe JSON parse.
  // Возвращаемый контракт сохранён: всегда возвращается объект (как раньше
  // .json()). При ошибке/таймауте/не-JSON ответе бросается Error, который
  // ловится верхними try/catch — это совместимо с прежним поведением
  // (раньше .json() при HTML-ответе бросал SyntaxError).
  const timeoutMs = getConfiguredTelegramApiTimeoutMs(env);
  const controller = new AbortController();
  const timeoutId = setTimeout(() => {
    try { controller.abort(); } catch (_) {}
  }, timeoutMs);
  let response;
  try {
    response = await fetch(`https://api.telegram.org/bot${env.TELEGRAM_BOT_TOKEN}/${method}`, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(payload || {}),
      signal: controller.signal,
    });
  } catch (error) {
    if (error && error.name === 'AbortError') {
      const timeoutError = new Error('Telegram API timeout after ' + String(timeoutMs) + 'ms (method=' + String(method) + ')');
      timeoutError.name = 'AbortError';
      throw timeoutError;
    }
    throw error;
  } finally {
    clearTimeout(timeoutId);
  }

  // Безопасное чтение тела + попытка распарсить как JSON независимо от
  // content-type (Telegram иногда возвращает корректный JSON без header'а).
  const rawText = await readResponseTextSafe(response);
  const data = tryParseJsonSafe(rawText);

  if (!response.ok) {
    // Возвращаем максимально информативную ошибку: сначала Telegram-описание
    // (description), потом тело, потом просто HTTP-код. Тело урезаем, чтобы
    // не раздуть лог при HTML 502.
    const description = data && (data.description || data.error_description) ? String(data.description || data.error_description) : '';
    const body = !description && rawText ? String(rawText).slice(0, 500) : '';
    const message = description
      || body
      || ('Telegram API HTTP ' + response.status + ' (method=' + String(method) + ')');
    // STAGE 288.1 — TS-friendly расширение Error через Object.assign:
    // .name стандартное у Error, .status — нет, поэтому прямое присваивание
    // err.status = ... вызывает TS2339 в строгом режиме чекера. Object.assign
    // возвращает Error с расширенными свойствами без изменения runtime-поведения
    // (свойства добавляются на инстанс ровно так же, как при прямом присвоении).
    const err = Object.assign(new Error(message), {
      name: 'TelegramApiError',
      status: response.status
    });
    throw err;
  }

  // response.ok, но тело не JSON — критично, бросаем понятную ошибку
  // (раньше .json() в этом случае падал с SyntaxError без контекста).
  if (data === null) {
    throw new Error('Telegram API returned non-JSON 2xx response (method=' + String(method) + ', body length=' + String(rawText.length) + ')');
  }
  return data;
}

async function sendTelegramMessage(env, chatId, text, extra = {}) {
  return telegramApi(env, "sendMessage", { chat_id: chatId, text, ...extra });
}

function classifyTelegramTaskNotificationTypesServer(task, todayYmd = null) {
  const labels = [];
  const text = [task?.title, task?.description, task?.task_product, task?.project_name].filter(Boolean).join(' ').toLowerCase();
  if (task && (Number(task.recurrence_enabled || 0) === 1 || task.recurrence_type || task.recurrence_series_id || task.recurrence_parent_task_id)) labels.push('Повторяшка');
  if (/(созвон|звонок|встреч|митинг|meeting|sync|call|координац|zoom|google meet|meet)/i.test(text)) labels.push('Координация');
  const priority = Math.max(Number(task?.priority_manual) || 0, Number(task?.priority_ai) || 0);
  const plannedMinutes = getEffectivePlannedMinutesServer(task || {});
  if (priority >= 3 || plannedMinutes >= 50) labels.push('Фокус');
  const targetYmd = String(todayYmd || getTelegramTodayYmd(TELEGRAM_CONTROL_TIMEZONE) || '').trim();
  const taskYmd = formatTelegramYmdFromIso(task?.due_at || null, TELEGRAM_CONTROL_TIMEZONE);
  const status = normalizeStatus(task?.status);
  if (status === TASK_STATUSES.PLANNED && taskYmd && taskYmd === targetYmd) labels.push('Текущая');
  return Array.from(new Set(labels));
}

function buildTelegramTaskReminderTextServer(task, options = {}) {
  const safeTask = task || {};
  const title = String(safeTask.title || 'Без названия').trim() || 'Без названия';
  const project = String(safeTask.project_name || 'Без проекта').trim() || 'Без проекта';
  const dueLabel = safeTask.due_at ? formatTelegramClockFromIso(safeTask.due_at, TELEGRAM_CONTROL_TIMEZONE) : 'Без времени';
  const dueDay = safeTask.due_at ? formatTelegramYmdFromIso(safeTask.due_at, TELEGRAM_CONTROL_TIMEZONE) : null;
  const planned = formatTelegramPlanDuration(getEffectivePlannedMinutesServer(safeTask));
  const lead = Number(options?.lead_minutes);
  const typeLabels = classifyTelegramTaskNotificationTypesServer(safeTask, options?.day_ymd || null);
  const lines = [
    '🔔 Напоминание по задаче',
    '',
    title,
    '',
    `Проект: ${project}`,
    `Когда: ${dueDay ? (dueDay + ' · ' + dueLabel) : dueLabel}`,
    `План: ${planned}`
  ];
  if (Number.isFinite(lead) && lead >= 0) lines.push(`Упреждение: ${lead === 0 ? 'в момент старта' : (lead + ' мин')}`);
  if (typeLabels.length) lines.push(`Тип: ${typeLabels.join(', ')}`);
  if (safeTask.ai_next_step) lines.push(`Следующий шаг: ${String(safeTask.ai_next_step).trim()}`);
  return lines.join('\n');
}


function buildTelegramTaskReminderCallbackData(action, taskId) {
  return ['tgr', String(action || '').trim(), String(taskId || '').trim()].join('|').slice(0, 64);
}

function parseTelegramTaskReminderCallbackData(data) {
  const parts = String(data || '').split('|');
  if (parts.length !== 3 || parts[0] !== 'tgr') return null;
  const action = String(parts[1] || '').trim();
  const taskId = String(parts[2] || '').trim();
  if (!action || !taskId) return null;
  return { action, taskId };
}

function buildTelegramTaskReminderReplyMarkup(request, env, task) {
  const appUrl = getAppUrlFromRequest(request, env);
  return {
    inline_keyboard: [
      [
        { text: '✅ Выполнено', callback_data: buildTelegramTaskReminderCallbackData('done', task?.id) },
        { text: '⏱ +10 мин', callback_data: buildTelegramTaskReminderCallbackData('snooze10', task?.id) }
      ],
      [
        { text: '📅 На завтра', callback_data: buildTelegramTaskReminderCallbackData('tomorrow', task?.id) },
        { text: 'Открыть задачу', web_app: { url: appUrl } }
      ]
    ]
  };
}

async function answerTelegramCallbackQuery(env, callbackQueryId, text = '', showAlert = false) {
  if (!callbackQueryId) return null;
  return telegramApi(env, 'answerCallbackQuery', {
    callback_query_id: callbackQueryId,
    text: text ? String(text).slice(0, 180) : undefined,
    show_alert: !!showAlert
  });
}

async function replaceTelegramTaskReminderReplyMarkup(env, callbackQuery, request, label = 'Открыть задачу в Planner') {
  const messageId = callbackQuery?.message?.message_id;
  const chatId = callbackQuery?.message?.chat?.id;
  if (!messageId || !chatId) return null;
  return telegramApi(env, 'editMessageReplyMarkup', {
    chat_id: chatId,
    message_id: messageId,
    reply_markup: buildTelegramPlannerOpenReplyMarkup(getAppUrlFromRequest(request, env), label)
  });
}

function getTelegramTaskReminderSnoozeIso(task, minutes = 10) {
  const baseIso = task?.due_at || task?.remind_at || new Date().toISOString();
  const base = new Date(baseIso);
  if (Number.isNaN(base.getTime())) return new Date(Date.now() + Math.max(1, Number(minutes) || 10) * 60000).toISOString();
  base.setMinutes(base.getMinutes() + Math.max(1, Number(minutes) || 10));
  return base.toISOString();
}

function getTelegramTaskReminderTomorrowIso(task) {
  let hour = TELEGRAM_DEFAULT_TOMORROW_HOUR;
  let minute = 0;
  const sourceIso = task?.due_at || task?.remind_at || null;
  if (sourceIso) {
    const sourceDate = new Date(sourceIso);
    if (!Number.isNaN(sourceDate.getTime())) {
      const parts = getTelegramTimeZoneDateParts(sourceDate, TELEGRAM_CONTROL_TIMEZONE);
      hour = parts.hour;
      minute = parts.minute;
    }
  }
  const tomorrowYmd = addDaysToServerYmd(getTelegramTodayYmd(TELEGRAM_CONTROL_TIMEZONE), 1);
  return zonedDateTimeToUtcIso(tomorrowYmd, hour, minute, TELEGRAM_CONTROL_TIMEZONE);
}

async function handleTelegramTaskReminderCallback(env, callbackQuery, request) {
  const parsed = parseTelegramTaskReminderCallbackData(callbackQuery?.data || '');
  if (!parsed) return false;

  const userId = String(callbackQuery?.from?.id || '').trim();
  const callbackQueryId = String(callbackQuery?.id || '').trim();
  if (!userId) {
    await answerTelegramCallbackQuery(env, callbackQueryId, 'Не удалось определить пользователя.', true);
    return true;
  }

  const task = await getTaskById(env, { taskId: parsed.taskId, userId });
  if (!task) {
    await answerTelegramCallbackQuery(env, callbackQueryId, 'Задача не найдена.', true);
    await replaceTelegramTaskReminderReplyMarkup(env, callbackQuery, request, 'Открыть Planner');
    return true;
  }

  const status = normalizeStatus(task.status);
  try {
    if (parsed.action === 'done') {
      if (status === TASK_STATUSES.DONE) {
        await answerTelegramCallbackQuery(env, callbackQueryId, 'Эта задача уже выполнена.');
      } else if (status === TASK_STATUSES.CANCELED) {
        await answerTelegramCallbackQuery(env, callbackQueryId, 'Отменённую задачу нельзя отметить выполненной.', true);
      } else {
        await updateTaskStatus(env, { taskId: task.id, userId, nextStatus: TASK_STATUSES.DONE });
        await answerTelegramCallbackQuery(env, callbackQueryId, 'Задача отмечена выполненной.');
        await replaceTelegramTaskReminderReplyMarkup(env, callbackQuery, request, 'Открыть Planner');
      }
      return true;
    }

    if (parsed.action === 'snooze10') {
      if (status === TASK_STATUSES.DONE || status === TASK_STATUSES.CANCELED) {
        await answerTelegramCallbackQuery(env, callbackQueryId, 'Эту задачу нельзя перенести.', true);
        return true;
      }
      const nextIso = getTelegramTaskReminderSnoozeIso(task, 10);
      await updateTaskSchedule(env, {
        taskId: task.id,
        userId,
        dueAt: nextIso,
        nextStatus: TASK_STATUSES.PLANNED,
        durationMinutes: task.duration_minutes
      });
      await answerTelegramCallbackQuery(env, callbackQueryId, 'Напоминание сдвинуто на 10 минут.');
      await replaceTelegramTaskReminderReplyMarkup(env, callbackQuery, request, 'Открыть Planner');
      return true;
    }

    if (parsed.action === 'tomorrow') {
      if (status === TASK_STATUSES.DONE || status === TASK_STATUSES.CANCELED) {
        await answerTelegramCallbackQuery(env, callbackQueryId, 'Эту задачу нельзя перенести.', true);
        return true;
      }
      const nextIso = getTelegramTaskReminderTomorrowIso(task);
      await updateTaskSchedule(env, {
        taskId: task.id,
        userId,
        dueAt: nextIso,
        nextStatus: TASK_STATUSES.PLANNED,
        durationMinutes: task.duration_minutes
      });
      await answerTelegramCallbackQuery(env, callbackQueryId, 'Задача перенесена на завтра.');
      await replaceTelegramTaskReminderReplyMarkup(env, callbackQuery, request, 'Открыть Planner');
      return true;
    }

    await answerTelegramCallbackQuery(env, callbackQueryId, 'Неизвестное действие.', true);
    return true;
  } catch (error) {
    await answerTelegramCallbackQuery(env, callbackQueryId, String(error?.message || error || 'Ошибка действия').slice(0, 180), true);
    return true;
  }
}

function parseTelegramChatIdList(value) {
  return String(value || "")
    .split(/[\s,;]+/)
    .map((item) => String(item || "").trim())
    .filter(Boolean);
}

function getTelegramErrorReportChatIds(env, fallbackChatId = null) {
  const sources = [
    env.TELEGRAM_ERROR_REPORT_CHAT_IDS,
    env.TELEGRAM_ERROR_CHAT_IDS,
    env.TELEGRAM_ADMIN_CHAT_IDS,
    env.ADMIN_CHAT_IDS,
    env.OWNER_TELEGRAM_CHAT_ID,
    env.TELEGRAM_OWNER_CHAT_ID,
    env.TELEGRAM_DEFAULT_CHAT_ID,
    fallbackChatId || null,
  ];
  const unique = new Set();
  sources.forEach((source) => {
    parseTelegramChatIdList(source).forEach((chatId) => unique.add(chatId));
  });
  return Array.from(unique);
}

function trimErrorReportText(value, maxLength = ERROR_REPORT_TEXT_LIMIT) {
  const normalized = String(value || "").trim();
  if (!normalized) return "";
  if (normalized.length <= maxLength) return normalized;
  return normalized.slice(0, Math.max(0, maxLength - 1)) + "…";
}

function safeJsonStringify(value) {
  try {
    return JSON.stringify(value, null, 2);
  } catch (error) {
    return String(value);
  }
}

function normalizeErrorTextForReport(error) {
  if (!error) return "Unknown error";
  if (typeof error === "string") return error;
  if (error && error.stack) return String(error.stack);
  if (error && error.message) return String(error.message);
  return safeJsonStringify(error);
}

function buildTelegramErrorReportText(payload = {}) {
  const lines = [
    "🚨 Planner error report",
    "",
    `Build: ${APP_BUILD}`,
    `Source: ${payload.source || "server"}`,
  ];

  if (payload.phase) lines.push(`Phase: ${payload.phase}`);
  if (payload.method || payload.path) lines.push(`Request: ${(payload.method || "GET")} ${payload.path || "—"}`);
  if (payload.status) lines.push(`Status: ${payload.status}`);
  if (payload.userId) lines.push(`User: ${payload.userId}`);
  if (payload.view) lines.push(`View: ${payload.view}`);
  if (payload.message) lines.push(`Message: ${payload.message}`);
  if (payload.url) lines.push(`URL: ${payload.url}`);
  if (payload.timestamp) lines.push(`Time: ${payload.timestamp}`);

  if (payload.extra) {
    lines.push("", "Extra:", trimErrorReportText(typeof payload.extra === "string" ? payload.extra : safeJsonStringify(payload.extra), 1200));
  }

  if (payload.errorText) {
    lines.push("", "Error:", trimErrorReportText(payload.errorText, 2000));
  }

  return trimErrorReportText(lines.join("\n"), ERROR_REPORT_TEXT_LIMIT);
}

async function reportTelegramError(env, payload = {}) {
  try {
    if (!env || !env.TELEGRAM_BOT_TOKEN) {
      return { ok: false, sent: false, reason: 'missing_bot_token', delivered_count: 0, failed_count: 0, chat_ids: [] };
    }
    const chatIds = getTelegramErrorReportChatIds(env, payload.fallbackChatId || null);
    if (!chatIds.length) {
      return { ok: false, sent: false, reason: 'missing_chat_ids', delivered_count: 0, failed_count: 0, chat_ids: [] };
    }
    const text = buildTelegramErrorReportText(payload);
    const results = await Promise.all(chatIds.map(async (chatId) => {
      try {
        const response = await sendTelegramMessage(env, chatId, text, { disable_notification: false });
        if (response && response.ok === false) {
          return { ok: false, chat_id: String(chatId), error: response.description || 'Telegram sendMessage failed' };
        }
        return { ok: true, chat_id: String(chatId) };
      } catch (error) {
        return { ok: false, chat_id: String(chatId), error: error && error.message ? String(error.message) : String(error) };
      }
    }));
    const delivered = results.filter((item) => item && item.ok);
    const failed = results.filter((item) => !item || !item.ok);
    return {
      ok: delivered.length > 0,
      sent: delivered.length > 0,
      reason: delivered.length > 0 ? 'ok' : 'send_failed',
      delivered_count: delivered.length,
      failed_count: failed.length,
      chat_ids: chatIds.map((item) => String(item)),
      errors: failed.map((item) => ({ chat_id: item && item.chat_id ? String(item.chat_id) : '', error: item && item.error ? String(item.error) : 'send_failed' }))
    };
  } catch (error) {
    return { ok: false, sent: false, reason: 'report_exception', delivered_count: 0, failed_count: 0, chat_ids: [], error: error && error.message ? String(error.message) : String(error) };
  }
}

function shouldSkipServerErrorReport(pathname) {
  return pathname === "/telegram/error-report" || pathname === "/health";
}

async function maybeReportErrorResponse(env, request, response) {
  try {
    const url = new URL(request.url);
    if (!response || response.status < 500 || shouldSkipServerErrorReport(url.pathname)) return response;
    const cloned = response.clone();
    let message = "";
    try {
      const contentType = cloned.headers.get("content-type") || "";
      if (contentType.includes("application/json")) {
        const data = await cloned.json();
        message = data && data.error ? String(data.error) : safeJsonStringify(data);
      } else {
        message = await cloned.text();
      }
    } catch (error) {
      message = "Failed to read error response body";
    }

    await reportTelegramError(env, {
      source: "server-response",
      phase: "response",
      method: request.method,
      path: url.pathname + (url.search || ""),
      status: response.status,
      message: trimErrorReportText(message, 800),
      timestamp: new Date().toISOString(),
      url: request.url,
      extra: { user_agent: request.headers.get("user-agent") || null },
    });
    return response;
  } catch (error) {
    return response;
  }
}

async function createServerErrorResponseWithReport(env, request, error) {
  const url = new URL(request.url);
  await reportTelegramError(env, {
    source: "server-uncaught",
    phase: "fetch",
    method: request.method,
    path: url.pathname + (url.search || ""),
    status: 500,
    message: error && error.message ? String(error.message) : "Unhandled server error",
    errorText: normalizeErrorTextForReport(error),
    timestamp: new Date().toISOString(),
    url: request.url,
    extra: { user_agent: request.headers.get("user-agent") || null },
  });

  if (url.pathname === "/app" || String(request.headers.get("accept") || "").includes("text/html")) {
    return htmlResponse("<h1>Planner error</h1><p>Произошла серверная ошибка. Репорт отправлен в Telegram.</p>", 500);
  }

  return jsonResponse({
    ok: false,
    build: getClientAppBuildLabel(),
    error: error && error.message ? String(error.message) : "Internal Server Error",
  }, { status: 500 });
}

function normalizeTelegramDayPlanSectionItems(items) {
  if (!Array.isArray(items)) return [];
  return items
    .map((item) => ({
      title: String(item?.title || "").trim(),
      planned_minutes: normalizeOptionalTaskMinutes(item?.planned_minutes, 1440),
    }))
    .filter((item) => item.title)
    .slice(0, 50);
}

function formatTelegramPlanDuration(minutes) {
  const value = normalizeOptionalTaskMinutes(minutes, 1440);
  if (value === null) return "—";
  const hours = Math.floor(value / 60);
  const rest = value % 60;
  if (hours <= 0) return `${rest} мин`;
  if (rest === 0) return `${hours} ч`;
  return `${hours} ч ${rest} мин`;
}

function formatTelegramDayPlanHeading(dayYmd) {
  if (!dayYmd) return "План на сегодня";
  const parsed = new Date(`${dayYmd}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return "План на день";
  return `План на ${parsed.toLocaleDateString("ru-RU", { day: "numeric", month: "long" })}`;
}

function buildTelegramDayPlanText({ dayYmd, sections }) {
  const normalizedSections = sections || {};
  const groups = [
    { title: "Основные", items: normalizeTelegramDayPlanSectionItems(normalizedSections.primary) },
    { title: "Дополнительные", items: normalizeTelegramDayPlanSectionItems(normalizedSections.additional) },
    { title: "Повторяшки", items: normalizeTelegramDayPlanSectionItems(normalizedSections.recurring) },
  ];

  const lines = [formatTelegramDayPlanHeading(dayYmd), ""];
  groups.forEach((group, index) => {
    const title = String(group.title || '');
    const items = Array.isArray(group.items) ? group.items : [];
    if (index > 0) lines.push("");
    lines.push(title);
    if (!items.length) {
      lines.push("—");
      return;
    }
    items.forEach((item, itemIndex) => {
      lines.push(`${itemIndex + 1}. ${item.title} — ${formatTelegramPlanDuration(item.planned_minutes)}`);
    });
  });

  return lines.join("\n");
}

function normalizeTelegramDayFactItems(items) {
  if (!Array.isArray(items)) return [];
  return items
    .map((item) => ({
      title: String(item?.title || "").trim(),
      actual_minutes: normalizeOptionalTaskMinutes(item?.actual_minutes, 1440),
      moved_to_ymd: item?.moved_to_ymd ? String(item.moved_to_ymd).trim() : null,
    }))
    .filter((item) => item.title)
    .slice(0, 50);
}

function formatTelegramShortDayMonth(dayYmd) {
  const match = String(dayYmd || "").match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!match) return null;
  return `${match[3]}.${match[2]}`;
}

function formatTelegramDayFactHeading(dayYmd) {
  if (!dayYmd) return "Факт дня";
  const parsed = new Date(`${dayYmd}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return "Факт дня";
  return `Факт за ${parsed.toLocaleDateString("ru-RU", { day: "numeric", month: "long" })}`;
}

function buildTelegramDayFactText({ dayYmd, completed, moved }) {
  const groups = [
    { title: "Выполнено", items: normalizeTelegramDayFactItems(completed), mode: "completed" },
    { title: "Перенесено", items: normalizeTelegramDayFactItems(moved), mode: "moved" },
  ];

  const lines = [formatTelegramDayFactHeading(dayYmd), ""];
  groups.forEach((group, index) => {
    const title = String(group.title || '');
    const items = Array.isArray(group.items) ? group.items : [];
    const mode = group.mode;
    if (index > 0) lines.push("");
    lines.push(title);
    if (!items.length) {
      lines.push("—");
      return;
    }
    items.forEach((item, itemIndex) => {
      if (mode === "completed") {
        lines.push(`${itemIndex + 1}. ${item.title} — факт ${formatTelegramPlanDuration(item.actual_minutes)} ✅`);
        return;
      }
      const movedTo = formatTelegramShortDayMonth(item.moved_to_ymd) || "—";
      lines.push(`${itemIndex + 1}. ${item.title} — факт ${formatTelegramPlanDuration(item.actual_minutes)} — перенесено на ${movedTo}`);
    });
  });
  return lines.join("\n");
}

function getTelegramTimeZoneDateParts(date, timeZone = TELEGRAM_CONTROL_TIMEZONE) {
  const formatter = new Intl.DateTimeFormat("en-CA", {
    timeZone,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  });
  /** @type {Record<string, string>} */
  const parts = formatter.formatToParts(date).reduce((acc, part) => {
    if (part.type !== "literal") acc[part.type] = part.value;
    return acc;
  }, /** @type {Record<string, string>} */ ({}));
  return {
    year: Number(parts.year),
    month: Number(parts.month),
    day: Number(parts.day),
    hour: Number(parts.hour),
    minute: Number(parts.minute),
    second: Number(parts.second),
  };
}

function getTelegramTodayYmd(timeZone = TELEGRAM_CONTROL_TIMEZONE) {
  const parts = getTelegramTimeZoneDateParts(new Date(), timeZone);
  return `${String(parts.year).padStart(4, "0")}-${String(parts.month).padStart(2, "0")}-${String(parts.day).padStart(2, "0")}`;
}

function getServerCurrentWeekStartYmd(now = new Date()) {
  const date = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
  const offset = (date.getUTCDay() + 6) % 7;
  date.setUTCDate(date.getUTCDate() - offset);
  return date.toISOString().slice(0, 10);
}

function addDaysToServerYmd(ymd, days) {
  const date = new Date(`${ymd}T00:00:00.000Z`);
  if (Number.isNaN(date.getTime())) throw new Error(`Invalid ymd: ${ymd}`);
  date.setUTCDate(date.getUTCDate() + Number(days || 0));
  return date.toISOString().slice(0, 10);
}

function zonedDateTimeToUtcIso(ymd, hour = 0, minute = 0, timeZone = TELEGRAM_CONTROL_TIMEZONE) {
  const match = String(ymd || "").match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!match) throw new Error(`Invalid ymd: ${ymd}`);
  const year = Number(match[1]);
  const month = Number(match[2]);
  const day = Number(match[3]);
  const utcGuess = new Date(Date.UTC(year, month - 1, day, Number(hour) || 0, Number(minute) || 0, 0));
  const tzParts = getTelegramTimeZoneDateParts(utcGuess, timeZone);
  const tzAsUtc = Date.UTC(tzParts.year, tzParts.month - 1, tzParts.day, tzParts.hour, tzParts.minute, tzParts.second || 0);
  const targetAsUtc = Date.UTC(year, month - 1, day, Number(hour) || 0, Number(minute) || 0, 0);
  return new Date(utcGuess.getTime() + (targetAsUtc - tzAsUtc)).toISOString();
}

function getTelegramDayRange(dayOffset = 0, timeZone = TELEGRAM_CONTROL_TIMEZONE) {
  const dayYmd = addDaysToServerYmd(getTelegramTodayYmd(timeZone), dayOffset);
  const nextYmd = addDaysToServerYmd(dayYmd, 1);
  return {
    ymd: dayYmd,
    fromIso: zonedDateTimeToUtcIso(dayYmd, 0, 0, timeZone),
    toIso: zonedDateTimeToUtcIso(nextYmd, 0, 0, timeZone),
  };
}

function getTelegramSpecificDayRange(dayYmd, timeZone = TELEGRAM_CONTROL_TIMEZONE) {
  const normalizedYmd = String(dayYmd || '').trim();
  if (!/^\d{4}-\d{2}-\d{2}$/.test(normalizedYmd)) throw new Error('Invalid day_ymd');
  const nextYmd = addDaysToServerYmd(normalizedYmd, 1);
  return {
    ymd: normalizedYmd,
    fromIso: zonedDateTimeToUtcIso(normalizedYmd, 0, 0, timeZone),
    toIso: zonedDateTimeToUtcIso(nextYmd, 0, 0, timeZone),
  };
}

function formatTelegramYmdFromIso(iso, timeZone = TELEGRAM_CONTROL_TIMEZONE) {
  if (!iso) return null;
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return null;
  const parts = getTelegramTimeZoneDateParts(date, timeZone);
  const year = String(parts.year || '').padStart(4, '0');
  const month = String(parts.month || '').padStart(2, '0');
  const day = String(parts.day || '').padStart(2, '0');
  if (!year || !month || !day) return null;
  return `${year}-${month}-${day}`;
}

function getTelegramTaskPriorityScore(task) {
  const manual = normalizePriorityManualValue(task?.priority_manual);
  if (manual !== null) return manual;
  return normalizePriorityManualValue(task?.priority_ai) || 0;
}

function compareTasksByDueAtAsc(a, b) {
  const aTime = a?.due_at ? Date.parse(a.due_at) : Number.MAX_SAFE_INTEGER;
  const bTime = b?.due_at ? Date.parse(b.due_at) : Number.MAX_SAFE_INTEGER;
  if (aTime !== bTime) return aTime - bTime;
  return String(a?.title || "").localeCompare(String(b?.title || ""), "ru", { sensitivity: "base" });
}

function compareTasksByPriorityAndDue(a, b) {
  const priorityDiff = getTelegramTaskPriorityScore(b) - getTelegramTaskPriorityScore(a);
  if (priorityDiff !== 0) return priorityDiff;
  return compareTasksByDueAtAsc(a, b);
}

function isTelegramRecurringTask(task) {
  return Boolean(task?.recurrence_enabled) || Boolean(task?.recurrence_type) || Boolean(task?.recurrence_series_id);
}

function getTelegramTaskSummaryItem(task) {
  return {
    id: task?.id,
    title: String(task?.title || "").trim(),
    planned_minutes: getEffectivePlannedMinutesServer(task),
  };
}

function buildTelegramPlanSectionsFromTasks(tasks) {
  const scheduled = Array.isArray(tasks) ? tasks.filter((task) => String(task?.title || "").trim()) : [];
  const recurring = scheduled.filter(isTelegramRecurringTask).sort(compareTasksByDueAtAsc);
  const regular = scheduled.filter((task) => !isTelegramRecurringTask(task)).sort(compareTasksByDueAtAsc);
  const primaryIds = new Set(regular.slice().sort(compareTasksByPriorityAndDue).slice(0, 3).map((task) => task.id));
  const primary = regular.filter((task) => primaryIds.has(task.id)).map(getTelegramTaskSummaryItem);
  const additional = regular.filter((task) => !primaryIds.has(task.id)).map(getTelegramTaskSummaryItem);
  return {
    primary,
    additional,
    recurring: recurring.map(getTelegramTaskSummaryItem),
  };
}

function formatTelegramClockFromIso(iso, timeZone = TELEGRAM_CONTROL_TIMEZONE) {
  if (!iso) return "—";
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return "—";
  return new Intl.DateTimeFormat("ru-RU", {
    timeZone,
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).format(date);
}

function buildTelegramPlannerOpenReplyMarkup(appUrl, label = "Открыть Planner") {
  return {
    inline_keyboard: [[{ text: label, web_app: { url: appUrl } }]],
  };
}

async function getTaskDisplayIndexById(env, { userId, status, taskId, limit = TELEGRAM_COMMAND_LOOKUP_LIMIT }) {
  const tasks = await getTasksByStatus(env, { userId, status, limit });
  const index = tasks.findIndex((task) => task.id === taskId);
  return index >= 0 ? index + 1 : null;
}

async function resolveTelegramTaskFromArgs(env, userId, args, defaultSourceStatus = TASK_STATUSES.PLANNED) {
  const parsed = parseStatusMoveArgs(args, defaultSourceStatus);
  if (!parsed.ok) return { ok: false, reason: parsed.reason || "invalid_args" };
  const task = await getTaskByDisplayIndex(env, {
    userId: String(userId),
    status: parsed.sourceStatus,
    index: parsed.index,
    limit: TELEGRAM_COMMAND_LOOKUP_LIMIT,
  });
  if (!task) return { ok: false, reason: "task_not_found", sourceStatus: parsed.sourceStatus, index: parsed.index };
  return { ok: true, task, sourceStatus: parsed.sourceStatus, index: parsed.index };
}

function isTelegramWorkTask(task) {
  return normalizeTaskSpaceKey(task && task.space_key) === 'work';
}

function filterTelegramItemsToWorkSpace(items) {
  return (Array.isArray(items) ? items : []).filter((item) => isTelegramWorkTask(item));
}

async function getTelegramTaskSpaceMap(env, { userId, taskIds }) {
  const ids = Array.from(new Set((Array.isArray(taskIds) ? taskIds : []).map((id) => String(id || '').trim()).filter(Boolean)));
  if (!ids.length) return new Map();
  const placeholders = ids.map(() => '?').join(', ');
  const result = await env.DB.prepare(`
    SELECT id, space_key
    FROM tasks
    WHERE user_id = ?
      AND id IN (${placeholders})
  `)
    .bind(String(userId), ...ids)
    .all();

  const map = new Map();
  (result.results || []).forEach((row) => {
    map.set(String(row.id), normalizeTaskSpaceKey(row.space_key));
  });
  return map;
}

function filterTelegramSectionsBySpaceMap(sections, taskSpaceMap, allowedSpaceKey = 'work') {
  const safeSections = sections && typeof sections === 'object' ? sections : {};
  const isAllowed = (item) => {
    const taskId = String(item && item.id || '').trim();
    if (!taskId) return false;
    return taskSpaceMap.get(taskId) === allowedSpaceKey;
  };
  return {
    primary: (Array.isArray(safeSections.primary) ? safeSections.primary : []).filter(isAllowed),
    additional: (Array.isArray(safeSections.additional) ? safeSections.additional : []).filter(isAllowed),
    recurring: (Array.isArray(safeSections.recurring) ? safeSections.recurring : []).filter(isAllowed),
  };
}

async function getTelegramControlDayContext(env, userId, dayOffset = 0) {
  const dayRange = getTelegramDayRange(dayOffset, TELEGRAM_CONTROL_TIMEZONE);
  const [scheduled, done] = await Promise.all([
    getScheduledTasksInRange(env, { userId: String(userId), fromIso: dayRange.fromIso, toIso: dayRange.toIso, limit: 200 }),
    getTasksByStatusUpdatedInRange(env, { userId: String(userId), status: TASK_STATUSES.DONE, fromIso: dayRange.fromIso, toIso: dayRange.toIso, limit: 200 }),
  ]);
  return {
    dayRange,
    scheduled: filterTelegramItemsToWorkSpace(scheduled).sort(compareTasksByDueAtAsc),
    done: filterTelegramItemsToWorkSpace(done).sort(compareTasksByDueAtAsc)
  };
}

async function getTelegramDayFactPayload(env, { userId, dayYmd, timeZone = TELEGRAM_CONTROL_TIMEZONE }) {
  const dayRange = getTelegramSpecificDayRange(dayYmd, timeZone);
  const [completedTasks, scheduleChanges] = await Promise.all([
    getTasksByStatusUpdatedInRange(env, { userId: String(userId), status: TASK_STATUSES.DONE, fromIso: dayRange.fromIso, toIso: dayRange.toIso, limit: 200 }),
    getTaskScheduleChangesInRange(env, { userId: String(userId), fromIso: dayRange.fromIso, toIso: dayRange.toIso, limit: 400 }),
  ]);

  const completed = filterTelegramItemsToWorkSpace(completedTasks).map((task) => ({
    task_id: task.id,
    title: task.title || 'Без названия',
    actual_minutes: normalizeOptionalTaskMinutes(task.actual_minutes, 1440),
  }));

  const completedIds = new Set(completed.map((item) => String(item.task_id)));
  const movedMap = new Map();

  (scheduleChanges || []).forEach((event) => {
    const payload = event && event.payload ? event.payload : null;
    if (!payload) return;
    if (!isTelegramWorkTask(event)) return;
    const taskId = String(event.task_id || '');
    if (!taskId || completedIds.has(taskId) || movedMap.has(taskId)) return;

    const previousDueAt = payload.previous_due_at || null;
    const nextDueAt = payload.next_due_at || null;
    const nextStatus = normalizeStatus(payload.next_status || null);

    const previousYmd = formatTelegramYmdFromIso(previousDueAt, timeZone);
    const nextYmd = formatTelegramYmdFromIso(nextDueAt, timeZone);

    if (previousYmd !== dayRange.ymd) return;
    if (nextStatus === TASK_STATUSES.DONE || nextStatus === TASK_STATUSES.CANCELED) return;
    if (nextYmd === dayRange.ymd) return;

    movedMap.set(taskId, {
      task_id: taskId,
      title: String(event.title || 'Без названия').trim() || 'Без названия',
      actual_minutes: normalizeOptionalTaskMinutes(event.actual_minutes, 1440),
      moved_to_ymd: nextYmd || null,
    });
  });

  return {
    dayRange,
    completed,
    moved: Array.from(movedMap.values()),
  };
}

function pickTelegramNextTaskCandidate(dayContext, inboxTasks) {
  const now = Date.now();
  const scheduled = Array.isArray(dayContext?.scheduled) ? dayContext.scheduled : [];
  const nextPlanned = scheduled.find((task) => {
    const dueTime = task?.due_at ? Date.parse(task.due_at) : NaN;
    return Number.isFinite(dueTime) && dueTime >= now - 5 * 60 * 1000;
  }) || scheduled[0] || null;
  if (nextPlanned) return { task: nextPlanned, sourceStatus: TASK_STATUSES.PLANNED };
  const inbox = Array.isArray(inboxTasks) ? inboxTasks.slice().sort(compareTasksByPriorityAndDue) : [];
  return inbox.length ? { task: inbox[0], sourceStatus: TASK_STATUSES.NEW } : null;
}

function buildTelegramTaskControlText(title, task, extraLines) {
  const lines = [title, "", `Задача: ${task.title}`];
  lines.push(`Проект: ${task.project_name || "Без проекта"}`);
  lines.push(`Плановая длительность: ${formatTelegramPlanDuration(getEffectivePlannedMinutesServer(task))}`);
  if (task.due_at) lines.push(`Время: ${formatTelegramClockFromIso(task.due_at)}`);
  if (task.ai_next_step) lines.push(`Следующий шаг: ${task.ai_next_step}`);
  if (Array.isArray(extraLines) && extraLines.length) {
    lines.push("");
    extraLines.forEach((line) => lines.push(line));
  }
  return lines.join("\n");
}

function suggestTelegramFocusDurationMinutes(task) {
  const planned = getEffectivePlannedMinutesServer(task);
  if (planned <= 20) return 15;
  if (planned <= 40) return 25;
  return 50;
}

async function handleTelegramPlanCommand(env, chatId, args, request) {
  const dayOffset = args && args[0] && String(args[0]).toLowerCase() === "tomorrow" ? 1 : 0;
  const context = await getTelegramControlDayContext(env, String(chatId), dayOffset);
  const sections = buildTelegramPlanSectionsFromTasks(context.scheduled);
  const text = buildTelegramDayPlanText({ dayYmd: context.dayRange.ymd, sections });
  await sendTelegramMessage(env, chatId, text, {
    reply_markup: buildTelegramPlannerOpenReplyMarkup(getAppUrlFromRequest(request, env), "Открыть день в Planner"),
  });
  return true;
}

async function handleTelegramNextCommand(env, chatId, request) {
  const [dayContext, inboxTasks] = await Promise.all([
    getTelegramControlDayContext(env, String(chatId), 0),
    getTasksByStatus(env, { userId: String(chatId), status: TASK_STATUSES.NEW, limit: TELEGRAM_COMMAND_LOOKUP_LIMIT }),
  ]);
  const candidate = pickTelegramNextTaskCandidate(dayContext, inboxTasks);
  if (!candidate || !candidate.task) {
    await sendTelegramMessage(env, chatId, "На сейчас ничего не нашёл: и день пустой, и новых задач нет.");
    return true;
  }
  const displayIndex = await getTaskDisplayIndexById(env, {
    userId: String(chatId),
    status: candidate.sourceStatus,
    taskId: candidate.task.id,
    limit: TELEGRAM_COMMAND_LOOKUP_LIMIT,
  });
  const commandPrefix = candidate.sourceStatus === TASK_STATUSES.PLANNED ? "planned" : "new";
  const lines = [
    candidate.sourceStatus === TASK_STATUSES.PLANNED ? "Следующее по плану" : "Следующая задача из входящих",
    "",
    `Задача: ${candidate.task.title}`,
    `Проект: ${candidate.task.project_name || "Без проекта"}`,
    `Плановая длительность: ${formatTelegramPlanDuration(getEffectivePlannedMinutesServer(candidate.task))}`,
  ];
  if (candidate.task.due_at) lines.push(`Время: ${formatTelegramClockFromIso(candidate.task.due_at)}`);
  if (candidate.task.ai_next_step) lines.push(`Следующий шаг: ${candidate.task.ai_next_step}`);
  if (displayIndex) {
    lines.push("");
    lines.push("Быстрые команды:");
    lines.push(`/focus ${commandPrefix} ${displayIndex}`);
    lines.push(`/done ${commandPrefix} ${displayIndex}`);
    lines.push(`/tomorrow ${commandPrefix} ${displayIndex}`);
  }
  await sendTelegramMessage(env, chatId, lines.join("\n"), {
    reply_markup: buildTelegramPlannerOpenReplyMarkup(getAppUrlFromRequest(request, env), "Открыть и выполнить"),
  });
  return true;
}

async function handleTelegramRestCommand(env, chatId) {
  const context = await getTelegramControlDayContext(env, String(chatId), 0);
  const now = Date.now();
  const overdue = [];
  const upcoming = [];
  (context.scheduled || []).forEach((task) => {
    const dueTime = task?.due_at ? Date.parse(task.due_at) : NaN;
    if (Number.isFinite(dueTime) && dueTime < now) overdue.push(task);
    else upcoming.push(task);
  });
  const lines = ["Остаток дня", ""];
  lines.push(`Осталось в плане: ${context.scheduled.length}`);
  lines.push(`Просрочено сегодня: ${overdue.length}`);
  lines.push("");
  lines.push("Дальше по дню");
  if (!upcoming.length) {
    lines.push("—");
  } else {
    upcoming.slice(0, 7).forEach((task, index) => {
      lines.push(`${index + 1}. ${formatTelegramClockFromIso(task.due_at)} · ${task.title} — ${formatTelegramPlanDuration(getEffectivePlannedMinutesServer(task))}`);
    });
  }
  if (overdue.length) {
    lines.push("");
    lines.push("Просрочено");
    overdue.slice(0, 5).forEach((task, index) => {
      lines.push(`${index + 1}. ${formatTelegramClockFromIso(task.due_at)} · ${task.title}`);
    });
  }
  await sendTelegramMessage(env, chatId, lines.join("\n"));
  return true;
}

async function handleTelegramFinishCommand(env, chatId, request) {
  const context = await getTelegramControlDayContext(env, String(chatId), 0);
  const donePlannedMinutes = (context.done || []).reduce((sum, task) => sum + getEffectivePlannedMinutesServer(task), 0);
  const remainingPlannedMinutes = (context.scheduled || []).reduce((sum, task) => sum + getEffectivePlannedMinutesServer(task), 0);
  const lines = ["Завершение дня", ""];
  lines.push(`Выполнено сегодня: ${context.done.length}`);
  lines.push(`План выполненного: ${formatTelegramPlanDuration(donePlannedMinutes)}`);
  lines.push(`Осталось в плане: ${context.scheduled.length}`);
  lines.push(`План остатка: ${formatTelegramPlanDuration(remainingPlannedMinutes)}`);
  if (context.scheduled.length) {
    lines.push("");
    lines.push("Что осталось");
    context.scheduled.slice(0, 7).forEach((task, index) => {
      lines.push(`${index + 1}. ${task.title} — ${formatTelegramPlanDuration(getEffectivePlannedMinutesServer(task))}`);
    });
    lines.push("");
    lines.push("Чтобы быстро перенести остаток на завтра:");
    lines.push(`/tomorrow planned 1`);
    if (context.scheduled.length > 1) lines.push(`/tomorrow planned 2`);
  }
  await sendTelegramMessage(env, chatId, lines.join("\n"), {
    reply_markup: buildTelegramPlannerOpenReplyMarkup(getAppUrlFromRequest(request, env), "Открыть Today"),
  });
  return true;
}

async function handleTelegramTomorrowCommand(env, chatId, args) {
  const resolved = await resolveTelegramTaskFromArgs(env, String(chatId), args, TASK_STATUSES.PLANNED);
  if (!resolved.ok) {
    await sendTelegramMessage(env, chatId, `Не удалось понять, какую задачу переносить.

Пример: /tomorrow planned 1`);
    return true;
  }
  const task = resolved.task;
  const currentStatus = normalizeStatus(task.status);
  if (currentStatus === TASK_STATUSES.DONE || currentStatus === TASK_STATUSES.CANCELED) {
    await sendTelegramMessage(env, chatId, 'Готовые или отменённые задачи на завтра не переношу.');
    return true;
  }
  let hour = TELEGRAM_DEFAULT_TOMORROW_HOUR;
  let minute = 0;
  if (task.due_at) {
    const parts = getTelegramTimeZoneDateParts(new Date(task.due_at), TELEGRAM_CONTROL_TIMEZONE);
    hour = parts.hour;
    minute = parts.minute;
  }
  const tomorrowYmd = addDaysToServerYmd(getTelegramTodayYmd(TELEGRAM_CONTROL_TIMEZONE), 1);
  const dueAt = zonedDateTimeToUtcIso(tomorrowYmd, hour, minute, TELEGRAM_CONTROL_TIMEZONE);
  const updatedTask = await updateTaskSchedule(env, {
    taskId: task.id,
    userId: String(chatId),
    dueAt,
    nextStatus: TASK_STATUSES.PLANNED,
    durationMinutes: task.duration_minutes,
  });
  await sendTelegramMessage(env, chatId, [
    'Перенёс на завтра.',
    '',
    `Задача: ${updatedTask.title}`,
    `Новое время: ${formatTelegramClockFromIso(updatedTask.due_at)}`,
    `Плановая длительность: ${formatTelegramPlanDuration(getEffectivePlannedMinutesServer(updatedTask))}`,
  ].join('\n'));
  return true;
}

async function handleTelegramFocusCommand(env, chatId, args, request) {
  let task = null;
  let sourceStatus = TASK_STATUSES.PLANNED;
  let displayIndex = null;

  if (args && args.length) {
    const resolved = await resolveTelegramTaskFromArgs(env, String(chatId), args, TASK_STATUSES.PLANNED);
    if (!resolved.ok) {
      await sendTelegramMessage(env, chatId, `Не удалось понять, для какой задачи подготовить фокус.\n\nПример: /focus planned 1`);
      return true;
    }
    task = resolved.task;
    sourceStatus = resolved.sourceStatus;
    displayIndex = resolved.index;
  } else {
    const [dayContext, inboxTasks] = await Promise.all([
      getTelegramControlDayContext(env, String(chatId), 0),
      getTasksByStatus(env, { userId: String(chatId), status: TASK_STATUSES.NEW, limit: TELEGRAM_COMMAND_LOOKUP_LIMIT }),
    ]);
    const candidate = pickTelegramNextTaskCandidate(dayContext, inboxTasks);
    if (candidate && candidate.task) {
      task = candidate.task;
      sourceStatus = candidate.sourceStatus;
      displayIndex = await getTaskDisplayIndexById(env, {
        userId: String(chatId),
        status: sourceStatus,
        taskId: task.id,
        limit: TELEGRAM_COMMAND_LOOKUP_LIMIT,
      });
    }
  }

  if (!task) {
    await sendTelegramMessage(env, chatId, 'Не нашёл задачу для фокуса. Попробуй сначала /next или /plan.');
    return true;
  }

  const lines = [
    'Фокус на задаче',
    '',
    `Задача: ${task.title}`,
    `Проект: ${task.project_name || 'Без проекта'}`,
    `Плановая длительность: ${formatTelegramPlanDuration(getEffectivePlannedMinutesServer(task))}`,
    `Рекомендуемая сессия: ${suggestTelegramFocusDurationMinutes(task)} мин`,
  ];
  if (task.ai_next_step) lines.push(`Следующий шаг: ${task.ai_next_step}`);
  lines.push('', 'Таймер и запись факта запускаются внутри Planner.');
  if (displayIndex) {
    const commandPrefix = sourceStatus === TASK_STATUSES.PLANNED ? 'planned' : 'new';
    lines.push('');
    lines.push('Быстрые команды:');
    lines.push(`/done ${commandPrefix} ${displayIndex}`);
    lines.push(`/tomorrow ${commandPrefix} ${displayIndex}`);
  }
  await sendTelegramMessage(env, chatId, lines.join('\n'), {
    reply_markup: buildTelegramPlannerOpenReplyMarkup(getAppUrlFromRequest(request, env), 'Открыть и начать фокус'),
  });
  return true;
}

function getTelegramDayPlanCountsFromSections(sections) {
  const safeSections = sections || {};
  const primary = Array.isArray(safeSections.primary) ? safeSections.primary : [];
  const additional = Array.isArray(safeSections.additional) ? safeSections.additional : [];
  const recurring = Array.isArray(safeSections.recurring) ? safeSections.recurring : [];
  const total = primary.length + additional.length + recurring.length;
  const planned_minutes = primary.concat(additional).concat(recurring).reduce((sum, item) => sum + (Number(item?.planned_minutes) || 0), 0);
  return {
    primary: primary.length,
    additional: additional.length,
    recurring: recurring.length,
    total,
    planned_minutes,
  };
}

async function getTelegramDayPlanPayload(env, { userId, dayYmd = null, timeZone = TELEGRAM_CONTROL_TIMEZONE, sections = null }) {
  let targetDayYmd = dayYmd ? String(dayYmd).trim() : null;
  let safeSections = sections || null;
  if (!safeSections) {
    const dayRange = targetDayYmd ? getTelegramSpecificDayRange(targetDayYmd, timeZone) : getTelegramDayRange(0, timeZone);
    targetDayYmd = dayRange.ymd;
    const scheduled = await getScheduledTasksInRange(env, {
      userId: String(userId),
      fromIso: dayRange.fromIso,
      toIso: dayRange.toIso,
      limit: 200,
    });
    safeSections = buildTelegramPlanSectionsFromTasks(filterTelegramItemsToWorkSpace(scheduled).sort(compareTasksByDueAtAsc));
  } else {
    const taskIds = [];
    ['primary', 'additional', 'recurring'].forEach((key) => {
      const items = Array.isArray(safeSections[key]) ? safeSections[key] : [];
      items.forEach((item) => {
        const taskId = String(item && item.id || '').trim();
        if (taskId) taskIds.push(taskId);
      });
    });
    const taskSpaceMap = await getTelegramTaskSpaceMap(env, { userId: String(userId), taskIds });
    safeSections = filterTelegramSectionsBySpaceMap(safeSections, taskSpaceMap, 'work');
  }
  const counts = getTelegramDayPlanCountsFromSections(safeSections);
  const text = buildTelegramDayPlanText({ dayYmd: targetDayYmd, sections: safeSections });
  return { dayYmd: targetDayYmd, sections: safeSections, counts, text };
}

async function sendTelegramDayPlanMessage(env, { userId, dayYmd = null, timeZone = TELEGRAM_CONTROL_TIMEZONE, sections = null, replyMarkup = null }) {
  const payload = await getTelegramDayPlanPayload(env, { userId, dayYmd, timeZone, sections });
  const telegram = await sendTelegramMessage(env, userId, payload.text, replyMarkup ? { reply_markup: replyMarkup } : undefined);
  if (!telegram || telegram.ok === false) {
    throw new Error(telegram?.description || 'Telegram sendMessage failed');
  }
  return { telegram, text: payload.text, counts: payload.counts, day_ymd: payload.dayYmd, sections: payload.sections };
}

