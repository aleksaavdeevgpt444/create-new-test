        var actions = document.createElement('div');
        actions.className = 'editor-task-help-summary-actions';
        [
          createEditorTaskHelpAction(data.sourceType === 'ai' ? 'Обновить AI-разбор' : 'AI-разбор', data.sourceType === 'ai' ? 'btn-secondary' : 'btn-primary', function () { requestEditorTaskHelpAi(); }),
          createEditorTaskHelpAction('К продукту', 'btn-ghost', function () { scrollEditorFieldIntoView('editorProductInput'); }),
          createEditorTaskHelpAction('К описанию', 'btn-ghost', function () { scrollEditorFieldIntoView('editorDescriptionInput'); }),
          createEditorTaskHelpAction('К времени', 'btn-ghost', function () { openTimeDialog('editor'); })
