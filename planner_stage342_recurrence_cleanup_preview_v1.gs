      if (authFailure) return authFailure;
      try {
        const now = new Date().toISOString();
        const taskId = crypto.randomUUID();
        const title = `Тестовая задача ${now}`;

        await insertTask(env, {
          id: taskId,
          user_id: "demo-user",
          title,
          description: "Первая тестовая задача из Cloudflare Worker",
          status: TASK_STATUSES.NEW,
          priority_manual: null,
          priority_ai: null,
          project_name: "MVP",
