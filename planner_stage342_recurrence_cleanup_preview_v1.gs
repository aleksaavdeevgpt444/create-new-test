            : (aiNextTask
              ? 'У задачи ещё нет AI next step. Открой редактор и нажми «Следующий шаг AI» — система предложит конкретное действие.'
              : 'Выдели главную задачу дня, чтобы AI помог сформулировать конкретный следующий шаг.'),
          meta: aiNextTask
            ? [createChip(aiNextTask.title ? aiNextTask.title.slice(0, 30) : 'Без названия'), createChip(aiNextStep ? 'Шаг задан' : 'Нет шага')]
            : [createChip('Главные задачи: ' + String(data.mainTasks.length || 0))],
          accent: !!aiNextStep,
          actions: aiNextTask ? [
            { label: 'Открыть задачу', className: 'btn-secondary', handler: function () { openEditor(aiNextTask.id); } },
            { label: 'Фокус', className: 'btn-ghost', handler: function () { startFocusModeFromTaskId(aiNextTask.id); } }
          ] : [
            { label: 'Выбрать главные', className: 'btn-ghost', handler: function () { openDayRitualDialog(dayYmd || state.dayYmd || formatYmdLocal(new Date())); } }
          ]
        }));
