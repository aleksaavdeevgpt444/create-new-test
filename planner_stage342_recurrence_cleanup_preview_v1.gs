        ['task', 'day', 'week', 'project'].forEach(function (scope) {
          var target = String(bundle.defaults && bundle.defaults[scope] || '').trim().toLowerCase();
          next.defaults[scope] = getFrameworkMeta(target) ? target : '';
        });
        return normalizeFrameworkSettings(next);
      }


      function buildFrameworkSettingsAfterSingleFramework(frameworkId) {
        var key = String(frameworkId || '').trim().toLowerCase();
        var next = normalizeFrameworkSettings(state.frameworkSettings || getDefaultFrameworkSettings());
