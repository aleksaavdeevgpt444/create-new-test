      function ensurePlannerActionDialog() {
        var existing = byId('plannerActionDialogBackdrop');
        if (existing) return existing;
        var backdrop = document.createElement('div');
        backdrop.id = 'plannerActionDialogBackdrop';
        backdrop.className = 'planner-action-dialog-backdrop';
        backdrop.innerHTML = '' +
          '<div class="planner-action-dialog" role="dialog" aria-modal="true">' +
            '<div id="plannerActionDialogTitle" class="planner-action-dialog-title">Подтверждение</div>' +
            '<div id="plannerActionDialogText" class="planner-action-dialog-text">—</div>' +
            '<div id="plannerActionDialogActions" class="planner-action-dialog-actions"></div>' +
          '</div>';
        document.body.appendChild(backdrop);
        backdrop.addEventListener('click', function (event) {
          if (event.target !== backdrop) return;
          if (typeof backdrop.__resolve === 'function') {
            var resolve = backdrop.__resolve;
            backdrop.__resolve = null;
            backdrop.style.display = 'none';
            resolve(null);
          }
        });
        document.addEventListener('keydown', function (event) {
          if (event.key !== 'Escape') return;
          if (!backdrop.__resolve) return;
          var resolve = backdrop.__resolve;
          backdrop.__resolve = null;
          backdrop.style.display = 'none';
          resolve(null);
        });
        return backdrop;
      }

      function showPlannerActionDialog(options) {
        options = options || {};
        var backdrop = ensurePlannerActionDialog();
        var title = byId('plannerActionDialogTitle');
        var text = byId('plannerActionDialogText');
        var actions = byId('plannerActionDialogActions');
        if (title) title.textContent = options.title || 'Подтверждение';
        if (text) text.textContent = options.text || '';
        if (actions) {
          actions.innerHTML = '';
          var list = Array.isArray(options.actions) ? options.actions.slice() : [];
          actions.classList.toggle('single', list.length <= 1);
          list.forEach(function (item) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = item.className || 'btn-secondary';
            btn.textContent = item.label || 'OK';
            btn.addEventListener('click', function () {
              var resolve = backdrop.__resolve;
              backdrop.__resolve = null;
              backdrop.style.display = 'none';
              if (resolve) resolve(item.value);
            });
            actions.appendChild(btn);
          });
        }
        backdrop.style.display = 'flex';
        return new Promise(function (resolve) {
          backdrop.__resolve = resolve;
        });
      }

      async function confirmPlannerAction(options) {
