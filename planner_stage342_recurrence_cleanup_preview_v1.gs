    await logAiLocalFallback(env, 'task-advice', { user_id: options && options.userId ? String(options.userId) : null, task_id: options && options.taskId ? String(options.taskId) : null, title: sourceText, project_name: options && options.project_name ? String(options.project_name) : '' }, error, getAiProviderMeta(normalized), 'AI task advice soft fallback used');
    return normalized;
  }
}

function getConfiguredGeminiApiKey(env) {
  const key = String(env && env.GEMINI_API_KEY || '').trim();
  return key || null;
}

function parseBooleanEnvValue(value, fallback = false) {
  if (value === undefined || value === null || value === '') return !!fallback;
  const safe = String(value).trim().toLowerCase();
  if (!safe) return !!fallback;
  if (['1', 'true', 'yes', 'on'].includes(safe)) return true;
  if (['0', 'false', 'no', 'off'].includes(safe)) return false;
  return !!fallback;
}

function getConfiguredGeminiGenerationModel(env) {
  const candidates = [env && env.GEMINI_MODEL, env && env.GEMINI_GENERATION_MODEL, GEMINI_GENERATION_MODEL_DEFAULT];
  for (let i = 0; i < candidates.length; i += 1) {
    const safe = String(candidates[i] || '').trim();
    if (safe) return safe;
  }
  return GEMINI_GENERATION_MODEL_DEFAULT;
}

function getConfiguredGeminiEmbeddingModel(env) {
  const candidates = [env && env.GEMINI_EMBEDDING_MODEL, GEMINI_EMBEDDING_MODEL_DEFAULT];
  for (let i = 0; i < candidates.length; i += 1) {
    const safe = String(candidates[i] || '').trim();
    if (safe) return safe;
  }
  return GEMINI_EMBEDDING_MODEL_DEFAULT;
}

function getConfiguredGeminiEmbeddingDimension(env) {
  const parsed = Number(env && env.GEMINI_EMBEDDING_DIMENSION);
  if (Number.isFinite(parsed) && parsed >= 128 && parsed <= 3072) return Math.round(parsed);
  return GEMINI_EMBEDDING_DIMENSION_DEFAULT;
}

function isAiEmbeddingHintsEnabled(env) {
  return parseBooleanEnvValue(env && env.AI_USE_EMBEDDING_HINTS, false) || parseBooleanEnvValue(env && env.GEMINI_EMBEDDING_ENABLED, false);
}

function getConfiguredEmbeddingSimilarTaskLimit(env) {
  const parsed = Number(env && env.GEMINI_EMBEDDING_SIMILAR_TASK_LIMIT);
  if (Number.isFinite(parsed) && parsed >= 1 && parsed <= 15) return Math.round(parsed);
  return GEMINI_EMBEDDING_SIMILAR_TASK_LIMIT_DEFAULT;
}

async function readResponseTextSafe(response) {
  try {
    return await response.text();
  } catch (error) {
    return '';
  }
}

function tryParseJsonSafe(value) {
  if (value === null || value === undefined) return null;
  const raw = String(value).trim();
  if (!raw) return null;
  try {
    return JSON.parse(raw);
  } catch (error) {
    return null;
  }
}

function extractGeminiCandidateText(data) {
  return data?.candidates?.[0]?.content?.parts?.map((part) => part?.text || '').join('').trim() || '';
}

async function callGeminiJsonWithSchema(env, body) {
  const apiKey = getConfiguredGeminiApiKey(env);
  if (!apiKey) throw new Error('GEMINI_API_KEY is not configured');

  // STAGE 288 — server hardening: timeout-safe fetch вместо «голого».
  // fetchWithAiTimeout уже определён ниже (function hoisting обеспечивает
  // доступность function declarations глобально, поэтому порядок не важен)
  // и используется аналогичными провайдерами (callGeminiFamilyJsonWithSchema,
  // callQwenGroqJsonWithSchema). Реюз даёт единый таймаут-механизм для
  // всех Gemini-вызовов и единый AbortError при таймауте.
  const timeoutMs = getConfiguredAiProviderTimeoutMs(env, null);
  const response = await fetchWithAiTimeout(
    `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(getConfiguredGeminiGenerationModel(env))}:generateContent?key=${apiKey}`,
    {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    },
    timeoutMs,
    'Gemini'
  );

  const rawText = await readResponseTextSafe(response);
  const data = tryParseJsonSafe(rawText);
  if (!response.ok) {
    const message = data?.error?.message || rawText || ('Gemini HTTP ' + response.status);
    throw new Error(message);
  }

  const candidateText = extractGeminiCandidateText(data || {});
  const parsed = tryParseJsonSafe(candidateText);
  if (!parsed) throw new Error('Gemini returned invalid JSON');
  return parsed;
}

function normalizeGeminiEmbeddingValues(data) {
  const values = data?.embedding?.values || data?.embeddings?.[0]?.values || null;
  if (!Array.isArray(values) || !values.length) throw new Error('Gemini embedding returned empty vector');
  return values.map((item) => Number(item) || 0);
}

function normalizeVectorL2(values) {
  const safe = Array.isArray(values) ? values.map((item) => Number(item) || 0) : [];
  const norm = Math.sqrt(safe.reduce((sum, value) => sum + value * value, 0));
  if (!norm) return safe;
  return safe.map((value) => value / norm);
}

function cosineSimilarityNormalized(a, b) {
  const length = Math.min(Array.isArray(a) ? a.length : 0, Array.isArray(b) ? b.length : 0);
  if (!length) return 0;
  let sum = 0;
  for (let i = 0; i < length; i += 1) sum += (Number(a[i]) || 0) * (Number(b[i]) || 0);
  return sum;
}

function buildTaskSemanticSourceText(taskLike) {
  return [
    taskLike?.title ? 'Название: ' + String(taskLike.title).trim() : '',
    taskLike?.task_product ? 'Продукт: ' + String(taskLike.task_product).trim() : '',
    taskLike?.description ? 'Описание: ' + String(taskLike.description).trim() : '',
    taskLike?.project_name ? 'Проект: ' + String(taskLike.project_name).trim() : ''
  ].filter(Boolean).join('\n');
}

async function sha256Hex(value) {
  const safe = String(value || '');
  const buffer = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(safe));
  return [...new Uint8Array(buffer)].map((item) => item.toString(16).padStart(2, '0')).join('');
}

async function callGeminiTextEmbedding(env, text, { taskType = 'SEMANTIC_SIMILARITY', outputDimensionality = null } = {}) {
  const apiKey = getConfiguredGeminiApiKey(env);
  if (!apiKey) throw new Error('GEMINI_API_KEY is not configured');
  const model = getConfiguredGeminiEmbeddingModel(env);
  const body = {
    model: 'models/' + model,
    content: { parts: [{ text: String(text || '').trim() }] },
    taskType: String(taskType || 'SEMANTIC_SIMILARITY').trim() || 'SEMANTIC_SIMILARITY'
  };
  const dimension = Number(outputDimensionality);
  if (Number.isFinite(dimension) && dimension >= 128 && dimension <= 3072) body.output_dimensionality = Math.round(dimension);

  // STAGE 288 — server hardening: timeout-safe fetch.
  // Вызывается из горячих путей создания/обновления задач (см. строки 2631 и 2671)
  // — без таймаута зависший Gemini Embedding API мог блокировать весь Worker.
  const timeoutMs = getConfiguredAiProviderTimeoutMs(env, null);
  const response = await fetchWithAiTimeout(
    `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:embedContent?key=${apiKey}`,
    {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body)
    },
    timeoutMs,
    'Gemini Embedding'
  );
  const rawText = await readResponseTextSafe(response);
  const data = tryParseJsonSafe(rawText);
  if (!response.ok) {
    const message = data?.error?.message || rawText || ('Gemini Embedding HTTP ' + response.status);
    throw new Error(message);
  }
  return normalizeVectorL2(normalizeGeminiEmbeddingValues(data || {}));
}

async function ensureTaskEmbeddingsSchema(env) {
  await ensureTasksSchema(env);
  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS task_embeddings (
      user_id TEXT NOT NULL,
      task_id TEXT NOT NULL,
      model TEXT NOT NULL,
      source_hash TEXT NOT NULL,
      source_text TEXT,
      vector_json TEXT NOT NULL,
      dimension INTEGER,
      created_at TEXT NOT NULL,
      updated_at TEXT NOT NULL,
      PRIMARY KEY (user_id, task_id, model)
    )
  `).run();
  await env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_task_embeddings_user_updated ON task_embeddings(user_id, updated_at DESC)`).run();
}

async function getStoredTaskEmbedding(env, { userId, taskId, model }) {
  await ensureTaskEmbeddingsSchema(env);
  return env.DB.prepare(`SELECT user_id, task_id, model, source_hash, source_text, vector_json, dimension, updated_at FROM task_embeddings WHERE user_id = ? AND task_id = ? AND model = ? LIMIT 1`)
    .bind(String(userId), String(taskId), String(model))
    .first();
}

async function upsertTaskEmbedding(env, { userId, taskId, model, sourceHash, sourceText, vector, dimension }) {
  await ensureTaskEmbeddingsSchema(env);
  const now = new Date().toISOString();
  await env.DB.prepare(`
    INSERT INTO task_embeddings (user_id, task_id, model, source_hash, source_text, vector_json, dimension, created_at, updated_at)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
    ON CONFLICT(user_id, task_id, model) DO UPDATE SET
      source_hash = excluded.source_hash,
      source_text = excluded.source_text,
      vector_json = excluded.vector_json,
      dimension = excluded.dimension,
      updated_at = excluded.updated_at
  `).bind(String(userId), String(taskId), String(model), String(sourceHash), String(sourceText || ''), JSON.stringify(vector || []), Number(dimension) || null, now, now).run();
}

/**
 * @param {any} env
 * @param {{ task?: any, force?: boolean }} [options]
 */
async function getTaskEmbeddingVector(env, { task, force = false } = {}) {
  if (!task || !task.id || !task.user_id) return null;
  const model = getConfiguredGeminiEmbeddingModel(env);
  const sourceText = buildTaskSemanticSourceText(task);
  if (!sourceText) return null;
  const sourceHash = await sha256Hex(sourceText);
  if (!force) {
    const stored = await getStoredTaskEmbedding(env, { userId: task.user_id, taskId: task.id, model });
    if (stored && String(stored.source_hash || '') === sourceHash) {
      const parsed = tryParseJsonSafe(stored.vector_json);
      if (Array.isArray(parsed) && parsed.length) return parsed.map((item) => Number(item) || 0);
    }
  }
  const vector = await callGeminiTextEmbedding(env, sourceText, { taskType: 'SEMANTIC_SIMILARITY', outputDimensionality: getConfiguredGeminiEmbeddingDimension(env) });
  await upsertTaskEmbedding(env, {
    userId: task.user_id,
    taskId: task.id,
    model,
    sourceHash,
    sourceText,
    vector,
    dimension: vector.length
  });
  return vector;
}

/**
 * @param {any} env
 * @param {{ userId?: string|null, excludeTaskId?: string|null, limit?: number }} [options]
 */
async function listSemanticCandidateTasks(env, { userId, excludeTaskId = null, limit = 12 } = {}) {
  await ensureTasksSchema(env);
  const safeLimit = Math.max(1, Math.min(Number(limit) || 12, 30));
  const result = excludeTaskId
    ? await env.DB.prepare(`SELECT ${TASK_SELECT_FIELDS} FROM tasks WHERE user_id = ? AND id <> ? ORDER BY updated_at DESC LIMIT ?`).bind(String(userId), String(excludeTaskId), safeLimit).all()
    : await env.DB.prepare(`SELECT ${TASK_SELECT_FIELDS} FROM tasks WHERE user_id = ? ORDER BY updated_at DESC LIMIT ?`).bind(String(userId), safeLimit).all();
  return result.results || [];
}

/**
 * @param {any} env
 * @param {{ userId?: string|null, taskId?: string|null, text?: string, limit?: number|null }} [options]
 */
async function findSimilarTasksByEmbedding(env, { userId, taskId = null, text = '', limit = null } = {}) {
  const normalizedUserId = String(userId || '').trim();
  if (!normalizedUserId) return [];
  const safeLimit = Math.max(1, Math.min(Number(limit) || getConfiguredEmbeddingSimilarTaskLimit(env), 10));
  const sourceTask = taskId ? await getTaskById(env, { taskId: String(taskId), userId: normalizedUserId }) : null;
  const sourceText = sourceTask ? buildTaskSemanticSourceText(sourceTask) : String(text || '').trim();
  if (!sourceText) return [];

  const queryVector = sourceTask
    ? await getTaskEmbeddingVector(env, { task: sourceTask })
    : await callGeminiTextEmbedding(env, sourceText, { taskType: 'SEMANTIC_SIMILARITY', outputDimensionality: getConfiguredGeminiEmbeddingDimension(env) });
  if (!queryVector || !queryVector.length) return [];

  const candidates = await listSemanticCandidateTasks(env, { userId: normalizedUserId, excludeTaskId: sourceTask ? sourceTask.id : taskId, limit: Math.max(safeLimit * 3, 12) });
  const scored = [];
  for (let i = 0; i < candidates.length; i += 1) {
    const candidate = candidates[i];
    const candidateVector = await getTaskEmbeddingVector(env, { task: candidate });
    if (!candidateVector || !candidateVector.length) continue;
    scored.push({
      task_id: candidate.id,
      title: String(candidate.title || '').trim(),
      project_name: String(candidate.project_name || '').trim(),
      task_product: String(candidate.task_product || '').trim(),
      similarity: Number(cosineSimilarityNormalized(queryVector, candidateVector).toFixed(4))
    });
  }
  return scored.sort((a, b) => b.similarity - a.similarity).slice(0, safeLimit);
}

/**
 * @param {any} env
 * @param {{ userId?: string|null, taskId?: string|null, text?: string, label?: string }} [options]
 */
async function buildAiSemanticHintsText(env, { userId = null, taskId = null, text = '', label = 'Похожие задачи' } = {}) {
  if (!isAiEmbeddingHintsEnabled(env)) return '';
  const normalizedUserId = String(userId || '').trim();
  if (!normalizedUserId) return '';
  try {
    const similar = await findSimilarTasksByEmbedding(env, { userId: normalizedUserId, taskId: taskId || null, text: text || '', limit: getConfiguredEmbeddingSimilarTaskLimit(env) });
    if (!similar.length) return '';
    const lines = [String(label || 'Похожие задачи') + ':'];
    similar.forEach((item, index) => {
      const parts = [
        `${index + 1}. ${item.title || 'Без названия'}`,
        item.project_name ? `проект: ${item.project_name}` : '',
        item.task_product ? `продукт: ${item.task_product}` : '',
        `сходство: ${item.similarity}`
      ].filter(Boolean);
      lines.push(parts.join(' · '));
    });
    return lines.join('\n');
  } catch (error) {
    return '';
  }
}

async function handleTaskSimilarByEmbeddingApi(request, env) {
  if (request.method !== 'POST') return textResponse('Method Not Allowed', 405);
  let body = null;
  try {
    body = await request.json();
    const userId = String(body?.user_id || '').trim();
    if (!userId) return jsonResponse({ ok: false, error: 'user_id is required' }, { status: 400 });
    const similar = await findSimilarTasksByEmbedding(env, {
      userId,
      taskId: body?.task_id ? String(body.task_id) : null,
      text: body?.text ? String(body.text) : '',
      limit: body?.limit || null
    });
    return jsonResponse({
      ok: true,
      build: getClientAppBuildLabel(),
      ai_module_version: AI_MODULE_VERSION,
      embedding_model: getConfiguredGeminiEmbeddingModel(env),
      embedding_dimension: getConfiguredGeminiEmbeddingDimension(env),
      similar
    });
  } catch (error) {
    const report = await reportAiEndpointFailure(env, request, 'similar-by-embedding', body || {}, error);
    return jsonResponse({ ok: false, build: getClientAppBuildLabel(), error: error && error.message ? String(error.message) : String(error), telegram_report: report || null }, { status: 500 });
  }
}

