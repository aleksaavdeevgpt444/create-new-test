      function getTodayOsActionSuggestion(dayYmd, data) {
        var now = new Date();
        var scheduled = getTasksForDay(dayYmd).filter(function (task) {
          return task && task.due_at && normalizeStatus(task.status) === STATUS.PLANNED;
        }).sort(compareTasksByDueAndUpdated);
        var currentTask = null;
        for (var i = 0; i < scheduled.length; i += 1) {
          var start = new Date(scheduled[i].due_at);
          var end = new Date(start.getTime() + getTaskDurationMinutes(scheduled[i]) * 60000);
          if (start <= now && end >= now) { currentTask = scheduled[i]; break; }
        }
        if (currentTask) {
          return { mode: 'current', label: 'Сейчас в работе', note: 'Задача уже стоит в текущем слоте. Можно сразу открыть её или запустить фокус.', task: currentTask };
        }
        if (data.nextTasks && data.nextTasks.length) {
          return { mode: 'next', label: 'Следующее действие', note: 'Ближайшая timeboxed-задача на день. Её удобно открыть заранее или поставить напоминание.', task: data.nextTasks[0] };
        }
        if (data.mainTasks && data.mainTasks.length && !data.mainTasks[0].due_at) {
          return { mode: 'schedule-main', label: 'Втянуть главную в день', note: 'Главная задача ещё без времени — можно поставить её в ближайший свободный слот.', task: data.mainTasks[0] };
        }
        if (data.noTimeTasks && data.noTimeTasks.length) {
          return { mode: 'schedule-backlog', label: 'Свободное окно дня', note: 'Есть задача без времени, которую можно быстро втянуть в день.', task: data.noTimeTasks[0] };
        }
        if (data.overflowTasks && data.overflowTasks.length) {
          return { mode: 'overflow', label: 'Разгрузить день', note: 'День перегружен: лучше снять часть задач или перенести их на завтра.', task: data.overflowTasks[0] };
        }
        return null;
      }

