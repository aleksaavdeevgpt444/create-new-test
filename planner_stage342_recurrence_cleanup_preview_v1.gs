      async function sendTelegramTaskNotification(task, settings, triggerIso, typeKeys) {
        var response = await requestJson('/telegram/send-task-reminder', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            user_id: state.userId,
            task_id: task.id,
            lead_minutes: Number(settings && settings.leadMinutes || 0),
            scope: String(settings && settings.scope || 'all'),
            day_ymd: state.dayYmd || formatYmdLocal(new Date()),
            trigger_at: triggerIso,
            types: Array.isArray(typeKeys) ? typeKeys : []
          }),
          __meta: { requestName: 'telegram-task-reminder', retryCount: 1, retryDelayMs: 400 }
        });
        setTelegramTaskNotifyState({
          lastTaskTitle: String(task && task.title || '').trim(),
          lastTaskId: String(task && task.id || '').trim(),
          lastSentAt: new Date().toISOString(),
          lastStatus: 'sent',
          lastError: '',
          sentCount: normalizeTelegramTaskNotifyState(state.telegramTaskNotifyState).sentCount + 1
        });
        return response;
      }

      async function checkDueTelegramTaskNotifications() {
