          noteBody.textContent = notesText;
          noteBox.appendChild(noteBody);
          card.appendChild(noteBox);
        }

        var metrics = document.createElement('div');
        metrics.className = 'project-metrics';
        metrics.appendChild(createProjectMetricCard('Today', item.stats.todayCount));
        metrics.appendChild(createProjectMetricCard('Неделя', item.stats.weekCount));
        metrics.appendChild(createProjectMetricCard('Backlog', item.stats.backlogCount));
        metrics.appendChild(createProjectMetricCard('Гант', item.stats.scheduledCount));
        metrics.appendChild(createProjectMetricCard('План', formatMinutesHoursLabel(item.stats.plannedMinutes)));
        metrics.appendChild(createProjectMetricCard('Факт', formatMinutesHoursLabel(item.stats.actualMinutes)));
        card.appendChild(metrics);

        var links = parseProjectLinksText(item.meta && item.meta.links_text);
        if (links.length) {
          var linksBox = document.createElement('div');
          linksBox.className = 'project-links';
