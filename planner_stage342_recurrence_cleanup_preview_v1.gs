function getStatusLabel(status) {
  const normalized = normalizeStatus(status);
  if (normalized === TASK_STATUSES.NEW) return "новые";
  if (normalized === TASK_STATUSES.PLANNED) return "в плане";
  if (normalized === TASK_STATUSES.DONE) return "выполнены";
  if (normalized === TASK_STATUSES.CANCELED) return "отменены";
  if (normalized === TASK_STATUSES.POSTPONED) return "перенесены";
  return status || "неизвестно";
}

function getStatusSingular(status) {
  const normalized = normalizeStatus(status);
  if (normalized === TASK_STATUSES.NEW) return "новая";
  if (normalized === TASK_STATUSES.PLANNED) return "в плане";
  if (normalized === TASK_STATUSES.DONE) return "выполнена";
  if (normalized === TASK_STATUSES.CANCELED) return "отменена";
  if (normalized === TASK_STATUSES.POSTPONED) return "перенесена";
  return status || "неизвестно";
}

function getPriorityLabelByNumber(priorityNumber) {
  if (priorityNumber === 3) return "высокий";
  if (priorityNumber === 2) return "средний";
  if (priorityNumber === 1) return "низкий";
  return "не задан";
}

function mapPriorityLevelToNumber(priorityLevel) {
  if (priorityLevel === "high") return 3;
  if (priorityLevel === "medium") return 2;
  if (priorityLevel === "low") return 1;
  return null;
}

function mapPriorityLevelToLabel(priorityLevel) {
  if (priorityLevel === "high") return "высокий";
  if (priorityLevel === "medium") return "средний";
  if (priorityLevel === "low") return "низкий";
  return "не определён";
}

function normalizePriorityManualValue(value) {
  if (value === null || value === undefined || value === "") return null;
  const parsed = Number(value);
  if (!Number.isFinite(parsed)) return null;
  if (parsed < 1 || parsed > 3) return null;
  return Math.round(parsed);
}

function formatTaskLine(task, index, options = {}) {
  const showStatus = options.showStatus === true;
  const projectName = task.project_name || "Без проекта";
  const priorityLabel = getPriorityLabelByNumber(task.priority_ai);
  const metaParts = [`Проект: ${projectName}`, `приоритет: ${priorityLabel}`];
  if (showStatus) metaParts.unshift(`статус: ${getStatusLabel(task.status)}`);
  return `${index + 1}. ${task.title}\n   ${metaParts.join(" · ")}`;
}

function buildTasksListText(title, tasks, options = {}) {
  if (!tasks.length) return `${title}\n\nПока пусто.`;
  const lines = tasks.map((task, index) => formatTaskLine(task, index, options));
  return `${title}\n\n${lines.join("\n\n")}`;
}

