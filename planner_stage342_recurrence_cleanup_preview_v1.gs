      // STAGE 295 — Strategic Portfolio Dashboard.
      // Читает уже существующие project profiles и задачи, не меняет task schema
      // и не добавляет новый server contract. Задача этапа — дать Strategic Engines
      // рабочий обзор: что уже заполнено, где OKR/RICE, где риски и что открыть первым.
      function buildKnowledgeStrategicPortfolioEntries() {
        var projectMap = Object.create(null);
        (state.allProjects || []).forEach(function (project) {
          var key = normalizeProjectName(project && project.name);
          if (!key || key === 'Без проекта') return;
          if (!projectMap[key]) projectMap[key] = { name: key, meta: project || null, tasks: [] };
          else projectMap[key].meta = project || projectMap[key].meta;
        });
        getShellTasks().forEach(function (task) {
          var key = normalizeProjectName(task && task.project_name);
          if (!key || key === 'Без проекта') return;
          if (!projectMap[key]) projectMap[key] = { name: key, meta: null, tasks: [] };
          projectMap[key].tasks.push(task);
        });
        Object.keys(state.projectStrategyProfiles || {}).forEach(function (key) {
          var name = normalizeProjectName(key);
          if (!name || name === 'Без проекта') return;
          if (!projectMap[name]) projectMap[name] = { name: name, meta: null, tasks: [] };
        });
        return Object.keys(projectMap).map(function (key) {
          var item = projectMap[key] || { name: key, tasks: [] };
          var stats = getProjectStats(item.tasks || []);
          var summary = buildProjectStrategicSummary(item.name, item.tasks || []);
          var profile = summary.profile || normalizeProjectStrategyProfile({});
          var hasProfile = !!(
            profile.primaryMethod || profile.impact || profile.effort || profile.reach || profile.confidence ||
            profile.moscow || profile.rollingWave || profile.objective || profile.keyResultTitle ||
            profile.keyResultCurrent || profile.keyResultTarget || profile.bottleneckNote || profile.cycleGoal || profile.quadrant2Focus
          );
          var readinessParts = [
            profile.primaryMethod,
            profile.impact && profile.effort,
            profile.reach && profile.impact && profile.confidence && profile.effort,
            profile.objective || profile.keyResultTitle,
            profile.rollingWave || profile.moscow,
            profile.bottleneckNote || summary.blockedCount || summary.criticalTask,
            profile.cycleGoal || profile.quadrant2Focus
          ].filter(Boolean).length;
          var riskScore = (stats.overdueCount || 0) * 3 + (summary.blockedCount || 0) * 2 + (summary.criticalTask ? 3 : 0) + (stats.backlogCount > 0 ? 1 : 0);
          var priorityScore = (summary.riceScore || 0) + (summary.impactEffortQuadrant === 'Быстрая победа' ? 5 : 0) + (summary.okrProgress > 0 ? summary.okrProgress / 20 : 0) + readinessParts;
          return {
            name: item.name,
            meta: item.meta || null,
            tasks: item.tasks || [],
            stats: stats,
            summary: summary,
            profile: profile,
            hasProfile: hasProfile,
            readinessParts: readinessParts,
            riskScore: riskScore,
            priorityScore: priorityScore
          };
        }).sort(function (a, b) {
          if (b.riskScore !== a.riskScore) return b.riskScore - a.riskScore;
          if (b.priorityScore !== a.priorityScore) return b.priorityScore - a.priorityScore;
          if ((b.stats.activeCount || 0) !== (a.stats.activeCount || 0)) return (b.stats.activeCount || 0) - (a.stats.activeCount || 0);
          return a.name.localeCompare(b.name, 'ru', { sensitivity: 'base' });
        });
      }

      function buildKnowledgeStrategicPortfolioSummary(entries) {
        var list = Array.isArray(entries) ? entries : [];
        return {
          projectCount: list.length,
          profiledCount: list.filter(function (entry) { return !!entry.hasProfile; }).length,
          okrCount: list.filter(function (entry) { return !!(entry.profile.objective || entry.profile.keyResultTitle); }).length,
          riceCount: list.filter(function (entry) { return (entry.summary.riceScore || 0) > 0; }).length,
          quickWinCount: list.filter(function (entry) { return entry.summary.impactEffortQuadrant === 'Быстрая победа'; }).length,
          riskCount: list.filter(function (entry) { return entry.riskScore > 0; }).length,
          bottleneckCount: list.filter(function (entry) { return !!(entry.profile.bottleneckNote || entry.summary.blockedCount); }).length,
          criticalCount: list.filter(function (entry) { return !!entry.summary.criticalTask; }).length,
          activeTasks: list.reduce(function (sum, entry) { return sum + (entry.stats.activeCount || 0); }, 0),
          overdueTasks: list.reduce(function (sum, entry) { return sum + (entry.stats.overdueCount || 0); }, 0),
          backlogTasks: list.reduce(function (sum, entry) { return sum + (entry.stats.backlogCount || 0); }, 0)
        };
      }

      function getKnowledgeStrategicPortfolioChipHtml(label, tone) {
        var safeTone = tone ? ' ' + escapeHtml(String(tone)) : '';
        return '<span class="knowledge-chip' + safeTone + '">' + escapeHtml(label || '') + '</span>';
      }

      // STAGE 296 — Strategic Portfolio Action Queue.
      // Поверх stage295 добавляет практические next-actions по проектам:
      // где снять риск, где забрать quick win, где заполнить profile и где подтянуть OKR.
      // Схему задач, project profile и server routes не меняем.
      function getKnowledgeStrategicPortfolioRiskReason(entry) {
        var reasons = [];
        var summary = entry && entry.summary ? entry.summary : {};
        var stats = entry && entry.stats ? entry.stats : {};
        if (stats.overdueCount) reasons.push('просрочено задач: ' + stats.overdueCount);
        if (summary.blockedCount) reasons.push('блокеров: ' + summary.blockedCount);
        if (summary.criticalTask) reasons.push('есть critical path candidate');
        if (stats.backlogCount && !stats.scheduledCount) reasons.push('backlog без расписания: ' + stats.backlogCount);
        return reasons.join(' · ') || 'есть стратегический риск по проекту';
      }

      function getKnowledgeStrategicPortfolioEntryAction(entry, forcedKind) {
        if (!entry) return null;
        var summary = entry.summary || {};
        var profile = entry.profile || normalizeProjectStrategyProfile({});
        var stats = entry.stats || {};
        var kind = String(forcedKind || '').trim();
        if (!kind) {
          if (entry.riskScore > 0) kind = 'risk';
          else if (summary.impactEffortQuadrant === 'Быстрая победа') kind = 'quick_win';
          else if ((profile.objective || profile.keyResultTitle) && (summary.okrProgress || 0) < 70) kind = 'okr_gap';
          else if (!entry.hasProfile) kind = 'profile';
          else if (stats.backlogCount >= 3) kind = 'backlog';
          else if (summary.impactEffortQuadrant === 'Стратегическая ставка') kind = 'strategic_bet';
          else kind = 'review';
        }
        if (kind === 'risk') {
          return {
            kind: kind,
            priority: 100 + (entry.riskScore || 0),
            tone: 'is-risk',
            title: 'Снять риск / bottleneck',
            label: 'Risk rescue',
            method: profile.primaryMethod || (summary.criticalTask ? 'critical_path' : 'toc'),
            reason: getKnowledgeStrategicPortfolioRiskReason(entry),
            action: summary.criticalTask ? ('Откройте проект и начните с критичной задачи: ' + (summary.criticalTask.title || 'Без названия')) : 'Откройте проект, выберите ближайший блокер и назначьте следующий конкретный шаг.'
          };
        }
        if (kind === 'quick_win') {
          return {
            kind: kind,
            priority: 86 + (entry.priorityScore || 0),
            tone: 'is-active',
            title: 'Забрать быструю победу',
            label: 'Quick win',
            method: 'impact_effort',
            reason: 'impact высокий, effort низкий',
            action: 'Перенесите 1–2 самые короткие задачи проекта в План/Сегодня и закройте их до конца недели.'
          };
        }
        if (kind === 'okr_gap') {
          return {
            kind: kind,
            priority: 78 + Math.max(0, 70 - (summary.okrProgress || 0)),
            tone: 'is-partial',
            title: 'Подтянуть OKR / KR',
            label: 'OKR gap',
            method: 'okr',
            reason: 'прогресс KR: ' + (summary.okrProgress || 0) + '%',
            action: 'Выберите одну задачу, которая напрямую двигает key result, и поставьте её в ближайший рабочий блок.'
          };
        }
        if (kind === 'profile') {
          return {
            kind: kind,
            priority: 62,
            tone: 'planned',
            title: 'Заполнить strategic profile',
            label: 'Profile gap',
            method: profile.primaryMethod || '',
            reason: 'у проекта нет Impact/Effort, RICE, OKR или Rolling Wave данных',
            action: 'Откройте профиль проекта и заполните минимум primary method + Impact/Effort. Этого достаточно для первого стратегического сигнала.'
          };
        }
        if (kind === 'backlog') {
          return {
            kind: kind,
            priority: 55 + Math.min(20, stats.backlogCount || 0),
            tone: 'is-partial',
            title: 'Разобрать backlog проекта',
            label: 'Backlog triage',
            method: profile.primaryMethod || 'rolling_wave',
            reason: 'backlog без даты: ' + (stats.backlogCount || 0),
            action: 'Разделите backlog на Now / Next / Later и запланируйте только 1 ближайший Now-шаг.'
          };
        }
        if (kind === 'strategic_bet') {
          return {
            kind: kind,
            priority: 52 + (entry.priorityScore || 0),
            tone: 'is-partial',
            title: 'Разложить стратегическую ставку',
            label: 'Strategic bet',
            method: profile.primaryMethod || 'rolling_wave',
            reason: 'impact высокий, effort высокий',
            action: 'Разбейте проект на 2–3 волны: что делаем сейчас, что проверяем дальше, что оставляем позже.'
          };
        }
        return {
          kind: 'review',
          priority: 35 + (entry.priorityScore || 0),
          tone: 'planned',
          title: 'Проверить стратегический статус',
          label: 'Review',
          method: profile.primaryMethod || '',
          reason: 'проект выглядит стабильным, но требует регулярного review',
          action: 'Откройте профиль и обновите стратегические поля, если изменился приоритет, цель или ближайший горизонт.'
        };
      }

      function buildKnowledgeStrategicPortfolioActionItems(entries, portfolio) {
        var list = Array.isArray(entries) ? entries : [];
        var items = [];
        list.forEach(function (entry) {
          if (!entry) return;
          var primary = getKnowledgeStrategicPortfolioEntryAction(entry);
          if (primary) items.push(Object.assign({ projectName: entry.name, entry: entry }, primary));
          if (entry.hasProfile && (entry.stats && entry.stats.backlogCount >= 5)) {
            items.push(Object.assign({ projectName: entry.name, entry: entry }, getKnowledgeStrategicPortfolioEntryAction(entry, 'backlog')));
          }
          if (entry.summary && entry.summary.impactEffortQuadrant === 'Быстрая победа' && primary && primary.kind !== 'quick_win') {
            items.push(Object.assign({ projectName: entry.name, entry: entry }, getKnowledgeStrategicPortfolioEntryAction(entry, 'quick_win')));
          }
        });
        if (portfolio && portfolio.projectCount && portfolio.profiledCount < portfolio.projectCount) {
          list.filter(function (entry) { return !entry.hasProfile; }).slice(0, 3).forEach(function (entry) {
            items.push(Object.assign({ projectName: entry.name, entry: entry }, getKnowledgeStrategicPortfolioEntryAction(entry, 'profile')));
          });
        }
        var seen = Object.create(null);
        return items.filter(function (item) {
          var key = (item.projectName || '') + '::' + (item.kind || '');
          if (seen[key]) return false;
          seen[key] = true;
          return true;
        }).sort(function (a, b) {
          if ((b.priority || 0) !== (a.priority || 0)) return (b.priority || 0) - (a.priority || 0);
          return String(a.projectName || '').localeCompare(String(b.projectName || ''), 'ru', { sensitivity: 'base' });
        }).slice(0, 8);
      }

      function renderKnowledgeStrategicPortfolioActionCard(item) {
        if (!item) return '';
        var methodTitle = item.method ? getStrategicMethodTitle(item.method) : '';
        var chips = [getKnowledgeStrategicPortfolioChipHtml(item.label || 'Action', item.tone || '')];
        if (methodTitle) chips.push(getKnowledgeStrategicPortfolioChipHtml(methodTitle));
        if (item.entry && item.entry.readinessParts !== undefined) chips.push(getKnowledgeStrategicPortfolioChipHtml('Готовность ' + item.entry.readinessParts + '/7'));
        return '<article class="framework-knowledge-card">' +
          '<div class="framework-knowledge-head"><div><div class="framework-knowledge-title">' + escapeHtml(item.projectName || 'Проект') + '</div><div class="framework-knowledge-scope">' + escapeHtml(item.title || 'Следующее действие') + '</div></div><span class="framework-knowledge-status ' + escapeHtml(item.tone || 'planned') + '">' + Math.round(item.priority || 0) + '</span></div>' +
          '<div class="knowledge-chip-row" style="margin-top:8px;">' + chips.join('') + '</div>' +
          '<div class="framework-knowledge-meta" style="margin-top:10px;"><strong>Почему:</strong> ' + escapeHtml(item.reason || '—') + '</div>' +
          '<div class="framework-knowledge-meta"><strong>Что сделать:</strong> ' + escapeHtml(item.action || 'Открыть проект и уточнить следующий шаг.') + '</div>' +
          '<div class="settings-inline-row" style="margin-top:12px;"><button class="btn-primary" type="button" data-kcp-strategic-portfolio-project="' + escapeHtml(item.projectName || '') + '">Открыть проект</button><button class="btn-ghost" type="button" data-kcp-strategic-profile-project="' + escapeHtml(item.projectName || '') + '">Профиль</button></div>' +
        '</article>';
      }

      function renderKnowledgeStrategicPortfolioActionQueue(entries, portfolio) {
        var items = buildKnowledgeStrategicPortfolioActionItems(entries, portfolio);
        if (!items.length) {
          return '<div style="margin-top:16px;" class="knowledge-method-empty">Strategic Action Queue пока пуст: добавьте проекты, задачи или заполните strategic profile — после этого Planner покажет следующие действия.</div>';
        }
        return '<div style="margin-top:16px;">' +
          '<div class="settings-block-title" style="margin:0 0 8px 0; font-size:16px;">Strategic Action Queue</div>' +
          '<div class="settings-block-subtitle" style="margin-bottom:10px;">Практическая очередь следующих действий по портфелю: сначала риски и bottleneck, затем quick wins, OKR-gap и незаполненные project profiles.</div>' +
          '<div class="framework-knowledge-grid">' + items.map(renderKnowledgeStrategicPortfolioActionCard).join('') + '</div>' +
        '</div>';
      }

      // STAGE 297 — Strategic Weekly Plan Bridge.
      // Превращает Strategic Action Queue в компактный недельный план действий:
      // что защитить, что забрать как quick win, что двигает OKR и какие профили
      // нужно заполнить. Не создаёт задачи автоматически и не меняет task schema.
      function getKnowledgeStrategicWeeklyPlanBucket(item) {
        var kind = item && item.kind ? String(item.kind) : '';
        if (kind === 'risk') return 'protect';
        if (kind === 'quick_win') return 'quickWins';
        if (kind === 'okr_gap') return 'okr';
        if (kind === 'profile') return 'profiles';
        return 'planning';
      }

      function getKnowledgeStrategicWeeklyPlanBucketMeta(bucket) {
        var map = {
          protect: {
            title: 'Защитить неделю',
            subtitle: 'Риски, bottleneck и critical path, которые лучше закрыть первыми.',
            empty: 'Критичных стратегических рисков не найдено.'
          },
          quickWins: {
            title: 'Быстрые победы',
            subtitle: 'Проекты с высоким impact и низким effort — хороший кандидат на ближайшие слоты.',
            empty: 'Quick wins пока не обнаружены.'
          },
          okr: {
            title: 'Двинуть цель',
            subtitle: 'Действия, которые напрямую подтягивают OKR / key result.',
            empty: 'OKR-gap пока не виден или цели не заполнены.'
          },
          profiles: {
            title: 'Настроить стратегию',
            subtitle: 'Проекты без минимального strategic profile, из-за чего Planner не может уверенно ранжировать их.',
            empty: 'Все видимые проекты имеют хотя бы базовый strategic profile.'
          },
          planning: {
            title: 'Разложить план',
            subtitle: 'Backlog, strategic bets и регулярный review — то, что нужно превратить в Plan / Week.',
            empty: 'Дополнительных planning-действий сейчас нет.'
          }
        };
        return map[bucket] || map.planning;
      }

      function buildKnowledgeStrategicWeeklyPlan(entries, portfolio) {
        var actions = buildKnowledgeStrategicPortfolioActionItems(entries, portfolio);
        var buckets = { protect: [], quickWins: [], okr: [], profiles: [], planning: [] };
        actions.forEach(function (item) {
          var bucket = getKnowledgeStrategicWeeklyPlanBucket(item);
          if (!buckets[bucket]) bucket = 'planning';
          buckets[bucket].push(item);
        });
        var focus = buckets.protect[0] || buckets.quickWins[0] || buckets.okr[0] || buckets.planning[0] || buckets.profiles[0] || null;
        var focusMethod = focus && focus.method ? getStrategicMethodTitle(focus.method) : '';
        var totalActions = Object.keys(buckets).reduce(function (sum, key) { return sum + buckets[key].length; }, 0);
        return {
          actions: actions,
          buckets: buckets,
          focus: focus,
          focusMethod: focusMethod,
          totalActions: totalActions,
          protectCount: buckets.protect.length,
          quickWinCount: buckets.quickWins.length,
          okrCount: buckets.okr.length,
          profileCount: buckets.profiles.length,
          planningCount: buckets.planning.length
        };
      }

      function renderKnowledgeStrategicWeeklyPlanItem(item, index) {
        if (!item) return '';
        var entry = item.entry || {};
        var chips = [];
        if (item.label) chips.push(getKnowledgeStrategicPortfolioChipHtml(item.label, item.tone || ''));
        if (item.method) chips.push(getKnowledgeStrategicPortfolioChipHtml(getStrategicMethodTitle(item.method)));
        if (entry.stats && entry.stats.activeCount !== undefined) chips.push(getKnowledgeStrategicPortfolioChipHtml('Активных: ' + (entry.stats.activeCount || 0)));
        return '<article class="framework-knowledge-card" style="padding:12px;">' +
          '<div class="framework-knowledge-head"><div><div class="framework-knowledge-title">' + (index + 1) + '. ' + escapeHtml(item.projectName || 'Проект') + '</div><div class="framework-knowledge-scope">' + escapeHtml(item.title || 'Следующее действие') + '</div></div><span class="framework-knowledge-status ' + escapeHtml(item.tone || 'planned') + '">' + Math.round(item.priority || 0) + '</span></div>' +
          '<div class="knowledge-chip-row" style="margin-top:8px;">' + chips.join('') + '</div>' +
          '<div class="framework-knowledge-meta" style="margin-top:8px;"><strong>Ход недели:</strong> ' + escapeHtml(item.action || 'Открыть проект и уточнить ближайший шаг.') + '</div>' +
          '<div class="settings-inline-row" style="margin-top:10px;"><button class="btn-ghost" type="button" data-kcp-strategic-portfolio-project="' + escapeHtml(item.projectName || '') + '">К проекту</button><button class="btn-ghost" type="button" data-kcp-strategic-profile-project="' + escapeHtml(item.projectName || '') + '">Профиль</button></div>' +
        '</article>';
      }

      function renderKnowledgeStrategicWeeklyPlanBucket(bucket, items, limit) {
        var meta = getKnowledgeStrategicWeeklyPlanBucketMeta(bucket);
        var visible = (items || []).slice(0, limit || 3);
        var body = visible.length ? visible.map(function (item, index) { return renderKnowledgeStrategicWeeklyPlanItem(item, index); }).join('') : '<div class="knowledge-method-empty" style="margin-top:8px;">' + escapeHtml(meta.empty) + '</div>';
        return '<section class="knowledge-pro-panel" style="padding:14px; background:rgba(255,255,255,.035);">' +
          '<div class="settings-block-title" style="margin:0 0 6px 0; font-size:15px;">' + escapeHtml(meta.title) + '</div>' +
          '<div class="settings-block-subtitle" style="margin-bottom:10px;">' + escapeHtml(meta.subtitle) + '</div>' +
          '<div class="framework-knowledge-grid">' + body + '</div>' +
        '</section>';
      }

      // STAGE 312 — Strategic Execution Bridge shell only.
      // Возвращаем только безопасную оболочку будущего execution-моста:
      // без переходов, без фильтров проекта, без clipboard и без новых обработчиков.
      // Цель — проверить точку встраивания после сбоя старого stage298/309.
      function renderKnowledgeStrategicExecutionBridgeShell(plan) {
        try {
          var safePlan = plan || {};
          var totalActions = Number(safePlan.totalActions || 0);
          var focus = safePlan.focus || null;
          var focusProject = focus && focus.projectName ? String(focus.projectName) : '—';
          var focusTitle = focus && focus.title ? String(focus.title) : 'Пока нет выбранного стратегического действия';
          var hint = totalActions
            ? 'Следующий этап подключит безопасные переходы в План, Неделю, Today и Гант по одному обработчику.'
            : 'Сначала заполните strategic profile проекта или добавьте действия в Strategic Action Queue.';
          return '<section class="knowledge-pro-panel" data-strategic-execution-shell="1" style="margin-top:12px; border-color:rgba(103,126,234,.28); background:rgba(103,126,234,.055);">' +
            '<div class="knowledge-pro-head">' +
              '<div><h3 class="knowledge-pro-title" style="margin:0;">Strategic Execution Bridge</h3>' +
              '<div class="knowledge-pro-subtitle">Безопасная оболочка будущего моста от стратегического плана к рабочим экранам. На этом этапе переходы и копирование специально отключены, чтобы проверить стабильность загрузки.</div></div>' +
              '<span class="framework-knowledge-status is-partial">shell</span>' +
            '</div>' +
            '<div class="knowledge-summary-grid" style="margin-top:10px;">' +
              '<article class="knowledge-summary-card"><div class="knowledge-summary-title">Фокус</div><div class="knowledge-summary-value" style="font-size:18px;">' + escapeHtml(focusProject) + '</div><div class="knowledge-summary-note">' + escapeHtml(focusTitle) + '</div></article>' +
              '<article class="knowledge-summary-card"><div class="knowledge-summary-title">Действия</div><div class="knowledge-summary-value">' + String(totalActions) + '</div><div class="knowledge-summary-note">Из Strategic Weekly Plan</div></article>' +
              '<article class="knowledge-summary-card"><div class="knowledge-summary-title">Статус</div><div class="knowledge-summary-value" style="font-size:18px;">Проверка</div><div class="knowledge-summary-note">Без активных переходов</div></article>' +
            '</div>' +
            '<div class="settings-inline-row" style="margin-top:12px;">' +
              '<button class="btn-ghost" type="button" disabled title="Будет включено отдельным безопасным этапом">Открыть в Плане</button>' +
              '<button class="btn-ghost" type="button" disabled title="Будет включено отдельным безопасным этапом">Неделя</button>' +
              '<button class="btn-ghost" type="button" disabled title="Будет включено отдельным безопасным этапом">Today</button>' +
              '<button class="btn-ghost" type="button" disabled title="Будет включено отдельным безопасным этапом">Гант</button>' +
            '</div>' +
            '<div class="settings-block-subtitle" style="margin-top:10px;">' + escapeHtml(hint) + '</div>' +
          '</section>';
        } catch (err) {
          console.warn('[strategic-execution-shell-render-error]', err);
          return '<div class="knowledge-method-empty" style="margin-top:12px;">Strategic Execution Bridge shell временно недоступен, но основной интерфейс продолжает работать.</div>';
        }
      }

      function renderKnowledgeStrategicWeeklyPlanBridge(entries, portfolio) {
        var plan = buildKnowledgeStrategicWeeklyPlan(entries, portfolio);
        if (!plan.totalActions) {
          return '<div style="margin-top:16px;" class="knowledge-method-empty">Strategic Weekly Plan пока пуст: когда появятся проекты, профили или риски, Planner соберёт краткий план следующей недели.</div>' + renderKnowledgeStrategicExecutionBridgeShell(plan);
        }
        var focus = plan.focus;
        var focusTitle = focus ? (focus.projectName + ' · ' + (focus.title || 'следующее действие')) : '—';
        var focusAction = focus ? focus.action : 'Добавьте проекты и strategic profile, чтобы Planner предложил недельный strategic plan.';
        return '<div style="margin-top:16px;">' +
          '<div class="settings-block-title" style="margin:0 0 8px 0; font-size:16px;">Strategic Weekly Plan</div>' +
          '<div class="settings-block-subtitle" style="margin-bottom:10px;">Мост от стратегического dashboard к Plan/Week: Planner показывает, какие 1–3 стратегических действия стоит поставить в неделю. Задачи автоматически не создаются — это безопасный planning-слой поверх существующих проектов.</div>' +
          '<div class="knowledge-summary-grid" style="margin-top:10px;">' +
            '<article class="knowledge-summary-card"><div class="knowledge-summary-title">Фокус недели</div><div class="knowledge-summary-value" style="font-size:18px;">' + escapeHtml(focus ? focus.projectName : '—') + '</div><div class="knowledge-summary-note">' + escapeHtml(focus ? focus.title : 'Нет явного фокуса') + '</div></article>' +
            '<article class="knowledge-summary-card"><div class="knowledge-summary-title">Protect / Win</div><div class="knowledge-summary-value">' + plan.protectCount + ' / ' + plan.quickWinCount + '</div><div class="knowledge-summary-note">Риски и быстрые победы</div></article>' +
            '<article class="knowledge-summary-card"><div class="knowledge-summary-title">OKR / Profile</div><div class="knowledge-summary-value">' + plan.okrCount + ' / ' + plan.profileCount + '</div><div class="knowledge-summary-note">Цели и заполненность стратегии</div></article>' +
            '<article class="knowledge-summary-card"><div class="knowledge-summary-title">Метод</div><div class="knowledge-summary-value" style="font-size:18px;">' + escapeHtml(plan.focusMethod || '—') + '</div><div class="knowledge-summary-note">Рекомендуемый strategic engine</div></article>' +
          '</div>' +
          '<div class="framework-knowledge-card" style="margin-top:12px;">' +
            '<div class="framework-knowledge-head"><div><div class="framework-knowledge-title">Первый ход недели</div><div class="framework-knowledge-scope">' + escapeHtml(focusTitle) + '</div></div><span class="framework-knowledge-status is-partial">week</span></div>' +
            '<div class="framework-knowledge-text">' + escapeHtml(focusAction || '') + '</div>' +
            '<div class="settings-inline-row" style="margin-top:12px;"><button class="btn-primary" type="button" data-kcp-strategic-nav="plan">Открыть План</button><button class="btn-ghost" type="button" data-kcp-strategic-nav="projects">К проектам</button><button class="btn-ghost" type="button" data-kcp-strategic-nav="gantt">К Ганту</button></div>' +
          '</div>' +
          '<div class="framework-knowledge-grid" style="margin-top:12px;">' +
            renderKnowledgeStrategicWeeklyPlanBucket('protect', plan.buckets.protect, 2) +
            renderKnowledgeStrategicWeeklyPlanBucket('quickWins', plan.buckets.quickWins, 2) +
            renderKnowledgeStrategicWeeklyPlanBucket('okr', plan.buckets.okr, 2) +
            renderKnowledgeStrategicWeeklyPlanBucket('profiles', plan.buckets.profiles, 2) +
          '</div>' +
          renderKnowledgeStrategicExecutionBridgeShell(plan) +
        '</div>';
      }

      function renderKnowledgeStrategicPortfolioProjectCard(entry, modeLabel) {
        var summary = entry.summary || {};
        var profile = entry.profile || normalizeProjectStrategyProfile({});
        var chips = [];
        if (profile.primaryMethod) chips.push(getKnowledgeStrategicPortfolioChipHtml('Primary: ' + getStrategicMethodTitle(profile.primaryMethod)));
        if (summary.riceScore > 0) chips.push(getKnowledgeStrategicPortfolioChipHtml('RICE ' + summary.riceScore.toFixed(1)));
        if (summary.impactEffortQuadrant) chips.push(getKnowledgeStrategicPortfolioChipHtml(summary.impactEffortQuadrant));
        if (profile.rollingWave) chips.push(getKnowledgeStrategicPortfolioChipHtml('Wave: ' + profile.rollingWave));
        if (profile.moscow) chips.push(getKnowledgeStrategicPortfolioChipHtml('MoSCoW: ' + profile.moscow.toUpperCase()));
        if (profile.objective || profile.keyResultTitle) chips.push(getKnowledgeStrategicPortfolioChipHtml('OKR ' + (summary.okrProgress || 0) + '%'));
        if (entry.stats.overdueCount) chips.push(getKnowledgeStrategicPortfolioChipHtml('Просрочка: ' + entry.stats.overdueCount));
        if (summary.blockedCount) chips.push(getKnowledgeStrategicPortfolioChipHtml('Блокеры: ' + summary.blockedCount));
        if (summary.criticalTask) chips.push(getKnowledgeStrategicPortfolioChipHtml('Critical path'));
        var note = profile.objective || profile.cycleGoal || profile.bottleneckNote || (summary.criticalTask ? ('Критичная задача: ' + (summary.criticalTask.title || 'Без названия')) : '') || ('Активных задач: ' + (entry.stats.activeCount || 0) + ' · Backlog: ' + (entry.stats.backlogCount || 0));
        return '<article class="framework-knowledge-card">' +
          '<div class="framework-knowledge-head"><div><div class="framework-knowledge-title">' + escapeHtml(entry.name) + '</div><div class="framework-knowledge-scope">' + escapeHtml(modeLabel || 'Strategic project') + '</div></div><span class="framework-knowledge-status ' + (entry.riskScore > 0 ? 'is-partial' : 'is-active') + '">' + escapeHtml(String(entry.readinessParts || 0)) + '/7</span></div>' +
          '<div class="framework-knowledge-text">' + escapeHtml(note) + '</div>' +
          '<div class="framework-knowledge-meta"><strong>Следующее действие:</strong> ' + escapeHtml((getKnowledgeStrategicPortfolioEntryAction(entry) || {}).action || 'Открыть проект и обновить strategic profile.') + '</div>' +
          '<div class="knowledge-chip-row" style="margin-top:10px;">' + (chips.join('') || '<span class="knowledge-chip">Профиль не заполнен</span>') + '</div>' +
          '<div class="framework-knowledge-meta"><strong>План/факт:</strong> ' + escapeHtml(formatMinutesHoursLabel(entry.stats.plannedMinutes || 0)) + ' / ' + escapeHtml(formatMinutesHoursLabel(entry.stats.actualMinutes || 0)) + '</div>' +
          '<div class="settings-inline-row" style="margin-top:12px;"><button class="btn-ghost" type="button" data-kcp-strategic-portfolio-project="' + escapeHtml(entry.name) + '">К проекту</button><button class="btn-ghost" type="button" data-kcp-strategic-profile-project="' + escapeHtml(entry.name) + '">Профиль</button></div>' +
        '</article>';
      }

      function renderKnowledgeStrategicPortfolioDashboard(bridgeState) {
        var entries = buildKnowledgeStrategicPortfolioEntries();
        var portfolio = buildKnowledgeStrategicPortfolioSummary(entries);
        var topRisk = entries.filter(function (entry) { return entry.riskScore > 0; }).slice(0, 3);
        var topPriority = entries.slice().sort(function (a, b) { return b.priorityScore - a.priorityScore; }).slice(0, 3);
        var topOkr = entries.filter(function (entry) { return !!(entry.profile.objective || entry.profile.keyResultTitle); }).sort(function (a, b) { return (a.summary.okrProgress || 0) - (b.summary.okrProgress || 0); }).slice(0, 3);
        var merged = [];
        topRisk.concat(topPriority).concat(topOkr).forEach(function (entry) {
          if (!entry || merged.some(function (candidate) { return candidate.name === entry.name; })) return;
          merged.push(entry);
        });
        var cards = merged.slice(0, 6).map(function (entry) {
          var label = entry.riskScore > 0 ? 'Risk / delivery' : ((entry.profile.objective || entry.profile.keyResultTitle) ? 'OKR / goal' : 'Strategic priority');
          return renderKnowledgeStrategicPortfolioProjectCard(entry, label);
        }).join('');
        if (!cards) {
          cards = '<div class="knowledge-method-empty">Пока нет project strategic profile. Откройте любой проект и заполните Impact/Effort, RICE или OKR-поля — после этого здесь появится portfolio dashboard.</div>';
        }
        return '<div style="margin-top:16px;">' +
          '<div class="settings-block-title" style="margin:0 0 8px 0; font-size:16px;">Strategic Portfolio Dashboard</div>' +
          '<div class="settings-block-subtitle" style="margin-bottom:10px;">Живой обзор Strategic Engines по реальным проектам: заполненность профилей, OKR/RICE, быстрые победы, bottleneck и critical path без изменения схемы задач.</div>' +
