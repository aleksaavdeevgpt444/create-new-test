async function getPlannerBridgeSummaryServer(env, { userId, limit = 6 }) {
  const safeLimit = Math.min(Math.max(Number(limit) || 6, 1), 20);
  const source = 'ideas-hub';
  // OPT-2 stage326: parallel reads → Promise.all
  const [countsRow, recentRows] = await Promise.all([
    env.DB.prepare(`
      SELECT
        COUNT(*) AS total_count,
        SUM(CASE WHEN status = ? THEN 1 ELSE 0 END) AS new_count,
        SUM(CASE WHEN status = ? THEN 1 ELSE 0 END) AS planned_count,
        SUM(CASE WHEN status = ? THEN 1 ELSE 0 END) AS done_count,
        SUM(CASE WHEN due_at IS NOT NULL THEN 1 ELSE 0 END) AS scheduled_count,
        SUM(CASE WHEN due_at IS NULL THEN 1 ELSE 0 END) AS backlog_count
      FROM tasks
      WHERE user_id = ? AND LOWER(COALESCE(source, '')) = ?
    `)
      .bind(TASK_STATUSES.NEW, TASK_STATUSES.PLANNED, TASK_STATUSES.DONE, String(userId), source)
      .first(),
    env.DB.prepare(`
      SELECT ${TASK_SELECT_FIELDS}
      FROM tasks
      WHERE user_id = ? AND LOWER(COALESCE(source, '')) = ?
      ORDER BY updated_at DESC, created_at DESC
      LIMIT ?
    `)
      .bind(String(userId), source, safeLimit)
      .all(),
  ]);

  return {
    source,
    source_label: getPlannerBridgeSourceLabelServer(source),
    total_count: Number(countsRow && countsRow.total_count) || 0,
    new_count: Number(countsRow && countsRow.new_count) || 0,
    planned_count: Number(countsRow && countsRow.planned_count) || 0,
    done_count: Number(countsRow && countsRow.done_count) || 0,
    scheduled_count: Number(countsRow && countsRow.scheduled_count) || 0,
    backlog_count: Number(countsRow && countsRow.backlog_count) || 0,
    recent_items: (recentRows.results || []).map((row) => ({
      id: row.id,
      title: row.title || 'Без названия',
      status: row.status || TASK_STATUSES.NEW,
      due_at: row.due_at || null,
      project_name: row.project_name || 'Без проекта',
      source: row.source || source,
      source_record_id: row.source_record_id || null,
      updated_at: row.updated_at || row.created_at || null,
    })),
  };
}

function safeStringifyHistoryPayload(payload) {
  try {
    return payload == null ? null : JSON.stringify(payload);
  } catch (error) {
    return JSON.stringify({ note: 'payload_stringify_failed' });
  }
}

function normalizeHistoryComparableValue(value) {
  if (value == null || value === '') return null;
  return String(value);
}

function hasHistoryChangeEntry(info) {
  if (!(info && typeof info === 'object' && ('from' in info || 'to' in info))) return false;
  return normalizeHistoryComparableValue(info.from) !== normalizeHistoryComparableValue(info.to);
}

function hasMeaningfulTaskHistoryPayload(eventType, payload) {
  if (!payload || typeof payload !== 'object') return false;

  if (eventType === 'created' || eventType === 'deleted') {
    return !!String(payload.title || '').trim();
  }

  if (
    hasHistoryChangeEntry(payload.title) ||
    hasHistoryChangeEntry(payload.task_product) ||
    hasHistoryChangeEntry(payload.description) ||
    hasHistoryChangeEntry(payload.project_name) ||
    hasHistoryChangeEntry(payload.priority_manual) ||
    hasHistoryChangeEntry(payload.duration_minutes) ||
    hasHistoryChangeEntry(payload.planned_minutes_manual) ||
    hasHistoryChangeEntry(payload.actual_minutes) ||
    hasHistoryChangeEntry(payload.remind_at)
  ) {
    return true;
  }

  if (normalizeHistoryComparableValue(payload.previous_status) !== normalizeHistoryComparableValue(payload.next_status)) {
    return true;
  }

  if (normalizeHistoryComparableValue(payload.previous_due_at) !== normalizeHistoryComparableValue(payload.next_due_at)) {
    return true;
  }

  if (normalizeHistoryComparableValue(payload.previous_blocked_by_task_id) !== normalizeHistoryComparableValue(payload.blocked_by_task_id)) {
    return true;
  }

  return false;
}

async function addTaskHistory(env, { userId, taskId, eventType, payload = null, createdAt = null }) {
  if (!userId || !taskId || !eventType) return;
  if (!hasMeaningfulTaskHistoryPayload(String(eventType), payload)) return;
  const stamp = createdAt || new Date().toISOString();
  await env.DB.prepare(`
    INSERT INTO task_history (id, user_id, task_id, event_type, payload_json, created_at)
    VALUES (?, ?, ?, ?, ?, ?)
  `)
    .bind(crypto.randomUUID(), String(userId), String(taskId), String(eventType), safeStringifyHistoryPayload(payload), stamp)
    .run();
}

async function listTaskHistory(env, { userId, taskId, limit = 40 }) {
  const safeLimit = Math.min(Math.max(Number(limit) || 40, 1), 200);
  const rows = await env.DB.prepare(`
    SELECT id, user_id, task_id, event_type, payload_json, created_at
    FROM task_history
    WHERE user_id = ? AND task_id = ?
    ORDER BY created_at DESC
    LIMIT ?
  `)
    .bind(String(userId), String(taskId), safeLimit)
    .all();
  return (rows.results || []).map((row) => {
    let payload = null;
    if (row.payload_json) {
      try { payload = JSON.parse(row.payload_json); } catch (error) { payload = { raw: row.payload_json }; }
    }
    return {
      id: row.id,
      user_id: row.user_id,
      task_id: row.task_id,
      event_type: row.event_type,
      payload,
      created_at: row.created_at,
    };
  }).filter((entry) => hasMeaningfulTaskHistoryPayload(entry.event_type, entry.payload));
}

