    .week-nav-shell {
      position: sticky;
      top: 12px;
      z-index: 45;
      transition: top .18s ease;
    }

     .week-nav {
      display: grid;
      grid-template-columns: auto minmax(260px, 1fr) auto;
      gap: 14px;
      align-items: center;
      background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.025));
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 24px;
      padding: 18px 20px;
      box-shadow: var(--shadow);
      transition: padding .18s ease, border-radius .18s ease, transform .18s ease, background .18s ease;
    }

    .week-nav-controls {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: nowrap;
    }

    .week-nav-btn {
      appearance: none;
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 16px;
      min-height: 44px;
      padding: 0 18px;
      font: inherit;
      font-weight: 800;
      letter-spacing: -.01em;
