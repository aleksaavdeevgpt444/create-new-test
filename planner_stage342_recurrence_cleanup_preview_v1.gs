// ============================================================
// STAGE 340 — Recurrence Unique Occurrence Guard
// All occurrence INSERTs must go through insertRecurringOccurrenceIfMissing_.
// This prevents duplicate rows from race conditions or repeated sync calls.
// ============================================================

/**
 * Build a dedup key for a recurring occurrence payload.
 * Primary: user_id + series_id + recurrence_index (most reliable).
 * Fallback: user_id + series_id + due_at + title + space_key.
 */
function buildRecurringOccurrenceDedupeKey_(taskOrPayload) {
  const t = taskOrPayload || {};
  const userId = String(t.user_id || '').trim();
  const seriesId = String(t.recurrence_series_id || '').trim();
  if (!userId || !seriesId) return null;

  const idx = (t.recurrence_index != null) ? String(t.recurrence_index) : null;
  if (idx !== null && idx !== '') {
    return userId + '|series:' + seriesId + '|idx:' + idx;
  }

  const dueAt = String(t.due_at || '').trim();
  const dueDatePart = dueAt ? dueAt.slice(0, 10) : 'nodate';
  const dueTimePart = (dueAt.length > 10) ? dueAt.slice(11, 16) : 'notime';
  const title = String(t.title || '').trim().toLowerCase().replace(/\s+/g, ' ');
  const space = String(t.space_key || 'work').trim().toLowerCase();
  return userId + '|series:' + seriesId + '|date:' + dueDatePart + '|time:' + dueTimePart + '|title:' + title + '|space:' + space;
}

/**
 * Look up an existing recurring occurrence in D1.
 * Checks primary key (series_id + index) first, then fallback (series_id + due_at + title + space).
 * Read-only — does not write.
 * @returns {Promise<object|null>}
 */
async function findExistingRecurringOccurrence_(env, occurrencePayload) {
  const t = occurrencePayload || {};
  const userId = String(t.user_id || '').trim();
  const seriesId = String(t.recurrence_series_id || '').trim();
  if (!userId || !seriesId) return null;

  // Primary: series_id + recurrence_index
  const recurrenceIndex = (t.recurrence_index != null) ? t.recurrence_index : null;
  if (recurrenceIndex !== null) {
    const row = await env.DB.prepare(
      `SELECT ${TASK_SELECT_FIELDS} FROM tasks WHERE user_id = ? AND recurrence_series_id = ? AND recurrence_index = ? LIMIT 1`
    ).bind(userId, seriesId, recurrenceIndex).first();
    if (row) return row;
  }

  // Fallback: series_id + due_at + title + space_key
  const dueAt = t.due_at ? String(t.due_at).trim() : null;
  if (dueAt) {
    const title = String(t.title || '').trim();
    const space = String(t.space_key || 'work').trim();
    const row = await env.DB.prepare(
      `SELECT ${TASK_SELECT_FIELDS} FROM tasks WHERE user_id = ? AND recurrence_series_id = ? AND due_at = ? AND title = ? AND space_key = ? LIMIT 1`
    ).bind(userId, seriesId, dueAt, title, space).first();
    if (row) return row;
  }

  return null;
}

/**
 * Insert a recurring occurrence only if one does not already exist.
 * If an existing occurrence is found (same series_id + index, or same series_id + date + title + space),
 * returns the existing task id without writing anything new.
 * @returns {Promise<{id: string, created: boolean, existing: boolean}>}
 */
async function insertRecurringOccurrenceIfMissing_(env, occurrencePayload) {
  const existing = await findExistingRecurringOccurrence_(env, occurrencePayload);
  if (existing) {
    console.log(
      '[stage340][occurrenceGuard] duplicate_prevented existingId=' + existing.id +
      ' series=' + (occurrencePayload.recurrence_series_id || '') +
      ' idx=' + occurrencePayload.recurrence_index +
      ' due=' + (occurrencePayload.due_at || '')
    );
    return { id: existing.id, created: false, existing: true };
  }
  await insertTask(env, occurrencePayload);
  return { id: occurrencePayload.id, created: true, existing: false };
}

