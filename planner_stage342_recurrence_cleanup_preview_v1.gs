    });
  } catch (error) {
    return jsonResponse({ ok: false, error: String(error) }, { status: 500 });
  }
}

async function handleTaskDeleteApi(request, env) {
  if (request.method !== "POST" && request.method !== "DELETE") return textResponse("Method Not Allowed", 405);

  try {
    const body = request.method === "DELETE"
      ? searchParamsToObject(new URL(request.url).searchParams)
      : await request.json();
    const taskId = body?.task_id;
    const userId = body?.user_id;

    if (!taskId || !userId) {
      return jsonResponse({ ok: false, error: "task_id and user_id are required" }, { status: 400 });
    }

    const existingTask = await getTaskById(env, { taskId, userId: String(userId) });
    if (!existingTask) return jsonResponse({ ok: false, error: "Task not found" }, { status: 404 });

    const shouldDetachCurrent = isTaskRecurringInstance(existingTask);
    if (shouldDetachCurrent) {
      await detachTaskFromRecurringSeries(env, { taskId, userId: String(userId) });
      await deleteSingleTaskRecord(env, { taskId, userId: String(userId) });
      return jsonResponse({ ok: true, deleted: true, task_id: taskId, detached: true, scope: 'current_only' });
    }

    await deleteTaskRecord(env, { taskId, userId: String(userId) });
    return jsonResponse({ ok: true, deleted: true, task_id: taskId, detached: false, scope: 'single' });
  } catch (error) {
    return jsonResponse({ ok: false, error: String(error) }, { status: 500 });
  }
}

