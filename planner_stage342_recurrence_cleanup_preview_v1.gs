        stats.appendChild(createCapacitySummaryStat(formatMinutesHoursLabel(data.summary.overflowMinutes > 0 ? data.summary.overflowMinutes : data.summary.freeMinutes), data.summary.overflowMinutes > 0 ? 'Перегруз' : 'Свободно', data.summary.overflowMinutes > 0 ? 'danger' : (data.summary.loadMeta && data.summary.loadMeta.tone === 'warning' ? 'warning' : '')));
        stats.appendChild(createCapacitySummaryStat(String(data.summary.overflowDays), 'Перегружено дней', data.summary.overflowDays > 0 ? 'danger' : ''));
        stats.appendChild(createCapacitySummaryStat(String(data.attentionDays.length), 'Риск-дней', data.attentionDays.length > 0 ? 'warning' : ''));
