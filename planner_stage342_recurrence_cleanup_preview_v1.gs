        var showInMonth = byId('editorShowInMonthCheckbox') ? (byId('editorShowInMonthCheckbox').checked ? 1 : 0) : 0;
        var spaceKey = byId('editorSpaceSelect') ? String(byId('editorSpaceSelect').value || state.activeSpaceKey || 'work').trim() : String(state.activeSpaceKey || 'work');
        var recurrencePayload = getRecurrencePayloadFromScope('editor');
        var nextStatus = normalizeStatus(byId('editorStatusSelect') ? byId('editorStatusSelect').value : currentTask.status);
        var currentProjectName = String(currentTask && currentTask.project_name || 'Без проекта');
        var currentPriorityManual = currentTask && currentTask.priority_manual != null ? String(currentTask.priority_manual) : '';
        var currentDateValue = currentTask && currentTask.due_at ? getTaskYmdFromIso(currentTask.due_at) : '';
        var currentTimeValue = currentTask && currentTask.due_at ? formatTimeByYmdWithPlannerTimeZone(currentTask.due_at, currentDateValue, '') : '';
        var currentDurationValue = getTaskDurationMinutes(currentTask);
        var currentPlannedMinutesManual = normalizeMinutesInputValue(currentTask && currentTask.planned_minutes_manual);
        var currentActualMinutes = normalizeMinutesInputValue(currentTask && currentTask.actual_minutes);
