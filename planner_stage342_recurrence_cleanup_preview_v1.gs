      function openRitualReviewDialog(dayYmd) {
        var dialog = ensureRitualReviewDialog();
        var ritual = loadDayRitual(dayYmd);
        dialog.backdrop.dataset.dayYmd = dayYmd;
        dialog.status.value = ritual.reviewStatus || '';
        dialog.note.value = ritual.reviewNote || '';
        dialog.backdrop.style.display = 'flex';
      }

      function ensureMeditationOverlay() {
        if (state.meditationOverlay) return state.meditationOverlay;
        var backdrop = document.createElement('div');
        backdrop.className = 'meditation-backdrop';
        var panel = document.createElement('div');
        panel.className = 'meditation-panel';
        panel.setAttribute('role', 'dialog');
        panel.setAttribute('aria-modal', 'true');

        panel.innerHTML = '' +
          '<div class="today-ritual-head">' +
            '<div>' +
              '<div id="meditationTitle" class="meditation-title">Микро-медитация</div>' +
              '<div id="meditationSubtitle" class="meditation-subtitle">Выбери короткий сценарий и запусти паузу на 2–10 минут.</div>' +
            '</div>' +
            '<button id="meditationCloseBtn" class="btn-ghost" type="button">Закрыть</button>' +
          '</div>' +
          '<div id="meditationProgramList" class="meditation-program-list"></div>' +
          '<div class="focus-mode-card">' +
            '<div class="panel-title">План практики</div>' +
            '<div id="meditationSteps" class="meditation-steps"></div>' +
          '</div>' +
          '<div class="focus-mode-card">' +
            '<div class="panel-title">Таймер</div>' +
            '<div class="meditation-timer-wrap">' +
              '<div id="meditationTimer" class="meditation-timer">00:00</div>' +
              '<div id="meditationTimerNote" class="meditation-subtitle">Готово к запуску.</div>' +
              '<div class="focus-mode-progress"><div id="meditationProgressBar" class="focus-mode-progress-bar"></div></div>' +
            '</div>' +
          '</div>' +
          '<div class="meditation-actions">' +
            '<button id="meditationStartBtn" class="btn-primary" type="button">Начать</button>' +
            '<button id="meditationFinishBtn" class="btn-ghost" type="button">Завершить</button>' +
          '</div>';

        backdrop.appendChild(panel);
        document.body.appendChild(backdrop);

        backdrop.addEventListener('click', function (event) {
          if (event.target !== backdrop) return;
          closeMeditationOverlay();
        });
        panel.querySelector('#meditationCloseBtn').addEventListener('click', closeMeditationOverlay);
        panel.querySelector('#meditationStartBtn').addEventListener('click', function () {
          var current = state.meditationSession;
          if (current) return;
          startMeditationSession(state.meditationSelectedProgram || 'gather');
        });
        panel.querySelector('#meditationFinishBtn').addEventListener('click', function () {
          stopMeditationSession({ saveLog: true });
        });

        state.meditationOverlay = {
          backdrop: backdrop,
          panel: panel,
          title: panel.querySelector('#meditationTitle'),
          subtitle: panel.querySelector('#meditationSubtitle'),
          list: panel.querySelector('#meditationProgramList'),
          steps: panel.querySelector('#meditationSteps'),
          timer: panel.querySelector('#meditationTimer'),
          timerNote: panel.querySelector('#meditationTimerNote'),
          progressBar: panel.querySelector('#meditationProgressBar'),
          startBtn: panel.querySelector('#meditationStartBtn'),
          finishBtn: panel.querySelector('#meditationFinishBtn')
        };
        return state.meditationOverlay;
      }

      function renderMeditationOverlay() {
        var overlay = ensureMeditationOverlay();
        var settings = state.meditationSettings || getDefaultMeditationSettings();
        var selectedKey = state.meditationSelectedProgram || 'gather';
        var program = getMeditationProgram(selectedKey);
        var durationMinutes = resolveMeditationDurationMinutes(selectedKey);

        overlay.title.textContent = program.title;
        overlay.subtitle.textContent = program.subtitle + ' Длительность сейчас: ' + durationMinutes + ' мин.';
        overlay.list.innerHTML = '';
        Object.keys(getMeditationPrograms()).forEach(function (key) {
          var item = getMeditationProgram(key);
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'meditation-program-btn' + (key === selectedKey ? ' is-active' : '');
          btn.innerHTML = '<strong>' + escapeHtml(item.title) + '</strong><span>' + escapeHtml(item.subtitle) + '</span>';
          btn.addEventListener('click', function () {
            if (state.meditationSession) return;
            state.meditationSelectedProgram = key;
            renderMeditationOverlay();
          });
          overlay.list.appendChild(btn);
        });

        overlay.steps.innerHTML = '';
        (program.steps || []).forEach(function (step, index) {
          var row = document.createElement('div');
          row.className = 'meditation-step';
          row.innerHTML = '<strong>' + (index + 1) + '. ' + escapeHtml(step.title || 'Шаг') + '</strong><span>' + escapeHtml(step.text || '') + '</span>';
          overlay.steps.appendChild(row);
        });

        if (!state.meditationSession) {
          overlay.timer.textContent = String(durationMinutes).padStart(2, '0') + ':00';
          overlay.timerNote.textContent = settings.enabled ? 'Готово к запуску.' : 'Слой медитаций отключён в настройках.';
          overlay.progressBar.style.width = '0%';
          overlay.startBtn.disabled = !settings.enabled;
          overlay.startBtn.textContent = 'Начать ' + durationMinutes + ' мин';
        } else {
          updateMeditationTimerUi();
          overlay.startBtn.disabled = true;
          overlay.startBtn.textContent = 'Практика идёт';
        }
      }

      function openMeditationOverlay(programKey) {
        var settings = state.meditationSettings || getDefaultMeditationSettings();
        if (!settings.enabled) {
          showError('Слой микро-медитаций сейчас отключён в настройках.');
          return;
        }
        state.meditationSelectedProgram = getMeditationProgram(programKey || state.meditationSelectedProgram || 'gather').key;
        var overlay = ensureMeditationOverlay();
        overlay.backdrop.style.display = 'flex';
        renderMeditationOverlay();
      }

      function closeMeditationOverlay() {
        if (state.meditationSession) {
          stopMeditationSession({ saveLog: true });
          return;
        }
        if (!state.meditationOverlay) return;
        state.meditationOverlay.backdrop.style.display = 'none';
      }

      function updateMeditationTimerUi() {
        if (!state.meditationSession) return;
        var overlay = ensureMeditationOverlay();
        var plannedMs = state.meditationSession.plannedMinutes * 60 * 1000;
        var elapsedMs = Date.now() - state.meditationSession.startedAt;
        var remainingMs = Math.max(0, plannedMs - elapsedMs);
        overlay.timer.textContent = formatFocusCountdown(remainingMs);
        overlay.timerNote.textContent = 'Осталось ' + formatDurationLabel(Math.max(0, Math.ceil(remainingMs / 60000))) + '.';
        overlay.progressBar.style.width = (plannedMs > 0 ? Math.min(100, (elapsedMs / plannedMs) * 100) : 0).toFixed(2) + '%';
        if (remainingMs <= 0) stopMeditationSession({ saveLog: true, autoCompleted: true });
      }

      function startMeditationSession(programKey) {
        state.meditationSelectedProgram = getMeditationProgram(programKey || 'gather').key;
        state.meditationSession = {
          programKey: state.meditationSelectedProgram,
          plannedMinutes: resolveMeditationDurationMinutes(state.meditationSelectedProgram),
          startedAt: Date.now()
        };
        if (state.meditationTimerId) clearInterval(state.meditationTimerId);
        state.meditationTimerId = setInterval(updateMeditationTimerUi, 1000);
        renderMeditationOverlay();
      }

      function stopMeditationSession(options) {
        var session = state.meditationSession;
        if (state.meditationTimerId) {
          clearInterval(state.meditationTimerId);
          state.meditationTimerId = null;
        }
        state.meditationSession = null;
        if (state.meditationOverlay) state.meditationOverlay.backdrop.style.display = 'none';
        if (!session) return;
        var elapsedMinutes = Math.max(1, Math.round((Date.now() - session.startedAt) / 60000));
        if (options && options.saveLog) {
          appendWellbeingLog('meditation', { programKey: session.programKey, elapsedMinutes: elapsedMinutes });
          showSuccess((options.autoCompleted ? 'Практика завершена. ' : 'Медитация завершена. ') + 'Зафиксировано ' + formatDurationLabel(elapsedMinutes) + '.');
        }
      }

      function resolveDefaultFocusMinutes(task) {
        var plannedDefault = Number(normalizeMinutesInputValue(task && task.planned_minutes_manual));
        if (!Number.isFinite(plannedDefault) || plannedDefault <= 0) plannedDefault = Number(getEffectivePlannedMinutesClient(task));
        if (Number.isFinite(plannedDefault) && plannedDefault > 0) return Math.round(plannedDefault);
        var focusSettings = state.focusSettings || getDefaultFocusSettings();
        if (Number.isFinite(Number(focusSettings.defaultMinutes)) && Number(focusSettings.defaultMinutes) > 0) return Number(focusSettings.defaultMinutes);
        return getWorkModeMeta(state.workMode).suggestedFocusMinutes || 25;
      }


      function getFocusSessionStorageKey() {
        return FOCUS_SESSION_STORAGE_KEY + ':' + String(state.userId || 'anon');
      }

      function getFocusSessionElapsedMs(session) {
        if (!session) return 0;
        var elapsedBeforePauseMs = Math.max(0, Number(session.elapsedBeforePauseMs) || 0);
        if (session.isPaused) return elapsedBeforePauseMs;
        var startedAt = Number(session.startedAt) || 0;
        if (startedAt <= 0) return elapsedBeforePauseMs;
        return elapsedBeforePauseMs + Math.max(0, Date.now() - startedAt);
      }

      function getFocusSessionElapsedMinutes(session) {
        return Math.max(1, Math.round(getFocusSessionElapsedMs(session) / 60000));
      }

      function normalizePersistedFocusSession(value) {
        if (!value || typeof value !== 'object') return null;
        var taskId = String(value.taskId || '').trim();
        var plannedMinutes = Math.round(Number(value.plannedMinutes) || 0);
        if (!taskId || plannedMinutes <= 0) return null;
        var snapshot = cloneTaskForFocus(value.taskSnapshot || null) || null;
        var checklist = Array.isArray(value.checklist)
          ? value.checklist.map(function (item) {
              return {
                text: String(item && item.text || '').trim(),
                is_done: !!(item && item.is_done)
              };
            }).filter(function (item) { return item.text; }).slice(0, 200)
          : [];
        return {
          taskId: taskId,
          plannedMinutes: plannedMinutes,
          startedAt: Number(value.startedAt) || Date.now(),
          elapsedBeforePauseMs: Math.max(0, Number(value.elapsedBeforePauseMs) || 0),
          isPaused: !!value.isPaused,
          pausedAt: value.pausedAt ? Number(value.pausedAt) || null : null,
          taskSnapshot: snapshot,
          checklist: checklist
        };
      }

      function persistFocusSession() {
        try {
          if (!state.focusSession) {
            localStorage.removeItem(getFocusSessionStorageKey());
            return;
          }
          localStorage.setItem(getFocusSessionStorageKey(), JSON.stringify({
            taskId: state.focusSession.taskId,
            plannedMinutes: state.focusSession.plannedMinutes,
            startedAt: state.focusSession.startedAt,
            elapsedBeforePauseMs: state.focusSession.elapsedBeforePauseMs || 0,
            isPaused: !!state.focusSession.isPaused,
            pausedAt: state.focusSession.pausedAt || null,
            taskSnapshot: state.focusSession.taskSnapshot || null,
            checklist: Array.isArray(state.focusSession.checklist) ? state.focusSession.checklist : []
          }));
        } catch (error) {}
      }

      function clearPersistedFocusSession() {
        try { localStorage.removeItem(getFocusSessionStorageKey()); } catch (error) {}
      }

      function restorePersistedFocusSession() {
        try {
          var raw = localStorage.getItem(getFocusSessionStorageKey());
          if (!raw) {
            state.focusSession = null;
            renderFocusSessionBanner();
            return;
          }
          var session = normalizePersistedFocusSession(JSON.parse(raw));
          if (!session) {
            clearPersistedFocusSession();
            state.focusSession = null;
            renderFocusSessionBanner();
            return;
          }
          state.focusSession = session;
          renderFocusSessionBanner();
          if (!session.isPaused) ensureFocusTimerRunning();
        } catch (error) {
          state.focusSession = null;
          clearPersistedFocusSession();
          renderFocusSessionBanner();
        }
      }

      function pauseFocusSession() {
        if (!state.focusSession || state.focusSession.isPaused) return;
        state.focusSession.elapsedBeforePauseMs = getFocusSessionElapsedMs(state.focusSession);
        state.focusSession.isPaused = true;
        state.focusSession.pausedAt = Date.now();
        state.focusSession.startedAt = Date.now();
        if (state.focusTimerId) {
          clearInterval(state.focusTimerId);
          state.focusTimerId = null;
        }
        persistFocusSession();
        renderFocusSession();
        renderFocusSessionBanner();
        showSuccess('Фокус-сессия поставлена на паузу.');
      }

      function resumeFocusSession() {
        if (!state.focusSession || !state.focusSession.isPaused) return;
        state.focusSession.isPaused = false;
        state.focusSession.pausedAt = null;
        state.focusSession.startedAt = Date.now();
        persistFocusSession();
        renderFocusSession();
        renderFocusSessionBanner();
        ensureFocusTimerRunning();
        showSuccess('Фокус-сессия продолжена.');
      }

      function extendFocusSession(minutesToAdd) {
        if (!state.focusSession) return;
        var safeMinutes = Math.max(1, Math.round(Number(minutesToAdd) || 0));
        state.focusSession.plannedMinutes = Math.max(1, Math.round(Number(state.focusSession.plannedMinutes) || 0) + safeMinutes);
        persistFocusSession();
        renderFocusSession();
        renderFocusSessionBanner();
        showSuccess('К фокус-сессии добавлено ' + formatDurationLabel(safeMinutes) + '.');
      }

      function updateFocusSessionBannerUi() {
        var host = byId('focusSessionShell');
        var session = state.focusSession;
        if (!host || !session) return;
        var task = findTaskById(session.taskId) || session.taskSnapshot || {};
        var timer = byId('focusSessionBannerTimer');
        var stateNode = byId('focusSessionBannerState');
        var titleNode = byId('focusSessionBannerTitle');
        var noteNode = byId('focusSessionBannerNote');
        var pauseBtn = byId('focusSessionBannerPauseBtn');
        if (titleNode) titleNode.textContent = task.title || 'Фокус-сессия';
        if (timer) {
          var plannedMs = Math.max(1, Number(session.plannedMinutes) || 0) * 60 * 1000;
          var remainingMs = Math.max(0, plannedMs - getFocusSessionElapsedMs(session));
          timer.textContent = formatFocusCountdown(remainingMs);
        }
        if (stateNode) {
          stateNode.textContent = session.isPaused
            ? 'Пауза · план ' + formatDurationLabel(session.plannedMinutes)
            : 'Идёт фокус · план ' + formatDurationLabel(session.plannedMinutes);
        }
        if (noteNode) {
          var project = task.project_name ? (' · ' + normalizeProjectName(task.project_name)) : '';
          noteNode.textContent = (task.ai_next_step || task.task_product || 'Сконцентрируйся на ближайшем конкретном шаге.') + project;
        }
        if (pauseBtn) {
          pauseBtn.textContent = session.isPaused ? 'Продолжить' : 'Пауза';
          pauseBtn.className = session.isPaused ? 'btn-secondary' : 'btn-ghost';
        }
      }

      function renderFocusSessionBanner() {
        var host = byId('focusSessionShell');
        if (!host) return;
        var session = state.focusSession;
        if (!session) {
          host.innerHTML = '';
          host.classList.add('hidden');
          return;
        }
        host.classList.remove('hidden');
        host.innerHTML =
          '<div class="focus-session-head">' +
            '<div>' +
              '<div class="focus-session-title" id="focusSessionBannerTitle">Фокус-сессия</div>' +
              '<div class="focus-session-note" id="focusSessionBannerNote">—</div>' +
            '</div>' +
            '<div class="focus-session-meta">' +
              '<div class="focus-session-timer" id="focusSessionBannerTimer">00:00</div>' +
              '<div class="focus-session-state" id="focusSessionBannerState">—</div>' +
            '</div>' +
          '</div>' +
          '<div class="focus-session-actions">' +
            '<div class="focus-session-note">Фокус продолжается даже при переключении между Today, Планом, Неделей и Проектами.</div>' +
            '<div style="display:flex;gap:8px;flex-wrap:wrap;">' +
              '<button id="focusSessionBannerOpenBtn" class="btn-secondary" type="button">Вернуться в фокус</button>' +
              '<button id="focusSessionBannerPauseBtn" class="btn-ghost" type="button">Пауза</button>' +
              '<button id="focusSessionBannerExtendBtn" class="btn-ghost" type="button">+10 мин</button>' +
              '<button id="focusSessionBannerFinishBtn" class="btn-primary" type="button">Завершить</button>' +
            '</div>' +
          '</div>';
        var openBtn = byId('focusSessionBannerOpenBtn');
        var pauseBtn = byId('focusSessionBannerPauseBtn');
        var extendBtn = byId('focusSessionBannerExtendBtn');
        var finishBtn = byId('focusSessionBannerFinishBtn');
        if (openBtn) openBtn.addEventListener('click', function () { renderFocusSession(); });
        if (pauseBtn) pauseBtn.addEventListener('click', function () {
          if (state.focusSession && state.focusSession.isPaused) resumeFocusSession();
          else pauseFocusSession();
        });
        if (extendBtn) extendBtn.addEventListener('click', function () { extendFocusSession(10); });
        if (finishBtn) finishBtn.addEventListener('click', function () { stopFocusSession({ saveProgress: true }); });
        updateFocusSessionBannerUi();
      }

      function startFocusSession(task, minutes) {
        var safeMinutes = Math.max(1, Math.round(Number(minutes) || resolveDefaultFocusMinutes(task) || 25));
        state.lastFocusMinutes = safeMinutes;
        state.focusSession = {
          taskId: task.id,
          plannedMinutes: safeMinutes,
          startedAt: Date.now(),
          elapsedBeforePauseMs: 0,
          isPaused: false,
          pausedAt: null,
          taskSnapshot: cloneTaskForFocus(task),
          checklist: (state.editorChecklist || []).map(function (item) {
            return { text: item.text || '', is_done: !!item.is_done };
          }).filter(function (item) { return item.text; })
        };
        var focusProtectionSettings = state.focusProtectionSettings || getDefaultFocusProtectionSettings();
        if (task && task.due_at && focusProtectionSettings.enabled && focusProtectionSettings.autoProtectOnFocusStart && !isTaskFocusProtected(task.id)) {
          toggleTaskFocusProtection(task.id, { silent: true });
        }
        persistFocusSession();
        renderFocusSessionBanner();
        renderFocusSession();
        ensureFocusTimerRunning();
      }

      function loadTodayWidthPercent() {
        var parsed = Number(localStorage.getItem(TODAY_WIDTH_STORAGE_KEY) || 64);
        return Number.isFinite(parsed) ? Math.min(78, Math.max(52, parsed)) : 64;
      }

      function loadWeekWidthPercent() {
        var parsed = Number(localStorage.getItem(WEEK_WIDTH_STORAGE_KEY) || 72);
        return Number.isFinite(parsed) ? Math.min(82, Math.max(54, parsed)) : 72;
      }

      function normalizeHourHeightPx(value, fallback) {
        var parsed = Number(value);
        var base = Number.isFinite(parsed) ? parsed : Number(fallback || 64);
        return Math.min(92, Math.max(42, base));
      }

      function loadTodayHourHeightPx() {
        return normalizeHourHeightPx(localStorage.getItem(TODAY_HEIGHT_STORAGE_KEY), 64);
      }

      function loadWeekHourHeightPx() {
        return normalizeHourHeightPx(localStorage.getItem(WEEK_HEIGHT_STORAGE_KEY), 64);
      }

      function applyTodayWidthPercent(value) {
        var normalized = Math.min(78, Math.max(52, Number(value) || 64));
        state.todayWidthPercent = normalized;
        localStorage.setItem(TODAY_WIDTH_STORAGE_KEY, String(normalized));
        var layout = byId('todayLayout');
        if (layout) layout.style.setProperty('--today-main-width', normalized + '%');
      }

      function applyWeekWidthPercent(value) {
        var normalized = Math.min(82, Math.max(54, Number(value) || 72));
        state.weekWidthPercent = normalized;
        localStorage.setItem(WEEK_WIDTH_STORAGE_KEY, String(normalized));
        var layout = byId('plannerLayout');
        if (layout) layout.style.setProperty('--week-main-width', normalized + '%');
        syncCalendarHeaderScrollbarCompensation();
        applyViewControlSettings(state.viewControlSettings || getDefaultViewControlSettings());
      }

      function applyTodayHourHeightPx(value) {
        var normalized = normalizeHourHeightPx(value, 64);
        state.todayHourHeightPx = normalized;
        localStorage.setItem(TODAY_HEIGHT_STORAGE_KEY, String(normalized));
        var layout = byId('todayLayout');
        if (layout) layout.style.setProperty('--hour-height', normalized + 'px');
      }

      function applyWeekHourHeightPx(value) {
        var normalized = normalizeHourHeightPx(value, 64);
        state.weekHourHeightPx = normalized;
        localStorage.setItem(WEEK_HEIGHT_STORAGE_KEY, String(normalized));
        var layout = byId('plannerLayout');
        if (layout) layout.style.setProperty('--hour-height', normalized + 'px');
        syncCalendarHeaderScrollbarCompensation();
        applyViewControlSettings(state.viewControlSettings || getDefaultViewControlSettings());
      }

      function saveGridStep(value) {
        var normalized = normalizeGridStep(value);
        localStorage.setItem(GRID_STEP_STORAGE_KEY, String(normalized));
        state.gridStepMinutes = normalized;
        refreshEditorPlannedMinutesField(state.editorCurrentTaskSnapshot || {});
        updateEditorTimeMetricsNote(state.editorCurrentTaskSnapshot || {});
        return normalized;
      }

      function getIsCompactViewport() {
        return window.matchMedia('(max-width: 860px)').matches;
      }

      function isTouchLikeDevice() {
        if (typeof window === 'undefined' || typeof navigator === 'undefined') return false;
        var hasFinePointer = false;
        var hasHoverPointer = false;
        var hasCoarsePointer = false;
        try {
          if (window.matchMedia) {
            hasFinePointer = !!(window.matchMedia('(pointer: fine)').matches || window.matchMedia('(any-pointer: fine)').matches);
            hasHoverPointer = !!(window.matchMedia('(hover: hover)').matches || window.matchMedia('(any-hover: hover)').matches);
            hasCoarsePointer = !!(window.matchMedia('(pointer: coarse)').matches || window.matchMedia('(any-pointer: coarse)').matches);
          }
        } catch (error) {}
        if (hasFinePointer || hasHoverPointer) return false;
        if (hasCoarsePointer) return true;
        if (navigator.maxTouchPoints && navigator.maxTouchPoints > 0) return true;
        if ('ontouchstart' in window) return true;
        return false;
      }

      function loadStoredComposerCollapsed() { return true; }
      function saveComposerCollapsed() {}
      function setComposerCollapsed() {}

      function getDefaultSideSectionsState() {
        return {
          today_agenda: false,
          today_backlog: false,
          planner_new: false,
          planner_planned: false,
          planner_done: false,
          planner_canceled: true,
          planner_postponed: true,
          inbox_new: false,
          inbox_triaged: false,
          inbox_plan: false,
          inbox_projects: false,
          inbox_archive: true,
          today_day_blocks: false,
          planner_day_blocks: false
        };
      }

      function normalizeSideSectionsState(value) {
        var defaults = getDefaultSideSectionsState();
        var normalized = Object.assign({}, defaults);
        if (!value || typeof value !== 'object') return normalized;
        Object.keys(defaults).forEach(function (key) { normalized[key] = !!value[key]; });
        return normalized;
      }

      function loadSideSectionsState() {
        try {
          var raw = localStorage.getItem(SIDE_SECTIONS_STORAGE_KEY);
          if (!raw) return getDefaultSideSectionsState();
          return normalizeSideSectionsState(JSON.parse(raw));
        } catch (error) {
          return getDefaultSideSectionsState();
        }
      }

      function saveSideSectionsState() {
        try {
          localStorage.setItem(SIDE_SECTIONS_STORAGE_KEY, JSON.stringify(normalizeSideSectionsState(state.sideSections)));
        } catch (error) {}
      }

      function isSideSectionCollapsed(sectionKey) {
        return !!normalizeSideSectionsState(state.sideSections)[sectionKey];
      }

      function updateSideSectionButtonState(sectionEl) {
        if (!sectionEl) return;
        var sectionKey = sectionEl.getAttribute('data-section-key');
        if (!sectionKey) return;
        var collapsed = isSideSectionCollapsed(sectionKey);
        sectionEl.classList.toggle('is-collapsed', collapsed);
        var button = sectionEl.querySelector('[data-section-toggle]');
        if (button) {
          button.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
          button.setAttribute('title', collapsed ? 'Развернуть блок' : 'Свернуть блок');
        }
        var icon = sectionEl.querySelector('.section-toggle-icon');
        if (icon) icon.textContent = collapsed ? '▸' : '▾';
      }

      function applySideSectionsState(scope) {
        var root = scope || document;
        Array.prototype.forEach.call(root.querySelectorAll('[data-section-key]'), function (sectionEl) {
          updateSideSectionButtonState(sectionEl);
        });
      }

      function toggleSideSection(sectionKey) {
        if (!sectionKey) return;
        if (!state.sideSections) state.sideSections = getDefaultSideSectionsState();
        state.sideSections[sectionKey] = !isSideSectionCollapsed(sectionKey);
        saveSideSectionsState();
        applySideSectionsState();
