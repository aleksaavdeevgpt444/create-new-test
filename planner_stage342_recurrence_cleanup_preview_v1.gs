    SET
      priority_ai = ?,
      project_name = ?,
      ai_priority_reason = ?,
      ai_project_guess = ?,
      ai_next_step = ?,
      updated_at = ?
    WHERE id = ?
  `)
    .bind(priorityAi, nextProjectName, priorityReason, projectGuess || null, nextStep, new Date().toISOString(), taskId)
    .run();
}

