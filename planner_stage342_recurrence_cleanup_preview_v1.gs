      function setTaskFrameworkAssignment(taskId, value, options) {
        var key = String(taskId || '').trim();
        if (!key) return;
        var normalized = normalizeTaskFrameworkAssignment(Object.assign({}, value || {}, { updatedAt: new Date().toISOString() }));
        var hasValue = !!(normalized.primaryFramework || normalized.taskBlockId || normalized.dayPattern || normalized.eisenhower || normalized.abcde || normalized.moscow || normalized.energy);
        if (!state.taskFrameworkAssignments || typeof state.taskFrameworkAssignments !== 'object') state.taskFrameworkAssignments = Object.create(null);
        if (!hasValue) delete state.taskFrameworkAssignments[key];
        else state.taskFrameworkAssignments[key] = normalized;
        saveStoredTaskFrameworkAssignments();
        if (!(options && options.skipServerSync) && state.userId) {
          persistTaskFrameworkAssignmentToServer(key, hasValue ? normalized : {}, { silent: true });
        }
