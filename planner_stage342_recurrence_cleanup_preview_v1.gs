      function getBoardSummaryData(tasks) {
        var list = Array.isArray(tasks) ? tasks : [];
        var blocked = list.filter(function (task) { return !!(getTaskDependencyMeta(task).blockedByTask); }).length;
        var attention = getAttentionTasks(list).length;
        var week = list.filter(function (task) {
          var ymd = getTaskWeekDayYmd(task);
          return !!ymd && isTaskInWeekRange(ymd, state.weekStart || getCurrentWeekStartYmd());
        }).length;
        var overdue = list.filter(isTaskOverdueForWorkspace).length;
        var done = list.filter(function (task) { return (normalizeStatus(task && task.status) || STATUS.NEW) === STATUS.DONE; }).length;
        return {
          total: list.length,
          attention: attention,
          blocked: blocked,
          week: week,
          overdue: overdue,
          done: done
        };
      }

