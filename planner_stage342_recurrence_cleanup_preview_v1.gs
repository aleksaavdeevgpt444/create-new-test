              top.appendChild(warn);
              hasTopContent = true;
            }
            if (visual.showStatus) {
              top.appendChild(createStatusPill(status, status === STATUS.DONE ? '✓' : getStatusSingular(status)));
              hasTopContent = true;
            }
            if (showFocusBadge) {
              var focusBadge = document.createElement('span');
              focusBadge.className = 'calendar-event-focus-badge';
              focusBadge.textContent = 'Фокус';
              top.appendChild(focusBadge);
              hasTopContent = true;
            }
            if (showRiskBadge) {
              var riskBadge = document.createElement('span');
              riskBadge.className = 'calendar-event-risk-badge';
              riskBadge.textContent = riskMeta.isBlocked ? 'Блокер' : 'Риск';
              top.appendChild(riskBadge);
              hasTopContent = true;
            }

            var titleEl = document.createElement('div');
            titleEl.className = 'today-event-title';
            titleEl.textContent = task.title || 'Без названия';

            var projectEl = document.createElement('div');
            projectEl.className = 'today-event-project';
            projectEl.textContent = normalizeProjectName(task.project_name);

            var inline = document.createElement('div');
            inline.className = 'today-event-inline';
            inline.textContent = formatTimeRange(task.due_at, duration) + ' · ' + (task.title || 'Без названия') + ' · ' + normalizeProjectName(task.project_name);

            if (hasTopContent) card.appendChild(top);
            card.appendChild(inline);
            card.appendChild(titleEl);
            if (visual.showProject) card.appendChild(projectEl);

            var resizeHandle = document.createElement('div');
            resizeHandle.className = 'today-event-resize-handle calendar-event-resize-handle';
            resizeHandle.title = 'Изменить длительность';
            resizeHandle.setAttribute('draggable', 'false');
            resizeHandle.addEventListener('dragstart', function (event) { event.preventDefault(); });
            resizeHandle.addEventListener('click', function (event) {
              event.preventDefault();
              event.stopPropagation();
            });
            resizeHandle.addEventListener('touchstart', function (event) {
              event.stopPropagation();
            }, { passive: true });
            resizeHandle.addEventListener('touchmove', function (event) {
              event.stopPropagation();
            }, { passive: true });
            resizeHandle.addEventListener('touchend', function (event) {
              event.preventDefault();
              event.stopPropagation();
            }, { passive: false });
            resizeHandle.addEventListener('pointerdown', function (event) { startResize(event, task, card, timeEl); });
            card.appendChild(resizeHandle);

            eventsLayer.appendChild(card);
          });
        });

        renderCurrentTimeIndicator();
      }

