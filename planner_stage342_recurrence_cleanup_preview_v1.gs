      function getTelegramTaskNotificationTypeKeys(task, dayYmd) {
        var explicitType = normalizeTelegramNotifyTypeClient(task && task.telegram_notify_type);
        if (explicitType === 'none') return [];
        if (explicitType) return [explicitType];
        var keys = [];
        var text = [task && task.title, task && task.description, task && task.task_product, task && task.project_name].filter(Boolean).join(' ').toLowerCase();
        if (task && (Number(task.recurrence_enabled || 0) === 1 || task.recurrence_type || task.recurrence_series_id || task.recurrence_parent_task_id)) keys.push('recurring');
        if (/(созвон|звонок|встреч|митинг|meeting|sync|call|координац|zoom|google meet|meet)/i.test(text)) keys.push('coordination');
        var priority = Math.max(Number(task && task.priority_manual) || 0, Number(task && task.priority_ai) || 0);
        if (priority >= 3 || getTaskDurationMinutes(task) >= 50) keys.push('focus');
