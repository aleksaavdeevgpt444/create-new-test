      function getPlannerBridgeSummaryClient() {
        var bridgeTasks = (state.allTasks || []).filter(isPlannerBridgeTask);
        var recent = bridgeTasks.slice().sort(function (a, b) {
          var aTime = a && a.updated_at ? new Date(a.updated_at).getTime() : 0;
          var bTime = b && b.updated_at ? new Date(b.updated_at).getTime() : 0;
          return bTime - aTime;
        }).slice(0, 6);
        var activeCount = bridgeTasks.filter(function (task) {
          var status = normalizeStatus(task && task.status);
          return status === STATUS.NEW || status === STATUS.PLANNED || status === STATUS.POSTPONED;
        }).length;
        var newCount = bridgeTasks.filter(function (task) { return normalizeStatus(task && task.status) === STATUS.NEW; }).length;
        var plannedCount = bridgeTasks.filter(function (task) { return normalizeStatus(task && task.status) === STATUS.PLANNED; }).length;
        var backlogCount = bridgeTasks.filter(function (task) { return !(task && task.due_at); }).length;
        return {
          totalCount: bridgeTasks.length,
          activeCount: activeCount,
          newCount: newCount,
          plannedCount: plannedCount,
          backlogCount: backlogCount,
          recent: recent
        };
      }

