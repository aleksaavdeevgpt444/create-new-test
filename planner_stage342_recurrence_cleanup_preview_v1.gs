              '<div class="product-map-subtitle">Planner собирается как одна система: входящее → weekly control → раскладка по времени → исполнение дня. Контрольные и стратегические экраны остаются отдельными слоями и не конкурируют с Today.</div>' +
            '</div>' +
            '<div class="product-map-role-pill">' + escapeHtml(spec.viewLabel) + ' = ' + escapeHtml(spec.roleTitle) + '</div>' +
          '</div>' +
          '<div class="product-map-group">' +
            '<div class="product-map-group-label">Основной маршрут</div>' +
            '<div class="product-map-chip-row">' + primaryHtml + '</div>' +
          '</div>' +
          '<div class="product-map-group">' +
            '<div class="product-map-group-label">Контрольные и стратегические слои</div>' +
            '<div class="product-map-chip-row">' + secondaryHtml + '</div>' +
          '</div>' +
          '<div class="product-map-contract">' +
            '<div class="product-map-contract-title">Контракт текущего экрана</div>' +
            '<div class="product-map-contract-question">' + escapeHtml(spec.contractQuestion) + '</div>' +
            '<div class="product-map-contract-hint">' + escapeHtml(spec.transitionHint) + '</div>' +
          '</div>';
      }

      function loadInitialView() {
        var fromQuery = new URL(window.location.href).searchParams.get('view');
        return normalizeViewName(fromQuery || loadStoredDefaultHomeView() || 'today');
      }

      function normalizePeriodMode(value) {
        var candidate = String(value || '').trim().toLowerCase();
        return ['week', 'month', 'quarter'].indexOf(candidate) >= 0 ? candidate : 'week';
      }

      function loadInitialPeriodMode() {
        var fromQuery = new URL(window.location.href).searchParams.get('period');
        return normalizePeriodMode(fromQuery || 'week');
      }

      function loadInitialDayYmd() {
        var fromQuery = new URL(window.location.href).searchParams.get('day');
        return /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(String(fromQuery || '')) ? fromQuery : formatYmdLocal(new Date());
      }

      function getPeriodAnchorDate() {
        return new Date((state.weekStart || getCurrentWeekStartYmd()) + 'T00:00:00');
      }

      function getScaleForView(viewName) {
        var view = normalizeViewName(viewName || state.currentView);
        if (view === 'today') return 'day';
        if (view === 'gantt') return normalizePeriodMode(state.periodMode);
        if (view === 'month') return 'month';
        return 'week';
      }

      function getPeriodStartDate(scaleOverride) {
        var scale = scaleOverride || getScaleForView();
        if (scale === 'day') {
          return new Date((state.dayYmd || formatYmdLocal(new Date())) + 'T00:00:00');
        }
        var date = getPeriodAnchorDate();
        if (scale === 'month') {
          return new Date(date.getFullYear(), date.getMonth(), 1);
        }
        if (scale === 'quarter') {
          var quarterMonth = Math.floor(date.getMonth() / 3) * 3;
          return new Date(date.getFullYear(), quarterMonth, 1);
        }
        return new Date(date.getFullYear(), date.getMonth(), date.getDate());
      }

      function getPeriodEndDateExclusive(scaleOverride) {
        var scale = scaleOverride || getScaleForView();
        var start = getPeriodStartDate(scale);
        if (scale === 'day') return new Date(start.getTime() + 86400000);
        if (scale === 'month') return new Date(start.getFullYear(), start.getMonth() + 1, 1);
        if (scale === 'quarter') return new Date(start.getFullYear(), start.getMonth() + 3, 1);
        return new Date(start.getTime() + 7 * 86400000);
      }

      function buildVisibleDays(scaleOverride) {
        var scale = scaleOverride || getScaleForView();
        if (scale === 'quarter') scale = 'week';
        var days = [];
        var start = getPeriodStartDate(scale);
        var end = getPeriodEndDateExclusive(scale);
        for (var cursor = new Date(start); cursor < end; cursor.setDate(cursor.getDate() + 1)) {
          var ymd = formatYmdLocal(cursor);
          days.push({
            ymd: ymd,
            date: new Date(cursor.getFullYear(), cursor.getMonth(), cursor.getDate()),
            name: formatWithPlannerTimeZone(cursor, { weekday: 'short' }, '—'),
            label: formatWithPlannerTimeZone(cursor, { day: 'numeric', month: 'short' }, '—')
          });
        }
        return days;
      }

      function shiftCurrentPeriod(delta) {
        var scale = getScaleForView();
        if (scale === 'day') {
          state.dayYmd = addDaysYmd(state.dayYmd || formatYmdLocal(new Date()), delta);
          return;
        }
        var date = getPeriodStartDate(scale);
        if (scale === 'month') {
          date.setMonth(date.getMonth() + delta);
          date.setDate(1);
          state.weekStart = formatYmdLocal(date);
          return;
        }
        if (scale === 'quarter') {
          date.setMonth(date.getMonth() + delta * 3);
          date.setDate(1);
          state.weekStart = formatYmdLocal(date);
          return;
        }
        date.setDate(date.getDate() + delta * 7);
        state.weekStart = formatYmdLocal(date);
      }

      function jumpToCurrentPeriod() {
        var now = new Date();
        var scale = getScaleForView();
        if (scale === 'day') {
          state.dayYmd = formatYmdLocal(now);
          return;
        }
        if (scale === 'month') {
          state.weekStart = formatYmdLocal(new Date(now.getFullYear(), now.getMonth(), 1));
          return;
        }
        if (scale === 'quarter') {
          state.weekStart = formatYmdLocal(new Date(now.getFullYear(), Math.floor(now.getMonth() / 3) * 3, 1));
          return;
        }
        state.weekStart = getCurrentWeekStartYmd();
      }

      function getCurrentPeriodRangeIso(scaleOverride) {
        return {
          startIso: getPeriodStartDate(scaleOverride).toISOString(),
          endIso: getPeriodEndDateExclusive(scaleOverride).toISOString()
        };
      }

      function isTaskInActivePeriod(task, scaleOverride) {
        if (!task || !task.due_at) return false;
        var dueMs = new Date(task.due_at).getTime();
        var range = getCurrentPeriodRangeIso(scaleOverride);
        return dueMs >= new Date(range.startIso).getTime() && dueMs < new Date(range.endIso).getTime();
      }

      function renderNavigationViewCleanupContext() {
        var host = byId('viewNav');
        if (!host) return;
        host.classList.toggle('is-current-primary', isPrimaryWorkflowViewName(state.currentView));
        host.classList.toggle('is-current-support', isSupportWorkflowViewName(state.currentView));
        host.classList.toggle('is-current-utility', isUtilityWorkflowViewName(state.currentView));
      }

      function updateViewButtons() {
        Array.prototype.forEach.call(document.querySelectorAll('[data-app-view-target]'), function (btn) {
          var target = normalizeViewName(btn.getAttribute('data-app-view-target'));
          var priority = NAVIGATION_VIEW_PRIORITY[target] || 'utility';
          var isFlowMain = target === 'today' || target === 'plan' || target === 'planner';
          btn.classList.toggle('is-active', target === state.currentView);
          btn.classList.toggle('is-primary-nav', priority === 'primary');
          btn.classList.toggle('is-core-nav', priority === 'core');
          btn.classList.toggle('is-support-nav', priority === 'support');
          btn.classList.toggle('is-utility-nav', priority === 'utility');
          btn.classList.toggle('is-flow-main', isFlowMain);
          btn.classList.toggle('is-flow-link', target === 'inbox');
          btn.setAttribute('data-nav-priority', priority);
          btn.setAttribute('aria-current', target === state.currentView ? 'page' : 'false');
          if (target === 'month') btn.setAttribute('title', 'Обзорный слой месяца');
          else if (target === 'templates') btn.setAttribute('title', 'Сервисный слой шаблонов и блоков дня');
          else if (target === 'board' || target === 'projects' || target === 'gantt') btn.setAttribute('title', 'Отдельный контрольный или стратегический слой');
          else btn.setAttribute('title', 'Основной рабочий маршрут planner');
        });
      }

      function updateViewSections() {
        var viewMap = {
          today: byId('todayView'),
          inbox: byId('inboxView'),
          templates: byId('templatesView'),
          planner: byId('plannerView'),
          projects: byId('projectsView'),
          board: byId('boardView'),
          plan: byId('planView'),
          gantt: byId('ganttView'),
          month: byId('monthView'),
          settings: byId('settingsView')
        };
        Object.keys(viewMap).forEach(function (key) {
          if (!viewMap[key]) return;
          viewMap[key].classList.toggle('is-active', key === state.currentView);
        });
        document.body.classList.toggle('settings-page-active', state.currentView === 'settings');
      }

      function setViewInUrl() {
        var url = new URL(window.location.href);
        url.searchParams.set('view', state.currentView || 'today');
        if (state.userId && shouldExposeUserIdInUrl()) url.searchParams.set('user_id', state.userId);
        else url.searchParams.delete('user_id');
        url.searchParams.set('week_start', state.weekStart || getCurrentWeekStartYmd());
        url.searchParams.set('day', state.dayYmd || formatYmdLocal(new Date()));
        url.searchParams.set('period', state.periodMode || 'week');
        url.searchParams.set('space', normalizeTaskSpaceClient(state.activeSpaceKey || 'all'));
        window.history.replaceState({}, '', url.toString());
      }

      function setActiveView(nextView) {
        var normalizedView = normalizeViewName(nextView);
        if (normalizedView !== 'settings') state.settingsReturnView = normalizedView;
        state.currentView = normalizedView;
        updateViewButtons();
        renderNavigationViewCleanupContext();
        updateViewSections();
        renderWeekInlineMetrics();
        updateWeekLabels();
        updateShellHero();
        renderProductMapStrip();
        renderNavigationReframeStrip();
        renderCoreFlowPolishStrip();
        renderScreenContractsCleanupStrip();
        refreshLiveNowIndicators();
        renderFocusSessionBanner();
        applyViewControlSettings(state.viewControlSettings || getDefaultViewControlSettings());
        setViewInUrl();
        if (state.currentView === 'planner') {
          setTimeout(function () {
            syncCalendarHeaderScrollbarCompensation();
            wireCalendarScrollSync();
          }, 0);
        }
      }

      function normalizeProjectName(value) {
        var project = String(value || '').trim();
        return project || 'Без проекта';
      }

      function normalizeTaskSpaceClient(value) {
        var normalized = String(value || '').trim().toLowerCase();
        if (normalized === 'personal' || normalized === 'private' || normalized === 'личное') return 'personal';
        if (normalized === 'all' || normalized === 'common' || normalized === 'general' || normalized === 'shared' || normalized === 'все' || normalized === 'всё' || normalized === 'общее' || normalized === 'общие') return 'all';
        return 'work';
      }

      function getTaskSpaceLabel(value) {
        return normalizeTaskSpaceClient(value) === 'personal' ? 'Личное' : 'Рабочее';
      }

      function normalizeTelegramNotifyTypeClient(value) {
        var normalized = String(value || '').trim().toLowerCase();
        if (!normalized || normalized === 'auto') return null;
        if (['coordination', 'recurring', 'focus', 'current', 'none'].includes(normalized)) return normalized;
        return null;
      }

      /**
       * Backward-compatible client alias.
       * Older Telegram watcher code can still call normalizeTelegramNotifyType(),
       * while the current client-side implementation uses normalizeTelegramNotifyTypeClient().
       */
      function normalizeTelegramNotifyType(value) {
        return normalizeTelegramNotifyTypeClient(value);
      }

      function getTelegramNotifyTypeSelectValue(value) {
        return normalizeTelegramNotifyTypeClient(value) || 'auto';
      }

      function getSpaceSwitchStorageKey() {
        return 'planner-active-space-v1';
      }

      function loadStoredActiveSpaceKey() {
        try {
          return normalizeTaskSpaceClient(localStorage.getItem(getSpaceSwitchStorageKey()) || 'all');
        } catch (error) {
          return 'all';
        }
      }

      function persistActiveSpaceKey() {
        try { localStorage.setItem(getSpaceSwitchStorageKey(), normalizeTaskSpaceClient(state.activeSpaceKey || 'all')); } catch (error) {}
      }

      function loadInitialActiveSpaceKey() {
        try {
          var urlValue = new URL(window.location.href).searchParams.get('space');
          if (urlValue) return normalizeTaskSpaceClient(urlValue);
        } catch (error) {}
        return loadStoredActiveSpaceKey();
      }

      function getDefaultCreateSpaceKey() {
        var active = normalizeTaskSpaceClient(state.activeSpaceKey || 'all');
        return active === 'personal' ? 'personal' : 'work';
      }

      function setActiveSpaceKey(nextSpaceKey) {
        state.activeSpaceKey = normalizeTaskSpaceClient(nextSpaceKey);
        persistActiveSpaceKey();
        setViewInUrl();
        renderSpaceSwitcher();
        renderShellViews();
        renderFocusSessionBanner();
        updateShellHero();
      }

      function taskMatchesActiveSpace(task) {
        var active = normalizeTaskSpaceClient(state.activeSpaceKey || 'all');
        if (active === 'all') return true;
        return normalizeTaskSpaceClient(task && task.space_key) === active;
      }

      function shouldMuteTaskByActiveSpace(task) {
        var active = normalizeTaskSpaceClient(state.activeSpaceKey || 'all');
        return active !== 'all' && !taskMatchesActiveSpace(task);
      }

      function getTasksForActiveSpace(tasks) {
        var list = Array.isArray(tasks) ? tasks.slice() : [];
        var active = normalizeTaskSpaceClient(state.activeSpaceKey || 'all');
        if (active === 'all') return list;
        var focused = [];
        var muted = [];
        list.forEach(function (task) {
          if (taskMatchesActiveSpace(task)) focused.push(task);
          else muted.push(task);
        });
        return focused.concat(muted);
      }

      /**
       * STAGE 302 — strict space scope for numeric metrics only.
       *
       * Важно: getTasksForActiveSpace() оставлен как UX-функция сортировки/приглушения,
       * чтобы не ломать текущую логику показа задач из других пространств.
       * Для расчётов План/Факт используем отдельный строгий фильтр:
       * - Общее / Все => все задачи;
       * - Рабочее => только work;
       * - Личное => только personal.
       */
      function getTasksForActiveSpaceMetrics(tasks) {
        var list = Array.isArray(tasks) ? tasks.slice() : [];
        var active = normalizeTaskSpaceClient(state.activeSpaceKey || 'all');
        if (active === 'all') return list;
        return list.filter(function (task) {
          return taskMatchesActiveSpace(task);
        });
      }

      function applyTaskSpaceFocusClass(element, task) {
        if (!element) return element;
        element.classList.remove('is-space-muted');
        if (shouldMuteTaskByActiveSpace(task)) element.classList.add('is-space-muted');
        return element;
      }

      function applyTaskVisualStatusClass(element, taskOrStatus) {
        if (!element) return element;
        var status = typeof taskOrStatus === 'string' ? normalizeStatus(taskOrStatus) : normalizeStatus(taskOrStatus && taskOrStatus.status);
        if (status === STATUS.PLANNED) element.classList.add('is-status-planned');
        if (status === STATUS.DONE) element.classList.add('is-status-done');
        return element;
      }

      function createTaskSpaceChip(task) {
        var chip = document.createElement('span');
        var spaceKey = normalizeTaskSpaceClient(task && task.space_key);
        chip.className = 'space-chip is-' + (spaceKey === 'personal' ? 'personal' : 'work');
        chip.textContent = getTaskSpaceLabel(spaceKey);
        return chip;
      }

      function renderSpaceSwitcher() {
        var host = byId('spaceSwitchShell');
        if (!host) return;
        host.innerHTML = '';

        var group = document.createElement('div');
        group.className = 'space-switch-group';

        var title = document.createElement('div');
        title.className = 'space-switch-title';
        title.textContent = 'Пространство';
        group.appendChild(title);

        ['work','personal','all'].forEach(function (key) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'space-switch-btn' + (normalizeTaskSpaceClient(state.activeSpaceKey) === key ? ' is-active' : '');
          btn.textContent = key === 'work' ? 'Рабочее' : (key === 'personal' ? 'Личное' : 'Все');
          btn.addEventListener('click', function () {
            setActiveSpaceKey(key);
          });
          group.appendChild(btn);
        });
        host.appendChild(group);

        var summaryData = getSpaceSummaryData();
        var summaryWrap = document.createElement('div');
        summaryWrap.className = 'space-switch-summary';

        ['work', 'personal', 'all'].forEach(function (key) {
          var item = summaryData[key];
          if (!item) return;
          var card = document.createElement('div');
          card.className = 'space-summary-card' + (normalizeTaskSpaceClient(state.activeSpaceKey) === key ? ' is-active' : '');

          var head = document.createElement('div');
          head.className = 'space-summary-head';

          var headMeta = document.createElement('div');
          var itemTitle = document.createElement('div');
          itemTitle.className = 'space-summary-title';
          itemTitle.textContent = item.label;
          var itemNote = document.createElement('div');
          itemNote.className = 'space-summary-note';
          itemNote.textContent = item.note;
          headMeta.appendChild(itemTitle);
          headMeta.appendChild(itemNote);

          head.appendChild(headMeta);

          var badge = document.createElement('span');
          badge.className = 'space-chip is-' + (key === 'personal' ? 'personal' : 'work');
          badge.textContent = key === 'all' ? 'Все' : getTaskSpaceLabel(key);
          head.appendChild(badge);
          card.appendChild(head);

          var metrics = document.createElement('div');
          metrics.className = 'space-summary-metrics';
          [
            'Задач: ' + item.count,
            'В календаре: ' + item.scheduled,
            'Backlog: ' + item.backlog,
            'Просрочено: ' + item.overdue
          ].forEach(function (label) {
            var metric = document.createElement('div');
            metric.className = 'space-summary-metric';
            metric.textContent = label;
            metrics.appendChild(metric);
          });
          card.appendChild(metrics);

          var actions = document.createElement('div');
          actions.className = 'space-summary-actions';

          var filterBtn = document.createElement('button');
          filterBtn.type = 'button';
          filterBtn.className = normalizeTaskSpaceClient(state.activeSpaceKey) === key ? 'btn-secondary' : 'btn-ghost';
          filterBtn.textContent = normalizeTaskSpaceClient(state.activeSpaceKey) === key ? 'Активно' : 'Фильтр';
          filterBtn.addEventListener('click', function () {
            setActiveSpaceKey(key);
          });
          actions.appendChild(filterBtn);

          var createBtn = document.createElement('button');
          createBtn.type = 'button';
          createBtn.className = 'btn-ghost';
          createBtn.textContent = 'Новая задача';
          createBtn.addEventListener('click', function () {
            state.activeSpaceKey = key === 'all' ? 'work' : key;
            persistActiveSpaceKey();
            openCreateDrawer();
            renderSpaceSwitcher();
            updateShellHero();
            setViewInUrl();
          });
          actions.appendChild(createBtn);

          if (item.nextTask && item.nextTask.id) {
            var openBtn = document.createElement('button');
            openBtn.type = 'button';
            openBtn.className = 'btn-ghost';
            openBtn.textContent = 'Открыть ближайшую';
            openBtn.addEventListener('click', function () {
              if (key !== 'all') setActiveSpaceKey(key);
              openEditor(item.nextTask.id);
            });
            actions.appendChild(openBtn);
          }

          card.appendChild(actions);
          summaryWrap.appendChild(card);
        });

        host.appendChild(summaryWrap);
      }

      function collectFallbackTasks() {
        var map = {};
        var result = [];
        var planner = state.planner || {};
        var scheduled = planner.scheduled || [];
        var queues = planner.queues || {};
        function pushTask(task) {
          if (!task || !task.id || map[task.id]) return;
          map[task.id] = true;
          result.push(task);
        }
        scheduled.forEach(pushTask);
        Object.keys(queues).forEach(function (key) {
          (queues[key] || []).forEach(pushTask);
        });
        return result;
      }

      function getAllShellTasks() {
        return (state.allTasks && state.allTasks.length ? state.allTasks : collectFallbackTasks()).slice();
      }

      function getShellTasks() {
        return getTasksForActiveSpace(getAllShellTasks());
      }

      function getSpaceSummaryData() {
        var allTasks = getAllShellTasks();
        var summary = {
          all: { key: 'all', label: 'Все пространства', note: 'Общий срез по planner', count: 0, scheduled: 0, backlog: 0, done: 0, overdue: 0, nextTask: null },
          work: { key: 'work', label: 'Рабочее', note: 'Фокус на рабочих сценариях', count: 0, scheduled: 0, backlog: 0, done: 0, overdue: 0, nextTask: null },
          personal: { key: 'personal', label: 'Личное', note: 'Личные задачи и ритмы', count: 0, scheduled: 0, backlog: 0, done: 0, overdue: 0, nextTask: null }
        };
        var now = new Date();
        allTasks.forEach(function (task) {
          if (!task || !task.id) return;
          var key = normalizeTaskSpaceClient(task.space_key);
          var status = normalizeStatus(task.status) || STATUS.NEW;
          var dueAt = task.due_at ? new Date(task.due_at) : null;
          ['all', key].forEach(function (bucketKey) {
            var bucket = summary[bucketKey];
            if (!bucket) return;
            bucket.count += 1;
            if (status === STATUS.DONE) bucket.done += 1;
            if (status === STATUS.NEW || status === STATUS.POSTPONED) bucket.backlog += 1;
            if ((status === STATUS.PLANNED || status === STATUS.DONE) && task.due_at) bucket.scheduled += 1;
            if (status !== STATUS.DONE && dueAt && !isNaN(dueAt.getTime()) && dueAt < now) bucket.overdue += 1;
            if (task.due_at && status !== STATUS.DONE) {
              if (!bucket.nextTask) bucket.nextTask = task;
              else {
                var currentNext = new Date(bucket.nextTask.due_at || 0);
                if (isNaN(currentNext.getTime()) || dueAt < currentNext) bucket.nextTask = task;
              }
            }
          });
        });
        return summary;
      }

      function compareTasksByDueAndUpdated(a, b) {
        var aDue = a && a.due_at ? new Date(a.due_at).getTime() : Number.MAX_SAFE_INTEGER;
        var bDue = b && b.due_at ? new Date(b.due_at).getTime() : Number.MAX_SAFE_INTEGER;
        if (aDue !== bDue) return aDue - bDue;
        var aUpdated = a && a.updated_at ? new Date(a.updated_at).getTime() : 0;
        var bUpdated = b && b.updated_at ? new Date(b.updated_at).getTime() : 0;
        return bUpdated - aUpdated;
      }

      function getPlannerBridgeSourceLabel(source) {
        var key = String(source || '').trim().toLowerCase();
        if (key === 'ideas-hub' || key === 'hub') return 'Ideas Hub';
        if (key === 'telegram') return 'Telegram';
        if (key === 'template') return 'Шаблон';
        if (key === 'checklist') return 'Checklist';
        if (key === 'quick-capture') return 'Быстрый ввод';
        return key || 'Источник';
      }

      function isPlannerBridgeTask(task) {
        var source = String((task && task.source) || '').trim().toLowerCase();
        return source === 'ideas-hub' || source === 'hub';
      }

      function createPlannerBridgeSourceChip(task) {
        if (!isPlannerBridgeTask(task)) return null;
        var chip = createChip(getPlannerBridgeSourceLabel(task && task.source));
        chip.classList.add('task-source-chip');
        return chip;
      }

      function createShellTaskCard(task) {
        var status = normalizeStatus(task && task.status) || STATUS.NEW;
        var card = document.createElement('div');
        card.className = 'shell-task-card';
        applyTaskSpaceFocusClass(card, task);
        applyTaskVisualStatusClass(card, status);
        card.setAttribute('tabindex', '0');
        attachDragSource(card, { taskId: task.id, source: 'today', status: status, dueAt: task.due_at || null, durationMinutes: getTaskDurationMinutes(task) });
        card.addEventListener('click', function () { openEditor(task.id); });
        card.addEventListener('keydown', function (event) {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openEditor(task.id);
          }
        });

        var title = document.createElement('div');
        title.className = 'shell-task-title';
        title.textContent = task.title || 'Без названия';
        card.appendChild(title);

        var meta = document.createElement('div');
        meta.className = 'shell-task-meta';
        meta.appendChild(createChip(normalizeProjectName(task.project_name)));
        meta.appendChild(createTaskSpaceChip(task));
        meta.appendChild(createStatusPill(status, getStatusSingular(status)));
        var sourceChip = createPlannerBridgeSourceChip(task);
        if (sourceChip) meta.appendChild(sourceChip);
        if (task.due_at) meta.appendChild(createChip(formatTimeRange(task.due_at, getTaskDurationMinutes(task), { withDate: true })));
        if (task.priority_ai) meta.appendChild(createChip(getPriorityText(task.priority_ai)));
        getTaskDependencyMetaNodes(task).forEach(function (node) { meta.appendChild(node); });
        card.appendChild(meta);
        return card;
      }

      function createBoardTaskAction(label, onClick, tone) {
        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'board-task-action';
        if (tone) button.classList.add('is-' + tone);
        button.textContent = label;
        button.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          onClick();
        });
        return button;
      }

      function getBoardTaskPriorityKey(task) {
        var rank = getTaskPriorityRank(task);
        if (rank >= 3) return 'high';
        if (rank >= 2) return 'medium';
        if (rank >= 1) return 'low';
        return 'none';
      }

      function getBoardTaskPriorityLabel(task) {
        var key = getBoardTaskPriorityKey(task);
        if (key === 'high') return 'Высокий приоритет';
        if (key === 'medium') return 'Средний приоритет';
        if (key === 'low') return 'Низкий приоритет';
        return 'Без приоритета';
      }

      function normalizeBoardProjectFilterValue(value) {
        var safe = String(value || 'all').trim();
        return safe || 'all';
      }


      function setBoardControlState(next) {
        var patch = next && typeof next === 'object' ? next : {};
        if (Object.prototype.hasOwnProperty.call(patch, 'focus')) state.boardFocus = patch.focus;
        if (Object.prototype.hasOwnProperty.call(patch, 'sort')) state.boardSort = patch.sort;
        if (Object.prototype.hasOwnProperty.call(patch, 'priority')) state.boardPriorityFilter = patch.priority;
        if (Object.prototype.hasOwnProperty.call(patch, 'project')) state.boardProjectFilter = patch.project;
        if (Object.prototype.hasOwnProperty.call(patch, 'timing')) state.boardTimingFilter = patch.timing;
        renderBoardView();
      }

      function scrollToBoardColumn(status) {
        var host = byId('boardShell');
        var target = host ? host.querySelector('[data-board-status="' + String(status || '') + '"]') : null;
        if (target && typeof target.scrollIntoView === 'function') {
          target.scrollIntoView({ behavior: 'smooth', block: 'start', inline: 'center' });
        }
      }

      function createBoardKanbanAction(label, handler, kind) {
        var button = document.createElement('button');
        button.type = 'button';
        button.className = kind === 'primary' ? 'btn-secondary' : 'btn-ghost';
        button.textContent = label;
        button.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          handler();
        });
        return button;
      }

      function getBoardKanbanControlData(tasks) {
        var list = Array.isArray(tasks) ? tasks : [];
        var blockedItems = list.filter(function (task) { return !!(getTaskDependencyMeta(task).blockedByTask); });
        var backlogItems = list.filter(function (task) { return !(task && task.due_at); });
        var overdueItems = list.filter(isTaskOverdueForWorkspace);
        var plannedItems = list.filter(function (task) { return (normalizeStatus(task && task.status) || STATUS.NEW) === STATUS.PLANNED; });
        var doneItems = list.filter(function (task) { return (normalizeStatus(task && task.status) || STATUS.NEW) === STATUS.DONE; });
        return {
          blockedItems: blockedItems,
          backlogItems: backlogItems,
          overdueItems: overdueItems,
          plannedItems: plannedItems,
          doneItems: doneItems,
          attentionCount: getAttentionTasks(list).length,
          focusLabel: getBoardFocusLabel(state.boardFocus || 'all'),
          sortLabel: getBoardSortLabel(state.boardSort || 'due')
        };
      }

      function createBoardControlOverviewCard(config) {
        var card = document.createElement('div');
        card.className = 'board-summary-card';
        if (config.tone) card.classList.add('is-' + config.tone);
