            actions.appendChild(triagedBtn);
          }
          if (stage !== 'plan') {
            var planBtn = document.createElement('button');
            planBtn.type = 'button';
            planBtn.className = 'btn-ghost';
            planBtn.textContent = 'В план';
            planBtn.addEventListener('click', function () { setInboxTaskStage(task.id, 'plan'); });
            actions.appendChild(planBtn);
          }
          if (stage !== 'projects') {
            var projectBtn = document.createElement('button');
            projectBtn.type = 'button';
            projectBtn.className = 'btn-ghost';
            projectBtn.textContent = 'В проект';
            projectBtn.addEventListener('click', function () { setInboxTaskStage(task.id, 'projects'); });
            actions.appendChild(projectBtn);
          }
          var riskBtn = document.createElement('button');
          riskBtn.type = 'button';
          riskBtn.className = isTaskAttentionNeeded(task) ? 'btn-secondary' : 'btn-ghost';
          riskBtn.textContent = 'Риск';
          riskBtn.addEventListener('click', function () { openTaskRiskDialog(task.id); });
          actions.appendChild(riskBtn);
          var reminderBtn = document.createElement('button');
          reminderBtn.type = 'button';
          reminderBtn.className = task.remind_at ? 'btn-secondary' : 'btn-ghost';
          reminderBtn.textContent = task.remind_at ? 'Снять напоминание' : 'Напомнить';
          reminderBtn.addEventListener('click', function () {
            if (task.remind_at) updateTaskReminder(task.id, null);
            else setSuggestedTaskReminder(task);
          });
          actions.appendChild(reminderBtn);
          var archiveBtn = document.createElement('button');
          archiveBtn.type = 'button';
          archiveBtn.className = 'btn-ghost';
          archiveBtn.textContent = 'В архив';
          archiveBtn.addEventListener('click', function () { setInboxTaskStage(task.id, 'archive'); });
          actions.appendChild(archiveBtn);
        } else {
          var restoreBtn = document.createElement('button');
          restoreBtn.type = 'button';
          restoreBtn.className = 'btn-ghost';
          restoreBtn.textContent = 'Вернуть';
          restoreBtn.addEventListener('click', function () {
