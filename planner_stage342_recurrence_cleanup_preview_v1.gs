      function getWorkflowDayContextSummary(dayYmd) {
        var safeDayYmd = dayYmd || state.dayYmd || formatYmdLocal(new Date());
        var dayTasks = getTasksForDay(safeDayYmd) || [];
        var activeTasks = dayTasks.filter(function (task) {
          var status = normalizeStatus(task && task.status);
          return status === STATUS.PLANNED || status === STATUS.DONE;
        });
        var plannedTasks = activeTasks.filter(function (task) { return normalizeStatus(task && task.status) === STATUS.PLANNED; });
        var doneTasks = activeTasks.filter(function (task) { return normalizeStatus(task && task.status) === STATUS.DONE; });
        var noTimeTasks = activeTasks.filter(function (task) { return !task || !task.due_at; });
        var metrics = aggregateTaskTimeMetrics(activeTasks);
        var capacity = splitDayTasksByCapacity(safeDayYmd, activeTasks);
        var date = new Date(safeDayYmd + 'T00:00:00');
        var title = formatWithPlannerTimeZone(date, { weekday: 'long', day: 'numeric', month: 'long' }, safeDayYmd) || safeDayYmd;
        var shortLabel = formatWithPlannerTimeZone(date, { day: 'numeric', month: 'short' }, safeDayYmd) || safeDayYmd;
        var isToday = safeDayYmd === formatYmdLocal(new Date());
        var nextFocus = plannedTasks[0] || activeTasks[0] || null;
        return {
          dayYmd: safeDayYmd,
          title: title,
          shortLabel: shortLabel,
          activeCount: activeTasks.length,
          plannedCount: plannedTasks.length,
          doneCount: doneTasks.length,
          noTimeCount: noTimeTasks.length,
          plannedMinutes: metrics.planned,
          actualMinutes: metrics.actual,
          capacityMinutes: capacity.capacityMinutes,
          overflowMinutes: capacity.overflowMinutes,
          freeMinutes: capacity.freeMinutes,
          isToday: isToday,
          nextFocus: nextFocus
        };
      }

