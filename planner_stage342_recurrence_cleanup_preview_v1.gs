          return;
        }
        if (isTelegramTaskNotifyMinGapActive(settings, now)) {
          setTelegramTaskNotifyState({ lastStatus: 'rate_limited', lastError: '' });
          return;
        }
        var candidates = (state.allTasks || []).filter(function (task) { return isTelegramTaskNotificationCandidate(task, settings); }).sort(compareTasksByDueAndUpdated);
        for (var i = 0; i < candidates.length; i += 1) {
          var task = candidates[i];
          var triggerIso = getTelegramTaskNotificationTriggerIso(task, settings);
          var triggerDate = triggerIso ? new Date(triggerIso) : null;
          if (!(triggerDate && !isNaN(triggerDate.getTime()) && triggerDate <= now)) continue;
          var signature = getTelegramTaskNotificationSignature(task, settings, triggerIso);
          var entry = state.telegramTaskNotifyDeliveredMap[signature];
          if (shouldSkipTelegramTaskNotificationDelivery(entry)) continue;
          var typeKeys = getTelegramTaskNotificationTypeKeys(task, state.dayYmd || formatYmdLocal(new Date()));
          try {
            await sendTelegramTaskNotification(task, settings, triggerIso, typeKeys);
            state.telegramTaskNotifyDeliveredMap[signature] = { deliveredAt: new Date().toISOString(), title: task.title || '' };
            saveStoredTelegramTaskNotifyDeliveredMap();
            break;
          } catch (error) {
            state.telegramTaskNotifyDeliveredMap[signature] = { failedAt: new Date().toISOString(), error: String(error && error.message ? error.message : error) };
            saveStoredTelegramTaskNotifyDeliveredMap();
            setTelegramTaskNotifyState({
              lastTaskTitle: String(task && task.title || '').trim(),
              lastTaskId: String(task && task.id || '').trim(),
              lastStatus: 'error',
              lastError: String(error && error.message ? error.message : error)
            });
          }
        }
      }

      function getReminderSignature(task) {
        if (!(task && task.id && task.remind_at)) return '';
        return String(task.id) + '|' + String(task.remind_at);
      }

      function clearReminderDeliveredForTask(taskId) {
        var prefix = String(taskId || '') + '|';
        Object.keys(state.reminderDeliveredMap || {}).forEach(function (key) {
          if (key.indexOf(prefix) === 0) delete state.reminderDeliveredMap[key];
        });
        saveStoredReminderDeliveredMap();
      }

      function isReminderCandidateTask(task) {
        var status = normalizeStatus(task && task.status);
        if (!task || !task.id || !task.remind_at) return false;
        if (status === STATUS.DONE || status === STATUS.CANCELED) return false;
        return true;
      }

      function getTaskYmdFromIso(iso) {
        if (!iso) return '';
        var date = new Date(iso);
        if (isNaN(date.getTime())) return '';
        return formatYmdLocal(date);
      }

      function getReminderCenterData(dayYmd) {
        var settings = state.reminderSettings || getDefaultReminderSettings();
        var now = new Date();
        var upcomingEnd = new Date(now.getTime() + Math.max(15, Number(settings.upcomingWindowMinutes) || 180) * 60000);
        var recentPast = new Date(now.getTime() - 24 * 60 * 60000);
        var targetDay = dayYmd || state.dayYmd || formatYmdLocal(new Date());
        var tasks = (state.allTasks || []).filter(isReminderCandidateTask).map(function (task) {
          var remindDate = new Date(task.remind_at);
          return Object.assign({}, task, { _remindDate: remindDate });
        }).filter(function (task) {
          return task._remindDate && !isNaN(task._remindDate.getTime());
        });
        function belongsToDay(task) {
          return getTaskYmdFromIso(task.due_at) === targetDay || getTaskYmdFromIso(task.remind_at) === targetDay;
        }
        var overdue = tasks.filter(function (task) {
          return task._remindDate <= now && task._remindDate >= recentPast && (belongsToDay(task) || task._remindDate <= now);
        }).sort(function (a, b) { return a._remindDate - b._remindDate; });
        var upcoming = tasks.filter(function (task) {
          return task._remindDate > now && task._remindDate <= upcomingEnd && belongsToDay(task);
        }).sort(function (a, b) { return a._remindDate - b._remindDate; });
        return {
          overdue: overdue,
          upcoming: upcoming,
          total: overdue.length + upcoming.length,
          settings: settings
        };
      }

      function notifyReminder(task) {
        var settings = state.reminderSettings || getDefaultReminderSettings();
        var title = task && task.title ? task.title : 'Напоминание по задаче';
        var body = task && task.due_at
          ? 'Запланировано: ' + formatTimeRange(task.due_at, getTaskDurationMinutes(task), { withDate: false })
          : 'Задача без времени. Самое время вернуться к ней.';
        if (settings.browserNotifications && typeof Notification !== 'undefined' && Notification && Notification.permission === 'granted') {
          try {
            new Notification('Planner · ' + title, { body: body, tag: 'planner-reminder-' + String(task.id || '') });
            return;
          } catch (error) {}
        }
        showSuccess('Напоминание: ' + title);
      }

      function checkDueReminders() {
        var settings = state.reminderSettings || getDefaultReminderSettings();
        if (!settings.enabled) return;
        var now = new Date();
        (state.allTasks || []).filter(isReminderCandidateTask).forEach(function (task) {
          var signature = getReminderSignature(task);
          if (!signature || state.reminderDeliveredMap[signature]) return;
          var remindDate = new Date(task.remind_at);
          if (isNaN(remindDate.getTime()) || remindDate > now) return;
          state.reminderDeliveredMap[signature] = { deliveredAt: new Date().toISOString() };
          saveStoredReminderDeliveredMap();
          notifyReminder(task);
        });
        if (state.currentView === 'today') renderTodayReminderCenter(state.dayYmd || formatYmdLocal(new Date()));
      }

      function clearTelegramTaskNotifyWatcher() {
        if (state.telegramTaskNotifyTimerId) {
          clearTimeout(state.telegramTaskNotifyTimerId);
          state.telegramTaskNotifyTimerId = null;
        }
      }

      function getTelegramTaskNotifyQuietResumeDate(settings, now) {
        var normalized = normalizeTelegramTaskNotifySettings(settings || state.telegramTaskNotifySettings || getDefaultTelegramTaskNotifySettings());
        if (!normalized.enabled || !normalized.quietHoursEnabled) return null;
        var current = now instanceof Date ? now : new Date();
        var startMinutes = parseTelegramTaskNotifyClockMinutes(normalized.quietStart, 23 * 60);
        var endMinutes = parseTelegramTaskNotifyClockMinutes(normalized.quietEnd, 8 * 60);
        if (startMinutes === endMinutes) return new Date(current.getTime() + 60 * 60000);
        var currentMinutes = getPlannerClockMinutes(current);
        if (startMinutes < endMinutes) {
          if (!(currentMinutes >= startMinutes && currentMinutes < endMinutes)) return null;
        } else {
          if (!(currentMinutes >= startMinutes || currentMinutes < endMinutes)) return null;
        }
        var base = new Date(current.getTime());
        var resume = new Date(base.getTime());
        resume.setSeconds(0, 0);
        resume.setMinutes(endMinutes % 60);
        resume.setHours(Math.floor(endMinutes / 60));
        if (startMinutes < endMinutes) {
          if (resume <= current) resume.setDate(resume.getDate() + 1);
        } else {
          if (currentMinutes >= startMinutes || resume <= current) resume.setDate(resume.getDate() + 1);
        }
        return resume;
      }

      function getNextTelegramTaskNotificationDelayMs(settings, now) {
        var normalized = normalizeTelegramTaskNotifySettings(settings || state.telegramTaskNotifySettings || getDefaultTelegramTaskNotifySettings());
        if (!normalized.enabled || !String(state.userId || '').trim()) return null;
        var current = now instanceof Date ? now : new Date();
        var pausedResume = null;
        if (isTelegramTaskNotifyPaused(normalized, current)) {
          try { pausedResume = new Date(normalized.pausedUntil); } catch (error) { pausedResume = null; }
          if (pausedResume && !isNaN(pausedResume.getTime())) return Math.max(1000, pausedResume.getTime() - current.getTime() + 250);
          return 60000;
        }
        var quietResume = getTelegramTaskNotifyQuietResumeDate(normalized, current);
        if (quietResume && !isNaN(quietResume.getTime())) {
          return Math.max(1000, quietResume.getTime() - current.getTime() + 250);
        }
        var gapResumeLabel = getTelegramTaskNotifyMinGapResumeLabel(normalized, current);
        if (gapResumeLabel) {
          var status = normalizeTelegramTaskNotifyState(state.telegramTaskNotifyState);
          var lastSentDate = status.lastSentAt ? new Date(status.lastSentAt) : null;
          var gapMs = getTelegramTaskNotifyMinGapMs(normalized);
          if (lastSentDate && !isNaN(lastSentDate.getTime()) && gapMs > 0) {
            return Math.max(1000, lastSentDate.getTime() + gapMs - current.getTime() + 250);
          }
        }
        var candidates = (state.allTasks || []).filter(function (task) { return isTelegramTaskNotificationCandidate(task, normalized); });
        var nextDelay = null;
        for (var i = 0; i < candidates.length; i += 1) {
          var task = candidates[i];
          var triggerIso = getTelegramTaskNotificationTriggerIso(task, normalized);
          if (!triggerIso) continue;
          var signature = getTelegramTaskNotificationSignature(task, normalized, triggerIso);
          if (shouldSkipTelegramTaskNotificationDelivery((state.telegramTaskNotifyDeliveredMap || {})[signature])) continue;
          var triggerDate = new Date(triggerIso);
          if (isNaN(triggerDate.getTime())) continue;
          var diff = triggerDate.getTime() - current.getTime();
          if (diff <= 0) return 250;
          if (nextDelay === null || diff < nextDelay) nextDelay = diff;
        }
        return nextDelay === null ? 60000 : Math.max(250, nextDelay);
      }

      function scheduleTelegramTaskNotifyWatcher() {
        clearTelegramTaskNotifyWatcher();
        try {
          var settings = normalizeTelegramTaskNotifySettings(state.telegramTaskNotifySettings || getDefaultTelegramTaskNotifySettings());
          var delayMs = getNextTelegramTaskNotificationDelayMs(settings, new Date());
          if (delayMs === null) return;
          state.telegramTaskNotifyTimerId = setTimeout(async function () {
            try {
              await checkDueTelegramTaskNotifications();
            } catch (error) {}
            try {
              scheduleTelegramTaskNotifyWatcher();
            } catch (error) {
              console.warn('[telegram-task-notify-watcher-reschedule-error]', error);
            }
          }, Math.max(250, Math.min(delayMs, 2147483647)));
        } catch (error) {
          console.warn('[telegram-task-notify-watcher-schedule-error]', error);
        }
      }

      function refreshReminderWatcher() {
        if (state.reminderWatcherTimerId) {
          clearInterval(state.reminderWatcherTimerId);
          state.reminderWatcherTimerId = null;
        }
        clearTelegramTaskNotifyWatcher();
        var reminderSettings = state.reminderSettings || getDefaultReminderSettings();
        var telegramSettings = normalizeTelegramTaskNotifySettings(state.telegramTaskNotifySettings || getDefaultTelegramTaskNotifySettings());
        if (reminderSettings.enabled) {
          state.reminderWatcherTimerId = setInterval(function () {
            checkDueReminders();
          }, 30000);
          setTimeout(function () {
            checkDueReminders();
          }, 0);
        }
        if (telegramSettings.enabled) {
          setTimeout(function () {
            try {
              checkDueTelegramTaskNotifications().catch(function () {});
              scheduleTelegramTaskNotifyWatcher();
            } catch (error) {
              console.warn('[telegram-task-notify-watcher-start-error]', error);
            }
          }, 0);
        }
      }

      function getDefaultReminderIsoForTask(task, leadMinutes) {
        var settings = state.reminderSettings || getDefaultReminderSettings();
        var lead = Number.isFinite(Number(leadMinutes)) ? Number(leadMinutes) : Number(settings.defaultLeadMinutes);
        var now = new Date();
        if (task && task.due_at) {
          var due = new Date(task.due_at);
          if (!isNaN(due.getTime())) {
            var target = new Date(due.getTime() - Math.max(0, lead) * 60000);
            var minFuture = new Date(now.getTime() + 5 * 60000);
            if (target < minFuture && due > minFuture) target = minFuture;
            if (due <= now) target = minFuture;
            return target.toISOString();
          }
        }
        return new Date(now.getTime() + Math.max(15, lead || 15) * 60000).toISOString();
      }

      async function updateTaskReminder(taskId, remindAtIso, options) {
        options = options || {};
        if (!state.userId) {
          showError('Сначала укажи user_id.');
          return;
        }
        var task = findTaskById(taskId);
        if (!(task && task.id)) {
          showError('Не удалось найти задачу для напоминания.');
          return;
        }
        try {
          var response = await updateTaskMeta(task.id, { remind_at: remindAtIso || null });
          if (response && response.item) applyTaskLocally(response.item);
          clearReminderDeliveredForTask(task.id);
          if (!(options && options.silent)) {
            showSuccess(remindAtIso ? ('Напоминание установлено: ' + formatShortDateTimeLocal(remindAtIso)) : 'Напоминание снято.');
          }
        } catch (error) {
          showError(String(error && error.message ? error.message : error));
        }
      }

      async function setSuggestedTaskReminder(task, options) {
        var remindAtIso = getDefaultReminderIsoForTask(task, options && options.leadMinutes);
        await updateTaskReminder(task.id, remindAtIso, options);
      }

      async function snoozeTaskReminder(taskId, minutes) {
        var remindAtIso = new Date(Date.now() + Math.max(5, Number(minutes) || 15) * 60000).toISOString();
        await updateTaskReminder(taskId, remindAtIso);
      }

      function createReminderActionButton(label, handler, className) {
        var button = document.createElement('button');
        button.type = 'button';
        button.className = className || 'btn-ghost';
        button.textContent = label;
        button.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          handler();
        });
        return button;
      }

      function createTodayReminderCard(task, tone) {
        var card = document.createElement('div');
        card.className = 'today-reminder-card ' + (tone === 'overdue' ? 'is-overdue' : 'is-upcoming');
        var head = document.createElement('div');
        head.className = 'today-reminder-card-head';
        var main = document.createElement('div');
        var title = document.createElement('div');
        title.className = 'today-reminder-card-title';
        title.textContent = task.title || 'Без названия';
        var note = document.createElement('div');
        note.className = 'today-reminder-card-note';
        note.textContent = (tone === 'overdue' ? 'Просрочено: ' : 'Скоро: ') + formatShortDateTimeLocal(task.remind_at) + (task.due_at ? ' · ' + formatTimeRange(task.due_at, getTaskDurationMinutes(task), { withDate: false }) : '');
        main.appendChild(title);
        main.appendChild(note);
        head.appendChild(main);
        head.appendChild(createChip(tone === 'overdue' ? 'Просрочено' : 'Скоро'));
        card.appendChild(head);
        var meta = document.createElement('div');
        meta.className = 'today-os-task-meta';
        meta.appendChild(createChip(normalizeProjectName(task.project_name)));
        meta.appendChild(createChip('План: ' + formatMinutesHoursLabel(getTaskPlannedMinutesValue(task))));
        card.appendChild(meta);
        var actions = document.createElement('div');
        actions.className = 'today-reminder-card-actions';
        actions.appendChild(createReminderActionButton('+15м', function () { snoozeTaskReminder(task.id, 15); }));
        actions.appendChild(createReminderActionButton('+1ч', function () { snoozeTaskReminder(task.id, 60); }));
        actions.appendChild(createReminderActionButton('Снять', function () { updateTaskReminder(task.id, null); }));
        actions.appendChild(createReminderActionButton('Открыть', function () { openEditor(task.id); }, 'btn-secondary'));
        card.appendChild(actions);
        return card;
      }

      function renderTodayReminderCenter(dayYmd) {
        var container = byId('todayReminderCenter');
        var card = byId('todayReminderCenterCard');
        if (!container || !card) return;
        var settings = state.reminderSettings || getDefaultReminderSettings();
        if (!settings.enabled || !settings.showTodayCenter) {
          card.style.display = 'none';
          container.innerHTML = '';
          setSectionCounter('todayReminderCount', 0);
          return;
        }
        card.style.display = '';
        var data = getReminderCenterData(dayYmd || state.dayYmd || formatYmdLocal(new Date()));
        container.innerHTML = '';
        var summary = document.createElement('div');
        summary.className = 'today-reminder-summary';
        summary.appendChild(createChip('Всего: ' + data.total));
        summary.appendChild(createChip('Скоро: ' + data.upcoming.length));
        summary.appendChild(createChip('Просрочено: ' + data.overdue.length));
        container.appendChild(summary);
        var list = document.createElement('div');
        list.className = 'today-reminder-list';
        if (!data.total) {
          var empty = document.createElement('div');
          empty.className = 'today-os-empty';
          empty.textContent = 'На выбранный день нет активных напоминаний.';
          list.appendChild(empty);
        } else {
          data.overdue.slice(0, 3).forEach(function (task) { list.appendChild(createTodayReminderCard(task, 'overdue')); });
          data.upcoming.slice(0, 4).forEach(function (task) { list.appendChild(createTodayReminderCard(task, 'upcoming')); });
        }
        container.appendChild(list);
        setSectionCounter('todayReminderCount', data.total);
      }

      function getDayRitualStorageKey(dayYmd) {
        if (!state.userId || !dayYmd) return null;
        return DAY_RITUAL_STORAGE_PREFIX + String(state.userId) + ':' + String(dayYmd);
      }

      function normalizeDayRitual(value, dayYmd) {
        var normalized = {
          ymd: dayYmd || formatYmdLocal(new Date()),
          startedAt: null,
          updatedAt: null,
          energy: '',
          intention: '',
          topTaskIds: [],
          reviewStatus: '',
          reviewNote: '',
          reviewCompletedAt: null,
          planSentAt: null,
          factSentAt: null,
          focusStartedAt: null,
          focusTaskId: ''
        };
        if (!value || typeof value !== 'object') return normalized;
        normalized.startedAt = value.startedAt || null;
        normalized.updatedAt = value.updatedAt || null;
        normalized.energy = String(value.energy || '').trim();
        normalized.intention = String(value.intention || '').trim();
        normalized.topTaskIds = Array.isArray(value.topTaskIds) ? value.topTaskIds.filter(Boolean).slice(0, 3) : [];
        normalized.reviewStatus = String(value.reviewStatus || '').trim();
        normalized.reviewNote = String(value.reviewNote || '').trim();
        normalized.reviewCompletedAt = value.reviewCompletedAt || null;
        normalized.planSentAt = value.planSentAt || null;
        normalized.factSentAt = value.factSentAt || null;
        normalized.focusStartedAt = value.focusStartedAt || null;
        normalized.focusTaskId = String(value.focusTaskId || '').trim();
        return normalized;
      }

      function loadDayRitual(dayYmd) {
        var key = getDayRitualStorageKey(dayYmd);
        if (!key) return normalizeDayRitual(null, dayYmd);
        try {
          var raw = localStorage.getItem(key);
          if (!raw) return normalizeDayRitual(null, dayYmd);
          return normalizeDayRitual(JSON.parse(raw), dayYmd);
        } catch (error) {
          return normalizeDayRitual(null, dayYmd);
        }
      }

      function saveDayRitual(dayYmd, ritual) {
        var key = getDayRitualStorageKey(dayYmd);
        if (!key) return;
        var normalized = normalizeDayRitual(ritual, dayYmd);
        try { localStorage.setItem(key, JSON.stringify(normalized)); } catch (error) {}
        state.dayRitual = normalized;
      }

      function appendWellbeingLog(type, payload) {
        if (!state.userId) return;
        var key = WELLBEING_LOG_STORAGE_KEY + ':' + String(state.userId);
        try {
          var raw = localStorage.getItem(key);
          var items = raw ? JSON.parse(raw) : [];
          if (!Array.isArray(items)) items = [];
          items.unshift({
            type: String(type || 'event'),
            timestamp: new Date().toISOString(),
            payload: payload || {}
          });
          if (items.length > 120) items = items.slice(0, 120);
          localStorage.setItem(key, JSON.stringify(items));
        } catch (error) {}
      }

      function getDayRitualTaskStats(dayYmd, ritual) {
        var targetDay = dayYmd || state.dayYmd || formatYmdLocal(new Date());
        var safeRitual = ritual || loadDayRitual(targetDay);
        var selectedTasks = (safeRitual.topTaskIds || []).map(function (taskId) { return findTaskById(taskId); }).filter(Boolean);
        var completedCount = 0;
        var pendingCount = 0;
        var plannedMinutes = 0;
        var actualMinutes = 0;
        var firstPendingTask = null;
        selectedTasks.forEach(function (task) {
          plannedMinutes += Math.max(Number(getEffectivePlannedMinutesClient(task)) || Number(getTaskDurationMinutes(task)) || 0, 0);
          actualMinutes += Math.max(Number(normalizeMinutesInputValue(task && task.actual_minutes)) || 0, 0);
          if (normalizeStatus(task && task.status) === STATUS.DONE) {
            completedCount += 1;
          } else {
            pendingCount += 1;
            if (!firstPendingTask) firstPendingTask = task;
          }
        });
        var delta = actualMinutes - plannedMinutes;
        var progressLabel = !selectedTasks.length
          ? 'Главные задачи не выбраны'
          : (completedCount >= selectedTasks.length ? 'Главные задачи закрыты' : ('Готово ' + completedCount + ' из ' + selectedTasks.length));
        var reviewLabel = safeRitual.reviewCompletedAt ? 'Разбор сохранён' : (safeRitual.startedAt ? 'Разбор ещё не сделан' : 'День ещё не запущен');
        return {
          selectedTasks: selectedTasks,
          completedCount: completedCount,
          pendingCount: pendingCount,
          plannedMinutes: plannedMinutes,
          actualMinutes: actualMinutes,
          delta: delta,
          firstPendingTask: firstPendingTask,
          progressLabel: progressLabel,
          reviewLabel: reviewLabel
        };
      }

      function markRitualPlanSent(dayYmd) {
        var targetDay = dayYmd || state.dayYmd || formatYmdLocal(new Date());
        var ritual = loadDayRitual(targetDay);
        ritual.planSentAt = new Date().toISOString();
        ritual.updatedAt = ritual.planSentAt;
        saveDayRitual(targetDay, ritual);
      }

      function markRitualFactSent(dayYmd) {
        var targetDay = dayYmd || state.dayYmd || formatYmdLocal(new Date());
        var ritual = loadDayRitual(targetDay);
        ritual.factSentAt = new Date().toISOString();
        ritual.updatedAt = ritual.factSentAt;
        saveDayRitual(targetDay, ritual);
      }

      function markRitualFocusStarted(dayYmd, taskId) {
        var targetDay = dayYmd || state.dayYmd || formatYmdLocal(new Date());
        var ritual = loadDayRitual(targetDay);
        ritual.focusStartedAt = ritual.focusStartedAt || new Date().toISOString();
        ritual.focusTaskId = String(taskId || '').trim();
        ritual.updatedAt = new Date().toISOString();
        saveDayRitual(targetDay, ritual);
      }

      async function startPrimaryRitualFocus(dayYmd) {
        var targetDay = dayYmd || state.dayYmd || formatYmdLocal(new Date());
        var ritual = loadDayRitual(targetDay);
        var stats = getDayRitualTaskStats(targetDay, ritual);
        if (!(stats.firstPendingTask && stats.firstPendingTask.id)) {
          showError('Для быстрого старта выбери хотя бы одну активную главную задачу.');
          return false;
        }
        await startFocusModeFromTaskId(stats.firstPendingTask.id);
        return true;
      }

