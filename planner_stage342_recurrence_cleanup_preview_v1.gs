      function parseProjectLinksText(linksText) {
        return String(linksText || '')
          .replaceAll('\\r', '').split('\\n')
          .map(function (item) { return String(item || '').trim(); })
          .filter(Boolean)
          .slice(0, 8);
      }

      function isProjectTaskActive(task) {
        var status = normalizeStatus(task && task.status) || STATUS.NEW;
        return status === STATUS.NEW || status === STATUS.PLANNED || status === STATUS.POSTPONED;
      }

      function isProjectTaskOverdue(task) {
        if (!(task && task.due_at) || !isProjectTaskActive(task)) return false;
        var dueMs = new Date(task.due_at).getTime();
        return Number.isFinite(dueMs) && dueMs < Date.now();
      }

      function getProjectTasksByName(projectName) {
        var normalized = normalizeProjectName(projectName);
        return getShellTasks().filter(function (task) {
          return normalizeProjectName(task && task.project_name) === normalized;
        });
      }

      function getProjectStats(tasks) {
        var activeTasks = (tasks || []).filter(isProjectTaskActive).sort(compareTasksByDueAndUpdated);
        var todayYmd = state.dayYmd || formatYmdLocal(new Date());
        var scheduledTasks = activeTasks.filter(function (task) { return !!task.due_at; });
        var todayTasks = scheduledTasks.filter(function (task) { return formatYmdLocal(new Date(task.due_at)) === todayYmd; });
        var weekTasks = scheduledTasks.filter(function (task) { return isTaskInActivePeriod(task, 'week'); });
        var backlogTasks = activeTasks.filter(function (task) { return !task.due_at; });
        var overdueTasks = activeTasks.filter(isProjectTaskOverdue);
        var doneTasks = (tasks || []).filter(function (task) { return normalizeStatus(task && task.status) === STATUS.DONE; });
        var timeMetrics = aggregateTaskTimeMetrics(tasks || []);
        return {
          activeTasks: activeTasks,
          activeCount: activeTasks.length,
          scheduledCount: scheduledTasks.length,
          todayCount: todayTasks.length,
          weekCount: weekTasks.length,
          backlogCount: backlogTasks.length,
          overdueCount: overdueTasks.length,
          doneCount: doneTasks.length,
          plannedMinutes: timeMetrics.planned,
          actualMinutes: timeMetrics.actual,
          nextDueTask: scheduledTasks[0] || null,
          previewTasks: (todayTasks.concat(weekTasks).concat(backlogTasks).concat(activeTasks)).filter(function (task, index, list) {
            return list.findIndex(function (candidate) { return candidate && task && candidate.id === task.id; }) === index;
          }).slice(0, 4)
        };
      }

