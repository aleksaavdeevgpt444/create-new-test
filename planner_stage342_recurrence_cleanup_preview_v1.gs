      function flashTodayTaskInCalendar(taskId) {
        var target = byId('todayEventsLayer') ? byId('todayEventsLayer').querySelector('[data-task-id="' + String(taskId || '') + '"]') : null;
        if (!target) return;
        Array.prototype.forEach.call(document.querySelectorAll('.today-event.is-agenda-highlight'), function (node) {
          node.classList.remove('is-agenda-highlight');
        });
        target.classList.add('is-agenda-highlight');
        if (typeof target.scrollIntoView === 'function') {
          target.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
        }
        window.setTimeout(function () {
          target.classList.remove('is-agenda-highlight');
        }, 1800);
      }

      function createTodayDashboardCard(config) {
        var card = document.createElement('div');
        card.className = 'today-dashboard-card' + (config && config.accent ? ' is-accent' : '');
        var head = document.createElement('div');
        head.className = 'today-dashboard-head';
        var main = document.createElement('div');
        var label = document.createElement('div');
        label.className = 'today-dashboard-label';
        label.textContent = config.label || '';
        main.appendChild(label);
        var value = document.createElement('div');
        value.className = 'today-dashboard-value';
        value.textContent = config.value || '—';
        main.appendChild(value);
        head.appendChild(main);
        if (config.badge) head.appendChild(createChip(config.badge));
        card.appendChild(head);
        if (config.note) {
          var note = document.createElement('div');
          note.className = 'today-dashboard-note';
          note.textContent = config.note;
          card.appendChild(note);
        }
        if (Array.isArray(config.meta) && config.meta.length) {
          var meta = document.createElement('div');
          meta.className = 'today-dashboard-meta';
          config.meta.forEach(function (node) { if (node) meta.appendChild(node); });
          card.appendChild(meta);
        }
        if (Array.isArray(config.actions) && config.actions.length) {
          var actions = document.createElement('div');
          actions.className = 'today-dashboard-actions';
          config.actions.forEach(function (action) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = action.className || 'btn-ghost';
            btn.textContent = action.label || 'Открыть';
            btn.disabled = !!action.disabled;
            btn.addEventListener('click', function (event) {
              event.preventDefault();
              event.stopPropagation();
              if (typeof action.handler === 'function') action.handler();
            });
            actions.appendChild(btn);
          });
          card.appendChild(actions);
        }
        return card;
      }

