  const priorityReason = aiResult && aiResult.priority_reason ? String(aiResult.priority_reason).trim() : null;
  const nextStep = aiResult && aiResult.next_step ? String(aiResult.next_step).trim() : null;
  const currentTask = await env.DB.prepare(`SELECT project_name FROM tasks WHERE id = ? LIMIT 1`).bind(taskId).first();
  const nextProjectName = projectGuess || normalizeProjectTextFieldServer(currentTask && currentTask.project_name ? currentTask.project_name : null);

  await env.DB.prepare(`
