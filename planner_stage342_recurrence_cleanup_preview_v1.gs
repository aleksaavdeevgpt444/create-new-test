      async function scheduleRecurringTaskWithScope(task, dueAtIso, nextStatus, durationMinutes, scope) {
        scope = 'current';
        if (!task || !task.id) return;
        if (!state.userId) {
          showError('Сначала укажи user_id.');
          return;
        }

        state.requestState = 'перенос-повтора-только-эта';
        updateDebugInfo();
        showError('');

        var optimistic = buildOptimisticScheduledTask(task.id, dueAtIso, nextStatus, durationMinutes, {
          detachSeries: scope === 'current'
        });

        try {
          if (optimistic && optimistic.next) {
            applyTaskLocally(optimistic.next);
          }

          var body = { task_id: task.id, user_id: state.userId, due_at: dueAtIso };
          if (nextStatus) body.status = nextStatus;
          if (durationMinutes !== undefined && durationMinutes !== null && durationMinutes !== '') {
            body.duration_minutes = Number(durationMinutes);
          }

          var response = await requestJson('/tasks/recurrence/apply-current', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(body)
          });

          if (response && response.item) {
            applyTaskLocally(response.item);
          }
          schedulePlannerReload(120);
          state.requestState = 'idle';
          updateDebugInfo();
        } catch (error) {
          if (optimistic && optimistic.previous) {
            applyTaskLocally(optimistic.previous);
          }
          state.requestState = 'error';
          updateDebugInfo();
          showError(String(error));
        }
      }


      function recurrenceLabel(value) {
        var map = {
          weekdays: 'Ежедневно по рабочим дням',
          daily: 'Ежедневно',
          weekly: 'Еженедельно',
          monthly: 'Ежемесячно',
          yearly: 'Ежегодно',
          custom: 'Другое'
        };
        return map[String(value || '')] || 'Без повтора';
      }


      function getWeekdayOrder() {
        return ['MO', 'TU', 'WE', 'TH', 'FR', 'SA', 'SU'];
      }

      function normalizeRecurrenceRuleValue(value) {
        return String(value || '').trim();
      }

      function setWeekdayChipState(label) {
        if (!label) return;
        var input = label.querySelector('input');
        label.classList.toggle('is-active', !!(input && input.checked));
      }

      function wireWeekdayChips(containerId) {
        var container = byId(containerId);
        if (!container) return;
        Array.prototype.forEach.call(container.querySelectorAll('.weekday-chip'), function (label) {
          var input = label.querySelector('input');
          setWeekdayChipState(label);
          label.addEventListener('click', function (event) {
            if (!input || input.disabled) return;
            if (event.target !== input) {
              event.preventDefault();
              input.checked = !input.checked;
              input.dispatchEvent(new Event('change', { bubbles: true }));
            }
            setTimeout(function () { setWeekdayChipState(label); }, 0);
          });
          if (input) input.addEventListener('change', function () { setWeekdayChipState(label); });
        });
      }

      function setCustomWeekdaysFromRule(scope, rule) {
        var container = byId(scope + 'CustomWeekdays');
        if (!container) return;
        var allowed = normalizeRecurrenceRuleValue(rule).split(',').map(function (x) { return x.trim(); }).filter(Boolean);
        Array.prototype.forEach.call(container.querySelectorAll('input[type="checkbox"]'), function (input) {
          input.checked = allowed.indexOf(input.value) >= 0;
          setWeekdayChipState(input.closest('.weekday-chip'));
        });
      }

      function getCustomWeekdaysRule(scope) {
        var container = byId(scope + 'CustomWeekdays');
        if (!container) return '';
        var values = [];
        Array.prototype.forEach.call(container.querySelectorAll('input[type="checkbox"]'), function (input) {
          if (input.checked) values.push(input.value);
        });
