        startBtn.addEventListener('click', function () {
          openDayRitualDialog(targetDay);
        });
        actions.appendChild(startBtn);

        if (nextMainTask && nextMainTask.id) {
          var startFocusBtn = document.createElement('button');
          startFocusBtn.type = 'button';
          startFocusBtn.className = 'btn-primary';
          startFocusBtn.textContent = 'Запустить первую главную';
          startFocusBtn.addEventListener('click', function () {
            startPrimaryRitualFocus(targetDay).catch(function (error) { showError(String(error)); });
          });
          actions.appendChild(startFocusBtn);
        }

        var sendPlanBtn = document.createElement('button');
        sendPlanBtn.type = 'button';
        sendPlanBtn.className = 'btn-ghost';
        sendPlanBtn.textContent = ritual.planSentAt ? 'Отправить план ещё раз' : 'Отправить план';
        sendPlanBtn.addEventListener('click', function () {
          sendDayPlanToChat({ dayYmd: targetDay, successMessage: 'План дня отправлен в чат.' }).then(function (sent) {
            if (!sent) return;
            markRitualPlanSent(targetDay);
            renderTodayRitualCard(targetDay);
          }).catch(function (error) {
            showError(String(error));
          });
        });
        actions.appendChild(sendPlanBtn);

        if ((state.meditationSettings || getDefaultMeditationSettings()).enabled && (state.meditationSettings || getDefaultMeditationSettings()).showInToday) {
          var meditationBtn = document.createElement('button');
          meditationBtn.type = 'button';
          meditationBtn.className = 'btn-ghost';
          meditationBtn.textContent = 'Медитация';
          meditationBtn.addEventListener('click', function () { openMeditationOverlay('gather'); });
          actions.appendChild(meditationBtn);
        }

        if (settings.showEveningReview) {
          var reviewBtn = document.createElement('button');
          reviewBtn.type = 'button';
          reviewBtn.className = ritual.reviewCompletedAt ? 'btn-secondary' : 'btn-ghost';
          reviewBtn.textContent = ritual.reviewCompletedAt ? 'Обновить вечерний разбор' : 'Вечерний разбор';
          reviewBtn.addEventListener('click', function () { openRitualReviewDialog(targetDay); });
          actions.appendChild(reviewBtn);
        }

        var sendFactBtn = document.createElement('button');
        sendFactBtn.type = 'button';
        sendFactBtn.className = 'btn-ghost';
        sendFactBtn.textContent = ritual.factSentAt ? 'Отправить факт ещё раз' : 'Отправить факт';
        sendFactBtn.addEventListener('click', function () {
          sendDayFactToChat({ dayYmd: targetDay, successMessage: 'Факт дня отправлен в чат.' }).then(function (sent) {
            if (!sent) return;
            markRitualFactSent(targetDay);
            renderTodayRitualCard(targetDay);
          }).catch(function (error) {
            showError(String(error));
          });
        });
        actions.appendChild(sendFactBtn);

        var helper = document.createElement('div');
        helper.className = 'ritual-helper-note';
        helper.textContent = nextMainTask
          ? 'Лучший следующий шаг сейчас — запустить фокус по первой главной задаче и не распыляться.'
          : (selectedTasks.length ? 'Главные задачи уже закрыты. Можно закончить день разбором и отправить факт.' : 'Сначала собери старт дня и выбери 1–3 главные задачи.');

        container.appendChild(head);
        container.appendChild(summaryGrid);
        container.appendChild(taskList);
        container.appendChild(actions);
        container.appendChild(helper);
      }

      async function saveStartDayRitualFromDialog(options) {
        options = options || {};
        var dialog = ensureDayRitualDialog();
        var backdrop = dialog.backdrop;
        var panel = dialog.panel;
        var dayYmd = backdrop.dataset.dayYmd || (state.dayYmd || formatYmdLocal(new Date()));
        var settings = state.ritualSettings || getDefaultRitualSettings();
        var selected = Array.prototype.map.call(panel.querySelectorAll('#ritualTaskPickList input[type="checkbox"]:checked'), function (input) {
          return input.value;
        }).filter(Boolean);
        if (selected.length > settings.maxMainTasks) {
          showError('Можно выбрать не больше ' + settings.maxMainTasks + ' главных задач.');
          return false;
        }
        var ritual = loadDayRitual(dayYmd);
        ritual.startedAt = ritual.startedAt || new Date().toISOString();
        ritual.updatedAt = new Date().toISOString();
        ritual.energy = String(panel.querySelector('#ritualEnergySelect').value || '').trim();
        ritual.intention = String(panel.querySelector('#ritualIntentionInput').value || '').trim();
        ritual.topTaskIds = selected.slice(0, settings.maxMainTasks);
        saveDayRitual(dayYmd, ritual);
        appendWellbeingLog('ritual-start', { dayYmd: dayYmd, topTaskIds: ritual.topTaskIds, energy: ritual.energy });
        backdrop.style.display = 'none';
        rerenderTodayOs(dayYmd);

        var shouldSendPlan = options.sendPlan === true || settings.autoSendPlanAfterStart === true;
        if (!shouldSendPlan) {
          showSuccess('Ритуал дня сохранён.');
          return true;
        }

        var sent = await sendDayPlanToChat({
          dayYmd: dayYmd,
          successMessage: 'Ритуал сохранён, план отправлен в чат.',
          silentError: true,
          silentSuccess: true
        });
        if (sent) {
          markRitualPlanSent(dayYmd);
          rerenderTodayOs(dayYmd);
          showSuccess('Ритуал сохранён, план отправлен в чат.');
          return true;
        }
        showError('Ритуал сохранён, но план не отправился в чат.');
        return false;
      }

