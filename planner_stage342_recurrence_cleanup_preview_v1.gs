        if (item.stats.overdueCount > 0 || item.stats.todayCount > 0) card.classList.add('project-card-highlight');

        var head = document.createElement('div');
        head.className = 'project-card-head';

        var copy = document.createElement('div');
        copy.className = 'project-card-copy';

        var title = document.createElement('div');
        title.className = 'project-card-title';
        title.textContent = item.name;
        copy.appendChild(title);

        var metaRow = document.createElement('div');
        metaRow.className = 'project-meta';
        metaRow.appendChild(createChip('Активных: ' + item.stats.activeCount));
        if (item.meta && item.meta.priority) metaRow.appendChild(createChip('Приоритет: ' + getProjectPriorityLabel(item.meta.priority)));
        if (item.stats.nextDueTask) metaRow.appendChild(createChip('Ближайшая: ' + formatShortDateTimeLocal(item.stats.nextDueTask.due_at)));
        if (item.stats.overdueCount > 0) metaRow.appendChild(createChip('Просрочено: ' + item.stats.overdueCount));
        if (item.stats.backlogCount > 0) metaRow.appendChild(createChip('Без слота: ' + item.stats.backlogCount));
        copy.appendChild(metaRow);

        var statusLine = document.createElement('div');
        statusLine.className = 'project-card-statusline';
