      function normalizeTaskFrameworkAssignment(value) {
        var source = value && typeof value === 'object' ? value : {};
        var normalized = {
          primaryFramework: '',
          taskBlockId: '',
          taskBlockLinkMode: '',
          dayPattern: '',
          eisenhower: '',
          abcde: '',
          moscow: '',
          energy: '',
          updatedAt: String(source.updatedAt || source.updated_at || '')
        };
        var primary = String(source.primaryFramework || source.primary_framework || '').trim().toLowerCase();
        normalized.primaryFramework = getFrameworkMeta(primary) ? primary : '';
        normalized.taskBlockId = String(source.taskBlockId || source.task_block_id || '').trim();
        var linkMode = String(source.taskBlockLinkMode || source.task_block_link_mode || source.linkMode || source.link_mode || '').trim().toLowerCase();
        normalized.taskBlockLinkMode = normalized.taskBlockId ? (['soft', 'hard'].indexOf(linkMode) >= 0 ? linkMode : 'soft') : '';
        normalized.dayPattern = ['big', 'medium', 'small'].indexOf(String(source.dayPattern || source.day_pattern || '').trim().toLowerCase()) >= 0 ? String(source.dayPattern || source.day_pattern || '').trim().toLowerCase() : '';
        normalized.eisenhower = ['important_urgent','important_not_urgent','not_important_urgent','not_important_not_urgent'].indexOf(String(source.eisenhower || '').trim().toLowerCase()) >= 0 ? String(source.eisenhower || '').trim().toLowerCase() : '';
        normalized.abcde = ['A','B','C','D','E'].indexOf(String(source.abcde || '').trim().toUpperCase()) >= 0 ? String(source.abcde || '').trim().toUpperCase() : '';
        normalized.moscow = ['must','should','could','wont'].indexOf(String(source.moscow || '').trim().toLowerCase()) >= 0 ? String(source.moscow || '').trim().toLowerCase() : '';
        normalized.energy = ['high','medium','low'].indexOf(String(source.energy || '').trim().toLowerCase()) >= 0 ? String(source.energy || '').trim().toLowerCase() : '';
        return normalized;
      }

      function loadStoredTaskFrameworkAssignments() {
        try {
          var raw = localStorage.getItem(TASK_FRAMEWORK_ASSIGNMENTS_STORAGE_KEY);
          if (!raw) return Object.create(null);
          var parsed = JSON.parse(raw);
          if (!parsed || typeof parsed !== 'object') return Object.create(null);
          var map = Object.create(null);
          Object.keys(parsed).forEach(function (key) {
            map[String(key)] = normalizeTaskFrameworkAssignment(parsed[key]);
          });
          return map;
        } catch (error) {
          return Object.create(null);
        }
      }

      function saveStoredTaskFrameworkAssignments() {
        try {
          var payload = Object.create(null);
          Object.keys(state.taskFrameworkAssignments || {}).forEach(function (key) {
            payload[key] = normalizeTaskFrameworkAssignment(state.taskFrameworkAssignments[key]);
          });
          localStorage.setItem(TASK_FRAMEWORK_ASSIGNMENTS_STORAGE_KEY, JSON.stringify(payload));
        } catch (error) {}
      }

