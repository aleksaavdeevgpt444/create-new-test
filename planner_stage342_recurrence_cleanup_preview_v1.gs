        if (spaceKey !== currentSpaceKey) otherChanged = true;
        if (telegramNotifyType !== currentTelegramNotifyType) otherChanged = true;
        if (nextStatus !== normalizeStatus(currentTask && currentTask.status)) otherChanged = true;
        if (String(recurrencePayload && recurrencePayload.type || '') !== currentRecurrenceType) otherChanged = true;
        if (String(recurrencePayload && recurrencePayload.rule || '') !== currentRecurrenceRule) otherChanged = true;
        if (Number(recurrencePayload && recurrencePayload.enabled || 0) !== currentRecurrenceEnabled) otherChanged = true;
        var actualChanged = actualMinutes !== currentActualMinutes;
        return {
          hasAnyChange: !!(otherChanged || actualChanged),
          actualOnly: !!(actualChanged && !otherChanged),
          actualChanged: !!actualChanged,
