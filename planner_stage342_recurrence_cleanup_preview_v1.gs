    return jsonResponse({ ok: true, build: getClientAppBuildLabel(), deleted: true, user_id: String(userId), source: FRAMEWORKS_SYNC_SOURCE_SERVER });
  }
  return jsonResponse({ ok: false, error: 'Method not allowed', build: getClientAppBuildLabel() }, { status: 405 });
}



function normalizeTaskTimeBlockLinkServer(value = {}) {
  const raw = /** @type {any} */ (value);
  const source = (raw && typeof raw === 'object' && !Array.isArray(raw)) ? raw : /** @type {any} */ ({});
  const taskId = String(source['task_id'] || source['taskId'] || '').trim();
  const blockInstanceId = String(source['block_instance_id'] || source['blockInstanceId'] || '').trim();
  const linkModeRaw = String(source['link_mode'] || source['linkMode'] || '').trim().toLowerCase();
  return {
    taskId,
    blockInstanceId,
    linkMode: blockInstanceId ? (['soft', 'hard'].includes(linkModeRaw) ? linkModeRaw : 'soft') : ''
  };
}

async function getTaskTimeBlockLinkForTask(env, userId, taskId) {
