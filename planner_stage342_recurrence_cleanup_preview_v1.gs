        var normalized = cloneEditorDependencyItem(item);
        state.editorDependencyState = normalized;
        if (normalized && normalized.task_id) {
          state.dependencyMap[String(normalized.task_id)] = {
            task_id: String(normalized.task_id),
            blocked_by_task_id: normalized.blocked_by_task_id ? String(normalized.blocked_by_task_id) : null,
            created_at: normalized.created_at || null,
            updated_at: normalized.updated_at || null
          };
        } else if (effectiveTaskId) {
          state.dependencyMap[effectiveTaskId] = {
            task_id: effectiveTaskId,
            blocked_by_task_id: null,
            created_at: null,
            updated_at: null
          };
        }
        if (effectiveTaskId) state.editorDependencyCache[effectiveTaskId] = cloneEditorDependencyItem(normalized);
      }

      function setEditorHistoryState(items, taskId) {
        var effectiveTaskId = String(taskId || state.editorTaskId || '');
        var normalized = cloneEditorHistoryItems(items || []);
        state.editorTaskHistory = normalized;
        if (effectiveTaskId) state.editorHistoryCache[effectiveTaskId] = cloneEditorHistoryItems(normalized);
      }

      function restoreEditorAuxiliaryPanelsFromCache(taskId) {
        var safeTaskId = String(taskId || '');
        if (!safeTaskId) return false;
        var hasCached = false;
        if (Object.prototype.hasOwnProperty.call(state.editorChecklistCache || {}, safeTaskId)) {
          state.editorChecklist = cloneEditorChecklistItems(state.editorChecklistCache[safeTaskId] || []);
          hasCached = true;
        } else {
          state.editorChecklist = [];
        }
        if (Object.prototype.hasOwnProperty.call(state.editorDependencyCache || {}, safeTaskId)) {
          state.editorDependencyState = cloneEditorDependencyItem(state.editorDependencyCache[safeTaskId]);
          hasCached = true;
        } else {
          state.editorDependencyState = null;
        }
        if (Object.prototype.hasOwnProperty.call(state.editorHistoryCache || {}, safeTaskId)) {
          state.editorTaskHistory = cloneEditorHistoryItems(state.editorHistoryCache[safeTaskId] || []);
          hasCached = true;
        } else {
          state.editorTaskHistory = [];
        }
        return hasCached;
      }

      function clearEditorAuxiliaryLoadTimer() {
        if (state.editorAuxLoadTimerId) {
          try { clearTimeout(state.editorAuxLoadTimerId); } catch (error) {}
          state.editorAuxLoadTimerId = null;
        }
      }

      async function loadChecklistItems(taskId, options) {
        options = options || {};
        var seq = options.seq;
        if (!state.userId || !taskId) {
          if (isActiveEditorAuxLoad(taskId, seq)) {
            setEditorChecklistState([], taskId);
            renderChecklist();
          }
          return;
        }
        try {
          var data = await requestJson('/tasks/checklist?task_id=' + encodeURIComponent(taskId) + '&user_id=' + encodeURIComponent(state.userId), {
            method: 'GET',
            __meta: { reportTransportErrors: options.reportTransportErrors === true, requestName: 'editor-checklist' }
          });
          if (!isActiveEditorAuxLoad(taskId, seq)) return;
          setEditorChecklistState(data.items || [], taskId);
        } catch (error) {
          if (!isActiveEditorAuxLoad(taskId, seq)) return;
          if (Object.prototype.hasOwnProperty.call(state.editorChecklistCache || {}, String(taskId || ''))) {
            state.editorChecklist = cloneEditorChecklistItems(state.editorChecklistCache[String(taskId || '')] || []);
          }
        }
        if (!isActiveEditorAuxLoad(taskId, seq)) return;
        renderChecklist();
      }

      function setChecklistFilterMode(mode) {
        state.checklistFilterMode = (mode === 'open' || mode === 'done') ? mode : 'all';
        renderChecklist();
      }

      function focusFirstOpenChecklistItem() {
        state.checklistFilterMode = 'open';
        renderChecklist();
        setTimeout(function () {
          var input = document.querySelector('#editorChecklistList .checklist-item:not(.is-done) .checklist-text-input');
          if (input) {
            try {
              input.focus();
              if (typeof input.select === 'function') input.select();
            } catch (error) {}
          }
        }, 0);
      }

      async function bulkToggleChecklistItemsUi(targetDone) {
        if (!state.userId) return;
        var targetItems = (state.editorChecklist || []).filter(function (item) {
          return item && item.id && (!!item.is_done !== !!targetDone);
        });
        if (!targetItems.length) return;

        var lastItems = null;
        for (var i = 0; i < targetItems.length; i += 1) {
          var data = await requestJson('/tasks/checklist/toggle', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ item_id: targetItems[i].id, user_id: state.userId, is_done: !!targetDone })
          });
          if (data && Array.isArray(data.items)) lastItems = data.items;
        }

        if (lastItems) {
          setEditorChecklistState(lastItems, state.editorTaskId);
        } else if (state.editorTaskId) {
          await loadChecklistItems(state.editorTaskId);
        }
        renderChecklist();
        await loadPlanner();
      }

      function renderChecklist() {
        var container = byId('editorChecklistList');
        if (!container) return;
        container.innerHTML = '';
        var frag = document.createDocumentFragment();
        var items = state.editorChecklist || [];
        var total = items.length;
        var doneCount = items.filter(function (item) { return !!item.is_done; }).length;
        var openCount = Math.max(total - doneCount, 0);
        var progressPercent = total ? Math.round((doneCount / total) * 100) : 0;

        var summary = document.createElement('div');
        summary.className = 'checklist-summary-strip';

        var summaryMain = document.createElement('div');
        summaryMain.className = 'checklist-summary-main';

        var summaryTitle = document.createElement('div');
        summaryTitle.className = 'checklist-summary-title';
        summaryTitle.textContent = 'Чек-лист задачи';
        summaryMain.appendChild(summaryTitle);

        var summaryNote = document.createElement('div');
        summaryNote.className = 'checklist-summary-note';
        summaryNote.textContent = total
          ? ('Всего: ' + total + ' · Открыто: ' + openCount + ' · Выполнено: ' + doneCount)
          : 'Чек-лист пока пуст.';
        summaryMain.appendChild(summaryNote);

        var progressWrap = document.createElement('div');
        progressWrap.className = 'checklist-summary-progress';
        var progressBar = document.createElement('div');
        progressBar.className = 'checklist-progress-bar';
        var progressFill = document.createElement('div');
        progressFill.className = 'checklist-progress-fill';
        progressFill.style.width = progressPercent + '%';
        progressBar.appendChild(progressFill);
        progressWrap.appendChild(progressBar);
        var progressMeta = document.createElement('div');
        progressMeta.className = 'checklist-progress-meta';
        progressMeta.textContent = total ? ('Прогресс: ' + progressPercent + '%') : 'Добавь первый пункт чек-листа.';
        progressWrap.appendChild(progressMeta);
        summaryMain.appendChild(progressWrap);

        summary.appendChild(summaryMain);

        var summaryActions = document.createElement('div');
        summaryActions.className = 'checklist-summary-actions';

        var filterRow = document.createElement('div');
        filterRow.className = 'checklist-filter-row';

        [
          { mode: 'all', label: 'Все' },
          { mode: 'open', label: 'Открытые' },
          { mode: 'done', label: 'Выполненные' }
        ].forEach(function (item) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = state.checklistFilterMode === item.mode ? 'btn-secondary' : 'btn-ghost';
          btn.textContent = item.label;
          btn.addEventListener('click', function () { setChecklistFilterMode(item.mode); });
          filterRow.appendChild(btn);
        });
        summaryActions.appendChild(filterRow);

        var toolsRow = document.createElement('div');
        toolsRow.className = 'checklist-filter-row';

        if (openCount) {
          var focusOpenBtn = document.createElement('button');
          focusOpenBtn.type = 'button';
          focusOpenBtn.className = 'btn-ghost';
          focusOpenBtn.textContent = 'К первому открытому';
          focusOpenBtn.addEventListener('click', function () { focusFirstOpenChecklistItem(); });
          toolsRow.appendChild(focusOpenBtn);

          var markAllDoneBtn = document.createElement('button');
          markAllDoneBtn.type = 'button';
          markAllDoneBtn.className = 'btn-ghost';
          markAllDoneBtn.textContent = 'Закрыть все открытые';
          markAllDoneBtn.addEventListener('click', function () { bulkToggleChecklistItemsUi(true).catch(function (error) { showError(String(error)); }); });
          toolsRow.appendChild(markAllDoneBtn);
        }

        if (doneCount) {
          var reopenAllBtn = document.createElement('button');
          reopenAllBtn.type = 'button';
          reopenAllBtn.className = 'btn-ghost';
          reopenAllBtn.textContent = 'Вернуть выполненные';
          reopenAllBtn.addEventListener('click', function () { bulkToggleChecklistItemsUi(false).catch(function (error) { showError(String(error)); }); });
          toolsRow.appendChild(reopenAllBtn);
        }

        if (doneCount) {
          var toggleDoneBtn = document.createElement('button');
          toggleDoneBtn.type = 'button';
          toggleDoneBtn.className = 'btn-ghost';
          toggleDoneBtn.textContent = state.checklistHideDone ? 'Показать выполненные' : 'Скрыть выполненные';
          toggleDoneBtn.addEventListener('click', function () {
            state.checklistHideDone = !state.checklistHideDone;
            renderChecklist();
          });
          toolsRow.appendChild(toggleDoneBtn);
        }

        if (toolsRow.childNodes.length) summaryActions.appendChild(toolsRow);

        summary.appendChild(summaryActions);
        frag.appendChild(summary);

        if (!items.length) {
          var empty = document.createElement('div');
          empty.className = 'empty-state';
          empty.textContent = 'Чек-лист пока пуст.';
          frag.appendChild(empty);
          return;
        }

        var visibleItems = items.filter(function (item) {
          if (state.checklistHideDone && item.is_done) return false;
          if (state.checklistFilterMode === 'open') return !item.is_done;
          if (state.checklistFilterMode === 'done') return !!item.is_done;
          return true;
        });

        if (!visibleItems.length) {
          var hiddenEmpty = document.createElement('div');
          hiddenEmpty.className = 'empty-state';
          hiddenEmpty.textContent = state.checklistFilterMode === 'done'
            ? 'Нет выполненных пунктов в текущем фильтре.'
            : state.checklistFilterMode === 'open'
              ? 'Нет открытых пунктов в текущем фильтре.'
              : 'Все выполненные пункты скрыты.';
          frag.appendChild(hiddenEmpty);
          return;
        }

        visibleItems.forEach(function (item) {
          var row = document.createElement('div');
          row.className = 'checklist-item' + (item.is_done ? ' is-done' : '');

          var checkbox = document.createElement('button');
          checkbox.type = 'button';
          checkbox.className = 'checklist-toggle-btn' + (item.is_done ? ' is-done' : '');
          checkbox.textContent = '';
          checkbox.setAttribute('aria-hidden', 'true');
          checkbox.setAttribute('aria-label', item.is_done ? 'Снять отметку' : 'Отметить пункт');
          checkbox.addEventListener('click', function () { toggleChecklistItemUi(item.id, !item.is_done); });

          var textWrap = document.createElement('div');
          textWrap.className = 'checklist-text-wrap';

          var input = document.createElement('input');
          input.type = 'text';
          input.className = 'checklist-text-input';
          input.value = item.text || '';
          input.placeholder = 'Пункт чек-листа';
          input.setAttribute('aria-label', 'Название пункта чек-листа');
          input.autocomplete = 'off';
          var initialText = item.text || '';
          input.addEventListener('input', function () {
            updateChecklistItemTextLocal(item.id, input.value);
            scheduleChecklistItemSave(item.id, input.value);
          });
          input.addEventListener('blur', function () {
            flushChecklistItemSave(item.id, input.value).catch(function (error) { showError(String(error)); });
          });
          input.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
              event.preventDefault();
              input.blur();
            }
            if (event.key === 'Escape') {
              event.preventDefault();
              clearChecklistSaveTimer(item.id);
              input.value = initialText;
              updateChecklistItemTextLocal(item.id, initialText);
              input.blur();
            }
          });
          textWrap.appendChild(input);

          var actions = document.createElement('div');
          actions.className = 'checklist-actions';

          var deleteBtn = document.createElement('button');
          deleteBtn.type = 'button';
          deleteBtn.className = 'btn-danger';
          deleteBtn.textContent = 'Удалить';
          deleteBtn.addEventListener('click', function () { deleteChecklistItemUi(item.id, item.text || ''); });
          actions.appendChild(deleteBtn);

          var convertBtn = document.createElement('button');
          convertBtn.type = 'button';
          convertBtn.className = 'btn-ghost';
          convertBtn.textContent = item.linked_task_id ? 'Открыть задачу' : 'В задачу';
          convertBtn.addEventListener('click', function () {
            if (item.linked_task_id) {
              openEditor(item.linked_task_id);
            } else {
              convertChecklistItemUi(item.id);
            }
          });
          actions.appendChild(convertBtn);

          row.appendChild(checkbox);
          row.appendChild(textWrap);
          row.appendChild(actions);
          frag.appendChild(row);
        });
        container.appendChild(frag);
      }

      async function addChecklistItemUi() {
        if (!state.editorTaskId) return;
        var input = byId('editorChecklistInput');
        var value = String(input && input.value || '').trim();
        if (!value) return;
        var data = await requestJson('/tasks/checklist/add', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ task_id: state.editorTaskId, user_id: state.userId, text: value }) });
        setEditorChecklistState(data.items || [], state.editorTaskId);
        if (input) input.value = '';
        renderChecklist();
        await loadPlanner();
      }

      async function toggleChecklistItemUi(itemId, isDone) {
        var data = await requestJson('/tasks/checklist/toggle', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ item_id: itemId, user_id: state.userId, is_done: isDone }) });
        setEditorChecklistState(data.items || [], state.editorTaskId);
        renderChecklist();
      }

      async function deleteChecklistItemUi(itemId, currentText) {
        if (!itemId || !state.userId) return;
        var confirmed = await confirmPlannerAction({
          title: 'Удалить пункт чек-листа',
          text: 'Удалить пункт «' + String(currentText || 'этот пункт') + '»?',
          confirmLabel: 'Удалить пункт',
          confirmClassName: 'btn-delete'
        });
        if (!confirmed) return;
        var data = await requestJson('/tasks/checklist/delete', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ item_id: itemId, user_id: state.userId })
        });
        setEditorChecklistState(data.items || [], state.editorTaskId);
        renderChecklist();
        await loadPlanner();
      }

      async function convertChecklistItemUi(itemId) {
        var data = await requestJson('/tasks/checklist/convert', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ item_id: itemId, task_id: state.editorTaskId, user_id: state.userId }) });
        setEditorChecklistState(data.items || [], state.editorTaskId);
        renderChecklist();
        await loadPlanner();
      }

      function getTimeDialogDurationTotalMinutes() {
        var days = Math.max(0, Number(byId('timeDialogDurationDaysInput').value || 0));
        var hours = Math.max(0, Number(byId('timeDialogDurationHoursInput').value || 0));
        var minutes = Math.max(0, Number(byId('timeDialogDurationMinutesInput').value || 0));
        var total = days * 1440 + hours * 60 + minutes;
        return Math.max(getDurationStepMinutes(), total || DEFAULT_EVENT_DURATION_MIN);
      }

      function setTimeDialogRecurrenceUi() {
        var enabled = byId('timeDialogRecurrenceEnabled').checked;
        var body = byId('timeDialogRecurrenceBody');
        if (body) body.style.display = enabled ? 'block' : 'none';
        var box = byId('timeDialogCustomRecurrenceBox');
        if (box) box.classList.toggle('visible', enabled && byId('timeDialogRecurrenceSelect').value === 'custom');
      }

      function openTimeDialog(target, context) {
        state.timeDialogTarget = target;
        state.timeDialogContext = context || {};
        var dateInput = byId('timeDialogDateInput');
        var timeInput = byId('timeDialogTimeInput');
        var totalDuration = Math.max(state.gridStepMinutes || 5, Number(context.durationValue || context.duration || 60));
        var days = Math.floor(totalDuration / 1440);
        var remain = totalDuration % 1440;
        var hours = Math.floor(remain / 60);
        var minutes = remain % 60;
        dateInput.value = parseDisplayDateToYmd(context.dateValue || context.date || '');
        timeInput.value = context.timeValue || context.time || '';
        byId('timeDialogDurationDaysInput').value = String(days);
        byId('timeDialogDurationHoursInput').value = String(hours);
        byId('timeDialogDurationMinutesInput').value = String(minutes);
        var recurrenceType = context.recurrenceType || '';
        var recurrenceRule = context.recurrenceRule || '';
        var recurrenceEnabled = Number(context.recurrenceEnabled || 0) === 1 || !!recurrenceType;
        byId('timeDialogRecurrenceEnabled').checked = recurrenceEnabled;
        byId('timeDialogRecurrenceSelect').value = recurrenceType || 'weekly';
        setCustomWeekdaysFromRule('timeDialog', recurrenceRule || '');
        setTimeDialogRecurrenceUi();
        updateTimeDialogPreview();
        byId('timeDialogBackdrop').classList.add('visible');
      }

      function closeTimeDialog() {
        state.timeDialogTarget = null;
        state.timeDialogContext = null;
        byId('timeDialogBackdrop').classList.remove('visible');
      }

      function updateTimeDialogPreview() {
        var dateValue = byId('timeDialogDateInput').value;
        var timeValue = byId('timeDialogTimeInput').value;
        var durationValue = getTimeDialogDurationTotalMinutes();
        var main = byId('timeDialogEndMain');
        var sub = byId('timeDialogEndSub');
        if (!dateValue || !timeValue) {
          if (main) main.textContent = '—';
          if (sub) sub.textContent = 'Выбирается автоматически';
          return;
        }
        try {
          var start = new Date(dateValue + 'T' + timeValue + ':00');
          var end = new Date(start.getTime() + durationValue * 60000);
          if (main) main.textContent = formatDateShortDisplay(end) + ' · ' + String(end.getHours()).padStart(2, '0') + ':' + String(end.getMinutes()).padStart(2, '0');
          if (sub) sub.textContent = 'Окончание рассчитано автоматически';
        } catch (error) {
          if (main) main.textContent = '—';
          if (sub) sub.textContent = 'Выбирается автоматически';
        }
      }

      async function applyTimeDialog() {
        var target = state.timeDialogTarget;
        if (!target) return;
        var dateValue = byId('timeDialogDateInput').value;
        var timeValue = byId('timeDialogTimeInput').value;
        var durationValue = String(getTimeDialogDurationTotalMinutes());
        var recurrenceEnabled = byId('timeDialogRecurrenceEnabled').checked ? '1' : '0';
        var recurrenceType = recurrenceEnabled === '1' ? String(byId('timeDialogRecurrenceSelect').value || 'weekly') : '';
        var recurrenceRule = recurrenceType === 'custom' ? getCustomWeekdaysRule('timeDialog') : '';
        if (target === 'create') {
          byId('createDateInput').value = dateValue || '';
          byId('createTimeInput').value = timeValue;
          byId('createDurationInput').value = durationValue;
          byId('createRecurrenceTypeInput').value = recurrenceType;
          byId('createRecurrenceRuleInput').value = recurrenceRule;
          byId('createRecurrenceEnabledInput').value = recurrenceEnabled;
          updateRecurrenceUi('create');
          updateTimeSummary('create');
        } else if (target === 'editor') {
          byId('editorDateInput').value = dateValue || '';
          byId('editorTimeInput').value = timeValue;
          byId('editorDurationInput').value = durationValue;
          byId('editorRecurrenceTypeInput').value = recurrenceType;
          byId('editorRecurrenceRuleInput').value = recurrenceRule;
          byId('editorRecurrenceEnabledInput').value = recurrenceEnabled;
          if (state.editorCurrentTaskSnapshot) {
            state.editorCurrentTaskSnapshot.due_at = (dateValue && timeValue) ? makeDueAtIso(dateValue, timeValue) : null;
            state.editorCurrentTaskSnapshot.duration_minutes = Number(durationValue) || DEFAULT_EVENT_DURATION_MIN;
            state.editorCurrentTaskSnapshot.planned_minutes_manual = getEditorPlannedMinutesManualValue();
            state.editorCurrentTaskSnapshot.actual_minutes = normalizeMinutesInputValue(byId('editorActualMinutesInput') && byId('editorActualMinutesInput').value);
            state.editorCurrentTaskSnapshot.recurrence_type = recurrenceType || '';
            state.editorCurrentTaskSnapshot.recurrence_rule = recurrenceRule || '';
            state.editorCurrentTaskSnapshot.recurrence_enabled = Number(recurrenceEnabled || 0);
          }
          if (dateValue && timeValue && byId('editorStatusSelect')) {
            var currentEditorStatus = byId('editorStatusSelect').value;
            if (shouldAutoSwitchEditorStatusToPlanned(currentEditorStatus)) {
              byId('editorStatusSelect').value = STATUS.PLANNED;
            }
          }
          updateRecurrenceUi('editor');
          updateTimeSummary('editor');
          refreshEditorPlannedMinutesField(state.editorCurrentTaskSnapshot || {});
          updateEditorTimeMetricsNote(state.editorCurrentTaskSnapshot || {});
          closeTimeDialog();
          await persistEditorAuto({ fromTimeDialog: true });
          return;
        } else if (target === 'duplicate') {
          closeTimeDialog();
          await duplicateEditorTaskFromDialog({
            dateValue: dateValue || '',
            timeValue: timeValue || '',
            durationValue: durationValue,
            recurrenceType: recurrenceType,
            recurrenceRule: recurrenceRule,
            recurrenceEnabled: Number(recurrenceEnabled || 0)
          });
          return;
        } else if (target === 'inbox_schedule') {
          var inboxTaskId = state.timeDialogContext && state.timeDialogContext.taskId;
          closeTimeDialog();
          if (inboxTaskId && dateValue && timeValue) {
            await scheduleTask(inboxTaskId, makeDueAtIso(dateValue, timeValue), STATUS.PLANNED, Number(durationValue) || DEFAULT_EVENT_DURATION_MIN);
          }
          return;
        }
        closeTimeDialog();
      }

      function shouldAutoSwitchEditorStatusToPlanned(currentStatus) {
        var normalized = normalizeStatus(currentStatus);
        return normalized !== STATUS.DONE && normalized !== STATUS.CANCELED;
      }

      function requestAiCreateAssist() {
        return requestJson('/tasks/create-ai', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            title: String(byId('createTitleInput').value || '').trim(),
            project_name: getProjectValueFromUi('create'),
            description: String(byId('createDescriptionInput').value || '').trim(),
            task_product: String((byId('createProductInput') && byId('createProductInput').value) || '').trim()
          }),
          __meta: { reportServerErrors: true, requestName: 'ai-create-assist', timeoutMs: AI_REQUEST_TIMEOUT_MS }
        });
      }


      async function requestAiEditorAssist() {
        return requestJson('/tasks/create-ai', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            title: String(byId('editorTitleInput').value || '').trim(),
            project_name: getProjectValueFromUi('editor'),
            description: String(byId('editorDescriptionInput').value || '').trim(),
            task_product: String((byId('editorProductInput') && byId('editorProductInput').value) || '').trim()
          }),
          __meta: { reportServerErrors: true, requestName: 'ai-editor-assist', timeoutMs: AI_REQUEST_TIMEOUT_MS }
        });
      }

      function requestAiTaskResultTransform(scope) {
        var prefix = scope === 'editor' ? 'editor' : 'create';
        var titleInput = byId(prefix + 'TitleInput');
        var productInput = byId(prefix + 'ProductInput');
        var descriptionInput = byId(prefix + 'DescriptionInput');
        return requestJson('/tasks/result-transform', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            title: String((titleInput && titleInput.value) || '').trim(),
            project_name: getProjectValueFromUi(prefix),
            description: String((descriptionInput && descriptionInput.value) || '').trim(),
            task_product: String((productInput && productInput.value) || '').trim()
          }),
          __meta: { reportServerErrors: true, requestName: 'ai-result-transform-' + prefix, timeoutMs: AI_REQUEST_TIMEOUT_MS }
        });
      }


      function resolveButtonElement(buttonOrId) {
        if (!buttonOrId) return null;
        if (typeof buttonOrId === 'string') return byId(buttonOrId);
        return buttonOrId && buttonOrId.nodeType === 1 ? buttonOrId : null;
      }

      function setAiButtonLoadingState(buttonOrId, isLoading, options) {
        var button = resolveButtonElement(buttonOrId);
        if (!button) return;
        var opts = options || {};
        var originalLabel = button.dataset.loadingOriginalLabel || button.textContent || '';
        if (!button.dataset.loadingOriginalLabel) button.dataset.loadingOriginalLabel = originalLabel;
        if (isLoading) {
          button.disabled = true;
          button.classList.add('is-loading');
          button.setAttribute('aria-busy', 'true');
          if (!button.classList.contains('btn-square-ai')) {
            button.textContent = opts.loadingLabel || 'Обработка запроса…';
          }
          return;
        }
        button.classList.remove('is-loading');
        button.removeAttribute('aria-busy');
        if (!button.classList.contains('btn-square-ai')) {
          button.textContent = button.dataset.loadingOriginalLabel || originalLabel;
        }
        updateAiButtonsAvailability();
      }

      function isAiQuotaLimitedError(error) {
        var responseData = error && error.__responseData ? error.__responseData : null;
        var details = responseData && responseData.details ? String(responseData.details) : (error && error.message ? String(error.message) : '');
        return /quota|resource exhausted|429|rate limit|daily free allocation|free_tier_requests|quota exceeded|limit exceeded|too many requests/i.test(details || '');
      }

      function getAiQuotaRetryMs(error) {
        var responseData = error && error.__responseData ? error.__responseData : null;
        var details = responseData && responseData.details ? String(responseData.details) : (error && error.message ? String(error.message) : '');
        var retryMatch = String(details || '').match(/retry in\s+([0-9]+(?:\.[0-9]+)?)s/i);
        if (retryMatch) {
          var retrySeconds = Number(retryMatch[1]);
          if (Number.isFinite(retrySeconds) && retrySeconds > 0) return Math.max(5000, Math.ceil(retrySeconds * 1000) + 1500);
        }
        if (/daily free allocation|free_tier_requests|quota exceeded/i.test(details || '')) return 10 * 60 * 1000;
        return 60 * 1000;
      }

      function formatAiCooldownRemaining(ms) {
        var totalSeconds = Math.max(1, Math.ceil(Number(ms || 0) / 1000));
        if (totalSeconds < 60) return totalSeconds + ' сек.';
        var minutes = Math.ceil(totalSeconds / 60);
        return minutes + ' мин.';
      }

      function buildAiQuotaCooldownMessage() {
        var until = Number(state && state.aiQuotaCooldownUntil || 0);
        if (!until || until <= Date.now()) return '';
        var remaining = until - Date.now();
        return 'AI временно недоступен из-за лимита запросов. Попробуй снова через ' + formatAiCooldownRemaining(remaining);
      }

      function resetAiCooldownIfExpired() {
        var until = Number(state && state.aiQuotaCooldownUntil || 0);
