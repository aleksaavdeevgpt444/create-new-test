    /* =========================================================
     * ЭТАП 234: UI-1 / SHELL HIERARCHY
     * Усиливаем главное действие, делаем period panel заметнее,
     * ослабляем вторичные действия без изменения логики.
     * ========================================================= */
    .topbar {
      grid-template-columns: minmax(360px, 1.2fr) minmax(300px, 0.84fr);
      gap: 12px;
      align-items: stretch;
    }
