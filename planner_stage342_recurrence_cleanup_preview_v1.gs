// GET /maintenance/recurrence-deduplicate-preview?user_id=...
// Returns what WOULD be cleaned up. Does not write anything.
// ============================================================
async function handleRecurrenceDeduplicatePreviewApi(request, env) {
  if (String(request.method || 'GET').toUpperCase() !== 'GET') {
    return textResponse('Method Not Allowed', 405);
  }
  const url = new URL(request.url);
  const userId = url.searchParams.get('user_id') || null;
