async function getUserStatusCounts(env, userId) {
  const result = await env.DB.prepare(`
    SELECT status, COUNT(*) AS count
    FROM tasks
    WHERE user_id = ?
    GROUP BY status
  `)
    .bind(String(userId))
    .all();

  const counts = {
    [TASK_STATUSES.NEW]: 0,
    [TASK_STATUSES.PLANNED]: 0,
    [TASK_STATUSES.DONE]: 0,
    [TASK_STATUSES.CANCELED]: 0,
    [TASK_STATUSES.POSTPONED]: 0,
  };

  for (const row of result.results || []) {
    const normalized = normalizeStatus(row.status);
    if (normalized && Object.prototype.hasOwnProperty.call(counts, normalized)) {
      counts[normalized] += Number(row.count) || 0;
    }
  }

  return counts;
}

async function getCountByQuery(env, sql, values) {
  const row = await env.DB.prepare(sql).bind(...values).first();
  return Number((row && (row.count ?? row.COUNT ?? row.cnt)) || 0);
}

async function getWeeklyStatusCounts(env, { userId, fromIso, toIso }) {
  const plannedStatuses = getStatusSqlValues(TASK_STATUSES.PLANNED);
  const newStatuses = getStatusSqlValues(TASK_STATUSES.NEW);
  const doneStatuses = getStatusSqlValues(TASK_STATUSES.DONE);
  const canceledStatuses = getStatusSqlValues(TASK_STATUSES.CANCELED);
  const postponedStatuses = getStatusSqlValues(TASK_STATUSES.POSTPONED);

  function buildIn(placeholders) {
    return placeholders.map(() => '?').join(', ');
  }

  const weekCounts = {
    [TASK_STATUSES.NEW]: 0,
    [TASK_STATUSES.PLANNED]: 0,
    [TASK_STATUSES.DONE]: 0,
    [TASK_STATUSES.CANCELED]: 0,
    [TASK_STATUSES.POSTPONED]: 0,
  };

  weekCounts[TASK_STATUSES.PLANNED] = await getCountByQuery(
    env,
    `SELECT COUNT(*) AS count FROM tasks WHERE user_id = ? AND status IN (${buildIn(plannedStatuses)}) AND due_at IS NOT NULL AND due_at >= ? AND due_at < ?`,
    [String(userId), ...plannedStatuses, fromIso, toIso]
  );

  weekCounts[TASK_STATUSES.NEW] = await getCountByQuery(
    env,
    `SELECT COUNT(*) AS count FROM tasks WHERE user_id = ? AND status IN (${buildIn(newStatuses)}) AND created_at >= ? AND created_at < ?`,
    [String(userId), ...newStatuses, fromIso, toIso]
  );

  weekCounts[TASK_STATUSES.DONE] = await getCountByQuery(
    env,
    `SELECT COUNT(*) AS count FROM tasks WHERE user_id = ? AND status IN (${buildIn(doneStatuses)}) AND updated_at >= ? AND updated_at < ?`,
    [String(userId), ...doneStatuses, fromIso, toIso]
  );

  weekCounts[TASK_STATUSES.CANCELED] = await getCountByQuery(
    env,
    `SELECT COUNT(*) AS count FROM tasks WHERE user_id = ? AND status IN (${buildIn(canceledStatuses)}) AND updated_at >= ? AND updated_at < ?`,
    [String(userId), ...canceledStatuses, fromIso, toIso]
  );

  weekCounts[TASK_STATUSES.POSTPONED] = await getCountByQuery(
    env,
    `SELECT COUNT(*) AS count FROM tasks WHERE user_id = ? AND status IN (${buildIn(postponedStatuses)}) AND updated_at >= ? AND updated_at < ?`,
    [String(userId), ...postponedStatuses, fromIso, toIso]
  );

  return weekCounts;
}

async function getBoardData(env, { userId, limitPerStatus = BOARD_LIMIT }) {
  const counts = await getUserStatusCounts(env, userId);
  const [newItems, plannedItems, doneItems, canceledItems, postponedItems] = await Promise.all([
    getTasksByStatus(env, { userId, status: TASK_STATUSES.NEW, limit: limitPerStatus }),
    getTasksByStatus(env, { userId, status: TASK_STATUSES.PLANNED, limit: limitPerStatus }),
    getTasksByStatus(env, { userId, status: TASK_STATUSES.DONE, limit: limitPerStatus }),
    getTasksByStatus(env, { userId, status: TASK_STATUSES.CANCELED, limit: limitPerStatus }),
    getTasksByStatus(env, { userId, status: TASK_STATUSES.POSTPONED, limit: limitPerStatus }),
  ]);

  return {
    counts,
    columns: {
      [TASK_STATUSES.NEW]: newItems,
      [TASK_STATUSES.PLANNED]: plannedItems,
      [TASK_STATUSES.DONE]: doneItems,
      [TASK_STATUSES.CANCELED]: canceledItems,
      [TASK_STATUSES.POSTPONED]: postponedItems,
    },
  };
}

function startOfWeekFromYmd(weekStartYmd) {
  const value = weekStartYmd || new Date().toISOString().slice(0, 10);
  const date = new Date(`${value}T00:00:00.000Z`);
  if (Number.isNaN(date.getTime())) throw new Error(`Invalid week_start: ${weekStartYmd}`);
  return date;
}

// Stage341 RECURRENCE_READ_ONLY_SAFE: this function must not call syncRecurringSeriesFromTask
async function getPlannerData(env, { userId, weekStartYmd, queueLimit = PLANNER_QUEUE_LIMIT }) {
  const weekStart = startOfWeekFromYmd(weekStartYmd);
  const weekEnd = new Date(weekStart.getTime() + 7 * 24 * 60 * 60 * 1000);
  const fromIso = weekStart.toISOString();
  const toIso = weekEnd.toISOString();

  const [calendarTasks, plannedTasks, newTasks, doneTasks, canceledTasks, postponedTasks, counts, weekCounts] = await Promise.all([
    getCalendarTasksInRange(env, { userId, fromIso, toIso, limit: 300 }),
    getScheduledTasksInRange(env, { userId, fromIso, toIso, limit: queueLimit }),
    getTasksByStatus(env, { userId, status: TASK_STATUSES.NEW, limit: queueLimit }),
    getTasksByStatusUpdatedInRange(env, { userId, status: TASK_STATUSES.DONE, fromIso, toIso, limit: queueLimit }),
    getTasksByStatusUpdatedInRange(env, { userId, status: TASK_STATUSES.CANCELED, fromIso, toIso, limit: queueLimit }),
    getTasksByStatusUpdatedInRange(env, { userId, status: TASK_STATUSES.POSTPONED, fromIso, toIso, limit: queueLimit }),
    getUserStatusCounts(env, userId),
    getWeeklyStatusCounts(env, { userId, fromIso, toIso }),
  ]);

  return {
    week: {
      start: weekStart.toISOString().slice(0, 10),
      endExclusive: weekEnd.toISOString().slice(0, 10),
    },
    counts,
    weekCounts,
    scheduled: calendarTasks,
    queues: {
      [TASK_STATUSES.NEW]: newTasks,
      [TASK_STATUSES.PLANNED]: plannedTasks.slice(0, queueLimit),
      [TASK_STATUSES.DONE]: doneTasks,
      [TASK_STATUSES.CANCELED]: canceledTasks,
      [TASK_STATUSES.POSTPONED]: postponedTasks,
    },
  };
}

function buildTelegramReplyAfterAi(taskText, aiResult) {
  let replyText = `Задача сохранена:\n${taskText}`;
  if (!aiResult) return replyText;
  replyText += `\n\nAI-приоритет: ${mapPriorityLevelToLabel(aiResult.priority_level)}`;
  if (aiResult.project_guess) replyText += `\nПроект: ${aiResult.project_guess}`;
  if (aiResult.next_step) replyText += `\nСледующий шаг: ${aiResult.next_step}`;
  return replyText;
}

async function handleStatusCommand(env, chatId, targetStatus, args) {
  if (!args.length) {
    const text = await getStatusTasksText(env, String(chatId), targetStatus, TELEGRAM_LIST_LIMIT);
    await sendTelegramMessage(env, chatId, text);
    return true;
  }

  const parsed = parseStatusMoveArgs(args, TASK_STATUSES.NEW);
  if (!parsed.ok) {
    await sendTelegramMessage(env, chatId, `Не удалось разобрать команду.\n\n${buildStatusMoveHelpText()}`);
    return true;
  }

  if (parsed.sourceStatus === targetStatus) {
    await sendTelegramMessage(env, chatId, "Источник и целевой статус совпадают. Используй другую команду или просто список.");
    return true;
  }

  const task = await getTaskByDisplayIndex(env, {
    userId: String(chatId),
    status: parsed.sourceStatus,
    index: parsed.index,
    limit: 50,
  });

  if (!task) {
    const listText = await getStatusTasksText(env, String(chatId), parsed.sourceStatus, TELEGRAM_LIST_LIMIT);
    await sendTelegramMessage(
      env,
      chatId,
      `Не нашёл задачу под номером ${parsed.index} в «${getStatusLabel(parsed.sourceStatus)}».\n\n${listText}`
    );
    return true;
  }

  const updatedTask = await updateTaskStatus(env, { taskId: task.id, userId: String(chatId), nextStatus: targetStatus });
  await sendTelegramMessage(
    env,
    chatId,
    [
      `Статус обновлён: ${getStatusLabel(parsed.sourceStatus)} → ${getStatusLabel(targetStatus)}`,
      "",
      `Задача: ${updatedTask?.title || task.title}`,
      `Проект: ${(updatedTask?.project_name || task.project_name || "Без проекта")}`,
      `Приоритет: ${getPriorityLabelByNumber(updatedTask?.priority_ai || task.priority_ai)}`,
    ].join("\n")
  );

  return true;
}

