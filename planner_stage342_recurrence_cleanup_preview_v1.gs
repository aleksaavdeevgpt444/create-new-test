        if (quality.hasResultMarker) data.meta.push('Есть формат результата');
        if (quality.hasMeasurement) data.meta.push('Есть критерий готовности');
        if (quality.hasOutcomeConnector) data.meta.push('Есть логика выхода');
        if (quality.sameAsTitle) data.meta.push('Дублирует название');
        if (quality.hasDescriptionSupport) data.meta.push('Есть контекст в описании');
