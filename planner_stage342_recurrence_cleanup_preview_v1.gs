      function getCoreWorkflowPolishMetrics(viewName) {
        var normalized = normalizeViewName(viewName || state.currentView || 'today');
        if (normalized === 'today') {
          var dayYmd = state.dayYmd || formatYmdLocal(new Date());
          var data = getTodayOsData(dayYmd);
          var reminderData = getReminderCenterData(dayYmd);
          return [
            { value: String(data.mainTasks.length || 0), label: 'Главных задач дня', note: 'Execution-набор, который реально нужно вытянуть сегодня.' },
            { value: formatMinutesHoursLabel(data.plannedMinutes), label: 'План дня', note: data.overflowMinutes > 0 ? 'Перегруз: ' + formatMinutesHoursLabel(data.overflowMinutes) : 'Свободно: ' + formatMinutesHoursLabel(data.freeMinutes) },
            { value: String(reminderData.total || 0), label: 'Напоминаний', note: 'Контроль дня, который не должен уезжать в weekly review.' }
          ];
        }
        if (normalized === 'plan') {
          var planData = getPlanViewData();
          return [
            { value: String(planData.stats.active || 0), label: 'Активных на неделю', note: 'Материал недели, который ещё можно переразобрать до календаря.' },
            { value: String(planData.stats.backlog || 0), label: 'Без даты', note: 'Backlog, который нужно чистить здесь, а не тянуть в Today.' },
            { value: String(planData.stats.attention || 0), label: 'Требуют внимания', note: 'Риски, блокеры и перегруз до входа в execution.' }
          ];
        }
        if (normalized === 'planner') {
          var weekTasks = getCurrentWeekTasks();
          var weekMetrics = aggregateTaskTimeMetrics(weekTasks);
          var weekCapacity = getWeekCapacitySummary(state.weekStart || getCurrentWeekStartYmd());
          return [
            { value: String(weekMetrics.count || 0), label: 'Задач в раскладке', note: 'Уже выбранная работа недели, которая живёт в календаре.' },
            { value: formatMinutesHoursLabel(weekMetrics.planned), label: 'План по времени', note: 'Календарная нагрузка без weekly triage.' },
            { value: String(weekCapacity.overflowDays || 0), label: 'Перегружено дней', note: weekCapacity.overflowDays > 0 ? 'Есть дни, которые стоит разгрузить до входа в Today.' : 'Неделя выглядит сбалансированной.' }
          ];
        }
        var inboxSummary = getInboxSummary();
        return [
          { value: String(inboxSummary.activeCount || 0), label: 'Во входящих', note: 'Общий входящий объём, требующий первичного решения.' },
