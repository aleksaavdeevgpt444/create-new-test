    .templates-summary-grid {
      display:grid;
      grid-template-columns:repeat(auto-fit, minmax(150px, 1fr));
      gap:10px;
      margin-top:12px;
    }
    .templates-summary-card {
      border:1px solid rgba(255,255,255,.08);
      border-radius:16px;
      background:rgba(255,255,255,.03);
      padding:12px;
      display:flex;
      flex-direction:column;
      gap:6px;
    }
