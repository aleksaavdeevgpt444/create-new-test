      function updateAiButtonsAvailability() {
        var cooldownUntil = Number(state && state.aiQuotaCooldownUntil || 0);
        var isCoolingDown = cooldownUntil > Date.now();
        var message = isCoolingDown ? buildAiQuotaCooldownMessage() : '';
        Array.prototype.slice.call(document.querySelectorAll(getAiButtonsSelector())).forEach(function (button) {
          if (!button) return;
          if (button.classList.contains('is-loading')) return;
          if (isCoolingDown) {
            button.disabled = true;
            button.dataset.aiCooldownDisabled = '1';
            if (message) button.title = message;
            return;
          }
          if (button.dataset.aiCooldownDisabled === '1') {
            button.disabled = false;
            button.dataset.aiCooldownDisabled = '0';
            if (button.title === message || /AI временно недоступен из-за лимита запросов/i.test(String(button.title || ''))) {
