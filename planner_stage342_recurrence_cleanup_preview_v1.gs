      recurrenceEnabled: shouldDetachCurrent ? 0 : (Object.prototype.hasOwnProperty.call(body || {}, "recurrence_enabled") ? body.recurrence_enabled : undefined),
    });
    const responseTask = shouldDetachCurrent
      ? updatedTask
      : await syncRecurringSeriesFromTask(env, { taskId: updatedTask.id, userId: String(userId), _debugCaller: 'handleTaskUpdateApi' });
    if (nextProjectName) {
      await upsertProjectRecord(env, { userId: String(userId), name: nextProjectName });
