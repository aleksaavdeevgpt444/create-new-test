      function formatTaskHistoryEventLabel(eventType) {
        var map = {
          created: 'Создание задачи',
          status_changed: 'Изменение статуса',
          schedule_changed: 'Изменение времени',
          meta_changed: 'Изменение полей',
          dependency_changed: 'Изменение блокера',
          deleted: 'Удаление задачи'
        };
        return map[String(eventType || '')] || 'Системное изменение';
      }

      function formatTaskHistoryPayload(entry) {
        var payload = entry && entry.payload ? entry.payload : null;
        if (!payload || typeof payload !== 'object') return 'Без дополнительных деталей.';
        var parts = [];
        function pushChange(label, info) {
          if (!(info && typeof info === 'object' && ('from' in info || 'to' in info))) return;
          var fromText = info.from == null || info.from === '' ? '—' : String(info.from);
          var toText = info.to == null || info.to === '' ? '—' : String(info.to);
          if (fromText === toText) return;
          parts.push(label + ': ' + fromText + ' → ' + toText);
        }
        pushChange('Название', payload.title);
        pushChange('Продукт', payload.task_product);
        pushChange('Описание', payload.description);
        pushChange('Проект', payload.project_name);
        pushChange('Приоритет', payload.priority_manual);
        pushChange('Длительность', payload.duration_minutes);
        pushChange('Плановое время', payload.planned_minutes_manual);
        pushChange('Факт', payload.actual_minutes);
        pushChange('Напоминание', payload.remind_at);
        if (payload.previous_status !== undefined || payload.next_status !== undefined) parts.push('Статус: ' + (payload.previous_status || '—') + ' → ' + (payload.next_status || '—'));
        if (payload.previous_due_at !== undefined || payload.next_due_at !== undefined) parts.push('Слот: ' + (payload.previous_due_at ? formatShortDateTimeLocal(payload.previous_due_at) : 'без даты') + ' → ' + (payload.next_due_at ? formatShortDateTimeLocal(payload.next_due_at) : 'без даты'));
        if (payload.previous_blocked_by_task_id !== undefined || payload.blocked_by_task_id !== undefined) {
          var prevTask = payload.previous_blocked_by_task_id ? findTaskById(payload.previous_blocked_by_task_id) : null;
          var nextTask = payload.blocked_by_task_id ? findTaskById(payload.blocked_by_task_id) : null;
          parts.push('Блокер: ' + (prevTask ? prevTask.title : '—') + ' → ' + (nextTask ? nextTask.title : '—'));
        }
        if (entry.event_type === 'created' && payload.title) parts.push('Создана задача: ' + payload.title);
        if (entry.event_type === 'deleted' && payload.title) parts.push('Удалена задача: ' + payload.title);
        return parts.length ? parts.join(' · ') : 'Без дополнительных деталей.';
      }

