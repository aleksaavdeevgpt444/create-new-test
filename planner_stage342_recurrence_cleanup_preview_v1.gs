    block_instance_id: String(row.block_instance_id || ''),
    link_mode: String(row.link_mode || 'soft'),
    created_at: row && row.created_at ? String(row.created_at) : null,
    updated_at: row && row.updated_at ? String(row.updated_at) : null
  };
}

async function upsertTaskTimeBlockLinkForTask(env, userId, taskId, blockInstanceId, linkMode) {
  await ensureFrameworksSchema(env);
  const normalized = normalizeTaskTimeBlockLinkServer({ task_id: taskId, block_instance_id: blockInstanceId, link_mode: linkMode });
  if (!normalized.taskId) throw new Error('task_id is required');
  if (!normalized.blockInstanceId) return deleteTaskTimeBlockLinkForTask(env, userId, normalized.taskId);
  const now = new Date().toISOString();
  const existing = await getTaskTimeBlockLinkForTask(env, userId, normalized.taskId);
  if (existing && existing.id) {
    await env.DB.prepare(`UPDATE task_time_block_links SET block_instance_id = ?, link_mode = ?, updated_at = ? WHERE id = ?`).bind(normalized.blockInstanceId, normalized.linkMode || 'soft', now, String(existing.id)).run();
    return {
      id: String(existing.id),
      user_id: String(userId),
      task_id: normalized.taskId,
      block_instance_id: normalized.blockInstanceId,
      link_mode: normalized.linkMode || 'soft',
      created_at: existing.created_at || now,
      updated_at: now
    };
  }
  const id = crypto.randomUUID();
  await env.DB.prepare(`INSERT INTO task_time_block_links (id, user_id, task_id, block_instance_id, link_mode, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)`).bind(id, String(userId), normalized.taskId, normalized.blockInstanceId, normalized.linkMode || 'soft', now, now).run();
  return {
    id,
    user_id: String(userId),
    task_id: normalized.taskId,
    block_instance_id: normalized.blockInstanceId,
    link_mode: normalized.linkMode || 'soft',
    created_at: now,
    updated_at: now
  };
}

