      function resolveWeekCardVisual(durationMinutes, overlapCols) {
        var settings = state.weekCardSettings || getDefaultWeekCardSettings();
        var density = settings.density || 'balanced';
        if (density === 'balanced') {
          if (overlapCols >= 3 || durationMinutes <= 15) density = 'minimal';
          else if (overlapCols >= 2 || durationMinutes <= 35) density = 'compact';
        } else if (density === 'compact') {
          if (overlapCols >= 3 || durationMinutes <= 15) density = 'minimal';
        }

        var displayMode = getCalendarCardDisplayMode(durationMinutes);
        if (density === 'compact' && displayMode === 'full') displayMode = 'time-title';
        if (density === 'minimal') displayMode = settings.showTime ? 'time-title' : 'title-wrap';

        var showTime = settings.showTime !== false;
        var showProject = settings.showProject !== false;
        var showStatus = settings.showStatus !== false;

        if (density === 'compact' && durationMinutes < 25) showProject = false;
        if (density === 'compact' && overlapCols > 1) showStatus = false;
        if (density === 'minimal') {
          showProject = false;
          showStatus = false;
        }

        var compactTitleOnly = (density === 'compact' || density === 'minimal') && durationMinutes <= 30;
        if (compactTitleOnly) {
          displayMode = durationMinutes <= 15 ? 'title-single' : 'title-wrap';
          showTime = false;
          showProject = false;
          showStatus = false;
        }

        return {
          density: density,
          displayMode: displayMode,
          showTime: showTime,
          showProject: showProject,
          showStatus: showStatus
        };
      }

      function renderScheduledEvents(tasks) {
        var eventsLayer = byId('eventsLayer');
        Array.prototype.forEach.call(eventsLayer.querySelectorAll('.calendar-event, .calendar-now-line'), function (el) {
          if (el && el.parentNode === eventsLayer) el.parentNode.removeChild(el);
        });

        var days = buildVisibleDays('week');
        var dayCount = days.length;
        var renderWindow = getCalendarRenderWindowHours();
        var totalMinutes = (renderWindow.endHour - renderWindow.startHour) * 60;
        var tasksByDay = {};

        (tasks || []).forEach(function (task) {
          if (!task || !task.due_at) return;
          var date = new Date(task.due_at);
          if (isNaN(date.getTime())) return;
          var dayKey = formatYmdLocal(date);
          if (!tasksByDay[dayKey]) tasksByDay[dayKey] = [];
          tasksByDay[dayKey].push(task);
        });

        Object.keys(tasksByDay).forEach(function (dayKey) {
          var startDate = getPeriodStartDate('week');
          var dayIndex = Math.round((new Date(dayKey + 'T00:00:00') - startDate) / 86400000);
          if (dayIndex < 0 || dayIndex >= dayCount) return;

          buildDayOverlapLayout(tasksByDay[dayKey]).forEach(function (layoutItem) {
            var task = layoutItem.task;
            var date = new Date(task.due_at);
            var startMinutes = date.getHours() * 60 + date.getMinutes();
            var relativeMinutes = startMinutes - renderWindow.startHour * 60;
            if (relativeMinutes < 0 || relativeMinutes >= totalMinutes) return;

            var duration = getTaskDurationMinutes(task);
            var topPercent = (relativeMinutes / totalMinutes) * 100;
            var heightPercent = getCalendarVisualHeightPercent(duration, totalMinutes);
            var baseDayWidth = 100 / dayCount;
            var overlapCols = Math.max(layoutItem.cols || 1, 1);
            var columnWidth = baseDayWidth / overlapCols;
            var leftPercent = dayIndex * baseDayWidth + layoutItem.col * columnWidth;
            var widthPercent = columnWidth;
            var status = normalizeStatus(task.status);
            var overdue = isOverdueTask(task);
            var hasOverlap = overlapCols > 1;
            var visual = resolveWeekCardVisual(duration, overlapCols);
            var displayMode = visual.displayMode;

            var isFocusProtected = isTaskFocusProtected(task.id);
            var riskMeta = getTaskRiskMeta(task);
            var showFocusBadge = !!((state.focusProtectionSettings || getDefaultFocusProtectionSettings()).enabled && (state.focusProtectionSettings || getDefaultFocusProtectionSettings()).showWeekBadge && isFocusProtected);
            var showRiskBadge = !!((state.riskSettings || getDefaultRiskSettings()).enabled && (state.riskSettings || getDefaultRiskSettings()).showWeekBadges && riskMeta.isAttentionNeeded);
            var card = document.createElement('div');
            card.className = 'today-event calendar-event density-' + visual.density + ' display-' + displayMode + (visual.showTime ? '' : ' hide-time') + (visual.showProject ? '' : ' hide-project') + (visual.showStatus ? '' : ' hide-status') + (getPriorityClass(task.priority_ai) || '') + (overdue ? ' is-overdue' : '') + (hasOverlap ? ' has-overlap' : '') + (status === STATUS.DONE ? ' is-done' : '') + (isFocusProtected ? ' is-focus-protected' : '') + (riskMeta.isAttentionNeeded ? ' is-risk-attention' : '');
            applyTaskSpaceFocusClass(card, task);
            applyTaskVisualStatusClass(card, status);
            card.style.top = 'calc(' + topPercent + '% + 2px)';
            card.style.left = 'calc(' + leftPercent + '% + 8px)';
            card.style.width = 'calc(' + widthPercent + '% - 16px)';
            card.style.height = 'calc(' + heightPercent + '% - 6px)';
            card.dataset.taskId = task.id;

            attachDragSource(card, {
              taskId: task.id,
              source: 'week',
              status: status,
              dueAt: task.due_at || null,
              durationMinutes: duration
            });

            bindTaskHoverCard(card, task);
            card.addEventListener('click', function () { hideTaskHoverCard(); if (shouldSuppressClick()) return; openEditor(task.id); });

            var top = document.createElement('div');
            top.className = 'today-event-top';
            var hasTopContent = false;
            var timeEl = document.createElement('div');
            timeEl.className = 'today-event-time';
            timeEl.textContent = formatTimeRange(task.due_at, duration);
            if (visual.showTime) {
              top.appendChild(timeEl);
