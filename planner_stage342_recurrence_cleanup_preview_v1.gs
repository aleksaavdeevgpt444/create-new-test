          });
          actions.appendChild(todayBtn);

          var calendarBtn = document.createElement('button');
          calendarBtn.type = 'button';
          calendarBtn.className = 'btn-ghost';
          calendarBtn.textContent = 'Календарь';
          calendarBtn.addEventListener('click', function () {
            openTimeDialog('inbox_schedule', {
              taskId: task.id,
              dateValue: state.dayYmd || formatYmdLocal(new Date()),
              timeValue: '',
              durationValue: String(getTaskDurationMinutes(task))
            });
          });
          actions.appendChild(calendarBtn);

          if (stage !== 'triaged') {
            var triagedBtn = document.createElement('button');
            triagedBtn.type = 'button';
