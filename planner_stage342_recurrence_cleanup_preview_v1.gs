      function getDayBlockData(dayYmd) {
        var blocks = [];
        if (!(state.dayBlockSettings || getDefaultDayBlockSettings()).enabled) {
          return {
            items: [],
            totalCount: 0,
            totalMinutes: 0,
            scheduledMinutes: 0,
            freeMinutes: 0,
            overflowMinutes: 0
          };
        }
        try {
          blocks = getMatchingDayBlocks(dayYmd).map(function (block) {
            return getDayBlockTaskBundle(dayYmd, block);
          });
        } catch (error) {
          blocks = [];
        }
        var totals = blocks.reduce(function (acc, item) {
          acc.totalMinutes += Number(item && item.blockMinutes) || 0;
          acc.scheduledMinutes += Number(item && item.overlapMinutes) || 0;
          acc.freeMinutes += Number(item && item.freeMinutes) || 0;
          acc.overflowMinutes += Number(item && item.overflowMinutes) || 0;
          return acc;
        }, { totalMinutes: 0, scheduledMinutes: 0, freeMinutes: 0, overflowMinutes: 0 });
        return {
          items: blocks,
          totalCount: blocks.length,
          totalMinutes: totals.totalMinutes,
          scheduledMinutes: totals.scheduledMinutes,
          freeMinutes: totals.freeMinutes,
          overflowMinutes: totals.overflowMinutes
        };
