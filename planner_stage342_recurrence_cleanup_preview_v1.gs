              renderGanttView();
            }),
            createBoardCommandAction('Открыть 1-ю', function () { if (loadRow.leadTask) openEditor(loadRow.leadTask.id); }),
            createBoardCommandAction('К проекту', function () { openProjectFromGantt(loadRow.project); })
          ]));
        }
        if (riskRow) {
          shell.appendChild(createBoardCommandCard('Риски в горизонте · ' + riskRow.project, 'Внимание: ' + riskRow.attentionCount + ' · блокеры: ' + riskRow.blockedCount, riskRow.blockedCount ? 'warn' : '', [
            createBoardCommandAction('Фильтр', function () {
              state.ganttProjectFilter = riskRow.project;
              renderGanttView();
            }),
            createBoardCommandAction('К неделе', function () { setActiveView('planner'); }),
            createBoardCommandAction('К проекту', function () { openProjectFromGantt(riskRow.project); })
          ]));
        }
        if (doneRow) {
          shell.appendChild(createBoardCommandCard('Завершённые в диапазоне · ' + doneRow.project, 'Готово: ' + doneRow.doneCount + ' · всего задач: ' + doneRow.count, '', [
            createBoardCommandAction('Показать', function () {
              state.ganttProjectFilter = doneRow.project;
              state.ganttFocus = 'done';
              renderGanttView();
            }),
            createBoardCommandAction('Открыть 1-ю', function () { if (doneRow.leadTask) openEditor(doneRow.leadTask.id); })
          ]));
        }
        var strategicSettings = normalizeStrategicLayerSettings(state.strategicLayerSettings || getDefaultStrategicLayerSettings());
        if (strategicSettings.enabled && strategicSettings.showGanttSummary) {
          var strategicRows = allRows.map(function (row) { return { row: row, summary: buildProjectStrategicSummary(row.project, row.tasks || []) }; });
          var bestRice = strategicRows.filter(function (entry) { return entry.summary.riceScore > 0; }).sort(function (a, b) { return b.summary.riceScore - a.summary.riceScore; })[0] || null;
          var bottleneck = strategicRows.filter(function (entry) { return !!(entry.summary.profile.bottleneckNote || entry.summary.blockedCount); }).sort(function (a, b) { return b.summary.blockedCount - a.summary.blockedCount; })[0] || null;
          if (bestRice && strategicSettings.methods.riceIce) {
            shell.appendChild(createBoardCommandCard('Strategic priority · ' + bestRice.row.project, 'RICE ' + bestRice.summary.riceScore.toFixed(1) + ' · ' + (bestRice.summary.impactEffortQuadrant || 'project-layer'), '', [
              createBoardCommandAction('Фильтр', function () { state.ganttProjectFilter = bestRice.row.project; renderGanttView(); }),
              createBoardCommandAction('К проекту', function () { openProjectFromGantt(bestRice.row.project); })
            ]));
          }
          if (bottleneck && strategicSettings.methods.toc) {
            shell.appendChild(createBoardCommandCard('Bottleneck · ' + bottleneck.row.project, (bottleneck.summary.profile.bottleneckNote || ('С блокером: ' + bottleneck.summary.blockedCount + ' задач')), 'warn', [
              createBoardCommandAction('Фильтр', function () { state.ganttProjectFilter = bottleneck.row.project; renderGanttView(); }),
              createBoardCommandAction('К проекту', function () { openProjectFromGantt(bottleneck.row.project); })
            ]));
          }
        }
      }

      function renderGanttProjectClusters(rows) {
        var shell = byId('ganttProjectClusters');
        if (!shell) return;
        shell.innerHTML = '';
        var metaMap = getProjectMetaMap();
        (rows || []).slice(0, 6).forEach(function (row) {
          var projectMeta = metaMap[normalizeProjectName(row && row.project)] || null;
          var note = projectMeta && projectMeta.notes ? String(projectMeta.notes).trim() : '';
          var links = projectMeta ? parseProjectLinksText(projectMeta.links_text) : [];
          var subtitleParts = ['Задач: ' + row.count, formatMinutesHoursLabel(row.plannedMinutes)];
          if (row.attentionCount) subtitleParts.push('внимание: ' + row.attentionCount);
          if (row.blockedCount) subtitleParts.push('блокеры: ' + row.blockedCount);
          var tone = row.blockedCount ? 'warn' : (row.attentionCount ? 'accent' : '');
          shell.appendChild(createBoardCommandCard(row.project, subtitleParts.join(' · '), tone, [
            createBoardCommandAction('Фильтр', function () {
              state.ganttProjectFilter = row.project;
              renderGanttView();
            }),
            createBoardCommandAction('Открыть 1-ю', function () { if (row.leadTask) openEditor(row.leadTask.id); }),
            createBoardCommandAction('К проекту', function () { openProjectFromGantt(row.project); })
          ]));
          var last = shell.lastChild;
          if (last && projectMeta) {
            var meta = document.createElement('div');
            meta.className = 'shell-task-meta';
            meta.appendChild(createChip('Приоритет проекта: ' + getProjectPriorityLabel(projectMeta.priority)));
            if (note) meta.appendChild(createChip('Есть заметки'));
            if (links.length) meta.appendChild(createChip('Ссылок: ' + links.length));
            last.appendChild(meta);
          }
        });
      }

      function getGanttSummaryData(rows) {
        var summary = {
          projects: rows.length,
          tasks: 0,
          plannedMinutes: 0,
          attention: 0,
          blocked: 0,
          done: 0
        };
        rows.forEach(function (row) {
          summary.tasks += row.count;
          summary.plannedMinutes += row.plannedMinutes;
          summary.attention += row.attentionCount;
          summary.blocked += row.blockedCount;
          summary.done += row.doneCount;
        });
        return summary;
      }

      function renderGanttSummaryStrip(rows) {
        var shell = byId('ganttSummaryStrip');
        if (!shell) return;
        shell.innerHTML = '';
        var summary = getGanttSummaryData(rows || []);
        shell.appendChild(createBoardSummaryCard(String(summary.projects), 'Проектов в диапазоне', ''));
        shell.appendChild(createBoardSummaryCard(String(summary.tasks), 'Задач на диаграмме', ''));
        shell.appendChild(createBoardSummaryCard(formatMinutesHoursLabel(summary.plannedMinutes), 'Плановая нагрузка', ''));
        shell.appendChild(createBoardSummaryCard(String(summary.attention), 'Требуют внимания', summary.attention ? 'warn' : ''));
        shell.appendChild(createBoardSummaryCard(String(summary.blocked), 'С блокером', summary.blocked ? 'warn' : ''));
        shell.appendChild(createBoardSummaryCard(String(summary.done), 'Выполнено в диапазоне', ''));
      }

      function renderGanttToolbarState(rows) {
        if (byId('ganttFocusSelect')) byId('ganttFocusSelect').value = getGanttFocusOptions().indexOf(state.ganttFocus) >= 0 ? state.ganttFocus : 'active';
        if (byId('ganttSortSelect')) byId('ganttSortSelect').value = ['timeline', 'load', 'attention', 'project'].indexOf(state.ganttSort) >= 0 ? state.ganttSort : 'timeline';
        var projectSelect = byId('ganttProjectFilterSelect');
        if (projectSelect) {
          var options = getGanttProjectFilterOptions(rows || []);
          var currentValue = normalizeProjectName(state.ganttProjectFilter || 'all');
          if (!options.some(function (item) { return item.value === currentValue; })) currentValue = 'all';
          state.ganttProjectFilter = currentValue;
          projectSelect.innerHTML = '';
          options.forEach(function (item) {
            var option = document.createElement('option');
            option.value = item.value;
            option.textContent = item.label;
            projectSelect.appendChild(option);
          });
          projectSelect.value = currentValue;
        }
      }

      function getQuarterWeekNumber(date, quarterStart) {
        var diff = date.getTime() - quarterStart.getTime();
        return Math.floor(diff / (7 * 86400000)) + 1;
      }

      function buildGanttScaleItems() {
        var scale = normalizePeriodMode(state.periodMode);
        if (scale === 'week') {
          return buildVisibleDays('week').map(function (day) {
            var start = new Date(day.ymd + 'T00:00:00');
            return { key: day.ymd, labelTop: day.name.toUpperCase(), labelBottom: day.label, startMs: start.getTime(), endMs: start.getTime() + 86400000 };
          });
        }
        if (scale === 'month') {
          return buildVisibleDays('month').map(function (day) {
            var start = new Date(day.ymd + 'T00:00:00');
            return { key: day.ymd, labelTop: String(start.getDate()), labelBottom: day.name, startMs: start.getTime(), endMs: start.getTime() + 86400000 };
          });
        }
        var start = getPeriodStartDate('quarter');
        var end = getPeriodEndDateExclusive('quarter');
        var items = [];
        for (var cursor = new Date(start); cursor < end; cursor.setDate(cursor.getDate() + 7)) {
          var itemStart = new Date(cursor.getFullYear(), cursor.getMonth(), cursor.getDate());
          var itemEnd = new Date(itemStart.getTime() + 7 * 86400000);
          if (itemEnd > end) itemEnd = new Date(end);
          items.push({
            key: formatYmdLocal(itemStart),
            labelTop: 'Н' + getQuarterWeekNumber(itemStart, start),
            labelBottom: formatWithPlannerTimeZone(itemStart, { day: '2-digit', month: '2-digit' }, '—'),
            startMs: itemStart.getTime(),
            endMs: itemEnd.getTime()
          });
        }
        return items;
      }

      function renderGanttDayHead() {
        var head = byId('ganttDaysHead');
        if (!head) return;
        head.innerHTML = '';
        var items = buildGanttScaleItems();
        head.style.gridTemplateColumns = 'repeat(' + items.length + ', minmax(72px, 1fr))';
        items.forEach(function (item) {
          var node = document.createElement('div');
          node.className = 'gantt-day-head';
          node.innerHTML = '<div>' + item.labelTop + '</div><div style="font-weight:800;color:#eef3ff;margin-top:4px;">' + item.labelBottom + '</div>';
          head.appendChild(node);
        });
      }

      function renderGanttView() {
        renderGanttDayHead();
        var container = byId('ganttRows');
        if (!container) return;
        container.innerHTML = '';
        var tasks = getGanttVisibleTasks(getShellTasks());
        var items = buildGanttScaleItems();
        var rangeStartMs = items.length ? items[0].startMs : getPeriodStartDate('week').getTime();
        var rangeEndMs = items.length ? items[items.length - 1].endMs : getPeriodEndDateExclusive('week').getTime();
        var rows = getGanttProjectRowsData(tasks, rangeStartMs, rangeEndMs);
        renderGanttToolbarState(rows);
        var filteredRows = getGanttFilteredRows(rows);
        renderGanttSummaryStrip(filteredRows);
        renderGanttCommandCenter(rows, filteredRows);
        renderGanttProjectClusters(filteredRows.length ? filteredRows : rows);
        if (!tasks.length) {
          var empty = document.createElement('div');
          empty.className = 'empty-state';
          empty.textContent = 'В текущем срезе нет задач с датой для диаграммы.';
          container.appendChild(empty);
          return;
        }
        if (!rows.length) {
          var emptyPeriod = document.createElement('div');
          emptyPeriod.className = 'empty-state';
          emptyPeriod.textContent = 'В выбранном масштабе нет задач с датой для диаграммы.';
          container.appendChild(emptyPeriod);
          return;
        }
        if (!filteredRows.length) {
          var emptyFilter = document.createElement('div');
          emptyFilter.className = 'empty-state';
          emptyFilter.textContent = 'По выбранному проекту в этом масштабе сейчас нет задач.';
          container.appendChild(emptyFilter);
          return;
        }
        var projectMetaMap = getProjectMetaMap();
        filteredRows.forEach(function (projectRow) {
          var projectMeta = projectMetaMap[normalizeProjectName(projectRow.project)] || null;
          var row = document.createElement('div');
          row.className = 'gantt-row';
          var left = document.createElement('div');
          left.className = 'gantt-project-card';
          var title = document.createElement('div');
          title.className = 'gantt-project-card-title';
          title.textContent = projectRow.project;
          left.appendChild(title);
          var subtitle = document.createElement('div');
          subtitle.className = 'gantt-project-card-subtitle';
          subtitle.textContent = 'Задач в диапазоне: ' + projectRow.count + ' · ' + formatMinutesHoursLabel(projectRow.plannedMinutes);
          left.appendChild(subtitle);
          var meta = document.createElement('div');
          meta.className = 'shell-task-meta';
          meta.appendChild(createChip('Внимание: ' + projectRow.attentionCount));
          meta.appendChild(createChip('Блокер: ' + projectRow.blockedCount));
          meta.appendChild(createChip('Готово: ' + projectRow.doneCount));
          if (projectMeta) meta.appendChild(createChip('Приоритет проекта: ' + getProjectPriorityLabel(projectMeta.priority)));
          left.appendChild(meta);
          if (projectMeta && projectMeta.notes) {
            var notes = document.createElement('div');
            notes.className = 'board-project-note';
            notes.textContent = String(projectMeta.notes).trim().slice(0, 180);
            left.appendChild(notes);
          }
          var ganttStrategicPanel = renderProjectStrategicPanel(projectRow.project, projectRow.tasks || [], { compact: true });
          if (ganttStrategicPanel && normalizeStrategicLayerSettings(state.strategicLayerSettings || getDefaultStrategicLayerSettings()).showGanttSummary) left.appendChild(ganttStrategicPanel);
          var actions = document.createElement('div');
          actions.className = 'board-column-actions';
          if (projectRow.leadTask) {
            actions.appendChild(createBoardColumnAction('Открыть первое', function () { openEditor(projectRow.leadTask.id); }));
            if (projectRow.leadTask.due_at) {
              actions.appendChild(createBoardColumnAction('К дню', function () { openDayInTodayView(formatYmdLocal(new Date(projectRow.leadTask.due_at))); }));
            }
          }
          actions.appendChild(createBoardColumnAction('Проект', function () { openProjectFromGantt(projectRow.project); }));
          actions.appendChild(createBoardColumnAction('План', function () { setActiveView('plan'); }));
          left.appendChild(actions);
          row.appendChild(left);

          var track = document.createElement('div');
          track.className = 'gantt-track';
          var grid = document.createElement('div');
          grid.className = 'gantt-track-grid';
          grid.style.gridTemplateColumns = 'repeat(' + items.length + ', minmax(0, 1fr))';
          for (var i = 0; i < items.length; i += 1) grid.appendChild(document.createElement('div'));
          track.appendChild(grid);
          var bars = document.createElement('div');
          bars.className = 'gantt-bars';
          projectRow.tasks.forEach(function (task, index) {
            var bar = document.createElement('div');
            bar.className = 'gantt-bar';
            applyTaskSpaceFocusClass(bar, task);
            var start = new Date(task.due_at).getTime();
            var endTask = getTaskEndDate(task);
            var end = endTask ? endTask.getTime() : start + getTaskDurationMinutes(task) * 60000;
            var totalRangeMs = Math.max(86400000, rangeEndMs - rangeStartMs);
            var leftPct = Math.max(0, Math.min(100, ((start - rangeStartMs) / totalRangeMs) * 100));
            var widthPct = Math.max(4, Math.min(100 - leftPct, ((end - start) / totalRangeMs) * 100));
            bar.style.left = leftPct + '%';
            bar.style.width = widthPct + '%';
            bar.style.top = (6 + index * 42) + 'px';
            if (isTaskAttentionNeeded(task)) {
              bar.style.boxShadow = '0 0 0 1px rgba(255,182,90,.34), 0 18px 30px rgba(255,182,90,.18)';
            }
            if (getTaskDependencyMeta(task).blockedByTask) {
              bar.style.borderColor = 'rgba(255,107,107,.42)';
              bar.style.background = 'linear-gradient(135deg, rgba(126,163,255,.88), rgba(255,107,107,.52))';
            }
            if ((normalizeStatus(task && task.status) || STATUS.NEW) === STATUS.DONE) {
              bar.style.opacity = '0.72';
            }
            bar.innerHTML = '<div class="gantt-bar-title"></div><div class="gantt-bar-subtitle"></div>';
            bar.querySelector('.gantt-bar-title').textContent = task.title || 'Без названия';
            bar.querySelector('.gantt-bar-subtitle').textContent = formatTimeRange(task.due_at, getTaskDurationMinutes(task), { withDate: true });
            bar.title = [normalizeProjectName(task.project_name), formatTimeRange(task.due_at, getTaskDurationMinutes(task), { withDate: true })].join(' · ');
            bar.addEventListener('click', function () { openEditor(task.id); });
            bars.appendChild(bar);
          });
          bars.style.minHeight = (projectRow.tasks.length * 42 + 12) + 'px';
          track.appendChild(bars);
          row.appendChild(track);
          container.appendChild(row);
        });
      }


      function getCurrentMonthTasks() {
        var start = getPeriodStartDate('month');
        var end = getPeriodEndDateExclusive('month');
        return getShellTasks().filter(function (task) {
          if (!task || !task.due_at) return false;
          var due = new Date(task.due_at);
          if (isNaN(due.getTime())) return false;
          return due >= start && due < end;
        }).sort(compareTasksByDueAndUpdated);
      }

      function isTaskMonthPinned(task) {
        return !!(task && Number(task.show_in_month || 0) === 1);
      }

      function getMonthViewTaskPriorityBucket(task, dayYmd) {
        if (isTaskMonthPinned(task)) return 3;
        if (isMonthViewPrimaryTask(task, dayYmd)) return 2;
        if (isMonthViewImportantNonRecurringTask(task)) return 1;
        return 0;
      }

      function isMonthViewPrimaryTask(task, dayYmd) {
        return !!(task && isTaskPrimaryForRitualDay(task, dayYmd));
      }

      function isMonthViewImportantNonRecurringTask(task) {
        if (!task) return false;
        if (isRecurringCalendarTask(task)) return false;
        return getTaskPriorityRank(task) >= 3 || isTaskFocusProtected(task);
      }

      function isTaskVisibleInMonthView(task, dayYmd) {
        if (!task) return false;
        if (isTaskMonthPinned(task)) return true;
        return isMonthViewPrimaryTask(task, dayYmd) || isMonthViewImportantNonRecurringTask(task);
      }

      function buildMonthGridDays() {
        var monthStart = getPeriodStartDate('month');
        var monthEnd = getPeriodEndDateExclusive('month');
        var gridStart = new Date(monthStart);
        var monthStartIndex = (gridStart.getDay() + 6) % 7;
        gridStart.setDate(gridStart.getDate() - monthStartIndex);
        var lastMonthDay = new Date(monthEnd.getTime() - 86400000);
        var lastIndex = (lastMonthDay.getDay() + 6) % 7;
        var gridEndExclusive = new Date(lastMonthDay);
        gridEndExclusive.setDate(gridEndExclusive.getDate() + (6 - lastIndex) + 1);
        var todayYmd = formatYmdLocal(new Date());
        var days = [];
        for (var cursor = new Date(gridStart); cursor < gridEndExclusive; cursor.setDate(cursor.getDate() + 1)) {
          var ymd = formatYmdLocal(cursor);
          var tasks = getTasksForDay(ymd);
          var activeTasks = tasks.filter(function (task) {
            var status = normalizeStatus(task && task.status) || STATUS.NEW;
            return status === STATUS.NEW || status === STATUS.PLANNED || status === STATUS.POSTPONED || status === STATUS.DONE;
          }).filter(function (task) {
            return isTaskVisibleInMonthView(task, ymd);
          });
          activeTasks.sort(function (a, b) {
            var bucketDiff = getMonthViewTaskPriorityBucket(b, ymd) - getMonthViewTaskPriorityBucket(a, ymd);
            if (bucketDiff !== 0) return bucketDiff;
            return compareTasksByDueAndUpdated(a, b);
          });
          var capacitySplit = splitDayTasksByCapacity(ymd, activeTasks);
          days.push({
            ymd: ymd,
            date: new Date(cursor.getFullYear(), cursor.getMonth(), cursor.getDate()),
            inCurrentMonth: cursor.getMonth() === monthStart.getMonth() && cursor.getFullYear() === monthStart.getFullYear(),
            isToday: ymd === todayYmd,
            tasks: activeTasks,
            attentionCount: getAttentionTasks(activeTasks).length,
            blockedCount: activeTasks.filter(function (task) { return !!(getTaskDependencyMeta(task).blockedByTask); }).length,
            overflowMinutes: capacitySplit.overflowMinutes,
            plannedMinutes: capacitySplit.plannedMinutes,
            doneCount: activeTasks.filter(function (task) { return (normalizeStatus(task && task.status) || STATUS.NEW) === STATUS.DONE; }).length,
            monthPinnedCount: activeTasks.filter(function (task) { return isTaskMonthPinned(task); }).length
          });
        }
        return days;
      }

      function getMonthViewSummaryData(days) {
        var list = Array.isArray(days) ? days.filter(function (day) { return day && day.inCurrentMonth; }) : [];
        var monthTasks = [];
        list.forEach(function (day) { monthTasks = monthTasks.concat(day.tasks || []); });
        return {
          total: monthTasks.length,
          activeDays: list.filter(function (day) { return (day.tasks || []).length > 0; }).length,
          planned: monthTasks.reduce(function (sum, task) { return sum + (Number(getEffectivePlannedMinutesClient(task)) || 0); }, 0),
          attention: getAttentionTasks(monthTasks).length,
          blocked: monthTasks.filter(function (task) { return !!(getTaskDependencyMeta(task).blockedByTask); }).length,
          done: monthTasks.filter(function (task) { return (normalizeStatus(task && task.status) || STATUS.NEW) === STATUS.DONE; }).length
        };
      }

      function renderMonthSummaryStrip(days) {
        var container = byId('monthSummaryStrip');
        if (!container) return;
        container.innerHTML = '';
        var summary = getMonthViewSummaryData(days);
        [
          createBoardSummaryCard(String(summary.total), 'Задач в месяце'),
          createBoardSummaryCard(String(summary.activeDays), 'Активных дней'),
          createBoardSummaryCard(formatMinutesHoursLabel(summary.planned), 'Плановая нагрузка'),
          createBoardSummaryCard(String(summary.attention), 'Требуют внимания', summary.attention > 0 ? 'warn' : ''),
          createBoardSummaryCard(String(summary.blocked), 'С блокером', summary.blocked > 0 ? 'danger' : ''),
          createBoardSummaryCard(String(summary.done), 'Выполнено')
        ].forEach(function (card) { container.appendChild(card); });
      }

      function createMonthTaskChip(task) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'month-task-chip';
        applyTaskSpaceFocusClass(btn, task);
        var status = normalizeStatus(task && task.status) || STATUS.NEW;
        var dependencyMeta = getTaskDependencyMeta(task);
        if (isTaskMonthPinned(task)) btn.classList.add('is-busy');
        if (isTaskAttentionNeeded(task)) btn.classList.add('is-attention');
        if (dependencyMeta.blockedByTask) btn.classList.add('is-blocked');
        if (status === STATUS.DONE) btn.classList.add('is-done');
        btn.innerHTML = '<div class="month-task-chip-header"><div class="month-task-chip-title"></div><div class="month-task-chip-badges"></div></div><div class="month-task-chip-meta"></div>';
        btn.querySelector('.month-task-chip-title').textContent = task.title || 'Без названия';
        var badges = btn.querySelector('.month-task-chip-badges');
        function appendBadge(label, className) {
          if (!badges) return;
          var badge = document.createElement('span');
          badge.className = 'month-task-badge' + (className ? ' ' + className : '');
          badge.textContent = label;
          badges.appendChild(badge);
        }
        if (isMonthViewPrimaryTask(task, formatYmdLocal(new Date(task.due_at || Date.now())))) appendBadge('Основная', 'is-primary');
        var parts = [];
        if (task.due_at) parts.push(formatWithPlannerTimeZone(task.due_at, { hour: '2-digit', minute: '2-digit', hour12: false }, '—'));
        parts.push(formatMinutesHoursLabel(getTaskDurationMinutes(task)));
        if (status === STATUS.DONE) parts.push('готово');
        btn.querySelector('.month-task-chip-meta').textContent = parts.join(' · ');
        btn.title = [normalizeProjectName(task.project_name), formatTimeRange(task.due_at, getTaskDurationMinutes(task), { withDate: true }), status === STATUS.DONE ? 'Выполнено' : getStatusSingular(status)].join(' · ');
        btn.addEventListener('click', function () { openEditor(task.id); });
        return btn;
      }

      function createMonthDayCell(day) {
        var cell = document.createElement('section');
        cell.className = 'month-day-cell';
        if (!day.inCurrentMonth) cell.classList.add('is-outside');
        if (day.isToday) cell.classList.add('is-today');
        if ((day.tasks || []).length) cell.classList.add('is-busy');
        if (day.overflowMinutes > 0) cell.classList.add('is-overflow');
        if (day.attentionCount > 0) cell.classList.add('is-attention');

        var head = document.createElement('div');
        head.className = 'month-day-head';
        var label = document.createElement('div');
        label.className = 'month-day-label';
        var number = document.createElement('div');
        number.className = 'month-day-number';
        number.textContent = String(day.date.getDate());
        var caption = document.createElement('div');
        caption.className = 'month-day-caption';
        caption.textContent = formatWithPlannerTimeZone(day.date, { weekday: 'long', month: 'short' }, '—');
        label.appendChild(number);
        label.appendChild(caption);
        head.appendChild(label);
        var summary = document.createElement('div');
        summary.className = 'month-day-summary';
        if (day.isToday) {
          var todayBadge = document.createElement('div');
          todayBadge.className = 'month-day-today-badge';
          todayBadge.textContent = 'Сегодня';
          summary.appendChild(todayBadge);
        }
        if ((day.tasks || []).length) summary.appendChild(createChip('Задач: ' + String(day.tasks.length)));
        if (day.attentionCount > 0) summary.appendChild(createChip('Внимание: ' + String(day.attentionCount)));
        if (day.blockedCount > 0) summary.appendChild(createChip('Блокер: ' + String(day.blockedCount)));
        head.appendChild(summary);
        cell.appendChild(head);

        var metrics = document.createElement('div');
        metrics.className = 'month-day-caption';
        metrics.textContent = (day.tasks || []).length
          ? ('Показаны задачи из месячного приоритета: вручную отмеченные, основные и важные неповторяющиеся · план: ' + formatMinutesHoursLabel(day.plannedMinutes) + (day.overflowMinutes > 0 ? ' · перегруз: ' + formatMinutesHoursLabel(day.overflowMinutes) : ' · выполнено: ' + String(day.doneCount)))
          : 'На этот день нет задач, отмеченных для «Месяца», основных или важных неповторяющихся задач.';
        cell.appendChild(metrics);

        var list = document.createElement('div');
        list.className = 'month-task-list';
        if (!(day.tasks || []).length) {
          var empty = document.createElement('div');
          empty.className = 'month-day-empty';
          empty.textContent = day.inCurrentMonth ? 'Пустой день' : 'Вне текущего месяца';
          list.appendChild(empty);
        } else {
          (day.tasks || []).slice(0, 4).forEach(function (task) { list.appendChild(createMonthTaskChip(task)); });
          if ((day.tasks || []).length > 4) {
            var more = document.createElement('button');
            more.type = 'button';
