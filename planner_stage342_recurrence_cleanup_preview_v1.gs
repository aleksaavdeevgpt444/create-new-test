async function handleTelegramCommand(env, chatId, text, request) {
  const commandData = extractTelegramCommandParts(text);
  if (!commandData) return false;
  const { command, args } = commandData;

  if (command === "/start") {
    await sendTelegramMessage(
      env,
      chatId,
      [
        "Привет. Я планнер.",
        "",
        "Что я уже умею:",
        "— сохранять текст как задачу",
        "— показывать списки по статусам",
        "— переносить задачи между статусами",
        "— открывать web-интерфейс прямо внутри Telegram",
        "— определять AI-приоритет и следующий шаг",
        "— управлять текущим днём прямо из чата",
        "",
        "Команды:",
        "/tasks — последние задачи",
        "/new — новые",
        "/planned — в плане",
        "/done — выполненные",
        "/canceled — отменённые",
        "/postponed — перенесённые",
        "/plan — план на сегодня",
        "/next — что делать дальше",
        "/rest — остаток дня",
        "/finish — завершить день",
        "/focus — фокус по задаче",
        "/tomorrow — перенести на завтра",
        "/app — открыть web-интерфейс",
        "/help — помощь",
      ].join("\n")
    );
    return true;
  }

  if (command === "/help") {
    await sendTelegramMessage(
      env,
      chatId,
      [
        "Как пользоваться:",
        "",
        "1. Напиши любой текст — я сохраню его как задачу.",
        "2. Списки по статусам:",
        "/new",
        "/planned",
        "/done",
        "/canceled",
        "/postponed",
        "/app — открыть Mini App",
        "",
        buildStatusMoveHelpText(),
      ].join("\n")
    );
    return true;
  }

  if (command === "/app" || command === "/web") return handleTelegramAppCommand(env, chatId, request);
  if (command === "/plan") return handleTelegramPlanCommand(env, chatId, args, request);
  if (command === "/next" || command === "/whatnext") return handleTelegramNextCommand(env, chatId, request);
  if (command === "/rest" || command === "/left") return handleTelegramRestCommand(env, chatId);
  if (command === "/finish" || command === "/shutdown") return handleTelegramFinishCommand(env, chatId, request);
  if (command === "/tomorrow") return handleTelegramTomorrowCommand(env, chatId, args);
  if (command === "/focus") return handleTelegramFocusCommand(env, chatId, args, request);
  if (command === "/tasks") {
    const tasksText = await getLatestTasksText(env, String(chatId), TELEGRAM_LIST_LIMIT);
    await sendTelegramMessage(env, chatId, tasksText);
    return true;
  }
  if (command === "/new" || command === "/inbox") return handleStatusCommand(env, chatId, TASK_STATUSES.NEW, args);
  if (command === "/planned" || command === "/today") return handleStatusCommand(env, chatId, TASK_STATUSES.PLANNED, args);
  if (command === "/done") return handleStatusCommand(env, chatId, TASK_STATUSES.DONE, args);
  if (command === "/canceled" || command === "/cancelled") return handleStatusCommand(env, chatId, TASK_STATUSES.CANCELED, args);
  if (command === "/postponed") return handleStatusCommand(env, chatId, TASK_STATUSES.POSTPONED, args);

  await sendTelegramMessage(env, chatId, `Неизвестная команда: ${extractTelegramCommand(text)}\n\n${buildStatusMoveHelpText()}`);
  return true;
}

async function handleTelegramWebhook(request, env) {
  if (request.method !== "POST") return textResponse("Method Not Allowed", 405);
  const secretHeader = request.headers.get("X-Telegram-Bot-Api-Secret-Token");
  if (secretHeader !== env.TELEGRAM_WEBHOOK_SECRET) return textResponse("Forbidden", 403);

  try {
    const update = await request.json();

    // STAGE 349 — agent callback router (covers agent_* callbacks from stages 340-346)
    const callbackQuery = update?.callback_query;
    if (callbackQuery) {
      const agentHandled = await handleTelegramWebhookAgentCallbacks(env, callbackQuery);
      if (agentHandled) return jsonResponse({ ok: true, handled: "agent_callback" });

      // Legacy task-reminder callbacks
      const handledCallback = await handleTelegramTaskReminderCallback(env, callbackQuery, request);
      if (handledCallback) return jsonResponse({ ok: true, handled: "callback_query" });
    }

    const message = update?.message;
    const chatId = message?.chat?.id;
    const text = message?.text?.trim();

    if (!chatId) return jsonResponse({ ok: true, skipped: "no chatId" });

    if (!text) {
      await sendTelegramMessage(env, chatId, "Пока я сохраняю только текстовые сообщения как задачи.");
      return jsonResponse({ ok: true, skipped: "non-text message" });
    }

    // STAGE 337 — agent intake: handle non-command messages via the agent pipeline
    const commandHandled = await handleTelegramCommand(env, chatId, text, request);
    if (commandHandled) return jsonResponse({ ok: true, handled: "command" });

    const agentIntakeResponse = await handleTelegramAgentIntake(env, update);
    if (agentIntakeResponse) return agentIntakeResponse;

    // Fallback: legacy AI task creation
    const { aiResult } = await createTaskWithAi(env, {
      user_id: String(chatId),
      title: text,
      description: null,
      project_name: "Без проекта",
      due_at: null,
      duration_minutes: 60,
      source: "telegram",
    });

    const replyText = buildTelegramReplyAfterAi(text, aiResult);
    await sendTelegramMessage(env, chatId, replyText);
    return jsonResponse({ ok: true, inserted: true, aiApplied: !!aiResult });
  } catch (error) {
    return jsonResponse({ ok: false, error: String(error) }, { status: 500 });
  }
}

async function handleIdeasHubCreateTaskApi(request, env) {
  if (request.method !== "POST") return textResponse("Method Not Allowed", 405);
  if (!isAuthorizedHubIngestRequest(request, env)) {
    return jsonResponse({ ok: false, error: "Unauthorized" }, { status: 401 });
  }

  try {
    const body = await request.json();
    const userId = body?.user_id ? String(body.user_id) : "";
    const sourceRecordId = body?.source_record_id ? String(body.source_record_id) : "";
    const source = normalizePlannerBridgeSource(body?.source || "ideas-hub") || 'ideas-hub';
    const upsertMode = normalizePlannerBridgeUpsertMode(body?.upsert_mode || (body?.update_existing ? 'update' : ''));

    if (!userId || !sourceRecordId || !body?.title) {
      return jsonResponse({ ok: false, error: "user_id, source_record_id and title are required" }, { status: 400 });
    }

    const existing = await getTaskBySourceRecord(env, {
      userId,
      source,
      sourceRecordId,
    });

    if (existing && upsertMode !== 'update') {
      return jsonResponse({
        ok: true,
        created: false,
        updated: false,
        duplicate: true,
        task_id: existing.id,
        item: existing,
        bridge_meta: {
          state: 'duplicate',
          source,
          source_label: getPlannerBridgeSourceLabelServer(source),
          source_record_id: sourceRecordId,
          upsert_mode: upsertMode,
        },
      });
    }

    if (existing && upsertMode === 'update') {
      let nextTask = existing;
      nextTask = await updateTaskMeta(env, {
        taskId: existing.id,
        userId,
        title: body?.title !== undefined ? String(body.title) : undefined,
        taskProduct: body?.task_product !== undefined ? String(body.task_product || '') : undefined,
        description: body?.description !== undefined ? String(body.description || '') : undefined,
        projectName: body?.project_name !== undefined ? String(body.project_name || '') : undefined,
        priorityManual: body?.priority_manual !== undefined ? body?.priority_manual : undefined,
        durationMinutes: body?.duration_minutes !== undefined ? body?.duration_minutes : undefined,
        plannedMinutesManual: body?.planned_minutes_manual !== undefined ? body?.planned_minutes_manual : undefined,
        actualMinutes: undefined,
        remindAt: undefined,
        recurrenceType: undefined,
        recurrenceRule: undefined,
        recurrenceEnabled: undefined,
      });
      if (Object.prototype.hasOwnProperty.call(body || {}, 'due_at')) {
        nextTask = await updateTaskSchedule(env, {
          taskId: existing.id,
          userId,
          dueAt: body?.due_at,
          nextStatus: null,
          durationMinutes: body?.duration_minutes !== undefined ? body?.duration_minutes : undefined,
        });
      }
      await addTaskHistory(env, {
        userId,
        taskId: existing.id,
        eventType: 'bridge_updated',
        payload: {
          source,
          source_record_id: sourceRecordId,
          source_label: getPlannerBridgeSourceLabelServer(source),
        },
      });
      return jsonResponse({
        ok: true,
        created: false,
        updated: true,
        duplicate: false,
        task_id: nextTask.id,
        item: nextTask,
        bridge_meta: {
          state: 'updated',
          source,
          source_label: getPlannerBridgeSourceLabelServer(source),
          source_record_id: sourceRecordId,
          upsert_mode: upsertMode,
        },
      });
    }

    const created = await createTaskRecord(env, {
      user_id: userId,
      source_record_id: sourceRecordId,
      source,
      title: String(body.title),
      description: body?.description ? String(body.description) : "",
      task_product: body?.task_product ? String(body.task_product) : "",
      project_name: body?.project_name ? String(body.project_name) : "Без проекта",
      priority_manual: body?.priority_manual ?? null,
      due_at: body?.due_at ?? null,
      duration_minutes: body?.duration_minutes ?? DEFAULT_EVENT_DURATION_FOR_SERVER(),
      planned_minutes_manual: body?.planned_minutes_manual ?? null,
      actual_minutes: null,
      recurrence_type: null,
      recurrence_rule: null,
      recurrence_enabled: 0,
      show_in_month: body?.show_in_month ?? 0,
    });

    await addTaskHistory(env, {
      userId,
      taskId: created.taskId,
      eventType: 'bridge_ingested',
      payload: {
        source,
        source_record_id: sourceRecordId,
        source_label: getPlannerBridgeSourceLabelServer(source),
      },
    });

    return jsonResponse({
      ok: true,
      created: true,
      updated: false,
      duplicate: false,
      task_id: created.taskId,
      item: created.task,
      bridge_meta: {
        state: 'created',
        source,
        source_label: getPlannerBridgeSourceLabelServer(source),
        source_record_id: sourceRecordId,
        upsert_mode: upsertMode,
      },
    });
  } catch (error) {
    return jsonResponse({ ok: false, error: String(error) }, { status: 500 });
  }
}

