# Local development secrets — copy to .dev.vars and fill in real values
# DO NOT commit .dev.vars to git (it is gitignored)

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
WB_API_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=


# Required for protected API routes; use a random local-only value
API_BEARER_TOKEN=
# Required only when testing Telegram webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=
